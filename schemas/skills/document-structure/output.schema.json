{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/litlfred/folio-assistant/schemas/skills/document-structure/output.schema.json",
  "title": "Document Structure Output",
  "type": "object",
  "required": ["manifestsChanged"],
  "properties": {
    "manifestsChanged": { "type": "array", "items": { "type": "string" } },
    "chapters": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Chapter directory names in their new reading order."
    },
    "forwardReferences": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Labels whose uses[] now points forward in reading order. A real finding after a reorder, not a mechanical detail."
    }
  }
}
