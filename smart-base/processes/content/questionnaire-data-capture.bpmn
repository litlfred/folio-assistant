<?xml version="1.0" encoding="UTF-8"?>
<!--
  smart-base — capture data with an SDC questionnaire: a health worker
  completes a DAK form on their device and the point-of-care system extracts
  the resources it stands for. Generic for any DAK; a DAK's diagram calls it
  with a callActivity whose calledElement is Process_QuestionnaireDataCapture
  (registering a client is the commonest use).

  Source of truth: this file. The picture beside it (questionnaire-data-capture.svg) is drawn by
  `bun run cat render:bpmn`;
  never hand-edit it.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/0.1.0/processes/ns/"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns/"
                  id="Definitions_QuestionnaireDataCapture"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">

  <bpmn:resource id="health-worker" name="Health worker" />
  <bpmn:resource id="point-of-care-system" name="Point-of-care system" />

  <bpmn:collaboration id="Collaboration_QuestionnaireDataCapture">
    <bpmn:participant id="Participant_QuestionnaireDataCapture" name="Capture data with an SDC questionnaire" processRef="Process_QuestionnaireDataCapture" />
  </bpmn:collaboration>

  <bpmn:process id="Process_QuestionnaireDataCapture" name="Capture data with an SDC questionnaire" isExecutable="false">
    <bpmn:documentation>A health worker completes one of the DAK's forms, a FHIR R4 Questionnaire conforming to Structured Data Capture, as their device renders it, and the point-of-care system turns the completed QuestionnaireResponse into the resources it stands for by the extraction the form declares (SDC $extract). Generic for any DAK: registering a client, recording a visit, a referral. A DAK's diagram calls it by call activity; the caller's lanes take on health-worker and point-of-care-system for the duration of the call. Skills: complete-sdc-questionnaire, extract-questionnaire-response (package authoring-who-smart-guidelines).</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="advisory" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="Process_QuestionnaireDataCapture_LaneSet">
      <bpmn:lane id="Lane_HealthWorker" name="Health worker" partitionElementRef="health-worker">
        <bpmn:documentation>A person in the health-worker role: completes the form with the client, confirming any pre-populated answer.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_FormDue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="Point-of-care system" partitionElementRef="point-of-care-system">
        <bpmn:documentation>The app or EHR the form is filled in: extracts and saves the resources, offline first.</bpmn:documentation>
        <bpmn:flowNodeRef>Gateway_Extracts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Extracted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Stored</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_FormDue" name="A form is due">
      <bpmn:documentation>The DAK's process reaches a step that records data on a form: registering a client, a visit, a referral.</bpmn:documentation>
      <bpmn:outgoing>Q01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Complete" name="Complete the form">
      <bpmn:documentation>Complete the SDC Questionnaire as the device renders it: confirm or correct each pre-populated answer, answer every enabled required item within its constraints, and submit. The result is a completed QuestionnaireResponse.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="complete-sdc-questionnaire" />
      </bpmn:extensionElements>
      <bpmn:incoming>Q01</bpmn:incoming>
      <bpmn:outgoing>Q02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Extracts" name="Form declares an extraction?">
      <bpmn:documentation>Read from the Questionnaire, not decided: an SDC extraction extension (targetStructureMap, itemExtractionContext or observationExtract) is present, or it is not.</bpmn:documentation>
      <bpmn:incoming>Q02</bpmn:incoming>
      <bpmn:outgoing>Q03</bpmn:outgoing>
      <bpmn:outgoing>Q04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Extract" name="Extract and save the resources">
      <bpmn:documentation>Run SDC $extract by the method the Questionnaire declares and save the resulting transaction Bundle whole, queued when offline.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="extract-questionnaire-response" />
      </bpmn:extensionElements>
      <bpmn:incoming>Q03</bpmn:incoming>
      <bpmn:outgoing>Q05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Extracted" name="Resources saved">
      <bpmn:documentation>The client's resources, and the response they came from, are in the record.</bpmn:documentation>
      <bpmn:incoming>Q05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Stored" name="Response stored">
      <bpmn:documentation>The form declares no extraction: the QuestionnaireResponse itself is the record.</bpmn:documentation>
      <bpmn:incoming>Q04</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Q01" sourceRef="Start_FormDue" targetRef="Task_Complete" />
    <bpmn:sequenceFlow id="Q02" sourceRef="Task_Complete" targetRef="Gateway_Extracts" />
    <bpmn:sequenceFlow id="Q03" name="yes" sourceRef="Gateway_Extracts" targetRef="Task_Extract" />
    <bpmn:sequenceFlow id="Q04" name="no" sourceRef="Gateway_Extracts" targetRef="End_Stored" />
    <bpmn:sequenceFlow id="Q05" sourceRef="Task_Extract" targetRef="End_Extracted" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_QuestionnaireDataCapture">
    <bpmndi:BPMNPlane id="BPMNPlane_QuestionnaireDataCapture" bpmnElement="Collaboration_QuestionnaireDataCapture">
      <bpmndi:BPMNShape id="Participant_QuestionnaireDataCapture_di" bpmnElement="Participant_QuestionnaireDataCapture" isHorizontal="true">
        <dc:Bounds x="100" y="40" width="760" height="370" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HealthWorker_di" bpmnElement="Lane_HealthWorker" isHorizontal="true">
        <dc:Bounds x="130" y="40" width="730" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="130" y="210" width="730" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_FormDue_di" bpmnElement="Start_FormDue">
        <dc:Bounds x="190" y="107" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="174" y="150" width="68" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Complete_di" bpmnElement="Task_Complete">
        <dc:Bounds x="270" y="85" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Extracts_di" bpmnElement="Gateway_Extracts" isMarkerVisible="true">
        <dc:Bounds x="455" y="280" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="430" y="240" width="100" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Extract_di" bpmnElement="Task_Extract">
        <dc:Bounds x="550" y="265" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Extracted_di" bpmnElement="End_Extracted">
        <dc:Bounds x="730" y="287" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="707" y="330" width="82" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Stored_di" bpmnElement="End_Stored">
        <dc:Bounds x="597" y="357" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="645" y="368" width="86" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Q01_di" bpmnElement="Q01">
        <di:waypoint x="226" y="125" />
        <di:waypoint x="270" y="125" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q02_di" bpmnElement="Q02">
        <di:waypoint x="335" y="165" />
        <di:waypoint x="335" y="305" />
        <di:waypoint x="455" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q03_di" bpmnElement="Q03">
        <di:waypoint x="505" y="305" />
        <di:waypoint x="550" y="305" />
        <bpmndi:BPMNLabel><dc:Bounds x="515" y="287" width="18" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q04_di" bpmnElement="Q04">
        <di:waypoint x="480" y="330" />
        <di:waypoint x="480" y="375" />
        <di:waypoint x="597" y="375" />
        <bpmndi:BPMNLabel><dc:Bounds x="486" y="348" width="14" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Q05_di" bpmnElement="Q05">
        <di:waypoint x="680" y="305" />
        <di:waypoint x="730" y="305" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
