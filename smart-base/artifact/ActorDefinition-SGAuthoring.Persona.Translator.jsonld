  "dcterms:identifier": "ActorDefinition/SGAuthoring.Persona.Translator",
  "schema:name": "Translator",
  "dcterms:title": "Translator",
  "dcterms:description": "A language specialist responsible for translating SMART Guidelines Implementation Guide content across UN languages to support global adoption and adaptation. Key activities: Translate IG narrative content across UN languages Translate FHIR resource display names and descriptions Review translated content for accuracy and clinical correctness Manage .pot/.po translation template files Coordinate with clinical SMEs for domain-specific terminology Ensure translated examples are available for each non-abstract profile Source : IG Starter Kit, Checklist L4 (example resources per UN language); PR 288 translation skill infrastructure",
  "schema:version": "0.3.0",
