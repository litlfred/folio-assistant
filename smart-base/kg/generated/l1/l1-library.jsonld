{
  "@context": {
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "sgkg": "http://smart.who.int/kg/",
    "doco": "http://purl.org/spar/doco/",
    "subClassOf": {
      "@id": "rdfs:subClassOf",
      "@type": "@id"
    },
    "comment": "rdfs:comment"
  },
  "@id": "http://smart.who.int/kg/l1-library",
  "comment": "Every layer points only upstream: L3 → L2 → L1 → library (the ingested source document, its sections and blocks). A layer may point at any layer above it and never at one below it.",
  "@graph": [
    {
      "@id": "http://smart.who.int/kg/publication",
      "subClassOf": "https://litlfred.github.io/cat-harness/v0/ns/SourceDocument",
      "comment": "The library's ingested source document; L1 adds publicationType, grcStatus, identifiers, reviewBy."
    },
    {
      "@id": "http://smart.who.int/kg/publication-section",
      "subClassOf": "http://purl.org/spar/doco/Section",
      "comment": "Whatever section the library's ingest cut — page, outline or consensus TOC; L1 adds number and ordinal."
    },
    {
      "@id": "http://smart.who.int/kg/publication-element",
      "subClassOf": "https://litlfred.github.io/cat-harness/v0/ns/Block",
      "comment": "A library block; L1 adds elementType, rowType, columns, columnMap and cells."
    },
    {
      "@id": "http://smart.who.int/kg/publication-element#table",
      "subClassOf": [
        "http://smart.who.int/kg/publication-element",
        "http://purl.org/spar/doco/Table"
      ],
      "comment": "A publication-element whose elementType is \"table\"."
    },
    {
      "@id": "http://smart.who.int/kg/publication-element#figure",
      "subClassOf": [
        "http://smart.who.int/kg/publication-element",
        "http://purl.org/spar/doco/Figure"
      ],
      "comment": "A publication-element whose elementType is \"figure\"."
    },
    {
      "@id": "http://smart.who.int/kg/publication-element#footnote",
      "subClassOf": [
        "http://smart.who.int/kg/publication-element",
        "http://purl.org/spar/doco/Footnote"
      ],
      "comment": "A publication-element whose elementType is \"footnote\"."
    },
    {
      "@id": "http://smart.who.int/kg/publication-element#list",
      "subClassOf": [
        "http://smart.who.int/kg/publication-element",
        "http://purl.org/spar/doco/List"
      ],
      "comment": "A publication-element whose elementType is \"list\"."
    },
    {
      "@id": "http://smart.who.int/kg/publication-element#box",
      "subClassOf": [
        "http://smart.who.int/kg/publication-element",
        "http://purl.org/spar/doco/TextBox"
      ],
      "comment": "A publication-element whose elementType is \"box\"."
    }
  ]
}
