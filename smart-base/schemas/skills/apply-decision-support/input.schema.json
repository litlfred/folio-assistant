{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apply Decision Support Input",
  "description": "The parameters of PlanDefinition/$apply (https://hl7.org/fhir/R4/plandefinition-operation-apply.html).",
  "type": "object",
  "required": [
    "planDefinition",
    "subject"
  ],
  "properties": {
    "planDefinition": {
      "type": "string",
      "description": "The PlanDefinition's canonical, url|version: a DAK decision table published at L3."
    },
    "subject": {
      "type": "object",
      "description": "A FHIR R4 Reference (https://hl7.org/fhir/R4/references.html).",
      "properties": {
        "reference": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "encounter": {
      "type": "object",
      "description": "A FHIR R4 Reference (https://hl7.org/fhir/R4/references.html).",
      "properties": {
        "reference": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "practitioner": {
      "type": "object",
      "description": "A FHIR R4 Reference (https://hl7.org/fhir/R4/references.html).",
      "properties": {
        "reference": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "resourceType"
      ],
      "properties": {
        "resourceType": {
          "const": "Bundle"
        }
      },
      "description": "Data to evaluate against when the record is not on the server."
    }
  },
  "additionalProperties": false
}
