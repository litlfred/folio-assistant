{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Extract Questionnaire Response Output",
  "description": "What SDC $extract (https://hl7.org/fhir/uv/sdc/extraction.html) produced, by the method the Questionnaire declares.",
  "type": "object",
  "required": [
    "bundle"
  ],
  "properties": {
    "bundle": {
      "type": "object",
      "required": [
        "resourceType"
      ],
      "properties": {
        "resourceType": {
          "const": "Bundle"
        },
        "type": {
          "const": "transaction"
        }
      },
      "description": "A FHIR R4 transaction Bundle (https://hl7.org/fhir/R4/bundle.html)."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning",
              "information"
            ]
          },
          "linkId": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
