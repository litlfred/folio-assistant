{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Activate Accepted Guidance Output",
  "description": "What was saved: accepted and modified requests active (intent plan or order) and referenced from the CarePlan; nothing for a declined action.",
  "type": "object",
  "required": [
    "bundle"
  ],
  "properties": {
    "bundle": {
      "type": "object",
      "required": [
        "resourceType"
      ],
      "properties": {
        "resourceType": {
          "const": "Bundle"
        },
        "type": {
          "const": "transaction"
        }
      },
      "description": "A FHIR R4 transaction Bundle (https://hl7.org/fhir/R4/bundle.html)."
    }
  },
  "additionalProperties": false
}
