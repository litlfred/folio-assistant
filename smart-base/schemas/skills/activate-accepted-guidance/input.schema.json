{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Activate Accepted Guidance Input",
  "type": "object",
  "required": [
    "guidance",
    "decisions"
  ],
  "properties": {
    "guidance": {
      "type": "object",
      "description": "The guidance, as apply-decision-support returned it: a RequestGroup/RequestOrchestration, or CDS Hooks cards, or both.",
      "properties": {
        "requestGroup": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "resourceType"
              ],
              "properties": {
                "resourceType": {
                  "const": "RequestGroup"
                }
              },
              "description": "FHIR R4 RequestGroup (https://hl7.org/fhir/R4/requestgroup.html): the proposed actions, each request a draft proposal."
            },
            {
              "type": "object",
              "required": [
                "resourceType"
              ],
              "properties": {
                "resourceType": {
                  "const": "RequestOrchestration"
                }
              },
              "description": "FHIR R5 RequestOrchestration (https://hl7.org/fhir/R5/requestorchestration.html), RequestGroup's R5 name."
            }
          ]
        },
        "cards": {
          "type": "array",
          "description": "CDS Hooks 2.0 cards (https://cds-hooks.hl7.org/2.0/#card-attributes), when the guidance came from a CDS service.",
          "items": {
            "type": "object",
            "required": [
              "summary",
              "indicator",
              "source"
            ],
            "properties": {
              "uuid": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "indicator": {
                "enum": [
                  "info",
                  "warning",
                  "critical"
                ]
              },
              "source": {
                "type": "object"
              },
              "suggestions": {
                "type": "array"
              }
            }
          }
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "outcome",
          "by",
          "at"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "The RequestGroup action id, or the CDS Hooks card uuid (and suggestion uuid)."
          },
          "outcome": {
            "enum": [
              "accepted",
              "declined",
              "modified"
            ],
            "description": "An action the health worker did not touch is declined."
          },
          "modified": {
            "type": "object",
            "description": "The changed request resource; only with outcome modified."
          },
          "by": {
            "type": "object",
            "description": "A FHIR R4 Reference (https://hl7.org/fhir/R4/references.html).",
            "properties": {
              "reference": {
                "type": "string"
              },
              "display": {
                "type": "string"
              }
            }
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
