{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Client History Output",
  "type": "object",
  "required": [
    "reliedOn"
  ],
  "properties": {
    "reliedOn": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "provenance"
        ],
        "properties": {
          "item": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "verified",
              "unverified",
              "reported"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
