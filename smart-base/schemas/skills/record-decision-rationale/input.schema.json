{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Record Decision Rationale Input",
  "description": "Optional and never blocking: only reached when the health worker opts in.",
  "type": "object",
  "required": [
    "decision",
    "practitioner"
  ],
  "properties": {
    "decision": {
      "type": "object",
      "required": [
        "action",
        "outcome",
        "by",
        "at"
      ],
      "properties": {
        "action": {
          "type": "string",
          "description": "The RequestGroup action id, or the CDS Hooks card uuid (and suggestion uuid)."
        },
        "outcome": {
          "enum": [
            "accepted",
            "declined",
            "modified"
          ],
          "description": "An action the health worker did not touch is declined."
        },
        "modified": {
          "type": "object",
          "description": "The changed request resource; only with outcome modified."
        },
        "by": {
          "type": "object",
          "description": "A FHIR R4 Reference (https://hl7.org/fhir/R4/references.html).",
          "properties": {
            "reference": {
              "type": "string"
            },
            "display": {
              "type": "string"
            }
          }
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "practitioner": {
      "type": "object",
      "description": "A FHIR R4 Reference (https://hl7.org/fhir/R4/references.html).",
      "properties": {
        "reference": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "planDefinition": {
      "type": "string",
      "description": "The canonical of the PlanDefinition the guidance came from."
    },
    "reason": {
      "type": "object",
      "description": "A FHIR CodeableConcept: a coded reason, free text in text, or both. Both optional.",
      "properties": {
        "coding": {
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
