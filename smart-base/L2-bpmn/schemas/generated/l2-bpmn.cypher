// WHO SMART Guidelines knowledge graph -- L2-BPMN ONTOLOGY (type graph).
// Generated by smart-base/L1/schemas/emit.ts. Do not edit; edit the layer's Zod source.
//
// These are CLASSES and LICENSED EDGES, not DAK instance data. Loading this gives you the
// schema to explore; a DAK's own graph is generated by that DAK's IG build.
//
// Every statement is MERGE, so re-running is safe.
//
// RUN THIS AGAINST A USER DATABASE, NOT `system`. The CREATE CONSTRAINT below is rejected
// with "can only be executed in a user database" if `system` is selected, which is where
// Neo4j Browser can land you after connecting. Switch first:
//
//     :use neo4j                                    (Browser, or your database's name)
//     cypher-shell -d neo4j -f <this file>           (shell)
//
// REQUIRES l2.cypher TO BE LOADED FIRST.
// This layer licenses edges onto imported classes (business-process, dak-task, external-artifact, persona). The MATCH
// statements below find nothing if those classes are absent, and Cypher does not treat
// that as an error -- the edges would simply be missing. Verify with the query at the
// end of this file.

CREATE CONSTRAINT kgclass_id IF NOT EXISTS
FOR (c:KGClass) REQUIRE c.id IS UNIQUE;

MERGE (:KGClass:Artefact {id:'bpmn-definitions', name:'BPMN File', kind:'Artefact', layer:'l2-bpmn', iri:'http://smart.who.int/kg/bpmn-definitions'});
MERGE (:KGClass:Structure {id:'bpmn-process', name:'BPMN Process', kind:'Structure', layer:'l2-bpmn', iri:'http://smart.who.int/kg/bpmn-process'});
MERGE (:KGClass:Structure {id:'bpmn-participant', name:'BPMN Participant', kind:'Structure', layer:'l2-bpmn', iri:'http://smart.who.int/kg/bpmn-participant'});
MERGE (:KGClass:Structure {id:'bpmn-task', name:'BPMN Task', kind:'Structure', layer:'l2-bpmn', iri:'http://smart.who.int/kg/bpmn-task'});
MERGE (:KGClass:Structure {id:'bpmn-gateway', name:'BPMN Gateway', kind:'Structure', layer:'l2-bpmn', iri:'http://smart.who.int/kg/bpmn-gateway'});
MERGE (:KGClass:Structure {id:'bpmn-event', name:'BPMN Event', kind:'Structure', layer:'l2-bpmn', iri:'http://smart.who.int/kg/bpmn-event'});

MATCH (s:KGClass {id:'bpmn-definitions'}), (t:KGClass {id:'external-artifact'}) MERGE (s)-[:ELABORATES {predicate:'elaborates', note:'One artefact, one IRI: instances of these two classes are the same node, described at two layers.'}]->(t);

MATCH (s:KGClass {id:'bpmn-definitions'}), (t:KGClass {id:'bpmn-process'}) MERGE (s)-[:CONTAINS {predicate:'contains'}]->(t);
MATCH (s:KGClass {id:'bpmn-definitions'}), (t:KGClass {id:'bpmn-participant'}) MERGE (s)-[:CONTAINS {predicate:'contains'}]->(t);
MATCH (s:KGClass {id:'bpmn-process'}), (t:KGClass {id:'bpmn-task'}) MERGE (s)-[:CONTAINS {predicate:'contains'}]->(t);
MATCH (s:KGClass {id:'bpmn-process'}), (t:KGClass {id:'bpmn-gateway'}) MERGE (s)-[:CONTAINS {predicate:'contains'}]->(t);
MATCH (s:KGClass {id:'bpmn-process'}), (t:KGClass {id:'bpmn-event'}) MERGE (s)-[:CONTAINS {predicate:'contains'}]->(t);
MATCH (s:KGClass {id:'bpmn-task'}), (t:KGClass {id:'bpmn-task'}) MERGE (s)-[:CONTAINS {predicate:'contains'}]->(t);
MATCH (s:KGClass {id:'bpmn-event'}), (t:KGClass {id:'bpmn-task'}) MERGE (s)-[:FLOWSTO {predicate:'flowsTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-event'}), (t:KGClass {id:'bpmn-gateway'}) MERGE (s)-[:FLOWSTO {predicate:'flowsTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-task'}), (t:KGClass {id:'bpmn-task'}) MERGE (s)-[:FLOWSTO {predicate:'flowsTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-task'}), (t:KGClass {id:'bpmn-gateway'}) MERGE (s)-[:FLOWSTO {predicate:'flowsTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-task'}), (t:KGClass {id:'bpmn-event'}) MERGE (s)-[:FLOWSTO {predicate:'flowsTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-gateway'}), (t:KGClass {id:'bpmn-task'}) MERGE (s)-[:FLOWSTO {predicate:'flowsTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-gateway'}), (t:KGClass {id:'bpmn-gateway'}) MERGE (s)-[:FLOWSTO {predicate:'flowsTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-gateway'}), (t:KGClass {id:'bpmn-event'}) MERGE (s)-[:FLOWSTO {predicate:'flowsTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-task'}), (t:KGClass {id:'bpmn-task'}) MERGE (s)-[:MESSAGETO {predicate:'messageTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-task'}), (t:KGClass {id:'bpmn-event'}) MERGE (s)-[:MESSAGETO {predicate:'messageTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-event'}), (t:KGClass {id:'bpmn-task'}) MERGE (s)-[:MESSAGETO {predicate:'messageTo'}]->(t);
MATCH (s:KGClass {id:'bpmn-participant'}), (t:KGClass {id:'persona'}) MERGE (s)-[:PERFORMEDBY {predicate:'performedBy'}]->(t);
MATCH (s:KGClass {id:'dak-task'}), (t:KGClass {id:'bpmn-task'}) MERGE (s)-[:DESCRIBES {predicate:'describes'}]->(t);
MATCH (s:KGClass {id:'business-process'}), (t:KGClass {id:'bpmn-definitions'}) MERGE (s)-[:SOURCEDFROM {predicate:'sourcedFrom'}]->(t);

// Verification. Must return 4 rows -- one per imported class this layer
// builds on. Fewer means an imported layer was not loaded and edges above are missing.
// MATCH (c:KGClass) WHERE c.id IN ['business-process', 'dak-task', 'external-artifact', 'persona'] RETURN c.id;
