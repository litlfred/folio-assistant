sgkg:presentedIn_HealthIntervention_PublicationSection a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:presentedIn ;
  rdfs:domain sgkg:HealthIntervention ;
  rdfs:range sgkg:PublicationSection ;
  rdfs:label "Health intervention presentedIn Publication section" .

sgkg:presentedIn_HealthIntervention_PublicationElement a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:presentedIn ;
  rdfs:domain sgkg:HealthIntervention ;
  rdfs:range sgkg:PublicationElement ;
