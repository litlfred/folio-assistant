  rdfs:range sgkg:BPMNTask ;
  rdfs:label "BPMN Gateway flowsTo BPMN Task" .

sgkg:flowsTo_BPMNGateway_BPMNGateway a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:flowsTo ;
  rdfs:domain sgkg:BPMNGateway ;
  rdfs:range sgkg:BPMNGateway ;
  rdfs:label "BPMN Gateway flowsTo BPMN Gateway" .

sgkg:flowsTo_BPMNGateway_BPMNEvent a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:flowsTo ;
  rdfs:domain sgkg:BPMNGateway ;
  rdfs:range sgkg:BPMNEvent ;
  rdfs:label "BPMN Gateway flowsTo BPMN Event" .

sgkg:messageTo_BPMNTask_BPMNTask a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:messageTo ;
  rdfs:domain sgkg:BPMNTask ;
  rdfs:range sgkg:BPMNTask ;
  rdfs:label "BPMN Task messageTo BPMN Task" .

sgkg:messageTo_BPMNTask_BPMNEvent a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:messageTo ;
  rdfs:domain sgkg:BPMNTask ;
  rdfs:range sgkg:BPMNEvent ;
  rdfs:label "BPMN Task messageTo BPMN Event" .

sgkg:messageTo_BPMNEvent_BPMNTask a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:messageTo ;
  rdfs:domain sgkg:BPMNEvent ;
  rdfs:range sgkg:BPMNTask ;
  rdfs:label "BPMN Event messageTo BPMN Task" .

sgkg:performedBy_BPMNParticipant_GenericPersona a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:performedBy ;
  rdfs:domain sgkg:BPMNParticipant ;
  rdfs:range sgkg:GenericPersona ;
  rdfs:label "BPMN Participant performedBy Generic Persona" .

sgkg:describes_TaskEntry_BPMNTask a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:describes ;
  rdfs:domain sgkg:TaskEntry ;
  rdfs:range sgkg:BPMNTask ;
  rdfs:label "Task Entry describes BPMN Task" .

sgkg:sourcedFrom_BusinessProcessWorkflow_BPMNFile a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:sourcedFrom ;
  rdfs:domain sgkg:BusinessProcessWorkflow ;
  rdfs:range sgkg:BPMNFile ;
  rdfs:label "Business Process Workflow sourcedFrom BPMN File" .



<http://smart.who.int/kg/l2-dmn> a owl:Ontology ;
  owl:imports <http://smart.who.int/kg/l2-bpmn> ;
  rdfs:label "WHO SMART Guidelines L2-DMN ontology" ;
  rdfs:comment "The interior of a DMN file, as its own subgraph. It imports l2-bpmn -- not for symmetry, but because a DMN genuinely references a BPMN: dmn:usingTask names the business-rule task that invokes the decision. The dependency runs one way, DMN to BPMN, and modelling them as one subgraph would have hidden that a DMN can be read without a BPMN while the reverse is not true of this edge. Pairwise licensing is carried as sub-properties, because a relationship is licensed between specific class pairs while an OWL object property has one global domain and range." .

### Node kinds

sgkg:Artefact a owl:Class ; rdfs:label "Artefact" ; rdfs:comment "A file, addressed as a whole. Shares its IRI with the L1 reference to the same file, so opening a file does not create a second name for it." .
sgkg:Structure a owl:Class ; rdfs:label "Structure" ; rdfs:comment "An element inside a file. It has no identity apart from the file that contains it, and its vocabulary is the file format's, not WHO's." .

### Classes

sgkg:DMNFile a owl:Class ;
  rdfs:subClassOf sgkg:Artefact ;
  rdfs:label "DMN File" ;
  skos:notation "dmn-definitions" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "One DMN file as a unit -- the `dmn:definitions` root. Shares its IRI with the l1:external-artifact for the same file, so the l2:decision-support-logic component that points at it and this subgraph name one resource." .

sgkg:DMNDecision a owl:Class ;
  rdfs:subClassOf sgkg:Structure ;
  rdfs:label "DMN Decision" ;
  skos:notation "dmn-decision" ;
  rdfs:comment "A `dmn:decision` -- the question being answered, and the node that carries the link back to the BPMN task invoking it. A file may hold several; the BCG file holds one." .

sgkg:DMNDecisionTable a owl:Class ;
  rdfs:subClassOf sgkg:Structure ;
  rdfs:label "DMN Decision Table" ;
  skos:notation "dmn-decision-table" ;
  rdfs:comment "The table realising a decision. Separate from dmn-decision because DMN permits other expression kinds -- a literal expression, an invocation -- and collapsing the two would make the graph unable to say which was used." .

sgkg:DMNInputClause a owl:Class ;
  rdfs:subClassOf sgkg:Structure ;
  rdfs:label "DMN Input Clause" ;
  skos:notation "dmn-input-clause" ;
  rdfs:comment "An input column. Its expression text is where data element names are embedded, which is the only reason this is a node rather than a property of the table." .

sgkg:DMNOutputClause a owl:Class ;
  rdfs:subClassOf sgkg:Structure ;
  rdfs:label "DMN Output Clause" ;
  skos:notation "dmn-output-clause" ;
  rdfs:comment "An output column. The BCG table's four are Care Plan, Guidance displayed to health worker, Annotations and Reference(s). These are column DEFINITIONS in a decision table, not clinical records: no edge from this class reaches an execution artefact, and none may." .

sgkg:DMNRule a owl:Class ;
  rdfs:subClassOf sgkg:Structure ;
  rdfs:label "DMN Rule" ;
  skos:notation "dmn-rule" ;
  rdfs:comment "One row. Its input and output cells are carried as properties, not nodes: 250 of them in the BCG table alone, none the target of a cross-model edge. What the rule needs a node for is its citation edge into L1." .

### Value sets
# Closed code lists bound to class properties. validate.ts rejects any other value.

<http://smart.who.int/kg/valueset/dmn-entry-kind> a skos:ConceptScheme ;
  skos:notation "dmn-entry-kind" ;
  skos:note "source: OMG DMN 1.3, DecisionRule.outputEntry and annotationEntry" ;
  skos:note "bound to: dmn-output-clause.serialisedAs" ;
  rdfs:comment "Which DMN element type a column's cells are serialised as. Added by the smart-base migration from smart-kg's propertyNote, which named the two values in prose." .
<http://smart.who.int/kg/valueset/dmn-entry-kind#outputEntry> a skos:Concept ; skos:inScheme <http://smart.who.int/kg/valueset/dmn-entry-kind> ; skos:notation "outputEntry" ; skos:definition "The column's cells are the rule's outputEntry elements." .
<http://smart.who.int/kg/valueset/dmn-entry-kind#annotationEntry> a skos:Concept ; skos:inScheme <http://smart.who.int/kg/valueset/dmn-entry-kind> ; skos:notation "annotationEntry" ; skos:definition "The column's cells are the rule's annotationEntry elements." .

### Object properties

sgkg:invokedBy a owl:ObjectProperty ;
  rdfs:label "invokedBy" ;
  rdfs:comment "A decision is invoked by a business-rule task. Read from dmn:usingTask/@href, whose fragment is the URL-encoded task NAME rather than its id -- so it resolves only while that prose stays byte-identical in the BPMN, punctuation and the en dash in \"Calmette-Guerin\" included. Carries a resolutionStatus; the target is a bpmn-task when the BPMN is present and an opaque l1:external-artifact when it is not." .

sgkg:reads a owl:ObjectProperty ;
  rdfs:label "reads" ;
  rdfs:comment "An input clause reads a data element. Recovered heuristically from free text, so every instance carries the extraction rule that produced it and a resolutionStatus. The target is an l2:data-element -- the DAK component -- so a recovered name and a declared dictionary entry are the same class and can meet when a dictionary exists." .

sgkg:citesSource a owl:ObjectProperty ;
  rdfs:label "citesSource" ;
  rdfs:comment "A decision rule cites an L1 source. The target is an l1:citation minted from the same string by the citation extractor, so the DMN subgraph and the L1 graph join without either knowing the other exists. Grounded but sparse: 1 of 25 BCG rules. The sparseness is the finding -- a rule with no citesSource edge is a rule with no stated source." .

### Licensed edges, as qualified sub-properties
# One per (source class, predicate, target class) triple the layer licenses.
# Domain and range on the sub-property is what preserves pairwise licensing: a single global
# domain/range on the predicate would be a union of everything and would permit pairs the
# model does not.

sgkg:contains_DMNFile_DMNDecision a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:contains ;
  rdfs:domain sgkg:DMNFile ;
  rdfs:range sgkg:DMNDecision ;
  rdfs:label "DMN File contains DMN Decision" .

sgkg:contains_DMNDecision_DMNDecisionTable a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:contains ;
  rdfs:domain sgkg:DMNDecision ;
  rdfs:range sgkg:DMNDecisionTable ;
  rdfs:label "DMN Decision contains DMN Decision Table" .

sgkg:contains_DMNDecisionTable_DMNInputClause a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:contains ;
  rdfs:domain sgkg:DMNDecisionTable ;
  rdfs:range sgkg:DMNInputClause ;
  rdfs:label "DMN Decision Table contains DMN Input Clause" .

sgkg:contains_DMNDecisionTable_DMNOutputClause a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:contains ;
  rdfs:domain sgkg:DMNDecisionTable ;
  rdfs:range sgkg:DMNOutputClause ;
  rdfs:label "DMN Decision Table contains DMN Output Clause" .

sgkg:contains_DMNDecisionTable_DMNRule a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:contains ;
  rdfs:domain sgkg:DMNDecisionTable ;
  rdfs:range sgkg:DMNRule ;
  rdfs:label "DMN Decision Table contains DMN Rule" .

sgkg:invokedBy_DMNDecision_BPMNTask a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:invokedBy ;
  rdfs:domain sgkg:DMNDecision ;
  rdfs:range sgkg:BPMNTask ;
  rdfs:label "DMN Decision invokedBy BPMN Task" .

sgkg:invokedBy_DMNDecision_ExternalArtefact a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:invokedBy ;
  rdfs:domain sgkg:DMNDecision ;
  rdfs:range sgkg:ExternalArtefact ;
  rdfs:label "DMN Decision invokedBy External artefact" .

sgkg:reads_DMNInputClause_CoreDataElement a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:reads ;
  rdfs:domain sgkg:DMNInputClause ;
  rdfs:range sgkg:CoreDataElement ;
  rdfs:label "DMN Input Clause reads Core Data Element" .

sgkg:citesSource_DMNRule_Citation a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:citesSource ;
  rdfs:domain sgkg:DMNRule ;
  rdfs:range sgkg:Citation ;
  rdfs:label "DMN Rule citesSource Citation" .

sgkg:sourcedFrom_DecisionSupportLogic_DMNFile a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:sourcedFrom ;
  rdfs:domain sgkg:DecisionSupportLogic ;
  rdfs:range sgkg:DMNFile ;
  rdfs:label "Decision-Support Logic sourcedFrom DMN File" .



<http://smart.who.int/kg/l3> a owl:Ontology ;
  owl:imports <http://smart.who.int/kg/l2-dmn> ;
  rdfs:label "WHO SMART Guidelines L3 ontology" ;
  rdfs:comment "The FHIR layer, as a THIN TYPED INDEX and nothing more. Each class carries a canonical URL, a resource type, the profile the artefact actually declares, and status metadata -- no action trees, no element definitions, no bindings, no CQL. That is docs/SCOPE.md's corollary applied: FHIR has canonical references, a validator and a publisher, so it is indexed by URL and never re-represented. What this layer adds that FHIR cannot answer is which L2 component an artefact implements, and therefore which L1 recommendation it ultimately rests on. Pairwise licensing is carried as sub-properties, because a relationship is licensed between specific class pairs while an OWL object property has one global domain and range." .

### Node kinds

sgkg:Conformance a owl:Class ; rdfs:label "Conformance" ; rdfs:comment "A FHIR conformance or definitional resource: something that constrains or defines structure and terminology. Indexed by canonical URL; its interior stays in FHIR." .
sgkg:Knowledge a owl:Class ; rdfs:label "Knowledge" ; rdfs:comment "A FHIR knowledge artefact: something that encodes clinical or operational logic. Indexed by canonical URL; its interior stays in FHIR." .

### Classes

sgkg:PlanDefinition a owl:Class ;
  rdfs:subClassOf sgkg:Knowledge ;
  rdfs:label "Plan Definition" ;
  skos:notation "plan-definition" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR PlanDefinition. The published mapping gives it two sources -- Processes and Decision Tables -- so a PlanDefinition alone does not say which it came from; the implementedBy edge does. 138 in the immunizations IG, all declaring cpg-recommendationdefinition, all decision tables. Shares its IRI with the l1:external-artifact for the same canonical." .

sgkg:ActivityDefinition a owl:Class ;
  rdfs:subClassOf sgkg:Knowledge ;
  rdfs:label "Activity Definition" ;
  skos:notation "activity-definition" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR ActivityDefinition -- the concrete act a plan's action invokes. Reached from a PlanDefinition action's `definitionCanonical`, which is a real reference rather than a convention. 3 in the immunizations IG: two cpg-immunizationactivity, one cpg-communicationactivity." .

sgkg:Library a owl:Class ;
  rdfs:subClassOf sgkg:Knowledge ;
  rdfs:label "Library" ;
  skos:notation "library" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR Library -- the resource that carries CQL. Indexed by canonical and status only. Its CONTENTS are deliberately out of scope: a future l3-cql subgraph will elaborate this same IRI, exactly as l2-bpmn elaborates a BPMN file. 279 in the immunizations IG, joined to their PlanDefinition by the `{id}Logic` suffix." .

sgkg:CQLFile a owl:Class ;
  rdfs:subClassOf sgkg:Knowledge ;
  rdfs:label "CQL File" ;
  skos:notation "cql-library" ;
  rdfs:comment "A .cql file on disk, as opposed to the FHIR Library resource that wraps it. A node so that the mapping table's four CQL rows -- CQL Concepts and CQL Data Elements under Elements, CQL under Decision Tables, CQL IndicatorLogic under Indicators -- do not dead-end. It carries a name, a path and a hash and NOTHING about the logic: no expressions, no comment tags, no data requirements. 279 in the immunizations IG. The l3-cql subgraph is where that content belongs, and it is not built yet." .

sgkg:Measure a owl:Class ;
  rdfs:subClassOf sgkg:Knowledge ;
  rdfs:label "Measure" ;
  skos:notation "measure" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR Measure -- an indicator made computable. 41 in the immunizations IG, all declaring proportion-measure-cqfm; the SOP makes the profile depend on scoring type, which is why the profile is read rather than assumed. Joined to its L2 indicator by id convention (IMMZ.IND.08 -> IMMZIND08)." .

sgkg:Questionnaire a owl:Class ;
  rdfs:subClassOf sgkg:Knowledge ;
  rdfs:label "Questionnaire" ;
  skos:notation "questionnaire" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR Questionnaire -- a data-collection form over a logical model. 10 in the immunizations IG. Its `sdc-questionnaire-targetStructureMap` extension names the StructureMap that extracts it, which is a real canonical reference. The SOP states no linkId convention and none exists in the estate, so no edge is licensed on linkId." .

sgkg:StructureMap a owl:Class ;
  rdfs:subClassOf sgkg:Conformance ;
  rdfs:label "Structure Map" ;
  skos:notation "structure-map" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR StructureMap. The SOP requires them in threes -- QuestionnaireResponse to logical model, logical model to resource, and a grouping map -- so a count that is not a multiple of three is worth a look. 16 .fml files in the immunizations IG." .

sgkg:LogicalModel a owl:Class ;
  rdfs:subClassOf sgkg:Conformance ;
  rdfs:label "Logical Model" ;
  skos:notation "structure-definition" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A StructureDefinition with kind `logical` -- one data dictionary tab as a data structure. Distinct from `profile`, which constrains a FHIR resource: WHO's ArchiMate model has Logical Model realising Data Object while Profile realises Data Element, and the two are not interchangeable. 15 in the immunizations IG." .

sgkg:Profile a owl:Class ;
  rdfs:subClassOf sgkg:Conformance ;
  rdfs:label "Profile" ;
  skos:notation "profile" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A StructureDefinition constraining a FHIR resource. Separate from structure-definition for the reason above. 5 in the immunizations IG. Its internals -- differentials, element definitions, bindings -- are the clearest case of what this layer refuses to re-represent." .

sgkg:ValueSet a owl:Class ;
  rdfs:subClassOf sgkg:Conformance ;
  rdfs:label "Value Set" ;
  skos:notation "value-set" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR ValueSet. 192 in the immunizations IG -- the most numerous artefact of all. Indexed by canonical; its expansion, its compose rules and the codes it contains are terminology, which docs/SCOPE.md keeps at arm's length as firmly here as at L1." .

sgkg:CodeSystem a owl:Class ;
  rdfs:subClassOf sgkg:Conformance ;
  rdfs:label "Code System" ;
  skos:notation "code-system" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR CodeSystem. The SOP says each guideline defines one guideline-level code system holding a concept for every data dictionary element -- which is what makes `code[WHO] = IMMZ.DE9` on a logical model element resolvable. 6 in the immunizations IG. The codes themselves are not copied here." .

sgkg:ConceptMap a owl:Class ;
  rdfs:subClassOf sgkg:Conformance ;
  rdfs:label "Concept Map" ;
  skos:notation "concept-map" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR ConceptMap -- one per target code system in the dictionary's terminology mappings. 8 in the immunizations IG. Records that a mapping exists; the mappings themselves belong to terminology." .

sgkg:ActorDefinition a owl:Class ;
  rdfs:subClassOf sgkg:Conformance ;
  rdfs:label "Actor Definition" ;
  skos:notation "actor-definition" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR ActorDefinition -- an L2 persona made a FHIR resource. ZERO in the immunizations IG and 22 in smart-base, which is itself worth a coverage query. The SOP names no profile for it and says one is not currently possible because SUSHI cannot profile an R5 resource in an R4 IG, and it tells authors not to assign an identifier -- so expect a bare resource and do not infer more." .

sgkg:Requirements a owl:Class ;
  rdfs:subClassOf sgkg:Conformance ;
  rdfs:label "Requirements" ;
  skos:notation "requirements" ;
  rdfs:subClassOf sgkg:ExternalArtefact ;
  skos:note "Instances share the IRI of the External artefact they elaborate: one artefact, one address, described opaquely at the layer above and structurally here." ;
  rdfs:comment "A FHIR Requirements resource. The ONE place the published SOP names an SG profile -- SGRequirements -- and the grain is one resource per business process holding many statements, not one per requirement. ZERO in the immunizations IG and 41 in smart-base." .

### Value sets
# Closed code lists bound to class properties. validate.ts rejects any other value.

<http://smart.who.int/kg/valueset/structure-definition-kind> a skos:ConceptScheme ;
  skos:notation "structure-definition-kind" ;
  skos:note "source: http://hl7.org/fhir/ValueSet/structure-definition-kind" ;
  skos:note "bound to: structure-definition.kind" ;
  rdfs:comment "FHIR StructureDefinitionKind. Added by the smart-base migration: smart-kg named the property without binding it." .
<http://smart.who.int/kg/valueset/structure-definition-kind#primitive-type> a skos:Concept ; skos:inScheme <http://smart.who.int/kg/valueset/structure-definition-kind> ; skos:notation "primitive-type" ; skos:definition "A primitive type." .
<http://smart.who.int/kg/valueset/structure-definition-kind#complex-type> a skos:Concept ; skos:inScheme <http://smart.who.int/kg/valueset/structure-definition-kind> ; skos:notation "complex-type" ; skos:definition "A complex data type." .
<http://smart.who.int/kg/valueset/structure-definition-kind#resource> a skos:Concept ; skos:inScheme <http://smart.who.int/kg/valueset/structure-definition-kind> ; skos:notation "resource" ; skos:definition "A resource." .
<http://smart.who.int/kg/valueset/structure-definition-kind#logical> a skos:Concept ; skos:inScheme <http://smart.who.int/kg/valueset/structure-definition-kind> ; skos:notation "logical" ; skos:definition "A logical model." .

### Object properties

sgkg:implementedBy a owl:ObjectProperty ;
  rdfs:label "implementedBy" ;
  rdfs:comment "An L2 component is implemented by a FHIR artefact. Reused from l1 and licensed here per (component, resource) pair transcribed from the published mapping table. ALWAYS `inferred`, never `derived`: with no back-pointer extension in the estate, the join is a naming convention or a canonical reference, and every instance records which rule matched and a resolutionStatus. The optional `targetPath` property on an instance names the element reached (e.g. `PlanDefinition.action[2]`) so traceability can be element-level without this layer modelling FHIR internals as nodes." .

sgkg:citesSource a owl:ObjectProperty ;
  rdfs:label "citesSource" ;
  rdfs:comment "A FHIR artefact cites an L1 source through `relatedArtifact[type = #citation]`. The target is an l1:citation minted from the same string by tools/extract-citations.mjs, so L3 and L1 join without either extractor knowing about the other -- the same mechanism l2-dmn uses from a decision rule." .

sgkg:uses a owl:ObjectProperty ;
  rdfs:label "uses" ;
  rdfs:comment "One FHIR artefact references another by canonical: a PlanDefinition its Library, an action its ActivityDefinition, a Questionnaire its StructureMap, a Measure its Library. These are real canonical references rather than conventions, so unlike implementedBy they are `derived` when read straight from the field." .

### Licensed edges, as qualified sub-properties
# One per (source class, predicate, target class) triple the layer licenses.
# Domain and range on the sub-property is what preserves pairwise licensing: a single global
# domain/range on the predicate would be a union of everything and would permit pairs the
# model does not.

sgkg:implementedBy_BusinessProcessWorkflow_PlanDefinition a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:BusinessProcessWorkflow ;
  rdfs:range sgkg:PlanDefinition ;
  rdfs:label "Business Process Workflow implementedBy Plan Definition" .

sgkg:implementedBy_BusinessProcessWorkflow_ActivityDefinition a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:BusinessProcessWorkflow ;
  rdfs:range sgkg:ActivityDefinition ;
  rdfs:label "Business Process Workflow implementedBy Activity Definition" .

sgkg:implementedBy_BPMNProcess_PlanDefinition a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:BPMNProcess ;
  rdfs:range sgkg:PlanDefinition ;
  rdfs:label "BPMN Process implementedBy Plan Definition" .

sgkg:implementedBy_BPMNTask_ActivityDefinition a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:BPMNTask ;
  rdfs:range sgkg:ActivityDefinition ;
  rdfs:label "BPMN Task implementedBy Activity Definition" .

sgkg:implementedBy_DecisionSupportLogic_PlanDefinition a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:DecisionSupportLogic ;
  rdfs:range sgkg:PlanDefinition ;
  rdfs:label "Decision-Support Logic implementedBy Plan Definition" .

sgkg:implementedBy_DecisionSupportLogic_ActivityDefinition a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:DecisionSupportLogic ;
  rdfs:range sgkg:ActivityDefinition ;
  rdfs:label "Decision-Support Logic implementedBy Activity Definition" .

sgkg:implementedBy_DecisionSupportLogic_Library a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:DecisionSupportLogic ;
  rdfs:range sgkg:Library ;
  rdfs:label "Decision-Support Logic implementedBy Library" .

sgkg:implementedBy_DecisionSupportLogic_CQLFile a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:DecisionSupportLogic ;
  rdfs:range sgkg:CQLFile ;
  rdfs:label "Decision-Support Logic implementedBy CQL File" .

sgkg:implementedBy_DMNDecision_PlanDefinition a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:implementedBy ;
  rdfs:domain sgkg:DMNDecision ;
  rdfs:range sgkg:PlanDefinition ;
  rdfs:label "DMN Decision implementedBy Plan Definition" .

