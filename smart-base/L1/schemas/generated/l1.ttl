sgkg:presentedIn_KeyQuestion_PublicationElement a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:presentedIn ;
  rdfs:domain sgkg:KeyQuestion ;
  rdfs:range sgkg:PublicationElement ;
  rdfs:label "Key question presentedIn Publication element" .

sgkg:presentedIn_Evidence_PublicationSection a owl:ObjectProperty ;
  rdfs:subPropertyOf sgkg:presentedIn ;
  rdfs:domain sgkg:Evidence ;
