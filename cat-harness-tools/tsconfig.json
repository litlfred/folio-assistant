{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "adapters/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.d.mts",
    "types/**/*.d.ts",
    "test/**/*.ts",
    "pipeline/**/*.ts",
    "archimate/**/*.ts",
    "openapi/**/*.ts",
    "schemas/**/*.ts",
    "skills/**/*.ts",
    "tools/**/*.ts",
    "templates/**/*.ts",
    "ui/**/*.ts",
    "viewer/**/*.ts",
    "deploy/**/*.ts",
    "id-lookup/**/*.d.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "schemas/block-qa-schema/tests",
    "dist",
    "node_modules",
    "**/*.e2e.ts"
  ]
}
