# Committed docs pages carry no QA data: scripts/gen-docs-pages.ts writes a structure-only badge
# placeholder, and every corpus fact goes into the per-page qa-index.json and the
# translation-qa-pages.json list. Each Scenario names the test that executes it.
Feature: QA badge placeholders and the corpus-dependent QA indexes

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_badge_placeholder::is_a_pending_button_carrying_only_URLs_and_names_—_no_verdict,_no_swept-ness
  Scenario: The badge placeholder is a pending button carrying only URLs and names
    Given a block badge for key "overview.block" on page "demo"
    When its placeholder is generated
    Then it has class "fa-qa-badge fa-qa-pending fa-qa-fam-block"
    And its data-qa-index points at "/assets/qa/demo/qa-index.json"
    And its data-qa-src points at "/assets/qa/demo/overview.block.json"
    And it contains none of the verdict or swept-ness classes and texts, such as "fa-qa-unswept", "fa-qa-fail", "not swept" or "not available"

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_badge_placeholder::declares_itself_English,_left-to-right_—_bean_`giiw`
  Scenario: The badge placeholder declares itself English and left-to-right
    Given a translation badge for key "page.translation" on page "demo"
    When its placeholder is generated
    Then it opens as a button carrying lang "en" and dir "ltr"

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_badge_placeholder::every_committed_generated_page_carries_placeholders_only
  Scenario: Every committed generated page carries badge placeholders only
    Given the checkout's site pages generated by scripts/gen-docs-pages.ts that hold a QA badge, translated pages excluded
    When every QA badge on them is read
    Then at least one such page is found
    And every badge is a button whose class starts with "fa-qa-pending"

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_per-page_verdict_index::with_the_corpus:_rows,_and_`unswept`_as_its_own_sorted_list
  Scenario: With a corpus the verdict index holds rows and a sorted unswept list
    Given a corpus with a "warn" badge for "a.block" and unswept keys "z.block", "b.translation" and "z.block"
    When the QA index for page "demo" is generated
    Then its corpus is "present"
    And the badge for "a.block" has state "warn"
    And unswept is "b.translation", "z.block", deduplicated and sorted
    And the index passes the QA index schema

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_per-page_verdict_index::without_it:_`absent`,_and_no_rows_—_never_an_empty_answer_that_reads_as_'nothing_swept'
  Scenario: Without a corpus the verdict index says absent and holds no rows
    Given no corpus, though badge rows and unswept keys are passed in
    When the QA index for page "demo" is generated
    Then its corpus is "absent"
    And its badges and unswept list are empty
    And the index passes the QA index schema

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_per-page_verdict_index::the_schema_refuses_an_absent-corpus_index_that_claims_rows
  Scenario: The schema refuses an absent-corpus index that claims rows
    Given a QA index with corpus "absent" and a badge row for "a.block"
    When it is checked against the QA index schema
    Then it is refused

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_authored-page_translation_list::is_published_under_the_witness_tree,_not_as_a_Jekyll_data_file
  Scenario: The translation page list is not named as a Jekyll data file
    Given the translation QA pages file name
    Then it is "translation-qa-pages.json"
    And it does not start with an underscore
    # Gap: where the file is published is not checked, only its name

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_authored-page_translation_list::says_`absent`_rather_than_`[]`_when_there_was_no_corpus
  Scenario: The translation page list says absent rather than empty when there is no corpus
    Given pages "skills" and "index"
    When the list is generated with a corpus
    Then it is corpus "present" with pages "index" and "skills" in sorted order
    And when it is generated without a corpus it is corpus "absent" with no pages
    And both pass the translation pages schema

  @test:scripts/tests/ui/qa-badge-placeholder.test.ts::the_authored-page_translation_list::`head_custom.html`_no_longer_reads_it_from_`_data`
  Scenario: The site head include fetches the translation list instead of reading it from _data
    Given the site's _includes/head_custom.html
    Then it does not contain "site.data.translation-qa-pages"
    And it contains "/assets/qa/translation-qa-pages.json"
