# scripts/install-skills.ts installs each harness's skills into the agent hosts' skill
# directories under that harness's skillPrefix, marking each copy as its own.
# Each Scenario names the test that executes it.
Feature: Installing skills under a harness prefix

  @test:scripts/tests/install-skills.test.ts::renderInstalled::prefixes_the_name,_keeps_every_other_key_and_the_body,_and_marks_the_copy
  Scenario: Rendering an installed copy prefixes the name, keeps the other keys and body, and marks it
    Given a todo-manager skill with a name, a description, allowed-tools and a body
    When it is rendered as "cat-todo-manager" from "skills/todo-manager.md"
    Then the front matter reads name "cat-todo-manager" with the description and allowed-tools unchanged
    And the output carries the installed marker
    And it carries the comment "<!-- source: skills/todo-manager.md -->"
    And it ends with the original body

  @test:scripts/tests/install-skills.test.ts::renderInstalled::adds_a_name_when_the_source_has_none_(the_name_was_its_file_name)
  Scenario: A source without a name gets the prefixed name added
    Given a skill whose front matter has only a description
    When it is rendered as "fa-x"
    Then its first three lines are "---", "name: fa-x" and "description: d"

  @test:scripts/tests/install-skills.test.ts::renderInstalled::refuses_a_file_without_front_matter
  Scenario: A file without front matter is refused
    Given a file holding only "# just text"
    When it is rendered as an installed skill
    Then it throws an error mentioning front matter

  @test:scripts/tests/install-skills.test.ts::planInstall::a_skill_takes_ITS_instance's_prefix,_so_two_harnesses'_skills_do_not_collide
  Scenario: Same-named skills from two harnesses take their own prefixes and do not collide
    Given two todo-manager skills, one from an instance with prefix "cat" and one with prefix "fa"
    When the install is planned
    Then the planned files are "cat-todo-manager" and "fa-todo-manager"
    And no collision is reported

  @test:scripts/tests/install-skills.test.ts::planInstall::the_same_prefixed_name_twice:_the_later_source_(nearer_the_root)_wins,_and_it_is_reported
  Scenario: The later of two sources with the same prefixed name wins and the collision is reported
    Given two todo-manager skills both with prefix "cat", the later one holding "The root's own."
    When the install is planned
    Then "cat-todo-manager" holds the later source's text
    And one collision is reported, naming "a/skills/todo-manager.md" as lost and "b/skills/todo-manager.md" as won

  @test:scripts/tests/install-skills.test.ts::planInstall::no_prefix_on_the_skill's_instance_or_the_installing_root:_skipped_with_the_reason,_never_installed_bare
  Scenario: A skill with no prefix anywhere is skipped with the reason, never installed bare
    Given a skill "plain" with no prefix
    When the install is planned
    Then no file is planned
    And it is skipped as "c/skills/plain.md" because "neither its instance nor the installing harness declares skillPrefix"

  @test:scripts/tests/install-skills.test.ts::planInstall::a_skill_the_reader_marked_as_uninstallable_is_skipped_with_its_reason
  Scenario: A skill the reader marked uninstallable is skipped with its reason
    Given a prefixed skill marked to skip because it has no description
    When the install is planned
    Then its skip reason mentions "no description"

  @test:scripts/tests/install-skills.test.ts::ownedInstalls::only_directories_whose_SKILL.md_carries_the_marker_are_this_script's_to_remove
  Scenario: Only installed directories that carry the marker are owned by the script
    Given a host skills directory with "cat-old" whose SKILL.md carries the marker and "my-own" whose SKILL.md does not
    When the owned installs are listed
    Then only "cat-old" is listed
    And a directory that does not exist lists nothing

  @test:scripts/tests/install-skills.test.ts::unmarkedFiles_(bean_folio-assistant-dtda)::lists_every_file_under_a_host_skill_directory_that_lacks_INSTALLED_MARKER
  Scenario: Every file under a host skill directory without the installed marker is reported as unmarked
    Given a host skills directory with a marked "cat-good/SKILL.md", an unmarked "hand-written/SKILL.md" and a script "bpmn_author/validate.py"
    When the unmarked files are listed
    Then they are "bpmn_author/validate.py" and "hand-written/SKILL.md"
    And a directory that does not exist lists nothing

  @test:scripts/tests/install-skills.test.ts::readChecklistSkill_(bean_folio-assistant-cy4p)::names_it_process-<stem>,_keeps_the_checklist_body_unchanged,_and_describes_how_to_walk_it
  Scenario: A generated checklist becomes a process skill with a description of how to walk it
    Given a checklist generated by bpmn-checklist.ts from activity-log.bpmn, titled "Agent "activity" log: runs"
    When it is read as a skill
    Then its name is "process-activity-log"
    And its text ends with the checklist unchanged
    And its description is a double-quoted YAML string that parses as JSON
    And the description quotes the title, names "cat-harness/sdlc/processes/activity-log.bpmn" and mentions "next:"
    And the description ends with the checklist's summary line

  @test:scripts/tests/install-skills.test.ts::readChecklistSkill_(bean_folio-assistant-cy4p)::installs_under_the_prefix_like_any_skill,_from_its_generated_text
  Scenario: A checklist skill installs under the prefix like any other skill
    Given the activity-log checklist read as a skill with prefix "cat"
    When the install is planned
    Then "cat-process-activity-log" starts with its name and a description in the front matter
    And it carries the installed marker
    And it contains the checklist heading

  @test:scripts/tests/install-skills.test.ts::readChecklistSkill_(bean_folio-assistant-cy4p)::ignores_a_.checklist.md_that_bpmn-checklist.ts_did_not_write,_and_any_other_file
  Scenario: A hand-written checklist or any other file is not read as a checklist skill
    Given a ".checklist.md" file without the generated banner
    And a generated checklist saved as "notes.md"
    When each is read as a checklist skill
    Then neither yields a skill

  @test:scripts/tests/install-skills.test.ts::hosts_(bean_cat-tools-0nxe)::every_host_reads_<dir>/<name>/SKILL.md_natively,_each_from_its_own_documented_directory
  Scenario: Every host reads skills from its own documented directory
    # Gap: that each host reads <dir>/<name>/SKILL.md natively is not checked, only the directory table
    When the host table is read
    Then claude is ".claude/skills", antigravity ".agents/skills", gemini ".gemini/skills", cursor ".cursor/skills" and copilot ".github/skills"

  @test:scripts/tests/install-skills.test.ts::hosts_(bean_cat-tools-0nxe)::a_name_Cursor_would_refuse_(not_lowercase_letters,_digits_and_hyphens)_is_skipped_with_the_reason
  Scenario: A name Cursor would refuse is skipped with the reason
    Given a skill named "Bad_Name" with prefix "cat"
    When the install is planned
    Then no file is planned
    And its skip reason mentions "Cursor requires"
