#!/bin/sh
# Warn (and block) if lake-manifest.json is staged for commit.
# To intentionally commit it, use: git commit --no-verify

MANIFEST="content/quantum-observable-universe/lean/lake-manifest.json"

if git diff --cached --name-only | grep -qF "$MANIFEST"; then
    echo ""
    echo "⚠  $MANIFEST is staged for commit."
    echo ""
    echo "   This file is auto-generated by lake. If you intentionally"
    echo "   updated dependencies, re-run with:  git commit --no-verify"
    echo ""
    exit 1
fi

# Every declared directory's README is generated from the Knowledge Graph
# (`bun run readme:subgraphs`). A commit that changes the tree without
# regenerating them is refused here, as it would be in CI.
if command -v bun >/dev/null 2>&1; then
    # Through the runner: since the scripts left the root `package.json`,
    # `bun run readme:subgraphs:check` names no script there and fails on every
    # commit, which read as a stale README.
    if ! bun run --silent cat readme:subgraphs:check >/dev/null 2>&1; then
        echo ""
        echo "⚠  A directory README is stale. Run:  bun run cat readme:subgraphs"
        echo "   then stage the result. To commit anyway: git commit --no-verify"
        echo ""
        exit 1
    fi
    # Beans lose `$schema: bean/1.0.0` whenever the `beans` CLI rewrites them
    # (bean `ujiv`). Put it back. A retagged bean that is STAGED has to be
    # staged again, or the commit takes it untagged; one in a mounted store is
    # carried to its branch by `state:push` and needs nothing from git.
    # Exit 2 is "could not check" — no store on disk here, so nothing staged
    # can be a bean; say so and go on rather than block every commit.
    #
    # The script is run by its path, not through `bun run cat`, so a broken
    # runner cannot read as an untaggable bean and block every commit. The
    # path is the index layout first, then cat-harness-tools on its own.
    retag_script=""
    for p in cat-harness-tools/scripts/beans-retag.ts scripts/beans-retag.ts; do
        if [ -f "$p" ]; then retag_script="$p"; break; fi
    done
    if [ -z "$retag_script" ]; then
        retag_rc=2
        retagged=""
    else
        retagged="$(bun run "$retag_script" --print-paths 2>/dev/null)"
        retag_rc=$?
    fi
    if [ "$retag_rc" -eq 2 ]; then
        echo "note: the bean store is not on disk here, so no bean was retagged (bun run cat state:mount)"
    elif [ "$retag_rc" -eq 0 ]; then
        staged=""
        for f in $retagged; do
            # 1 = this path has staged changes; 0 = none; 128 = not in this repository.
            git diff --cached --quiet -- "$f" >/dev/null 2>&1
            if [ $? -eq 1 ]; then staged="$staged $f"; fi
        done
        if [ -n "$staged" ]; then
            echo ""
            echo "⚠  bun run cat beans:retag put \$schema: bean/1.0.0 back into beans this commit stages."
            echo "   Stage them again:  git add$staged"
            echo "   then commit again. To commit anyway: git commit --no-verify"
            echo ""
            exit 1
        fi
    else
        echo ""
        echo "⚠  A bean's tag could not be restored. Run:  bun run cat beans:retag"
        echo "   To commit anyway: git commit --no-verify"
        echo ""
        exit 1
    fi
    if ! bun run --silent iri:sync:check >/dev/null 2>&1; then
        echo ""
        echo "⚠  A release IRI is not at its instance's declared version. Run:  bun run iri:sync"
        echo "   then stage the result. To commit anyway: git commit --no-verify"
        echo ""
        exit 1
    fi
fi
