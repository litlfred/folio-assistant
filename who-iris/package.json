{
  "name": "@litlfred/who-iris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "folio-assistant-cor[e]",
    "../folio-assistant-cor[e]",
    "cat-harnes[s]",
    "../cat-harnes[s]",
    "cat-harness-tool[s]",
    "../cat-harness-tool[s]",
    "bootstrap-tool[s]",
    "../bootstrap-tool[s]"
  ],
  "dependencies": {
    "@litlfred/folio-assistant-core": "0.1.0",
    "jsonld": "8",
    "oxigraph": "^0.5.11",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1"
  },
  "scripts": {
    "check:catalogue": "bun run folio-assistant-core/scripts/check-catalogue.ts .",
    "iris:covers": "bun run folio-assistant-core/scripts/gen-covers.ts .",
    "iris:covers:check": "bun run folio-assistant-core/scripts/gen-covers.ts . --check",
    "dc:render": "bun run folio-assistant-core/scripts/dc-render.ts .",
    "dc:render:check": "bun run folio-assistant-core/scripts/dc-render.ts . --check",
    "iris:pages": "bun run scripts/gen-iris-pages.ts",
    "iris:pages:check": "bun run scripts/gen-iris-pages.ts --check",
    "site:catalogue": "bun run scripts/gen-iris-pages.ts --catalogue-into",
    "site:home": "bun run scripts/gen-iris-pages.ts --home-into",
    "iris:pot": "bun run scripts/gen-iris-pages.ts --extract-pot"
  },
  "checkoutScripts": {
    "check:catalogue": "bun run folio-assistant-core/scripts/check-catalogue.ts who-iris",
    "iris:covers": "bun run folio-assistant-core/scripts/gen-covers.ts who-iris",
    "iris:covers:check": "bun run folio-assistant-core/scripts/gen-covers.ts who-iris --check",
    "dc:render": "bun run folio-assistant-core/scripts/dc-render.ts who-iris",
    "dc:render:check": "bun run folio-assistant-core/scripts/dc-render.ts who-iris --check",
    "iris:pages": "bun run who-iris/scripts/gen-iris-pages.ts",
    "iris:pages:check": "bun run who-iris/scripts/gen-iris-pages.ts --check",
    "iris:pot": "bun run who-iris/scripts/gen-iris-pages.ts --extract-pot"
  },
  "overrides": {
    "zod": "^4.6.6",
    "undici": "^6.29.1",
    "@fastify/busboy": "^3.2.1",
    "katex": "^0.18.2"
  }
}
