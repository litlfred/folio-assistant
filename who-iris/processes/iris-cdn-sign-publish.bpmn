      <bpmndi:BPMNEdge id="Edge_DOA_Task_PublishTags" bpmnElement="DOA_Task_PublishTags"><di:waypoint x="1645" y="730"/><di:waypoint x="1645" y="1080"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
