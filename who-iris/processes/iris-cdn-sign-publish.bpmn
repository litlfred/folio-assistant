      <bpmndi:BPMNEdge id="Edge_DOA_Task_Upload" bpmnElement="DOA_Task_Upload"><di:waypoint x="1075" y="590"/><di:waypoint x="1075" y="1080"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Shape_DSR_cloudflare_git" bpmnElement="DSR_cloudflare_git"><dc:Bounds x="1620" y="1080" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1674" y="1087" width="90" height="36" /></bpmndi:BPMNLabel>
