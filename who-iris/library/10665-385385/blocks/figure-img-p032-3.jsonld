  "narrative": [
    {
      "text": "World map of the prevalence of chronic HBV infection among children aged under 5 years at country level, 2024 (Fig. 3.8), shaded in blues for <0.1%, 0.1–0.9% and ≥1%. The darkest shade (≥1%) covers most of sub-Saharan Africa and a few countries in Asia and the Western Pacific, while the Americas, Europe and Australia are in the lightest shade.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
        "id": "claude-code",
        "model": "not-disclosed",
