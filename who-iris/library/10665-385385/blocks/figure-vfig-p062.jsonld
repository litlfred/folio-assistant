  "narrative": [
    {
      "text": "Header row of Table 4.2 (coverage of HBV diagnosis and treatment by WHO region, 2024), with columns: WHO region; number of people with a chronic HBV infection in 2024 (millions, 95% UI); number who had been diagnosed by the end of 2024 (millions); number on treatment for HBV by the end of 2024 (millions); percentage diagnosed; percentage of those diagnosed who were on treatment; and percentage of all people with chronic HBV on treatment. No data rows are included.",
      "lang": "en",
      "state": "draft",
