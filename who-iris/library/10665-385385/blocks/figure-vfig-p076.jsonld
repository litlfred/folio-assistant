  "narrative": [
    {
      "text": "Cropped legend strip from Figure 5.5 (funding required for HBV and HCV diagnosis and treatment), showing colour keys for “HBV laboratory tests” (blue) and “HCV treatment” (dark green), plus a red key whose label is cut off.",
      "lang": "en",
      "state": "draft",
