  "narrative": [
    {
      "text": "Global status in 2024 of the GHSS viral hepatitis intervention coverage indicators, set against their 2025 and 2030 targets, grouped into hepatitis B vaccination, hepatitis B and C diagnosis and treatment, safety of blood and health-care injections, and harm-reduction services.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
