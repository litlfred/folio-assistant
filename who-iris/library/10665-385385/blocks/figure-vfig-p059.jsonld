  "narrative": [
    {
      "text": "Legend fragment of the map in Figure 4.10, with green categories Implemented in >95% of clinics, Implemented in 50–95% of clinics, Implemented in <50% of clinics, plus Policy not in place, No data and Not applicable; the map itself is not included.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
