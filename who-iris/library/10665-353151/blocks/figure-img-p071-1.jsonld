  "narrative": [
    {
      "text": "Screenshot of the WHO Digital Health Atlas website showing a map of East Africa with location pins. A side panel for Rwanda lists digital health projects, including the Rwanda Health Analytics Platform, Rwanda RMIS and RHMIS for COVID-19 Surveillance.",
      "lang": "en",
      "state": "draft",
