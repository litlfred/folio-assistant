  "narrative": [
    {
      "text": "Photograph of three young men outdoors in front of a tiled-roof house; two are seated and one stands holding a wooden farm tool on his shoulder, and each looks at a small red-and-white card in his hands.",
      "lang": "en",
      "state": "draft",
