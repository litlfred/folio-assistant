      "fac:narrative": [
        {
          "text": "The table explains what a strong (“We recommend…”) and a conditional (“We suggest…”) recommendation imply for patients, for clinicians and for policy-makers.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt7LJVddPRBy6F6BnEb"
          },
          "drafted_at": "2026-11-11"
        },
        {
          "text": "يوضح الجدول ما تعنيه التوصية القوية («نوصي…») والتوصية المشروطة («نقترح…») بالنسبة إلى المرضى والأطباء السريريين وراسمي السياسات.",
          "lang": "ar",
          "state": "draft",
          "drafted_by": {
