  "narrative": [
    {
      "text": "The table lists the eight new or updated recommendations on the management of TB in children and adolescents from the 2022 WHO consolidated guidelines, grouped under diagnostic approaches, treatment regimens and models of TB care. Each recommendation is followed by its status (new or updated), strength and certainty of evidence.",
      "lang": "en",
      "state": "draft",
