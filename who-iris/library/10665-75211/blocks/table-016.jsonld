  "narrative": [
    {
      "text": "The table gives three example questions for describing the eHealth vision for important stakeholder groups (who they are, their current experience of the health system, and how eHealth will improve it), with potential considerations for each.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
        "id": "claude-code",
        "model": "not-disclosed",
        "session": "https://claude.ai/code/session_01Qmmkt7LJVddPRBy6F6BnEb"
