  "narrative": [
    {
      "text": "For each of the three national contexts (experimentation and early adoption; developing and building up; scale up and mainstreaming), the table gives an example focus for the eHealth strategy and example actions.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
