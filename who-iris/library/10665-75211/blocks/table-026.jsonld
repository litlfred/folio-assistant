  "narrative": [
    {
      "text": "The table lists eight areas in which eHealth can bring benefits (from access to services and efficiency of service delivery to empowering individuals and innovation and growth), with examples for each.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
