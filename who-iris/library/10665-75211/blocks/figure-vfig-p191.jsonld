  "narrative": [
    {
      "text": "Chapter 2 opening ('Developing an eHealth monitoring and evaluation framework: overview') with a three-step chevron diagram: indicators (define indicators for eHealth), measures (define baseline and target measures for indicators) and governance (define supporting governance and processes).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
