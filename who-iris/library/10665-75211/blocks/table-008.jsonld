  "narrative": [
    {
      "text": "The table sets out a sample approach to engagement for each of the four stakeholder roles: decision-makers, key influencers, engaged stakeholders, and broader stakeholders and general public.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
