    },
    {
      "block": "library/10665-37905/blocks/prose-page-003",
      "source": "sections/page-003.md",
      "source_hash": "a818c40fbc7cdee5d0d091c42a1eb57d7e474ac3d5b5aba9e2d2bbb74b52d713",
      "narrative": [
        {
          "text": "The table of contents of the French WHO/UNICEF statement on accelerating immunization, listing sections from planning to evaluation and conclusion.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
