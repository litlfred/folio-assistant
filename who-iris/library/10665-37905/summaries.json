      "source_hash": "bdf76ed1e0672e4ae5e94790280b8ccd735444e4bdb544d9de1f210854b88bda",
      "narrative": [
        {
          "text": "The copyright and cataloguing page of the 1985 French WHO/UNICEF statement, with ISBN, reproduction rights and standard disclaimers. It also notes the treatment of proprietary names and the printer's details.",
          "lang": "en",
