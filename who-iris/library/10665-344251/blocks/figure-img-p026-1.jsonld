  "narrative": [
    {
      "text": "Green tile labelled “OE2” with a white icon of three circles of increasing size. Its text reads “Impulsar la ejecución de estrategias nacionales de salud digital” (advance the implementation of national digital health strategies).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
        "id": "claude-code",
        "model": "not-disclosed",
