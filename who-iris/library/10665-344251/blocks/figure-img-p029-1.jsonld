  "narrative": [
    {
      "text": "Orange tile labelled “OE3” with a white icon of a tilted rectangle balanced on a circle. Its text reads “Fortalecer la gobernanza en pro de la salud digital en los planos mundial, regional y nacional” (strengthen governance for digital health at global, regional and national levels).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
