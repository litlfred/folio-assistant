  "narrative": [
    {
      "text": "The table presents WHO's recommendations on home-based records for maternal, newborn and child health, followed by the Guideline Development Group's rationale and remarks on their use and implementation.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
        "id": "claude-code",
        "model": "not-disclosed",
