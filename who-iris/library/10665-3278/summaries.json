    {
      "block": "library/10665-3278/blocks/prose-sec-front-matter",
      "source": "sections/sec-front-matter.md",
      "source_hash": "d88a07c854d0f2c19f8897619bcd065bba0de4791e1f5e32ea90a18beb625235",
      "narrative": [
        {
          "text": "Opens a 2010 French-language WHO Executive Board report (EB128/9) on the Global Immunization Vision and Strategy, noting that vaccination averts about 2.5 million deaths a year yet 1.5 million child deaths remain vaccine-preventable. It recalls the relevant Health Assembly resolutions and reports rising global coverage between 2000 and 2009. It describes the shortfalls in reaching coverage targets, the millions of unvaccinated infants and new strategies for reaching underserved groups.",
          "lang": "en",
          "state": "draft",
