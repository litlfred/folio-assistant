      "source_hash": "f8a8085f3de99e2974b29d7a9d56f04ada481fc4a5aa4334c05107dd786ba55e",
      "narrative": [
        {
          "text": "A section heading fragment on reducing child mortality further through new vaccines.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
