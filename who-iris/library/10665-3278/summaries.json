    },
    {
      "block": "library/10665-3278/blocks/prose-sec-009",
      "source": "sections/sec-009-recherche-développement-et-production-de-vaccins.md",
      "source_hash": "6e79dc7d623a596e31df8f3ba3184c3d7bb3b04baf8c77aa9ef0997fb80e297c",
      "narrative": [
        {
          "text": "Describes WHO vaccine prequalification, which ensures that vaccines bought by UN agencies meet quality, safety and efficacy standards, including products from emerging economies. It also covers support for vaccine research and regulation in developing countries, including HIV vaccine research in Africa.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
