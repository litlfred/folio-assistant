  "narrative": [
    {
      "text": "Black-and-white photograph of a large group of smiling children crowded together, one holding a football. It is the opening photograph for Chapter III (Harm and benefit) (credit: WHO).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
