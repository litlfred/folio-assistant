    {
      "block": "library/10665-357088/blocks/prose-sec-030",
      "source": "sections/sec-030-4-implementation-considerations.md",
      "source_hash": "fbf68634df17b1f986c76ba487e4ec5897d1c461de338d8e076b85375266a113",
      "narrative": [
        {
          "text": "Discusses practical issues in implementing the guidelines, including access to rapid antigen assays, laboratory reflex screening and task sharing. It also covers access to essential antifungal medicines, especially flucytosine and liposomal amphotericin B, and adapting the toxicity monitoring package to available resources.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
    {
