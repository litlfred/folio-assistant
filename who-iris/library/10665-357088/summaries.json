      "source": "sections/sec-031-5-research-needs.md",
      "source_hash": "2754476bf8fcf388f708c197d8baa4f74d379df08980bd8e6803c253088cb3b3",
      "narrative": [
        {
          "text": "Lists research needs, such as screening at CD4 counts of 100–200, using blood antigen titres to predict meningitis, managing relapse and integrating screening into advanced HIV care packages.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
