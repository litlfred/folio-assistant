      "narrative": [
        {
          "text": "A short reference list citing the trial of single-dose liposomal amphotericin B for cryptococcal meningitis, a related qualitative study protocol and an MSF report on access to liposomal amphotericin B.",
          "lang": "en",
          "state": "draft",
