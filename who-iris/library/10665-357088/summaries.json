    {
      "block": "library/10665-357088/blocks/prose-sec-034",
      "source": "sections/sec-034-annex-1-process-for-developing-the-guidelines.md",
      "source_hash": "9446b4fe680d2d57d32a2faf70f3dacba5ea0b02d90eaddec78926d7853e44ea",
      "narrative": [
        {
          "text": "Annex 1 of the WHO cryptococcal disease guidelines outlines how they were developed, from the 2011 rapid advice and 2018 guidelines to a February 2022 Guideline Development Group meeting prompted by new evidence on induction therapy. It explains the use of GRADE to rate evidence certainty and set recommendation strength, and how evidence was summarized and presented. It also describes how declarations of interest from the Guideline Development Group and External Review Group were reviewed and managed.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
    {
