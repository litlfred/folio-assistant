    {
      "block": "library/10665-266967/blocks/prose-sec-001",
      "source": "sections/sec-001-by.md",
      "source_hash": "56eb0a0e816a29b28081da7f33d9df077d178f3c168ee87462c6d440f4172233",
      "narrative": [
        {
          "text": "Reviews antibody studies of HEP Flury vaccine and the authors' earlier findings, then explains that multiple doses of each vaccine were tested before and after challenge with pooled vaccine as control. The methods begin with the guinea-pigs used.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
