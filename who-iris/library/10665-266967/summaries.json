    {
      "block": "library/10665-266967/blocks/prose-sec-front-matter",
      "source": "sections/sec-front-matter.md",
      "source_hash": "2f81dd1565750d9a3553c414a0b0a187e0ae6beb6d8746602c7d97b07879d233",
      "narrative": [
        {
          "text": "The opening of a 1963 Bulletin article by Veeraraghavan and Subrahmanyan comparing duck-embryo and HEP Flury rabies vaccines with pooled sheep-brain vaccine in guinea-pigs. The abstract reports that the avian embryo vaccines gave little protection after infection, even at high doses, while pooled phenolized vaccine worked well. It concludes that the recommended human dose of duck-embryo vaccine is inadequate and HEP Flury vaccine is unsuited for post-infection treatment, before reviewing earlier work on the duck-embryo vaccine.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
