  "narrative": [
    {
      "text": "Annex A, a second sample registry screen with the same banner, navigation menu and side-bar, and a 'Health workforce data display' panel showing an 'Age Distribution' bar chart of total staff by age range; the tallest bars are 30-34 (4,067) and 65+ (6,699).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
