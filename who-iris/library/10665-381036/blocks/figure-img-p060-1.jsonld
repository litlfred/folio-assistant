  "narrative": [
    {
      "text": "Forest plot of sensitivity and specificity with 95% confidence intervals for 15 studies in children: sputum with a microbiological reference standard. Sensitivity ranges from 0.57 to 0.91 where estimable and specificity from 0.82 to 1.00.",
      "lang": "en",
      "state": "draft",
