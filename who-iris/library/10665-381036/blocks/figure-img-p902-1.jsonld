  "narrative": [
    {
      "text": "A forest plot of TBST sensitivity (%) in HIV-positive individuals, grouped by test: DST (≥5mm) 70.27% (53.87–82.71), DST (any induration size) 39.77% (30.11–50.30) and C-Tb (≥5mm) 68.75% (61.85–74.91). The overall random-effects pooled sensitivity is 63.49% (52.60–73.16) across 317 participants.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
