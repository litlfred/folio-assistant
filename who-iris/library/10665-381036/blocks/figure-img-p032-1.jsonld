  "narrative": [
    {
      "text": "Risk-of-bias and applicability-concerns chart for 13 studies of LC-aNAATs for detection of rifampicin resistance. Each study is rated high (red), unclear (yellow) or low (green) for patient selection, index test (LC-aNAATs), reference standard and flow and timing; most ratings are low.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
