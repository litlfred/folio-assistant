  "narrative": [
    {
      "text": "A forest plot of risk ratios (TBST vs TST) for rash, from four C-Tb studies (Aggerbeck 2018, Aggerbeck 2019, Hoff 2016, Ruhwald 2017). The overall random-effects pooled risk ratio is 0.80 (0.52–1.23).",
      "lang": "en",
      "state": "draft",
