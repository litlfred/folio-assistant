  "narrative": [
    {
      "text": "Forest plot of sensitivity and specificity with 95% confidence intervals for detection of rifampicin resistance in 13 studies (2 Truenat MTB-RIF Dx, 11 Xpert Ultra). Truenat MTB-RIF Dx sensitivities are 0.53 and 0.85; Xpert Ultra sensitivities are 0.93–1.00 where estimable, and specificities are 0.97–1.00 across studies.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
