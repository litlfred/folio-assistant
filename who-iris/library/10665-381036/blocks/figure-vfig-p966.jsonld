  "narrative": [
    {
      "text": "A PRISMA flowchart for the secondary systematic review (PPD-TST and IGRA), followed by body text: 652 records in EMBASE and 272 in MEDLINE; 407 records published since July 2011 after removing duplicates; 350 excluded after title and abstract screening; 57 reports assessed in full text, of which 28 were excluded for not reporting a clear health system perspective and costs and/or ICERs; 29 studies included in the review.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
