  "narrative": [
    {
      "text": "PRISMA flow diagram of study selection for Xpert Ultra. From 1267 database records (746 duplicates removed), 521 were screened, 110 reports were assessed for eligibility and 79 were excluded with reasons listed; 8 further records came from a WHO public call. 33 studies were included in the review.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
