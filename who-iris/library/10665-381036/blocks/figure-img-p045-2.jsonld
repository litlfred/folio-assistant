  "narrative": [
    {
      "text": "Forest plot of sensitivity and specificity with 95% confidence intervals, grouped by brand, for pulmonary TB in HIV-negative people against a microbiological reference standard: 4 Xpert Ultra studies (sensitivity 0.88 to 0.91) and 2 Truenat MTB Plus studies (0.97 and 0.88).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
