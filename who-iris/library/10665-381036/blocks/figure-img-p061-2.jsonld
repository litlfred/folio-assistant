  "narrative": [
    {
      "text": "Forest plot of sensitivity and specificity with 95% confidence intervals for 11 studies in children: sputum with a composite reference standard. Sensitivity is low, mostly 0.17–0.27 (highest 0.63, Yenew 2023), while specificity is 1.00 in all studies.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
