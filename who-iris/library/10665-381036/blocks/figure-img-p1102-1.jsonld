  "narrative": [
    {
      "text": "Diagram of people-related factors in test acceptability (Figure B3) shown as seven grey circles: Consumer demographics, Consumer experience, Perceptions of skin tests, Knowledge, Familiarity, Usefulness and Provider-consumer communication.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
