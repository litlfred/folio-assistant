  "narrative": [
    {
      "text": "Recommendations for asking about self-reported HIV status in future bio-behavioural surveys, grouped under survey design, questionnaire, ethical considerations, surveys in small communities and data use, with one recommendation per aspect of the survey.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
