  "narrative": [
    {
      "text": "The cover of 'Leave no one behind: guidance for planning and implementing catch-up vaccination': a photograph of a health worker vaccinating an infant held by a seated woman, under a dark blue title band, with the WHO logo. Listed among the WHO guidance this kit draws on.",
      "state": "draft",
      "drafted_by": {
