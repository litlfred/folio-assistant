  "narrative": [
    {
      "text": "The cover of 'Monitoring Metrics Related to the Global Covid-19 Vaccination Strategy in a Changing World', July 2022 update: a blue cover with line drawings of a virus particle and a syringe, and the WHO logo. Listed among the WHO guidance this kit draws on.",
      "state": "draft",
