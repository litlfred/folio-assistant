  "label": "Table 3a",
  "title": "Table 3a. “Best buy” interventions by risk factor",
  "file": "../tables/table-3a.csv",
  "headers": [
    "Risk factor (DALYs lost, millions; % GBD)",
    "Intervention/action (core set of “best buys”)",
