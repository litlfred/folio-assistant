  "narrative": [
    {
      "text": "The table lists the screening and diagnosis, and prevention, prophylaxis and pre-emptive treatment components of the package of care for children and adolescents with advanced HIV disease, indicating (Yes/No) whether each applies to children aged <5, 5–9 and 10–19 years.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
