  "narrative": [
    {
      "text": "Back-cover photo of a woman in an orange embroidered sari seen from behind in a dark doorway, carrying a sleeping young child on her shoulder, framed by pink walls and a teal metal door.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
