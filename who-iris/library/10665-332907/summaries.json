    {
      "block": "library/10665-332907/blocks/prose-sec-012",
      "source": "sections/sec-012-malnutrition.md",
      "source_hash": "7acdb4e5010ac80e40d9c4f1606f5d8610c66c8aa16ffba4e12d056c543be0ba",
      "narrative": [
        {
          "text": "Notes that severe acute malnutrition is common and deadly at HIV diagnosis and that malnutrition treatment should be part of children's HIV programmes. It then lists useful resources on child TB formulations, pneumonia management and malnutrition.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
