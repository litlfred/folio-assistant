    },
    {
      "block": "library/10665-332907/blocks/prose-sec-013",
      "source": "sections/sec-013-optimize.md",
      "source_hash": "e013e52152e4e824c47992295238aacf41bb5b24e54d5dcd56addb847937ebe1",
      "narrative": [
        {
          "text": "Reviews trials from South Africa and Kenya on the timing of antiretroviral therapy in children with severe acute malnutrition or hospitalization. It also stresses the risk of loss to follow-up and the need to link children to ongoing HIV care at discharge.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
