      "source": "sections/sec-014-counselling-and-support.md",
      "source_hash": "cd8e85e4e4c8db5c92044145e073503e77033bb94806ee75d26bf79b16970dcd",
      "narrative": [
        {
          "text": "Calls for more counselling and adolescent-friendly adherence support with earlier treatment initiation, and lists counselling resources.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
