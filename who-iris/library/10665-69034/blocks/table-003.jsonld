  "narrative": [
    {
      "text": "The table lists the proposed components of the immunization monitoring system to be assessed at district level and at health unit (HU) level, from recording and archiving to evidence of using data for action.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
