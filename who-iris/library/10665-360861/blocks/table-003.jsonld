  "narrative": [
    {
      "text": "Framework for differentiated PrEP service delivery: for each building block (where, who, when, what), the table names what has to be defined at initiation, initial follow-up and re-initiation, and during continuation (PrEP refills and follow-up).",
      "lang": "en",
