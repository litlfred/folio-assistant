  "narrative": [
    {
      "text": "Suggested kidney function testing at PrEP initiation and at follow-up for people taking TDF-containing oral PrEP, by population group defined by age (under 30, 30–49, 50+), kidney-related comorbidities and previous evidence of reduced kidney function.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
