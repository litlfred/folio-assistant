  "kind": "table",
  "label": "Table 2",
  "title": "Table 2. Pooled estimates of risk for active TB among household contacts stratified by age and baseline LTBI status as compared with the general population",
  "file": "../tables/table-2.csv",
  "headers": [
    "Age (years)",
    "No. of studies",
    "Risk ratio",
    "No. of studies",
    "Risk ratio",
    "No. of studies",
