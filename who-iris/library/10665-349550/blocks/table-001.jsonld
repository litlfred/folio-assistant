  "narrative": [
    {
      "text": "The table summarizes, for the elimination of mother-to-child transmission (EMTCT) of HIV, syphilis and hepatitis B virus (columns), the 2030 aspirational targets, the EMTCT impact targets and the process/programmatic targets (rows).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
