  "narrative": [
    {
      "text": "The table shows, with dots, the combinations of infections (HIV, syphilis, HBV) for which a country may apply for single, dual or triple validation of EMTCT.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
