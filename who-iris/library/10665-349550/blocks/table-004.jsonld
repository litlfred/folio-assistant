  "label": "Table 5.1",
  "title": "Table 5.1. Prevalence requirements, indicators and targets for certification on the PTE of MTCT of HIV, syphilis, and/or HBV",
  "file": "../tables/table-5-1.csv",
  "headers": [
    "Tier",
    "Infection",
    "Impact indicators for at least one year",
    "Process/programme indicators for at least two years"
