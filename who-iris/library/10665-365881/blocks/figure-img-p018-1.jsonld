  "narrative": [
    {
      "text": "Low-angle photograph of two masked women in yellow vests with Somali-language text, one carrying a backpack reading \"Daryeele Caafimaad ee u dhow gurigaaga\", walking past children against a blue sky in a settlement of tarpaulin shelters.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
