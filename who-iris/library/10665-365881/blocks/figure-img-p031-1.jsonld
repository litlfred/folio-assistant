  "narrative": [
    {
      "text": "Photograph of masked women and a man gathered outdoors around a blue poster in Somali headed \"Yaree Khatarta caabuqa korona\" showing illustrated prevention measures, with the SHF, WHO and Ministry of Health logos; one woman points to the poster.",
      "lang": "en",
      "state": "draft",
