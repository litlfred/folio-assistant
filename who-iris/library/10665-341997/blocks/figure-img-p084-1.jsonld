  "narrative": [
    {
      "text": "Persona profile poster for 'Jane, Community Health Worker (CHW)' with photos, 'My Tasks' (80% of time in the community checking in with families and counselling; 20% on administrative duties), 'My Workload', a 'My Typical Day' timeline from 8am to 7pm and a quote: 'Tools are never enough. The regimen changes daily and needs to be continually updated.' The bottom row lists barriers to providing reproductive health services: client beliefs, tracking clients, incentive and workload.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
