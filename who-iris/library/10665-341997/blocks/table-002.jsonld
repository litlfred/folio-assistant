  "narrative": [
    {
      "text": "The table describes the three key generic personas targeted by the family planning digital adaptation kit (auxiliary nurse midwife, midwife and nurse). For each occupational title it gives a description, other names used for the role and the corresponding ISCO occupation code.",
      "lang": "en",
      "state": "draft",
