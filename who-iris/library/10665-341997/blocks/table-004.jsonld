  "narrative": [
    {
      "text": "The table interprets the adolescent user scenario for system design. Its columns list the data elements to be collected, the decision logic to be embedded, the functional and non-functional requirements, and the adolescent-specific considerations to be triggered when the client’s age is 19 years or younger.",
      "lang": "en",
      "state": "draft",
