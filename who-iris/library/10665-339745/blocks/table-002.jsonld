  "narrative": [
    {
      "text": "The table describes the three key generic personas targeted by the antenatal care digital adaptation kit: the auxiliary nurse midwife, the midwife and the nurse. For each it gives a description of the role and training, other names used for the occupation and the ISCO occupation code.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
