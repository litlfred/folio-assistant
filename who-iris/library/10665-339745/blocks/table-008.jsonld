  "narrative": [
    {
      "text": "The table lists four data elements derived by calculation from core data elements: estimated due date, gestational age, body mass index and total weight gain. For each it gives the core data elements used as variables and the calculation formula.",
      "lang": "en",
      "state": "draft",
