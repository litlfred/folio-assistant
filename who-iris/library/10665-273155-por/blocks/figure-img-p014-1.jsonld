  "narrative": [
    {
      "text": "Photograph of a health worker in white with gloved hands holding an infant's foot and a filter-paper card with printed circles, some containing blood spots, while a woman holds the infant wrapped in a striped blanket.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
        "id": "claude-code",
        "model": "not-disclosed",
        "session": "https://claude.ai/code/session_01Qmmkt7LJVddPRBy6F6BnEb"
      },
      "drafted_at": "2026-11-11"
    },
    {
      "text": "صورة فوتوغرافية لعامل صحي يرتدي الأبيض ويداه في قفازين، يمسك قدم رضيع وبطاقة من ورق الترشيح عليها دوائر مطبوعة يحتوي بعضها على بقع دم، بينما تحمل امرأة الرضيع الملفوف ببطانية مخططة.",
      "lang": "ar",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
        "id": "claude-code",
