      "source": "sections/page-016.md",
      "source_hash": "0d2b3dd9df940a218955c658f9921e3d80b06c89dca306b23a2be2c1f6cd821a",
      "narrative": [
        {
          "text": "Acknowledgements naming the meeting participants and WHO staff who contributed to the update.",
          "lang": "en",
          "state": "draft",
