      "source_hash": "e7c63fb546ced56c03d5b81fda1305d8128f2a7f3d9e978b59310b018a83d49d",
      "narrative": [
        {
          "text": "Part of the reference list, citing studies on infant HIV diagnosis, point-of-care testing and treatment interruption.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
