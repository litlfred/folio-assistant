      "narrative": [
        {
          "text": "Draft Assembly resolution (in Russian) on intensifying research into tropical parasitic diseases. It urges Member States to expand national research and asks the Director-General to strengthen WHO research on diseases such as malaria, onchocerciasis and schistosomiasis and to report back.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
