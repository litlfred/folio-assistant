      "narrative": [
        {
          "text": "Draft Assembly resolution (in Russian) on psychosocial factors and health, stating that WHO should begin programmes on how these factors affect general and mental health and health services. It asks the Director-General to set up multidisciplinary programmes and report to the Executive Board and Assembly.",
          "lang": "en",
          "state": "draft",
