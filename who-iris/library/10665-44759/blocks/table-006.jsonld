  "narrative": [
    {
      "text": "GRADE summary of findings on IGRAs (T-SPOT, QFT-G/QFT-GIT) compared with TST for diagnosing active TB in children in low- and middle-income countries. Rows cover overall diagnostic accuracy, proportion of indeterminate results, performance in HIV-infected children and performance in children under 5, by index test; columns give participants, pooled sensitivity/specificity or indeterminate rates, what the results mean at 10% and 30% prevalence, and quality of evidence.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
