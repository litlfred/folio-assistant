  "narrative": [
    {
      "text": "GRADE summary of findings on IGRAs for diagnosing latent TB infection in children in low- and middle-income countries. Rows are outcomes (predictive value for active TB, performance against a dichotomous exposure measure, performance against exposure gradients); columns give participants per test, principal findings (pooled odds ratios, correlations, regression slopes for QFT, T-SPOT and TST), their meaning, quality of evidence and importance.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
        "id": "claude-code",
        "model": "not-disclosed",
