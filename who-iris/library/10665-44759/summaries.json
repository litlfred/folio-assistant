  "summaries": [
    {
      "block": "library/10665-44759/blocks/prose-sec-000",
      "source": "sections/sec-000-1-background.md",
      "source_hash": "14a39054271e363c45054aa4d7c02d5da266b57edcfdb4c4563816d5e6d387b9",
      "narrative": [
        {
          "text": "Describes the background to the IGRA policy statement, noting that about a third of the world's population has latent TB infection and that the tuberculin skin test long was the only detection tool, with known limitations. It explains how IGRAs work and their growing commercial promotion in high-burden settings. It argues that their role needed evaluation in low- and middle-income countries with limited public health resources.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
    {
      "block": "library/10665-44759/blocks/prose-sec-001",
      "source": "sections/sec-001-2-methods.md",
      "source_hash": "8696622f344183c4f73993a175acb8daa6418a5cc29099e5d2d762cba2d6f7f2",
      "narrative": [
        {
          "text": "A section heading for the methods chapter, with no further text.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
