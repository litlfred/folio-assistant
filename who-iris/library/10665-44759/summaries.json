    {
      "block": "library/10665-44759/blocks/prose-sec-002",
      "source": "sections/sec-002-21-evidence-synthesis.md",
      "source_hash": "2b11fa20d932e0087e94889aa3376a56fcebe77baa28ce3197ba6f94c628a36b",
      "narrative": [
        {
          "text": "Describes the evidence synthesis behind the IGRA policy, following WHO's process of systematic reviews and meta-analysis of diagnostic accuracy studies followed by an Expert Group review using the GRADE approach. It sets out how studies were selected, data extracted and quality assessed. It explains how results were pooled, or summarized when fewer than four studies were available.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
    {
      "block": "library/10665-44759/blocks/prose-sec-003",
      "source": "sections/sec-003-22-decision-making-during-the-expert-group-meeti.md",
      "source_hash": "2d96a0127a67d5f4fc30a2f5dbd95d3eaa3d43bb827a97b48ef4c9919ba66a24",
      "narrative": [
        {
          "text": "Explains that the Expert Group reviewed the systematic reviews in advance and reached decisions by consensus, with members' concerns recorded in the meeting report. The final policy was approved by WHO's Guidelines Review Committee.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
    {
      "block": "library/10665-44759/blocks/prose-sec-004",
      "source": "sections/sec-004-23-scope-of-the-policy-guidance.md",
      "source_hash": "663fa61030e1e152c3648567b617024da83bd354c44caea6944492bc8bc28359",
      "narrative": [
        {
          "text": "Defines the scope of the policy guidance as a pragmatic summary of evidence and recommendations on IGRAs in low- and middle-income countries, intended for national TB programme managers and to be read with the Expert Group report.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
