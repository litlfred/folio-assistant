      "source_hash": "b6b63a4852399f93e15f027e650aead0261b252d2d4b823ff73da3b4675b5b59",
      "narrative": [
        {
          "text": "Describes the studies on IGRAs for screening health care workers, very few of them from low- and middle-income settings, with widely varying designs and exposure risks.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
