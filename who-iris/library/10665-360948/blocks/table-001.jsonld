  "narrative": [
    {
      "text": "The table lists the minimum data elements recommended for recording viral hepatitis (HBV and HCV) information in HIV programmes, grouped by topic area: testing and diagnosis, treatment initiation and continuation, and monitoring of treatment effectiveness.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
