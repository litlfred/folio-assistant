  "narrative": [
    {
      "text": "The table lists the HIV antibody assays (by manufacturer and product name) used by the laboratories participating in the WHO quality assessment exercise, with the number of laboratories using each.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
