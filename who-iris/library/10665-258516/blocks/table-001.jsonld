  "narrative": [
    {
      "text": "Laboratory and point-of-care tests for people starting and using HIV pre-exposure prophylaxis (PrEP): for each pathogen or analyte (HIV, creatinine, hepatitis B and C, pregnancy, syphilis, gonorrhoea and chlamydia) the table gives where testing can be done and its timing and frequency.",
      "lang": "en",
      "state": "draft",
