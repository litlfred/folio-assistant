  "narrative": [
    {
      "text": "An oval rubber stamp on the results form reading “Central Public Health Laboratories, Ministry of Health, Virology Lab”, with a small coat of arms inside.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
