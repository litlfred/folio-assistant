  "narrative": [
    {
      "text": "The table gives the ranges of sensitivity and specificity of computer-aided detection (CAD) software and of human readers interpreting digital chest X-rays for bacteriologically confirmed TB, separately for the screening and triage use cases, alongside the WHO target product profile.",
      "lang": "en",
      "state": "draft",
