  "label": "Table 3",
  "title": "Table 3. Diagnostic accuracy of symptoms, chest radiography, and molecular WHO-recommended rapid diagnostic tests for screening for TB disease",
  "file": "../tables/table-3.csv",
  "headers": [
    "Screening test",
    "No. of studies (no. of participants)",
    "Sensitivity",
    "No. of studies (no. of participants)",
