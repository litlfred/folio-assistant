  "narrative": [
    {
      "text": "The table lists the six PICO questions addressed by the guideline update, and for each summarizes the systematic review methods: review type, review lead or team, search dates, databases searched, and the number and design of included studies.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
