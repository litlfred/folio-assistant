  "narrative": [
    {
      "text": "The four GRADE levels of certainty of evidence (high, moderate, low, very low), each with what it means for confidence that the true effect is close to the estimated effect.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
