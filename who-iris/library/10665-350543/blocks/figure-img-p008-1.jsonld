  "narrative": [
    {
      "text": "Stacked bar chart of HIV funding in Belarus by source for 2008–2011, with public funds (blue) and international funds (green) in US dollars. Totals are US$ 18.6 m in 2008 (13 536 983 public, 5 078 724 international), US$ 16.7 m in 2009 (11 351 741 and 5 308 642), US$ 19.7 m in 2010 (13 246 041 and 6 476 941) and US$ 19.9 m in 2011 (9 668 805 and 10 195 678); the international share rises until it exceeds public funds in 2011.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
