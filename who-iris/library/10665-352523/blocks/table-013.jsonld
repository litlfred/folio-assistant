  "narrative": [
    {
      "text": "Recommended dose and dose range in mg/kg body weight for the four first-line TB medicines (isoniazid, rifampicin, pyrazinamide, ethambutol) in children and young adolescents aged 0–14 years.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
