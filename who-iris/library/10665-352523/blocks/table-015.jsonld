  "narrative": [
    {
      "text": "Number of child-friendly tablets of first-line TB medicines per weight band: HRZ 50/75/150 mg and ethambutol 100 mg in the intensive phase and HR 50/75 mg in the continuation phase; adult dosages are recommended from 25 kg.",
      "lang": "en",
      "state": "draft",
