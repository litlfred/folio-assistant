  "narrative": [
    {
      "text": "Treatment regimens for extrapulmonary TB by age group and type (peripheral lymph node TB, other EPTB, TB meningitis, osteoarticular TB), giving intensive-phase and continuation-phase regimens; the 6-month intensive TBM regimen has no separate continuation phase.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
