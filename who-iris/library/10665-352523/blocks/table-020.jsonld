  "narrative": [
    {
      "text": "Possible individualized MDR/RR-TB regimens for children and adolescents according to fluoroquinolone susceptibility (susceptible, resistant, or resistant also to bedaquiline with or without clofazimine), with the core regimen and additional medicines that may be added.",
      "lang": "en",
      "state": "draft",
