  "narrative": [
    {
      "text": "Doses of the recommended TB preventive treatment regimens (3HR, 3HP, 1HP, 6H or 9H, 4R) by age and body weight. Each regimen gives mg/kg doses by age and, where applicable, nested sub-tables with the number of tablets per weight band for each formulation.",
      "lang": "en",
      "state": "draft",
