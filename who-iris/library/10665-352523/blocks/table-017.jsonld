  "narrative": [
    {
      "text": "Doses by weight band for adolescents on the 4-month 2HPMZ/2HPM regimen: isoniazid, rifapentine and moxifloxacin doses are the same for all weight bands in both phases, while the pyrazinamide dose (intensive phase only) varies by weight.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
