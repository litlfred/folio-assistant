  "narrative": [
    {
      "text": "Preferred, alternative and special-circumstance first-line antiretroviral regimens for neonates, children and adolescents on TB treatment. In the printed table, colour indicates whether each regimen needs no change, a dose adjustment or a change of regimen with TB treatment.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
