  "narrative": [
    {
      "text": "Assessments recommended at the end of treatment to detect post-TB lung disease in children with non-severe and severe pulmonary TB (clinical assessment, chest X-ray, spirometry, health-related quality of life).",
      "lang": "en",
      "state": "draft",
