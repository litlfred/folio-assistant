    {
      "block": "library/9789240122925-eng/blocks/prose-sec-010",
      "source": "sections/sec-010-23-status-of-health-workforce-data-in-2025.md",
      "source_hash": "1196a571b77ea13daeaa1cda0f3b3ac1627bea191e0440f6d216617e64a527be",
      "narrative": [
        {
          "text": "Analyses 2025 NHWA data availability, timeliness, periodicity, and disaggregation across indicators, occupations, and key health workforce topics, showing an nearly 20-fold increase in platform data volume from 12 587 data points in 2018 to 248 873 in 2025.",
          "lang": "en",
          "state": "draft",
