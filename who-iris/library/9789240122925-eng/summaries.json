    {
      "block": "library/9789240122925-eng/blocks/prose-sec-015",
      "source": "sections/sec-015-41-global-population-demographic-changes-2024203.md",
      "source_hash": "b351b7bc367d1d308b22dffd764f3af7ad4c4120ff3003ef1d1b9abdef130c0b",
      "narrative": [
        {
          "text": "Illustrates 2024 global population age pyramids across World Bank income groups using UN World Population Prospects 2024 data, contrasting predominantly young populations in low-income countries with older populations in high-income countries.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
