    },
    {
      "block": "library/9789240122925-eng/blocks/prose-sec-005",
      "source": "sections/sec-005-12-what-is-the-nhwa.md",
      "source_hash": "ee55cac7676604ecc863ec6c0c31dd87f64e4a97dac6eaa150e13e9ccd188e63",
      "narrative": [
        {
          "text": "Defines the National Health Workforce Accounts (NHWA) as a country-led system for progressively improving the availability, quality, and use of health workforce data across ten modules following the health labour market framework to support universal health coverage and the SDGs.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://e083ca61-5100-484e-9e88-6af4ce3f56a1"
          },
          "drafted_at": "2026-10-30"
        }
      ]
    },
    {
