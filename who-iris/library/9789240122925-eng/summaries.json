    {
      "block": "library/9789240122925-eng/blocks/prose-sec-004",
      "source": "sections/sec-004-11-historical-overview-of-health-workforce-data.md",
      "source_hash": "c594d5a8cdb67d6f74eb95ae90255224922ff3b216c6e320a875933231c873b6",
      "narrative": [
        {
          "text": "Traces twenty years of global initiatives, World Health Assembly resolutions (including WHA63.16 and WHA69.19), and WHO guidelines from 2004 to 2023 that established and expanded the National Health Workforce Accounts (NHWA) and human resources for health information systems.",
          "lang": "en",
          "state": "draft",
