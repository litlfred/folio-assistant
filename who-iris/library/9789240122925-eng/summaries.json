    {
      "block": "library/9789240122925-eng/blocks/prose-sec-012",
      "source": "sections/sec-012-31-global-and-regional-estimates.md",
      "source_hash": "dfe5a6558f945f2e04cd9a0304fd6fea269b1a71dce7854d1d703a5c14878e58",
      "narrative": [
        {
          "text": "Presents 2024 global, regional, and income-group stock and density estimates totaling 70.9 million health and care workers (15.1 million medical doctors, 31.0 million nursing personnel, 2.3 million midwifery personnel, 2.6 million dentists, 4.1 million pharmacists, and 15.7 million other occupations), highlighting stark regional and income-group disparities.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://e083ca61-5100-484e-9e88-6af4ce3f56a1"
          },
          "drafted_at": "2026-10-30"
        }
      ]
    },
    {
      "block": "library/9789240122925-eng/blocks/prose-sec-013",
      "source": "sections/sec-013-32-global-and-regional-trends.md",
      "source_hash": "268902bd713a00a41e09b6428d458bb597a16982ce8a0848bfda0b0caa4382d1",
      "narrative": [
        {
          "text": "Examines global and regional trends in health workforce stock and density from 2006 to 2025, showing a 52% global increase in the combined density of SDG 3.c.1 occupations from 44.8 to 67.9 per 10 000 population alongside a projected global shortage of 11.1 million health workers by 2030.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "conversation://e083ca61-5100-484e-9e88-6af4ce3f56a1"
          },
          "drafted_at": "2026-10-30"
        }
      ]
    },
    {
