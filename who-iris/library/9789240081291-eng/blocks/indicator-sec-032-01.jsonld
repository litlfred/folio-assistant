  "meta": {
    "indicatorId": "1-10",
    "module": "Module 1: Stock and flow",
    "abbreviatedName": "Annual outflows of health workers",
    "name": "Ratio of active health workers leaving the health labour market to the total stock of active health workers",
    "numerator": "Number of health workers who became inactive in the health labour market",
    "denominator": "Total number of active health workers, defined in headcounts",
    "disaggregation": "By occupation, by occupation and type of exit (voluntary vs involuntary), by occupation, type of exit and sex",
    "definition": "Percentage of active health workers who became inactive in the health labour market\ndue to voluntary reason or involuntary reason\nThe disaggregation by type of exit has the following two categories:\n• Voluntary exit corresponds to the following situations: emigration, temporary leave, change of\nsector, early retirement or other voluntary reason. Only early retirement should be considered\nas voluntary exit; retirement at standard age is to be counted in the involuntary exit.\n• Involuntary exit corresponds to the following situations: death, retirement (excluding\nearly retirement), suspension from work, long-term illness or other involuntary reason.\nFor the total number of active health workers, data at the end of the previous year should be used.",
    "glossary": "Active health worker; Activity level; Sex; Occupation",
    "reportingFrequency": "Annual",
    "reportingFrameworks": "SCORE for Health Data Technical Package (SCORE)",
    "dataSources": "Health workforce registry or database; Professional council/chamber/association registers; Aggregate data from health facilities (routine administrative records, Health Management Information System, District Health Information System census and/or survey); Data from pension and/or retirement administration units; Mortality records",
