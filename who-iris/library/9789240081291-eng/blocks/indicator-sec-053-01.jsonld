    "indicatorId": "4-05",
    "module": "Module 4: Working conditions, governance and leadership",
    "abbreviatedName": "National capacity to monitor key metrics for health workforce planning and global monitoring frameworks",
    "name": "Capacity of national human resources for health information systems to monitor key metrics relevant for national health workforce planning and policy-making and for global monitoring frameworks",
    "definition": "This indicator is a composite of nine sub-indicators, see below. The response to these nine\nsub-indicators is aggregated as a score (see part II on methods) on a scale from 1 (nascent)\nto 5 (sustainable).\nEach sub-indicator is a self-assessment of one aspect of the capacity of the national human\nresources for health information system (HRHIS) or other mechanisms to report on key metrics\nthat are relevant for national health workforce planning and policy-making as well as for global\nmonitoring frameworks. To help answer some of these self-assessed sub-indicators, guiding\nquestions are provided.",
    "glossary": "International Health Regulations; Subnational level; Active health worker; Occupation; Remuneration; Status in employment; Gender",
    "reportingFrequency": "Annual",
    "reportingFrameworks": "Global Strategy for Human Resources for Health: Workforce 2030 (GSHRH), Working for Health programme, Global Strategic Directions for Nursing and Midwifery (SDNM), SCORE for Health Data Technical Package (SCORE)",
    "dataSources": "Ministry of Health and regional ministries of health; Professional chambers; Institutions or units responsible for monitoring, or for policies on the health workforce; Ministry of Labour; National Statistical Office; National Focal Point for WHO Global Code of Practice; Ministry of Health and subnational ministries of health; Institutions collecting health workforce data",
    "furtherInformation": "(6, 9, 31, 51, 63, 98-100)",
    "source_number": "4-05",
