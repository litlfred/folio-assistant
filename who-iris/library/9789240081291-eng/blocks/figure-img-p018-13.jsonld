  "narrative": [
    {
      "text": "A small cover thumbnail in Figure 2 showing the WHO report \"World health statistics 2022: monitoring health for the SDGs, sustainable development goals\": a pale teal cover with the title at the top left, a circular globe illustration, and the WHO logo at the bottom.",
      "lang": "en",
      "state": "draft",
