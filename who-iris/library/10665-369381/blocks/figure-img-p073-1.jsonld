  "narrative": [
    {
      "text": "Line chart “F. 4.8 – Malaria cases diagnosed and treated” for each month of 2019 (per the caption, dispensary C), with lines for suspected malaria cases, suspected cases tested, confirmed malaria, presumed malaria and confirmed malaria given ACT. Suspected cases peak at about 600 in June; tested cases peak at about 355 in June and drop to about 15 in July, when presumed malaria rises to about 430.",
      "lang": "en",
      "state": "draft",
