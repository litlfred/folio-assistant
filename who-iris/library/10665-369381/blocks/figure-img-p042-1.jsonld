  "narrative": [
    {
      "text": "Line chart “DM. 3.1 – Outpatient department visits new and repeat” for each month of 2019. New visits are about 8 000–9 000 a month, rise to about 16 500 in June, fall to a low of about 4 000 in September and recover to about 7 000–7 500; repeat visits follow the same pattern at a lower level (about 2 300–6 500).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
        "id": "claude-code",
        "model": "not-disclosed",
