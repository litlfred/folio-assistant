  "narrative": [
    {
      "text": "100% stacked bar chart “F. 1.5 – Inpatient proportional mortality, top 10 causes of death, Dec 2019 ranking (%)” showing the monthly share of inpatient deaths in 2019 by the same 11 cause categories. “Other conditions, not classified elsewhere” is the largest share in most months (about 20–38%); injuries reach about 20% in September; March has no data.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
