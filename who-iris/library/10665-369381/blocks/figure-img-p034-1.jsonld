  "narrative": [
    {
      "text": "100% stacked bar chart “DA. 1.5 – Inpatient proportional mortality – top 10 causes of death, 2019 ranking (%)” for 2015–2019, with categories: other conditions not classified elsewhere, pneumonia, malaria, HIV disease, NCDs, diarrhea, anaemias, certain perinatal conditions, injuries, measles and all other specified causes. “Other conditions” stays at about 27–28% each year; the pneumonia share rises from about 9% to about 17% in 2019 while the malaria share shrinks.",
      "lang": "en",
      "state": "draft",
