      "narrative": [
        {
          "text": "A table of health service resource indicators covering infrastructure, beds, bed occupancy, length of stay, workforce, medicines and finance, with definitions, calculations and disaggregation.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
