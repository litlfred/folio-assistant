      "source": "sections/sec-025-221-morbidity-indicators.md",
      "source_hash": "05827168b9203cd69f2bc25a06dff50994e70f87a9852a8ffdd93ceeb2aea23c",
      "narrative": [
        {
          "text": "Tabulates the morbidity indicators, covering leading inpatient and outpatient diagnoses and cases of diseases under surveillance, with their calculation and disaggregation.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
