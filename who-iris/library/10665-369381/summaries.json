    {
      "block": "library/10665-369381/blocks/prose-sec-031",
      "source": "sections/sec-031-312-about-the-data.md",
      "source_hash": "d83e24a93f44e3b57c14c1ace40fe08d0dff128bbc200431dd2ea6f1de83d796",
      "narrative": [
        {
          "text": "Explains the concepts of health service utilization and access for a WHO guide on analysing routine health facility data, noting that utilization is often used as a rough proxy for access. It introduces three ways of analysing utilization and service availability data. Worked examples from the fictional Lupara district show outpatient visits by age and sex, with questions for the reader.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
