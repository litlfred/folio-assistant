    {
      "block": "library/10665-369381/blocks/prose-sec-023",
      "source": "sections/sec-023-213-analysis.md",
      "source_hash": "65daf67d8bc8ac5935d30fa45c67e1a25731086a87c7dd26a2f25d5d71287bc1",
      "narrative": [
        {
          "text": "Describes how to record causes of death and analyse institutional mortality by overall levels, leading causes and specific causes, using charts from the sample district. It discusses indicators such as stillbirths, neonatal and maternal deaths, case fatality rates and perioperative mortality. The section ends with factors affecting emergency unit mortality and the need to investigate unexpected rises.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
