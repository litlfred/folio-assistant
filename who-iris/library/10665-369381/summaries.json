        }
      ]
    },
    {
      "block": "library/10665-369381/blocks/prose-sec-045",
      "source": "sections/sec-045-413-core-analysis.md",
      "source_hash": "8ffa08c6272a2e48081649d7774ab0bd9052af1daedc05c5dd38ee2f8ba7662f",
      "narrative": [
        {
          "text": "Presents core analyses of health service resources, starting with facility density and distribution drawn from a master facility list, and hospital bed density. Further indicators assess efficiency through bed occupancy and length of stay, as well as health workforce availability and medicine stock-outs. The section ends with health finance, asking readers to interpret Lupara district's 2019 budget execution and plan spending for the last quarter.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
