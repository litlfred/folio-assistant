    {
      "block": "library/10665-369381/blocks/prose-sec-027",
      "source": "sections/sec-027-223-core-analysis.md",
      "source_hash": "8dc5792a040dab3df40f80f6f5030bcc2cec491b78354d6303d03bee0ddbd65f",
      "narrative": [
        {
          "text": "Describes analysing leading causes of morbidity through ranked top-10 lists of outpatient and inpatient diagnoses, counting only new outpatient cases. It also covers tracking cases of selected diseases under surveillance to spot outbreaks. Charts from the fictitious district illustrate both analyses with interpretation questions.",
          "lang": "en",
