    {
      "block": "library/10665-369381/blocks/prose-sec-021",
      "source": "sections/sec-021-211-mortality-indicators.md",
      "source_hash": "1352112a6c467c4730fdca95c6677d981de6ecd686bc0aff268a1978051985c6",
      "narrative": [
        {
          "text": "Tabulates the institutional mortality indicators, giving definitions, calculations, disaggregation and level of use for inpatient mortality, stillbirths, neonatal and maternal deaths, case fatality and surgical and emergency mortality.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
