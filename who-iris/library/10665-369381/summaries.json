      "source": "sections/sec-018-17-sample-indicators-for-integrated-health-servi.md",
      "source_hash": "f6acd68f71e467234ff6657ecd634df48f057568552b01ad8193be6f82b5a454",
      "narrative": [
        {
          "text": "Lists the sample indicators for integrated health service analysis, grouped under health status, such as institutional mortality and morbidity, and health service performance, such as utilization, coverage, quality and resources.",
          "lang": "en",
          "state": "draft",
