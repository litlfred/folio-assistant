    {
      "block": "library/10665-369381/blocks/prose-sec-044",
      "source": "sections/sec-044-412-about-the-data.md",
      "source_hash": "c638a051b2a06465375b466d316179c7063366f4928962d71f93a88d1221638f",
      "narrative": [
        {
          "text": "Explains that resources such as facilities, equipment, staff, medicines and finance are needed to deliver services and that resource data can shed light on performance. It notes that such data are often held outside routine information systems, for example in administrative and finance databases.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
