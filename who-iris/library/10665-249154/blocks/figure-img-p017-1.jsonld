  "narrative": [
    {
      "text": "Photograph of a strip of eight reaction tubes under ultraviolet light (Figure 2): the four tubes on the left are clear, while the four on the right show bright green fluorescence at the bottom, illustrating negative and positive TB-LAMP results.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
