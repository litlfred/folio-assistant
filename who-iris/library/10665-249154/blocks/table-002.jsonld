  "narrative": [
    {
      "text": "The table gives the review authors’ QUADAS-2 judgements (low, high or unclear) for each of the 13 TB-LAMP studies: risk of bias in four domains (patient selection, index test, reference standard, flow and timing) and applicability concerns in three domains.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
