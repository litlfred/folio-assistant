  "narrative": [
    {
      "text": "Forest plot of TB-LAMP sensitivity and specificity with 95% confidence intervals against culture reference Standard 2 (Figure 5), with TP, FP, FN and TN counts for ten studies, adding India (Demo), Malawi (RFA) and Tanzania (RFA) to those in Standard 1. Sensitivity ranges from 0.62 (Malawi) to 0.91 (Peru), while specificity is 0.90–1.00.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
