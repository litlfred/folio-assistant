  "kind": "table",
  "label": "Table 6",
  "title": "Table 6. TB-LAMP as an add-on test following negative sputum-smear microscopy: eligible and included patients, by reference standard and study site (see Annex 1 for information about the studies)",
  "file": "../tables/table-6.csv",
