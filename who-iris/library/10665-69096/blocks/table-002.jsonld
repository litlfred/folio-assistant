  "narrative": [
    {
      "text": "For each of the five GHTF founding member countries/areas, the table lists the acceptable quality system standards for medical devices and the body that certifies compliance.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
