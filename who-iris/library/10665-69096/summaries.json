        }
      ]
    },
    {
      "block": "library/10665-69096/blocks/prose-sec-014",
      "source": "sections/sec-014-312-maintaining-pre-qualified-status.md",
      "source_hash": "5ae79d0dc475fbd6402c63a3a4c05a6a297e7ba201ad07fc376e5b414b9fb49d",
      "narrative": [
        {
          "text": "States that pre-qualified products are kept under continual review and that manufacturers must report significant changes to product, process or site or risk losing their status.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
