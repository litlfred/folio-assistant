    {
      "block": "library/10665-69096/blocks/prose-sec-017",
      "source": "sections/sec-017-313-loosing-pre-qualified-status.md",
      "source_hash": "474ab658dae2bedd14fe90693744b46457999a23f7a43dadc8bebdf7601b6885",
      "narrative": [
        {
          "text": "Lists the ways a manufacturer can lose pre-qualified status, such as unapproved changes to site, process or specification, poor quality reports from UN agencies, failure to report adverse events or renew licences, and bankruptcy.",
          "lang": "en",
          "state": "draft",
