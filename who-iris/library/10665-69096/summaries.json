    },
    {
      "block": "library/10665-69096/blocks/prose-sec-016",
      "source": "sections/sec-016-3122-the-annual-pqs-review-process.md",
      "source_hash": "e703fb2fcc15fd3507a5ec97591698cc79d90b295bcad28d7ea57dcd97388624",
      "narrative": [
        {
          "text": "Describes the annual review of pre-qualified devices against a standard checklist, with manufacturers required to pay the re-evaluation fee and submit renewed documents on time. Results are communicated only if problems are found or status changes.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
