    },
    {
      "block": "library/10665-69096/blocks/prose-sec-012",
      "source": "sections/sec-012-310-the-dossier-evaluation-process.md",
      "source_hash": "4970dd316b08df9bbb09371477c60603e7973563d5c321c65f8e23804abd4994",
      "narrative": [
        {
          "text": "Describes the dossier evaluation process, including a one-month grace period for missing items, possible use of independent evaluators under confidentiality, and acceptance of ISO-compliant devices without further testing.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
    {
      "block": "library/10665-69096/blocks/prose-sec-013",
      "source": "sections/sec-013-311-evaluation-results-and-the-approval-process.md",
      "source_hash": "31c222b7e70b4dfda38a3832ce1ee56e0bba6feb1c4cd0f7c322be29c5f883ce",
      "narrative": [
        {
          "text": "Describes how evaluation results are reviewed and decided by the PQS Steering Group within six weeks of a complete dossier, and how manufacturers are told of approval or rejection, with decisions final.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
