    },
    {
      "block": "library/10665-69096/blocks/prose-sec-015",
      "source": "sections/sec-015-3121-the-extra-ordinary-pqs-review-process.md",
      "source_hash": "54f9133f26234fd974cd48746b9678ed91e037e0b57863af9742463e1d981b12",
      "narrative": [
        {
          "text": "Describes extraordinary reviews when serious problems such as adverse events or device failures arise, which may lead to suspension or withdrawal of pre-qualification.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
