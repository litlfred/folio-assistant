    {
      "block": "library/10665-97885/blocks/prose-sec-022",
      "source": "sections/sec-022-51-vaccine-efficacy.md",
      "source_hash": "da67437dfb3773871fd61829bdf737afd2e02de8ec940fb7f1179bb3f0eeac1b",
      "narrative": [
        {
          "text": "Reports prelicensure studies showing a single dose of Jeryl Lynn mumps vaccine was about 95% effective over short follow-up, and high efficacy for Leningrad-3 strain vaccines.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
