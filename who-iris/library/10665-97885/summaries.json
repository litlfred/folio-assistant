    },
    {
      "block": "library/10665-97885/blocks/prose-sec-023",
      "source": "sections/sec-023-52-vaccine-effectiveness.md",
      "source_hash": "0ce22cf05dea51b86c40f1cb81d3712f41eb4a144c7323d86db14811312eb10e",
      "narrative": [
        {
          "text": "Reviews postlicensure vaccine effectiveness from outbreak studies, with a median of 79% for one dose of Jeryl Lynn vaccine and lower figures for the Urabe strain. It reports that the Rubini strain showed little or no effectiveness and is no longer available. Two-dose Jeryl Lynn effectiveness had a median of 88%, usually but not significantly higher than one dose. It calls for research linking protection to neutralizing antibody levels and on the role of heterologous mumps strains.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
