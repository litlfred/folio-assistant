    {
      "block": "library/10665-97885/blocks/prose-sec-002",
      "source": "sections/sec-002-preface.md",
      "source_hash": "7bb737b7d8d3670a0ace257c9faa30b2606af3571ec0dcc9891f64ceaf18652c",
      "narrative": [
        {
          "text": "The preface explains that the Immunological Basis for Immunization series began in 1993 with eight modules on the vaccines of the Expanded Programme on Immunization and has been widely used. It notes that the series is being updated and extended with new modules, including this one on mumps.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
