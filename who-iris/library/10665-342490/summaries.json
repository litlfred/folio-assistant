    {
      "block": "library/10665-342490/blocks/prose-sec-003",
      "source": "sections/sec-003-1-general-information.md",
      "source_hash": "4dc9afe38adc478ec0cd4e6212c115b14318b3574898193282f38b0fee919f66",
      "narrative": [
        {
          "text": "Summarises key facts on the Janssen COVID-19 vaccine: five-dose vials, a single 0.5 ml dose, use from age 18 and intramuscular injection in the deltoid.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
