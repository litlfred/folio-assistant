      "source": "sections/sec-009-precautions.md",
      "source_hash": "7eedc95a1564bd832d1f3655eb476a4c9feb424643e837d074baebba759dfaa3",
      "narrative": [
        {
          "text": "Lists precautions for vaccination, namely acute febrile illness and bleeding risk in people on anticoagulants or with clotting disorders, and carries the job aid's page footer.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
