    {
      "block": "library/10665-342490/blocks/prose-sec-010",
      "source": "sections/sec-010-5-preparation-and-administration-of-vaccine.md",
      "source_hash": "69ce941cd86c5754d9dcd4b472a27e19872da3ddb6ed034fa8b551bc071bc67e",
      "narrative": [
        {
          "text": "Gives step-by-step instructions for preparing and giving the Janssen vaccine, from wearing protective equipment and screening the recipient (including a 14-day gap after other vaccines) to aseptic withdrawal of a 0.5 ml dose without dilution. It covers injecting into the deltoid, observing the person afterwards, recording the date, name and batch number, and reporting suspected adverse reactions.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
            "model": "not-disclosed",
            "session": "https://claude.ai/code/session_01Qmmkt6Ag2x8GsfdRq4ALsz"
          },
          "drafted_at": "2026-11-11"
        }
      ]
    },
    {
