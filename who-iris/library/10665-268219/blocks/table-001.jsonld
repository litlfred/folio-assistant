  "narrative": [
    {
      "text": "The table shows how many vaccine trials in the WHO Vaccine Trial Registry (1987–1999) conducted short-term (<4 weeks) and long-term (≥ 4 weeks) monitoring of adverse events following immunization, and how many reported details on the types of AEFI, with percentages of the 68 trials.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
        "kind": "agent",
