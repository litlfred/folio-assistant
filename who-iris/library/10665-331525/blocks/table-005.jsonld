  "narrative": [
    {
      "text": "The table summarizes the recommended TB preventive treatment regimens and suggested criteria for assessing treatment completion. For each regimen it gives the total duration in months, the expected number of doses, 80% of recommended doses, and the extended time allowed for completion (treatment duration plus 33%).",
      "lang": "en",
      "state": "draft",
