  "narrative": [
    {
      "text": "A photograph of a man in a blue T-shirt standing in a home and looking down at two small white medicine bottles in his hands. Behind him are floral and turquoise curtains and a television on a table covered with a red cloth.",
      "lang": "en",
      "state": "draft",
