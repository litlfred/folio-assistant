      "narrative": [
        {
          "text": "Introduces the Bangkok workshop on CD4 T lymphocyte counting, citing the HIV burden in the South-East Asia Region and the need for CD4 testing to guide antiretroviral therapy. It notes that sixteen laboratory professionals from seven countries attended, facilitated by Siriraj Hospital and India's National AIDS Research Institute.",
          "lang": "en",
          "state": "draft",
          "drafted_by": {
            "kind": "agent",
            "id": "claude-code",
