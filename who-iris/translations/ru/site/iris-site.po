# Russian translation of the who-iris IRIS replica's interface.
# Produced by an agent, with an independent back-translation round trip
# recorded in bean folio-assistant-lffo (issue #2228). Not yet reviewed by a
# person: the replica says so on every translated page.
#
msgid ""
msgstr ""
"Project-Id-Version: who-iris iris-site\n"
"PO-Revision-Date: 2026-10-05\n"
"Last-Translator: agent (unreviewed)\n"
"Language: ru\n"
"Language-Team: \n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

#: who-iris/scripts/gen-iris-pages.ts:781
#. Under a community: how many files it holds at WHO and their total size. {files} is a number, {size} a size such as '12.3 GiB'.
msgid "{files} files · {size} upstream"
msgstr "файлов: {files} · объём в первоисточнике: {size}"

#: who-iris/scripts/gen-iris-pages.ts:768
#. A rendering that has not been produced. {label} is the rendering's name, {command} a command in code type.
msgid "{label}: not rendered (run {command})"
msgstr "{label}: не создано (выполните {command})"

#: who-iris/scripts/gen-iris-pages.ts:833
#. A list entry under Browse. {link} is a collection's name from the catalogue, which is not translated.
msgid "{link} — collection"
msgstr "{link} — коллекция"

#: who-iris/scripts/gen-iris-pages.ts:832
#. A list entry under Browse. {link} is the 'List of Communities' link, {url} an address in code type, {communities} and {collections} numbers.
msgid "{link} — the replica of {url}, with every node’s materialisation state ({communities} communities, {collections} collections)"
msgstr "{link} — реплика {url} с состоянием материализации каждого узла (сообществ: {communities}, коллекций: {collections})"

#: who-iris/scripts/gen-iris-pages.ts:783
#. Beside a collection: how many of its items the catalogue models, and how many are held here. Both are numbers; rephrase freely to avoid plural agreement.
msgid "{modelled} item(s) modelled, {held} held here"
msgstr "смоделировано записей: {modelled}, хранится здесь: {held}"

#: who-iris/scripts/gen-iris-pages.ts:726
#. Inside the banner. {nodes} is how many catalogue nodes exist here, {items} how many items IRIS holds upstream, {size} a size such as '361.55 GiB', {held} how many items are held here (2 or more).
msgid "{nodes} nodes of a {items}-item {size} repository, of which <strong>{held} items</strong> are held here"
msgstr "узлов: {nodes}, в репозитории записей: {items}, объём: {size}; из них <strong>хранятся здесь: {held}</strong>"

#: who-iris/scripts/gen-iris-pages.ts:727
#. As above, when exactly one item is held here.
msgid "{nodes} nodes of a {items}-item {size} repository, of which <strong>1 item</strong> is held here"
msgstr "узлов: {nodes}, в репозитории записей: {items}, объём: {size}; из них <strong>здесь хранится одна запись</strong>"

#: who-iris/scripts/gen-iris-pages.ts:728
#. As above, when the upstream size was never measured.
msgid "{nodes} nodes of a repository of unmeasured size, of which <strong>{held} item(s)</strong> are held here"
msgstr "узлов: {nodes}, объём репозитория не измерен; из них <strong>хранятся здесь: {held}</strong>"

#: who-iris/scripts/gen-iris-pages.ts:777
#. A file size in megabytes. {size} is a number with two decimals.
msgid "{size} MB"
msgstr "{size} МБ"

#: who-iris/scripts/gen-iris-pages.ts:723
#. The browser tab title of every replica page. {title} is the page's own title (a collection or item name from the catalogue, which is not translated).
msgid "{title} — ingested IRIS replica"
msgstr "{title} — импортированная реплика IRIS"

#: who-iris/scripts/gen-iris-pages.ts:788
#. Note under the held-items table. Keep everything in <code> as written.
msgid "<strong>Both link forms are confirmed working.</strong> The <code>raw.githubusercontent.com</code> links were fetched and returned 200 with byte counts matching the catalogue exactly. The <em>via CDN</em> links could not be checked from the environment that generated this page — <code>cdn.jsdelivr.net</code> is egress-blocked there — so they were composed from jsDelivr's documented URL form and the owner exercised one by hand on 2026-09-20. Both are kept: one costs this project nothing to serve, and a reader who finds either unavailable still has the other."
msgstr "<strong>Обе формы ссылок проверены и работают.</strong> Ссылки <code>raw.githubusercontent.com</code> были загружены и вернули 200, а размеры в байтах в точности совпали с каталогом. Ссылки <em>через CDN</em> не удалось проверить из среды, в которой создавалась эта страница, — там исходящий доступ к <code>cdn.jsdelivr.net</code> заблокирован, — поэтому они составлены по документированной форме URL jsDelivr, и владелец вручную проверил одну из них 2026-09-20. Сохранены обе: одна ничего не стоит этому проекту, а читатель, для которого одна из них недоступна, всё равно имеет другую."

#: who-iris/scripts/gen-iris-pages.ts:795
#. Box above a collection's items. {note} is the catalogue's own note, which is not translated.
msgid "<strong>How this node was established.</strong> {note}"
msgstr "<strong>Как был установлен этот узел.</strong> {note}"

#: who-iris/scripts/gen-iris-pages.ts:725
#. The banner at the top of every page. {folioAssistant} and {iris} are links whose text is a name (folio-assistant, WHO IRIS) and is not translated. {figures} is the sentence about node counts below.
msgid "<strong>INGESTED COPY — not WHO, and not live.</strong> This page is rendered by {folioAssistant} from its own catalogue of {iris}, modelled <em>by reference</em>: {figures}. The WHO logo is deliberately omitted, and the rendered covers are withheld from display for the same reason — they carry the emblem printed on the publications."
msgstr "<strong>ИМПОРТИРОВАННАЯ КОПИЯ — это не ВОЗ и не действующий сайт.</strong> Эта страница создана инструментом {folioAssistant} на основе собственного каталога {iris}, смоделированного <em>по ссылке</em>: {figures}. Логотип ВОЗ намеренно опущен, а созданные обложки не показываются по той же причине: на них напечатана эмблема с изданий."

#: who-iris/scripts/gen-iris-pages.ts:740
#. Footer, first paragraph. {catalogue} and {generator} are file paths in code type; {iris} is a link to iris.who.int. None are translated.
msgid "<strong>Ingested replica.</strong> Rendered from {catalogue} by {generator}. Layout after {iris}; every figure on this page is read out of the catalogue, not copied from a screenshot."
msgstr "<strong>Импортированная реплика.</strong> Создана на основе {catalogue} с помощью {generator}. Макет по образцу {iris}; каждое число на этой странице прочитано из каталога, а не скопировано со снимка экрана."

#: who-iris/scripts/gen-iris-pages.ts:818
#. Shown on an item with no metadata record. iris-dspace is the name of a skill and R8 a rule number; keep both.
msgid "<strong>No Dublin Core record.</strong> The catalogue says so rather than synthesising metadata from the PDF — the <code>iris-dspace</code> skill's R8, <em>never infer metadata from the PDF when a record exists</em>, whose converse is that an absent record stays absent."
msgstr "<strong>Записи Dublin Core нет.</strong> Каталог сообщает об этом, а не синтезирует метаданные из PDF: таково правило R8 навыка <code>iris-dspace</code>, <em>никогда не выводить метаданные из PDF, если запись существует</em>, обратная сторона которого — отсутствующая запись остаётся отсутствующей."

#: who-iris/scripts/gen-iris-pages.ts:834
#. Note at the foot of the home page. A 'bean' is a work item; keep everything in <code> as written.
msgid "<strong>This is the front door, not the library visualiser.</strong> The full <code>library/</code> visualiser is bean <code>jbx2</code> and is being built separately. This page mocks the IRIS home page and links onward rather than becoming a second answer to the same question."
msgstr "<strong>Это главный вход, а не визуализатор библиотеки.</strong> Полный визуализатор <code>library/</code> — это задача <code>jbx2</code>, и он создаётся отдельно. Эта страница воспроизводит главную страницу IRIS и ведёт дальше, а не становится вторым ответом на тот же вопрос."

#: who-iris/scripts/gen-iris-pages.ts:787
#. Note under the held-items table. KG is 'knowledge graph'; jsDelivr is a product name.
msgid "<strong>Three routes to one item, which is the point.</strong> The catalogue knows this item once; the bytes are reachable <em>upstream at WHO</em>, <em>here as a replica page</em>, and <em>from a CDN edge</em> — jsDelivr serves any public repository, so the last one costs this project no hosting at all. The KG says what exists and where; the CDN says nothing and just serves it."
msgstr "<strong>Три пути к одной записи — в этом и смысл.</strong> Каталог знает эту запись один раз; байты доступны <em>у первоисточника в ВОЗ</em>, <em>здесь в виде страницы реплики</em> и <em>с узла CDN</em> — jsDelivr обслуживает любой открытый репозиторий, поэтому последний путь не стоит этому проекту ничего за хостинг. Граф знаний говорит, что существует и где; CDN ничего не говорит и просто отдаёт файлы."

#: who-iris/scripts/gen-iris-pages.ts:789
#. Note under the held-items table. A 'bean' is a work item in this repository's tracker; #477 is a pull request number. Keep everything in <code> as written.
msgid "<strong>Where the held copies actually live — bean <code>yl5w</code>.</strong> The catalogue records each of these at <code>uploads/&lt;name&gt;.pdf</code> relative to <code>who-iris/</code>, and <em>all three of those paths are missing</em>: #477 moved <code>library/</code> into this instance and left <code>uploads/</code> in <code>cat-harness/</code>."
msgstr "<strong>Где на самом деле лежат хранимые копии — задача <code>yl5w</code>.</strong> Каталог указывает для каждой из них путь <code>uploads/&lt;name&gt;.pdf</code> относительно <code>who-iris/</code>, и <em>все три этих пути отсутствуют</em>: #477 перенёс <code>library/</code> в этот экземпляр и оставил <code>uploads/</code> в <code>cat-harness/</code>."

#: who-iris/scripts/gen-iris-pages.ts:838
#. Tooltip on a withheld cover. {gates} names the publication gates that refused it, which are not translated.
msgid "A cover is rendered and held here. It is not published: {gates}."
msgstr "Обложка создана и хранится здесь. Она не опубликована: {gates}."

#: who-iris/scripts/gen-iris-pages.ts:844
#. Tooltip on a cover the replica chooses not to display.
msgid "A cover is rendered and recorded for this item. It is not displayed: the publication's cover carries the WHO emblem, and this replica is not published under WHO."
msgstr "Обложка для этой записи создана и учтена. Она не показывается: на обложке издания есть эмблема ВОЗ, а эта реплика не опубликована от имени ВОЗ."

#: who-iris/scripts/gen-iris-pages.ts:724
#. The page's meta description, read by search engines and link previews.
msgid "A replica of a WHO IRIS page, rendered from this repository's ingested catalogue. Not WHO, and not live."
msgstr "Реплика страницы IRIS ВОЗ, созданная на основе импортированного каталога этого репозитория. Это не ВОЗ и не действующий сайт."

#: who-iris/scripts/gen-iris-pages.ts:735
#. Navbar item (shown, not a link, in the replica).
msgid "About"
msgstr "О репозитории"

#: who-iris/scripts/gen-iris-pages.ts:835
#. Continues the note above. Keep everything in <code> as written.
msgid "Addressing follows the owner’s rule — <code>&lt;base-url&gt;/&lt;path-to-kind-or-node&gt;</code> — so an instance that instantiates a directory gets a visualiser mounted under that directory’s kind: <code>/library/who-iris/</code>, <code>/docs/who-iris/</code>, and so on."
msgstr "Адресация следует правилу владельца — <code>&lt;base-url&gt;/&lt;path-to-kind-or-node&gt;</code>, — так что экземпляр, который инстанцирует директорию, получает визуализатор, смонтированный под типом этой директории: <code>/library/who-iris/</code>, <code>/docs/who-iris/</code> и так далее."

#: who-iris/scripts/gen-iris-pages.ts:849
#. Before a link that repeats the search in the identifier lookup.
msgid "Also search identifier lookup:"
msgstr "Также искать по идентификатору:"

#: who-iris/scripts/gen-iris-pages.ts:808
#. Heading over the table of the item's links: upstream at WHO and held here.
msgid "Both links, as asked for"
msgstr "Обе ссылки, как и просили"

#: who-iris/scripts/gen-iris-pages.ts:831
#. Heading on the home page.
msgid "Browse"
msgstr "Обзор"

#: who-iris/scripts/gen-iris-pages.ts:733
#. Navbar item (shown, not a link, in the replica).
msgid "Browse IRIS"
msgstr "Обзор IRIS"

#: who-iris/scripts/gen-iris-pages.ts:805
#. Table column heading: the DSpace bundle a file belongs to (ORIGINAL, THUMBNAIL — those values are not translated).
msgid "Bundle"
msgstr "Пакет"

#: who-iris/scripts/gen-iris-pages.ts:753
#. Table column heading; also the badge on a collection in the search results.
msgid "Collection"
msgstr "Коллекция"

#: who-iris/scripts/gen-iris-pages.ts:732
#. Navbar link to the community list. DSpace's own label; keep &amp; as written if you use an ampersand.
msgid "Communities &amp; Collections"
msgstr "Сообщества и коллекции"

#: who-iris/scripts/gen-iris-pages.ts:754
#. The badge on a community in the search results.
msgid "Community"
msgstr "Сообщество"

#: who-iris/scripts/gen-iris-pages.ts:739
#. Breadcrumb on the community list page.
msgid "Community List"
msgstr "Список сообществ"

#: who-iris/scripts/gen-iris-pages.ts:736
#. Navbar item (shown, not a link, in the replica).
msgid "Contact"
msgstr "Контакты"

#: who-iris/scripts/gen-iris-pages.ts:842
#. Alternative text of a cover image, read by a screen reader. {title} is the publication's title, which is not translated.
msgid "Cover of {title}, rendered here from page 1 of the held PDF"
msgstr "Обложка издания «{title}», созданная здесь по странице 1 хранимого PDF"

#: who-iris/scripts/gen-iris-pages.ts:843
#. As above, for a cover whose WHO emblem was masked.
msgid "Cover of {title}, rendered here from page 1 of the held PDF, with the WHO emblem masked out"
msgstr "Обложка издания «{title}», созданная здесь по странице 1 хранимого PDF, с замаскированной эмблемой ВОЗ"

#: who-iris/scripts/gen-iris-pages.ts:839
#. Placeholder in place of a withheld cover image, over two lines. The <br> may move.
msgid "cover<br>withheld"
msgstr "обложка<br>не показана"

#: who-iris/scripts/gen-iris-pages.ts:762
#. In the Metadata record column when the record is declared but its file is absent.
msgid "declared, but missing on disk"
msgstr "объявлено, но отсутствует на диске"

#: who-iris/scripts/gen-iris-pages.ts:763
#. Link to download a metadata record. {file} is a file name.
msgid "Download {file}"
msgstr "Скачать {file}"

#: who-iris/scripts/gen-iris-pages.ts:816
#. Row label: the item's metadata record.
msgid "Dublin Core record"
msgstr "Запись Dublin Core"

#: who-iris/scripts/gen-iris-pages.ts:817
#. Row label: the record rendered as XML and JSON-LD.
msgid "Dublin Core renderings"
msgstr "Представления Dublin Core"

#: who-iris/scripts/gen-iris-pages.ts:769
#. Link to the item's record as XML.
msgid "Dublin Core XML"
msgstr "Dublin Core XML"

#: who-iris/scripts/gen-iris-pages.ts:786
#. Paragraph under that heading.
msgid "Each row carries <strong>three routes to the same item</strong>: the <strong>IRIS source</strong> upstream at WHO, this repository's own <strong>local replica</strong> page, and the <strong>asset itself</strong> — downloadable from the repository and, separately, from a CDN edge."
msgstr "Каждая строка даёт <strong>три пути к одной и той же записи</strong>: <strong>источник в IRIS</strong> у первоисточника в ВОЗ, страницу <strong>локальной реплики</strong> этого репозитория и <strong>сам ресурс</strong> — его можно скачать из репозитория и, отдельно, с узла CDN."

#: who-iris/scripts/gen-iris-pages.ts:784
#. Introduction to the community list. {referenced} and {materialized} are the state badges, already translated.
msgid "Every row below is <strong>live</strong>. A row is not greyed out when this repository does not hold it — it says {referenced} instead, which is the actual state and the whole point of a catalogue modelled by reference. {materialized} means the bytes are here."
msgstr "Каждая строка ниже <strong>активна</strong>. Строка не выделяется серым, если этот репозиторий её не хранит: в ней указано {referenced}, что и есть фактическое состояние и весь смысл каталога, смоделированного по ссылке. {materialized} означает, что байты находятся здесь."

#: who-iris/scripts/gen-iris-pages.ts:803
#. DSpace heading over the item's files.
msgid "Files"
msgstr "Файлы"

#: who-iris/scripts/gen-iris-pages.ts:757
#. Table column heading: the copy held in this repository.
msgid "Held copy"
msgstr "Хранимая копия"

#: who-iris/scripts/gen-iris-pages.ts:785
#. Heading of the table of held items. {n} is a number.
msgid "Held here — {n} materialized item(s)"
msgstr "Хранятся здесь — материализованных записей: {n}"

#: who-iris/scripts/gen-iris-pages.ts:812
#. Row label: the copy held in this repository. folio-assistant is a name.
msgid "Held here, in folio-assistant"
msgstr "Хранится здесь, в folio-assistant"

#: who-iris/scripts/gen-iris-pages.ts:774
#. In place of a download link when a file is held but may not be published. {gates} names the publication gates that refused it, which are not translated.
msgid "held here, not published — {gates}"
msgstr "хранится здесь, не опубликовано — {gates}"

#: who-iris/scripts/gen-iris-pages.ts:737
#. Navbar item (shown, not a link, in the replica).
msgid "Help"
msgstr "Справка"

#: who-iris/scripts/gen-iris-pages.ts:738
#. First breadcrumb, and the home page's own breadcrumb.
msgid "Home"
msgstr "Главная"

#: who-iris/scripts/gen-iris-pages.ts:827
#. Link text: the page that looks a node up by its identifier.
msgid "identifier lookup"
msgstr "поиск по идентификатору"

#: who-iris/scripts/gen-iris-pages.ts:760
#. Under a collection's name: the communities it sits in. {communities} is a list of names from the catalogue.
msgid "in {communities}"
msgstr "в {communities}"

#: who-iris/scripts/gen-iris-pages.ts:814
#. Row label: the collection the item belongs to.
msgid "In collection"
msgstr "В коллекции"

#: who-iris/scripts/gen-iris-pages.ts:802
#. Under the item's URL: the community and collection it sits in. {path} is names from the catalogue joined by ›.
msgid "In: {path}"
msgstr "В: {path}"

#: who-iris/scripts/gen-iris-pages.ts:815
#. Row label: the item's text as extracted into this repository's library. L1 is a level name; keep it.
msgid "Ingested text (L1)"
msgstr "Импортированный текст (L1)"

#: who-iris/scripts/gen-iris-pages.ts:730
#. What the letters IRIS stand for, under the 'iris.' wordmark. Use the name WHO uses for IRIS in your language if there is one; the <br> may move.
msgid "Institutional Repository<br>for Information Sharing"
msgstr "Институциональный репозиторий<br>для обмена информацией"

#: who-iris/scripts/gen-iris-pages.ts:742
#. Accessible name of the row of language links in the banner. The links themselves are each language's own name and are not translated.
msgid "Interface language"
msgstr "Язык интерфейса"

#: who-iris/scripts/gen-iris-pages.ts:772
#. Link from a table row to the item's page at WHO. Flip the arrow if your language reads right to left.
msgid "IRIS source →"
msgstr "Источник в IRIS →"

#: who-iris/scripts/gen-iris-pages.ts:752
#. Table column heading; also the badge on an item in the search results.
msgid "Item"
msgstr "Запись"

#: who-iris/scripts/gen-iris-pages.ts:796
#. DSpace heading over a collection's item list.
msgid "Items in this Collection"
msgstr "Записи в этой коллекции"

#: who-iris/scripts/gen-iris-pages.ts:770
#. Link to the item's record as JSON-LD.
msgid "JSON-LD (DCMI Terms)"
msgstr "JSON-LD (термины DCMI)"

#: who-iris/scripts/gen-iris-pages.ts:810
#. Table column heading.
msgid "Link"
msgstr "Ссылка"

#: who-iris/scripts/gen-iris-pages.ts:780
#. Title and heading of the community list page, and a link to it from the home page.
msgid "List of Communities"
msgstr "Список сообществ"

#: who-iris/scripts/gen-iris-pages.ts:771
#. Link from a table row to this replica's page for the item. Flip the arrow if your language reads right to left.
msgid "Local replica →"
msgstr "Локальная реплика →"

#: who-iris/scripts/gen-iris-pages.ts:731
#. Small notice at the right of the masthead.
msgid "Logo omitted, covers withheld — replica, not published under WHO"
msgstr "Логотип опущен, обложки не показываются — реплика, не опубликованная от имени ВОЗ"

#: who-iris/scripts/gen-iris-pages.ts:850
#. That link. {q} is what the reader typed. Use your language's quotation marks; flip the arrow for right-to-left.
msgid "Look up “{q}” in referenced nodes →"
msgstr "Найти «{q}» среди узлов, на которые есть ссылки →"

#: who-iris/scripts/gen-iris-pages.ts:848
#. Heading of the search results. {n} is a number.
msgid "Matching catalogue nodes ({n}):"
msgstr "Найденные узлы каталога ({n}):"

#: who-iris/scripts/gen-iris-pages.ts:747
#. State badge: the bytes are held in this repository. Shown in capitals by the stylesheet where the script has case.
msgid "materialized"
msgstr "материализовано"

#: who-iris/scripts/gen-iris-pages.ts:758
#. Table column heading: the item's Dublin Core record.
msgid "Metadata record"
msgstr "Запись метаданных"

#: who-iris/scripts/gen-iris-pages.ts:804
#. Table column heading: a file's name.
msgid "Name"
msgstr "Имя"

#: who-iris/scripts/gen-iris-pages.ts:845
#. In place of an abstract the record does not carry. Keep the field name in <code> as written.
msgid "No <code>dc.description.abstract</code> in the captured record."
msgstr "В полученной записи нет <code>dc.description.abstract</code>."

#: who-iris/scripts/gen-iris-pages.ts:836
#. In a recent submission's byline when the record names no author.
msgid "no author recorded"
msgstr "автор не указан"

#: who-iris/scripts/gen-iris-pages.ts:759
#. In the Collection column when the catalogue names none.
msgid "no collection recorded"
msgstr "коллекция не указана"

#: who-iris/scripts/gen-iris-pages.ts:841
#. Placeholder in place of a cover that was never rendered.
msgid "no cover"
msgstr "нет обложки"

#: who-iris/scripts/gen-iris-pages.ts:840
#. Tooltip on the placeholder of an item with no cover.
msgid "no cover rendered"
msgstr "обложка не создана"

#: who-iris/scripts/gen-iris-pages.ts:851
#. When nothing matches. {q} is what the reader typed.
msgid "No materialized items or collections matched “<strong>{q}</strong>”."
msgstr "Ни одна материализованная запись или коллекция не соответствует запросу «<strong>{q}</strong>»."

#: who-iris/scripts/gen-iris-pages.ts:766
#. In the Dublin Core renderings row when the item has no record.
msgid "no record, so nothing to render"
msgstr "записи нет, поэтому отображать нечего"

#: who-iris/scripts/gen-iris-pages.ts:773
#. In the Upstream column when the catalogue has no WHO address for the item.
msgid "no upstream URI recorded"
msgstr "URI первоисточника не указан"

#: who-iris/scripts/gen-iris-pages.ts:761
#. In the Metadata record column when no record was captured.
msgid "none captured"
msgstr "запись не получена"

#: who-iris/scripts/gen-iris-pages.ts:794
#. In place of a URL or link the catalogue does not record.
msgid "none recorded"
msgstr "не указан"

#: who-iris/scripts/gen-iris-pages.ts:801
#. In place of the item's URL when it has none.
msgid "none recorded — ingested from a local copy, not resolved from IRIS"
msgstr "не указан — импортировано из локальной копии, не разрешено через IRIS"

#: who-iris/scripts/gen-iris-pages.ts:813
#. In the row above when nothing is held.
msgid "not held"
msgstr "не хранится"

#: who-iris/scripts/gen-iris-pages.ts:775
#. In place of a download link when the file is not held in this repository.
msgid "not held here"
msgstr "здесь не хранится"

#: who-iris/scripts/gen-iris-pages.ts:776
#. A file size the catalogue does not record.
msgid "not recorded"
msgstr "не указан"

#: who-iris/scripts/gen-iris-pages.ts:797
#. Under that heading. {n} is the number of items the catalogue models in this collection.
msgid "Now showing 1 – {n} of {n} <em>modelled</em>. The upstream collection is larger; this catalogue holds what was materialised, and says so per row."
msgstr "Показаны 1 – {n} из {n} <em>смоделированных</em>. Коллекция в первоисточнике больше; этот каталог содержит то, что было материализовано, и указывает это в каждой строке."

#: who-iris/scripts/gen-iris-pages.ts:830
#. Under that heading. {key} is a metadata field name in code type. WPRO is the WHO Western Pacific Regional Office; keep the acronym.
msgid "Ordered by {key}, latest first — the key IRIS’s own list sorts on. Where a record carries several accessions the latest is used; the WPRO item has two, five days apart, the second being the regional-IRIS merge."
msgstr "Упорядочено по {key}, сначала самые новые — по этому ключу IRIS сортирует собственный список. Если у записи несколько дат поступления, используется последняя; у записи WPRO их две, с разницей в пять дней, и вторая — это слияние с региональным IRIS."

#: who-iris/scripts/gen-iris-pages.ts:793
#. DSpace label before the collection's handle URL.
msgid "Permanent URI for this collection"
msgstr "Постоянный URI этой коллекции"

#: who-iris/scripts/gen-iris-pages.ts:800
#. DSpace label before the item's handle URL.
msgid "Permanent URI for this item"
msgstr "Постоянный URI этой записи"

#: who-iris/scripts/gen-iris-pages.ts:837
#. In a recent submission's byline, as IRIS labels it. {date} is a date such as 2020-05-14.
msgid "Publication Date: {date}"
msgstr "Дата публикации: {date}"

#: who-iris/scripts/gen-iris-pages.ts:765
#. Under the download link: the record's format and size. {size} is a number.
msgid "qualified Dublin Core · {size} KB"
msgstr "квалифицированный Dublin Core · {size} КБ"

#: who-iris/scripts/gen-iris-pages.ts:807
#. Heading over the embedded PDF reader.
msgid "Read it here"
msgstr "Читать здесь"

#: who-iris/scripts/gen-iris-pages.ts:829
#. DSpace heading on the home page.
msgid "Recent Submissions"
msgstr "Недавние поступления"

#: who-iris/scripts/gen-iris-pages.ts:748
#. State badge: known to the catalogue, held upstream at WHO only.
msgid "referenced"
msgstr "по ссылке"

#: who-iris/scripts/gen-iris-pages.ts:822
#. Small print under the hero paragraph. {theme} is a theme's name in code type.
msgid "Replica. No WHO emblem, no photograph — colour only, from the {theme} theme measured off the site’s own stylesheet."
msgstr "Реплика. Без эмблемы ВОЗ и без фотографии — только цвет, из темы {theme}, измеренной по собственной таблице стилей сайта."

#: who-iris/scripts/gen-iris-pages.ts:825
#. The search button.
msgid "Search"
msgstr "Найти"

#: who-iris/scripts/gen-iris-pages.ts:826
#. Note under the search box. {held} and {referenced} are numbers; {lookup} is a link whose text is the next string.
msgid "Search across <strong>{held}</strong> items held by value and referenced communities/collections. To look up any of the <strong>{referenced}</strong> referenced nodes by identifier, search here or open the {lookup}."
msgstr "Поиск по записям, хранимым по значению (<strong>{held}</strong>), а также по сообществам и коллекциям, на которые есть ссылки. Чтобы найти по идентификатору любой из узлов, на которые есть ссылки (<strong>{referenced}</strong>), ищите здесь или откройте {lookup}."

#: who-iris/scripts/gen-iris-pages.ts:852
#. Link shown when nothing matches. {q} is what the reader typed, {n} a number. Flip the arrow for right-to-left.
msgid "Search for “{q}” in the referenced identifier lookup ({n} nodes) →"
msgstr "Найти «{q}» в поиске по идентификаторам узлов, на которые есть ссылки (узлов: {n}) →"

#: who-iris/scripts/gen-iris-pages.ts:824
#. Accessible name of the search box.
msgid "Search through the repository items and referenced identifier lookup"
msgstr "Поиск по записям репозитория и по идентификаторам узлов, на которые есть ссылки"

#: who-iris/scripts/gen-iris-pages.ts:823
#. Placeholder text inside the search box. {n} is a number, written without separators.
msgid "Search through the repository’s {n} items"
msgstr "Поиск по записям репозитория (всего: {n})"

#: who-iris/scripts/gen-iris-pages.ts:806
#. Table column heading: a file's size.
msgid "Size"
msgstr "Размер"

#: who-iris/scripts/gen-iris-pages.ts:782
#. Under a community whose size at WHO was never measured.
msgid "size upstream <strong>unknown</strong> — the storage report's second page was never read, and a number interpolated from the first would look measured"
msgstr "объём в первоисточнике <strong>неизвестен</strong> — вторая страница отчёта о хранении так и не была прочитана, а число, интерполированное по первой, выглядело бы измеренным"

#: who-iris/scripts/gen-iris-pages.ts:741
#. Footer, second paragraph. {iris} is a link to iris.who.int.
msgid "Source of record: {iris} — © WHO. This copy asserts no endorsement and carries no WHO mark."
msgstr "Первоисточник: {iris} — © ВОЗ. Эта копия не заявляет о каком-либо одобрении и не несёт никаких знаков ВОЗ."

#: who-iris/scripts/gen-iris-pages.ts:755
#. Table column heading: the materialisation state.
msgid "State"
msgstr "Состояние"

#: who-iris/scripts/gen-iris-pages.ts:734
#. Navbar item (shown, not a link, in the replica).
msgid "Statistics"
msgstr "Статистика"

#: who-iris/scripts/gen-iris-pages.ts:790
#. Continues the note above. Keep everything in <code> as written: they are field and command names.
msgid "The download links above point at where the bytes <em>are</em>, so they work. The claim in the catalogue is what is wrong, and <code>check:catalogue</code> does not check <code>localPath</code> at all — it verifies <code>metadataRef</code> and <code>libraryId</code>, and reports a clean run over three <code>materialized</code> claims that resolve to nothing."
msgstr "Ссылки для скачивания выше указывают туда, где байты <em>действительно находятся</em>, поэтому они работают. Неверно утверждение в каталоге, а <code>check:catalogue</code> вообще не проверяет <code>localPath</code> — он проверяет <code>metadataRef</code> и <code>libraryId</code> и сообщает об успешной проверке трёх утверждений <code>materialized</code>, которые ни на что не указывают."

#: who-iris/scripts/gen-iris-pages.ts:743
#. Shown on every translated page. {language} is the language's own name. It states where the translation stops: the records are WHO's data and are never machine-translated.
msgid "The interface is shown in {language}. Publication titles, authors, abstracts and other catalogue records are shown as WHO published them."
msgstr "Интерфейс показан на языке: {language}. Названия изданий, авторы, аннотации и другие записи каталога показаны в том виде, в каком их опубликовала ВОЗ."

#: who-iris/scripts/gen-iris-pages.ts:821
#. The hero paragraph on the home page, as IRIS's own home page states it. Use the Organization's official names for its offices and Governing Bodies in your language.
msgid "The primary objective of the Institutional Repository for Information Sharing (IRIS) is to provide free digital access to the scientific and technical publications of the World Health Organization (WHO), including contributions from its Country Offices, Regional Offices, and Headquarters. Additionally, IRIS encompasses the mandates established by the Organization’s Governing Bodies in collaboration with its Member States."
msgstr "Основная цель Институционального репозитория для обмена информацией (IRIS) — обеспечить бесплатный цифровой доступ к научным и техническим публикациям Всемирной организации здравоохранения (ВОЗ), включая материалы её страновых бюро, региональных бюро и штаб-квартиры. Кроме того, IRIS охватывает мандаты, установленные руководящими органами Организации совместно с её государствами-членами."

#: who-iris/scripts/gen-iris-pages.ts:767
#. In the Dublin Core renderings row when there is nowhere to publish them.
msgid "this instance declares no published root"
msgstr "этот экземпляр не объявляет опубликованного корня"

#: who-iris/scripts/gen-iris-pages.ts:744
#. Shown with the note above until a person signs the catalogue off.
msgid "This interface translation was produced by an agent and has not been reviewed by a person."
msgstr "Этот перевод интерфейса выполнен агентом и не проверен человеком."

#: who-iris/scripts/gen-iris-pages.ts:749
#. State badge: the catalogue has not determined the state.
msgid "unknown"
msgstr "неизвестно"

#: who-iris/scripts/gen-iris-pages.ts:756
#. Table column heading: where the item lives at WHO.
msgid "Upstream"
msgstr "Первоисточник"

#: who-iris/scripts/gen-iris-pages.ts:828
#. Continues the note above. {items} and {files} are numbers.
msgid "Upstream IRIS reports <strong>{items}</strong> items across <strong>{files}</strong> files."
msgstr "IRIS у первоисточника сообщает: записей — <strong>{items}</strong>, файлов — <strong>{files}</strong>."

#: who-iris/scripts/gen-iris-pages.ts:811
#. Row label: the item's address at WHO.
msgid "Upstream, at WHO"
msgstr "У первоисточника, в ВОЗ"

#: who-iris/scripts/gen-iris-pages.ts:764
#. Second link to the same file, served by a content delivery network.
msgid "via CDN"
msgstr "через CDN"

#: who-iris/scripts/gen-iris-pages.ts:809
#. Table column heading.
msgid "Where"
msgstr "Где"

#: who-iris/scripts/gen-iris-pages.ts:729
#. The wordmark in the masthead, set in type because the WHO logo is deliberately omitted. Use the Organization's official name in your language; the <br> breaks it over two lines and may move.
msgid "World Health<br>Organization"
msgstr "Всемирная организация<br>здравоохранения"
