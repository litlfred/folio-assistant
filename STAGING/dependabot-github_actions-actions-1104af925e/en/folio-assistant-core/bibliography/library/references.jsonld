    {
      "@id": "references/arxiv-2602.16554v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "MerLean: An Agentic Framework for Autoformalization in Quantum Computation",
      "dcterms:creator": [
        "Ren∗, Yuanjie"
      ],
      "dcterms:identifier": "https://arxiv.org/abs/2602.16554",
      "dcterms:abstract": "We introduce MerLean, a fully automated agentic framework for autoformalization in quantum computation. MerLean extracts mathematical statements from LATEX source files, formalizes them into verified Lean 4 code built on Mathlib, and trans- lates the result back into human-readable LATEX for semantic review. We evaluate MerLean on three theoretical quantum computing papers producing 2,050 Lean dec- larations from 114 statements in total. MerLean achieves end-to-end formalization on all three papers, reducing the verification burden to only the newly introduced definitions and axioms. Our results demonstrate that agentic autoformalization can scale to frontier research, offering both a practical tool for machine-verified peer review and a scalable engine for mining high-quality synthetic data to train future reasoning models. Our approach can also be generalized to any other rigorous research in mathematics and theoretical physics.",
      "dcterms:source": "folio-assistant-sci/library/arxiv-2602.16554v1/manifest.jsonld",
      "dcterms:hasVersion": "folio-assistant-sci/library/arxiv-2602.16554v1"
    },
