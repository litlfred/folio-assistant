      "dcterms:issued": "D:20260921",
      "dcterms:source": "cat-harness/library/rfc2119-key-words-requirement-levels/manifest.jsonld",
      "dcterms:hasVersion": "cat-harness/library/rfc2119-key-words-requirement-levels"
