    "lane-string-not-extracted": {
      "summary": "A lane `name` or `<documentation>` absent from its diagram's translation template. This asks about EXTRACTION, never about a translation existing: catalogues here ship with an empty `msgstr` awaiting a person, and gating on that would be a gate on somebody else's unfinished work. A diagram with no template at all is `translate-bpmn --check`'s finding, not this one's.",
      "count": 0,
      "entries": []
    },
