  "title": "Content Review Input",
  "description": "Input schema for formal content review and approval workflow.",
  "type": "object",
  "required": [
    "reviewType",
    "contentRef"
  ],
  "properties": {
    "reviewType": {
      "type": "string",
      "enum": [
        "l2-to-l3-gate",
        "l3-to-publish-gate",
        "change-assessment",
