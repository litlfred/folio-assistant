  "staging": {
    "branch": "claude/agent-built-previews",
    "sha": "ffe4449ac4c8ad3acdf4196e94b3af83e5d93947",
    "pr": "2885/merge",
    "run": "41346355179"
  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-agent-built-previews/folio-assistant-core/tools/review-sheet-sync.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "review-sheet-sync",
      "title": "Build the review sheet's Apps Script and a document's Config tab",
      "description": "Builds `Code.gs` (one generic script for every document, `--script`) and one document's Config tab rows (`--config`): the Google Apps Script that keeps a public-comment review sheet's links and joins current: each comment No. links to its comment page, Sections, Page and Line no(s) link to the page of the frozen review draft, Review Change Sets joins its comments, suggested revisions, feedback and dispositions with each `No. n` linking to its row, and on both tabs Agentic status lists each pull request of the change-set, linked, with its status and what it changed, from the Agent tab. The script is the same for every review (`review-sheet.gs`); this Tool fills in one folio's data from its `review/public-comment/sheet-sync.json`, its review anchors and the draft's `pdf-line-map.json`. The script reads the document's URLs, tab and column names and data from the sheet's Config tab (visible, locked to the owner), which the agent writes from these rows. A person pastes the script (one file) into the sheet once (Extensions > Apps Script) and runs `installTriggers`; from then on the sheet rebuilds itself within five minutes of an edit, with no agent. With `\"mode\": \"drafting\"` in the config it builds the simpler drafting sheet instead: one Contributor Feedback tab where each row is a change set (ids assigned by the script), Sections picked from the document's table of contents and linked to it, and Issue and Agentic status from the Agent tab.",
      "install": {
        "service": "Google Apps Script bound to the review sheet: copy the template, have the agent write its Config tab, add editors to the \"Ready columns: editors\" lock, paste Code.gs, run installTriggers (skill review-sheet-script, \"Setting up a sheet for a new document\")"
      },
      "invoke": {
        "shell": "bun run folio-assistant-core/tools/review-sheet-sync/build-review-sheet-script.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "script",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-agent-built-previews/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where to write the generic Code.gs. The same for every document.",
            "required": false,
            "arg": {
              "flag": "--script"
            }
          },
          {
            "name": "repo",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-agent-built-previews/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio repository. Default the current directory.",
            "required": false,
            "arg": {
              "flag": "--repo"
            }
          },
          {
            "name": "config",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-agent-built-previews/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio's sheet settings, e.g. `review/public-comment/sheet-sync.json`: anchors, lineMap, draftUrl, commentUrl, and optional namedSections, aliases, tabs and columns. A drafting sheet's config (`review/drafting/sheet-sync.json`) has mode `drafting`, anchors and sectionUrl.",
            "required": false,
            "arg": {
              "flag": "--config"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-agent-built-previews/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where to write the Config tab's rows (JSON). Default standard output.",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          }
        ],
        "outputs": [
          {
            "name": "script",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-agent-built-previews/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Code.gs, ready to paste into any review sheet's Apps Script editor. Never committed: it is rebuilt from the template."
          },
          {
            "name": "configRows",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-agent-built-previews/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The Config tab's rows for one document, which the agent writes into the sheet. Never committed: rebuilt from the config."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-agent-built-previews/folio-assistant-core/skill/review-sheet-script"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-core/tools/review-sheet-sync.jsonld"
    }
  ]
}
