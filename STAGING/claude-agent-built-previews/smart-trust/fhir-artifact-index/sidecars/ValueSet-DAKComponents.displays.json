{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/trust/ValueSet-DAKComponents.displays.json",
  "title": "DAK components Display Values",
  "description": "Display values for DAK components ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "health-interventions-and-recommendations": {
      "en": "Health Interventions & Recommendations"
    },
    "generic-personas": {
      "en": "Generic Personas"
    },
    "user-scenarios": {
      "en": "User Scenarios"
    },
    "generic-business-processes-and-workflows": {
      "en": "Business Processes & Workflows"
    },
    "core-data-elements": {
      "en": "Core Data Elements"
    },
    "decision-support-logic": {
      "en": "Decision Support Logic"
    },
    "scheduling-logic": {
      "en": "Scheduling Logic"
    },
    "programme-indicators": {
      "en": "Indicators & Monitoring"
    },
    "functional-and-non-functional-requirements": {
      "en": "Functional & Non-functional Requirements"
    },
    "test-scenarios": {
      "en": "Test Scenarios"
    }
  },
  "fhir:valueSet": "http://smart.who.int/trust/ValueSet/DAKComponents",
  "fhir:version": "1.7.5",
  "fhir:expansionTimestamp": "2026-11-01T20:48:19+00:00"
}