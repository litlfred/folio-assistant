      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "Skills, extracted (large-datasets)",
      "skos:definition": "Candidate terms extracted from every skill's front matter: `name` as the label, `description` as the definition. Generated by folio-assistant-core/scripts/glossary-extract.ts; not curated, and never hand-edited: a person promotes a term by authoring it in a glossary of their own.",
      "dcterms:source": "Skills of large-datasets"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-skills/copy-out-materialized",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "copy-out-materialized"
        }
      ],
      "skos:definition": [
        {
          "@value": "Materialized content is read-only. To work on it you take a copy into your own folio/, and the copy records what it is a copy of — the local-provenance edge, which is not the upstream one."
        }
      ],
      "skos:notation": "copy-out-materialized",
      "dcterms:source": "large-datasets/skills/copy-out-materialized.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-skills/materialize-on-demand",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "materialize-on-demand"
        }
      ],
      "skos:definition": [
        {
          "@value": "After bootstrap, a person asks for part of a remote subgraph to be held locally. Check what is already here (cache:index), put a number on the ask before anything is fetched, then run materialize-remote. Eviction is a report, never an act."
        }
      ],
      "skos:notation": "materialize-on-demand",
      "dcterms:source": "large-datasets/skills/materialize-on-demand.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-skills/materialize-remote",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "materialize-remote"
        }
      ],
      "skos:definition": [
        {
          "@value": "Landing remote content locally — the five gates, the three states, and the two purposes. One process, shared by catalogue import and harness bootstrap, plus the refresh that is not a re-import."
        }
      ],
      "skos:notation": "materialize-remote",
      "dcterms:source": "large-datasets/skills/materialize-remote.md",
      "skos:note": "candidate"
    }
