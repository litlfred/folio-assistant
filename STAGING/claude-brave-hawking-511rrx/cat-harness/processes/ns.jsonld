{
  "@context": {
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "isDefinedBy": {
      "@id": "rdfs:isDefinedBy",
      "@type": "@id"
    }
  },
  "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns",
  "label": "cat-harness's diagram elements",
  "comment": "The elements cat-harness adds to BPMN, in the XML namespace https://litlfred.github.io/folio-assistant/cat-harness/processes/ns# and written with the prefix cat-harness.processes:, the name of the Subgraph that declares them. skill, role and precondition are bootstrap's (https://litlfred.github.io/folio-assistant/bootstrap/processes/ns#) and are written bootstrap.processes:. A reader matches elements by namespace, never by the prefix text.",
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#bean",
      "@type": "rdfs:Class",
      "label": "bean",
      "comment": "On a task: the step touches the work plan (beans). Attribute op: claim, note or resolve, which the engine performs; absent means the step touches the plan in a way the tools do not perform automatically.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#policy",
      "@type": "rdfs:Class",
      "label": "policy",
      "comment": "On a process: enforcement, strict or advisory. On a task: relaxable=\"false\" means a content package may not declare a relaxation for this step.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#adjudication",
      "@type": "rdfs:Class",
      "label": "adjudication",
      "comment": "On a task: the step is a judgement, and codes lists the answers it may give (optionally from a named code list, list). On a call activity: accepts, the answers the caller can act on. On a branch out of its gateway: code, the answer that takes this branch. defers=\"caller\" hands the answer to the calling process.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#no-skill",
      "@type": "rdfs:Class",
      "label": "no-skill",
      "comment": "On a task: it names no Skill on purpose. Attribute reason: why.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#no-call",
      "@type": "rdfs:Class",
      "label": "no-call",
      "comment": "On a task: it names a Skill that owns a process of the same name, and is deliberately not a call of that process. Attribute reason: why.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#job",
      "@type": "rdfs:Class",
      "label": "job",
      "comment": "On a node: the CI job it stands for. Attribute name: the job name in the workflow the process implements.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#implements",
      "@type": "rdfs:Class",
      "label": "implements",
      "comment": "On a process: the CI workflow file it documents. Attribute workflow: its path.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#judgement",
      "@type": "rdfs:Class",
      "label": "judgement",
      "comment": "On an exclusive gateway: its branch is a judgement, on purpose, rather than computed. Attribute reason: why.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#fulfilment",
      "@type": "rdfs:Class",
      "label": "fulfilment",
      "comment": "On a task: which Actor kinds may perform it, said explicitly. Attributes kinds (for example \"person agent\") and reason.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#raci",
      "@type": "rdfs:Class",
      "label": "raci",
      "comment": "On a task: a Role that is accountable, consulted or informed. Attributes ref (the Role) and involvement. Responsible is not declared here: the lane already says who performs the task.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#involvement",
      "@type": "rdfs:Class",
      "label": "involvement",
      "comment": "On a process: which involvement vocabulary its raci letters are written in. Attribute vocabulary; absent means raci.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#link",
      "@type": "rdfs:Class",
      "label": "link",
      "comment": "On a call activity: where a reader goes for the called process, overriding the default. Attribute href.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#decision",
      "@type": "rdfs:Class",
      "label": "decision",
      "comment": "On an exclusive gateway: its outcome is computed from a DMN decision table. Attribute ref: decisions/<file>.dmn#<Decision_Id>, relative to the diagram.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#log",
      "@type": "rdfs:Class",
      "label": "log",
      "comment": "On a process: whether running it writes activity-log entries. Attribute capture: on or off; absent means undecided, which is reported rather than defaulted.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns#convention",
      "@type": "rdfs:Class",
      "label": "convention",
      "comment": "On a process, lane or task: a convention in force there. Attribute ref: the convention's id.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/cat-harness/processes/ns"
    }
  ]
}
