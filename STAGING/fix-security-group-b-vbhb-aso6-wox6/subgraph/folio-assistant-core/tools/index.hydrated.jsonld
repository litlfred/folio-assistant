              },
              {
                "arg": {
                  "flag": "--blocks-out"
                },
                "description": "With `folio`: also write `blocks.json`, so a later run can anchor without checking the folio out.",
                "name": "blocks-out",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--blocks"
                },
