    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/folio-assistant-core/tools/block-actions/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/tools/block-actions.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Each labelled block's links back to where it can be changed: [edit] opens the block's Markdown source in GitHub's editor on `main`, and [feedback] opens a new GitHub issue about the block, from the folio's `.github/ISSUE_TEMPLATE/block-feedback.yml` when it has one (prefilling only the fields it declares: block, section, source, page, url) or as a plain issue whose body carries the same facts. The document build draws these on every block; this Tool prints them as JSON for one block or all. Governed by the `block-actions` skill (bean `uphx`, REQ-17).",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run folio-assistant-core/scripts/block-actions.ts"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--repo"
                },
                "description": "The folio's repository root. Default: the working directory.",
                "name": "repo",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--block"
                },
                "description": "One block's label. Absent: every block of every document. A label no block has exits 1.",
                "name": "block",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/NodeId"
              },
              {
                "arg": {
                  "flag": "--github"
                },
                "description": "`owner/name` on GitHub. Default `GITHUB_REPOSITORY`, else the checkout's `origin`. None at all exits 2: no links rather than broken ones.",
                "name": "github",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
              },
              {
                "arg": {
                  "flag": "--edit-branch"
                },
                "description": "The branch [edit] opens. Default `main`.",
                "name": "edit-branch",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
              },
              {
                "arg": {
                  "flag": "--issue-template"
                },
                "description": "The issue form's file name under `.github/ISSUE_TEMPLATE/`. Default `block-feedback.yml`, used only if the folio has it.",
                "name": "issue-template",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ],
            "outputs": [
              {
                "description": "JSON on stdout: one `{ label, source, section, edit, feedback }` per block. A one-line summary goes to stderr.",
                "name": "links",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ]
          },
          "name": "block-actions",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/block-actions",
          "title": "Block edit and feedback links"
        }
      ],
