            "runtime": [
              "bun"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/figure-rebuild",
          "title": "Figure coverage and computability"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/figure-coverage",
      "path": "tools/figure-coverage/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/folio-assistant-core/tools/folio-block-qa-summary/",
