                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--existing"
                },
                "description": "The previous `review-comments.json`. Every comment in it is kept, with its status.",
                "name": "existing",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--commit"
                },
                "description": "The head commit. Default `GITHUB_SHA`, else `git rev-parse HEAD`.",
                "name": "commit",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/CommitSha"
              },
              {
                "arg": {
                  "flag": "--todos"
                },
                "description": "The folio's todos graph root. Review comments committed under its `todo-feedback` directory, on the feature branch, win over the previously published copy.",
                "name": "todos",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--comments"
                },
