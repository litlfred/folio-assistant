                "name": "out",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--repo"
                },
                "description": "The folio's instance root, where verdicts are anchored. Default: found from `folio` exactly as the QA sweep finds it.",
                "name": "repo",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
