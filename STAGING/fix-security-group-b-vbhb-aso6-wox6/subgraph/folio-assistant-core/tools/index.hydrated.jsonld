    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/folio-assistant-core/tools/catalogue-from-references/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/tools/catalogue-from-references.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Write one `folio-dublin-core/v1` record and one `folio-catalogue-node/v1` item per library entry that the source ledger joins to a CSL-JSON reference, into the folio's declared `catalogue` directory, so `gen-library-jsonld` reads the title from the catalogue's `dc.title` instead of falling to the PDF or the slug. The join is exact: a ledger row naming the entry's `structure.json` source file, one reference id, and the same sha256 where both record one. Unjoined entries are reported and left alone. Never touches a node it did not write (folio-assistant-core#72).",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run folio-assistant-core/scripts/catalogue-from-references.ts"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "positional": 0
                },
                "description": "The folio instance's root. It must declare a `catalogue` and a `library` directory.",
                "name": "instance",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--apply"
                },
                "description": "Write the records and nodes, and remove this tool's stale ones. Without it the run is a dry run.",
                "name": "apply",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--check"
                },
                "description": "Write nothing. Exit 1 if any record or node on disk differs from what the bibliography gives.",
                "name": "check",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--json"
                },
                "description": "Print the plan as JSON.",
                "name": "json",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ],
            "outputs": [
              {
                "description": "`<catalogue>/records/<slug>.dc.json` and `<catalogue>/nodes/item-<slug>.json` per joined entry; `catalogue.json` when absent and `--base-url` is given. A summary of joined and left-alone entries goes to stdout.",
                "name": "catalogue",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ]
          },
          "name": "catalogue-from-references",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/filing-dublin-core",
          "title": "Catalogue a library from its bibliography"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/catalogue-from-references",
      "path": "tools/catalogue-from-references/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/folio-assistant-core/tools/dublin-core-render/",
