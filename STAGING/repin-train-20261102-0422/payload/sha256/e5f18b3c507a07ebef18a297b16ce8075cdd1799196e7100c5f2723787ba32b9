    {
      "id": "library/9789240081291-eng/blocks/prose-sec-009",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Applications at the national level",
      "pageStart": 19,
      "pageEnd": 21,
      "target": "../sections/sec-009-applications-at-the-national-level.md",
      "narrative": null,
      "content": "The NHWA indicators have been selected with clear policy relevance in mind, so that they \ncan be used by any country according to its own specific needs. While designed to support \na coherent framework for HWF policy analysis and design, the NHWA can be implemented \nand used in a flexible, modular way. It is important for countries to note that while the NHWA \nmodules provide full coverage of indicators for all components and policy domains and form a \nnatural whole across the HLM framework, there is also significant room for selecting country-\nspecific indicators. As countries strongly differ",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Applications at the national level: NHWA indicators were chosen for policy relevance and can be adopted flexibly and modularly; countries select and prioritize modules to suit their needs and may mature towards covering all indicators, though full coverage is not a goal in itself. Implementation is progressive, with some benefits immediate and others longer term, and in five years countries have used it to set up multi-stakeholder governance, find data sources, strengthen HRH information systems and build a data-use culture. Box 1 lists national benefits — better understanding of workforce size, characteristics and distribution, evidence for policy, guidance for scaling education, intersectoral policy dialogue, cross-cutting investment and better planning — and the section closes with policy questions NHWA can inform, on availability and competence of the workforce, closing gaps through performance, retention, partnerships, education or in-migration, financing such policies, replacing exits, and incentives for underserved areas.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "claude-opus-5-5"
        },
        "draftedAt": "2026-10-31"
