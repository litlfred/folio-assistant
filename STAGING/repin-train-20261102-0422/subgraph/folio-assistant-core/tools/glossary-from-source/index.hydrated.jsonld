            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--id"
            },
            "description": "The scheme id, for a new file.",
            "name": "id",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "stdin": true
            },
            "description": "The scheme title, for a new file: free text, so it goes on stdin.",
            "name": "title",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "arg": {
              "flag": "--from"
            },
            "description": "A directory whose glossary and abbreviations sections are read: an L1 entry's `sections/`.",
            "name": "from",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--terms"
            },
            "description": "A Markdown file read as term and definition rows.",
            "name": "terms",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--abbreviations"
            },
            "description": "A Markdown file read as acronym and expansion rows.",
            "name": "abbreviations",
