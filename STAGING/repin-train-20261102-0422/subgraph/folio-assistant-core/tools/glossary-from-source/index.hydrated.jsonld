      "@type": "cat-harness:Tool",
      "description": "Read a source's glossary and abbreviations sections (an L1 entry's sections/, or a folio block) into `candidate` terms of a folio-glossary/v1 scheme, verbatim, each with `source: <file>#L<line>`. Acronyms fold into the term they expand as `notation`. The scheme is merged: terms a person owns are never changed. `--check` writes nothing and fails when the scheme would change.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat glossary:from-source"
      },
      "io": {
        "inputs": [
          {
            "arg": {
