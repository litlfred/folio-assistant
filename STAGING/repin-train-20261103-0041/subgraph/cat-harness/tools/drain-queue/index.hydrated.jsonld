      "@type": "cat-harness:Tool",
      "description": "Read every bean copy, keep the drainable open beans (task, bug, feature in todo or in-progress, not blocked, not owner-held), group them by the owner already working in that area, mark the ones another agent touched within the window as skip, and list everything left out with its reason and every bean whose copies disagree. The newest updated_at wins where copies disagree.",
      "install": {
        "none": true
      },
      "invoke": {
        "inProcess": {
          "module": "scripts/drain-queue.ts"
        },
        "shell": "bun run cat beans:drain-queue"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--copy"
            },
            "description": "A local checkout of a bean copy, fetched by the tool to its bean ref. Repeat once per copy. Defaults to the current checkout.",
            "name": "copy",
            "repeated": true,
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--holdings"
            },
            "description": "A JSON file mapping each owner to the bean ids it holds (`holdings` in the skill's input schema).",
            "name": "holdings",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--agents"
            },
            "description": "A JSON file of the agents and their commit authors (`agents` in the skill's input schema). Defaults to the table in the bean-drain skill.",
            "name": "agents",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--window"
            },
            "description": "Another agent's commit within this window marks a bean skip. Defaults to 24h.",
            "name": "window",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/TimeWindow"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "description": "Emit the queue as JSON matching `definitions.queue`, instead of Markdown.",
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "The queue: sources with the tip each was read at, one section per owner in priority order, the spare pool, the excluded beans with reasons, and the copies that disagree. With --json, the same as `definitions.queue` of schemas/skills/bean-drain/output.schema.json. A copy that cannot be fetched is an error, never an empty queue.",
            "name": "queue",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          },
          {
            "description": "With --json, the queue as one `DrainQueue` record: sources, owner sections in priority order, the spare pool, exclusions and disagreeing copies. Programs read this; people read `queue`.",
            "name": "result",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/DrainQueue"
          }
        ]
      },
