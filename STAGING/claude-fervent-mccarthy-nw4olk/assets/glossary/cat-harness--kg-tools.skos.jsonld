        }
      ],
      "skos:notation": "docs-auto-viewer",
      "dcterms:source": "cat-harness/tools/viewers.ts#docs-auto-viewer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/external-schemas-viewer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "External schemas viewer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render the declared external schemas, and which of this instance's modules conform to each, as one page."
        }
      ],
      "skos:notation": "external-schemas-viewer",
      "dcterms:source": "cat-harness/tools/viewers.ts#external-schemas-viewer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/feature-staging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Stage a branch's preview"
        }
      ],
      "skos:definition": [
        {
          "@value": "Publish a branch's built site to `STAGING/<slug>/` on the publish branch, so a reviewer compares a rendered before and after rather than a description of one. Stamps the commit SHA, and removes the preview when its pull request closes."
        }
      ],
      "skos:notation": "feature-staging",
      "dcterms:source": "cat-harness/tools/index.ts#feature-staging",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/folio-block-qa-summary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio block QA summary"
        }
      ],
      "skos:definition": [
        {
          "@value": "Summarise a folio's committed per-block QA verdicts into one `block-qa.json` a staging preview publishes: each block is failing (a FRESH verdict failed, with the worst severity), stale (a verdict predates the block's current files), passing, or unaudited. Freshness is the QA sweep's own rule, including the uses-graph hash for graph-scoped criteria. Runs no checker and writes no verdict."
        }
      ],
      "skos:notation": "folio-block-qa-summary",
      "dcterms:source": "cat-harness/tools/index.ts#folio-block-qa-summary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/folio-block-screenshots",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio block screenshots"
        }
      ],
      "skos:definition": [
        {
          "@value": "Picture each changed figure, diagram, table, equation or simulator block on the published main site and on a staging build, and compare the two pictures pixel by pixel in Chromium's canvas. Writes `visual-diff.json` (`folio-visual-diff/v1`: per block, the share of pixels changed beyond anti-aliasing, and the before, after and diff pictures) and `visual/*.png`, which the review page's visual renderer shows. A side that cannot be pictured (page or anchor missing) is recorded as missing, never drawn blank. Adds no dependency: Playwright is already the platform's browser driver."
        }
      ],
      "skos:notation": "folio-block-screenshots",
      "dcterms:source": "cat-harness/tools/index.ts#folio-block-screenshots",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/folio-init",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Scaffold a folio"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create a new folio repository that uses this platform — folio/, uploads/, library/, the first manifests, the builder shim, agent files, and the link back to the platform."
        }
      ],
      "skos:notation": "folio-init",
      "dcterms:source": "cat-harness/tools/mcp.ts#folio-init",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/folio-viewer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio viewer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render each declared folio directory as a browsable page over its published index."
        }
      ],
      "skos:notation": "folio-viewer",
      "dcterms:source": "cat-harness/tools/viewers.ts#folio-viewer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/fsh-cone",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "FSH dependency cone"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compute the dependency cone over an IG's FSH graph, and the blast radius of a set of changed files. What makes an incremental IG build possible: without it, any edit rebuilds everything."
        }
      ],
      "skos:notation": "fsh-cone",
      "dcterms:source": "cat-harness/tools/index.ts#fsh-cone",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "The platform's quality gates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the checks CI runs, derived from the workflow rather than listed here. One Tool for all of them, not one per gate: the list is computed from `.github/workflows/code-quality-gates.yml` at call time, so it cannot drift from what CI actually enforces."
        }
      ],
      "skos:notation": "gates",
      "dcterms:source": "cat-harness/tools/index.ts#gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/gates-merged",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Gates on the merged tree"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build this branch merged with the current base in a throwaway worktree and run the full `bun run gates` there — the state a merge will actually produce, which neither the branch's CI nor the base's CI evaluates. Exit 0 passes, 1 conflicts or fails, 2 could not determine (never read as clean). The working copy is never touched."
        }
      ],
      "skos:notation": "gates-merged",
      "dcterms:source": "cat-harness/tools/index.ts#gates-merged",
      "skos:note": "candidate"
    },
