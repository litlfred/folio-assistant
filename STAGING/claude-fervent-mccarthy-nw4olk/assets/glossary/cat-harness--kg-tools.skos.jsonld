      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "GitHub"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open and drive change proposals on GitHub — branches, pull requests, reviews, checks. One forge among possible others; the skills it satisfies name none."
        }
      ],
      "skos:notation": "github",
      "dcterms:source": "cat-harness/tools/index.ts#github",
      "skos:note": "candidate"
    },
