      "skos:prefLabel": [
        {
          "@value": "TeX-source hazard audit"
        }
      ],
      "skos:definition": [
        {
          "@value": "Catch the source patterns that crash pdflatex but read as ordinary prose — a bare `_` or `^` in a bibliography field, `|` inside a markdown table cell where it is also the column separator, a `$…$` span across two lines, markdown link syntax inside a fenced tex block, a double subscript. Born from named build failures rather than from a style opinion."
        }
      ],
      "skos:notation": "tex-source-audit",
