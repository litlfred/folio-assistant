        }
      ],
      "skos:definition": [
        {
          "@value": "STUB — not implemented. Would read a delimited text file into CSVW: one table, its columns and their datatypes. A CSV has no sheets and no cells outside the table, so `fac:anchor.sheet` and `fac:anchor.cell` are a determined null rather than an absence. Routing a CSV is not a sniff — it has no magic bytes — and must not become an extension guess (bean `p67i`)."
        }
      ],
      "skos:notation": "tabular-csv",
      "dcterms:source": "cat-harness/tools/index.ts#tabular-csv",
