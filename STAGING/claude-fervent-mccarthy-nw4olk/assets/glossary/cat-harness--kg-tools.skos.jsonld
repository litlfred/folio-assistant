      },
      "skos:prefLabel": [
        {
          "@value": "Do the Tool nodes agree with their skills?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check every Tool node's joins: that each `satisfies` resolves to a real skill and agrees with that skill's declared contract, that every io port names a declared type, and that no argv input has a type able to express a shell payload."
        }
      ],
      "skos:notation": "check-tools",
      "dcterms:source": "cat-harness/tools/index.ts#check-tools",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/ci-health",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Is CI passing on the default branch?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Report each workflow's state on the default branch, which a checkout cannot see: a red workflow looks exactly like a green one from in here. One API call over the recent run history, not one request per workflow — fanning out would exhaust the unauthenticated 60/hr limit and make it unusable at session start."
        }
      ],
      "skos:notation": "ci-health",
      "dcterms:source": "cat-harness/tools/index.ts#ci-health",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/content-context",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Content JSON-LD context"
        }
      ],
      "skos:definition": [
        {
          "@value": "Emit the published JSON-LD `@context` that both populations share — authored block siblings and ingested `library/**` nodes reference it by URL — generated from its TypeScript definition rather than hand-kept."
        }
      ],
      "skos:notation": "content-context",
      "dcterms:source": "cat-harness/tools/index.ts#content-context",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/content-graph-analysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Editorial content-graph analysis"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build the block- and section-level editorial dependency graph of one paper from its `.ts` manifests and report forward references, cross-chapter coupling, sparse or dense sections and isolated blocks, ranked. Reads `uses[]`/`interprets` only — the editorial relation, never the formal one."
        }
      ],
      "skos:notation": "content-graph-analysis",
      "dcterms:source": "cat-harness/tools/index.ts#content-graph-analysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/content-graph-build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Content graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build the content graph under a path and report its edges, separated into the EDITORIAL relation an author maintains and the FORMAL one derived from Lean. Reading the two as one number is how the editorial signal gets overwritten."
        }
      ],
      "skos:notation": "content-graph-build",
      "dcterms:source": "cat-harness/tools/index.ts#content-graph-build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/content-graph-uml",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "A paper's block graph as UML"
        }
      ],
      "skos:definition": [
        {
          "@value": "Draw a paper's block graph from buildContentGraph: chapters as packages, editorial edges (uses / interprets) solid and formal Lean edges (type / value) dashed purple, never one derived from the other, and each block filled by its formalization status from proof-objects.json when given. One diagram for the paper and one per chapter, each in portrait and landscape, stamped with its source's hash. Run from a folio: the platform carries no paper."
        }
      ],
      "skos:notation": "content-graph-uml",
      "dcterms:source": "cat-harness/tools/index.ts#content-graph-uml",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/content-manifest-validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Content manifest validation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Validate the block manifests under a path against their schemas. Exits 2 where no folio is present rather than reporting a clean run — the platform carries no content, and a validator that passes over nothing is how this one validated nothing for a while."
        }
      ],
      "skos:notation": "content-manifest-validate",
      "dcterms:source": "cat-harness/tools/index.ts#content-manifest-validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/context-prefixes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "JSON-LD prefix check"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check every committed JSON-LD document in both directions: each prefix a context binds is spoken by something (or forward-declared with a reason), each prefix a document SPEAKS as a key or `@type` is bound in its context, each binding onto one of our own namespaces is spelt as that instance's stub, and every plain key in a document on the published content context is a declared term (never descending into an `@json` value). A context it cannot resolve is reported as undetermined, never clean."
        }
      ],
      "skos:notation": "context-prefixes",
      "dcterms:source": "cat-harness/tools/index.ts#context-prefixes",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/discuss",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "discussion"
        }
      ],
      "skos:definition": [
        {
          "@value": "Put a question to a person or a sibling agent and receive an answer, to determine which harness this repository should become and which repositories are read from and written to. The two facts no file holds."
        }
      ],
      "skos:notation": "discuss",
      "dcterms:source": "cat-harness/tools/index.ts#discuss",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools/docs-auto-viewer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Generated index pages"
        }
      ],
      "skos:definition": [
