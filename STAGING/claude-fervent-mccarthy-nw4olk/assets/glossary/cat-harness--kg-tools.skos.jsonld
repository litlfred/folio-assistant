      },
      "skos:prefLabel": [
        {
          "@value": "Glossary build"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build a paper's glossary index from its manifests and render the LaTeX. `--check` reports drift instead of writing, comparing everything except the `generated` timestamp so a re-run is not mistaken for a change."
        }
      ],
      "skos:notation": "glossary-build",
      "dcterms:source": "cat-harness/tools/index.ts#glossary-build",
      "skos:note": "candidate"
