{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "bs": "https://litlfred.github.io/folio-assistant/cat-bootstrap/ns#",
    "cat": "https://litlfred.github.io/folio-assistant/cat-harness/ns#",
    "fac": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "isDefinedBy": {
      "@id": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "seeAlso": {
      "@id": "rdfs:seeAlso",
      "@type": "@id"
    }
  },
  "@id": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
  "@type": "owl:Ontology",
  "label": "folio-assistant vocabulary",
  "comment": "Every class and property the folio knowledge graph projects, one node each. Generated by scripts/ns-export.ts; graph-kind definitions are read from the declaration registry rather than restated here.",
  "@graph": [
    {
      "@id": "cat:FshGutsNode",
      "@type": "rdfs:Class",
      "label": "FshGutsNode",
      "comment": "One item in the trashcan: something deprecated or thrown away, kept and addressable rather than deleted, and deliberately absent from the rendered site. Carries where it used to live, so it is not an orphan.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:Instance",
      "@type": "rdfs:Class",
      "label": "Instance",
      "comment": "A repository carrying a harness declaration — it names itself, its published stub, and the directories it holds.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness",
      "seeAlso": "https://litlfred.github.io/agentic-harness.html"
    },
    {
      "@id": "cat:Folio",
      "@type": "rdfs:Class",
      "label": "Folio",
      "comment": "A repository that authors folio content — it declares a content type, and `folio_init` wrote its config. Distinct from an Instance: this repository's `cat-harness/` is an Instance and is not a Folio.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness",
      "seeAlso": "https://litlfred.github.io/getting-started.html"
    },
    {
      "@id": "cat:SushiProject",
      "@type": "rdfs:Class",
      "label": "SushiProject",
      "comment": "A repository SUSHI will build — FSH compiled to a FHIR implementation guide. Minted here because SUSHI publishes no logical model for its own config; this is our name for the membership, not a claim to define SUSHI.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "bs:Actor",
      "@type": "rdfs:Class",
      "label": "Actor",
      "comment": "A concrete participant — human, agentic or mechanical — that persists across processes and takes on a role in each.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/agentic-harness.html"
    },
    {
      "@id": "cat:Convention",
      "@type": "rdfs:Class",
      "label": "Convention",
      "comment": "A standing rule an actor must hold while performing a task, bound to a process, a lane or an activity rather than loaded unconditionally. Resolution is first-binding-wins along that order, not a merge, so a reader asking why a rule applies here gets one answer.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness",
      "seeAlso": "https://litlfred.github.io/agentic-harness.html"
    },
    {
      "@id": "cat:Requirement",
      "@type": "rdfs:Class",
      "label": "Requirement",
      "comment": "A stated need a change must satisfy, elicited and signed off in the CRDM process before implementation begins. Distinct from the issue that tracks it and the bean that plans the work.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness",
      "seeAlso": "https://litlfred.github.io/crdm-methodology.html"
    },
    {
      "@id": "bs:Role",
      "@type": "rdfs:Class",
      "label": "Role",
      "comment": "A BPMN swimlane: the persona an actor takes on because of the lane it is acting in, carrying that lane's skills.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/agentic-harness.html"
    },
    {
      "@id": "bs:Skill",
      "@type": "rdfs:Class",
      "label": "Skill",
      "comment": "The instruction body an actor needs to perform a task.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/skills.html"
    },
    {
      "@id": "cat:SkillPackage",
      "@type": "rdfs:Class",
      "label": "SkillPackage",
      "comment": "A directory of skills shipped and versioned together.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness",
      "seeAlso": "https://litlfred.github.io/skills.html"
    },
    {
      "@id": "bs:Process",
      "@type": "rdfs:Class",
      "label": "Process",
      "comment": "A BPMN process: lanes that bind roles, activities that name skills, and the flow between them.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/publication-workflow.html"
    },
    {
      "@id": "bs:ProcessNode",
      "@type": "rdfs:Class",
      "label": "ProcessNode",
      "comment": "One element of a process — an activity, a gateway, a start or end event.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/publication-workflow.html"
    },
    {
      "@id": "bs:SequenceFlow",
      "@type": "rdfs:Class",
      "label": "SequenceFlow",
      "comment": "A directed edge between two process nodes.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/publication-workflow.html"
    },
    {
      "@id": "cat:Tool",
      "@type": "rdfs:Class",
      "label": "Tool",
      "comment": "A callable operation the harness exposes, declared as a node rather than only as code.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness",
      "seeAlso": "https://litlfred.github.io/architecture.html"
    },
    {
      "@id": "cat:Schema",
      "@type": "rdfs:Class",
      "label": "Schema",
      "comment": "A schema definition, itself a node in the knowledge graph rather than an island beside one.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:Capability",
      "@type": "rdfs:Class",
      "label": "Capability",
      "comment": "Something an actor's environment provides — a binary, a service, a credential — probed rather than assumed.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "bs:Directory",
      "@type": "rdfs:Class",
      "label": "Directory",
      "comment": "A declared place to look, naming the kinds of graph found in it.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/architecture.html"
    },
    {
      "@id": "bs:Asset",
      "@type": "rdfs:Class",
      "label": "Asset",
      "comment": "A file an instance declares as its own, with the role that file plays for it — the instance saying what something IS rather than a scan inferring it.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/architecture/harness-instances.html"
    },
    {
      "@id": "bs:GraphKind",
      "@type": "rdfs:Class",
      "label": "GraphKind",
      "comment": "What a declared directory holds — the vocabulary a consumer matches on to decide whether to scan it.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap",
      "seeAlso": "https://litlfred.github.io/architecture.html"
    },
    {
      "@id": "cat:Harness",
      "@type": "rdfs:Class",
      "label": "Harness",
      "comment": "An instance's root declaration: the directories it scans and the graphs they hold.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness",
      "seeAlso": "https://litlfred.github.io/architecture.html"
    },
    {
      "@id": "fac:Image",
      "@type": "rdfs:Class",
      "label": "Image",
      "comment": "A declared picture belonging to an instance, carrying its role, its layout and any text region.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "cat:RoleGraph",
      "@type": "rdfs:Class",
      "label": "RoleGraph",
      "comment": "The role registry as a graph — every role, what it inherits, and the lanes it binds.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "fac:FolioGraph",
      "@type": "rdfs:Class",
      "label": "FolioGraph",
      "comment": "Authored content — the folio itself, rendered to a website.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core",
      "seeAlso": "https://litlfred.github.io/content-types.html"
    },
    {
      "@id": "fac:PreviewGraph",
      "@type": "rdfs:Class",
      "label": "PreviewGraph",
      "comment": "A staging target: the same folio built for review rather than for release.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:UnknownGraph",
      "@type": "rdfs:Class",
      "label": "UnknownGraph",
      "comment": "A declared graph kind nothing recognises — reported as its own state, never silently treated as empty.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "cat:BeanDefsGraph",
      "@type": "rdfs:Class",
      "label": "BeanDefsGraph",
      "comment": "Work items — one Markdown file each, in the layout the `beans` CLI reads. Authored and edited by people and agents.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:BeanGraph",
      "@type": "rdfs:Class",
      "label": "BeanGraph",
      "comment": "The work plan — what is being worked on, and where each running BPMN instance got to. Its inner directories are declared by `beans/beans.json`.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:CatalogueGraph",
      "@type": "rdfs:Class",
      "label": "CatalogueGraph",
      "comment": "A remote catalogue modelled by reference — communities, collections and items of a corpus the instance does not hold. Every node declares whether its bytes are here (`materialized`), elsewhere (`referenced`) or unestablished (`unknown`), with no default. Distinct from `library`, which is content that IS here.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:DocsGraph",
      "@type": "rdfs:Class",
      "label": "DocsGraph",
      "comment": "Documentation ABOUT the knowledge graph — how the harness works, what its directories hold, how a process runs. Rendered by the plain just-the-docs pipeline. Distinct from `folio`, which is content an author CREATES using the graph; the difference is the SUBJECT, not the format. The who-iris catalogue is `library/`; a note about it is a `folio`; the page explaining how ingestion works is `docs`.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:FshGutsGraph",
      "@type": "rdfs:Class",
      "label": "FshGutsGraph",
      "comment": "Deprecated and throwaway structured content — kept, addressable and exported, and deliberately absent from the rendered site. The destination for anything that would otherwise be deleted, and for SDLC churn that must not reach the folio's readers.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:HealthGraph",
      "@type": "rdfs:Class",
      "label": "HealthGraph",
      "comment": "Repository health reports — one `health-report/v1` document per sweep, carrying every check's three-state verdict, the thresholds it applied and the basis each threshold was chosen on. Generated by `test/health/run.ts`; never hand-edited.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:InteractionGraph",
      "@type": "rdfs:Class",
      "label": "InteractionGraph",
      "comment": "How a person wants to be asked — read at session start, never written by a process.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:IssueMarkGraph",
      "@type": "rdfs:Class",
      "label": "IssueMarkGraph",
      "comment": "How far an agent has read an issue — the comment id and the edit time it accounted for.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "bs:KnowledgeGraph",
      "@type": "rdfs:Class",
      "label": "KnowledgeGraph",
      "comment": "Skills, workflows, roles — the harness layer's own knowledge graph.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap"
    },
    {
      "@id": "fac:LibraryGraph",
      "@type": "rdfs:Class",
      "label": "LibraryGraph",
      "comment": "L1 source content — one `<bib-slug>/` per ingested document, holding `sections/*.md`, `structure.json` and, where the source was scanned, `ocr/page-NNN.txt`. Every knowledge-graph reference to a source resolves through here, never to a loose path or a bare URL.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "cat:MemoryGraph",
      "@type": "rdfs:Class",
      "label": "MemoryGraph",
      "comment": "Durable facts an agent carries between sessions. Read during a process, never written by one.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:MethodologyGraph",
      "@type": "rdfs:Class",
      "label": "MethodologyGraph",
      "comment": "Judgement methodologies, adopted whole and kept independent — parallel ways to reach a decision, selected by context.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:QaGraph",
      "@type": "rdfs:Class",
      "label": "QaGraph",
      "comment": "QA witnesses — one `qa-witness/v1` document per audited subject, in three families (`block`, `kg`, `translation`), projected for the docs site from the verdicts that live beside their subjects. Generated; never hand-edited.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "bs:SchemaGraph",
      "@type": "rdfs:Class",
      "label": "SchemaGraph",
      "comment": "Schema definitions, self-declared in the smart-base manner.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "cat-bootstrap"
    },
    {
      "@id": "cat:SessionStateGraph",
      "@type": "rdfs:Class",
      "label": "SessionStateGraph",
      "comment": "A session's context — the acting actor, the instances it has open, and what it waits on.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "fac:TodoFeedbackGraph",
      "@type": "rdfs:Class",
      "label": "TodoFeedbackGraph",
      "comment": "Feedback items — todos raised against a specific block, carrying the submitter's identity. Read by the `todo-review` skill.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:TodoGraph",
      "@type": "rdfs:Class",
      "label": "TodoGraph",
      "comment": "Human actors' outstanding work — content, owned by the folio, tagged by role, process, task and identity. Its inner directories are declared by `todos/todos.json`.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:TodoItemsGraph",
      "@type": "rdfs:Class",
      "label": "TodoItemsGraph",
      "comment": "Todo nodes — one file each, carrying `\"$schema\": \"folio-todo/v1\"`. Authored by people and by agents on their behalf.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "cat:ToolGraph",
      "@type": "rdfs:Class",
      "label": "ToolGraph",
      "comment": "Tool definitions — themselves nodes in the KG, per the repo taxonomy.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:TranslationSourceGraph",
      "@type": "rdfs:Class",
      "label": "TranslationSourceGraph",
      "comment": "POT templates, PO catalogues and their `TranslationNode` manifests, one directory per target locale. The INPUT to injection; the rendered output is ordinary content that declares its own `lang`.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "fac:UploadsGraph",
      "@type": "rdfs:Class",
      "label": "UploadsGraph",
      "comment": "The incoming queue — raw files as dropped, before ingestion. NOT L1, and not greppable as corpus: a document here reads as absent to every consumer.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:VoiceGraph",
      "@type": "rdfs:Class",
      "label": "VoiceGraph",
      "comment": "Editorial voice profiles — one JSON each, carrying `\"$schema\": \"folio-voice/v1\"`. Every rule cites the ingested source or KG node it was derived from. Opt-in per folio.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "cat:WaiverGraph",
      "@type": "rdfs:Class",
      "label": "WaiverGraph",
      "comment": "Confirmations a person granted in advance — each naming one gate, scoped to a session or a process run, each expiring.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:WorkflowStateGraph",
      "@type": "rdfs:Class",
      "label": "WorkflowStateGraph",
      "comment": "Running BPMN instances — one JSON file each, carrying `\"$schema\": \"folio-workflow-instance/v1\"`. Owned by the interpreter, never hand-edited.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:partOf",
      "@type": "rdf:Property",
      "label": "partOf",
      "comment": "The node this one belongs to.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:inPackage",
      "@type": "rdf:Property",
      "label": "inPackage",
      "comment": "The skill package a skill ships in.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:inSubgraph",
      "@type": "rdf:Property",
      "label": "inSubgraph",
      "comment": "The DECLARED DIRECTORY a node was projected from — the named subgraph it belongs to, as a link to that directory's own node rather than a bare id. Derived from the instance's declaration, longest path prefix winning, and INHERITED through `partOf` for nodes that have no path of their own (a ProcessNode is part of a diagram, not a file). A node with no value belongs to no declared directory — vocabulary nodes are minted from the namespace rather than from any file — and that absence is reported as its own state rather than folded into a default.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:localId",
      "@type": "rdf:Property",
      "label": "localId",
      "comment": "The node's own identifier within its file, before any IRI is minted.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:module",
      "@type": "rdf:Property",
      "label": "module",
      "comment": "The source module a node was projected from.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:path",
      "@type": "rdf:Property",
      "label": "path",
      "comment": "A declared directory's path, relative to the instance root.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:assetRole",
      "@type": "rdf:Property",
      "label": "assetRole",
      "comment": "What a declared asset is FOR, as the instance names it — `instance-readme`, `agent-instructions`. A literal, and not the swimlane Role, which is a node with skills.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:typeIri",
      "@type": "rdf:Property",
      "label": "typeIri",
      "comment": "The IRI of a node's type, so a consumer need not parse the `@type` string.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:statement",
      "@type": "rdf:Property",
      "label": "statement",
      "comment": "What a convention REQUIRES, in one line. Distinct from rdfs:comment, which is prose about the node: this is the rule itself, and a consumer filtering for enforceable text needs the two apart.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:rationale",
      "@type": "rdf:Property",
      "label": "rationale",
      "comment": "Why a convention holds, so a reader can tell whether it still does. Kept separate from the statement deliberately — a rule and its justification collapsed into one field is a rule nobody can retire, because nothing is left that says what would falsify it.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:applies",
      "@type": "rdf:Property",
      "label": "applies",
      "comment": "The surfaces a convention governs — `typescript`, `bpmn`, `commit-message`. A filter, not prose, and open rather than enumerated: a closed set would have to be edited before a convention about a new surface could exist.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:nodeKind",
      "@type": "rdf:Property",
      "label": "nodeKind",
      "comment": "Which kind of node this is, where the type alone is not specific enough.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:graphKind",
      "@type": "rdf:Property",
      "label": "graphKind",
      "comment": "The kind of graph a directory declares it holds.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:holdsGraph",
      "@type": "rdf:Property",
      "label": "holdsGraph",
      "comment": "A graph kind found in this directory.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:renderable",
      "@type": "rdf:Property",
      "label": "renderable",
      "comment": "Whether a directory's contents are published as a website.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:scans",
      "@type": "rdf:Property",
      "label": "scans",
      "comment": "A directory an instance will look in.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:scope",
      "@type": "rdf:Property",
      "label": "scope",
      "comment": "Which root a declared path resolves against — the instance's or the repository's.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:dependents",
      "@type": "rdf:Property",
      "label": "dependents",
      "comment": "Whether an instance depending on this one materialises its own copy of a declared directory. Orthogonal to `scope`, which says where a path resolves rather than who gets one.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "harness"
    },
    {
      "@id": "cat:movedOn",
      "@type": "rdf:Property",
      "label": "movedOn",
      "comment": "When a node was moved into the trashcan.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
