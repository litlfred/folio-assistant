      "@type": "cat-harness:Tool",
      "description": "Draw every journey (`user-scenario`) and workshop (`workshop`) in the checkout as static pages at the route of the visualiser an instance declares for this Tool, `<locale>/<instance>/<id>/`: an index of all journeys, grouped by instance (each a sub-graph page) and by `partOf`, ordered along `follows`; one page per journey, a journey map with a lane and a feeling curve per persona, then each step with its BPMN drawing (the step's flow nodes highlighted), user stories, requirements, FHIR examples, building blocks and ArchiMate views; and the workshop layer, the questions for the room on each step, a page per workshop and per module, job aids, and printable A3/A4 sheets. Instances below the declaring one are read through their declarations, so a downstream site shows the journeys of the layers it mounts too.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat journeys:viz"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--instance"
            },
            "description": "The instance whose `visualisers` declare this Tool: the pages go to that visualiser's route. One that declares none gets nothing, and the run exits 78 (not applicable).",
            "name": "instance",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--site"
            },
            "description": "A site being built: the pages are written at the declared route under it. Absent, under the instance's own site directory. The route is this Tool's alone and is replaced whole.",
            "name": "site",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "The viewer's pages and its two assets (`assets/journeys.css`, `assets/journeys.js`), under the declared route.",
            "name": "pages",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "journeys-viewer",
