{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/claude-graph-kind-guard/kg/tool-types.schema.json",
  "title": "Tool I/O types",
  "description": "The shared types a Tool's io.inputs/io.outputs reference by absolute IRI. Generated from schemas/tool-types.ts, which is authoritative.",
  "$defs": {
    "BeanId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "A bean identifier, e.g. folio-assistant-1dfh",
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "BeanStatus": {
      "type": "string",
      "enum": [
        "draft",
        "todo",
        "in-progress",
        "completed",
        "scrapped"
      ],
      "description": "A bean status. Exactly what `beans update --status` accepts.",
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "RepoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._][A-Za-z0-9._/-]*$",
      "description": "A path relative to the repository root. No `..` segments.",
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "Url": {
      "type": "string",
      "format": "uri",
      "description": "An absolute http(s) URL",
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "Branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "description": "A git branch name",
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "ChangeProposalNumber": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "A change-proposal number — a pull request on GitHub, a merge request on GitLab",
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "Markdown": {
      "type": "string",
      "description": "Markdown text",
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
}
