    {
      "@id": "references/9789241548960-eng",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO handbook for guideline development",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2014-12-18",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789241548960",
      "dcterms:identifier": "https://iris.who.int/handle/10665/145714",
      "dcterms:language": "en",
      "dcterms:abstract": "This handbook provides comprehensive guidance on the planning, development, publication, implementation, adaptation and updating of WHO guidelines. Intended for WHO technical units, guideline developers, members of guideline development and external review groups, and other contributors, it describes the principles, methods and governance processes required to produce transparent, evidence-informed recommendations for clinical practice and public health policy that meet WHO standards.",
