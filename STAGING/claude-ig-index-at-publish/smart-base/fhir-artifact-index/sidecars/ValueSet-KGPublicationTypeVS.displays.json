{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/base/ValueSet-KGPublicationTypeVS.displays.json",
  "title": "Knowledge graph L1: publication type Display Values",
  "description": "Display values for Knowledge graph L1: publication type ValueSet codes. Generated from FHIR expansions. Keys are code fragments (the part after '#' in the canonical IRI). The full IRI can be reconstructed as system + '#' + code.",
  "type": "object",
  "properties": {
    "fhir:displays": {
      "type": "object",
      "description": "Multilingual display values for ValueSet codes keyed by code fragment",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "description": "Display values for a specific code fragment by language",
          "properties": {
            "en": {
              "type": "string",
              "description": "English display value"
            }
          },
          "patternProperties": {
            "^[a-z]{2}(-[A-Z]{2})?$": {
              "type": "string",
              "description": "Display value in the specified language (ISO 639-1 code)"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "fhir:displays"
  ],
  "additionalProperties": true,
  "fhir:displays": {
    "standard-guideline": {
      "en": "Standard guideline"
    },
    "consolidated-guideline": {
      "en": "Consolidated guideline"
    },
    "interim-guideline": {
      "en": "Interim guideline"
    },
    "rapid-advice-guideline": {
      "en": "Rapid advice guideline"
    },
    "emergency-guideline": {
      "en": "Emergency guideline"
    },
    "collaborative-guideline": {
      "en": "Collaborative guideline"
    },
    "external-guideline": {
      "en": "External guideline"
    },
    "adapted-guideline": {
      "en": "Adapted guideline"
    },
    "position-paper": {
      "en": "Position paper"
    },
    "summary-table": {
      "en": "Summary table"
    },
    "classification": {
      "en": "Classification"
    },
    "implementation-guidance": {
      "en": "Implementation guidance"
    },
    "methodology": {
      "en": "Methodology"
    },
    "supplement": {
      "en": "Supplement"
    }
  },
  "fhir:valueSet": "http://smart.who.int/base/ValueSet/KGPublicationTypeVS",
  "fhir:version": "0.3.0",
