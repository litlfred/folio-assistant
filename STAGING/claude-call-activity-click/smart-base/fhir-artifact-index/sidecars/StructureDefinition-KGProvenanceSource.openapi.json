{
  "openapi": "3.1.0",
  "info": {
    "title": "Knowledge graph: provenance source API",
    "description": "A source a graph document was extracted from, pinned by hash.",
    "version": "1.0.0"
  },
  "paths": {
    "/StructureDefinition-KGProvenanceSource.schema.json": {
      "get": {
        "summary": "JSON Schema definition for the Logical Model StructureDefinition-KGProvenanceSource",
        "description": "This endpoint serves the JSON Schema definition for the Logical Model StructureDefinition-KGProvenanceSource.",
        "responses": {
          "200": {
            "description": "The JSON Schema for StructureDefinition-KGProvenanceSource",
            "content": {
              "application/schema+json": {
                "schema": {
                  "$ref": "./StructureDefinition-KGProvenanceSource.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StructureDefinition-KGProvenanceSource": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "http://smart.who.int/base/StructureDefinition-KGProvenanceSource.schema.json",
        "title": "Knowledge graph: provenance source",
        "description": "A source a graph document was extracted from, pinned by hash.",
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "const": "KGProvenanceSource",
            "description": "Resource type identifier for KGProvenanceSource logical model"
          },
          "path": {
            "type": "string",
            "description": "Path of the source."
          },
          "sha256": {
            "type": "string",
            "description": "Hash of the source (64 lower-case hex digits)."
          },
          "repository": {
            "type": "string",
            "description": "Repository holding the source."
          },
          "commit": {
            "type": "string",
            "description": "Commit the source was read at."
          },
          "note": {
            "type": "string",
            "description": "What the hash covers, where that is not obvious."
