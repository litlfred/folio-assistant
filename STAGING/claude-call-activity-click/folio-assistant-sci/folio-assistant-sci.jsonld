    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-coverage.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "lean-coverage",
      "title": "Lean coverage",
      "description": "Count how many provable blocks — theorem, lemma, proposition, corollary — carry a full Lean proof rather than a sorry, per paper. The completeness half of the Lean audit: what is formalised, and what is still a gap.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-sci/scripts/lean-coverage.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "paper",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "One paper instead of all.",
            "required": false,
            "arg": {
              "flag": "--paper"
            }
          },
          {
            "name": "contentRoot",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where content blocks live. NOT a Lean project root — see the note above this node.",
            "required": false,
            "arg": {
              "flag": "--content-root"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          }
        ],
        "outputs": [
          {
            "name": "coverage",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Provable blocks, and how many are sorry-free. A count, not a verdict: a sorry-free proof can still be vacuous, which is the sibling node's question."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/lean-completeness-audit"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/lean-coverage.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-formal-edges.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "lean-formal-edges",
      "title": "Formal edges from the Lean build",
      "description": "Extract ELABORATED formal dependencies between a folio's lean.ref declarations (LeanArchitect's rule over the folio's own lean.ref set). Needs a Lean toolchain and a built Lake project. Tagged declarations missing from the build are reported, never recorded as dependency-free; with ingest the result is recorded in the formal cache as source \"elaborated\".",
      "install": {
        "none": true
      },
      "invoke": {
        "mcp": {
          "tool": "lean_formal_edges"
        },
        "inProcess": {
          "module": "pipeline/formal-edges-mcp.ts"
        }
      },
      "io": {
        "inputs": [
          {
            "name": "lake_dir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio's Lake project directory (holds lakefile.* and .lake/).",
            "required": true
          },
          {
            "name": "root",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Content root to collect lean.ref targets from (default: the folio's declared one).",
            "required": false
          },
          {
            "name": "ingest",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Record the result in the formal cache as source \"elaborated\".",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Markdown",
            "description": "The extracted edges, or why they could not be determined — never an empty edge set in place of a failure."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "lake"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/lean-formal-edges"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/lean-formal-edges.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-html-docs.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "lean-html-docs",
      "title": "Build a Lean package's HTML docs (doc-gen4)",
      "description": "Build the doc-gen4 HTML render of a folio's Lake package — the visualiser of a declared `lean` directory — with `lake -R -Kenv=dev build <Lib>:docs`, cache-aware: refuses while another lake/lean process holds `.lake/`, refuses on a restored tree that carries no traces (a Lake build there EVICTS the cache), checks or restores the warm cache first, and enables a sentinel-commented doc-gen4 `[[require]]` for this build only, restoring the lakefile on exit. Never runs `lake update`. Output: `<lake-root>/.lake/build/doc`.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bash folio-assistant-sci/adapters/paper/lean/lean-docs-build.sh"
      },
      "io": {
        "inputs": [
          {
            "name": "lakeRoot",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The Lake package directory whose lakefile requires (or sentinel-comments) doc-gen4, e.g. `folio/quantum-observable-universe/lean`.",
            "required": true,
            "arg": {
              "flag": "--lake-root"
            }
          },
          {
            "name": "lib",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/InstanceId",
            "description": "The `lean_lib` to document, e.g. `QOU` (a Lean library name: alphanumerics, dot, underscore, hyphen). Repeat for several.",
            "required": true,
            "arg": {
              "flag": "--lib"
            }
          },
          {
            "name": "platform",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The index checkout holding `lake-cache.sh`. Default `$FOLIO_ASSISTANT_ROOT`.",
            "required": false,
            "arg": {
              "flag": "--platform"
            }
          },
          {
            "name": "restore",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Restore the warm cache first (about 2 minutes) instead of only checking it.",
            "required": false,
            "arg": {
              "flag": "--restore"
            }
          },
          {
            "name": "allowCold",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Build without a warm cache: Mathlib from source, 30-60 minutes before doc-gen4 starts.",
            "required": false,
            "arg": {
              "flag": "--allow-cold"
            }
          },
          {
            "name": "dryRun",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Run every guard, print the build command, build nothing.",
            "required": false,
            "arg": {
              "flag": "--dry-run"
            }
          }
        ],
        "outputs": [
          {
            "name": "render",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`<lake-root>/.lake/build/doc`, doc-gen4's output, printed as the last line. Feed it to `lean-render-publish`."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bash",
          "git",
          "lake"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/lean-html-docs"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/lean-html-docs.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-kg-publish.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "lean-kg-publish",
      "title": "Publish the dynamic Lean viewer: doc-gen4 declaration data as knowledge-graph shards",
      "description": "Ingest doc-gen4's per-module declaration data (`.lake/build/doc-data/declaration-data-<Module>.bmp`) into JSON-LD shards — one per module, with declaration nodes, `imports` edges and `formalizes` edges to the content blocks whose `lean.ref` names each declaration — and publish them under the folio's site with a single viewer page that loads modules, signature chunks and the search list on demand. Signatures are chunked 500 declarations per file so a 12,804-declaration module stays usable. With `--base` it writes a STAGING overlay: only modules whose content hash differs from the published base, plus `overlay.json`; the viewer loads the rest from the base. Rails the viewer page with the same pass as `lean-render-publish`.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-sci/adapters/paper/lean/lean-kg-publish.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "docData",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "doc-gen4's `.lake/build/doc-data` from `lean-html-docs`.",
            "required": true,
            "arg": {
              "flag": "--doc-data"
            }
          },
          {
            "name": "site",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio's built site.",
            "required": true,
            "arg": {
              "flag": "--site"
            }
          },
          {
            "name": "route",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Where under the site. Default `lean`.",
            "required": false,
            "arg": {
              "flag": "--route"
            }
          },
          {
            "name": "module",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/PackageName",
            "description": "A module root to keep (`qou` keeps `QOU`). Repeat for several.",
            "required": false,
            "arg": {
              "flag": "--module"
            }
          },
          {
            "name": "contentRoot",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Content tree whose blocks' `lean.ref` become `formalizes` edges.",
            "required": false,
            "arg": {
              "flag": "--content-root"
            }
          },
          {
            "name": "repo",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoFullName",
            "description": "`owner/repo` for block links.",
            "required": false,
            "arg": {
              "flag": "--repo"
            }
          },
          {
            "name": "ref",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Branch",
            "description": "Branch or sha for block links.",
            "required": false,
            "arg": {
              "flag": "--ref"
            }
          },
          {
            "name": "contentPrefix",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Path of the content root inside the repo, for block links.",
            "required": false,
            "arg": {
              "flag": "--content-prefix"
            }
          },
          {
            "name": "base",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "Published `data/` of the base graph; enables the STAGING overlay.",
            "required": false,
            "arg": {
              "flag": "--base"
            }
          },
          {
            "name": "externalBase",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "Where links into pruned modules go. Default the community mathlib4 docs.",
            "required": false,
            "arg": {
              "flag": "--external-base"
            }
          },
          {
            "name": "homeLabel",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/InstanceId",
            "description": "The rail's home row.",
            "required": false,
            "arg": {
              "flag": "--home-label"
            }
          },
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/InstanceId",
            "description": "As rail-standalone-pages.ts --instance.",
            "required": false,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "platform",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The index checkout holding the rail pass.",
            "required": false,
            "arg": {
              "flag": "--platform"
            }
          },
          {
            "name": "noRail",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Publish only; the caller rails the site.",
            "required": false,
            "arg": {
              "flag": "--no-rail"
            }
          }
        ],
        "outputs": [
          {
            "name": "viewer",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`<site>/<route>/`: index.html, viewer.js/css, extracted signature styles, config.json and `data/` (index.json, names.json, m/<Module>.jsonld, m/<Module>.<k>.sig.json, overlay.json)."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/lean-html-docs"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/lean-kg-publish.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-render-publish.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "lean-render-publish",
      "title": "Publish a Lean render under a folio site, with the harness rail",
      "description": "Stage a doc-gen4 render under a folio's built site (`<site>/<route>/`, default `lean/`) and give every page the harness navbar and rail by running `cat-harness/scripts/rail-standalone-pages.ts --foreign-site` over the site — the same rail `stage-folio-local.ts` applies to the folio's own pages. Leaves out Lake's `.hash`/`.trace` bookkeeping, marks doc-gen4's iframe navbar and `find/` redirect `folio-navbar: none` so no rail is drawn inside the sidebar, adds a layout shim so the rail does not cover doc-gen4's fixed sidebar, and with `--modules` prunes to the folio's own modules, repointing links into dropped ones to the community docs. Then asserts every staged page is railed or declined.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-sci/adapters/paper/lean/lean-render.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "docs",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The doc-gen4 render, `lean-html-docs`'s output.",
            "required": true,
            "arg": {
              "flag": "--docs"
            }
          },
          {
            "name": "site",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio's built site (`_site` from build-folio-site.ts).",
            "required": true,
            "arg": {
              "flag": "--site"
            }
          },
          {
            "name": "route",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Where under the site. Default `lean`.",
            "required": false,
            "arg": {
              "flag": "--route"
            }
          },
          {
            "name": "module",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/PackageName",
            "description": "A Lake package whose module root to keep (`qou` keeps `QOU/`, matched case-insensitively). Repeat for several. Default: keep everything.",
            "required": false,
            "arg": {
              "flag": "--module"
            }
          },
          {
            "name": "externalBase",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "Where links into pruned modules go. Default the community mathlib4 docs.",
            "required": false,
            "arg": {
              "flag": "--external-base"
            }
          },
          {
            "name": "homeLabel",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/InstanceId",
            "description": "The rail's home row: the folio's instance name, e.g. `qou`.",
            "required": false,
            "arg": {
              "flag": "--home-label"
            }
          },
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/InstanceId",
            "description": "Rail as this instance's own site (its name, mark and graphs), as rail-standalone-pages.ts --instance.",
            "required": false,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "platform",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The index checkout holding the rail pass. Default `$FOLIO_ASSISTANT_ROOT`, then the nearest ancestor that has it.",
            "required": false,
            "arg": {
              "flag": "--platform"
            }
          },
          {
            "name": "noRail",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Stage only; the caller rails the site itself.",
            "required": false,
            "arg": {
              "flag": "--no-rail"
            }
          }
        ],
        "outputs": [
          {
            "name": "pages",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`<site>/<route>/`, railed, plus the rail's shared data under `<site>/assets/navbar/`."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/lean-html-docs"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/lean-render-publish.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-toolchain-setup.jsonld",
