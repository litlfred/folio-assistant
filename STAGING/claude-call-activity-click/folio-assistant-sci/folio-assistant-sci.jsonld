            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Markdown",
            "description": "Per-dependency: present, absent, or could not be determined."
