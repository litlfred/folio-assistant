    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/docs",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "docs",
      "renderable": true,
      "summary": "Documentation ABOUT the knowledge graph — how the harness works, what its directories hold, how a process runs. Rendered by the plain just-the-docs pipeline. Distinct from `folio`, which is content an author CREATES using the graph; the difference is the SUBJECT, not the format. An L1 library's catalogue is `library/`; a note about it is a `folio`; the page explaining how ingestion works is `docs`."
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/v0/ns#graphTypology/schemas",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
