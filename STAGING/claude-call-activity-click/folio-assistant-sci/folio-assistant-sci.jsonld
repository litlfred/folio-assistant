    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/proof-objects-extract.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "proof-objects-extract",
      "title": "Proof-object extraction",
      "description": "Extract the theorem, lemma and definition environments of a paper's LaTeX chapters into `proof-objects.json` — the manifest the dependency graph and the proof-status update read.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "python3 .github/scripts/extract_proof_objects.py"
      },
      "io": {
        "inputs": [
          {
            "name": "output",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where to write proof-objects.json.",
            "required": false,
            "arg": {
              "flag": "--output"
            }
          }
        ],
        "outputs": [
          {
            "name": "manifest",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "proof-objects.json. A chapter file that is missing is skipped with a warning, not treated as empty."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/proof-status-tracking"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/proof-objects-extract.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/proof-status-update.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "proof-status-update",
      "title": "Proof status from a Lean build",
      "description": "Update each proof object's status in `proof-objects.json` from a Lean build log — which objects built, which carry `sorry`, which failed. Exits 1 on a manifest with no objects rather than writing an empty status.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "python3 .github/scripts/update_proof_status.py"
      },
      "io": {
        "inputs": [
          {
            "name": "manifest",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The proof-objects.json to update.",
            "required": false,
            "arg": {
              "flag": "--manifest"
            }
          },
          {
            "name": "buildLog",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The Lean build log; stdin when absent.",
            "required": false,
            "arg": {
              "flag": "--build-log"
            }
          }
        ],
        "outputs": [
          {
            "name": "manifest",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "proof-objects.json with statuses updated in place."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/proof-status-tracking"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/proof-status-update.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/tex-install.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "tex-install",
      "title": "Install TeX Live in a sandbox",
      "description": "Install TeX Live (full) and latexmk where no TeX engine is present, disabling the firewalled launchpad PPAs that otherwise abort `apt-get update`. Idempotent: does nothing when pdflatex and memoize.sty are already present. About 5 GB and 10-20 minutes, so run it in the background. pdflatex unpacks early but is not usable until the post-install format build ends (`kpsewhich memoize.sty` returning a path is the ready signal).",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bash cat-harness-tools/scripts/install-tex.sh"
      },
      "io": {
        "inputs": [],
        "outputs": [
          {
            "name": "engine",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "A `pdflatex --version` line on success. The installed packages are system-wide."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bash",
          "apt-get",
          "sudo"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/latex-build-cache"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/tex-install.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/tex-snippet-validate.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "tex-snippet-validate",
      "title": "TeX snippet validation (AST)",
      "description": "Parse every `tex` snippet in a folio's blocks and report what will not compile — structural, not textual: it reads an AST rather than matching patterns. Complementary to `latex-preflight`, which gates a main.tex before a compile, and to `latex-overfull`, which reads a log after one.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat latex:validate"
      },
      "io": {
        "inputs": [
          {
            "name": "paper",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "One folio by slug. Absent, every folio the content root holds.",
            "required": false,
            "arg": {
              "flag": "--paper"
            }
          },
          {
            "name": "file",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A single `.md` block, for the narrow case.",
            "required": false,
            "arg": {
              "flag": "--file"
            }
          },
          {
            "name": "compile",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Also compile each snippet with pdflatex — needs a TeX distribution, which the base `requires` does NOT claim.",
            "required": false,
            "arg": {
              "flag": "--compile"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          },
          {
            "name": "warningsLog",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Write a QA-compatible log to this path.",
            "required": false,
            "arg": {
              "flag": "--warnings-log"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Per snippet, what will not compile. Run in the platform it reports `Files scanned: 0` and exits 2 — could-not-determine (this repository carries no folio, so there was nothing to scan). Read the scanned count before reading the verdict."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/latex-validation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/tex-snippet-validate.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/tex-source-audit.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "tex-source-audit",
      "title": "TeX-source hazard audit",
      "description": "Catch the source patterns that crash pdflatex but read as ordinary prose — a bare `_` or `^` in a bibliography field, `|` inside a markdown table cell where it is also the column separator, a `$…$` span across two lines, markdown link syntax inside a fenced tex block, a double subscript. Born from named build failures rather than from a style opinion.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat latex:audit-source"
      },
      "io": {
        "inputs": [
          {
            "name": "strict",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Exit 1 on any finding, for use as a gate.",
            "required": false,
            "arg": {
              "flag": "--strict"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Hazards with file and line, plus a committed sidecar. Run where no folio exists it says `No .md files found … refusing to report success. This audits a FOLIO's content; folio-assistant is the platform.` and exits 2 (could-not-determine)."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/latex-validation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/tex-source-audit.jsonld"
    },
