    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/content-manifest-validate.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "content-manifest-validate",
      "title": "Content manifest validation",
      "description": "Validate the block manifests under a path against their schemas. Exits 2 where no folio is present rather than reporting a clean run — the platform carries no content, and a validator that passes over nothing is how this one validated nothing for a while.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat content:validate"
      },
      "io": {
        "inputs": [
          {
            "name": "targetPath",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A paper or chapter directory; absent, every paper the folio declares.",
            "required": false,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "strict",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Treat warnings as errors.",
            "required": false,
            "arg": {
              "flag": "--strict"
            }
          }
        ],
        "outputs": [
          {
            "name": "issues",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "One line per issue, with its block and file. Exit 2 means NO FOLIO WAS FOUND — could-not-determine, never valid."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/content-validate",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/content-validation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/content-manifest-validate.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/headless-render-qc.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "headless-render-qc",
      "title": "Headless render QC (Playwright)",
      "description": "Drive a folio's built viewer in headless Chromium and report the blocks whose diagrams, SVGs, LaTeX math or markdown do not render — with `--screenshot` to save the pictures. This is the mechanised half of looking at it: a green gate set is not a rendering.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat render:headless-qc"
      },
      "io": {
        "inputs": [
          {
            "name": "screenshot",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Save the screenshots as well as the verdict — which is the point when the reader is a person rather than a gate.",
            "required": false,
            "arg": {
              "flag": "--screenshot"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Per block: rendered, or the failure. Needs a FOLIO's `build/viewer/paper.json` and its `folio-assistant/ui`, so it exits 2 with `No paper.json found` in the platform (could-not-determine)."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "chromium"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/rendered-verification"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/headless-render-qc.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/latex-image.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "latex-image",
      "title": "Compile LaTeX in a container",
      "description": "Compile a rendered paper's `main.tex` with latexmk inside a TeX Live (full) image, for a host with Docker but no TeX engine. The image carries TeX Live, latexmk, Pandoc, latexdiff, graphviz and poppler-utils; it does not run the content pipeline, which renders the chapters on the host first.",
      "install": {
        "container": "docker build -t folio-latex -f folio-assistant-sci/scripts/docker-latex-build/Dockerfile folio-assistant-sci/scripts/docker-latex-build"
      },
      "invoke": {
        "container": "docker run --rm -v .:/workspace -w /workspace folio-latex latexmk -pdf -interaction=nonstopmode"
      },
      "io": {
        "inputs": [
          {
            "name": "mainTex",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The rendered paper's top-level `.tex`, relative to the checkout.",
            "required": true,
            "arg": {
              "positional": 0
            }
          }
        ],
        "outputs": [
          {
            "name": "pdf",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The compiled PDF beside the input."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "docker"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/latex-build-cache"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/latex-image.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/latex-overfull.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "latex-overfull",
      "title": "LaTeX overfull-box report",
      "description": "Turn a pdflatex log's Overfull \\hbox warnings into a located, actionable report, with a threshold so a long tail of trivial overruns does not bury the real ones.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat latex:overfull"
      },
      "io": {
        "inputs": [
          {
            "name": "log",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The pdflatex log to read. Nothing to read means no answer, not a pass.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "min",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Dpi",
            "description": "Ignore overruns below this size — the long tail is noise, and reporting it hides the rest.",
            "required": false,
            "arg": {
              "flag": "--min"
            }
          },
          {
            "name": "max",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Dpi",
            "description": "Fail above this count, for use as a gate.",
            "required": false,
            "arg": {
              "flag": "--max"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Located overfull boxes. Requires a build log: with no log there is nothing to read, which is could-not-determine rather than clean."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/latex-validation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/latex-overfull.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/latex-preflight.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "latex-preflight",
      "title": "LaTeX preflight",
      "description": "Lint TeX source for the pdflatex-compile failure classes a permissive AST parser accepts — the ones that pass validation and then break the build.",
      "install": {
