    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/qa",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "qa",
      "renderable": false,
      "summary": "QA verdicts and their projections — kg-qa audits, block and translation QA, qa-witness documents for the docs site, the viewer-navbar audit, result roll-ups and test runs; every `$schema` family is named in `nodeSchemas`, which is the list — a count here would be a second one, and it was already wrong by one before `viewer-nav-qa/v1` was added. Generated; never hand-edited."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/attestations",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "attestations",
      "renderable": false,
      "summary": "QA attestations — the judgements a QA family carries across runs (pair attestations, voice reviews, agent and human verdicts, bibliography verifications and human reviews), one `qa-attestations/v1` file per subject, mirroring the derived family's tree. Kept on main where deleting derived results cannot reach them; each entry pins the hash it attested, so a stale one is detectable."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/code",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "code",
      "renderable": false,
      "summary": "Source code -- the modules, scripts and entry points an instance holds. Declared so that code is scannable at all: an undeclared file is one no checker has a reason to look at. Being declared here says nothing about whether a Tool node claims it, which is a separate question and a separate axis."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/library",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "library",
      "renderable": false,
      "summary": "L1 source content — one `<bib-slug>/` per ingested document, holding `sections/*.md`, `structure.json` and, where the source was scanned, `ocr/page-NNN.txt`. Every knowledge-graph reference to a source resolves through here, never to a loose path or a bare URL."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/software-library",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "software-library",
      "renderable": false,
      "summary": "Outside libraries a layer imports or vendors -- one generated `software-library` node per library per layer, with the version and sha512 its `bun.lock` pins, its SPDX licence, its range, whether it is a dev dependency, the files that import it and the shim that types it. Shares its core with `tool-release`."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/voices",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "voices",
      "renderable": false,
      "summary": "Editorial voice profiles — one JSON each, carrying `\"$schema\": \"folio-voice/v1\"`. Every rule cites the ingested source or KG node it was derived from. Opt-in per folio."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/translation-sources",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "translation-sources",
      "renderable": false,
      "summary": "POT templates, PO catalogues and their `TranslationNode` manifests, one directory per target locale. The INPUT to injection; the rendered output is ordinary content that declares its own `lang`."
    },
