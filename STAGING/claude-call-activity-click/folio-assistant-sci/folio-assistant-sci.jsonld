    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/proof-integration-watcher",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Skill",
      "name": "proof-integration-watcher",
      "title": "/proof-integration-watcher",
      "description": "Proof-QA integration watcher — watches origin/main + open active PRs + newly-opened PRs for narrative-proof (`.md`) or Lean-proof (`.lean`) changes, runs the proof QA skill suite on every detected change, queues gaps, attempts auto-discharge for easy sorries / naked conjectures with provable scaffolding, and escalates the rest to the author. Inherits shared mechanics (Monitor, subscriptions, queue, ledger, idle sweep, author-ask, watch-prepared-PRs, witness-drift recovery, billing-quick-fail flake, post-completion one-voice, sibling-PR comment protocol) from `local/integration-watcher`.",
      "instructionsPath": "skills/content/folio-paper-adapter/proof-integration-watcher.md",
      "instructionLines": 458,
      "hasInstructions": true,
