    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-build.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "lean-build",
      "title": "Lean build",
      "description": "Build every Lean project in the workspace from the root Lake manifest, so cross-package dependencies resolve against it rather than a possibly-stale per-paper manifest. Writes a committable build-status sidecar every run.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat lean:build-all"
      },
      "io": {
        "inputs": [
          {
            "name": "paper",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Build one paper instead of all of them.",
            "required": false,
            "arg": {
              "flag": "--paper"
            }
          },
          {
            "name": "cache",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Fetch the Mathlib cache first. A from-source Mathlib build is 30–60 minutes against ~2 for a restore.",
            "required": false,
            "arg": {
              "flag": "--cache"
            }
          },
          {
            "name": "update",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Run `lake update` before building.",
            "required": false,
            "arg": {
              "flag": "--update"
            }
          },
          {
            "name": "logDir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where logs and the status sidecar go.",
            "required": false,
            "arg": {
              "flag": "--log-dir"
            }
          }
        ],
        "outputs": [
          {
            "name": "status",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`lean-build-status.json` — committable, so a green build is distinguishable from one nobody ran."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bash",
          "lean",
          "lake"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/lean-build-fix"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/lean-build.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-cache.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "lean-cache",
      "title": "Lake olean cache",
      "description": "Restore, verify, seed and diagnose the prebuilt `.lake/` artefacts for a Lean package. Always try `restore` first: a from-source Mathlib build is 30–60 minutes, a restore about two.",
