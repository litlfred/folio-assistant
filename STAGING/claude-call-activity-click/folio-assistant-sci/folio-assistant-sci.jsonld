      "name": "check-dependencies",
      "title": "Dependency probe",
      "description": "Report which of the harness's optional and required dependencies are present on this machine, and what each unmet one blocks.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat check-deps",
        "mcp": {
          "tool": "check_dependencies"
