    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/lean-audit.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "lean-audit",
      "title": "Lean vacuity audit",
      "description": "Inspect Lean declarations chapter by chapter for proofs that type-check, are sorry-free and axiom-clean, and still carry no mathematical content — assuming what they claim, concluding something trivially true, or resting on a false premise.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-sci/scripts/lean-audit.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "chapter",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "One chapter instead of the whole corpus.",
            "required": false,
            "arg": {
              "flag": "--chapter"
            }
          },
          {
            "name": "strict",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "required": false,
            "arg": {
              "flag": "--strict"
            }
          },
          {
            "name": "checkAxioms",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Axiom-cleanliness is a separate question from vacuity: a proof can be axiom-clean and still assume its conclusion.",
            "required": false,
            "arg": {
              "flag": "--check-axioms"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Flag",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "findings",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Sorry inventory and trivial-truth detections. Sibling of `lean-coverage`, not an alternative to it: that one COUNTS what is proved, this one asks whether a proof says anything."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
