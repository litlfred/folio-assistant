    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/paper-feature-build.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "paper-feature-build",
      "title": "Paper feature build (changed chapters + latexdiff)",
      "description": "Quick preview of a paper folio's branch: render the paper with the sci print template (plus the folio's notation fragment when it has one), then compile ONLY the chapters changed against a base ref, and a colored and a plain latexdiff of each. Margin notes are off by default (`FAST_PREVIEW=1`, about 2x). Cross-references to chapters outside the build print as '??'. A preview, never a publish build. Run from the folio. Without a TeX engine the render still runs and the compile steps are skipped with a message.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bash folio-assistant-sci/adapters/paper/latex/feature-build.sh"
      },
      "io": {
        "inputs": [
          {
            "name": "base",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Branch",
            "description": "The ref to diff against. Default `origin/main`.",
            "required": false,
            "arg": {
              "flag": "--base"
            }
          },
          {
            "name": "chapters",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Chapter slugs, comma-separated. Default: the chapters whose sources changed against `base`.",
            "required": false,
            "arg": {
              "flag": "--chapters"
            }
          },
          {
            "name": "paper",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "The paper's slug. Default: the folio's only paper; with several, the tool refuses and names them.",
            "required": false,
            "arg": {
              "flag": "--paper"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Output directory, which the folio should gitignore. Default `build-feature`.",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          },
          {
            "name": "notation",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio's notation fragment, appended after the template. Default `<paper dir>/latex/notation-preamble.tex` when present.",
            "required": false,
            "arg": {
              "flag": "--notation"
            }
          },
          {
            "name": "preload",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Bun preload that configures the platform's injected registries (values, Lean packages). Default `scripts/preload-registry.ts` when present. It must import the same platform checkout as this tool.",
            "required": false,
            "arg": {
              "flag": "--preload"
            }
          }
        ],
        "outputs": [
          {
            "name": "preview",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`<out>/changed.pdf`, `<out>/<chapter>.diff-color.pdf` and `.diff-plain.pdf`, with the logs and `<out>/build.log` beside them. The render also rewrites the folio's `chapters/` and `main.tex`."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git",
          "bash"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/latex-build-cache"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/paper-feature-build.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/tools/paper-latex-build.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "paper-latex-build",
      "title": "Paper build to LaTeX chapters",
      "description": "Render a paper's content objects to LaTeX chapters: load the paper manifest, resolve its chapters and blocks, render, validate the LaTeX AST, and write the chapter files. With no manifest it builds the folio's only paper, and refuses — naming them — when there are several or none.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat content:build"
      },
      "io": {
        "inputs": [
          {
            "name": "paperManifest",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The paper's `<paper>.ts` manifest; absent, the folio's single paper.",
            "required": false,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "outDir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where to write the chapters; absent, `chapters/` at the content root.",
            "required": false,
            "arg": {
              "flag": "--out-dir"
            }
          }
        ],
        "outputs": [
          {
            "name": "chapters",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "One `.tex` per chapter under the output directory."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/skill/content-validation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/paper-latex-build.jsonld"
    },
