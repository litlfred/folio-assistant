    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-call-activity-click/folio-assistant-sci/directory/sci-adapters",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Subgraph",
