  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/archimate-detangle.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Searches for a less tangled drawing of each view: a line may be re-routed straight or orthogonally (an L, or a Z through a free lane between boxes), and two same-size boxes in the same parent and row or column may swap places. A change is kept only if it lowers crossings + lines through boxes + lines drawn on top of each other. Without `--apply` it reports before and after per view; with it, the model is written back in place, only the moved boxes' bounds and the re-routed lines' bendpoints changing.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat archimate:detangle"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--model"
            },
            "description": "The `.archimate` file (plain XML or Archi's zipped archive).",
            "name": "model",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--view"
            },
            "description": "One view, by its Archi id (`id-<hex>`) or its page slug (e.g. `1-central-health-workforce-registry`). A slug, not free text, so no shell payload can ride on it. Absent: every view in the model.",
            "name": "view",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--routes-only"
            },
            "description": "Never move a box; only re-route lines.",
            "name": "routes-only",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--apply"
            },
            "description": "Write the model back in place.",
            "name": "apply",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "description": "Print JSON instead of one line per view.",
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Per view: tangles before and after, and the swaps and routes made.",
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "archimate-detangle",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/archimate-models",
      "title": "Lower the tangles in ArchiMate views: re-route lines and swap same-size boxes in a row"
    }
  ],
