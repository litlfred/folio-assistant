      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/navbar-include.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Render `_includes/generated/navbar-footer.html` from `docs/_data/harness.json` with the same renderer every railed page uses. With `--instance`, render the navbar of an IG repository's OWN site instead — that instance first, then what it needs; its own pages at this site's root, every other link to the main site at `--link-root` — into the shell that site is built from (#2235).",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat navbar:include"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--check"
            },
            "description": "Fail if the committed include is stale; write nothing.",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "description": "The instance whose own site this navbar is for.",
            "name": "instance",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "description": "With `--instance`: the main site's URL, for every link that is not this instance's own.",
            "name": "link-root",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "With `--instance`: the label the navbar's home row carries.",
            "name": "title",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "description": "With `--instance`: where to write the include (the shell's `_includes/generated/navbar-footer.html`).",
            "name": "out",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "The include written, or `up to date`.",
            "name": "include",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "navbar-include",
