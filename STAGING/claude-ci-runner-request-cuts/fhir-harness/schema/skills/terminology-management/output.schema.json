{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terminology Management Output",
  "description": "Output schema for terminology management operations.",
  "type": "object",
  "required": [
    "resources"
  ],
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "resourceType"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "resourceType": {
            "type": "string",
            "enum": [
              "CodeSystem",
              "ValueSet",
              "ConceptMap"
            ]
          },
          "url": {
            "type": "string"
          },
          "conceptCount": {
            "type": "integer"
          }
        }
      }
    },
    "unmappedConcepts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Concepts that could not be mapped to the target standard."
    }
  },
  "$id": "https://litlfred.github.io/folio-assistant/fhir-harness/schema/skills/terminology-management/output.schema.json",
