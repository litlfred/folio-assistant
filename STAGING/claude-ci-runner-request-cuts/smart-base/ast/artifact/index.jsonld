      "dcterms:title": "Can translate content",
      "dcterms:description": "Capability to translate IG content across UN languages.",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/Requirements/SGAuthoring.Skills.TranslateContent"
      }
    },
    {
      "@id": "Requirements-SGAuthoring.Skills.ValidateArtifactConformance.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/SGAuthoring.Skills.ValidateArtifactConformance",
      "dcterms:title": "Can validate artifact conformance",
      "dcterms:description": "Capability to verify conformance to CRMI Shareable, Publishable, Computable, and Executable profiles.",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/Requirements/SGAuthoring.Skills.ValidateArtifactConformance"
      }
    },
    {
      "@id": "Requirements-SGAuthoring.Skills.ValidateDAKContent.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/SGAuthoring.Skills.ValidateDAKContent",
      "dcterms:title": "Can validate DAK content",
      "dcterms:description": "Capability to review and validate DAK components against L1 source documents and for cross-component consistency.",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/Requirements/SGAuthoring.Skills.ValidateDAKContent"
      }
    },
    {
      "@id": "Requirements-SGAuthoring.Skills.ValidateL3Functionality.jsonld",
      "@type": "fhir:Requirements",
      "dcterms:identifier": "Requirements/SGAuthoring.Skills.ValidateL3Functionality",
      "dcterms:title": "Can validate L3 functionality",
      "dcterms:description": "Capability to test StructureMap extraction, CQL execution, and measure calculation using reference tooling.",
      "dcterms:type": "Requirements: Formal Requirements",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/Requirements/SGAuthoring.Skills.ValidateL3Functionality"
      }
    },
    {
      "@id": "StructureDefinition-BusinessProcessWorkflow.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/BusinessProcessWorkflow",
      "dcterms:title": "Business Process Workflow (DAK)",
      "dcterms:description": "Logical Model for representing Generic Business Processes and Workflows from a DAK. A business process is a set of related activities or tasks performed together to achieve the objectives of the health programme area.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/BusinessProcessWorkflow"
      }
    },
    {
      "@id": "StructureDefinition-BusinessProcessWorkflowSource.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/BusinessProcessWorkflowSource",
      "dcterms:title": "Business Process Workflow Source",
      "dcterms:description": "Source reference for Business Process Workflow - exactly one of the following must be provided:\n- url (url data type): URL to retrieve BusinessProcessWorkflow definition from input/ or external source\n- canonical (canonical data type): Canonical URI pointing to the BusinessProcessWorkflow definition\n- instance: Inline BusinessProcessWorkflow instance data",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/BusinessProcessWorkflowSource"
      }
    },
    {
      "@id": "StructureDefinition-CoreDataElement.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/CoreDataElement",
      "dcterms:title": "Core Data Element (DAK)",
      "dcterms:description": "Logical Model for representing Core Data Elements from a DAK. A core data element can be one of: a ValueSet, a CodeSystem, a ConceptMap, or a Logical Model adherent to SGLogicalModel. This is the ONE EXCEPTION to allowing FHIR R4 models into the DAK LMs.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/CoreDataElement"
      }
    },
    {
      "@id": "StructureDefinition-CoreDataElementSource.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/CoreDataElementSource",
      "dcterms:title": "Core Data Element Source",
      "dcterms:description": "Source reference for Core Data Element - exactly one of the following must be provided:\n- url (url data type): URL to retrieve CoreDataElement definition from input/ or external source\n- canonical (canonical data type): Canonical URI pointing to the CoreDataElement definition\n- instance: Inline CoreDataElement instance data",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/CoreDataElementSource"
      }
    },
    {
      "@id": "StructureDefinition-DAK.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/DAK",
      "dcterms:title": "Digital Adaptation Kit (DAK)",
      "dcterms:description": "Logical Model for representing a complete Digital Adaptation Kit (DAK) with metadata and all 9 DAK components",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/DAK"
      }
    },
    {
      "@id": "StructureDefinition-DecisionSupportLogic.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/DecisionSupportLogic",
      "dcterms:title": "Decision-Support Logic (DAK)",
      "dcterms:description": "Logical Model for representing Decision-Support Logic from a DAK. Decision-support logic and algorithms to support appropriate service delivery in accordance with WHO clinical, public health and data use guidelines.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/DecisionSupportLogic"
      }
    },
    {
      "@id": "StructureDefinition-DecisionSupportLogicSource.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/DecisionSupportLogicSource",
      "dcterms:title": "Decision Support Logic Source",
      "dcterms:description": "Source reference for Decision Support Logic - exactly one of the following must be provided:\n- url (url data type): URL to retrieve DecisionSupportLogic definition from input/ or external source\n- canonical (canonical data type): Canonical URI pointing to the DecisionSupportLogic definition\n- instance: Inline DecisionSupportLogic instance data",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/DecisionSupportLogicSource"
      }
    },
    {
      "@id": "StructureDefinition-DublinCore.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/DublinCore",
      "dcterms:title": "Dublin Core Metadata Element Set",
      "dcterms:description": "Logical Model representing Dublin Core metadata elements as defined at https://www.dublincore.org/specifications/dublin-core/dcmi-terms/",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/DublinCore"
      }
    },
    {
      "@id": "StructureDefinition-FHIRSchemaBase.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/FHIRSchemaBase",
      "dcterms:title": "FHIR Schema Base (SMART Guidelines)",
      "dcterms:description": "Base logical model providing the common schema metadata interface inherited by all SMART Guidelines logical models. Every SMART Guidelines logical model schema derives from this base, which documents the shared FHIR and JSON-LD metadata properties used by the JSON Schema generation pipeline.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/FHIRSchemaBase"
      }
    },
    {
      "@id": "StructureDefinition-FunctionalRequirement.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/FunctionalRequirement",
      "dcterms:title": "Functional Requirement (DAK)",
      "dcterms:description": "Logical Model for representing functional requirement from a DAK",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/FunctionalRequirement"
      }
    },
    {
      "@id": "StructureDefinition-GenericPersona.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/GenericPersona",
      "dcterms:title": "Generic Persona (DAK)",
      "dcterms:description": "Logical Model for representing Generic Personas from a DAK. Depiction of the human and system actors. Human actors are end users, supervisors and related stakeholders who would be interacting with the digital system or involved in the clinical care, public health or health system pathway.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/GenericPersona"
      }
    },
    {
      "@id": "StructureDefinition-GenericPersonaSource.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/GenericPersonaSource",
      "dcterms:title": "Generic Persona Source",
      "dcterms:description": "Source reference for Generic Persona - exactly one of the following must be provided:\n- url (url data type): URL to retrieve GenericPersona definition from input/ or external source\n- canonical (canonical data type): Canonical URI pointing to the GenericPersona definition\n- instance: Inline GenericPersona instance data",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/GenericPersonaSource"
      }
    },
    {
      "@id": "StructureDefinition-HealthInterventions.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/HealthInterventions",
      "dcterms:title": "Health Interventions and Recommendations (DAK)",
      "dcterms:description": "Logical Model for representing Health Interventions and Recommendations from a DAK. Overview of the health interventions and WHO, regional or national recommendations included within the DAK.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/HealthInterventions"
      }
    },
    {
      "@id": "StructureDefinition-HealthInterventionsSource.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/HealthInterventionsSource",
      "dcterms:title": "Health Interventions Source",
      "dcterms:description": "Source reference for Health Interventions - exactly one of the following must be provided:\n- url (url data type): URL to retrieve HealthInterventions definition from input/ or external source\n- canonical (canonical data type): Canonical URI pointing to the HealthInterventions definition\n- instance: Inline HealthInterventions instance data",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/HealthInterventionsSource"
      }
    },
    {
      "@id": "StructureDefinition-KGCitation.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGCitation",
      "dcterms:title": "Knowledge graph L1: Citation",
      "dcterms:description": "One citation string exactly as written in a DAK artefact. A cell holding several citations yields several nodes. Content-addressed in the DAK's namespace, so one string is one node across artefacts. Where a citation was found is recorded by appearsIn (L2) and by each use edge (L2-DMN, L3 citesSource), not on the node. Class IRI: http://smart.who.int/kg/citation.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGCitation"
      }
    },
    {
      "@id": "StructureDefinition-KGEdge.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGEdge",
      "dcterms:title": "Knowledge graph: edge",
      "dcterms:description": "One reified statement: a predicate from a source node to a target node, with its derivation and evidence.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGEdge"
      }
    },
    {
      "@id": "StructureDefinition-KGEvidence.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGEvidence",
      "dcterms:title": "Knowledge graph L1: Evidence",
      "dcterms:description": "One row of an evidence profile: the evidence for one outcome of one key question, with its certainty (handbook §9.2). Class IRI: http://smart.who.int/kg/evidence.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGEvidence"
      }
    },
    {
      "@id": "StructureDefinition-KGEvidenceLocation.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGEvidenceLocation",
      "dcterms:title": "Knowledge graph: evidence location",
      "dcterms:description": "Where a node or edge came from in its source. Required on anything not mechanically derived.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGEvidenceLocation"
      }
    },
    {
      "@id": "StructureDefinition-KGGraphDocument.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGGraphDocument",
      "dcterms:title": "Knowledge graph L1: graph document",
      "dcterms:description": "One L1 knowledge-graph document: typed nodes and reified edges, provenance-pinned to the sources it was extracted from. In JSON the context element is written @context.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGGraphDocument"
      }
    },
    {
      "@id": "StructureDefinition-KGHealthIntervention.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGHealthIntervention",
      "dcterms:title": "Knowledge graph L1: Health intervention",
      "dcterms:description": "An intervention identified in a WHO catalogue or classification (UHC Compendium, ICHI, CDHI), digital interventions included. A peer of recommendation, not a recommendation. A DAK may draw on both. Corresponds to HealthInterventions: identifier and description correspond to HealthInterventions.id and description[x]; not a Parent because HealthInterventions requires reference 1..* DublinCore, which here is an edge (definedIn) rather than a field. Class IRI: http://smart.who.int/kg/health-intervention.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGHealthIntervention"
      }
    },
    {
      "@id": "StructureDefinition-KGImplementationPractice.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGImplementationPractice",
      "dcterms:title": "Knowledge graph L1-LIBRARY: Implementation practice",
      "dcterms:description": "A statement of how to put guidance into practice, printed in a publication whose publicationType is implementation-guidance or methodology: the handbook's \"products that are not guidelines\" (§1.9), a \"how to\" document that makes no recommendations of its own. Not a recommendation, and not a good practice statement — both are made by a guideline and approved by the GRC; this is neither. It carries no kind, direction, strength or certainty, because nothing graded it. A handbook's own \"Best practices\" lists are the typical source. Owner ruling 1b, 2026-10-12: model these as their own class, not as recommendation nodes of a new kind. statement is verbatim and is the only stored copy, as recommendation's is. identifier is used in the IRI. There is no remark: L1 3.0's remark is minted under a recommendation (its iriPattern) and hasRemark starts at one, so a remark of a practice needs L1 itself to change — proposed upstream, not patched here. Class IRI: http://smart.who.int/kg/implementation-practice.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGImplementationPractice"
      }
    },
    {
      "@id": "StructureDefinition-KGIndicator.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGIndicator",
      "dcterms:title": "Knowledge graph L1: Indicator",
      "dcterms:description": "A WHO indicator, identified by its published reference number. Printed in several places (HIV SI 2022: summary list, Table 2.3, reference sheet) and stored once. variants is a list of {population, definition, numerator, denominator} for population-specific or level-specific forms (PRV.17, PRV.3). Corresponds to ProgramIndicator: definition, numerator, denominator and disaggregation are ProgramIndicator's elements and types (markdown); not a Parent because ProgramIndicator makes them 1..1 and an L1 indicator is recorded with what its source prints. Class IRI: http://smart.who.int/kg/indicator.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGIndicator"
      }
    },
    {
      "@id": "StructureDefinition-KGKeyQuestion.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGKeyQuestion",
      "dcterms:title": "Knowledge graph L1: Key question",
      "dcterms:description": "A question in PICO format, framed before the evidence search (handbook §7.1–7.4). P and C are verbatim text with codes through crossReferences; I is also joined to a catalogued intervention; O is the outcome node. Class IRI: http://smart.who.int/kg/key-question.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGKeyQuestion"
      }
    },
    {
      "@id": "StructureDefinition-KGLibraryNode.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGLibraryNode",
      "dcterms:title": "Knowledge graph L1-LIBRARY: Library node",
      "dcterms:description": "A node in the ingested library L1 is read from: a source document, a section or a block, addressed by the library's own IRI. Opaque, as L1 asserts nothing about the library's internal model; the library is upstream, so pointing at it keeps the layering rule. Class IRI: http://smart.who.int/kg/library-node.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGLibraryNode"
      }
    },
    {
      "@id": "StructureDefinition-KGNode.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGNode",
      "dcterms:title": "Knowledge graph: node",
      "dcterms:description": "One typed node of a knowledge-graph document. Its instance fields are an instance of the logical model of its class (see definedBy), e.g. KGPublication for a publication.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGNode"
      }
    },
    {
      "@id": "StructureDefinition-KGOutcome.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGOutcome",
      "dcterms:title": "Knowledge graph L1: Outcome",
      "dcterms:description": "An outcome a guideline group chose to judge a key question by, with its importance in this guideline (handbook §7.6). A node because evidence attaches to it and one list is shared by several questions (ANC Web annex 1). Flat: one node per specific outcome. name as first printed; aliases are the other printed forms (e.g. 'EGWG'); category is the printed group heading (e.g. 'Fetal/newborn morbidity'). Class IRI: http://smart.who.int/kg/outcome.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGOutcome"
      }
    },
    {
      "@id": "StructureDefinition-KGProvenanceSource.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGProvenanceSource",
      "dcterms:title": "Knowledge graph: provenance source",
      "dcterms:description": "A source a graph document was extracted from, pinned by hash.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGProvenanceSource"
      }
    },
    {
      "@id": "StructureDefinition-KGPublication.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGPublication",
      "dcterms:title": "Knowledge graph L1: Publication",
      "dcterms:description": "A WHO publication: a guideline of any of the handbook's types, a position paper, a summary table, a classification, implementation guidance, or a supplement. Metadata follows Dublin Core. identifiers is a list of {type, value}; type is from identifier-type, and the first of isbn, iris-handle, doi, issn, url builds the IRI, so an edition change is a new publication. issued and modified are Dublin Core. reviewBy is the handbook's review-by date (§12.5.1). sha256 pins the PDF. Derives from DublinCore (smart-base input/fsh/models/DublinCore.fsh); title, creator, publisher, language, rights are its elements. Class IRI: http://smart.who.int/kg/publication.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGPublication"
      }
    },
    {
      "@id": "StructureDefinition-KGPublicationElement.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGPublicationElement",
      "dcterms:title": "Knowledge graph L1: Publication element",
      "dcterms:description": "One printed block: a table, a table row, a footnote, a figure, a chart, an image, a flowchart, a box or a list. It records where something is printed and exactly what is printed that no content node holds. It carries no meaning of its own; meaning lives in content nodes, joined by presentedIn. columns is the header text, verbatim. columnMap names, per column, the content field that fills it when the table is re-rendered (e.g. 'Recommendation' -> statement). cells holds only text no content node holds; a cell filled through columnMap is null. text is for unmodelled printed text such as a footnote that is not a remark. sha256 is for images. Class IRI: http://smart.who.int/kg/publication-element.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGPublicationElement"
      }
    },
    {
      "@id": "StructureDefinition-KGPublicationSection.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGPublicationSection",
      "dcterms:title": "Knowledge graph L1: Publication section",
      "dcterms:description": "A chapter, annex or numbered section, at any depth. Class IRI: http://smart.who.int/kg/publication-section.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGPublicationSection"
      }
    },
    {
      "@id": "StructureDefinition-KGRecommendation.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGRecommendation",
      "dcterms:title": "Knowledge graph L1: Recommendation",
      "dcterms:description": "A normative statement from a WHO guideline. Kinds other than a graded recommendation (context-specific, research-only, good practice statement, no-recommendation) are the same node with a different kind. statement is verbatim and is the only stored copy. intervention, population, setting, provider and timing are verbatim slots taken from the statement, its remarks, or the enclosing caption or heading. setting absorbs the former conditionality. identifier is the published number (e.g. A.1.1), used in the IRI; sub-recommendations append their letter. Class IRI: http://smart.who.int/kg/recommendation.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGRecommendation"
      }
    },
    {
      "@id": "StructureDefinition-KGReferenceEntry.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGReferenceEntry",
      "dcterms:title": "Knowledge graph L1: Reference entry",
      "dcterms:description": "One row of a DAK artefact's own reference list: '(1)' and the full bibliographic text and URL it stands for. Resolved once; every citation numbered to it shares the result. Class IRI: http://smart.who.int/kg/reference-entry.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGReferenceEntry"
      }
    },
    {
      "@id": "StructureDefinition-KGRemark.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGRemark",
      "dcterms:title": "Knowledge graph L1: Remark",
      "dcterms:description": "A remark attached to a recommendation (handbook §10.6). May also be printed as a table footnote. Class IRI: http://smart.who.int/kg/remark.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGRemark"
      }
    },
    {
      "@id": "StructureDefinition-KGTerminologyCode.jsonld",
      "@type": "fhir:StructureDefinition",
      "dcterms:identifier": "StructureDefinition/KGTerminologyCode",
      "dcterms:title": "Knowledge graph L1: Terminology code",
      "dcterms:description": "A code in an external terminology — ICD-10, ICD-11, SNOMED CT, ATC, or a WHO classification such as CDHI. CROSS-REFERENCE ONLY. It records system, code and display, and asserts NOTHING about the terminology: no hierarchy, no subsumption, no synonyms, no post-coordination. The terminology has its own authority, its own release cycle and its own tooling, and a partial copy here would be wrong within one release. Resolve meaning against the terminology server, not against this graph. Derives from Coding (FHIR R4 core datatype); system, code, display, version are its elements. Class IRI: http://smart.who.int/kg/terminology-code.",
      "dcterms:type": "Structures: Logical Models",
      "schema:sameAs": {
        "@id": "http://smart.who.int/base/StructureDefinition/KGTerminologyCode"
      }
    },
    {
