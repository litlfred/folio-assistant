      "@type": "fhir:ValueSet",
      "dcterms:identifier": "ValueSet/CDHIv1",
      "dcterms:title": "Classification of Digital Health Interventions v1",
      "dcterms:description": "Value Set for Classification of Digital Health Interventions v1. Autogenerated from DAK artifacts",
