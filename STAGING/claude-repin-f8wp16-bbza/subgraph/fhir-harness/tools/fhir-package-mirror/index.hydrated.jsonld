      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/fhir-package-mirror.jsonld",
      "@type": "cat-harness:Tool",
      "description": "On a machine that reaches packages.fhir.org, fetch exactly a missing list (from `fhir-cache-seed-npm --missing-out`), check each tarball names itself exactly, record SHA512SUMS, and commit and push to a git repository that an environment without packages.fhir.org reads with `--mirror`. The person running it is the trust anchor for what it adds.",
      "install": {
        "cli": "git clone -b claude/ast-export https://github.com/litlfred/fhir-ig-publisher"
      },
      "invoke": {
        "shell": "fhir-ig-publisher/ast-export/scripts/mirror-fhir-packages.sh <mirror-repo-dir> <missing.txt | name#version ...>"
      },
      "io": {
        "inputs": [
          {
            "description": "A git checkout to fill; committed and pushed when it is one.",
            "name": "mirror-repo-dir",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "description": "The seeder's `--missing-out` file, so nothing unneeded is mirrored.",
            "name": "missing",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          }
        ],
        "outputs": [
          {
            "description": "Exit non-zero when any could not be fetched or named itself differently.",
            "name": "mirrored",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "fhir-package-mirror",
      "requirements": {
        "network": true,
        "runtime": [
          "bash",
          "curl",
          "python3",
          "git"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/fhir-harness/skill/ig-publisher-fork",
      "title": "Mirror FHIR packages from packages.fhir.org into a git repository"
    }
  ],
