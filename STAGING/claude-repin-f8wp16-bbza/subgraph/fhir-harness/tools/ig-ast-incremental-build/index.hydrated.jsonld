  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/ig-ast-incremental-build.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Write the unchanged part of a base AST as a FHIR package into the package cache, build a temporary IG of only the rebuild set with the stock Publisher, merge the result into a mixed-provenance AST (`builtAt` per resource), and repeat while the merged graph's cone reaches resources that were not rebuilt.",
      "install": {
        "cli": "git clone -b claude/ast-export https://github.com/litlfred/fhir-ig-publisher && cd fhir-ig-publisher/ast-export && mvn -q package && mvn -q dependency:build-classpath -Dmdep.outputFile=cp.txt"
      },
      "invoke": {
        "shell": "java -cp \"target/classes:$(cat cp.txt)\" org.hl7.fhir.igtools.ast.IncrementalBuildCli -ast <base> -ig <ig> -out <dir> [-cache-folder <dir>] [-fsh-users <json>]"
      },
      "io": {
        "inputs": [
          {
            "name": "ast",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "name": "ig",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "name": "out",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "description": "Keeps the `*.ast-cache` packages out of `~/.fhir/packages`.",
            "name": "cache-folder",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "description": "`fsh-file-users/v1` from `fsh-cone --file-users`, so a changed RuleSet- or Alias-only file reaches its users instead of forcing a full build.",
            "name": "fsh-users",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          }
        ],
        "outputs": [
          {
            "description": "Rounds to a fixed point; exit 3 when it does not converge, which means run a full build.",
            "name": "rounds",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "ig-ast-incremental-build",
      "requirements": {
        "network": true,
        "runtime": [
          "java",
          "sushi"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/fhir-harness/skill/ig-publisher-fork",
      "title": "Rebuild only the cone of a change and merge it into the AST"
    }
  ],
