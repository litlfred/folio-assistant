            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
          },
          {
            "arg": {
              "flag": "--ref"
            },
            "description": "Branch or sha for block links.",
            "name": "ref",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          },
          {
            "arg": {
              "flag": "--content-prefix"
            },
            "description": "Path of the content root inside the repo, for block links.",
            "name": "contentPrefix",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--base"
            },
            "description": "Published `data/` of the base graph; enables the STAGING overlay.",
            "name": "base",
