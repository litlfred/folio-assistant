      "@id": "https://litlfred.github.io/folio-assistant/subgraph/folio-assistant-sci/tools/tex-snippet-validate/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/tex-snippet-validate.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Parse every `tex` snippet in a folio's blocks and report what will not compile — structural, not textual: it reads an AST rather than matching patterns. Complementary to `latex-preflight`, which gates a main.tex before a compile, and to `latex-overfull`, which reads a log after one.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat latex:validate"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--paper"
                },
                "description": "One folio by slug. Absent, every folio the content root holds.",
                "name": "paper",
