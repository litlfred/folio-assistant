    },
    "device-product": {
      "en": "Device product"
    },
    "behavioural": {
      "en": "Behavioural"
    },
    "public-health": {
      "en": "Public health"
    },
    "health-system": {
      "en": "Health system"
    },
    "health-information": {
      "en": "Health information"
    },
    "digital": {
      "en": "Digital"
    }
  },
  "fhir:valueSet": "http://smart.who.int/base/ValueSet/KGInterventionTypeVS",
  "fhir:version": "0.3.0",
