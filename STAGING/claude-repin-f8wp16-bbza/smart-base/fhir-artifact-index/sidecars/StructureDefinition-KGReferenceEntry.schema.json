{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/base/StructureDefinition-KGReferenceEntry.schema.json",
  "title": "Knowledge graph L1: Reference entry",
  "description": "One row of a DAK artefact's own reference list: '(1)' and the full bibliographic text and URL it stands for. Resolved once; every citation numbered to it shares the result. Class IRI: http://smart.who.int/kg/reference-entry.",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string",
      "const": "KGReferenceEntry",
      "description": "Resource type identifier for KGReferenceEntry logical model"
    },
    "@context": {
      "description": "JSON-LD context for this logical model with ValueSet vocabularies",
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "description": "URI reference to external JSON-LD context"
        },
        {
          "type": "object",
          "description": "Inline JSON-LD context",
          "properties": {
            "@version": {
              "type": "number",
              "const": 1.1
            },
            "fhir": {
              "type": "string",
              "const": "http://hl7.org/fhir/"
            }
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        {
          "type": "array",
          "description": "Array of JSON-LD context objects/URIs",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      ]
    },
    "@type": {
      "type": "string",
      "description": "JSON-LD type identifier for KGReferenceEntry logical model",
      "examples": [
        "LogicalModel-KGReferenceEntry"
      ]
    },
    "number": {
      "type": "string",
      "description": "The entry's number in the reference list."
    },
    "text": {
      "type": "string",
      "description": "The full bibliographic text, verbatim."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "The URL the entry prints."
    },
    "resolutionStatus": {
      "$ref": "./ValueSet-KGResolutionStatusVS.schema.json",
      "description": "Whether a citation string has been matched to what it cites."
    }
  },
  "required": [
    "resourceType"
  ],
  "allOf": [
    {
      "$ref": "./StructureDefinition-FHIRSchemaBase.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "resourceDefinition": {
          "type": "string",
          "format": "uri",
          "const": "http://smart.who.int/base/StructureDefinition/KGReferenceEntry"
        },
        "fhir:parent": {
          "type": "string",
          "const": "http://hl7.org/fhir/StructureDefinition/Base"
        },
        "jsonld:valuesets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "const": [
            "KGResolutionStatusVS"
          ]
        },
        "jsonld:contextTemplate": {
          "type": "object",
          "const": {
            "@version": 1.1,
            "fhir": "http://hl7.org/fhir/",
            "KGResolutionStatusVS": "http://smart.who.int/base/ValueSet-KGResolutionStatusVS.jsonld"
          }
        }
      }
    }
  ]
}