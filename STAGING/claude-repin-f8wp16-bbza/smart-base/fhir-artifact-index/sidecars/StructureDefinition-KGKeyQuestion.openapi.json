{
  "openapi": "3.1.0",
  "info": {
    "title": "Knowledge graph L1: Key question API",
    "description": "A question in PICO format, framed before the evidence search (handbook §7.1–7.4). P and C are verbatim text with codes through crossReferences; I is also joined to a catalogued intervention; O is the outcome node. Class IRI: http://smart.who.int/kg/key-question.",
    "version": "1.0.0"
  },
  "paths": {
    "/StructureDefinition-KGKeyQuestion.schema.json": {
      "get": {
        "summary": "JSON Schema definition for the Logical Model StructureDefinition-KGKeyQuestion",
        "description": "This endpoint serves the JSON Schema definition for the Logical Model StructureDefinition-KGKeyQuestion.",
        "responses": {
          "200": {
            "description": "The JSON Schema for StructureDefinition-KGKeyQuestion",
            "content": {
              "application/schema+json": {
                "schema": {
                  "$ref": "./StructureDefinition-KGKeyQuestion.schema.json"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StructureDefinition-KGKeyQuestion": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "http://smart.who.int/base/StructureDefinition-KGKeyQuestion.schema.json",
        "title": "Knowledge graph L1: Key question",
        "description": "A question in PICO format, framed before the evidence search (handbook §7.1–7.4). P and C are verbatim text with codes through crossReferences; I is also joined to a catalogued intervention; O is the outcome node. Class IRI: http://smart.who.int/kg/key-question.",
        "type": "object",
        "properties": {
          "resourceType": {
            "type": "string",
            "const": "KGKeyQuestion",
            "description": "Resource type identifier for KGKeyQuestion logical model"
          },
          "identifier": {
            "type": "string",
            "description": "The question's published number."
          },
          "text": {
            "type": "string",
            "description": "The question, verbatim."
          },
          "population": {
            "type": "string",
            "description": "P, verbatim."
          },
          "intervention": {
            "type": "string",
            "description": "I, verbatim."
          },
          "comparator": {
            "type": "string",
            "description": "C, verbatim."
          },
          "setting": {
            "type": "string",
            "description": "Setting, verbatim."
          },
          "contentHash": {
            "type": "string",
            "description": "sha256 of the normalised text."
          }
        },
        "required": [
          "resourceType"
        ],
        "allOf": [
          {
            "$ref": "./StructureDefinition-FHIRSchemaBase.schema.json"
          },
          {
            "type": "object",
            "properties": {
              "resourceDefinition": {
                "type": "string",
                "format": "uri",
                "const": "http://smart.who.int/base/StructureDefinition/KGKeyQuestion"
              },
              "fhir:parent": {
                "type": "string",
                "const": "http://hl7.org/fhir/StructureDefinition/Base"
              }
            }
          }
        ]
      }
    }
  }
}