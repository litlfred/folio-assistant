    {
      "@id": "references/9789241548960-eng",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "WHO handbook for guideline development",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2014-12-18",
      "dcterms:publisher": "World Health Organization",
