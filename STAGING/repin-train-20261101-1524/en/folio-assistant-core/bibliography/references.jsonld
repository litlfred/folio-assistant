    {
      "@id": "references/arxiv-2601.22554v1.r12",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Olympiad-Level Formal Mathematical Reasoning with Reinforcement Learning",
      "dcterms:creator": [
        "Hubert, Thomas",
        "Mehta, Rishi",
        "Sartran, Laurent",
        "Horváth, Miklós Z.",
        "Žužić, Goran",
        "Wieser, Eric",
        "Huang, Aja",
        "Schrittwieser, Julian",
        "Schroecker, Yannick",
        "Masoom, Hussain"
      ],
      "dcterms:issued": "2025",
      "bibo:doi": "10.1038/s41586-025-09833-y",
      "dcterms:identifier": "https://doi.org/10.1038/s41586-025-09833-y",
      "dcterms:source": "folio-assistant-sci/library/arxiv-2601.22554v1/sections/sec-012-limitations.md"
