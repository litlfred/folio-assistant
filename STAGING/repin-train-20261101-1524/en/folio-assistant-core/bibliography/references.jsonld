    },
    {
      "@id": "references/9789240031593-eng",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "Consolidated guidelines on HIV prevention, testing, treatment, service delivery and monitoring: recommendations for a public health approach",
      "dcterms:creator": [
        "World Health Organization"
      ],
      "dcterms:issued": "2021-07-16",
      "dcterms:publisher": "World Health Organization",
      "bibo:isbn": "9789240031593 (electronic version)",
      "dcterms:identifier": "https://iris.who.int/handle/10665/342899",
      "dcterms:language": "en",
      "dcterms:abstract": "These consolidated guidelines provide comprehensive, evidence-based recommendations for HIV prevention, testing, treatment, service delivery and programme monitoring across the continuum of HIV care. Updating the 2016 WHO consolidated guidelines, this edition integrates guidance issued between 2016 and 2021 and reflects major advances in clinical practice, diagnostics and service delivery. Developed using the GRADE approach and informed by expert consultation and country experience, the guidelines aim to support countries in implementing high-quality, person-centred HIV services while advancing universal health coverage and progress towards ending AIDS as a public health threat by 2030.\n\nThe publication addresses HIV testing strategies, prevention interventions, antiretroviral therapy, management of advanced HIV disease, care for common coinfections and comorbidities, differentiated service delivery, procurement, laboratory services and programme monitoring. It incorporates updated recommendations on HIV self-testing, pre-exposure and post-exposure prophylaxis, dolutegravir-based treatment, rapid antiretroviral therapy initiation, viral load monitoring and community-based models of care. Intended primarily for national HIV programme managers, policy-makers and health-care providers, the guidelines also serve as a resource for technical partners, community organizations and people living with HIV to support the implementation of effective, equitable and people-centred HIV programmes.",
      "dcterms:source": "who-iris/catalogue/records/9789240031593-eng.dc.json"
    },
    {
      "@id": "references/WHO-2019-nCoV-Digital-certificates-vaccination-2021.1-eng",
