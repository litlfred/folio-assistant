      "dcterms:title": "A Blueprint for the Formalization of Carleson’s Theorem on Convergence of Fourier Series",
      "dcterms:creator": [
        "Becker, Lars",
        "de Frutos-Fernández, María Inés",
        "Diedering, Leo",
        "van Doorn, Floris",
