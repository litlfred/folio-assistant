  "$ref": "#/definitions/NQuadsPartition",
  "definitions": {
    "NQuadsPartition": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Partition identifier, e.g. 'spine' or community/subgraph id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable title for the partition"
        },
        "graphIri": {
          "type": "string",
          "format": "uri",
          "description": "Target named graph IRI serialized in the N-Quads"
        },
        "fileNq": {
          "type": "string",
          "format": "ends_with",
          "pattern": ".*\\.nq$",
          "description": "Relative filename of uncompressed W3C N-Quads"
        },
        "fileGz": {
          "type": "string",
          "format": "ends_with",
          "pattern": ".*\\.nq\\.gz$",
          "description": "Relative filename of gzipped W3C N-Quads"
        },
        "mediaType": {
          "default": "application/n-quads",
          "type": "string",
          "const": "application/n-quads"
        },
        "compressFormat": {
          "default": "application/gzip",
          "type": "string",
          "const": "application/gzip"
        },
        "quadCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "itemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byteSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "name",
        "graphIri",
        "fileNq",
        "fileGz",
        "quadCount",
        "itemCount"
      ]
    }
  },
