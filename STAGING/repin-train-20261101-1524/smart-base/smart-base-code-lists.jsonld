  "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld",
  "title": "Code lists",
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty",
      "@type": "skos:ConceptScheme",
      "notation": "grade-certainty",
      "prefLabel": "GRADE certainty of evidence",
      "definition": "The four levels of certainty GRADE assigns to a BODY of evidence for one outcome — never to a single citation. Randomised trials start at high and observational studies at low, before rating down or up. Moved from smart-kg/methodologies/grade.md by bean wg7r, 2026-09-24 (owner: 'needs to be part of skill/SKOS'). Read with the `grade` skill.",
      "source": {
        "@id": "https://doi.org/10.1016/j.jclinepi.2010.07.015"
      },
      "changeNote": "Balshem H, et al. GRADE guidelines: 3. Rating the quality of evidence. J Clin Epidemiol 2011;64(4):401-406"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty/high",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty",
      "notation": "high",
      "prefLabel": "High",
      "definition": "We are very confident that the true effect lies close to the estimate of the effect."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty/moderate",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty",
      "notation": "moderate",
      "prefLabel": "Moderate",
      "definition": "We are moderately confident in the effect estimate: the true effect is likely to be close to it, but there is a possibility that it is substantially different."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty/low",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty",
      "notation": "low",
      "prefLabel": "Low",
      "definition": "Our confidence in the effect estimate is limited: the true effect may be substantially different from it."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty/very-low",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-certainty",
      "notation": "very-low",
      "prefLabel": "Very low",
      "definition": "We have very little confidence in the effect estimate: the true effect is likely to be substantially different from it. Not the same finding as 'could not determine' — absent evidence is a gap, not a grade."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "@type": "skos:ConceptScheme",
      "notation": "grade-etd-criterion",
      "prefLabel": "GRADE Evidence-to-Decision criteria",
      "definition": "The criteria an Evidence-to-Decision framework judges, EACH EXPLICITLY, before a recommendation. They are judged and argued, never summed into a score. These are the criteria of the framework for clinical and public-health recommendations. Moved from smart-kg/methodologies/grade.md by bean wg7r, 2026-09-24 (owner: 'needs to be part of skill/SKOS'). Read with the `grade` skill.",
      "source": {
        "@id": "https://doi.org/10.1136/bmj.i2016"
      },
      "changeNote": "Alonso-Coello P, et al. GRADE Evidence to Decision (EtD) frameworks: a systematic and transparent approach to making well informed healthcare choices. 1: Introduction. BMJ 2016;353:i2016"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/problem-priority",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "problem-priority",
      "prefLabel": "Priority of the problem",
      "definition": "Whether the problem the recommendation addresses is a priority."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/desirable-effects",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "desirable-effects",
      "prefLabel": "Desirable effects",
      "definition": "How substantial the desirable anticipated effects of the option are."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/undesirable-effects",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "undesirable-effects",
      "prefLabel": "Undesirable effects",
      "definition": "How substantial the undesirable anticipated effects of the option are."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/certainty-of-evidence",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "certainty-of-evidence",
      "prefLabel": "Certainty of evidence",
      "definition": "The overall certainty of the evidence of effects, rated per the grade-certainty list."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/values",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "values",
      "prefLabel": "Values",
      "definition": "Whether there is important uncertainty about, or variability in, how much the people affected value the main outcomes."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/balance-of-effects",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "balance-of-effects",
      "prefLabel": "Balance of effects",
      "definition": "Whether the balance between desirable and undesirable effects favours the option or the comparison."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/resources-required",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "resources-required",
      "prefLabel": "Resources required",
      "definition": "How large the resource requirements, or costs, of the option are."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/resource-evidence-certainty",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "resource-evidence-certainty",
      "prefLabel": "Certainty of evidence of required resources",
      "definition": "The certainty of the evidence about the resources the option requires."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/cost-effectiveness",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "cost-effectiveness",
      "prefLabel": "Cost-effectiveness",
      "definition": "Whether the cost-effectiveness of the option favours the option or the comparison."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/equity",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "equity",
      "prefLabel": "Equity",
      "definition": "What the impact of the option on health equity would be."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/acceptability",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "acceptability",
      "prefLabel": "Acceptability",
      "definition": "Whether the option is acceptable to key stakeholders."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion/feasibility",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-etd-criterion",
      "notation": "feasibility",
      "prefLabel": "Feasibility",
      "definition": "Whether the option is feasible to implement."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down",
      "@type": "skos:ConceptScheme",
      "notation": "grade-rating-down",
      "prefLabel": "GRADE reasons to rate certainty down",
      "definition": "The five domains for which GRADE lowers the certainty of a body of evidence. Each rating-down is recorded with the code that caused it, so the grade can be re-examined. Moved from smart-kg/methodologies/grade.md by bean wg7r, 2026-09-24 (owner: 'needs to be part of skill/SKOS'). Read with the `grade` skill.",
      "source": {
        "@id": "https://gdt.gradepro.org/app/handbook/handbook.html"
      },
      "changeNote": "GRADE Handbook (Schünemann H, Brożek J, Guyatt G, Oxman A, eds.), section 5.2: factors that can reduce the certainty of evidence; GRADE guidelines 4-8, J Clin Epidemiol 2011"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down/risk-of-bias",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down",
      "notation": "risk-of-bias",
      "prefLabel": "Risk of bias",
      "definition": "Limitations in the design or execution of the included studies — such as lack of allocation concealment, lack of blinding, or loss to follow-up — that make the estimate likely to be biased."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down/inconsistency",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down",
      "notation": "inconsistency",
      "prefLabel": "Inconsistency",
      "definition": "Unexplained heterogeneity: the studies' effect estimates differ widely, their confidence intervals overlap little, or statistical tests show heterogeneity that the analysis cannot explain."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down/indirectness",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down",
      "notation": "indirectness",
      "prefLabel": "Indirectness",
      "definition": "The evidence does not answer the question directly: the population, intervention, comparator or outcome studied differs from the one the recommendation is about, or interventions were compared only indirectly."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down/imprecision",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down",
      "notation": "imprecision",
      "prefLabel": "Imprecision",
      "definition": "The estimate is uncertain because the studies are small or events few, so the confidence interval includes effects that would lead to different decisions."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down/publication-bias",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-down",
      "notation": "publication-bias",
      "prefLabel": "Publication bias",
      "definition": "Studies are likely missing from the body of evidence because publication depended on the direction or size of their results."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-up",
      "@type": "skos:ConceptScheme",
      "notation": "grade-rating-up",
      "prefLabel": "GRADE reasons to rate certainty up",
      "definition": "The three domains for which GRADE may raise the certainty of a body of evidence — applied mainly to observational studies with no reason to rate down. Moved from smart-kg/methodologies/grade.md by bean wg7r, 2026-09-24 (owner: 'needs to be part of skill/SKOS'). Read with the `grade` skill.",
      "source": {
        "@id": "https://doi.org/10.1016/j.jclinepi.2011.06.004"
      },
      "changeNote": "Guyatt GH, et al. GRADE guidelines: 9. Rating up the quality of evidence. J Clin Epidemiol 2011;64(12):1311-1316"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-up/large-effect",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-up",
      "notation": "large-effect",
      "prefLabel": "Large magnitude of effect",
      "definition": "The effect is so large that bias alone is unlikely to explain it."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-up/dose-response",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-up",
      "notation": "dose-response",
      "prefLabel": "Dose-response gradient",
      "definition": "The effect increases or decreases consistently with the level of exposure, which strengthens the inference that the relationship is causal."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-up/plausible-confounding",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-rating-up",
      "notation": "plausible-confounding",
      "prefLabel": "Plausible confounding would reduce the effect",
      "definition": "All plausible residual confounding or bias would reduce a demonstrated effect — or would suggest a spurious effect where none was observed — so the true effect is likely at least as large as estimated."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-direction",
      "@type": "skos:ConceptScheme",
      "notation": "grade-recommendation-direction",
      "prefLabel": "GRADE recommendation direction",
      "definition": "Which way a recommendation points. Always recorded together with its strength: one without the other is not a GRADE recommendation. Moved from smart-kg/methodologies/grade.md by bean wg7r, 2026-09-24 (owner: 'needs to be part of skill/SKOS'). Read with the `grade` skill.",
      "source": {
        "@id": "https://doi.org/10.1016/j.jclinepi.2013.02.003"
      },
      "changeNote": "Andrews JC, et al. GRADE guidelines: 15. Going from evidence to recommendation — determinants of a recommendation's direction and strength. J Clin Epidemiol 2013;66(7):726-735; WHO Handbook for Guideline Development, 2nd ed. (2014), which uses 'conditional' for GRADE's 'weak'"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-direction/for",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-direction",
      "notation": "for",
      "prefLabel": "For the option",
      "definition": "The recommendation is to use the option."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-direction/against",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-direction",
      "notation": "against",
      "prefLabel": "Against the option",
      "definition": "The recommendation is not to use the option."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-strength",
      "@type": "skos:ConceptScheme",
      "notation": "grade-recommendation-strength",
      "prefLabel": "GRADE recommendation strength",
      "definition": "How strongly a recommendation is made. Strength is NOT certainty: a strong recommendation can rest on low-certainty evidence and a conditional one on high certainty. Moved from smart-kg/methodologies/grade.md by bean wg7r, 2026-09-24 (owner: 'needs to be part of skill/SKOS'). Read with the `grade` skill.",
      "source": {
        "@id": "https://doi.org/10.1016/j.jclinepi.2013.02.003"
      },
      "changeNote": "Andrews JC, et al. GRADE guidelines: 15. Going from evidence to recommendation — determinants of a recommendation's direction and strength. J Clin Epidemiol 2013;66(7):726-735; WHO Handbook for Guideline Development, 2nd ed. (2014), which uses 'conditional' for GRADE's 'weak'"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-strength/strong",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-strength",
      "notation": "strong",
      "prefLabel": "Strong",
      "definition": "The guideline panel is confident that the desirable effects of following the recommendation clearly outweigh the undesirable effects — or clearly do not, for a recommendation against — so most informed people would choose the recommended course."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-strength/conditional",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#grade-recommendation-strength",
      "notation": "conditional",
      "prefLabel": "Conditional",
      "definition": "The desirable effects probably outweigh the undesirable effects, but the panel is less confident: the balance is close, the evidence uncertain, or values and preferences vary, so different choices will suit different people or settings. GRADE's 'weak'; WHO uses 'conditional'."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "@type": "skos:ConceptScheme",
      "notation": "sgkg-l1-classes",
      "prefLabel": "SMART Guidelines KG L1 classes",
      "definition": "The classes an L1 knowledge-graph node can be: a WHO publication, its sections, recommendations and the evidence they rest on. smart-base document kinds and the L1 extraction name these as `sgkg-l1#<code>`. Taken on 2026-10-23 from litlfred/smart-kg at 66a9b1393fd7, which had been pinned since 2026-10-02 (bean pebe). smart-kg is deprecated (owner, 2026-10-16), so smart-base owns this list now: edit it here, not upstream.",
      "source": {
        "@id": "https://github.com/litlfred/smart-kg/blob/66a9b1393fd7f315eb4eb0dab001db5e3eb0c5ef/ontology/l1/l1.json"
      },
      "changeNote": "litlfred/smart-kg ontology/l1/l1.json at 66a9b1393fd7, the `classes` array: id, name, note and iri."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/publication",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "publication",
      "prefLabel": "Publication",
      "definition": "A WHO normative publication: a guideline, guidance, recommendation summary, or classification. Metadata follows Dublin Core, which HealthInterventions already uses.",
      "rdf:value": "http://smart.who.int/kg/publication"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/publication-section",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "publication-section",
      "prefLabel": "Publication section",
      "definition": "A chapter, annex or numbered section. Recommendations are located by section and page, which is what makes an extraction checkable.",
      "rdf:value": "http://smart.who.int/kg/publication-section"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/recommendation",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "recommendation",
      "prefLabel": "Recommendation",
      "definition": "The atomic normative statement. This is the node nothing in the WHO estate currently makes addressable.",
      "rdf:value": "http://smart.who.int/kg/recommendation"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/remark",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "remark",
      "prefLabel": "Remark",
      "definition": "An implementation consideration attached to a recommendation. Grounded: the BCG table's first annotationEntry carries exactly this — \"Neonates born to women of unknown HIV status should be vaccinated as the benefits…\" — clinical nuance that shapes the decision logic but is not the recommendation itself.",
      "rdf:value": "http://smart.who.int/kg/remark"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/evidence",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "evidence",
      "prefLabel": "Evidence",
      "definition": "The body of evidence behind a recommendation, with its GRADE certainty rating.",
      "rdf:value": "http://smart.who.int/kg/evidence"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/population",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "population",
      "prefLabel": "Population",
      "definition": "PICO P (population).",
      "rdf:value": "http://smart.who.int/kg/population"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/intervention",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "intervention",
      "prefLabel": "Intervention",
      "definition": "PICO I. The clinical or public-health action, distinct from health-intervention, which is the DAK-facing component.",
      "rdf:value": "http://smart.who.int/kg/intervention"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/comparator",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "comparator",
      "prefLabel": "Comparator",
      "definition": "PICO C. Frequently absent in WHO recommendations; absence is recorded rather than invented.",
      "rdf:value": "http://smart.who.int/kg/comparator"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/outcome",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "outcome",
      "prefLabel": "Outcome",
      "definition": "PICO O (outcome).",
      "rdf:value": "http://smart.who.int/kg/outcome"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/health-intervention",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "health-intervention",
      "prefLabel": "Health intervention",
      "definition": "What a recommendation is about, and the hinge to L2. Corresponds to the DAK component smart-base defines as HealthInterventions — today `id`, `description[x]` and `reference 1..* DublinCore`, i.e. a bibliographic citation with no recommendation behind it. This class is what that citation should resolve to.",
      "rdf:value": "http://smart.who.int/kg/health-intervention"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/schedule",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "schedule",
      "prefLabel": "Schedule",
      "definition": "A normative delivery schedule. Grounded: the BCG table cites \"WHO recommendations for routine immunization – summary tables\", which IS a schedule publication — the single most-cited L1 source in the immunization DAK.",
      "rdf:value": "http://smart.who.int/kg/schedule"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/schedule-entry",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "schedule-entry",
      "prefLabel": "Schedule entry",
      "definition": "One row of a schedule: which intervention, for whom, when, how many doses. This is the granularity a decision table actually consumes — the BCG rules turn on dose count, age and interval since a live vaccine.",
      "rdf:value": "http://smart.who.int/kg/schedule-entry"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/indicator",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "indicator",
      "prefLabel": "Indicator",
      "definition": "A programme indicator defined normatively at L1. Distinct from the DAK's ProgramIndicator component, which is its L2 expression; that model already carries `references 0..* id` pointing at health intervention ids.",
      "rdf:value": "http://smart.who.int/kg/indicator"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/terminology-code",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "terminology-code",
      "prefLabel": "Terminology code",
      "definition": "A code in an external terminology — ICD-10, ICD-11, SNOMED CT, ATC, or a WHO classification such as CDHI. CROSS-REFERENCE ONLY. It records system, code and display, and asserts NOTHING about the terminology: no hierarchy, no subsumption, no synonyms, no post-coordination. The terminology has its own authority, its own release cycle and its own tooling, and a partial copy here would be wrong within one release. Resolve meaning against the terminology server, not against this graph.",
      "rdf:value": "http://smart.who.int/kg/terminology-code"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/citation",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "citation",
      "prefLabel": "Citation",
      "definition": "A citation string exactly as it appears in an L2 or L3 artefact, together with what it was resolved to. Grounded directly in the BCG table, where every rule's annotationEntry[1] reads \"WHO recommendations for routine immunization – summary tables (March 2023) (1)\" — a citation that no tool can currently follow. This class is where that string becomes a link, and where the fact that resolving it was a judgement gets recorded.",
      "rdf:value": "http://smart.who.int/kg/citation"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes/external-artifact",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l1-classes",
      "notation": "external-artifact",
      "prefLabel": "External artefact",
      "definition": "An L2 or L3 artefact addressed by canonical URL — a BPMN process, a DMN decision table, a FHIR PlanDefinition. Deliberately opaque: it carries an IRI and a free-text kind, and this graph asserts nothing about its internal structure. That opacity is the boundary. The L2 and L3 subgraphs model those artefacts properly; L1 only needs to point.",
      "rdf:value": "http://smart.who.int/kg/external-artifact"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "@type": "skos:ConceptScheme",
      "notation": "sgkg-l2-classes",
      "prefLabel": "SMART Guidelines KG L2 classes",
      "definition": "The classes an L2 (DAK) knowledge-graph node can be: the kit, its personas, scenarios, processes, decisions, indicators and requirements. smart-base document kinds and the recommendation scenarios name these as `sgkg-l2#<code>`. Taken on 2026-10-23 from litlfred/smart-kg at 66a9b1393fd7, which had been pinned since 2026-10-02 (bean pebe). smart-kg is deprecated (owner, 2026-10-16), so smart-base owns this list now: edit it here, not upstream.",
      "source": {
        "@id": "https://github.com/litlfred/smart-kg/blob/66a9b1393fd7f315eb4eb0dab001db5e3eb0c5ef/ontology/l2/l2.json"
      },
      "changeNote": "litlfred/smart-kg ontology/l2/l2.json at 66a9b1393fd7, the `classes` array: id, name, note and iri."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/dak",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "dak",
      "prefLabel": "Digital Adaptation Kit",
      "definition": "The kit itself. Properties are exactly the metadata fields DAK.fsh declares and dak.json carries -- no more, so that a dak node can be produced from a real file without anything being invented.",
      "rdf:value": "http://smart.who.int/kg/dak"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/persona",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "persona",
      "prefLabel": "Generic Persona",
      "definition": "DAK component 2. Grounded in GenericPersona.fsh -- title, id, description, otherNames, iscoCode bound to ISCO08ValueSet -- and in the 22 committed ActorDefinition instances that carry name, title, type and description. The two disagree about where ISCO lives, which the properties record rather than smooth over.",
      "rdf:value": "http://smart.who.int/kg/persona"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/user-scenario",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "user-scenario",
      "prefLabel": "User Scenario",
      "definition": "DAK component 3. A narrative describing how personas interact. Carries `personas 0..* id`, which is the only structured link between the narrative layer and the personas it names.",
      "rdf:value": "http://smart.who.int/kg/user-scenario"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/business-process",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "business-process",
      "prefLabel": "Business Process Workflow",
      "definition": "DAK component 4. NOT the BPMN file -- the component that points at one. `source 1..1 uri` is that pointer, and the BPMN's interior is the l2-bpmn subgraph, reached through the external-artifact this sourcedFrom targets.",
      "rdf:value": "http://smart.who.int/kg/business-process"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/dak-task",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "dak-task",
      "prefLabel": "Task Entry",
      "definition": "One entry of BusinessProcessWorkflow's `task 0..*` backbone: identifier, name, description. A node rather than a property because the same task is also drawn in the BPMN file, and the two lists have to be joinable to be checkable against each other.",
      "rdf:value": "http://smart.who.int/kg/dak-task"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/data-element",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "data-element",
      "prefLabel": "Core Data Element",
      "definition": "DAK component 5. CoreDataElement.fsh calls itself \"the ONE EXCEPTION to allowing FHIR R4 models into the DAK LMs\": `type` is one of valueset | codesystem | conceptmap | logicalmodel and `canonical 1..1 uri` points at it. The canonical is recorded; nothing inside it is copied, because FHIR is its own query layer.",
      "rdf:value": "http://smart.who.int/kg/data-element"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/decision-support-logic",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "decision-support-logic",
      "prefLabel": "Decision-Support Logic",
      "definition": "DAK component 6. The whole model is an id, an optional description and `source 1..1 uri` to a DMN file. Nothing about the decision itself -- which is the gap the l2-dmn subgraph fills.",
      "rdf:value": "http://smart.who.int/kg/decision-support-logic"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/scheduling-logic",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "scheduling-logic",
      "prefLabel": "Scheduling Logic",
      "definition": "When an intervention is due, as a DAK component. NOT declared by DAK.fsh -- it is added here because the published SOP lists Scheduling Logic as an active L2 input (spreadsheets under input/scheduling-logic), WHO's ArchiMate model declares it a BusinessObject realised by PlanDefinition, and l1:schedule and l1:schedule-entry had no L2 component to reach. Note that the SOP's own L3 row for scheduling is present but HTML-commented-out and there is no l3_schedulinglogic.md page, so WHO has drafted the mapping and not activated it; the L3 edge is licensed here as a deliberate departure, recorded rather than hidden.",
      "rdf:value": "http://smart.who.int/kg/scheduling-logic"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/program-indicator",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "program-indicator",
      "prefLabel": "Program Indicator",
      "definition": "DAK component 7. Named program-indicator and not `indicator` because L1 already declares an `indicator` -- one normatively defined in a publication. They are different things: this is the DAK's operational measure, and `derivedFrom` is how it points at the normative one. Collapsing them would silently merge a WHO definition with a country's implementation of it.",
      "rdf:value": "http://smart.who.int/kg/program-indicator"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/functional-requirement",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "functional-requirement",
      "prefLabel": "Functional Requirement",
      "definition": "DAK component 8, first half. The as-a/I-want/so-that shape: `activity`, `capability[x]`, `benefit[x]`, and `actor 0..* Reference(SGActor)`. The 41 committed instances use the R5 SGRequirements profile rather than this logical model, so a real instance carries `statement` entries and a userstory extension; both shapes are accommodated and `profile` records which was read.",
      "rdf:value": "http://smart.who.int/kg/functional-requirement"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/non-functional-requirement",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "non-functional-requirement",
      "prefLabel": "Non-Functional Requirement",
      "definition": "DAK component 8, second half. `requirement 1..1 markdown`, an optional category and classification codings. Kept separate from the functional half because the fields genuinely differ -- a non-functional requirement has no actor and no benefit.",
      "rdf:value": "http://smart.who.int/kg/non-functional-requirement"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/requirement-statement",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "requirement-statement",
      "prefLabel": "Requirement Statement",
      "definition": "One numbered, labelled statement inside a requirement, with a conformance verb. A node rather than a property because conformance is queried across a whole DAK -- 'every SHALL in this kit, and what fulfils it' is the question requirements exist to answer.",
      "rdf:value": "http://smart.who.int/kg/requirement-statement"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes/test-scenario",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/repin-train-20261101-1524/smart-base/smart-base-code-lists.jsonld#sgkg-l2-classes",
      "notation": "test-scenario",
      "prefLabel": "Test Scenario",
      "definition": "DAK component 9. `feature 1..1 uri` to a Gherkin feature file, plus an optional description. The feature file's interior is not modelled: no DAK in this estate ships one yet, so a subgraph for it would have no instance to check it against.",
      "rdf:value": "http://smart.who.int/kg/test-scenario"
    }
  ],
