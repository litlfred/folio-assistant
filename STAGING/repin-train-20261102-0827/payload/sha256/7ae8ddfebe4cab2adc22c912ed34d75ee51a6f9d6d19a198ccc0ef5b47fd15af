      "narrative": null,
      "content": "### 2.4. Additional Terms\n\n<a id=\"_durable_content_credential\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Heading that opens section 2.4 Additional Terms; it carries no text of its own.",
