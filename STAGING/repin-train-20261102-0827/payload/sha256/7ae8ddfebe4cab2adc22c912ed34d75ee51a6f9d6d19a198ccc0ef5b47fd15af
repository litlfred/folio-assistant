        },
        "draftedAt": "2026-11-01"
      }
    },
    {
      "id": "library/c2pa-2026-specification-2-5/blocks/prose-s204-14-5-2-6-special-considerations-for-unstructured",
      "types": [
        "folio-assistant-core:Prose",
