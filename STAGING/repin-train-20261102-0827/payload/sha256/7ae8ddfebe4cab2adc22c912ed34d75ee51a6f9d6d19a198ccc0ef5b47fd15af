      "target": "../sections/s420-16-4-5-repository-receipt.md",
      "narrative": null,
      "content": "#### 16.4.5. Repository Receipt\n\n<a id=\"_description_15\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Heading that opens Section 16.4.5, Repository Receipt; the block holds no text beyond the heading.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
