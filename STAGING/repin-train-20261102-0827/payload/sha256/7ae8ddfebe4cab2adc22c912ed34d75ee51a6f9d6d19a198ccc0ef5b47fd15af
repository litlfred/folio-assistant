      "target": "../sections/s138-12-cryptography.md",
      "narrative": null,
      "content": "## 12\\. Cryptography\n\n<a id=\"_hashing\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Heading that opens Chapter 12, Cryptography; it carries no text of its own.",
