      "target": "../sections/s607-a-6-embedding-manifests-into-zip-based-formats.md",
      "narrative": null,
      "content": "### A.6. Embedding manifests into ZIP-based formats\n\n<a id=\"_general_20\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Heading that opens Section A.6, Embedding manifests into ZIP-based formats; the block holds no text beyond the heading.",
