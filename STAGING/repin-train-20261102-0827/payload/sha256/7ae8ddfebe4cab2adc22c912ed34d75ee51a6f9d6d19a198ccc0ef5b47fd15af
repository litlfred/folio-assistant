      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Writing follows the usual placeholder, hash, sign and same-length replace flow, only one C2PA block is allowed per file (duplicates mean no manifest is treated as located), and consumers shall ignore unrecognised extension block types.",
