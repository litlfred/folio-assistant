    {
      "id": "library/c2pa-2026-specification-2-5/blocks/prose-s732-g-5-3-font-actions",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "G.5.3. Font Actions",
      "pageStart": null,
