      "narrative": null,
      "content": "#### 16.6.3. Asset Type\n\n<a id=\"_description_19\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Heading that opens Section 16.6.3, Asset Type; the block holds no text beyond the heading.",
