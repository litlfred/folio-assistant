      "narrative": null,
      "content": "#### 16.6.8. Metadata\n\n<a id=\"_description_24\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Heading that opens Section 16.6.8, Metadata; the block holds no text beyond the heading.",
