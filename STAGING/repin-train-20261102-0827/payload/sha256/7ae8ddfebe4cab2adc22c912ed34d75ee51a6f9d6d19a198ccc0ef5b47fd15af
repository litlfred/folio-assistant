      "kind": "prose",
      "title": "16.5.12. Existing manifests",
      "pageStart": null,
      "pageEnd": null,
      "target": "../sections/s437-16-5-12-existing-manifests.md",
      "narrative": null,
      "content": "#### 16.5.12. Existing manifests\n\n<a id=\"_general_14\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Heading that opens Section 16.5.12, Existing manifests; the block holds no text beyond the heading.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
