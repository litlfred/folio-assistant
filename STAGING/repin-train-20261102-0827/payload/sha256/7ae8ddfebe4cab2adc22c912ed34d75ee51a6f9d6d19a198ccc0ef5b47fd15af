    {
      "id": "library/c2pa-2026-specification-2-5/blocks/prose-s022-2-2-1-digital-content",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "2.2.1. Digital content",
      "pageStart": null,
      "pageEnd": null,
      "target": "../sections/s022-2-2-1-digital-content.md",
      "narrative": null,
      "content": "#### 2.2.1. Digital content\n\nThe portion of an [asset](#_asset) that represents the actual content, such as the pixels of an image, along with any additional technical metadata required to understand the content (e.g., a colour profile or encoding parameters).\n\n<a id=\"_asset_metadata\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Defines digital content as the part of an asset that is the actual content, such as an image's pixels, together with any technical metadata needed to understand it, such as a colour profile or encoding parameters.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "claude-opus-5-5"
        },
        "draftedAt": "2026-10-31"
      }
    },
    {
      "id": "library/c2pa-2026-specification-2-5/blocks/prose-s023-2-2-2-asset-metadata",
