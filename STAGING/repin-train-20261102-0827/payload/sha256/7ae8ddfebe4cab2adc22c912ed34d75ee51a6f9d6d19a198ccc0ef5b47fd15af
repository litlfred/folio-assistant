      "narrative": null,
      "content": "#### 14.8.1. Obtaining the TimeStampToken\n\n<a id=\"_embedded_in_the_claim_signature\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
