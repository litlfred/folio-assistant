    {
      "id": "library/c2pa-2026-specification-2-5/blocks/prose-s456-16-6-2-1-general",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "16.6.2.1. General",
      "pageStart": null,
      "pageEnd": null,
      "target": "../sections/s456-16-6-2-1-general.md",
      "narrative": null,
      "content": "##### 16.6.2.1. General\n\nThis assertion is used to refer to an alternative digital content that is different from the primary asset, and to provide functionality depending on the referenced digital content. It shall have a label of `c2pa.alternative-content-representation`.\n\nThis assertion has the parameters depending on the file format specification. Individual specifications are specified in the following sections.\n\n<a id=\"_original_preservation_image\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Defines the alternative content representation assertion, which shall have the label c2pa.alternative-content-representation and refers to digital content different from the primary asset, with parameters that depend on the file format as specified in the following sections.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "claude-opus-5-5"
        },
        "draftedAt": "2026-11-01"
      }
    },
    {
      "id": "library/c2pa-2026-specification-2-5/blocks/prose-s457-16-6-2-2-original-preservation-image",
      "types": [
        "folio-assistant-core:Prose",
