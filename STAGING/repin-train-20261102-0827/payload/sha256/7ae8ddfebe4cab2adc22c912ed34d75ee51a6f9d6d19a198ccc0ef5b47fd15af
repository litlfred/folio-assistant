      "target": "../sections/s457-16-6-2-2-original-preservation-image.md",
      "narrative": null,
      "content": "##### 16.6.2.2. Original Preservation Image\n\n<a id=\"_description_18\"></a>",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Heading that opens Section 16.6.2.2, Original Preservation Image; the block holds no text beyond the heading.",
        "state": "draft",
        "draftedBy": {
