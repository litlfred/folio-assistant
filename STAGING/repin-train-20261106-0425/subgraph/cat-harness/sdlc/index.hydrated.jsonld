        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/process/Process_CriterionAdjudication",
          "@type": "bootstrap:Process",
          "conformsTo": [
            "https://litlfred.github.io/folio-assistant/cat-harness/externalSchema/omg-bpmn-2.0",
