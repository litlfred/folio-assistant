{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-batched-publisher/cat-harness/tool-types/ProvActivity.schema.json",
  "title": "ProvActivity",
  "type": "object",
  "properties": {
    "@type": {
      "type": "string",
      "const": "prov:Activity"
    },
    "@id": {
      "type": "string",
      "minLength": 1
    },
    "prov:startedAtTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "prov:endedAtTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "prov:qualifiedAssociation": {
      "type": "object",
      "properties": {
        "prov:agent": {
          "type": "string",
          "minLength": 1
        },
        "prov:hadRole": {
          "type": "string",
          "minLength": 1
        },
        "prov:hadPlan": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*#[A-Za-z_][A-Za-z0-9_.-]*$"
        }
      },
      "required": [
        "prov:agent",
        "prov:hadRole",
        "prov:hadPlan"
      ],
      "additionalProperties": false
    },
    "prov:actedOnBehalfOf": {
      "type": "string",
      "minLength": 1
    },
    "prov:used": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "@id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+.-]*:\\S+$"
              },
              "@type": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "const": "prov:Entity"
                  },
                  {
                    "type": "string",
                    "const": "dcat:Distribution"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "spdx:checksum": {
                "type": "object",
                "properties": {
                  "@type": {
                    "type": "string",
                    "const": "spdx:Checksum"
                  },
                  "spdx:algorithm": {
                    "type": "string",
                    "enum": [
                      "spdx:checksumAlgorithm_sha256",
                      "spdx:checksumAlgorithm_sha512"
                    ]
                  },
                  "spdx:checksumValue": {
                    "type": "string",
                    "pattern": "^[0-9a-f]+$"
                  }
                },
                "required": [
                  "spdx:algorithm",
                  "spdx:checksumValue"
                ],
                "additionalProperties": false
              },
              "dcat:downloadURL": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+.-]*:\\S+$"
              }
            },
            "required": [
              "@id",
              "@type",
              "spdx:checksum"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "@id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9+.-]*:\\S+$"
              },
              "@type": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "const": "prov:Entity"
                  },
                  {
                    "type": "string",
                    "const": "cred:VerifiableCredential"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "@id",
              "@type"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "prov:generated": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prov:wasInformedBy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "cat-harness:underPolicy": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "cat-harness:consent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "versionId"
      ],
      "additionalProperties": false
    },
    "cat-harness:consentBased": {
      "type": "boolean"
    },
    "cat-harness:previousHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cat-harness:recordHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "@type",
    "@id",
    "prov:startedAtTime",
    "prov:qualifiedAssociation",
    "cat-harness:underPolicy"
  ],
  "additionalProperties": false,
  "description": "A PROV-O activity (schemas/content/prov.ts). Structured. Not admissible as a command-line argument.",
  "staging": {
    "branch": "claude/staging-batched-publisher",
    "sha": "5952aad361e8c9b0975329b22b5385df129ab5ff",
    "pr": "2884/merge",
    "run": "41327090701"
  }
}
