      },
      "skos:prefLabel": [
        {
          "@value": "Mirror FHIR packages from packages.fhir.org into a git repository"
        }
      ],
      "skos:definition": [
        {
          "@value": "On a machine that reaches packages.fhir.org, fetch exactly a missing list (from `fhir-cache-seed-npm --missing-out`), check each tarball names itself exactly, record SHA512SUMS, and commit and push to a git repository that an environment without packages.fhir.org reads with `--mirror`. The person running it is the trust anchor for what it adds."
        }
      ],
