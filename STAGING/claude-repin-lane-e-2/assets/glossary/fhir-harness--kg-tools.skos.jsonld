      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Write one JSON-LD node per IG artefact, and check a built site's nodes"
        }
      ],
      "skos:definition": [
        {
          "@value": "`write` turns an artefact index into `artifact/<Type>-<id>.jsonld` (and a `.json` twin) under a docs root: one `folio-ig-artifact-jsonld/v1` node per artefact, in borrowed vocabularies only (the FHIR RDF class, dcterms, schema.org, PROV), naming the artefact's canonical URL, its representations and, for a compiled copy, what built it. `check` is the kind's QA: over a BUILT site, every artefact has its node and no node is an orphan, each node is its own file's, its twin matches, and every local resource it names is on the site. It also writes and checks the index node, `artifact/index.jsonld` (`folio-ig-artifact-index-jsonld/v1`): every artefact once, each entry naming its node. WHO-free; the assets the thin pages render (owner, 2026-10-11, option A; thin by default since 2026-10-12)."
        }
      ],
      "skos:notation": "ig-artifact-jsonld",
      "dcterms:source": "fhir-harness/tools/ig-artifact-jsonld/ig-artifact-jsonld.ts#ig-artifact-jsonld",
      "skos:note": "candidate"
    },
