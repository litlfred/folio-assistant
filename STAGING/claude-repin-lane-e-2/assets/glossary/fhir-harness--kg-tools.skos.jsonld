        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Stage one IG as its own just-the-docs Jekyll site"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turn an IG source repository into ONE Jekyll source for just-the-docs, as the IG Publisher builds one IG per site: `input/pagecontent` pages with title, parent and order from `sushi-config.yaml` `pages:`, the files the Publisher's include tags resolve against, images, `_data/fhir.json` from `ig-site-data`, and a `_config.yml`. The pages render unchanged, including their references to the IG's site data (bean `bamf`, owner's choice of one site per IG). With the IG's menu, the layout is the one every IG site wears (bean `mftp`): the IG's own top bar, the IG's TOC declared as the folio-assistant navbar's section (added by `rail-standalone-pages`), no sidebar of its own, an edit link per page, and per heading a source-line link and a pre-filled feedback issue."
        }
      ],
      "skos:notation": "build-ig-site",
      "dcterms:source": "fhir-harness/tools/build-ig-site/build-ig-site.ts#build-ig-site",
      "skos:note": "candidate"
    },
    {
