      },
      "skos:prefLabel": [
        {
          "@value": "Ingest an IG's navigation from its sushi-config"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read `menu:` (and the page tree) out of an IG source repository's `sushi-config.yaml` into `fhir-artifact-index/menu.json`, recording the repository and commit it was read at — the declared source `stage-ig-sites` clones. `--check` re-derives it against a checkout; with no `--source` it reports COULD NOT DETERMINE and exits 2, never 0."
        }
      ],
      "skos:notation": "ingest-ig-menu",
      "dcterms:source": "fhir-harness/tools/ingest-ig-menu/ingest-ig-menu.ts#ingest-ig-menu",
      "skos:note": "candidate"
    },
