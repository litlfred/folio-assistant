      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Check an IG's built Questionnaires with CSIRO's SDC libraries"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build-time Structured Data Capture checks, one result per Questionnaire (`sdcChecks[]` of `fhir-questionnaire-wireframe`): `assemble` (`@aehrc/sdc-assemble` 2.0.3: an assemble-root's sub-forms resolve in this IG, and `--out` writes the assembled Questionnaire), `template-extract` (`@aehrc/sdc-template-extract` 1.0.16: extraction from the IG's fixture response yields the expected resources), `populate` (`@aehrc/sdc-populate` 4.7.2: FHIRPath pre-population from a fixture context gives the expected answers) and `behaviour` (`@aehrc/questionnaire-test-toolkit` 0.1.0: the IG's own behavioural test, warn-only). Owner, 2026-10-14: checks, not UI."
        }
      ],
      "skos:notation": "sdc-checks",
      "dcterms:source": "fhir-harness/tools/sdc-checks/sdc-checks.ts#sdc-checks",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-tools/stage-ig-sites",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Stage every IG whose instance records its source, one Jekyll site each"
        }
      ],
      "skos:definition": [
        {
          "@value": "For every instance holding `fhir-artifact-index/menu.json` with a sushi-config source, clone the IG at the recorded commit and stage it with `build-ig-site`: the instance's webpage theme (inherited along `needs` when it declares none), its artefact pages and `artifacts` page, its post-processing fills, and an edit link to the IG's default branch. An instance whose docs directory declares `igSite` is staged to be served AT `/<instance>/` with its artefact pages copied in (a collision is refused); otherwise beside it at `/<instance>/ig/`. Prints one `<instance> <jekyll source> <at>` line per IG for the caller's `jekyll build` (beans `bamf`, `mftp`)."
        }
      ],
      "skos:notation": "stage-ig-sites",
      "dcterms:source": "fhir-harness/tools/stage-ig-sites/stage-ig-sites.ts#stage-ig-sites",
      "skos:note": "candidate"
    },
