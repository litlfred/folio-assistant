      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Check a Questionnaire field for field against the wireframe it was derived from"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compare the `data-element` fields of a mid-fidelity wireframe (per `data-layout`, in document order) with the answerable items of a BUILT Questionnaire (depth first, named by `definition` or `code`). Reports a field with no item, an item with no field, an item naming no data element, a data element twice in one layout, and the first place the order differs. Fidelity, not design. Moved down from the WHO layer on the owner's ruling of 2026-10-14: nothing in it is WHO's."
        }
      ],
      "skos:notation": "check-wireframe-questionnaire",
      "dcterms:source": "fhir-harness/tools/check-wireframe-questionnaire/check-wireframe-questionnaire.ts#check-wireframe-questionnaire",
      "skos:note": "candidate"
    },
    {
