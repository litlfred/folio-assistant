      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/translation-roundtrip-record.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Write a back-translation verdict, produced by a pair of translation agents, into a block's existing translation-QA sidecar. It records a judgement rather than making one, and refuses where no sidecar exists — a round trip cannot be what decides a block is translated.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat translation:roundtrip"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--payload"
            },
            "description": "JSON carrying the block, locale, verdict and the agent pair. Absent, the command exits 2 with its usage — measured, not assumed.",
            "name": "payload",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "The `<block>.<locale>.translation-qa.json` written, under criterion `translation-semantic-roundtrip`. An AGENT entry replaces a previous agent entry — a re-run is a re-measurement of the same pair on the same text, not another line in a log — while a human ruling already recorded is kept, because this process does not supersede one.",
            "name": "sidecar",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "translation-roundtrip-record",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/translation-manager",
      "title": "Record a round-trip translation verdict"
    }
  ],
