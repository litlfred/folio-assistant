      "maintainsFrom": "schemas/kg/jsonld.ts",
      "name": "content-context",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/kg-export",
      "title": "Content JSON-LD context"
