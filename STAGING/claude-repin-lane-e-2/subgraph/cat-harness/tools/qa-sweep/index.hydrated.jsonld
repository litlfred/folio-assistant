      "@type": "cat-harness:Tool",
      "description": "Run every registered criterion over the blocks under a path and write a per-block QA sidecar. A sidecar rather than a console report, because a printed verdict cannot distinguish \"never checked\" from \"checked and clean\".",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat qa:sweep"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "The content root to sweep. Absent, the command exits 2 with its usage — could-not-determine, not a clean sweep.",
            "name": "targetPath",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--dry-run"
            },
            "description": "Report what would change without writing sidecars.",
            "name": "dryRun",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--ci"
            },
            "description": "Fail on a finding rather than recording it.",
            "name": "ci",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "One `<block>.qa.json` per block, committed beside its subject.",
            "name": "sidecars",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "qa-sweep",
