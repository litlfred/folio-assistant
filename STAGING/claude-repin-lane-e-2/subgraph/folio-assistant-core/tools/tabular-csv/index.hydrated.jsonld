      "@type": "cat-harness:Tool",
      "description": "Read a delimited text file into a `folio-tabular-csvw/v1` record: one table, its columns and their CSVW datatypes, each measured or explicitly undetermined. Routing is by content, never by extension: the first rows must agree on one field count of two or more, under exactly one of `,` `;` TAB `|`. A CSV's `fac:anchor` sheet and cell are a determined null. Governed by the `tabular-metadata` skill (bean `eief`).",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-core/scripts/tabular-csv.ts"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "Path to the delimited text file.",
            "name": "file",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/DelimitedTextPath"
          },
          {
            "arg": {
              "flag": "--doc-id"
            },
            "description": "The record's `doc_id`. Default: the file name without its extension.",
            "name": "doc-id",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/DocId"
          },
          {
            "arg": {
              "flag": "--out"
            },
            "description": "Where to write `tabular.csvw.json`. Default: stdout.",
            "name": "out",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "A `folio-tabular-csvw/v1` document. Exit 2 when the file is not shown to be a table.",
            "name": "record",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "tabular-csv",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/tabular-metadata",
      "title": "CSV tabular metadata"
