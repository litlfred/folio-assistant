{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-npm_and_yarn-cat-harness-schemas-zod-4.6.5/skills/content-plan/output.schema.json",
  "title": "Content Plan Output",
  "description": "Output schema for content planning.",
  "type": "object",
  "required": [
