        "sprints",
        "team"
      ],
      "properties": {
        "projectName": {
          "type": "string"
        },
        "sprints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer"
              },
              "startDate": {
                "type": "string",
                "format": "date"
              },
              "endDate": {
                "type": "string",
                "format": "date"
              },
              "goals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "team": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "actorId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
