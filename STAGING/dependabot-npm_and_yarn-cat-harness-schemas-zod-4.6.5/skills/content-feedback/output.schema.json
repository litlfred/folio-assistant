{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-npm_and_yarn-cat-harness-schemas-zod-4.6.5/skills/content-feedback/output.schema.json",
  "title": "Content Feedback Output",
  "description": "Output schema for triaged feedback.",
  "type": "object",
  "required": [
    "triagedItems"
  ],
  "properties": {
    "triagedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "backlog",
              "next-sprint",
              "wont-fix",
              "duplicate",
              "needs-info"
            ]
          },
          "assignee": {
            "type": "string"
          },
          "linkedIssue": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "critical": {
          "type": "integer"
        },
        "major": {
          "type": "integer"
        },
        "minor": {
          "type": "integer"
        },
        "enhancement": {
          "type": "integer"
        }
      }
    }
  },
  "staging": {
    "branch": "dependabot/npm_and_yarn/cat-harness/schemas/zod-4.6.5",
    "sha": "626a46304d4e05df421b8668f9d97609e710d492",
    "pr": "912/merge",
    "run": "35712721512"
  }
}
