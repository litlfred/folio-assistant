      },
      "skos:prefLabel": [
        {
          "@value": "Compute the cone of the change"
        }
      ],
      "skos:definition": [
        {
          "@value": "`fsh-cone --changed` (scripts/fsh-cone.ts) over the changed files: the forward cone is what to rebuild, the backward cone is what to check out."
        }
      ],
      "skos:notation": "Task_Cone",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Cone",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igincremental.task_conereport",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the cone report on the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review path: the reviewer sees what this change rebuilds — how many artefacts, and whether a hub (a shared RuleSet, CQL library or value set) is touched — before the build finishes. On main it is a log line."
        }
      ],
      "skos:notation": "Task_ConeReport",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_ConeReport",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igincremental.task_contextload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Load or reuse the warm context"
        }
      ],
      "skos:definition": [
        {
          "@value": "The validator's server mode holds the loaded dependency packages, snapshots and expansions in its session cache. Cold start loads the restored derived FHIR rather than regenerating it."
        }
      ],
      "skos:notation": "Task_ContextLoad",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_ContextLoad",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igincremental.task_deploy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy the site"
        }
      ],
      "skos:definition": [
        {
          "@value": "Deploy the site built from main or a release. Deploying is release-management, after a human authorised the release — an agent never records that authorisation. Report the published URL only once it answers: a returned deploy is not a serving site."
        }
      ],
      "skos:notation": "Task_Deploy",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Deploy",
