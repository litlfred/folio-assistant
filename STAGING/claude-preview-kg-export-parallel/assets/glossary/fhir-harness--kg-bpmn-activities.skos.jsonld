      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log the environment error on the bean"
        }
      ],
      "skos:definition": [
        {
          "@value": "Exit 2 from restore: the cache store or the toolchain could not be reached. Record that on the change's bean, with the restore output, so the work plan says the build did not run and why. Check before creating — beans create is not idempotent."
        }
      ],
      "skos:notation": "Task_LogEnvError",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_LogEnvError",
