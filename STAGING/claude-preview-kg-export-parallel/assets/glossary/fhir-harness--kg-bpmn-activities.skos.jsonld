      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "BPMN activities, extracted (fhir-harness)",
      "skos:definition": "Candidate terms extracted from every BPMN task and call activity: `name` as the label, its own `<documentation>` as the definition, the element id as the code. Generated by folio-assistant-core/scripts/glossary-extract.ts; not curated, and never hand-edited: a person promotes a term by authoring it in a glossary of their own.",
      "dcterms:source": "BPMN activities of fhir-harness"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastcache.task_buildsite",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build and publish the site from the AST"
        }
      ],
      "skos:definition": [
        {
          "@value": "Runs the site route's steps via `stage-local.ts` → `build-instance-site.ts`: `ig-site:sidecars` (IG API sidecars, if the landing layer has the step), `ig-site:compose` (artefact index and thin pages from the AST, the IG composed at the root), `ig-site:openapi` (if the IG holds OpenAPI pages), `ig-site:publisher-pages` (the AST's resources as `ast-data/`, the build stamp), and last `ig-site:bar` (the IG's slim bar on pages written after `publisher-pages`). Published at the root from the default branch, as a preview otherwise."
        }
      ],
      "skos:notation": "Task_BuildSite",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_BuildSite",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastcache.task_dispatch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dispatch AST refresh"
        }
      ],
      "skos:definition": [
        {
          "@value": "Actions → \"IG AST refresh (by hand)\" → Run workflow on the default branch, inputs `ref` = the default branch, `force` = false. Set `force` = true only to rebuild a cache that is valid but suspected wrong."
        }
      ],
      "skos:notation": "Task_Dispatch",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_Dispatch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastcache.task_export",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the IG with the AST exporter"
        }
      ],
      "skos:definition": [
        {
          "@value": "The runner mounts the layers the IG repository's `index.lock.json` pins, then restores and judges the cache itself. When it is not valid (or `force` is set) it rebuilds with the Publisher fork (Tool `ig-ast-export`, `litlfred/fhir-ig-publisher` at the pinned `claude/ast-export` commit). A stale cache is first rebuilt incrementally (`IncrementalBuildCli`), falling back to a full `AstExportCli` build with `-tx`; a `force` run, a `pre-export` caller, or a missing or cannot-tell cache always builds in full, and a release needs a full build. The caller's optional `pre-export` overlay command runs before a full build; the inputs it changed are put back and the AST is recorded against the clean commit's input digest (`ig-ast.ts source-inputs`). The AST just built must itself be `valid` for the commit, or the run fails."
        }
      ],
      "skos:notation": "Task_Export",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_Export",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastcache.task_restore",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Restore and judge the cached AST"
        }
      ],
      "skos:definition": [
        {
          "@value": "`ig-cache.sh restore --ig-root .` fetches `cat/fhir-harness/fhir-ast/<package id>` into `output-ast/` (with the Publisher's `txcache/`), then `ig-cache.sh verify` runs `ig-ast.ts validity`: exit 0 valid, 1 stale-inputs (naming which input), 2 cannot-tell. A restore that finds no branch is a miss, judged as not valid. In an IG repository's site route this is the first `pre` step, `ig-site:ast` (`ig-repo-site.ts ast`)."
        }
      ],
      "skos:notation": "Task_Restore",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_Restore",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastcache.task_seed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the cache branch"
        }
      ],
      "skos:definition": [
        {
          "@value": "`ig-cache.sh seed --ig-root . --push`: one commit holding the AST, the Publisher's expansions and `txcache/`, its subject recording the package, counts, Publisher version and source commit. Refused when the candidate is under 90% of the incumbent's resources or edges (the no-shrink gate)."
        }
      ],
      "skos:notation": "Task_Seed",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_Seed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastdeltareview.task_diff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Diff the two ASTs"
        }
      ],
      "skos:definition": [
        {
          "@value": "`ig-ast.ts diff <base> <head> --plan plan.json --site <site>/ast-delta/`: resources added, removed, changed (with an element-level differential) and version-changed; edges added and removed; the plan's decision. Every page opens with the provisional mark and is wrapped in raw so narrative Liquid is not executed."
        }
      ],
      "skos:notation": "Task_Diff",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-delta-review.bpmn#Task_Diff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastdeltareview.task_filecoupling",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Note the missed coupling on the work plan"
        }
      ],
      "skos:definition": [
        {
          "@value": "Append to the IG AST work-plan item: the resource key, the differential path, and why it is unexplained. A note on the existing item, not a new one unless the owner asks; creating an item is not idempotent, so check before creating."
        }
      ],
      "skos:notation": "Task_FileCoupling",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-delta-review.bpmn#Task_FileCoupling",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastdeltareview.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the delta"
        }
      ],
      "skos:definition": [
        {
          "@value": "Start at the delta index; open each changed resource's page. Check `builtAt` before judging: a resource carried from the base was not rebuilt, so a difference there is the change itself or a missed coupling, never noise. The differential is structural: a reordered repeating element shows at every index."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-delta-review.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igastdeltareview.task_validity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the base AST against the inputs"
        }
      ],
      "skos:definition": [
        {
          "@value": "`ig-ast.ts validity <base> --ig <root>`: folio-assistant-core's compiledValidity on the manifest's inputs, with the input digest recomputed by the same algorithm as the Java writer. Exit 0 valid, 1 stale-inputs (names which input), 2 cannot-tell. Run against the BASE revision's checkout."
        }
      ],
      "skos:notation": "Task_Validity",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-delta-review.bpmn#Task_Validity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igdocssitecompose.task_composeinto",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compose each staged IG into the host source [stage-ig-sites]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `stage-ig-sites` with `--compose-into ./_docs` (the same run as `Task_Stage`). Moves each staged site INTO the host's Jekyll source at `<instance>/`, with its includes and data namespaced per IG. Pages wear the thin layout with the host's chrome linked (`--full-pages` inlines the host's full chrome instead). Prints one `<instance> <jekyll source> <at>` line per IG: the build list the host keeps (`./_ig-list.txt`) for the post-build pass."
        }
      ],
      "skos:notation": "Task_ComposeInto",
      "dcterms:source": "fhir-harness/processes/tools/ig-docs-site-compose.bpmn#Task_ComposeInto",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igdocssitecompose.task_indexes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build each IG's artefact index [ig-index-build]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `ig-index-build`: `bun run cat ig-index:build`. Restores each IG's AST from its cache branch and writes `fhir-artifact-index/` (`index.json`, `menu.json` with the `source.of`/`source.ref` that `Task_Stage` clones from, `releases.json`, `package.tgz`). A missing input skips that instance, named."
        }
      ],
      "skos:notation": "Task_Indexes",
      "dcterms:source": "fhir-harness/processes/tools/ig-docs-site-compose.bpmn#Task_Indexes",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igdocssitecompose.task_pages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Generate each IG instance's artefact pages [ig-pages]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `ig-pages`: `bun run fhir-harness/scripts/gen-ig-pages.ts --instance <instance> ...`, run for every IG instance by its own pages script. Writes `<instance>/docs/` from the artefact index: one thin page per artefact with its JSON-LD node, and, for an instance whose docs declare `igSite`, only a front-matter `artifacts.md`. Built at publish, never committed."
        }
      ],
      "skos:notation": "Task_Pages",
      "dcterms:source": "fhir-harness/processes/tools/ig-docs-site-compose.bpmn#Task_Pages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igdocssitecompose.task_stage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Clone each IG at its recorded commit and stage it [stage-ig-sites]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `stage-ig-sites`: `bun run fhir-harness/scripts/stage-ig-sites.ts --work ./_ig --baseurl /<repo> --plantuml-jar <jar>`. Clones each IG at its recorded commit and stages ONE just-the-docs Jekyll source per IG with Tool `build-ig-site` (pages, includes, images, PlantUML, `_data/`, theme colours); the artefact lists (`artifacts`, `toc`) are thin pages over the artefact index node (Liquid only under `--full-pages`), and the instance's artefact pages from `Task_Pages` are copied in. The theme is the one `webpage` theme the instance declares or inherits along `needs`; two at the same distance are refused."
        }
      ],
      "skos:notation": "Task_Stage",
      "dcterms:source": "fhir-harness/processes/tools/ig-docs-site-compose.bpmn#Task_Stage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igincremental.task_checkout",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Restricted checkout of the backward cone"
        }
      ],
      "skos:definition": [
        {
          "@value": "git sparse-checkout of the cone's files plus sushi-config.yaml, ig.ini and the alias files — a median of three files, p90 eleven, measured on the SMART Immunizations IG."
        }
      ],
      "skos:notation": "Task_Checkout",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Checkout",
      "skos:note": "candidate"
    },
    {
