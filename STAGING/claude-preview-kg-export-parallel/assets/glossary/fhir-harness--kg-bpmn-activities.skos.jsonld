      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Full publisher build"
        }
      ],
      "skos:definition": [
        {
          "@value": "Exit 1 or 3 from restore: the whole IG is built. Its outputs become the records the next seed writes."
        }
      ],
      "skos:notation": "Task_FullBuild",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_FullBuild",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities/process_igincremental.task_index",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Rebuild the meta-index (ig_metaindex_rebuild)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The whole-IG aggregates only — artifacts, TOC, canonicals, expansions, package, QA aggregate. Never re-derives an artefact: a missing record is a miss (exit 1), not a silent rebuild."
        }
      ],
      "skos:notation": "Task_Index",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Index",
      "skos:note": "candidate"
    },
    {
