      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy the preview site"
        }
      ],
      "skos:definition": [
        {
          "@value": "A preview never seeds the shared cache."
        }
      ],
      "skos:notation": "Task_DeployPreview",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_DeployPreview",
      "skos:note": "candidate"
    },
