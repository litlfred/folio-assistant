      "title": "Publish target",
      "notation": "publish-target",
      "definition": "GitHub Pages, or wherever the folio is served from. Reached, probed and reported on — never assumed live.",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness-glossary.jsonld",
