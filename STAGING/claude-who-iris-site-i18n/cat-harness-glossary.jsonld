    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#glossary-usage/Process_HumanTranslation/Lane_Coordinator",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#role/translation-coordinator",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#process/Process_HumanTranslation",
      "label": "Translation Coordinator",
      "scopeNote": "Owns the completeness gate, Gateway_Complete, a different question from the accuracy Lane_Reviewer judges later: this lane can send work back to the translator for missing or fuzzy strings before a single sentence has been checked for meaning.",
      "source": "cat-harness/processes/library/human-translation-workflow.bpmn"
    },
    {
