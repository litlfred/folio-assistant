    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#role/integration-watcher",
      "@type": "skos:Concept",
      "prefLabel": "Integration watcher",
      "title": "Integration watcher",
      "notation": "integration-watcher",
      "definition": "Watches the default branch and open branches for newly-landed work that an existing audit axis should be re-run over. Reports findings; does not author the fix.",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness-glossary.jsonld"
    },
    {
