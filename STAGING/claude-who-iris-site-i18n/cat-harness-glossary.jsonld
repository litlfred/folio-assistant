      "@type": "skos:Concept",
      "prefLabel": "Lean authoring agent",
      "title": "Lean authoring agent",
      "notation": "lean-authoring-agent",
      "definition": "Writes and repairs the Lean 4 formalization — translating narrative mathematics into declarations, keeping the build green, and curating what is staged for upstream.",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness-glossary.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#role/proof-review-agent",
      "@type": "skos:Concept",
      "prefLabel": "Proof review agent",
      "title": "Proof review agent",
      "notation": "proof-review-agent",
      "definition": "Reviews proofs — narrative and formal — for gaps, vacuity, redundancy and divergence between the two renderings of the same claim.",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness-glossary.jsonld"
    },
