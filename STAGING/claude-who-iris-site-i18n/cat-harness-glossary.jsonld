    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#role/merge-steward",
      "@type": "skos:Concept",
      "prefLabel": "Merge steward",
      "title": "Merge steward",
      "notation": "merge-steward",
      "definition": "Stewards writes to ONE watched ref -- a long-lived branch several processes write and something downstream consumes serially. The ref is a parameter of the LANE INSTANCE, not of this persona, so `main`, `gh-pages` and each `cat/cat-harness/*` store branch can each have a steward without a schema change; `scripts/special-branches.json` is the declaration of which refs qualify. On `main` that work is a merge train: composes it from the queue, attributes and ejects on red, lands at the tested SHA. On a route-keyed ref it is coalescing: batches the writes arriving in one window into a single write. Decides nothing the reprioritisation table or the owner has not -- placement is computed by merge-priority.dmn, and landing waits for the owner's release. Records decisions on queue entries and windows, never the host's facts.",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness-glossary.jsonld",
      "usage": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#glossary-usage/Process_MergeTrain/Lane_Steward"
      ]
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#glossary-usage/Process_MergeTrain/Lane_Steward",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#role/merge-steward",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#process/Process_MergeTrain",
      "label": "Merge steward",
      "scopeNote": "Composes the train from the queue, decides nothing the placement table or the owner has not, attributes and ejects on red, and lands at the tested SHA.",
      "source": "cat-harness/processes/sdlc/merge-train.bpmn"
    },
    {
