      "label": "CI/CD Pipeline",
      "scopeNote": "The gate and the deploy. `code-quality-gates.yml` runs `slice:sqlite:check` on every pull request; `docs-site.yml` and `feature-staging.yml` build each slice into `_site/` from the tree they publish, one line per slice.",
      "source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#glossary-usage/Process_HumanTranslation/Lane_Pipeline",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#LaneUsage",
