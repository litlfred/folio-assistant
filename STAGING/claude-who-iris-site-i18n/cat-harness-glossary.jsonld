      "source": "cat-harness/processes/process/crdm-close.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#glossary-usage/Process_CRDM_DataModel/Lane_BA",
