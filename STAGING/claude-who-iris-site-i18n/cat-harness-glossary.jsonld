      "label": "Build pipeline",
      "scopeNote": "Mechanical: every decision on this lane is read off the resolved source, so the same declaration mounts the same way in every container, and an override in the instance config is the only thing that changes it.",
      "source": "cat-harness/processes/kg/mount-subgraph.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#glossary-usage/Process_SliceSqlitePublish/Lane_Ci",
