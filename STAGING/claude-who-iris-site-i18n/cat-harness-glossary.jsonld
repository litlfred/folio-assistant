      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#role/validation-pipeline",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#process/Process_QaReportSigning",
      "label": "Validation and QA (mechanical + agents)",
      "scopeNote": "Owns everything except the act of signing: it builds the hashable run, computes the two facts — effectiveReach and whether the API is configured — that Gateway_SigningRoute's table reads rather than a hand-asserted choice, and after either route returns, records which one fired. The record is what lets a later reader know which trust assumption they are relying on without having to ask.",
      "source": "cat-harness/processes/sdlc/qa-report-signing.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-who-iris-site-i18n/cat-harness.jsonld#role/publish-target",
