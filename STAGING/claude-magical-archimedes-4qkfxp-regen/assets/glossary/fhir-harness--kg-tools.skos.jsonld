      "skos:prefLabel": [
        {
          "@value": "Strip binary payloads from Library resources"
        }
      ],
      "skos:definition": [
        {
          "@value": "Remove base64 `content.data` from published `Library` resources, so an IG embedding compiled CQL does not ship the bytes twice."
        }
      ],
      "skos:notation": "strip-library-binaries",
      "dcterms:source": "fhir-harness/tools/index.ts#strip-library-binaries",
      "skos:note": "candidate"
