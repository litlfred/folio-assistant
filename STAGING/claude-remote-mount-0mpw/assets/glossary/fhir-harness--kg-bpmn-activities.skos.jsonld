        {
          "@value": "Validate the cone (fhir_validate) [fhir-validation]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Validate the cone's resources against the warm validator and report the cone that was checked. A validator that could not start is could-not-determine, never a pass with no findings. A green cone is not a green IG: a profile the change did not touch can still be broken by it."
        }
