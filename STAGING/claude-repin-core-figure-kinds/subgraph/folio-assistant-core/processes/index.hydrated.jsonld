    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/globalTask/GT_SeedWorkPlan",
      "@type": "bootstrap:Task",
      "bpmnType": "bpmn:GlobalTask",
      "description": "The plan becomes beans, so a resumed session or a sibling agent can pick it up. The run's own bean was claimed by the Process_BeanOpen call before this step (bean m8gz), so this step only notes the seeded plan on it; the beans themselves are written with the agent's own `beans create`, which no engine op performs. From here on, beans/ is the shared answer to 'what is done, what is next' — for humans and agents alike.",
      "inSubgraph": "https://litlfred.github.io/folio-assistant/folio-assistant-core/directory/core-processes",
      "name": "Seed the work plan",
      "requires": "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/todo-manager",
      "sourcePath": "processes/global-tasks.bpmn",
      "sourceUrl": "https://github.com/litlfred/folio-assistant-core/blob/main/processes/global-tasks.bpmn",
      "summary": "The plan becomes beans, so a resumed session or a sibling agent can pick it up."
    }
  ],
