  "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tools/remote-mount.jsonld",
  "partOf": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/cat-harness.jsonld",
  "staging": {
    "branch": "claude/repin-core-figure-kinds",
    "sha": "35d4e36ebdc755161c34dcfb9b2c63c05315a83e",
    "pr": "2862/merge",
    "run": "41254746755"
  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tools/remote-mount.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "remote-mount",
      "title": "Mount remote harnesses at a pinned commit, only when trusted",
      "description": "Lay down each declared remote mount — a `source.remote` instance in the root `index.config.json`, or, in a folio with no index, a `remoteMounts` entry on its declaration (both at once is refused) — and its dependency closure, from another repository at a full commit SHA. Write the lock, `index.lock.json` (a legacy `<name>.mount-lock.json` is read, and renamed onto it when rewritten), and, with an index, regenerate the root `.gitignore` block that ignores each mount path. It READS the declared mounts and never writes them: a tool that changes a mount writes through `writeDeclaredMounts` into `index.config.json`. Before anything is checked out, each mount must pass the trust gate (`schemas/kg/mount-trust.ts`, rule H8): a person's consent recorded for THIS pin, or a signature in a declared trust network. No signature verifier exists yet, so a signature alone is could-not-determine and does not mount. Unsigned and unconsented is refused. `--staging` mounts for a preview and needs neither, by the owner's ruling. A directory id an override or `mountDefaults` names may be one the instance declares in its `<name>.json` or one it declares FROM WITHIN a declared directory (`skills/skills.json` naming `voices`), resolved at the pin through `instanceDirectories` (bean `mo75` G3); an id in neither is refused at plan time. `tools` on an override names Tools by id and mounts each one runnable (bean `mo75` G3; owner, 2026-10-24): its definition (`<tools dir>/<id>/<id>.ts`), its implementation (the `inProcess.module`, or the script its `bun run cat <key>` resolves to) and their import closure, walked by bootstrap-tools' `importClosure` (the one closure walker), as every declared directory that closure touches — the lock still records directories only. A `hydrated` mount (bean `mo75`) lays each chosen directory down as its published `index.hydrated.jsonld` only: read from the pin's git tree when a commit carries it, otherwise fetched from the pin's subgraph index package (the `subgraph-index-<sha>` release asset `subgraph-index-package` publishes), its tarball checked against its `folio-binary-release/v1` record, its manifest against the repository, pin and harness asked for, and each file against its sha256, `SubgraphHydratedSchema` and the subgraph IRI; the lock records the package's URL and sha256 so a replay fetches the same bytes. `--check` compares the disk against the lock and never fetches. When a run CHANGES the lock, it then re-renders the agent surface (`skill:commands` → `.claude/commands/`, `agent-memory` → `.claude/agent-memory/` and `.agents/`) from the checkout root, so a re-pin commit carries the skills and memory the new layers define; a generator that fails fails the run, and `--no-agent-surface` opts out.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat mount:remote"
      },
      "io": {
        "inputs": [
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The downstream instance root; omitted, every declaring instance in the checkout.",
            "required": false,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "staging",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Mount for a staging preview: no signature or consent required.",
            "required": false,
            "arg": {
              "flag": "--staging"
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Compare the disk against the lock; fetch nothing.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          },
          {
            "name": "noAgentSurface",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Do not re-render `.claude/commands/` and the agent memory after a mount that changed the lock.",
            "required": false,
            "arg": {
              "flag": "--no-agent-surface"
            }
          },
          {
            "name": "noInstall",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Lay the pinned bytes down without `bun install` in each mounted instance that carries a `package.json`. By default the install runs (`--production`; `--install-all` keeps devDependencies), so the mounted tools run; it writes only `node_modules/`, which no mount digest covers, so `--check` still passes.",
            "required": false,
            "arg": {
              "flag": "--no-install"
            }
          },
          {
            "name": "seed",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/MountSeed",
            "description": "`<name>=<owner/repo>@<40-char sha>`: create or re-pin that remote instance in `index.config.json` instead of mounting, writing its `trust.consent` for that pin in the same write (needs `consentBy` and `evidence`; repeatable; `--whole` mounts every tracked file). Refused while a mount it moves has edits the lock does not hold, since the next mount would leave that mount at the old commit (folio-assistant#2682); `fresh` lets it through.",
            "required": false,
            "arg": {
              "flag": "--seed"
            }
          },
          {
            "name": "fresh",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Replace a mount whose bytes no longer hash to the lock instead of leaving it untouched; with `seed`, re-pin over such edits. The edits are discarded.",
            "required": false,
            "arg": {
              "flag": "--fresh"
            }
          },
          {
            "name": "choose",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/MountChoice",
            "description": "`<harness>[:<instance>]`: write a review's choice (`directories` and/or `tools`) into that mount entry's `overrides.<instance>` instead of mounting, so a fresh clone replays it (bean `mo75`). The pin and its consent are untouched; the next mount resolves the choice and the lock records what it resolved to.",
            "required": false,
            "arg": {
              "flag": "--choose"
            }
          },
          {
            "name": "directories",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/IdList",
            "description": "With `choose`: comma-separated directory ids, nested ids or concern names.",
            "required": false,
            "arg": {
              "flag": "--directories"
            }
          },
          {
            "name": "tools",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/IdList",
            "description": "With `choose`: comma-separated Tool ids, each mounted runnable.",
            "required": false,
            "arg": {
              "flag": "--tools"
            }
          },
          {
            "name": "consentBy",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/Login",
            "description": "With `seed`: who consented, as `consent.by`.",
            "required": false,
            "arg": {
              "flag": "--consent-by"
            }
          },
          {
            "name": "evidence",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "With `seed`: where the consent was given, readable (a session, an issue comment), as `consent.evidence`. On stdin because it is free prose: it quotes what was said.",
            "required": false,
            "arg": {
              "stdin": true
            }
          }
        ],
        "outputs": [
          {
            "name": "outcomes",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Per instance: mounted, local, skipped, missing (including refused by the trust gate) or could-not-determine."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git",
          "curl",
          "tar"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/skill/security",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-figure-kinds/cat-harness/skill/agent-memory"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/remote-mount.jsonld"
    }
  ]
}
