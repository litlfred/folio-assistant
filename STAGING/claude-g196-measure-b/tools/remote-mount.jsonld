  "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tools/remote-mount.jsonld",
  "partOf": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/cat-harness.jsonld",
  "staging": {
    "branch": "claude/g196-measure-b",
    "sha": "9fcbebb40c264041faefd351f7247f3dd96896ea",
    "pr": "2640/merge",
    "run": "39982078963"
  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tools/remote-mount.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "remote-mount",
      "title": "Mount remote harnesses at a pinned commit, only when trusted",
      "description": "Lay down each declared remote mount — a `source.remote` instance in the root `index.config.json`, or, in a folio with no index, a `remoteMounts` entry on its declaration (both at once is refused) — and its dependency closure, from another repository at a full commit SHA. Write the lock, `index.lock.json` (a legacy `<name>.mount-lock.json` is read, and renamed onto it when rewritten), and, with an index, regenerate the root `.gitignore` block that ignores each mount path. It READS the declared mounts and never writes them: a tool that changes a mount writes through `writeDeclaredMounts` into `index.config.json`. Before anything is checked out, each mount must pass the trust gate (`schemas/mount-trust.ts`, rule H8): a person's consent recorded for THIS pin, or a signature in a declared trust network. No signature verifier exists yet, so a signature alone is could-not-determine and does not mount. Unsigned and unconsented is refused. `--staging` mounts for a preview and needs neither, by the owner's ruling. `--check` compares the disk against the lock and never fetches. When a run CHANGES the lock, it then re-renders the agent surface (`skill:commands` → `.claude/commands/`, `agent-memory` → `.claude/agent-memory/` and `.agents/`) from the checkout root, so a re-pin commit carries the skills and memory the new layers define; a generator that fails fails the run, and `--no-agent-surface` opts out.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat mount:remote"
      },
      "io": {
        "inputs": [
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tool-types.schema.json#/$defs/RepoPath",
            "description": "The downstream instance root; omitted, every declaring instance in the checkout.",
            "required": false,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "staging",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tool-types.schema.json#/$defs/Flag",
            "description": "Mount for a staging preview: no signature or consent required.",
            "required": false,
            "arg": {
              "flag": "--staging"
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tool-types.schema.json#/$defs/Flag",
            "description": "Compare the disk against the lock; fetch nothing.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          },
          {
            "name": "noAgentSurface",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tool-types.schema.json#/$defs/Flag",
            "description": "Do not re-render `.claude/commands/` and the agent memory after a mount that changed the lock.",
            "required": false,
            "arg": {
              "flag": "--no-agent-surface"
            }
          },
          {
            "name": "noInstall",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tool-types.schema.json#/$defs/Flag",
            "description": "Lay the pinned bytes down without `bun install` in each mounted instance that carries a `package.json`. By default the install runs (`--production`; `--install-all` keeps devDependencies), so the mounted tools run; it writes only `node_modules/`, which no mount digest covers, so `--check` still passes.",
            "required": false,
            "arg": {
              "flag": "--no-install"
            }
          },
          {
            "name": "seed",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tool-types.schema.json#/$defs/MountSeed",
            "description": "`<name>=<owner/repo>@<40-char sha>`: create or re-pin that remote instance in `index.config.json` instead of mounting, writing its `trust.consent` for that pin in the same write (needs `consentBy` and `evidence`; repeatable; `--whole` mounts every tracked file).",
            "required": false,
            "arg": {
              "flag": "--seed"
            }
          },
          {
            "name": "consentBy",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tool-types.schema.json#/$defs/Login",
            "description": "With `seed`: who consented, as `consent.by`.",
            "required": false,
            "arg": {
              "flag": "--consent-by"
            }
          },
          {
            "name": "evidence",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-b/tool-types.schema.json#/$defs/Text",
            "description": "With `seed`: where the consent was given, readable (a session, an issue comment), as `consent.evidence`. On stdin because it is free prose: it quotes what was said.",
            "required": false,
            "arg": {
              "stdin": true
            }
          }
        ],
        "outputs": [
          {
            "name": "outcomes",
