      "@type": "bootstrap:Asset",
      "label": "vocabulary",
      "title": "bootstrap vocabulary",
      "description": "Every term bootstrap defines, in order, and every Graph Kind it defines, as RDF and SKOS — the document bootstrap's namespace resolves to. Generated from bootstrap's own terms by its toolset; each term links to the schema that defines it.",
      "source": "ns.jsonld",
      "isPartOf": "https://litlfred.github.io/folio-assistant/STAGING/claude-gifted-fermi-t8k217/bootstrap/bootstrap.jsonld"
