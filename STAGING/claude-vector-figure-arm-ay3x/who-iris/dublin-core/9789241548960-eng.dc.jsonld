  "dcterms:abstract": [
    {
      "@value": "This handbook provides comprehensive guidance on the planning, development, publication, implementation, adaptation and updating of WHO guidelines. Intended for WHO technical units, guideline developers, members of guideline development and external review groups, and other contributors, it describes the principles, methods and governance processes required to produce transparent, evidence-informed recommendations for clinical practice and public health policy that meet WHO standards.",
      "@language": "en"
    }
  ],
  "dcterms:tableOfContents": [
    {
      "@value": "Chapter 14: Strong recommendation when the evidence is low quality; Chapter 15: Using evidence from qualitative research to develop WHO guidelines; Chapter 16: decision-making for guideline development at WHO; Chapter 17: developing guideline recommendations for tests or diagnostic tools; Chapter 18: Incorporating a complexity perspective into WHO guidelines",
      "@language": "en"
    }
  ],
