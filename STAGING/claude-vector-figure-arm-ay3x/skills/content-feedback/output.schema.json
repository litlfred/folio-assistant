{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/claude-vector-figure-arm-ay3x/skills/content-feedback/output.schema.json",
  "title": "Content Feedback Output",
  "description": "Output schema for triaged feedback.",
  "type": "object",
  "required": [
    "triagedItems"
  ],
  "properties": {
    "triagedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "backlog",
              "next-sprint",
              "wont-fix",
              "duplicate",
              "needs-info"
            ]
          },
          "assignee": {
            "type": "string"
          },
          "linkedIssue": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "critical": {
          "type": "integer"
        },
        "major": {
          "type": "integer"
        },
        "minor": {
          "type": "integer"
        },
        "enhancement": {
          "type": "integer"
        }
      }
    }
  },
  "staging": {
    "branch": "claude/vector-figure-arm-ay3x",
    "sha": "18c69aa713cbe7f203ca9d94158f99132c5638c5",
    "pr": "1990/merge",
    "run": "37133953446"
  }
}
