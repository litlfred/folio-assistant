      "kind": "prose",
      "title": "Introduction to Profiles",
      "pageStart": 16,
      "pageEnd": 16,
      "target": "../sections/sec-015-introduction-to-profiles.md",
      "narrative": null,
      "content": "Profile is the term for a compliance point within the SPDX community across The Linux Foundation and OMG. The System\nPackage Data Exchange (SPDX) specification defines the following nine compliance points, defined as “Profiles”:\n• Core Profile\n• Software Profile\n• Security Profile\n• Licensing Profile\n• Dataset Profile\n• AI Profile\n• Build Profile\n• Lite Profile\n• Extension Profile\nThe Core Profile is mandatory. All others are optional.\n5.3",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "not-summarised"
      }
