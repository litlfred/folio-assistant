  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-content-finding",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-content-finding",
      "prefLabel": "Disputed review finding outcomes",
      "definition": "The answers an adjudicator may give when the editor and a reviewer, or two reviewers, disagree about one finding in a content change review.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/1073"
      },
      "changeNote": "bean bvuk; owner approved the answer set 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-content-finding/stands",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-content-finding",
      "notation": "stands",
      "prefLabel": "The finding stands",
      "definition": "The finding is right; the author addresses it before the change can be approved."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-content-finding/withdrawn",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-content-finding",
      "notation": "withdrawn",
      "prefLabel": "The finding is withdrawn",
      "definition": "The finding is wrong; the review comment closes as adjudicated, with the decision that closed it."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-criterion",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-criterion",
      "prefLabel": "Criterion adjudication outcomes",
      "definition": "The answers an adjudicator may give when a reviewer or author disagrees with ONE QA criterion's finding. Declared by Process_CriterionAdjudication; each code selects the work that follows it.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/1073"
      },
      "changeNote": "named by #1019 (bean 5vo9); moved to the QA-criterion specialisation by bean bvuk, 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-criterion/stands",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-criterion",
      "notation": "stands",
      "prefLabel": "The finding stands",
      "definition": "The criterion applies to this subject and its finding is right; the subject is what changes.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/1073"
      }
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-criterion/scope",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-criterion",
      "notation": "scope",
      "prefLabel": "The criterion does not apply here",
      "definition": "The criterion is scoped so it stops applying to subjects like this one: one edit to the criterion rather than repeated overrules on blocks it should never have covered."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-criterion/dispensation",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-criterion",
      "notation": "dispensation",
      "prefLabel": "It applies; this is an exception",
      "definition": "The rule applies and this subject is a stated exception. The dispensation carries its reason and lapses when the source changes, so it is scoped to the version it was granted for."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-materialized-conflict",
      "prefLabel": "Materialized-copy conflict outcomes",
      "definition": "The answers an adjudicator may give when a materialized copy changed both locally and upstream since it was fetched. Never a merge rule: which side wins depends on why the local edit was made.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/pull/1156"
      },
      "changeNote": "bean bvuk; the owner's own answer set and design, 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict/remote",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "notation": "remote",
      "prefLabel": "The remote wins",
      "definition": "Take the upstream version; the local copy is re-materialized from it (Task_Apply)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict/local",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "notation": "local",
      "prefLabel": "The local edit wins",
      "definition": "Keep the local edit AND re-pin, so the same settled question stops being asked on every refresh (Task_KeepLocal)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict/merge",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "notation": "merge",
      "prefLabel": "Neither whole — reconcile",
      "definition": "Reconcile the two by hand, then apply, so the five import gates see the hand-made artefact rather than being told about it (Task_Reconcile)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict/defer",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "notation": "defer",
      "prefLabel": "Not decidable today",
      "definition": "Decide nothing and do NOT re-pin — the only thing separating it from local. The conflict is recorded, because a deferral nobody wrote down is indistinguishable from a refresh that silently did nothing (Task_RecordConflict)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-requirement-set",
      "prefLabel": "Requirement-set sign-off outcomes",
      "definition": "The answers a signer may give when a requirements document (a requirement set, or one of its members) is put to them for sign-off. Declared by the requirement-set callers of Process_Adjudication — crdm-signoff.bpmn's BA_Signoff and crdm-close.bpmn's BA_Confirm — and by spec-kit's adjudicated status. Each answer is recorded as a `requirement-signoff` attestation before anything follows it.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/2405#issuecomment-6035207256"
      },
      "changeNote": "FR-013 of the RequirementSet amendment; approved by the owner 2026-10-07"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set/approve",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set",
      "notation": "approve",
      "prefLabel": "Approve",
      "definition": "The set (or member) is agreed as written. On the set, this moves it to `approved` — or, at close-out, to `accepted`."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set/amend",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set",
      "notation": "amend",
      "prefLabel": "Approve with amendments",
      "definition": "Agreed with the changes the reason states. The document is revised to carry them before any work starts on what changed."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set/reject",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set",
      "notation": "reject",
      "prefLabel": "Reject",
      "definition": "Not agreed. On the set, this moves it to `rejected`; the reason says why, so the next proposal does not repeat it."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set/defer",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set",
      "notation": "defer",
      "prefLabel": "Defer",
      "definition": "Neither agreed nor refused now. The set keeps its stage; the reason says what it waits on."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set/cancel",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-requirement-set",
      "notation": "cancel",
      "prefLabel": "Cancel",
      "definition": "The work is withdrawn. On the set, this moves it to `cancelled`, and a cancellation without a reason is refused by `check:requirements`."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-drift",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-translation-drift",
      "prefLabel": "Round-trip drift outcomes",
      "definition": "The answers an adjudicator may give on ONE passage round-trip QA flagged. All three are reasons recorded against the L1 completeness verdict, which Lane_0 owns; what differs is the obligation each creates.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/pull/1156"
      },
      "changeNote": "bean bvuk; the owner's own answer set and design, 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-drift/real",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-drift",
      "notation": "real",
      "prefLabel": "The drift is real",
      "definition": "The translation lost or changed the source's meaning, or used the wrong term; recorded as the reason against the completeness verdict."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-drift/spurious",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-drift",
      "notation": "spurious",
      "prefLabel": "False positive",
      "definition": "The two readings say the same thing. Recorded so the passage stops being re-flagged on every run."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-drift/source-wrong",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-drift",
      "notation": "source-wrong",
      "prefLabel": "The SOURCE is wrong",
      "definition": "The flag is right but the fault is in the source, not the translation. The one answer that sends work out of this process: re-translating a wrong source cannot produce a right target."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-passage",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-translation-passage",
      "prefLabel": "Flagged translation passage outcomes",
      "definition": "The answers a human reviewer may give on a passage the translation workflow's QA flagged.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/pull/1156"
      },
      "changeNote": "bean bvuk; the owner's own answer set and design, 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-passage/accept",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-passage",
      "notation": "accept",
      "prefLabel": "Accept as-is",
      "definition": "The flag was a false positive; the translation stands and the workflow writes an unofficial status."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-passage/edit",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-passage",
      "notation": "edit",
      "prefLabel": "Edit and re-run QA",
      "definition": "Correct the passage in place; Task_EditTranslation re-injects it, so QA re-runs over the corrected PO file rather than discarding a good translation wholesale."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-passage/retranslate",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#adjudication-translation-passage",
      "notation": "retranslate",
      "prefLabel": "Reject — re-translate",
      "definition": "Reject the translation and request a new one; it goes back to Task_Translate."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "@type": "skos:ConceptScheme",
      "notation": "concern-group",
      "prefLabel": "Concern groups",
      "definition": "The eight semantic concerns a subgraph is grouped by, inside every subgraph TYPOLOGY that groups at all (skills, processes, schemas, tests, library, uml): `<kind dir>/<group>/`. Owner, 2026-09-29: \"declared sub-graphs of cat-harness based on semantic concern … dont need a separate facet. built into location.\" Ruled 2026-09-30: eight groups (bean 9umr). A group id is SHARED: every instance and every kind uses these eight, the harness declares each group once from within the kind's own declaration file, and a higher instance's same-named directory is a named MEMBER of it (bean 1g4s, option A) — so a higher instance adds no group of its own. The vocabulary lives here ONCE, as a code list, so the declaration files name groups by code and restate nothing (placement proposal §1.1; AGENTS.md \"one fact, one place\"). Checked by `check:concern-groups`.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/1594"
      },
      "changeNote": "Bean folio-assistant-9umr, owner rulings 2026-09-29 and 2026-09-30; placement proposal §1.2 (bean folio-assistant-ejye, PR0)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group/sdlc",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "notation": "sdlc",
      "prefLabel": "Software delivery lifecycle",
      "definition": "How a change is planned, tracked, verified and shipped: the work plan (beans), branches, PRs, CI and gates, QA and adjudication, staging, and release."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group/process",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "notation": "process",
      "prefLabel": "Process model and execution",
      "definition": "How work is modelled and run: BPMN and DMN, roles and task authorization, workflow-engine state, and the methodologies a process adopts (RACI, CRDM, spec-kit, SWOT, Kepner-Tregoe, MADR)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group/tools",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "notation": "tools",
      "prefLabel": "Tools and MCP",
      "definition": "How a capability becomes a Tool node and an MCP service, and how that service is deployed and authenticated. A tool may describe its OWN specific subprocesses beside it, so a general skill is not bogged down by one tool's detail (owner, 2026-09-30)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group/kg",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "notation": "kg",
      "prefLabel": "Knowledge graph",
      "definition": "How the graph is declared, placed, read, restructured, exported and audited, including skill registration and placement."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group/library",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "notation": "library",
      "prefLabel": "Library and information management",
      "definition": "How a source is acquired, uploaded, described by metadata in the KG, and held in library/. The harness holds the basic flow; core holds the detailed methods."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group/content",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "notation": "content",
      "prefLabel": "Content authoring",
      "definition": "How content is authored, reviewed, validated and published, independent of content type (lifecycle, voice review, technical writing). Higher instances put their content-type packages here."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group/ui",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "notation": "ui",
      "prefLabel": "Rendering, UI and publication surfaces",
      "definition": "How the corpus is rendered, published and presented: the docs site, viewers, boards and themes."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group/conduct",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#concern-group",
      "notation": "conduct",
      "prefLabel": "Agent conduct",
      "definition": "How an agent behaves: interaction, confirmation, memory, reporting, swarms and security."
    },
    {
