      "@type": "skos:ConceptScheme",
      "notation": "own-namespaces",
      "prefLabel": "Namespaces this project mints",
      "definition": "Every namespace IRI folio-assistant mints for itself, with what each one names. Code reads the values from here (schemas/namespaces.ts); external-schemas:check fails on a spelling of ours that is not listed, and on a retired one still in use.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/1140"
      },
      "changeNote": "owner, 2026-09-23: code lists as nodes rather than constants in code"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#own-namespaces/cat-bootstrap",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-g196-measure-a/cat-harness-code-lists.jsonld#own-namespaces",
      "notation": "cat-bootstrap",
