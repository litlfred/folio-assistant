      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/kg-graph-export",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "kg-graph-export",
      "title": "Knowledge-graph export",
      "description": "Dump this instance's knowledge graph — skills, BPMN activities and their lanes, roles, actors, directories — to one JSON-LD document for publication. The export is data; something else draws it.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run kg:export"
      },
      "io": {
        "inputs": [
          {
            "name": "baseUrl",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Url",
            "description": "Publication base the node IRIs are minted against; a preview passes its own.",
            "required": false,
            "arg": {
              "flag": "--base-url"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where to write; defaults to `_kg/<stub>.jsonld`, which is build output and gitignored.",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          }
        ],
        "outputs": [
          {
            "name": "graph",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "The written JSON-LD document."
          },
