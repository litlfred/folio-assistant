      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "kg-validate",
      "title": "Validate a node in the graph",
      "description": "Check one file against the schema for its graph kind. ONE tool rather than one per schema: the declaration already says which directory holds which kind, so the kind is the parameter and the lookup does the rest.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run kg:validate"
      },
      "io": {
        "inputs": [
          {
            "name": "path",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "The node to check. Its graph kind is resolved from the declared directory that contains it.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "lenient",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Flag",
            "description": "Accept partial coverage knowingly: downgrade could-not-determine from an error to a warning.",
            "required": false,
            "arg": {
              "flag": "--lenient"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Text",
            "description": "One line per file — valid, invalid with the failing paths, or could-not-determine with the reason. Exit 0 valid, 1 invalid or undetermined, 2 misuse."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#skill/kg-navigation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#tool/kg-validate"
    },
