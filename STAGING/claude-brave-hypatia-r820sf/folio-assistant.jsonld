      "maintainsFrom": [
        "schemas/tool-types.ts"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#tool/tool-types-schema"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/log-message",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "log-message",
      "title": "Log a message to the discussion",
      "description": "Write a log line where the human actor will read it: the discussion you are already in. Takes the five required fields and the optional body, and renders them as one entry.",
      "install": {
        "none": true
      },
      "invoke": {
        "manual": true
      },
      "io": {
        "inputs": [
          {
            "name": "timestamp",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Timestamp",
            "description": "When it happened, as an ISO-8601 UTC instant.",
            "required": true
          },
          {
            "name": "actor",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Text",
            "description": "WHO acted. Never the Logger: it receives and records, so it cannot know.",
            "required": true
          },
          {
            "name": "process",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/ProcessId",
            "description": "The process the actor was inside, e.g. initialize-harness.",
            "required": true
          },
          {
            "name": "task",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/NodeId",
            "description": "The step within it, e.g. A_Install.",
            "required": true
          },
          {
            "name": "message",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Text",
            "description": "What happened, in the one line somebody scanning will read.",
            "required": true
          },
          {
            "name": "body",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Markdown",
            "description": "The detail — a diff, an error, what was not where it should have been.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "entry",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Markdown",
            "description": "The entry as posted."
          }
        ]
      },
      "requirements": {
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#skill/log-message"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#tool/log-message"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/content-graph-build",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "content-graph-build",
      "title": "Content graph",
      "description": "Build the content graph under a path and report its edges, separated into the EDITORIAL relation an author maintains and the FORMAL one derived from Lean. Reading the two as one number is how the editorial signal gets overwritten.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/content/pipeline/content-graph.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "targetPath",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "Content root to walk; defaults to the folio's `content/`.",
            "required": false,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Flag",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Text",
            "description": "Block count, then edge counts reported separately and never summed: EDITORIAL (`uses[]`, `interprets` — author-maintained) and FORMAL (derived from `lean.ref`). The formal line distinguishes `0` from `cache ABSENT`, so an unavailable formal graph cannot be read as a graph with no formal edges."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#skill/content-validate"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#tool/content-graph-build"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/content-manifest-validate",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "content-manifest-validate",
      "title": "Content manifest validation",
      "description": "Validate the block manifests under a path against their schemas. Exits 2 where no folio is present rather than reporting a clean run — the platform carries no content, and a validator that passes over nothing is how this one validated nothing for a while.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/content/pipeline/validate.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "targetPath",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "A paper or chapter directory; absent, every paper the folio declares.",
            "required": false,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "strict",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Flag",
            "description": "Treat warnings as errors.",
            "required": false,
            "arg": {
              "flag": "--strict"
            }
          }
        ],
        "outputs": [
          {
            "name": "issues",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Text",
            "description": "One line per issue, with its block and file. Exit 2 means NO FOLIO WAS FOUND — could-not-determine, never valid."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#skill/content-validate"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#tool/content-manifest-validate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/glossary-build",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "glossary-build",
      "title": "Glossary build",
      "description": "Build a paper's glossary index from its manifests and render the LaTeX. `--check` reports drift instead of writing, comparing everything except the `generated` timestamp so a re-run is not mistaken for a change.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/content/pipeline/build-glossary.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "targetPath",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "The paper directory, which must hold a `<paper>.ts` manifest. Absent, the command exits 2 with its usage — could-not-determine, not an empty glossary.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Flag",
            "description": "Report drift and write nothing.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "glossary",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "`glossary.json` beside the paper, and `chapters/glossary.tex` at the repo root."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#skill/document-intake"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#tool/glossary-build"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/fsh-cone",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "fsh-cone",
      "title": "FSH dependency cone",
      "description": "Compute the dependency cone over an IG's FSH graph, and the blast radius of a set of changed files. What makes an incremental IG build possible: without it, any edit rebuilds everything.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/content/pipeline/fsh-cone.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "igRoot",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "The IG root holding the FSH sources. Absent, the command exits 2 with its usage — could-not-determine, not an empty cone.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "csv",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "Write the report as CSV to this path instead of printing it.",
            "required": false,
            "arg": {
              "flag": "--csv"
            }
          },
          {
            "name": "top",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Count",
            "description": "Show only the N largest cones. `0` is a legitimate request for none, which is why `Count` admits zero.",
            "required": false,
            "arg": {
              "flag": "--top"
            }
          },
          {
            "name": "history",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Count",
            "description": "Report the blast radius over the last N commits instead of a static cone.",
            "required": false,
            "arg": {
              "flag": "--history"
            }
          }
        ],
        "outputs": [
          {
            "name": "cone",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Text",
            "description": "The cone, or the impact of `--changed`. With `--csv` it goes to that path instead."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#skill/fhir-validation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#tool/fsh-cone"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/translation-roundtrip-record",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "translation-roundtrip-record",
      "title": "Record a round-trip translation verdict",
      "description": "Write a back-translation verdict, produced by a pair of translation agents, into a block's existing translation-QA sidecar. It records a judgement rather than making one, and refuses where no sidecar exists — a round trip cannot be what decides a block is translated.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/content/pipeline/translation-roundtrip.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "payload",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "JSON carrying the block, locale, verdict and the agent pair. Absent, the command exits 2 with its usage — measured, not assumed.",
            "required": true,
            "arg": {
              "flag": "--payload"
            }
          }
        ],
        "outputs": [
          {
            "name": "sidecar",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "The `<block>.<locale>.translation-qa.json` written, under criterion `translation-semantic-roundtrip`. An AGENT entry replaces a previous agent entry — a re-run is a re-measurement of the same pair on the same text, not another line in a log — while a human ruling already recorded is kept, because this process does not supersede one."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#skill/translation-manager"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#tool/translation-roundtrip-record"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/l1-complete-check",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
      "name": "l1-complete-check",
      "title": "L1 source completeness",
      "description": "Is a `library/<bib-slug>/` entry complete as L1 source content? Each requirement is met, unmet, or NOT-DERIVABLE, so a document that cannot yield an artefact is distinguished from one that simply has not.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/scripts/check-l1-complete.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "targetPath",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/RepoPath",
            "description": "One `library/<bib-slug>/` entry. Absent, every entry the declared `library` graph holds.",
            "required": false,
            "arg": {
              "positional": 0
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/tool-types.schema.json#/$defs/Text",
            "description": "Per requirement: met, unmet, or `not-derivable` — the third distinguishes a document that CANNOT yield an artefact from one that simply has not. Exit 2 means no `library` graph is declared anywhere, which the script states as \"This is NOT a pass. Treat it as unknown.\""
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#skill/library-ingestion"
      ],
