    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#convention/no-clean-run-over-an-empty-set",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Convention",
      "localId": "no-clean-run-over-an-empty-set",
      "title": "A check that examined nothing does not report a pass",
      "description": "Every scan, filter or audit states what it looked at, so an empty result can be told from an empty subject.",
      "statement": "A check that found no files, no nodes or no candidates must say so and exit non-zero or `undetermined` — never 0 with a clean report. Assert a non-vacuity floor alongside the property itself.",
      "rationale": "Measured repeatedly in this repository: `check-declared-assets` reported 0 findings over 45 dead links; `check-agents-xref` printed a census of 0 where it had been 8, at exit 0; `bean-store-hygiene` asserted over an empty list; ruff reported a clean baseline over missing paths. The verified count of this defect in one session was eight.",
      "applies": [
        "typescript",
        "python",
        "workflow-yaml"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#convention/no-clean-run-over-an-empty-set"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#convention/comment-why-not-what",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Convention",
      "localId": "comment-why-not-what",
      "title": "A comment says WHY, and names the measurement",
      "description": "The convention this repository actually follows in code it keeps: a comment records the defect the line prevents and what was measured, not a restatement of the line.",
      "statement": "A comment explains why the code is as it is — the defect it prevents, the alternative that was tried, the number that was measured. Never a paraphrase of what the line already says.",
      "rationale": "This repository's own modules are unusually heavily commented and the comments earn it: `ci-gates.ts` records the 27-of-33 miscount that produced it, `known-skills.ts` records the silent drop. A comment restating the code goes stale invisibly, because nothing contradicts it; a comment naming a measurement can be checked and can be wrong out loud.",
      "applies": [
        "typescript",
        "python"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#convention/comment-why-not-what"
    },
