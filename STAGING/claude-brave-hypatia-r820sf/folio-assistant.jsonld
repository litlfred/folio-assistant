    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/deploy-access",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Capability",
      "localId": "deploy-access",
      "name": "Deployment Access",
      "description": "Credentials and configuration to deploy this instance — the OAuth client id/secret and cookie secret that deploy/.env holds. Probed by CONFIGURATION rather than by attempting a deployment, the same reading signing-api takes: a probe that tried to deploy would be indistinguishable from an outage, and would act on an external host just to answer a question about setup. The path is not invented — deploy/deploy.sh gates on exactly this file ([ ! -f \"$DEPLOY_DIR/.env\" ]) before it will run, so the probe agrees with the script it describes. Declared 2026-09-20, bean folio-assistant-q6ud: it was referenced by deployment-auth and declared by nothing, which executing the degradation model found on its first run.",
      "detection": {
        "method": "file-exists",
        "path": "cat-harness/deploy/.env"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#capability/deploy-access"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/ig-publisher",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Capability",
      "localId": "ig-publisher",
      "name": "FHIR IG Publisher",
      "description": "HL7 FHIR Implementation Guide Publisher for building and validating FHIR IGs.",
      "detection": {
        "method": "command",
        "command": "java -jar ${IG_PUBLISHER_JAR:-/opt/ig-publisher/publisher.jar} --version"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/java-runtime"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#capability/ig-publisher"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/latex-compiler",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Capability",
      "localId": "latex-compiler",
      "name": "LaTeX Compiler",
      "description": "Full LaTeX distribution with latexmk and biber for document compilation.",
      "detection": {
        "method": "command",
        "command": "latexmk --version"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#capability/latex-compiler"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/lean-mcp",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Capability",
      "localId": "lean-mcp",
      "name": "Lean MCP Server",
      "description": "MCP server providing Lean 4 diagnostics, proof state, and goal information. It does NOT require a local lean-toolchain: the Lean runs server-side and detection is an mcp-probe against the endpoint. It used to declare that requirement, which made it unavailable on any machine without a local Lean even when the server was reachable — and, because `lean-toolchain.fallbackTo` names this capability, made that fallback unable to fire at all (it was absent in exactly the case it existed for). Removed 2026-09-20, bean folio-assistant-sym3.",
      "detection": {
        "method": "mcp-probe",
        "endpoint": "lean-mcp",
        "healthPath": "/health"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#capability/lean-mcp"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/smart-base",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Capability",
      "localId": "smart-base",
      "name": "WHO SMART Guidelines smart-base toolchain",
      "description": "A checkout of WorldHealthOrganization/smart-base, whose input/scripts/ carries the DAK extractors, generators and XSLT transforms. Loaded from, never vendored: the scripts are invoked by the DAK repositories' own GitHub Actions, so smart-base stays their authoritative home and this platform depends on it rather than copying it. Resolved from SMART_BASE_HOME, defaulting to /opt/smart-base.",
      "detection": {
        "method": "command",
        "command": "test -f ${SMART_BASE_HOME:-/opt/smart-base}/input/scripts/extract_dak.py"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#capability/smart-base"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/docling",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Capability",
      "localId": "docling",
      "name": "Docling (layout-aware PDF parsing)",
      "description": "IBM's MIT-licensed document parser: layout analysis, TableFormer table structure, formula enrichment. Stage 3 of docs/proposals/rag-document-ingestion.md §10 — the ~20 documents pypdf cannot serve (7 no-TOC, 17 unsectioned, 7 likely-scanned) plus the WHO L1 guidelines, where boxed recommendations and GRADE tables are layout facts. IMPORTANT: `pip install docling` succeeds but a first parse fetches weights from huggingface.co, which returns `CONNECT tunnel failed, response 403` under organisation policy (re-measured 2026-08-26). So the import is NOT the capability, and this probe does not stop there: it passes when the weights are already cached locally, and otherwise falls back to a 5-second reachability check. A sandboxed session therefore reports ABSENT and a workstation with models downloaded passes offline and instantly. Run it where egress allows and commit the artefacts.",
      "detection": {
        "method": "command",
        "command": "python3 -c 'import docling' && { [ -d \"$HOME/.cache/docling/models\" ] || curl -sf --max-time 5 -o /dev/null https://huggingface.co; }"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#capability/docling"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/pymupdf",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Capability",
      "localId": "pymupdf",
      "name": "PyMuPDF (preferred PDF reader backend for pdf-structure.py)",
      "description": "Optional PDF reader backend for scripts/pdf-structure.py, preferred over pypdf when present. Its text layer is cleaner on math PDFs (fewer split words, correct accents, correct CJK where pypdf yields mojibake), and it reads the embedded outline directly via get_toc() rather than walking pypdf's outline object. pdf-structure.py auto-detects it and falls back to pypdf when absent, so it is never required. LICENCE: PyMuPDF is AGPL-3.0 (or commercial); the shipped Docker image installs pypdf (BSD-3-Clause), not PyMuPDF, so this stays an opt-in accelerator. Install: pip install pymupdf.",
      "detection": {
        "method": "command",
        "command": "python3 -c 'import pymupdf'"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/folio-assistant.jsonld#capability/pymupdf"
    },
    {
