    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-brave-hypatia-r820sf/folio-assistant.jsonld#tool/folio-init",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#Tool",
