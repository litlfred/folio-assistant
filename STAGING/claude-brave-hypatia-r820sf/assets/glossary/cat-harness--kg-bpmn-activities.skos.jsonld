      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_lifecycle.task_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
