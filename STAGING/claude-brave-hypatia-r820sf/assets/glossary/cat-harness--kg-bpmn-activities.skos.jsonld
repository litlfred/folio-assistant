        }
      ],
      "skos:definition": [
        {
          "@value": "NOT IMPLEMENTED. Tracked as a bean; see docs/document-ingestion.md."
        }
      ],
      "skos:notation": "Task_Audio",
      "dcterms:source": "cat-harness/processes/ingest-derive-content.bpmn#Task_Audio",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_derivecontent.task_image",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Narrative description per image, localized"
        }
      ],
      "skos:definition": [
        {
          "@value": "NOT IMPLEMENTED. Tracked as a bean; see docs/document-ingestion.md. Applies equally to an image EXTRACTED FROM A PDF, not only to an uploaded one."
        }
      ],
      "skos:notation": "Task_Image",
      "dcterms:source": "cat-harness/processes/ingest-derive-content.bpmn#Task_Image",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_derivecontent.task_provenance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cite the author of every narrative"
        }
      ],
      "skos:definition": [
        {
          "@value": "A generated description is a claim by someone. Record whether a human or an agent wrote it, and for an agent the model version. An uncited narrative is indistinguishable from a transcription of the source."
        }
      ],
      "skos:notation": "Task_Provenance",
      "dcterms:source": "cat-harness/processes/ingest-derive-content.bpmn#Task_Provenance",
      "skos:note": "candidate"
    },
    {
