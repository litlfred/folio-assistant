      },
      "skos:prefLabel": [
        {
          "@value": "Schema and constraint checks [content-validate]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Block schema, label prefixes, required fields, constraint rules."
        }
      ],
      "skos:notation": "Task_SchemaValidate",
      "dcterms:source": "cat-harness/processes/editing-hci-validation.bpmn#Task_SchemaValidate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_editing.task_smereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Human / SME review [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Escalated to a human reviewer or subject-matter expert when the change turns on clinical or scientific judgement."
        }
      ],
      "skos:notation": "Task_SmeReview",
      "dcterms:source": "cat-harness/processes/editing-hci-validation.bpmn#Task_SmeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_editing.task_syntaxspell",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Syntax, spelling and links [content-validate]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Syntax, spelling, cross-references, citation and link resolution."
        }
      ],
      "skos:notation": "Task_SyntaxSpell",
      "dcterms:source": "cat-harness/processes/editing-hci-validation.bpmn#Task_SyntaxSpell",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_appraisegrade",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Appraise and grade the body of evidence"
        }
      ],
      "skos:definition": [
        {
          "@value": "Certainty of evidence per the grading system the folio declares. The grade attaches to the BODY of evidence for one PICO question, not to an individual citation -- which is why this step is after the join and not inside the fan-out."
        }
      ],
      "skos:notation": "Task_AppraiseGrade",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_AppraiseGrade",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_attachevidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Attach the evidence to the recommendation [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The PICO, the graded body of evidence, each verified citation and its resolved authority record are written onto the recommendation block, so a reader can retrace the whole chain from the sentence back to the source."
        }
      ],
      "skos:notation": "Task_AttachEvidence",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_AttachEvidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_datarepos",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Query data repositories and statistical datasets"
        }
      ],
      "skos:definition": [
        {
          "@value": "Indicator and microdata sources. Distinct from the two above because the unit of evidence is a MEASUREMENT with a population, a period and a method, not a claim in prose."
        }
      ],
      "skos:notation": "Task_DataRepos",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_DataRepos",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_framepico",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Frame the question as PICO [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Population, Intervention, Comparator, Outcome. The PICO is what makes the search reproducible and the evidence auditable: without it, 'we looked for evidence' is not a claim anyone can check. WHO guideline development states the question this way before any retrieval."
        }
      ],
      "skos:notation": "Task_FramePico",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_FramePico",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_l1sources",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search trusted SOURCES — L1 [document-intake]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ingested primary literature under library/: the sections/*.md tree and, where a document was scanned, ocr/page-NNN.txt. NOTE the known blind spot — a document OCR'd but never re-run through pdf-structure.py has only a stub in sections/, so a sections-only search misses it."
        }
      ],
      "skos:notation": "Task_L1Sources",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_L1Sources",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_l2l3content",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search trusted CONTENT — L2 DAKs, L3 IGs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Already-adjudicated guidance: WHO SMART DAKs at L2 and FHIR Implementation Guides at L3. A recommendation adopted in a published DAK is evidence of a different kind from a primary study -- it is a prior decision, with its own provenance, and must be cited as that rather than laundered into primary evidence. NOT YET SKILL-BACKED. This step named `corpus-search`, which has never existed. It is not `corpus-grep`, whose job is the pre-declaration check that something really is an open gap — searching adjudicated L2/L3 content for evidence is a different task, so pointing the ref there would have been a plausible-looking wrong answer. Left uncovered until the skill is written."
        }
      ],
      "skos:notation": "Task_L2L3Content",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_L2L3Content",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_recordgap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the evidence gap [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Insufficient evidence is a RESULT. It is recorded as such -- an honest gap the guideline can state -- rather than being closed by weakening the recommendation until the available evidence supports it."
        }
      ],
      "skos:notation": "Task_RecordGap",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_RecordGap",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_recordunverified",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open a bean for the unverified citation [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "An unresolvable citation is not dropped and not silently kept. It becomes a tracked item, so the gap is visible in the work plan rather than surviving as a footnote nobody re-checks."
        }
      ],
      "skos:notation": "Task_RecordUnverified",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_RecordUnverified",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_reviewexisting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the guidance already in this content [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The author reads what the document, DAK or IG ALREADY says on this question, before looking outward. A recommendation that contradicts a sibling recommendation in the same artefact is a defect no external evidence will reveal."
        }
      ],
      "skos:notation": "Task_ReviewExisting",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_ReviewExisting",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_verifyauthority",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify authority against the observatory / registry API"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each candidate is resolved against the standard API of the body that publishes it, so that 'authoritative' is a RESOLVED FACT rather than an assertion in the citation. What is checked: that the identifier resolves at the publisher; that the retrieved record matches what the citation claims; that the version and date are the ones cited; and that the publisher is one this folio has declared trusted. STRAWPERSON: the concrete registry list and endpoints are not settled here -- see the cat-harness.processes:policy note."
        }
      ],
      "skos:notation": "Task_VerifyAuthority",
      "dcterms:source": "cat-harness/processes/evidence-retrieval.bpmn#Task_VerifyAuthority",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_extractstructure.task_candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract claim candidates"
        }
      ],
      "skos:definition": [
        {
          "@value": "candidates.json holds extracted theorems and definitions. Proposals only -- never adjudicated verdicts."
        }
      ],
      "skos:notation": "Task_Candidates",
      "dcterms:source": "cat-harness/processes/ingest-extract-structure.bpmn#Task_Candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_extractstructure.task_extracttext",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract the text layer"
        }
      ],
      "skos:definition": [
        {
          "@value": "The document has a text layer: extract it with pdf-extract (pdfminer.six, then a zero-dependency content-stream reader). Exit 2 means no text layer — a scan — and routes to OCR; it is not an empty document."
        }
      ],
      "skos:notation": "Task_ExtractText",
      "dcterms:source": "cat-harness/processes/ingest-extract-structure.bpmn#Task_ExtractText",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_extractstructure.task_ocr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "OCR to ocr/page-*.txt"
        }
      ],
      "skos:definition": [
        {
          "@value": "A document ingested this way keeps its text in ocr/ and only a stub in sections/, which the documented sections/ grep cannot see. That asymmetry is why the corpus-grep checklist has a fourth tier."
        }
      ],
      "skos:notation": "Task_Ocr",
      "dcterms:source": "cat-harness/processes/ingest-extract-structure.bpmn#Task_Ocr",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_extractstructure.task_sections",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Split into sections/*.md with doc_brief front-matter"
        }
      ],
      "skos:definition": [
        {
          "@value": "Contextual retrieval: a chunk in isolation loses what makes it mean anything, so each section carries the document brief."
        }
      ],
      "skos:notation": "Task_Sections",
      "dcterms:source": "cat-harness/processes/ingest-extract-structure.bpmn#Task_Sections",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_extractstructure.task_structure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write structure.json (TOC, page ranges, metadata)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write structure.json (pdf-structure/v1): doc id, TOC from the PDF outline or inferred from headings, page ranges, metadata, and source{} with the sha256 and a mimetype sniffed from the bytes, never the extension. A structure that could not be determined says so in structure_note rather than being rendered as one."
        }
      ],
      "skos:notation": "Task_Structure",
      "dcterms:source": "cat-harness/processes/ingest-extract-structure.bpmn#Task_Structure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.h_confirm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Repeat the slug, exactly, to confirm"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step in this process that is a person's. Repeating the slug is not ceremony: it names the artefact being confirmed, so a confirmation cannot be inherited by a later run pointed at a different preview."
        }
      ],
      "skos:notation": "H_Confirm",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#H_Confirm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the docs site Jekyll · TypeDoc · KG export"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build the preview from the PR's head: regenerate the generated docs, trim what this preview does not need, render the BPMN diagrams, then Jekyll, TypeDoc and the knowledge-graph export, with the staging banner and SEO identity claims stripped."
        }
      ],
      "skos:notation": "Task_Build",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_Build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment the preview URL on the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Post, or update in place, one comment on the PR giving the preview URL (STAGING/<slug>/) and the commit it was built from. Pull-request events only."
        }
      ],
      "skos:notation": "Task_Comment",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_deploy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish to STAGING/&lt;slug&gt;"
        }
      ],
      "skos:definition": [
        {
          "@value": "`keep_files: true` and a `destination_dir`, so this push adds one directory beside whatever else is on the branch. It is also RETRIED once: five other workflows push to `gh-pages` without joining this one's concurrency group, and a queue does not help because GitHub CANCELS a pending job when a newer one arrives for the same group rather than queueing it. Measured 2026-09-19: three staging runs from three different branches inside 17 seconds, two cancelled."
        }
      ],
      "skos:notation": "Task_Deploy",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_Deploy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_logrendered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `rendered` to the render log"
        }
      ],
      "skos:definition": [
        {
          "@value": "Its OWN commit, not part of the deploy. The publish action writes only into `destination_dir`, so an entry riding in `_site` would land at `STAGING/<slug>/_render-log/` — inside the directory a cleanup removes, which is the one place a record of the removal must not be. `continue-on-error`: a preview that deployed and whose entry did not is a gap in the record, not a failed deploy."
        }
      ],
      "skos:notation": "Task_LogRendered",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_LogRendered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_logretained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `retained`, with why it stays"
        }
      ],
      "skos:definition": [
        {
          "@value": "The event that makes the log worth reading. A removal was CONSIDERED and refused; without an entry that leaves no trace on the branch at all, and the next person asking *\"why is this preview still up\"* has only a comment on a pull request that may itself be closed."
        }
      ],
      "skos:notation": "Task_LogRetained",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_LogRetained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_notice",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the retention notice on the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Removal was not confirmed, so the preview stays: post a retention notice on the PR giving its URL and saying it has NOT been removed, and the two ways to remove it: the staging:cleanup label while the PR is open, or, once it is closed, a Run workflow dispatch with cleanup_slug and a matching cleanup_confirm."
        }
      ],
      "skos:notation": "Task_Notice",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_Notice",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_preflight",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-evaluate liveness AT REMOVAL TIME"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-evaluated AT REMOVAL TIME, through the same `previewLiveness` the health sweep uses rather than a second implementation of it. The sweep runs daily and proposes; this acts. Between them a branch can come back to life — bean `w2g5` documents exactly that, a session reusing one branch across five successive pull requests."
        }
      ],
      "skos:notation": "Task_Preflight",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_Preflight",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_remove",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove the preview AND append `removed` — one commit"
        }
      ],
      "skos:definition": [
        {
          "@value": "ONE COMMIT for the removal and its record. A separate log push can fail on its own and leave a preview that vanished with nothing saying why — which is the exact state bean `plj1` left the branch in. `render-log.ts` refuses a `removed` entry with no reason, so this step fails loudly rather than writing a record that says an artefact went and not why."
        }
      ],
      "skos:notation": "Task_Remove",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_Remove",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_removedisp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove it AND append `removed` — one commit"
        }
      ],
      "skos:definition": [
        {
          "@value": "Say what is going — size and file count — then remove STAGING/<slug>/ and append `removed` to the render log in the SAME commit, so a preview cannot vanish without a record of who dispatched it and why. The slug is a dispatch input, so the tool re-checks it by value rather than trusting the guard."
        }
      ],
      "skos:notation": "Task_RemoveDisp",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_RemoveDisp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_slug",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Derive the slug from the head ref"
        }
      ],
      "skos:definition": [
        {
          "@value": "Derive the slug from the PR's head ref: every character outside [a-zA-Z0-9._-] becomes '-', runs of '-' collapse, and leading or trailing '-' is trimmed. It must be one safe path segment, checked by value."
        }
      ],
      "skos:notation": "Task_Slug",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_Slug",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_featurestaging.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the slug's SHAPE and that the confirmation repeats it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Guarded three ways because a dispatch input is a DELETION TRIGGER. `workflow_dispatch` is available only to an actor with write access; the slug must match exactly the characters the sed pipeline can produce, with `.` and `..` refused by name; and the confirmation must repeat the slug, so a confirmation cannot be carried over from an earlier run against a different preview."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "cat-harness/processes/feature-staging.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_askintent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose from the offered options"
        }
      ],
      "skos:definition": [
        {
          "@value": "The question is presented as a short list of selectable options, never as free prose, and the list names the top-level content types the agent knows about. The answer becomes the statedIntent fact and the table is evaluated again — the user's answer is read as evidence, like any other fact."
        }
      ],
      "skos:notation": "Task_AskIntent",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_AskIntent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_confirmimport",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import what, where, and who does it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three questions the scan cannot answer: import these or not; library or content for each group; leave the files where they are or reorganize to declutter. Plus whether to dispatch one ingestion agent or a small swarm. Non-relaxable: nobody's files are moved or imported on inference."
        }
      ],
      "skos:notation": "Task_ConfirmImport",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_ConfirmImport",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_createrepo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create the repository"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only on the new-repo branch, and only after the user has named it. An empty working directory is scaffolded in place instead."
        }
      ],
      "skos:notation": "Task_CreateRepo",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_CreateRepo",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_detectmodality",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect the interaction modality"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before the first question is asked, establish HOW to ask it: audio, ordinary chat, selectable options for a user with limited hand function, large-type for low vision. A user who finds the questions unusable never reaches the rest of this diagram."
        }
      ],
      "skos:notation": "Task_DetectModality",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_DetectModality",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_pagesbootstrap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Start the Pages build and derive the URL"
        }
      ],
      "skos:definition": [
        {
          "@value": "scripts/pages-bootstrap.ts: derive the site URL from the git remote or <name>.config.json, report whether a publish workflow exists, and optionally probe until the site answers."
        }
      ],
      "skos:notation": "Task_PagesBootstrap",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_PagesBootstrap",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_readfacts",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the repository facts"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mechanical, read-only: does a `<name>.config.json` declare a contentType, does the working tree hold somebody's existing project, and what has the user actually said. These are the three inputs to folio-intent.dmn. Non-relaxable: scaffolding without looking first is how a folio gets written over somebody's project."
        }
      ],
      "skos:notation": "Task_ReadFacts",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_ReadFacts",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_reportpending",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Say where it will be"
        }
      ],
      "skos:definition": [
        {
          "@value": "A measured 404. The author is told the address and that the first build has not landed there yet — which is useful, and is not the same as being told it is live."
        }
      ],
      "skos:notation": "Task_ReportPending",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_ReportPending",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_reportunknown",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Say it could not be confirmed"
        }
      ],
      "skos:definition": [
        {
          "@value": "No URL, no probe, or a failed request. Reported as \"could not check\", never as \"not yet\" and never as \"live\"."
        }
      ],
      "skos:notation": "Task_ReportUnknown",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_ReportUnknown",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_reporturl",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand over the live link"
        }
      ],
      "skos:definition": [
        {
          "@value": "Confirmed live. The link is given as a link, and the author is told what is on it."
        }
      ],
      "skos:notation": "Task_ReportUrl",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_ReportUrl",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_scaffold",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scaffold the folio (folio_init)"
        }
      ],
      "skos:definition": [
        {
          "@value": "content/, uploads/, library/, the first manifests, <slug>.json and <slug>.config.json, the builder shim, AGENTS.md with its stubs, .mcp.json, the session-start hook and the beans store. Refuses rather than overwrites when a folio is already present."
        }
      ],
      "skos:notation": "Task_Scaffold",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_Scaffold",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_scanrepo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the repo for content worth importing"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read-only. Classifies candidates into library/ (external source) and content/ (authored here), and reports what it could not classify as its own bucket rather than forcing every file into one of the two."
        }
      ],
      "skos:notation": "Task_ScanRepo",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_ScanRepo",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_seedplan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the work plan"
        }
      ],
      "skos:definition": [
        {
          "@value": "The first beans: what the author said they want to get started on, one bean per top-level content object they named."
        }
      ],
      "skos:notation": "Task_SeedPlan",
      "dcterms:source": "cat-harness/processes/getting-started.bpmn#Task_SeedPlan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step no package may relax. A repository cut changes the substrate every other diagram's lanes bind to, and that is a person's decision."
        }
      ],
      "skos:notation": "Task_Authorise",
      "dcterms:source": "cat-harness/processes/graph-detanglement.bpmn#Task_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief the topic before&#10;touching anything"
        }
      ],
      "skos:definition": [
        {
          "@value": "What am I doing and why is it worth doing; what do I already know, with each measurement's provenance; how do I plan to do it and WHAT WOULD FALSIFY THE APPROACH. A falsifier that never fires is decoration &#8212; this practice's own fired, took edges 5 to 12, and rewrote the plan."
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/graph-detanglement.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "1 &#183; Declare in place&#10;(nothing moves)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `<name>.json` entry with its `graphs[]` kinds. A sub-graph that owns its own layout gains a NESTED declaration whose paths resolve against its own directory, so the whole graph relocates by moving one folder."
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/processes/graph-detanglement.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "4 &#183; Extract &#8212; a directory move,&#10;not a file-by-file sift"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once edges are zero and the declaration stands alone: move the sub-graph out as one directory move, not a file-by-file sift. Its nested declaration resolves paths against its own directory, so moving the folder moves the graph. The five-point gate is in migration-plan.md Phase II."
        }
      ],
      "skos:notation": "Task_Extract",
      "dcterms:source": "cat-harness/processes/graph-detanglement.bpmn#Task_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_isolate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "3 &#183; Isolate &#8212; own declaration,&#10;namespace, artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once cross-edges measure zero: give the sub-graph its own declaration, its own namespace and its own published artefact, as bootstrap/ has (its own declaration, bs: namespace and graph document). Nothing moves yet; the sub-graph now stands alone in place."
        }
      ],
      "skos:notation": "Task_Isolate",
      "dcterms:source": "cat-harness/processes/graph-detanglement.bpmn#Task_Isolate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2a &#183; Measure &#8212; unassigned&#10;column FIRST"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run check:partition`. Read the unassigned column before the edge count, and quote BOTH numbers rather than only the one that improved. The count rising when the measurement improves is correct: 43 to 49 when thirteen previously-unjudged edges were folded in."
        }
      ],
      "skos:notation": "Task_Measure",
      "dcterms:source": "cat-harness/processes/graph-detanglement.bpmn#Task_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2b &#183; Prune, merge, factor&#10;&#8212; or the classification is wrong"
        }
      ],
      "skos:definition": [
        {
          "@value": "The only four moves. Move the shared TARGET first and the importers after; check the target's layer before the importer's; a schema moves with its script. The fix is never an exemption, it is the right owner."
        }
      ],
      "skos:notation": "Task_Move",
      "dcterms:source": "cat-harness/processes/graph-detanglement.bpmn#Task_Move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what would move&#10;&#8212; sizes, and what breaks"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports and waits. `deletion-requires-confirmation` is not a courtesy to waive: an agent never removes or relocates a durable artefact on its own initiative."
        }
      ],
      "skos:notation": "Task_Propose",
      "dcterms:source": "cat-harness/processes/graph-detanglement.bpmn#Task_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_appenddisclaimer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append WHO disclaimer (if DAK)"
        }
      ],
      "skos:definition": [
        {
          "@value": "For WHO SMART Guidelines content, automatically appends the WHO legal disclaimer: - Translation not created by WHO - English edition is authoritative original - WHO not responsible for translation accuracy Only applies when folio contentType includes WHO/DAK content."
        }
      ],
      "skos:notation": "Task_AppendDisclaimer",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_AppendDisclaimer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_assigntranslator",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Assign to qualified human translator"
        }
      ],
      "skos:definition": [
        {
          "@value": "The coordinator assigns the translation to a qualified translator, ideally a domain SME for the content area. For WHO content, the translator should be familiar with WHO SMART Guidelines terminology. The assignment includes: - The .pot file(s) from extraction - The domain glossary - Context notes (block kind, chapter, content area) - The deadline"
        }
      ],
      "skos:notation": "Task_AssignTranslator",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_AssignTranslator",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_checkcompleteness",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check translation completeness"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify that all msgid entries have msgstr translations. Partial translations are acceptable for initial submissions but must be flagged for follow-up. The coordinator checks: - % of strings translated - Any fuzzy-flagged entries - Missing critical sections"
        }
      ],
      "skos:notation": "Task_CheckCompleteness",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_CheckCompleteness",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_extractpot",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract POT (translatable strings)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Pre-processes source markdown: 1. Segments prose by paragraph 2. Shields non-translatable content (math, code, labels) as placeholders 3. Normalizes whitespace 4. Extracts metadata (titles, alt text, captions) Produces .pot file(s) at the configured granularity. Tool: translation_extract MCP tool"
        }
      ],
      "skos:notation": "Task_ExtractPOT",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_ExtractPOT",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_identifycontent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify content and target locale"
        }
      ],
      "skos:definition": [
        {
          "@value": "The coordinator selects: - Which content nodes need translation (block, section, chapter, or folio) - The target locale (one of the supportedLocales in <name>.config.json) - The priority and deadline"
        }
      ],
      "skos:notation": "Task_IdentifyContent",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_IdentifyContent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_injectpo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject PO → translated Markdown"
        }
      ],
      "skos:definition": [
        {
          "@value": "Post-processes the completed .po file: 1. Substitutes msgstr for msgid in source markdown 2. Unshields placeholder tokens back to original content 3. Validates structural integrity (paragraph count, heading levels) 4. Validates completeness (flags empty msgstr) 5. Runs linting (doubled punctuation, orphaned placeholders) Tool: translation_inject MCP tool"
        }
      ],
      "skos:notation": "Task_InjectPO",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_InjectPO",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_prepareglossary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare domain glossary"
        }
      ],
      "skos:definition": [
        {
          "@value": "Generates or retrieves the domain glossary for the target locale. Sources: 1. Root folio's translations/ glossary 2. Folio-assistant dependency translations (depth-first walk) 3. WHO standard terminology (from smart-base) 4. Previous translations of related content"
        }
      ],
      "skos:notation": "Task_PrepareGlossary",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_PrepareGlossary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_receiveassignment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Receive assignment and materials"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator receives: - .pot file with source strings (msgid) - Domain glossary with approved term translations - Context notes per string - Style guide and WHO terminology references Tools: Poedit, Weblate, Crowdin, or direct .po editing."
        }
      ],
      "skos:notation": "Task_ReceiveAssignment",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_ReceiveAssignment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_requestmorework",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Request completion of remaining strings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Return to the translator with a list of untranslated or fuzzy strings that need attention."
        }
      ],
      "skos:notation": "Task_RequestMoreWork",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_RequestMoreWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_returnforcorrection",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Return for correction with annotations"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer annotates specific passages that need correction and returns to the translator with detailed feedback. Each annotation includes: - The passage in question - What is wrong (terminology, meaning, style) - The suggested correction or reference"
        }
      ],
      "skos:notation": "Task_ReturnForCorrection",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_ReturnForCorrection",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean: folio-assistant-ktt2 Back-translates target-language .md to source language and compares meaning. Distinguishes semantic drift from terminology misses. Tool: translation_validate MCP tool No gateway follows: drift or clean, the translation goes to Task_SMEReview with the findings attached. Which of two readings is right is a human call (translation-manager, \"route drift to a human reviewer\"), and every translation in this workflow is reviewed and signed off anyway, so a clean result is evidence for the reviewer and never a way around them."
        }
      ],
      "skos:notation": "Task_RoundTripQA",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_RoundTripQA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off translation as official"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer signs off the translation, making it official. This records: - signedOffBy: the reviewer's identity - signedOffAt: the current timestamp - sourceHash: SHA-256 of the source .md - level: block | section | chapter | folio Tool: translation_signoff MCP tool"
        }
      ],
      "skos:notation": "Task_Signoff",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_smereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review translation for accuracy"
        }
      ],
      "skos:definition": [
        {
          "@value": "A subject-matter expert reviews the injected translated markdown for: - Clinical/technical accuracy of terminology - Preservation of meaning from the source - Cultural appropriateness for the target locale - Consistency with the domain glossary For WHO content: the SME verifies that normative statements (\"SHALL\", \"SHOULD\", \"MAY\") are translated with the correct force in the target language."
        }
      ],
      "skos:notation": "Task_SMEReview",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_SMEReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_submitpo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Submit completed .po file"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator submits the completed .po file back to the pipeline. This may happen via: - Git commit + push - Weblate/Crowdin sync - File upload to the coordinator"
        }
      ],
      "skos:notation": "Task_SubmitPO",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_SubmitPO",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_translateintool",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate strings in preferred tool"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator works through each msgid, producing msgstr translations. They: - Follow the domain glossary for technical terms - Preserve placeholder tokens ({1}, {2}) in position - Mark uncertain translations as #fuzzy - Note any source ambiguities for the coordinator"
        }
      ],
      "skos:notation": "Task_TranslateInTool",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_TranslateInTool",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_humantranslation.task_writestatus",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (official)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Writes translations/<locale>/status.json with the official sign-off metadata and source hash for staleness detection."
        }
      ],
      "skos:notation": "Task_WriteStatus",
      "dcterms:source": "cat-harness/processes/human-translation-workflow.bpmn#Task_WriteStatus",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_checkout",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Restricted checkout of the backward cone"
        }
      ],
      "skos:definition": [
        {
          "@value": "git sparse-checkout of the cone's files plus sushi-config.yaml, ig.ini and the alias files — a median of three files, p90 eleven, on smart-immunizations."
        }
      ],
      "skos:notation": "Task_Checkout",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_Checkout",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_cone",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compute the cone of the change (fsh-cone --changed)"
        }
      ],
      "skos:definition": [
        {
          "@value": "content/pipeline/fsh-cone.ts over the changed files: the forward cone is what to rebuild, the backward cone is what to check out."
        }
      ],
      "skos:notation": "Task_Cone",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_Cone",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_conereport",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the cone report on the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review path: the reviewer sees what this change rebuilds — how many artefacts, and whether a hub (a shared RuleSet, CQL library or value set) is touched — before the build finishes. On main it is a log line."
        }
      ],
      "skos:notation": "Task_ConeReport",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_ConeReport",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_contextload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Load or reuse the warm context (fhir_context_load)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The validator's server mode holds the loaded dependency packages, snapshots and expansions in its session cache. Cold start loads the restored derived FHIR rather than regenerating it."
        }
      ],
      "skos:notation": "Task_ContextLoad",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_ContextLoad",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_deploy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy the site [content-publish] [ig-publication]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Deploy the site built from main or a release. Deploying is release-management, after a human authorised the release — an agent never records that authorisation. Report the published URL only once it answers: a returned deploy is not a serving site."
        }
      ],
      "skos:notation": "Task_Deploy",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_Deploy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_deploypreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy the preview site [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "A preview never seeds the shared cache."
        }
      ],
      "skos:notation": "Task_DeployPreview",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_DeployPreview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_fullbuild",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Full publisher build [ig-publication]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Exit 1 or 3 from restore: the whole IG is built as today. Its outputs become the records the next seed writes."
        }
      ],
      "skos:notation": "Task_FullBuild",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_FullBuild",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_index",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Rebuild the meta-index (ig_metaindex_rebuild)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The whole-IG aggregates only — artifacts, TOC, canonicals, expansions, package, QA aggregate. Never re-derives an artefact: a missing record is a miss (exit 1), not a silent rebuild."
        }
      ],
      "skos:notation": "Task_Index",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_Index",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_logenverror",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log the environment error on the bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Exit 2 from restore: the cache store or the toolchain could not be reached. Record that on the change's bean, with the restore output, so the work plan says the build did not run and why. Check before creating — beans create is not idempotent."
        }
      ],
      "skos:notation": "Task_LogEnvError",
      "dcterms:source": "cat-harness/processes/ig-incremental-build.bpmn#Task_LogEnvError",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_igincremental.task_logfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log findings on the bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Validation failed: record the findings on the change's bean, so the work plan says what blocks it. Check before creating — beans create is not idempotent."
        }
      ],
      "skos:notation": "Task_LogFindings",
