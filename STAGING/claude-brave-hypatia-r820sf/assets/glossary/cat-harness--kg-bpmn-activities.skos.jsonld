    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_editing.task_logfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log findings on the bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings are appended to the bean, so the next agent or human sees what is outstanding."
        }
      ],
      "skos:notation": "Task_LogFindings",
      "dcterms:source": "cat-harness/processes/editing-hci-validation.bpmn#Task_LogFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_editing.task_recorddecision",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the decision and its audit note [decision-audit]"
        }
      ],
      "skos:definition": [
        {
          "@value": "A decision is an act ABOUT the findings, not a finding. Record the outcome, every finding it weighed, every finding it overrules — and an audit note saying why it was made, or why a finding in it was left. Each note cites corpus evidence: a witness, another finding, a QA report, a block, a file range. An overruled mechanical finding stays on the record; a gate whose findings vanish when somebody disagrees with them cannot be audited. An agent may assemble the citations and is recorded as `proposed_by`; the author is whoever decided."
        }
      ],
      "skos:notation": "Task_RecordDecision",
      "dcterms:source": "cat-harness/processes/editing-hci-validation.bpmn#Task_RecordDecision",
      "skos:note": "candidate"
    },
