      },
      "skos:prefLabel": [
        {
          "@value": "Agent review of the change [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "A review agent judges what no checker can: accuracy, voice, exposition, whether the change says what the editor meant."
        }
      ],
      "skos:notation": "Task_AgentReview",
      "dcterms:source": "cat-harness/processes/editing-hci-validation.bpmn#Task_AgentReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_editing.task_buildgates",
