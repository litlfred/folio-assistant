    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_lifecycle.task_retire",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retire or archive [content-retire]"
        }
      ],
      "skos:definition": [
        {
          "@value": "No more content is planned: deprecate the folio. Post a deprecation notice and timeline, update its status metadata, archive it, point references at any successor, and remove it from active publication. The programme manager decides; retirement archives rather than deletes."
        }
      ],
      "skos:notation": "Task_Retire",
      "dcterms:source": "cat-harness/processes/content-lifecycle.bpmn#Task_Retire",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_lifecycle.task_seedbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the work plan [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The plan becomes beans. From here on, beans/ is the shared answer to 'what is done, what is next' — for humans and agents alike."
        }
      ],
      "skos:notation": "Task_SeedBeans",
      "dcterms:source": "cat-harness/processes/content-lifecycle.bpmn#Task_SeedBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_lifecycle.task_test",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Integration test and QA sweep [content-test]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Corpus-wide checks that a single-block gate cannot make: cross-references, build green, proof status, QA axes across the whole folio."
        }
      ],
      "skos:notation": "Task_Test",
      "dcterms:source": "cat-harness/processes/content-lifecycle.bpmn#Task_Test",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_copyright",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "COPYRIGHT per bitstream, and for the derived work"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the licence permits for THIS bitstream, and separately whether it permits the derivation. LICENSE-CONTENT.md exists in this repository and the ingestion pipeline does not read it."
        }
      ],
      "skos:notation": "Task_Copyright",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_Copyright",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the node `materialized`"
        }
      ],
      "skos:definition": [
        {
          "@value": "The node's state moves from `referenced` to `materialized`, carrying purpose, localPath, gates and (archival) fixity. There is NO default state: a node that has not said is invalid, because 'the author did not say' and 'the author said they could not tell' are different facts."
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_enumerate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "ENUMERATE + SUBSET against the source descriptor"
        }
      ],
      "skos:definition": [
        {
          "@value": "Resolve the request against the source's descriptor (large-datasets/schemas/source-descriptor.ts, one file per source under large-datasets/sources/) BEFORE any gate. Three things come from it and none may be guessed. (1) Which subset strategies the source supports — supportsSubset(). (2) Whether a subset stands on its own: when subsetIsSelfContained is false (mathlib), the request is closed over its dependencies here, and every gate after this one is asked about the CLOSURE, because a subset that omits what its members depend on is not a smaller corpus, it is one that does not build. (3) What enumerating the whole costs — enumerationCost(), which is undefined when the descriptor has no measured denominator; SIZE then refuses rather than estimates. A source with no descriptor is not an error here: it is an unknown, and SIZE refuses on it. Bean w5bn: the descriptor is CALLED here rather than restated."
        }
      ],
      "skos:notation": "Task_Enumerate",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_Enumerate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_fetch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch, and record fixity"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch, then record sha256 and byte count. Fixity is REQUIRED for an archival copy: an archive that cannot demonstrate it is unchanged is a copy, and it cannot be re-fetched to check, because the thing it would be re-fetched from is what it exists to survive. The data already exists — every structure.json carries sha256 and bytes, and nothing reads them as fixity."
        }
      ],
      "skos:notation": "Task_Fetch",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_Fetch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_purpose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the purpose: working or archival"
        }
      ],
      "skos:definition": [
        {
          "@value": "working or archival, and it is asked FIRST because three of the five gates mean different things under each. An archival copy keeps the original bytes, never expires, requires fixity, and is the only thing that discharges sourceLoss; a working copy keeps derived content and discharges none of that. A process that gated first and asked afterwards would be judging a copy whose obligations it did not yet know."
        }
      ],
      "skos:notation": "Task_Purpose",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_Purpose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_restrictions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "RESTRICTIONS unknown is an answer, not a green light"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner's phrase is 'no restrictions known in context', and that is a STATE, not a green light. GateVerdict is three-valued for this reason alone, and `unknown` is never rendered as `permitted`."
        }
      ],
      "skos:notation": "Task_Restrictions",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_Restrictions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_retention",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "RETENTION what expires this copy"
        }
      ],
      "skos:definition": [
        {
          "@value": "A copy with no expiry cannot be told from an abandoned one — the same argument bean-blocking makes about a block with no expiry. An ARCHIVAL copy is the exception and it is a specification rather than an omission: freshness() reports it `permanent`, not `no-expiry`."
        }
      ],
      "skos:notation": "Task_Retention",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_Retention",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_size",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SIZE what fraction, and what the whole would cost"
        }
      ],
      "skos:definition": [
        {
          "@value": "What is being taken, and what the whole collection would cost. REFUSES when it cannot tell: 'three items' with no denominator is not a size answer. 0.7 TB is the measured reason the IRIS import is by reference."
        }
      ],
      "skos:notation": "Task_Size",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_Size",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_sourceloss",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SOURCE LOSS what survives if the origin goes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Not hypothetical. The one IRIS record this repository holds carries a handle on iris.wpro.who.int, a regional instance merged into the global one. Only an ARCHIVAL copy of the original bytes discharges this; a working copy cannot, because the derived sections are not the publication."
        }
      ],
      "skos:notation": "Task_SourceLoss",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_SourceLoss",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_materializeremote.task_stayref",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it `referenced`, record why"
        }
      ],
      "skos:definition": [
        {
          "@value": "A refusal is not a failure of the process — it is the process working. The node stays `referenced`, which means the graph still knows it exists and where, and the refusing gate's basis is recorded so the next caller does not re-litigate it."
        }
      ],
      "skos:notation": "Task_StayRef",
      "dcterms:source": "cat-harness/processes/materialize-remote.bpmn#Task_StayRef",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_integrate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Integrate: call existing processes"
        }
      ],
      "skos:definition": [
        {
          "@value": "The method's steps become a process whose judgement points call the processes that already exist (adjudication, options analysis, review) by calledElement. Nothing is re-implemented. A needed change to an existing process becomes a bean against its owner."
        }
      ],
      "skos:notation": "A_Integrate",
      "dcterms:source": "cat-harness/processes/methodology-from-source.bpmn#A_Integrate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_origin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish origin and licence"
        }
      ],
      "skos:definition": [
        {
          "@value": "Authors, publication, identifier, and the licence the source itself states. No stated licence means reference only: headings, page ranges and a summary in our own words; the file stays in uploads/ (git-ignored) pinned by checksum. A method with no origin is a house process; write a skill instead."
        }
      ],
      "skos:notation": "A_Origin",
      "dcterms:source": "cat-harness/processes/methodology-from-source.bpmn#A_Origin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_place",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place by ownership; declare the directory"
        }
      ],
      "skos:definition": [
        {
          "@value": "A domain-neutral method belongs to the harness and a domain method to the folio that owns the domain. If the session cannot write where it belongs, draft it where it can, say so in the file, and open a bean to move it."
        }
      ],
      "skos:notation": "A_Place",
      "dcterms:source": "cat-harness/processes/methodology-from-source.bpmn#A_Place",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render the method: adopted vs refused"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the source says, section by section, then a table of what this platform adopts and what it refuses, each with a reason. Extensions beyond the source (such as web plus mobile where the paper studied mobile) are stated as ours. Reported results are not imported as facts."
        }
      ],
      "skos:notation": "A_Render",
      "dcterms:source": "cat-harness/processes/methodology-from-source.bpmn#A_Render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_tools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Every skill and tool used becomes a Tool"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each script, CLI or checker the process relies on gets a Tool node in cat-harness/tools/index.ts that satisfies a named skill, validated by folio-assistant's ToolDefinitionSchema."
        }
      ],
      "skos:notation": "A_Tools",
      "dcterms:source": "cat-harness/processes/methodology-from-source.bpmn#A_Tools",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.call_ingest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ingest into library/"
        }
      ],
      "skos:definition": [
        {
          "@value": "folio-assistant's document ingestion, choosing the rung mechanically (embedded outline, pages, OCR). Section text is written only when the licence allows it."
        }
      ],
      "skos:notation": "Call_Ingest",
      "dcterms:source": "cat-harness/processes/methodology-from-source.bpmn#Call_Ingest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.call_relatedwork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Related work: find, sort, ask"
        }
      ],
      "skos:definition": [
        {
          "@value": "Search beans, issues and open PRs for work the method touches, categorize and summarize them, and ask the owner whether and how to coordinate. CRDM calls the same sub-process."
        }
      ],
      "skos:notation": "Call_RelatedWork",
      "dcterms:source": "cat-harness/processes/methodology-from-source.bpmn#Call_RelatedWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.o_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the adoption"
        }
      ],
      "skos:notation": "O_Review",
      "dcterms:source": "cat-harness/processes/methodology-from-source.bpmn#O_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativecodereview.a_attest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Attest the pair, with a reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "The prose holds: record it with `bun run pairs:attest -- --sidecar … --by agent|human --reason \"…\"`, naming what was compared. The attestation moves the pair's baseline to the current hashes, so the staleness flag clears and stays cleared until the code moves again."
        }
      ],
      "skos:notation": "A_Attest",
      "dcterms:source": "cat-harness/processes/narrative-code-review.bpmn#A_Attest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativecodereview.a_raisefinding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise a finding against the wrong side"
        }
      ],
      "skos:definition": [
        {
          "@value": "The prose and the code really disagree: raise a finding that names which side is wrong and why. Usually the prose, because the code is what runs — but a skill can state intended behaviour correctly while the code has regressed, and then the finding is against the code."
        }
      ],
      "skos:notation": "A_RaiseFinding",
      "dcterms:source": "cat-harness/processes/narrative-code-review.bpmn#A_RaiseFinding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativecodereview.a_readpairfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the pair checks' findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the subject's kg-qa sidecar and list what is open: a failing prose-reviewed-since-code-changed (code moved, prose did not), and every false or undetermined claim from prose-claims-resolve — `bun run pairs:claims` prints the full list, including what it did not check. Claims that hold and pairs that are not stale need nothing."
        }
      ],
      "skos:notation": "A_ReadPairFindings",
      "dcterms:source": "cat-harness/processes/narrative-code-review.bpmn#A_ReadPairFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativecodereview.a_reread",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-read the prose against the code"
        }
      ],
      "skos:definition": [
        {
          "@value": "For each open item, read the prose claim beside the code it describes and decide what is true. For a stale pair, read what changed in the code and whether the prose still describes it. For an undetermined claim, say whether it points at something real outside this repository. For a false claim, check the checker's reading before trusting it."
        }
      ],
      "skos:notation": "A_ReRead",
      "dcterms:source": "cat-harness/processes/narrative-code-review.bpmn#A_ReRead",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativecodereview.call_adjudication",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate against the checker"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer and a checker read the same claim differently — a disagreement about ONE kg-qa criterion (prose-claims-resolve). Descend into Process_CriterionAdjudication, which runs the shared adjudication and then one of its three outcomes: the checker's finding stands, the criterion is scoped, or a dispensation is granted with its reason. The checker's entry is kept beneath the verdict rather than overwritten (requirement R4 of issue #1042)."
        }
      ],
      "skos:notation": "Call_Adjudication",
      "dcterms:source": "cat-harness/processes/narrative-code-review.bpmn#Call_Adjudication",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativereview.call_voiceoverlay",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Voice overlay review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_VoiceReview for whichever named voices the folio has ACTIVATED — the WHO editorial style, the guideline-development register, the publication design conventions, the Milnor exposition standard. No new role is taken on: register is what this lane already judges, and a voice is a register. Placed after the base voice adjudication because a voice OVERLAYS the house voice rather than replacing it, so the house finding has to be settled first. Its own first gateway leaves immediately when no voice is active, which is this instance's case and the default everywhere."
        }
      ],
      "skos:notation": "Call_VoiceOverlay",
      "dcterms:source": "cat-harness/processes/review-narrative.bpmn#Call_VoiceOverlay",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativereview.task_adjudicatevoice",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the voice findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three outcomes, all legitimate: the register is wrong for this genre; the criterion does not belong in this genre and should carry `profiles`; or the block is a stated exception and a reviewer entry records why."
        }
      ],
      "skos:notation": "Task_AdjudicateVoice",
      "dcterms:source": "cat-harness/processes/review-narrative.bpmn#Task_AdjudicateVoice",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativereview.task_readfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the sidecar findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the block's `.qa.json`, not just the evidence line: register is a property of the passage, and the sidecar quotes one line of it."
        }
      ],
      "skos:notation": "Task_ReadFindings",
      "dcterms:source": "cat-harness/processes/review-narrative.bpmn#Task_ReadFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativereview.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record findings as advice"
        }
      ],
      "skos:definition": [
        {
          "@value": "A reviewer cannot accept a change — that is the editor's lane — so the output is findings on the sidecar, not a commit."
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "cat-harness/processes/review-narrative.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativereview.task_reviewtranslation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the translation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Coverage, preserved terms and echoes are mechanical. A semantic round trip needs a back-translator that has not seen the original; where none has run, the criterion carries no verdict and that is the honest state."
        }
      ],
      "skos:notation": "Task_ReviewTranslation",
      "dcterms:source": "cat-harness/processes/review-narrative.bpmn#Task_ReviewTranslation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_narrativereview.task_reviewuses",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the editorial dependencies"
        }
      ],
      "skos:definition": [
        {
          "@value": "`uses[]` is what a READER must have read to follow the block — never populated from the formal dependency graph."
        }
      ],
      "skos:notation": "Task_ReviewUses",
      "dcterms:source": "cat-harness/processes/review-narrative.bpmn#Task_ReviewUses",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Apply it, and state each option's trade-offs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Follow the selected methodology as written — adopted whole, not blended with another. At least two real options: one option is not a choice, and a straw option is worse than a short list because it makes the analysis look thorough while narrowing it. Never quantify the comparison to make it look measured. Where a method scores and sums, this platform takes the structure and refuses the arithmetic: the weights are invented and a total reads as a measurement."
        }
      ],
      "skos:notation": "A_Apply",
      "dcterms:source": "cat-harness/processes/options-analysis.bpmn#A_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_checkevidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the selected methodology's evidence base"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before applying a methodology, establish that the thing being applied is what it claims to be. A methodology is adopted because it is somebody else's named, external work; this step checks that the `origin` it cites resolves to a source in a declared library, and reads the `methodology-evidence` QA sidecar for it. WHY THE CHECK IS HERE AND NOT AT ADOPTION. Adoption happens once; selection happens every time a decision is made. A source that was reachable when the methodology was adopted can stop being so, and a methodology adopted before this axis existed was never checked at all. Measured 2026-09-22: six methodologies cited an origin and NONE had that source in any library, so every selection made until then rested on an unverifiable citation. WHAT A GAP DOES AND DOES NOT DO. A missing source does NOT block the decision, and this step has no branch that stops the process — that would make a documentation gap into an outage, and the owner decides whether an unbacked methodology may still be used. It does two things: it runs `literature-search` to try to close the gap, and it puts the evidence state into the record `A_Record` writes, so a reader can tell a decision made on a verified method from one made on a citation nobody could follow. The third state is the one that matters. \"Source ingested\", \"source located but unreachable from here\" and \"no source found\" are three different facts, and `literature-search` exists largely to stop the middle one being reported as the last."
        }
      ],
      "skos:notation": "A_CheckEvidence",
      "dcterms:source": "cat-harness/processes/options-analysis.bpmn#A_CheckEvidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_frame",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Frame the decision and check the trigger"
        }
      ],
      "skos:definition": [
        {
          "@value": "One sentence naming the KIND of thing being chosen, not the options — \"which cache strategy\", never \"A or B\". Then the trigger: is this irreversible, or would the answer surprise someone? If neither, say so and stop; the calling step decides without this subprocess. Stopping here is a correct outcome, not a skipped step."
        }
      ],
      "skos:notation": "A_Frame",
      "dcterms:source": "cat-harness/processes/options-analysis.bpmn#A_Frame",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the recommendation AND the rejected options"
        }
      ],
      "skos:definition": [
        {
          "@value": "The rejected options and why they lost are part of the output, not an appendix. A rejected option with no record is a dead end nobody marked, and the next agent walks into it — the same argument `bean-coordination` makes for `scrapped` over deleted. In a bean context the form is MADR's. Which methodology was followed is named here, so a reader can check the method rather than take the conclusion."
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/options-analysis.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_select",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Select the methodology by context"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask the selection question in order, first yes decides: do the criteria RECUR with the same inputs having to produce the same answer; is this the CERTAINTY of a body of evidence behind a recommendation; is the context a BEAN recording a decision; otherwise a one-off choice among candidates. If none fits, that is a finding — say which question the decision is and that no adopted methodology covers it. Do not improvise one and do not stretch the nearest fit. The declared set is the contents of the `methodology` graph. Ask for it; do not remember it."
        }
      ],
      "skos:notation": "A_Select",
      "dcterms:source": "cat-harness/processes/options-analysis.bpmn#A_Select",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_authorblocks",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "4 · Author blocks [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every block edit runs the HCI validation gate — see editing-hci-validation.bpmn."
        }
      ],
      "skos:notation": "Task_AuthorBlocks",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_AuthorBlocks",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_formalize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "5 · Formalise in Lean [lean-formalization]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Give each formal block (definition, theorem, lemma, proposition, corollary, conjecture, proof) a .lean sibling that Lean 4 accepts, in the order lean-formalization sets out. A compiling declaration is not a formalised claim: check vacuity and narrative drift before calling it done, and record the status with proof-verification."
        }
      ],
      "skos:notation": "Task_Formalize",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_Formalize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "1 · Plan the paper [content-plan]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scope the paper: chapters, the blocks each needs, what gets formalised."
        }
      ],
      "skos:notation": "Task_Plan",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_Plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "9 · Publish [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "See draft-to-publication.bpmn for the review and release path this expands into."
        }
      ],
      "skos:notation": "Task_Publish",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_Publish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "7 · Render PDF / HTML [latex-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Typeset the paper through LaTeX to PDF and HTML. Run latex_preflight first — missing packages, fonts or engine — rather than discovering them twenty minutes in. The preamble, class and macros belong to the folio, never to the platform."
        }
      ],
      "skos:notation": "Task_Render",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_Render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "8 · Review and feedback [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review the rendered paper, not a description of it, and record the feedback. The outcome is iterate — back to authoring — or approved for the publication path."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_scaffold",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "3 · Scaffold the folio repo [content-plan]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the folio repository with `bun run init-folio` (or the folio_init tool): content/, the document, chapter and first block manifests, the builder shim, AGENTS.md, .mcp.json, the session-start hook and the beans store, with the platform linked rather than copied."
        }
      ],
      "skos:notation": "Task_Scaffold",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_Scaffold",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_seedplan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2 · Seed the work plan [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The plan becomes beans, so a resumed session or a sibling agent can pick it up."
        }
      ],
      "skos:notation": "Task_SeedPlan",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_SeedPlan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_paperauthoring.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "6 · Validate [content-validate]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run content validation over the folio: schemas, the content profile (formal kinds only in a paper), cross-block consistency and that the Lean builds. Loop back rather than rendering over a failure."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "cat-harness/processes/authoring-a-paper.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the&#10;tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clean: close the open pr-no-checks issue, if any, saying why (every open pull request's head now has a CI run). Runs only on a clean verdict — on unknown the issue is left untouched and the job fails instead, because could-not-check is never rendered as clean."
        }
      ],
      "skos:notation": "Task_Close",
      "dcterms:source": "cat-harness/processes/pr-checks-present.bpmn#Task_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment ONCE per&#10;(PR, head sha)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Comment on each affected open PR once per (PR, head sha): a hidden marker carrying the sha is checked first, so a re-run on the same head stays silent and a new push can be reported again. A PR that is no longer open is skipped."
        }
      ],
      "skos:notation": "Task_Comment",
      "dcterms:source": "cat-harness/processes/pr-checks-present.bpmn#Task_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the tracking&#10;label exists"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the pr-no-checks label with --force so it exists before either issue path runs — the close path filters on it too, and on a repository that has never had a finding it would not exist yet. Skipped on an unknown verdict."
        }
      ],
      "skos:notation": "Task_Label",
      "dcterms:source": "cat-harness/processes/pr-checks-present.bpmn#Task_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_sweep",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask, per open PR, whether its&#10;HEAD has a run &#8212; skipping&#10;heads younger than 15 min"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run check:prs-have-runs --min-age-minutes 15, writing the report file first. A head younger than 15 minutes legitimately has no run yet and is skipped. Exit 0 clean, 1 findings, 2 could not determine; an exit 1 with no report file is a crash and is treated as could-not-determine."
        }
      ],
      "skos:notation": "Task_Sweep",
      "dcterms:source": "cat-harness/processes/pr-checks-present.bpmn#Task_Sweep",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_track",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one&#10;tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings: EDIT the one open issue labelled pr-no-checks if there is one, otherwise create it, with the sweep's report as the body. One issue edited in place, never a new issue or a comment per run, so the tracking issue never becomes a feed."
        }
      ],
      "skos:notation": "Task_Track",
      "dcterms:source": "cat-harness/processes/pr-checks-present.bpmn#Task_Track",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.callactivity_editing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Editing and HCI validation [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The editing sub-process. Every change to the corpus goes through its HCI validation gate — a red draft is fixed there, never by patching the built artifact."
        }
      ],
      "skos:notation": "CallActivity_Editing",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#CallActivity_Editing",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_authorizerelease",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the release [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Publication requires authorisation by the programme manager or designated authority."
        }
      ],
      "skos:notation": "Task_AuthorizeRelease",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_AuthorizeRelease",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_builddraft",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the draft publication [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render the corpus into the draft form of the folio: PDF, HTML site, or FHIR IG."
        }
      ],
      "skos:notation": "Task_BuildDraft",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_BuildDraft",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_circulatedraft",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Circulate the draft [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The draft publication is circulated to the review team for formal review."
        }
      ],
      "skos:notation": "Task_CirculateDraft",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_CirculateDraft",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_closereleasebeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the release beans [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "What shipped is resolved; what slipped stays open and carries into the next cycle."
        }
      ],
      "skos:notation": "Task_CloseReleaseBeans",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_CloseReleaseBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_openchangebeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open beans for the change requests [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each requested change becomes a bean, so the editors and agents picking the work up next see exactly what review asked for and what is still open."
        }
      ],
      "skos:notation": "Task_OpenChangeBeans",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_OpenChangeBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_openreleasebean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or claim the release bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The release itself is a bean: it carries what is in this draft, what is outstanding, and who is holding it."
        }
      ],
      "skos:notation": "Task_OpenReleaseBean",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_OpenReleaseBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_publicationqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run publication QA gates [content-test]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Publication-readiness QA across layers — QC reports, IG Publisher QA, proof status, broken links, build warnings."
        }
      ],
      "skos:notation": "Task_PublicationQa",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_PublicationQa",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_publishrelease",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Version, tag and publish [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Version bump, release notes, tag, build the final artifacts, deploy to the publication platform."
        }
      ],
      "skos:notation": "Task_PublishRelease",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_PublishRelease",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_reviewdraft",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the draft publication [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Content reviewer, QC reviewer and technical officer review the draft as a whole — coherence, phase-gate criteria, breaking vs non-breaking change."
        }
      ],
      "skos:notation": "Task_ReviewDraft",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_ReviewDraft",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publication.task_smesignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Clinical / scientific sign-off [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Domain sign-off: clinical SMEs for a guideline, subject-matter reviewers for a paper."
        }
      ],
      "skos:notation": "Task_SmeSignoff",
      "dcterms:source": "cat-harness/processes/draft-to-publication.bpmn#Task_SmeSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publishalert.a_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment on the open issue, naming the step"
        }
      ],
      "skos:definition": [
        {
          "@value": "Add this failure to the open issue as a comment (which notifies), and refresh the body to the latest state."
        }
      ],
      "skos:notation": "A_Comment",
      "dcterms:source": "cat-harness/processes/publish-alert.bpmn#A_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publishalert.a_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the publication-manager label"
        }
      ],
      "skos:definition": [
        {
          "@value": "The alert is a tracking issue labelled `publication-manager` — the role, not a person, because no actor declares a GitHub account for it. Whoever watches that label is alerted."
        }
      ],
      "skos:notation": "A_Label",
      "dcterms:source": "cat-harness/processes/publish-alert.bpmn#A_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publishalert.a_open",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the tracking issue, naming the failed step"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the issue with the step that failed, the run link and — for a verification failure — the verifier report."
        }
      ],
      "skos:notation": "A_Open",
      "dcterms:source": "cat-harness/processes/publish-alert.bpmn#A_Open",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publishalert.u_triage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Triage the failure: hold or fix forward"
        }
      ],
      "skos:definition": [
        {
          "@value": "The publication manager reads what failed and decides: hold the release, or fix forward and publish again. Nothing was deployed on a failure before the deploy; a failure after it (the deploy itself, or the previews lost) is live, and says so. The next successful publish closes the issue."
        }
      ],
      "skos:notation": "U_Triage",
      "dcterms:source": "cat-harness/processes/publish-alert.bpmn#U_Triage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_publishverification.a_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run every verifier over the export"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the verifier set (scripts/publish-verify.ts, `bun run publish:verify -- --dir <site>`) over the built tree. A SET: each verifier is one entry, and adding one changes nothing else. The first is JSON-LD expansion under a real processor, network refused — a property the context does not declare, a relative IRI or a context that will not load is a finding. Only documents of OURS are verified; third-party data in the tree is counted and cannot block."
        }
      ],
      "skos:notation": "A_Verify",
      "dcterms:source": "cat-harness/processes/publish-verification.bpmn#A_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_apisign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign over the API"
        }
      ],
      "skos:definition": [
        {
          "@value": "The attestation service signs the run hashes. Reached only from the one table row that has both egress and a configured endpoint."
        }
      ],
      "skos:notation": "Task_ApiSign",
      "dcterms:source": "cat-harness/processes/qa-report-signing.bpmn#Task_ApiSign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_buildrun",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the test run [folio-test-run/v1]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assemble the run record the signature will cover: the data hash and the process hash, each all-or-nothing. An UNKNOWN_HASH never reproduces another unknown, so a run that could not be hashed is signable only as what it is — unverifiable."
        }
      ],
      "skos:notation": "Task_BuildRun",
      "dcterms:source": "cat-harness/processes/qa-report-signing.bpmn#Task_BuildRun",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_humansign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign as release authority"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person attests the run hashes out of band. This is a userTask, not a serviceTask, and the distinction is enforced: `fulfilmentKindsForBpmnType` will not let a system actor fill it, which is what stops the air-gapped route quietly becoming another machine route."
        }
      ],
      "skos:notation": "Task_HumanSign",
      "dcterms:source": "cat-harness/processes/qa-report-signing.bpmn#Task_HumanSign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_recordattestation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record which route signed it"
        }
      ],
      "skos:definition": [
        {
          "@value": "The attestation records the route, not only the signature. A reader who cannot tell an API signature from a human one cannot tell which trust assumption they are relying on."
        }
      ],
      "skos:notation": "Task_RecordAttestation",
      "dcterms:source": "cat-harness/processes/qa-report-signing.bpmn#Task_RecordAttestation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_resolvereach",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the performer's reach [effectiveReach + signing-api probe]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compute the two facts the gateway reads: effectiveReach(deployment, actor) from schemas/actor-reach.ts, and whether the signing-api capability is configured. Undeclared reach resolves to \"unknown\" rather than to the deployment's value — an aggregate does not determine a member."
        }
      ],
      "skos:notation": "Task_ResolveReach",
      "dcterms:source": "cat-harness/processes/qa-report-signing.bpmn#Task_ResolveReach",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the conflict"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human or agentic decision, never a merge rule. Which side wins depends on why the local edit was made, and a process that picked automatically would be choosing without the one fact that decides it."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/processes/refresh-materialized.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-materialize, re-asking the five gates — and record the new fixity"
        }
      ],
      "skos:definition": [
        {
          "@value": "The gates are re-asked, not inherited: a licence can change, and a collection can grow past the size a caller agreed to. AND THE NEW FIXITY IS RECORDED IN THE SAME CHANGE. This step rewrites bytes that a materialization record describes, so leaving the old digest behind would make a CORRECT run of this process fail check:materialized-fixity as a mismatch — the gate reading \"somebody edited held content without saying so\" about the one process whose job is to replace it. Measured 2026-09-22 (bean 10s1): this task named no fixity write at all. This is the owner's publication exception, stated as a rule rather than as a carve-out. The exception is NOT \"these actors may skip the rule\"; it is \"say what you did\". A writer that updates the digest alongside the bytes passes, and the record then describes what is actually there. A writer that does not fails, correctly, because it has forked upstream silently. A list of permitted writers would go stale the first time somebody added a sixth one; this does not."
        }
      ],
      "skos:notation": "Task_Apply",
      "dcterms:source": "cat-harness/processes/refresh-materialized.bpmn#Task_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_fixity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "ARCHIVAL verify fixity — never re-fetch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-compute the digest and compare. An archive is NEVER re-fetched — the source is what it exists to survive, so replacing it with today's version discards the state it was keeping. A mismatch means OUR copy rotted, and the remedy is restoration from a backup, not re-download."
        }
      ],
      "skos:notation": "Task_Fixity",
      "dcterms:source": "cat-harness/processes/refresh-materialized.bpmn#Task_Fixity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_keeplocal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep the local edit, and re-pin so it stops being asked"
        }
      ],
      "skos:definition": [
        {
          "@value": "The local edit wins, so nothing is re-materialized — and the pin moves to the upstream revision that was compared against. Re-pinning is the half that is easy to forget and is the reason this is a step rather than an absence: without it the same upstream change is detected as new on every cycle, and a contributor is asked the same settled question for ever. The record says the copy is deliberately divergent FROM a named revision, which is a different claim from being stale against an unknown one."
        }
      ],
      "skos:notation": "Task_KeepLocal",
      "dcterms:source": "cat-harness/processes/refresh-materialized.bpmn#Task_KeepLocal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_local",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "What changed LOCALLY since"
        }
      ],
      "skos:definition": [
        {
          "@value": "The half nothing answers today. A materialized copy that was edited in place is not a copy any more, and overwriting it silently destroys work whose existence the process never established."
        }
      ],
      "skos:notation": "Task_Local",
      "dcterms:source": "cat-harness/processes/refresh-materialized.bpmn#Task_Local",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_reconcile",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Reconcile the two by hand"
        }
      ],
      "skos:definition": [
        {
          "@value": "Neither side wins whole: the contributor produces content that is neither the local copy nor the remote one, and THEN it is applied. Drawn as a separate step before Task_Apply rather than folded into it, because Task_Apply re-asks the five import gates against what is being materialized — and what is being materialized here is a hand-made artefact, which is exactly the case those gates should see rather than be told about."
        }
      ],
      "skos:notation": "Task_Reconcile",
      "dcterms:source": "cat-harness/processes/refresh-materialized.bpmn#Task_Reconcile",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_recordconflict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the conflict, decide nothing, and do NOT re-pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both copies stay and the conflict is written down with what each side says. Deliberately does not re-pin, which is the one thing separating it from Task_KeepLocal: the question is unresolved, so it must be asked again next cycle. Recording is not optional here for the reason A_RecordEntry is not optional in an adjudication — a judgement nobody wrote down is indistinguishable from a check that never ran, and a DEFERRAL nobody wrote down is indistinguishable from a refresh that silently did nothing."
        }
      ],
      "skos:notation": "Task_RecordConflict",
      "dcterms:source": "cat-harness/processes/refresh-materialized.bpmn#Task_RecordConflict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_upstream",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "WORKING what changed upstream"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compare the recorded upstreamVersion against the source. `could not reach the source` is a THIRD answer and is never reported as `unchanged` — an unreachable source is the sourceLoss gate firing late."
        }
      ],
      "skos:notation": "Task_Upstream",
      "dcterms:source": "cat-harness/processes/refresh-materialized.bpmn#Task_Upstream",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_relatedwork.a_categorize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Categorize and summarize"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each hit gets a category (overlaps: coordinate; affected by; out of scope; unrelated) and a one-line summary with its state. Judgement, not a keyword score: say why each is in its category."
        }
      ],
      "skos:notation": "A_Categorize",
      "dcterms:source": "cat-harness/processes/related-work.bpmn#A_Categorize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_relatedwork.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record and act on the answer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the chosen coordination where it will be found: bean links (--blocked-by, --parent), a line in the issue or PR body, or 'note only'. A declined coordination is recorded too."
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/related-work.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_relatedwork.a_searchbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search beans for relevance"
        }
      ],
      "skos:definition": [
        {
          "@value": "beans list --json / beans query over titles AND bodies, open and recently completed. A completed bean is evidence of a decision already made."
        }
      ],
      "skos:notation": "A_SearchBeans",
      "dcterms:source": "cat-harness/processes/related-work.bpmn#A_SearchBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_relatedwork.a_searchissues",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search issues and open PRs"
        }
      ],
      "skos:definition": [
        {
          "@value": "The repository's issues (open and closed) and its open pull requests. An open PR touching the same files is the collision most worth finding early."
        }
      ],
      "skos:notation": "A_SearchIssues",
      "dcterms:source": "cat-harness/processes/related-work.bpmn#A_SearchIssues",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_relatedwork.u_coordinate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Coordinate? How?"
        }
      ],
      "skos:notation": "U_Coordinate",
      "dcterms:source": "cat-harness/processes/related-work.bpmn#U_Coordinate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_renderlog.a_logremoved",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `removed` with the reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "BEFORE the removal, not after: a job that dies mid-step must leave a record of the intent rather than an artefact that vanished with no entry. A reason is REQUIRED — an entry saying an artefact went and not why is the ambiguity this log exists to prevent."
        }
      ],
      "skos:notation": "A_LogRemoved",
      "dcterms:source": "cat-harness/processes/staging-render-log.bpmn#A_LogRemoved",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_renderlog.a_logrendered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `rendered`"
        }
      ],
      "skos:definition": [
        {
          "@value": "A re-deploy is a rendering, so it gets its own entry rather than overwriting the last. \"When was this last built\" is then answerable without diffing commits."
        }
      ],
      "skos:notation": "A_LogRendered",
      "dcterms:source": "cat-harness/processes/staging-render-log.bpmn#A_LogRendered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_renderlog.a_logrestored",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `restored`"
        }
      ],
      "skos:definition": [
        {
          "@value": "A full-replace deploy (`docs-site.yml`, the only publisher without keep_files) wipes the branch; `restore-staging` carries the previews AND this log back in. Its own event rather than a second `rendered`, because \"somebody pushed this branch\" and \"an unrelated merge nearly deleted it\" are different facts — and bean `plj1` is what happens when the second is invisible."
        }
      ],
      "skos:notation": "A_LogRestored",
      "dcterms:source": "cat-harness/processes/staging-render-log.bpmn#A_LogRestored",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_renderlog.a_logretained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `retained` with the reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE ENTRY THAT MAKES THE LOG WORTH READING. A preview still standing because a signal fired leaves no trace otherwise, and the next person asking \"why is this still up\" has nothing to consult. A reason is REQUIRED — the tool refuses without one."
        }
      ],
      "skos:notation": "A_LogRetained",
      "dcterms:source": "cat-harness/processes/staging-render-log.bpmn#A_LogRetained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_renderlog.a_preflight",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Preflight: is the preview live?"
        }
      ],
      "skos:definition": [
        {
          "@value": "`previewLiveness` — a disjunction over open-pr, unmerged-branch and recent-commit, shared with the health sweep so the two cannot disagree. Bean `w2g5`: a preview whose pull request is closed is NOT an abandoned one."
        }
      ],
      "skos:notation": "A_Preflight",
      "dcterms:source": "cat-harness/processes/staging-render-log.bpmn#A_Preflight",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_renderlog.a_remove",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove the artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "`rm -rf STAGING/<slug>`. Cannot reach the log, which lives outside STAGING/ — structural rather than guarded, because a branch named to collide with a directory under STAGING/ slugifies to exactly that name and git permits the ref."
        }
      ],
      "skos:notation": "A_Remove",
      "dcterms:source": "cat-harness/processes/staging-render-log.bpmn#A_Remove",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_repohealth.task_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the health checks,&#10;keeping the report either way"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run bun run health --out and upload the JSON report whatever the verdict — on unknown it is the only evidence of why the sweep went blind. Exit 0 clean, 1 gating findings, 2 could not check; exit 1 with no report is a crash. The checks report and never act: every finding names something a person does."
        }
      ],
      "skos:notation": "Task_Check",
      "dcterms:source": "cat-harness/processes/repository-health-watch.bpmn#Task_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_repohealth.task_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the&#10;tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clean: close the open repo-health issue, if any, saying why (every check ran and none had anything to report). Runs only on a clean verdict — on unknown the issue is left untouched and the job fails instead, because could-not-check is never rendered as clean."
        }
      ],
      "skos:notation": "Task_Close",
      "dcterms:source": "cat-harness/processes/repository-health-watch.bpmn#Task_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_repohealth.task_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the tracking&#10;label exists"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the repo-health label with --force so it exists before either issue path runs — the close path filters on it too, and on a repository that has never had a finding it would not exist yet. Skipped on an unknown verdict."
        }
      ],
      "skos:notation": "Task_Label",
      "dcterms:source": "cat-harness/processes/repository-health-watch.bpmn#Task_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_repohealth.task_track",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one&#10;tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings: EDIT the one open issue labelled repo-health if there is one, otherwise create it, with the report as the body. One issue edited in place, never a new issue or a comment per run, so the tracking issue never becomes a feed. The body states that nothing in it has been acted on."
        }
      ],
      "skos:notation": "Task_Track",
      "dcterms:source": "cat-harness/processes/repository-health-watch.bpmn#Task_Track",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_review.call_codereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Code node review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_CodeReview. The actor takes on the `code-reviewer` lane for this call path only."
        }
      ],
      "skos:notation": "Call_CodeReview",
      "dcterms:source": "cat-harness/processes/review-task.bpmn#Call_CodeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_review.call_narrativecodereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prose and the code it describes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_NarrativeCodeReview: judge what the pair checks could not settle (a stale pair, a false or undetermined claim), and send a disagreement with a checker to adjudication. Issue #1042, stage C."
        }
      ],
      "skos:notation": "Call_NarrativeCodeReview",
      "dcterms:source": "cat-harness/processes/review-task.bpmn#Call_NarrativeCodeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_review.call_narrativereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Narrative review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_NarrativeReview. The actor takes on the `narrative-reviewer` lane for this call path only."
        }
      ],
      "skos:notation": "Call_NarrativeReview",
      "dcterms:source": "cat-harness/processes/review-task.bpmn#Call_NarrativeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_review.task_classifychange",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Classify what changed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Prose, code nodes, or both. This is the only decision the generic lane makes on its own: everything after it is made inside a subprocess by the role that lane binds."
        }
      ],
      "skos:notation": "Task_ClassifyChange",
      "dcterms:source": "cat-harness/processes/review-task.bpmn#Task_ClassifyChange",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_review.task_consolidate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Consolidate findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "One report from however many subprocesses ran. Findings are advice: a reviewer cannot accept the change."
        }
      ],
      "skos:notation": "Task_Consolidate",
      "dcterms:source": "cat-harness/processes/review-task.bpmn#Task_Consolidate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_review.task_editordecides",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accept, or send back"
        }
      ],
      "skos:definition": [
        {
          "@value": "The editor's lane, kept separate on purpose: the reviewer who judged the change is not the position that accepts it."
        }
      ],
      "skos:notation": "Task_EditorDecides",
      "dcterms:source": "cat-harness/processes/review-task.bpmn#Task_EditorDecides",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sampleimport.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialize remote content (the five gates)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared subprocess. It resolves the request against the source descriptor, then asks size, restrictions, copyright, retention and source loss, and either fetches with fixity or leaves the content referenced. This process does not restate any of that; it waits for the outcome."
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "cat-harness/processes/sample-import.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sampleimport.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh materialized content"
        }
      ],
      "skos:definition": [
        {
          "@value": "Refresh is not re-import: what changed upstream, what changed locally since, and what to do when both did. The shared subprocess answers all three, and re-asks the five gates, since a licence can change and a collection can grow past the size agreed."
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "cat-harness/processes/sample-import.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sampleimport.task_importtest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import into the store, and test the import"
        }
      ],
      "skos:definition": [
        {
          "@value": "The part only this process does. Load the landed sample into the chosen store and check what an import can get wrong: every item arrived (count against the request), identifiers survived (the descriptor's authoritative ones), structure validates against the store's schema, and provenance (source, revision, fixity) is attached to each node. A check that could not run is a failure, not a pass."
        }
      ],
      "skos:notation": "Task_ImportTest",
      "dcterms:source": "cat-harness/processes/sample-import.bpmn#Task_ImportTest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sampleimport.task_library",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land it in library/"
        }
      ],
      "skos:definition": [
        {
          "@value": "A permanent sample joins the library as an L1 source, with the materialization record (purpose, gates, fixity) beside it. From here refresh-materialized governs it."
        }
      ],
      "skos:notation": "Task_Library",
      "dcterms:source": "cat-harness/processes/sample-import.bpmn#Task_Library",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sampleimport.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what failed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which check failed, on which items, and the evidence. The landed copy is not removed: a failed import is information about the source or the store, and deleting the copy would destroy the evidence."
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "cat-harness/processes/sample-import.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sampleimport.task_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the sample: which items, which store, and is it PERMANENT?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three answers, recorded before anything is fetched. WHICH ITEMS: named by the source's identifiers, or by a subset strategy its descriptor supports. WHICH STORE: the knowledge graph or other structured store the import is tested against. PERMANENT OR TRIAL: a permanent sample lands in library/ and is refreshed; a trial lands in fsh-guts/ and is not. The purpose materialize-remote asks for (working or archival) is asked there, not here."
        }
      ],
      "skos:notation": "Task_Scope",
      "dcterms:source": "cat-harness/processes/sample-import.bpmn#Task_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sampleimport.task_trial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep it as a trial: the unpublished trashcan"
        }
      ],
      "skos:definition": [
        {
          "@value": "A trial goes to the kept trashcan: addressable, exported, never published. Its node declares `$schema: folio-fsh-guts/v1` and carries the bean or issue it was written under, since it was never moved from anywhere and a `movedFrom` would be invented provenance. It is NOT refreshed: a trial records what the source looked like when it was tried. Promoting a trial means running this process again with permanent = yes, so the gates are asked afresh."
        }
      ],
      "skos:notation": "Task_Trial",
      "dcterms:source": "cat-harness/processes/sample-import.bpmn#Task_Trial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_askwhoisacting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask who is acting"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step that needs a person. Asked ONCE and recorded, never re-asked: `interaction/interaction.json` and the record exist so that a preference stated once is not requested again, which is WCAG 2.2 SC 3.3.7."
        }
      ],
      "skos:notation": "A_AskWhoIsActing",
      "dcterms:source": "cat-harness/processes/session-state-machine.bpmn#A_AskWhoIsActing",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_closesession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the session"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records that the actor stopped. It does NOT resolve beans or complete instances: those outlive the session by design, and a machine that closed them on the way out would be asserting work finished because somebody went away."
        }
      ],
      "skos:notation": "A_CloseSession",
      "dcterms:source": "cat-harness/processes/session-state-machine.bpmn#A_CloseSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_identifyactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish who is acting"
        }
      ],
      "skos:definition": [
        {
          "@value": "The first step and not a formality: `actor` is the one field of the record that nothing else can supply. Every other field is recoverable by reading the repository; who is acting is not."
        }
      ],
      "skos:notation": "A_IdentifyActor",
      "dcterms:source": "cat-harness/processes/session-state-machine.bpmn#A_IdentifyActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_opensession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the session record"
        }
      ],
      "skos:definition": [
        {
          "@value": "Writes `id`, `actor` and `startedAt`, with `open` and `claimed` empty. An empty `open` is the NORMAL state, not an unfinished one: an agent reading, answering or deciding is in no process at all."
        }
      ],
      "skos:notation": "A_OpenSession",
      "dcterms:source": "cat-harness/processes/session-state-machine.bpmn#A_OpenSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_readturn",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Take in the turn"
        }
      ],
      "skos:definition": [
        {
          "@value": "A turn is anything that arrives — a person's message, a tool result, a notification. The machine advances on turns rather than on a clock, because a session that has been told nothing has not changed."
        }
      ],
      "skos:notation": "A_ReadTurn",
      "dcterms:source": "cat-harness/processes/session-state-machine.bpmn#A_ReadTurn",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_touch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh `updatedAt` only"
        }
      ],
      "skos:definition": [
        {
          "@value": "Nothing changed, and saying so is the point. A record that stops being written looks exactly like an abandoned session; a refreshed timestamp with no other change says the session is alive and idle, which is a different fact and the commonest one."
        }
      ],
      "skos:notation": "A_Touch",
      "dcterms:source": "cat-harness/processes/session-state-machine.bpmn#A_Touch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_updatesession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write what changed"
        }
      ],
      "skos:definition": [
        {
          "@value": "An instance opened or closed, a bean claimed, a wait started or ended. All by REFERENCE: the bean and the instance are each the authority on themselves, and a status copied here would be free to contradict them. NO `cat-harness.processes:bean` on this step. It records that a claim happened; it does not claim."
        }
      ],
      "skos:notation": "A_UpdateSession",
      "dcterms:source": "cat-harness/processes/session-state-machine.bpmn#A_UpdateSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_cross",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cross the axes into SO, WO, ST, WT"
        }
      ],
      "skos:definition": [
        {
          "@value": "The TOWS matching step, and the only step that produces anything actionable. Strengths and weaknesses across, opportunities and threats down, and each cell names the strategy the pairing implies: SO — achieve opportunities that greatly match the strengths; WO — overcome weaknesses to attain opportunities; ST — use strengths to reduce vulnerability to threats; WT — prevent weaknesses, to avoid becoming more susceptible to threats. A SWOT that stops at four lists is the failure the source names as its central one. This step is what the process exists to reach. It produces CANDIDATE strategies, not a chosen one, and they are not ranked — see the process documentation on why no scoring activity exists."
        }
      ],
      "skos:notation": "A_Cross",
      "dcterms:source": "cat-harness/processes/swot-analysis.bpmn#A_Cross",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_framesubject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name the subject and the level"
        }
      ],
      "skos:definition": [
        {
          "@value": "One sentence naming WHAT is being analysed and at WHICH level — individual, organisational, national, international. The source requires this before anything is listed: \"the classification of a variable also depends on the purpose of the practice\", and the criteria for assigning a variable to a quadrant \"may be more difficult to clarify if the methodology is not used for a company but for a country\". It also bounds the known limitation that SWOT \"is rarely deployed at lower than the organization level\", where one scan drives strategy for units its factors do not hold equally for. Naming the level does not remove that risk; it makes it visible in the record."
        }
      ],
      "skos:notation": "A_FrameSubject",
      "dcterms:source": "cat-harness/processes/swot-analysis.bpmn#A_FrameSubject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_groupreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pool knowledge across participants"
        }
      ],
      "skos:definition": [
        {
          "@value": "The four lists are reviewed by more than the person who wrote them. This is the method's own answer to its own bias limitation, and it is a distinct activity rather than advice attached to the scans, because an activity can be recorded as not performed and a recommendation cannot. Disagreement about which quadrant a factor belongs in is an OUTPUT of this step, not a failure of it — it feeds A_RecordAmbiguous."
        }
      ],
      "skos:notation": "A_GroupReview",
      "dcterms:source": "cat-harness/processes/swot-analysis.bpmn#A_GroupReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_handoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand the candidates to a decision methodology"
        }
      ],
      "skos:definition": [
        {
          "@value": "The candidate strategies go to `options-analysis`, which selects the decision methodology by context and applies it. SWOT does not make that selection and does not make the decision. What is handed over includes the ambiguities from A_RecordAmbiguous and the fact that the candidates are UNRANKED. A receiving methodology that assumed an ordered list would be reading a priority SWOT never established."
        }
      ],
      "skos:notation": "A_HandOff",
      "dcterms:source": "cat-harness/processes/swot-analysis.bpmn#A_HandOff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_recordambiguous",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what did not classify cleanly"
        }
      ],
      "skos:definition": [
        {
          "@value": "Factors that sit in two quadrants, or in none, are written down as such. The source states this as inherent rather than as analyst error: \"the same factor can be fitted in two categories. A factor can be a strength and a weakness at the same time.\" It adds the two drifts — strengths not maintained become weaknesses, and opportunities not taken but taken by competitors become threats. A scan that silently forced every factor into one quadrant would report a cleanliness the method does not have. This is the same third-state discipline the rest of this repository applies to \"could not determine\": an unclassifiable factor is a finding, not a blank."
        }
      ],
      "skos:notation": "A_RecordAmbiguous",
      "dcterms:source": "cat-harness/processes/swot-analysis.bpmn#A_RecordAmbiguous",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_scanexternal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the environment opportunities and threats"
        }
      ],
      "skos:definition": [
        {
          "@value": "The external axis, first, per Weihrich. Work the source's categories of environmental change rather than free-associating: societal, governmental, economic, competitive, supplier and market changes, each item recorded with what it impacts. An opportunity is an external element that gives benefit; a threat is one that could cause trouble. Both are outside the subject and largely beyond its control — that is what puts them on this axis, not whether they feel good or bad."
        }
      ],
      "skos:notation": "A_ScanExternal",
      "dcterms:source": "cat-harness/processes/swot-analysis.bpmn#A_ScanExternal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_scaninternal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the subject strengths and weaknesses"
        }
      ],
      "skos:definition": [
        {
          "@value": "The internal axis. Work the source's functional checklist rather than a blank page: marketing, research and development, management information systems, management team, operations, finance, human resources. A strength gives advantage over others in the field; a weakness places the subject at a disadvantage relative to others. Both are attributes OF the subject. The source's warning belongs to this step specifically: listing strengths on paper \"is very different from testing the organization and experiencing the strengths at work\", so a strength recorded here is a claim, and where evidence for it exists it is cited."
        }
      ],
      "skos:notation": "A_ScanInternal",
      "dcterms:source": "cat-harness/processes/swot-analysis.bpmn#A_ScanInternal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_themeuireview.a_accessibility",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accessibility: measure, do not assert"
        }
      ],
      "skos:definition": [
        {
          "@value": "Contrast COMPUTED against the real ground, including the worst case a backdrop can present; a non-colour channel wherever colour carries meaning (SC 1.4.1); an accessible name on every region; keyboard and focus order. An automated pass is necessary and not sufficient — axe accepts a non-empty placeholder as an accessible name, and a CSS selector that matches nothing raises no error at all."
        }
      ],
      "skos:notation": "A_Accessibility",
      "dcterms:source": "cat-harness/processes/theme-ui-review.bpmn#A_Accessibility",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_themeuireview.a_branding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Branding: does it read as this instance?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Marks, palettes and art against the instance's own declaration rather than a remembered style. The question a downstream folio makes sharp: would this instance inherit something it did not choose?"
        }
      ],
      "skos:notation": "A_Branding",
      "dcterms:source": "cat-harness/processes/theme-ui-review.bpmn#A_Branding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_themeuireview.a_inventory",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inventory the ingested assets"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which graphical assets arrived, for which surfaces of the website or app design, in which locales, and at which VIEWPORTS: every surface at a web width and at a mobile width (owner, 2026-09-23, issue #1023). Read off the ingested artefacts rather than off the intent — a layout the source declares but does not supply is not in the inventory, and a surface the design needs but no asset covers is the one that would ship wrong."
        }
      ],
      "skos:notation": "A_Inventory",
      "dcterms:source": "cat-harness/processes/theme-ui-review.bpmn#A_Inventory",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_themeuireview.a_locales",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Languages: extracted, rendered, and RTL"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every user-facing string reaches the .pot; every declared locale renders without clipping or overflow; right-to-left is laid out rather than mirrored by accident. New UI is where untranslated strings enter, because nothing was stale — there was nothing there before."
        }
      ],
      "skos:notation": "A_Locales",
      "dcterms:source": "cat-harness/processes/theme-ui-review.bpmn#A_Locales",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_themeuireview.a_raisefindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise findings before the assets land"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings go back to whoever authored the choice, because the choice was theirs: a theme is picked per note by a human or an agent, and there is no mapping to correct instead. Raised, never silently fixed — a reviewer who re-themes a note has substituted their judgement for the author's without saying so."
        }
      ],
      "skos:notation": "A_RaiseFindings",
      "dcterms:source": "cat-harness/processes/theme-ui-review.bpmn#A_RaiseFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_themeuireview.r_judge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Judge the assets in their design"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person looks at the ingested assets laid out in the design they are for, at BOTH a web and a mobile width. THIS IS A HUMAN STEP INSIDE INGESTION, and that is stated rather than hidden: `ingest-theme.bpmn` used to refuse to call this process for exactly that reason. The owner's ruling puts theme review at ingestion only, and a ruling that moves a review does not remove the person who performs it — so ingestion of a THEME SOURCE is attended at this step, while ingestion of everything else stays unattended because `Gateway_ThemeSource` routes it past. A judgement made at one viewport is incomplete, not passed, and the wireframe of the surface (wireframe-design-review) says what each layout was meant to be. Three defects in the landing board — a selector matching nothing, a crop cutting the subject, a fade wrong in both directions — were invisible to a clean build, a passing suite and every gate, and were found only by rendering the page and looking."
        }
      ],
      "skos:notation": "R_Judge",
      "dcterms:source": "cat-harness/processes/theme-ui-review.bpmn#R_Judge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate flagged passage (human reviewer)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human SME or editor reviews the flagged passage. They may: - Accept the translation as-is (false positive) - Edit the translation and re-run QA - Reject and request re-translation The round trip establishes that two readings differ. Which one is right is a human call."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_edittranslation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit the flagged passage and re-inject"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer corrects the passage in the PO rather than sending the whole translation back. Flows to Task_PoInject, so the round-trip QA runs again over the corrected text — \"edit the translation and re-run QA\", which is what the adjudication step has always offered and what this process could not do. A userTask, not a service task: this is the one step here where a person edits content, and the lane's actor is the reviewer who just adjudicated."
        }
      ],
      "skos:notation": "Task_EditTranslation",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_EditTranslation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_poinject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject translations (PO → Markdown)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reads .po file and source .md, substitutes msgstr for msgid, preserves non-translatable elements, writes translated .md to translations/<locale>/block.md. Tool: translation_inject MCP tool or bun run content/pipeline/po-inject.ts"
        }
      ],
      "skos:notation": "Task_PoInject",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_PoInject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_potextract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract translatable strings (POT generation)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scans content nodes and extracts translatable strings to .pot files. Excludes math, labels, code, and Lean companions. Tool: translation_extract MCP tool or bun run content/pipeline/pot-extract.ts"
        }
      ],
      "skos:notation": "Task_PotExtract",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_PotExtract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA (back-translate)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean: folio-assistant-ktt2 Back-translates the target-language .md into the source language and compares meaning with the original. Detects semantic drift and terminology misses that a forward-only fluency check cannot see. Tool: translation_validate MCP tool"
        }
      ],
      "skos:notation": "Task_RoundTripQA",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_RoundTripQA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off translation (human adjudicator)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human reviewer signs off the translation at the chosen hierarchy level (block, section, chapter, or folio). Updates status.json: { official: true, signedOffBy: \"...\", signedOffAt: \"...\", sourceHash: \"...\" } Tool: translation_signoff MCP tool"
        }
      ],
      "skos:notation": "Task_Signoff",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_stalenesscheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check staleness (source hash)"
        }
      ],
      "skos:definition": [
        {
          "@value": "On source content change: computes sha256(source.md) and compares to each translation's status.json sourceHash. If they differ, sets stale: true. The translation remains visible with a \"stale — needs re-adjudication\" indicator."
        }
      ],
      "skos:notation": "Task_StalenessCheck",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_StalenessCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce translation (PO file)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Translation of .pot → .po by one of: 1. Existing PO from smart-base (Weblate/Crowdin/Launchpad) 2. FHIR/translation-utils po-translate CLI (DeepL/Google, tagged #fuzzy) 3. Agent (LLM) translation 4. Human translator Result: <locale>/block.po with msgid/msgstr pairs."
        }
      ],
      "skos:notation": "Task_Translate",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_writeofficial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (official)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records the sign-off with the SHA-256 of the source .md, enabling staleness detection on future source changes."
        }
      ],
      "skos:notation": "Task_WriteOfficial",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_WriteOfficial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_translation.task_writeunofficial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (unofficial)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records the translation as unofficial in translations/<locale>/status.json: { official: false, generatedBy: \"...\", generatedAt: \"...\" } The translation is usable but carries a visible warning badge."
        }
      ],
      "skos:notation": "Task_WriteUnofficial",
      "dcterms:source": "cat-harness/processes/translation-workflow.bpmn#Task_WriteUnofficial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_applypin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move the pin and open the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "The pin literal moves in the one file `upstream-pins.json` declares, and the PR body says what the version range changed in RENDERED output — the evidence, not just the verdict."
        }
      ],
      "skos:notation": "A_ApplyPin",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#A_ApplyPin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_evidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the MVP evidence staging URL + gate results"
        }
      ],
      "skos:definition": [
        {
          "@value": "Staging URL, gate results and the impact analysis, on the PR. Enough for the reviewer to answer without opening anything else."
        }
      ],
      "skos:notation": "A_Evidence",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#A_Evidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_impact",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Impact analysis what of ours binds it"
        }
      ],
      "skos:definition": [
        {
          "@value": "The half a changelog cannot supply, because upstream does not know what you reached into. Worked from the row's `binds` list in `upstream-pins.json`. For the theme: `docs/assets/js/docs-ui.js` MOVES the theme's own search markup into the action launcher and binds `.search`, `#search-input` and `.search-label`; `docs-ui.css` overrides `.side-bar`, `.site-header` and `.main-header`; three e2e specs assert the structure the theme emits. An upstream rename of any of those is not a build failure — it is a shipped feature that quietly stops working."
        }
      ],
      "skos:notation": "A_Impact",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#A_Impact",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_recordoutcome",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the hold or the decline"
        }
      ],
      "skos:definition": [
        {
          "@value": "A HOLD is a block with an expiry and a revisit trigger: a hold with neither cannot be told from abandoned work, and the next watcher run re-raises the same pin with no memory of why it was left. A DECLINE is a scrapped bean carrying its reasons — what stops the next agent re-entering the same dead end. Either way the decision is written down before the process ends, and the bean is resolved from here: a run that stops at \"we looked and said no\" is as finished as one that moved the pin."
        }
      ],
      "skos:notation": "A_RecordOutcome",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#A_RecordOutcome",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the delta pinned → candidate"
        }
      ],
      "skos:definition": [
        {
          "@value": "Restricted to the directories that reach our output — for a Jekyll theme `_sass`, `_includes`, `_layouts`, `assets`. Upstream's own docs, CI and tests cannot reach us, and counting them makes a harmless release look alarming. The changelog is the claim; `git diff --stat pinned..candidate` over those paths is the evidence."
        }
      ],
      "skos:notation": "A_Scope",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#A_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.call_optionsanalysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Options analysis adopt · hold · decline"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the single edge into `PM_Decide`, and deliberately not earlier: the MVP build and its gates are HOW the options' costs are measured, so an analysis before `Task_Mvp` would weigh alternatives against no evidence. Everything the decider needs exists by the time the reviewer has finished and the fixable findings are fixed. In the Agent lane, because this step produces the analysis and does not make the decision — `PM_Decide` is a `userTask` whose lane admits `person` only, and putting the analysis in the agent's lane is what keeps that separation legible rather than implied. A subprocess that decided would be a second accepting party. Reached through the loop as well as straight through: `SF_UA_8` re-enters at `A_Impact`, so a run where the reviewer found something fixable arrives here a second time with different evidence. That is a genuine re-analysis and its `op=\"note\"` appends rather than deduping, which is the behaviour wanted — a second note records that the options were weighed again against changed inputs."
        }
      ],
      "skos:notation": "Call_OptionsAnalysis",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#Call_OptionsAnalysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.pm_decide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adopt, hold or decline"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PERSON decides. The lane admits `person` only, so `activity-fulfilment-kind` fails the moment somebody makes an agent the accepting party, and `relaxable=\"false\"` means no package may relax the step. The publication manager rather than the editor because a pin is not a change to the corpus — it is a change to what the published artefact is BUILT FROM, and that role is the one accountable for what is live. Deliberately NOT a DMN-backed gateway. Every computed gateway in this repository reduces to arithmetic over tool output; this one weighs a rendering nobody can score against the cost of staying behind, and a table here would look authoritative without being so."
        }
      ],
      "skos:notation": "PM_Decide",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#PM_Decide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.r_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the MVP against what we bind to"
        }
      ],
      "skos:definition": [
        {
          "@value": "A narrower question than \"is the new version good\": does everything in `binds` still hold, checked against the deployed page. A `userTask`, and the lane admits `person` and `agent` — a review agent is a legitimate reviewer here, and the separation that matters is the next lane's: a reviewer cannot accept."
        }
      ],
      "skos:notation": "R_Review",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#R_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.task_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the row's gates tests · e2e · site-links"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `mvp` commands declared for this tenant. For the theme: `bun test`, `CI=1 bunx playwright test` (a11y, action tiles, sidebar panels, QA panel) and `scripts/site-links.ts --site ./_site`, which checks the navbar tiles against the BUILT site rather than against the attribute — the distinction that let a 404 ship unnoticed once already. A red gate is EVIDENCE, not an exit. It does not end the process and it does not loop by itself: \"this version breaks us\" is a finding the decider needs, not a reason to stop before they see it."
        }
      ],
      "skos:notation": "Task_Gates",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#Task_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreamadoption.task_mvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "MVP: build the candidate on a staging branch"
        }
      ],
      "skos:definition": [
        {
          "@value": "An MVP is a DEPLOYED BUILD, not a description of one. The pin is moved on a branch and `feature-staging.yml` publishes it under `STAGING/<branch-slug>/`, so the reviewer looks at the artefact rather than at a screenshot — the same argument the merge discipline makes about rendered work."
        }
      ],
      "skos:notation": "Task_Mvp",
      "dcterms:source": "cat-harness/processes/upstream-version-adoption.bpmn#Task_Mvp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.a_pickup",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pick up the stale pin claim a bean"
        }
      ],
      "skos:definition": [
        {
          "@value": "The hand-off from the mechanical lane to the one that can exercise judgement. Claiming the bean here is what stops two sessions adopting the same bump."
        }
      ],
      "skos:notation": "A_PickUp",
      "dcterms:source": "cat-harness/processes/upstream-pin-watch.bpmn#A_PickUp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.call_adopt",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adopt the version bump"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reusable subprocess. Every pinned dependency enters it the same way, so a new tenant is a registry row and a call — never a second diagram saying the same thing in different words."
        }
      ],
      "skos:notation": "Call_Adopt",
      "dcterms:source": "cat-harness/processes/upstream-pin-watch.bpmn#Call_Adopt",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.task_closeissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Closed automatically when every pin is current, so the issue's existence is the state rather than a log of past states."
        }
      ],
      "skos:notation": "Task_CloseIssue",
      "dcterms:source": "cat-harness/processes/upstream-pin-watch.bpmn#Task_CloseIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.task_queryupstream",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "List upstream releases and compare to the pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "`git ls-remote --tags`, filtered by the row's `tagPattern` and ordered by version. Nothing is cloned and no API token is needed, so the check runs the same way on a laptop and in CI."
        }
      ],
      "skos:notation": "Task_QueryUpstream",
      "dcterms:source": "cat-harness/processes/upstream-pin-watch.bpmn#Task_QueryUpstream",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.task_readpins",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the pin registry upstream-pins.json"
        }
      ],
      "skos:definition": [
        {
          "@value": "The registry lists the tenants and says, per row, WHICH FILE holds the pin literal and how to read it. It deliberately does not store the version: one answer to \"what are we running\", read from the file the build reads."
        }
      ],
      "skos:notation": "Task_ReadPins",
      "dcterms:source": "cat-harness/processes/upstream-pin-watch.bpmn#Task_ReadPins",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.task_trackissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "One issue, edited in place. GitHub's own failure mail is the channel that was already ignored thirty times, so this adds none: an edit does not notify, and a pin that stays behind for two months stays one unread item rather than nine."
        }
      ],
      "skos:notation": "Task_TrackIssue",
      "dcterms:source": "cat-harness/processes/upstream-pin-watch.bpmn#Task_TrackIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_voicereview.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate: prose, scope, or exception"
        }
      ],
      "skos:definition": [
        {
          "@value": "The same three outcomes as the base voice axis. The register is wrong for this block (fix the prose); the rule does not apply to this content (scope it on the voice, one edit rather than ten overrules); or the rule applies and this block is an exception (a reviewer entry saying why)."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/processes/voice-review.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_voicereview.task_loadactive",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Load the active voices"
        }
      ],
      "skos:definition": [
        {
          "@value": "The activated set only, never everything shipped. An id naming no shipped voice is an error rather than a skip — a folio that believes it is applying a voice and is applying nothing has the cleanest-looking output of the three."
        }
      ],
      "skos:notation": "Task_LoadActive",
      "dcterms:source": "cat-harness/processes/voice-review.bpmn#Task_LoadActive",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_voicereview.task_mechanicalhalf",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the rule's mechanical half"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whatever `patterns` and `terminology` the rule carries. A `judgementOnly` rule has no mechanical half by declaration, which is different from nobody having written one yet."
        }
      ],
      "skos:notation": "Task_MechanicalHalf",
      "dcterms:source": "cat-harness/processes/voice-review.bpmn#Task_MechanicalHalf",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_voicereview.task_opencitation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the rule's citation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every rule resolves to a real `library/` section or a KG node, and carries the quote it was read from. Opening it is what lets a reviewer say WHY the rule applies — and it is the only way to catch a rule that misread its own source."
        }
      ],
      "skos:notation": "Task_OpenCitation",
      "dcterms:source": "cat-harness/processes/voice-review.bpmn#Task_OpenCitation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_voicereview.task_recordonsidecar",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record on the block's QA sidecar"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through `qa-merge-findings`, so the icon and the published witness agree with the decision. The adjudication LEADS the criterion and the script entry is kept beneath it: a disagreement between a checker and a reviewer is information."
        }
      ],
      "skos:notation": "Task_RecordOnSidecar",
      "dcterms:source": "cat-harness/processes/voice-review.bpmn#Task_RecordOnSidecar",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_voicereview.task_ruleiswrong",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "The RULE is the defect — bean it"
        }
      ],
      "skos:definition": [
        {
          "@value": "A rule its own quote does not support is a finding against the voice, not against the block. Measured precedent: `voice-editorializing` flags \"clearly\", and the exemplar the Milnor gate is named after uses it fourteen times as proof economy (bean `2t41`)."
        }
      ],
      "skos:notation": "Task_RuleIsWrong",
      "dcterms:source": "cat-harness/processes/voice-review.bpmn#Task_RuleIsWrong",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.call_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudication"
        }
      ],
      "skos:definition": [
        {
          "@value": "folio-assistant's adjudication: the adjudication leads, the checker's entry is kept, and the dispensation carries its reason. Reviewers disagreeing on ONE criterion is a criterion disagreement, so this calls the QA-criterion specialisation (bean `bvuk`, owner 2026-09-23): the failing entry stands, the criterion does not apply to this screen, or a dispensation is granted with its reason. FOR THIS CALLER THE SPLIT WAS A REGRESSION, not a fix, and that is worth keeping because the PR that made it said the opposite. When `bvuk` moved the outcome half out of `adjudication.bpmn`, #1074 reported that all four remaining callers \"no longer reach A_ScopeCriterion or A_Dispensation\" and framed it as the intended effect. True for three of them, whose question never admitted those steps. Here it removed the two steps the sentence above already documents, so the call was left pointing at a shared judgement that no longer runs either. Repointing restores what the documentation always claimed rather than changing it. The entry condition matches exactly rather than approximately: GW_Agree asks whether the blind reviewers' entries agree and takes `no` here, and `Process_CriterionAdjudication` starts at \"entries for one criterion disagree\" — R_Review records pass, warn or fail PER CRITERION with a reason, so the disagreement reaching this step is a per-criterion disagreement between reviewer entries and nothing else."
        }
      ],
      "skos:notation": "Call_Adjudicate",
      "dcterms:source": "cat-harness/processes/wireframe-design-review.bpmn#Call_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.call_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose a candidate"
        }
      ],
      "skos:definition": [
        {
          "@value": "A one-off choice between surviving candidates. Rejected candidates are kept, with the reason each lost."
        }
      ],
      "skos:notation": "Call_Choose",
      "dcterms:source": "cat-harness/processes/wireframe-design-review.bpmn#Call_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.d_candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce >= 2 candidates, web + mobile"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mid-fidelity HTML: monochrome, real folio content, semantic icons, no placeholder text. Each candidate has both a web layout and a mobile layout."
        }
      ],
      "skos:notation": "D_Candidates",
      "dcterms:source": "cat-harness/processes/wireframe-design-review.bpmn#D_Candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.d_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mechanical checks, both viewports"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool wireframe-check renders every candidate at a web and a mobile viewport. It fails on horizontal overflow at mobile width, on placeholder text, and on a missing viewport, and writes screenshots and a script entry per criterion."
        }
      ],
      "skos:notation": "D_Check",
      "dcterms:source": "cat-harness/processes/wireframe-design-review.bpmn#D_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.d_intent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the design intent"
        }
      ],
      "skos:definition": [
        {
          "@value": "A short statement of who the screen is for, what they need to do, and what it must show. It is the criterion every candidate is judged against."
        }
      ],
      "skos:notation": "D_Intent",
      "dcterms:source": "cat-harness/processes/wireframe-design-review.bpmn#D_Intent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.r_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Blind review per criterion"
        }
      ],
      "skos:definition": [
        {
          "@value": "Criteria: intent-fit, web usability, mobile usability, accessibility, and alternatives considered. A review at one viewport only is incomplete."
        }
      ],
      "skos:notation": "R_Review",
      "dcterms:source": "cat-harness/processes/wireframe-design-review.bpmn#R_Review",
      "skos:note": "candidate"
    }
  ]
}
