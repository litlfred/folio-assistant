{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/bootstrap/schemas/requirement.schema.json",
  "title": "Requirement",
  "description": "What a harness, or something built with one, must do, said so it can be checked: a titled set of numbered statements, each with a level (SHALL, SHOULD, MAY, SHALL NOT) and one sentence. A test run points at a statement as `req:<slug>#<key>`; the requirement does not list its tests. Statement keys are unique within a requirement.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^req:[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "in-force",
        "superseded",
        "retired"
      ]
    },
    "derivedFrom": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "statements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "conformance": {
            "type": "string",
            "enum": [
              "SHALL",
              "SHOULD",
              "MAY",
              "SHALL NOT"
            ]
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "functional",
              "non-functional"
            ]
          },
          "activity": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "benefit": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "key",
          "label",
          "conformance",
          "requirement"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposedIn": {
      "type": "string",
      "minLength": 1
    },
    "supersededBy": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "actors",
    "statements"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "supersededBy"
        ]
      }
    },
    {
      "properties": {
        "statements": {
          "items": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "functional"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "not": {
                    "required": [
                      "category"
                    ]
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "non-functional"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "activity"
                        ]
                      },
                      {
                        "required": [
                          "capability"
                        ]
                      },
                      {
                        "required": [
                          "benefit"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
