{
  "@context": {
    "@version": 1.1,
    "@base": "https://litlfred.github.io/folio/",
    "cat-harness": "https://litlfred.github.io/cat-harness/0.1.0/ns#",
    "doco": "http://purl.org/spar/doco/",
    "deo": "http://purl.org/spar/deo/",
    "cito": "http://purl.org/spar/cito/",
    "oa": "http://www.w3.org/ns/oa#",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "fhir": "http://hl7.org/fhir/",
    "csvw": "http://www.w3.org/ns/csvw#",
    "label": "cat-harness:label",
    "title": "dcterms:title",
    "kind": "cat-harness:kind",
    "uses": {
      "@id": "cat-harness:uses",
      "@type": "@id",
      "@container": "@set"
    },
    "interprets": {
      "@id": "cat-harness:interprets",
      "@type": "@id"
    },
    "foreshadows": {
      "@id": "cat-harness:foreshadows",
      "@type": "@id",
      "@container": "@set"
    },
    "proofs": {
      "@id": "cat-harness:proofs",
      "@type": "@id",
      "@container": "@set"
    },
    "examples": {
      "@id": "cat-harness:examples",
      "@type": "@id",
      "@container": "@set"
    },
    "cites": {
      "@id": "cito:cites",
      "@type": "@id",
      "@container": "@set"
    },
    "tags": {
      "@id": "cat-harness:tag",
      "@container": "@set"
    },
    "defines": {
      "@id": "cat-harness:defines",
      "@container": "@set"
    },
    "leanRef": "cat-harness:leanRef",
    "sorryFree": "cat-harness:sorryFree",
    "text": {
      "@id": "cat-harness:text"
    },
    "leanSource": {
      "@id": "cat-harness:leanSource"
    },
    "meta": {
      "@id": "cat-harness:blockMeta",
      "@type": "@json"
    },
    "license": {
      "@id": "dcterms:license"
    },
    "licenceRecord": {
      "@id": "cat-harness:licenceRecord",
      "@type": "@json"
    },
    "$schema": {
      "@id": "dcterms:conformsTo"
    },
    "format": {
      "@id": "dcterms:format"
    },
    "narrative": {
      "@id": "cat-harness:narrative",
      "@type": "@json"
    },
    "source": {
      "@id": "cat-harness:sourceTechnicalMetadata",
      "@type": "@json"
    },
    "archive": {
      "@id": "cat-harness:archiveTechnicalMetadata",
      "@type": "@json"
    },
    "sheets": {
      "@id": "cat-harness:sheets",
      "@type": "@json"
    },
    "entries": {
      "@id": "cat-harness:archiveEntries",
      "@type": "@json"
    },
    "n_sheets": {
      "@id": "cat-harness:sheetCount",
      "@type": "http://www.w3.org/2001/XMLSchema#integer"
    },
    "n_entries": {
      "@id": "cat-harness:entryCount",
      "@type": "http://www.w3.org/2001/XMLSchema#integer"
    },
    "n_files": {
      "@id": "cat-harness:archiveFileCount",
      "@type": "http://www.w3.org/2001/XMLSchema#integer"
    },
    "n_directories": {
      "@id": "cat-harness:directoryCount",
      "@type": "http://www.w3.org/2001/XMLSchema#integer"
    },
    "uncompressed_bytes": {
      "@id": "cat-harness:uncompressedBytes",
      "@type": "http://www.w3.org/2001/XMLSchema#integer"
    },
    "header_vocabulary": {
      "@id": "cat-harness:headerVocabulary",
      "@container": "@set"
    },
    "headers": {
      "@id": "cat-harness:headers",
      "@container": "@list"
    },
    "file": {
      "@id": "cat-harness:file"
    },
    "contains": {
      "@id": "dcterms:hasPart",
      "@type": "@id",
      "@container": "@set"
    },
    "refs": {
      "@id": "cat-harness:refs",
      "@type": "@id",
      "@container": "@set"
    },
    "derivedFrom": {
      "@id": "prov:wasDerivedFrom",
      "@type": "@id"
    },
    "sourceDocument": {
      "@id": "cat-harness:sourceDocument",
      "@type": "@id"
    },
    "provenance": "cat-harness:provenance",
    "pageStart": "cat-harness:pageStart",
    "pageEnd": "cat-harness:pageEnd",
    "strength": "cat-harness:strength"
  }
}
