{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quality Control Input",
  "description": "Input schema for quality control checks across content lifecycle.",
  "type": "object",
  "required": [
    "checkType",
    "targetPath"
  ],
  "properties": {
    "checkType": {
      "type": "string",
      "enum": [
        "qa-report",
        "publication-checklist",
        "conformance-validation",
        "functionality-test",
        "cross-component-consistency"
      ],
      "description": "Type of QC check to perform."
    },
    "targetPath": {
      "type": "string",
      "description": "Path to content being checked."
    },
    "checklistSections": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "L1",
          "L2",
          "L3",
          "L4",
          "global"
        ]
      },
      "description": "Publication checklist sections to review."
    }
  },
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/claude-foaq-fsh-guts-viz-tracked/folio-assistant-core/schema/skills/quality-control/input.schema.json",
