{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-npm_and_yarn-cat-harness-schemas-block-qa-schema-typescript-7.0.2/skills/content-feedback/output.schema.json",
  "title": "Content Feedback Output",
  "description": "Output schema for triaged feedback.",
  "type": "object",
  "required": [
    "triagedItems"
  ],
  "properties": {
    "triagedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "backlog",
              "next-sprint",
              "wont-fix",
              "duplicate",
              "needs-info"
            ]
          },
          "assignee": {
            "type": "string"
          },
          "linkedIssue": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "critical": {
          "type": "integer"
        },
        "major": {
          "type": "integer"
        },
        "minor": {
          "type": "integer"
        },
        "enhancement": {
          "type": "integer"
        }
      }
    }
  },
  "staging": {
    "branch": "dependabot/npm_and_yarn/cat-harness/schemas/block-qa-schema/typescript-7.0.2",
    "sha": "15eb4a6fa79a736025a1df439ef7c6c94a90d367",
    "pr": "914/merge",
    "run": "36170533021"
  }
}
