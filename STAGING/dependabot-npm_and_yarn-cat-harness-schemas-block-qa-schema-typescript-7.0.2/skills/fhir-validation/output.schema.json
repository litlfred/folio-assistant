{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-npm_and_yarn-cat-harness-schemas-block-qa-schema-typescript-7.0.2/skills/fhir-validation/output.schema.json",
  "title": "FHIR Validation Output",
  "description": "Output schema for FHIR validation results.",
  "type": "object",
  "required": [
    "overallStatus"
  ],
  "properties": {
    "overallStatus": {
      "type": "string",
      "enum": [
        "pass",
        "warnings",
        "errors"
      ]
    },
    "sushiResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "errors": {
          "type": "integer"
        },
        "warnings": {
          "type": "integer"
        }
      }
    },
    "publisherResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string"
        },
        "qaHtmlPath": {
          "type": "string"
        },
        "errorCount": {
          "type": "integer"
        },
        "warningCount": {
          "type": "integer"
        },
        "infoCount": {
          "type": "integer"
        }
      }
    },
    "conformanceResults": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "conformant",
              "non-conformant"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "staging": {
    "branch": "dependabot/npm_and_yarn/cat-harness/schemas/block-qa-schema/typescript-7.0.2",
    "sha": "b346a34b0f3f5e1f4ce6691dee1559858fcd2028",
    "pr": "914/merge",
    "run": "35712758251"
  }
}
