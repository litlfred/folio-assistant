{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-npm_and_yarn-cat-harness-schemas-block-qa-schema-typescript-7.0.2/skills/l3-fhir-authoring/output.schema.json",
  "title": "L3 FHIR Authoring Output",
  "description": "Output schema for L3 FHIR IG authoring.",
  "type": "object",
  "required": [
    "fshFiles",
    "sushiResult"
  ],
  "properties": {
    "fshFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "resourceType"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "resourceType": {
            "type": "string"
          },
          "resourceId": {
            "type": "string"
          }
        }
      }
    },
    "sushiResult": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "warnings",
            "errors"
          ]
        },
        "resourceCount": {
          "type": "integer"
        },
        "errorCount": {
          "type": "integer"
        },
        "warningCount": {
          "type": "integer"
        }
      }
    },
    "generatedResources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "resourceType": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "staging": {
    "branch": "dependabot/npm_and_yarn/cat-harness/schemas/block-qa-schema/typescript-7.0.2",
    "sha": "15eb4a6fa79a736025a1df439ef7c6c94a90d367",
    "pr": "914/merge",
    "run": "36170533021"
  }
}
