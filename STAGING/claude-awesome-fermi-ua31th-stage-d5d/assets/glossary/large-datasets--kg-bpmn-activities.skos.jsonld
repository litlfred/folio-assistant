      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit it in place — it is your own content"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ordinary path, drawn so the process does not read as though every edit needs a copy. Content in a writable directory is authored content and is edited where it lives; the copy-out is for somebody else's bytes, not for yours."
        }
      ],
      "skos:notation": "Task_EditDirectly",
      "dcterms:source": "large-datasets/processes/copy-out-materialized.bpmn#Task_EditDirectly",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_land",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land the bytes in the copier's own folio/"
        }
      ],
      "skos:definition": [
        {
          "@value": "Into the copier's own declared `folio/`, never a scratch area — a directory nobody declared is a directory nobody gates, and the copy would be publishable by accident. The copy is NOT read-only: it is the copier's own content, makes no claim about anybody else's bytes, and freezing it too would mean the next person needs a copy of the copy."
        }
      ],
      "skos:notation": "Task_Land",
      "dcterms:source": "large-datasets/processes/copy-out-materialized.bpmn#Task_Land",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_readsource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the original — and write nothing"
        }
      ],
      "skos:definition": [
        {
          "@value": "A read, and the only interaction this process has with the source. Its digest and `provenance` are carried forward: the digest so Task_VerifySourceUntouched has something to check against, and `provenance` so the copy can name what it came out of without re-deriving it."
        }
      ],
      "skos:notation": "Task_ReadSource",
      "dcterms:source": "large-datasets/processes/copy-out-materialized.bpmn#Task_ReadSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_recordprovenance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record provenance.local — what this is a copy OF"
        }
      ],
      "skos:definition": [
        {
          "@value": "The step that is easy to omit and impossible to reconstruct afterwards. `provenance` is a PAIR: `upstream` is the remote thing, `local` is the original in this repository. A copy-out writes `local`; it does not overwrite `upstream`, and it does not reuse `upstream` for a local value — that was one field until 2026-09-22, and by then 5 of the 9 who-iris item records were using it for a local one in violation of its own documentation. Without `local`, one rename later the copy is indistinguishable from original work and nothing downstream can repair it, because the information was never written down."
        }
      ],
      "skos:notation": "Task_RecordProvenance",
      "dcterms:source": "large-datasets/processes/copy-out-materialized.bpmn#Task_RecordProvenance",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_verifysourceuntouched",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify the ORIGINAL still hashes to its digest"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:materialized-fixity`. Run against the SOURCE, not the copy — the copy is new content with no claim to verify, and the source is the thing a botched copy-out would have disturbed. A mismatch here means the copy-out was an edit in place wearing a copy's clothes, and it is the only signal that tells the two apart."
        }
      ],
      "skos:notation": "Task_VerifySourceUntouched",
      "dcterms:source": "large-datasets/processes/copy-out-materialized.bpmn#Task_VerifySourceUntouched",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_copyright",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "COPYRIGHT per bitstream, and for the derived work"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the licence permits for THIS bitstream, and separately whether it permits the derivation. LICENSE-CONTENT.md exists in this repository and the ingestion pipeline does not read it."
        }
      ],
      "skos:notation": "Task_Copyright",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_Copyright",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the node `materialized`"
        }
      ],
      "skos:definition": [
        {
          "@value": "The node's state moves from `referenced` to `materialized`, carrying purpose, localPath, gates and (archival) fixity. There is NO default state: a node that has not said is invalid, because 'the author did not say' and 'the author said they could not tell' are different facts."
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_enumerate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "ENUMERATE + SUBSET against the source descriptor"
        }
      ],
      "skos:definition": [
        {
          "@value": "Resolve the request against the source's descriptor (large-datasets/schemas/source-descriptor.ts, one file per source under large-datasets/sources/) BEFORE any gate. Three things come from it and none may be guessed. (1) Which subset strategies the source supports — supportsSubset(). (2) Whether a subset stands on its own: when subsetIsSelfContained is false (mathlib), the request is closed over its dependencies here, and every gate after this one is asked about the CLOSURE, because a subset that omits what its members depend on is not a smaller corpus, it is one that does not build. (3) What enumerating the whole costs — enumerationCost(), which is undefined when the descriptor has no measured denominator; SIZE then refuses rather than estimates. A source with no descriptor is not an error here: it is an unknown, and SIZE refuses on it. Bean w5bn: the descriptor is CALLED here rather than restated."
        }
      ],
      "skos:notation": "Task_Enumerate",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_Enumerate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_fetch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch, and record fixity"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch, then record sha256 and byte count. Fixity is REQUIRED for an archival copy: an archive that cannot demonstrate it is unchanged is a copy, and it cannot be re-fetched to check, because the thing it would be re-fetched from is what it exists to survive. The data already exists — every structure.json carries sha256 and bytes, and nothing reads them as fixity."
        }
      ],
      "skos:notation": "Task_Fetch",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_Fetch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_purpose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the purpose: working or archival"
        }
      ],
      "skos:definition": [
        {
          "@value": "working or archival, and it is asked FIRST because three of the five gates mean different things under each. An archival copy keeps the original bytes, never expires, requires fixity, and is the only thing that discharges sourceLoss; a working copy keeps derived content and discharges none of that. A process that gated first and asked afterwards would be judging a copy whose obligations it did not yet know."
        }
      ],
      "skos:notation": "Task_Purpose",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_Purpose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_restrictions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "RESTRICTIONS unknown is an answer, not a green light"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner's phrase is 'no restrictions known in context', and that is a STATE, not a green light. GateVerdict is three-valued for this reason alone, and `unknown` is never rendered as `permitted`."
        }
      ],
      "skos:notation": "Task_Restrictions",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_Restrictions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_retention",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "RETENTION what expires this copy"
        }
      ],
      "skos:definition": [
        {
          "@value": "A copy with no expiry cannot be told from an abandoned one — the same argument bean-blocking makes about a block with no expiry. An ARCHIVAL copy is the exception and it is a specification rather than an omission: freshness() reports it `permanent`, not `no-expiry`."
        }
      ],
      "skos:notation": "Task_Retention",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_Retention",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_size",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SIZE what fraction, and what the whole would cost"
        }
      ],
      "skos:definition": [
        {
          "@value": "What is being taken, and what the whole collection would cost. REFUSES when it cannot tell: 'three items' with no denominator is not a size answer. 0.7 TB is the measured reason the IRIS import is by reference."
        }
      ],
      "skos:notation": "Task_Size",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_Size",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_sourceloss",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SOURCE LOSS what survives if the origin goes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Not hypothetical. The one IRIS record this repository holds carries a handle on iris.wpro.who.int, a regional instance merged into the global one. Only an ARCHIVAL copy of the original bytes discharges this; a working copy cannot, because the derived sections are not the publication."
        }
      ],
      "skos:notation": "Task_SourceLoss",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_SourceLoss",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_materializeremote.task_stayref",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it `referenced`, record why"
        }
      ],
      "skos:definition": [
        {
          "@value": "A refusal is not a failure of the process — it is the process working. The node stays `referenced`, which means the graph still knows it exists and where, and the refusing gate's basis is recorded so the next caller does not re-litigate it."
        }
      ],
      "skos:notation": "Task_StayRef",
      "dcterms:source": "large-datasets/processes/materialize-remote.bpmn#Task_StayRef",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the conflict"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human or agentic decision, never a merge rule. Which side wins depends on why the local edit was made, and a process that picked automatically would be choosing without the one fact that decides it."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "large-datasets/processes/refresh-materialized.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-materialize, re-asking the five gates — and record the new fixity"
        }
      ],
      "skos:definition": [
        {
          "@value": "The gates are re-asked, not inherited: a licence can change, and a collection can grow past the size a caller agreed to. AND THE NEW FIXITY IS RECORDED IN THE SAME CHANGE. This step rewrites bytes that a materialization record describes, so leaving the old digest behind would make a CORRECT run of this process fail check:materialized-fixity as a mismatch — the gate reading \"somebody edited held content without saying so\" about the one process whose job is to replace it. Measured 2026-09-22 (bean 10s1): this task named no fixity write at all. This is the owner's publication exception, stated as a rule rather than as a carve-out. The exception is NOT \"these actors may skip the rule\"; it is \"say what you did\". A writer that updates the digest alongside the bytes passes, and the record then describes what is actually there. A writer that does not fails, correctly, because it has forked upstream silently. A list of permitted writers would go stale the first time somebody added a sixth one; this does not."
        }
      ],
      "skos:notation": "Task_Apply",
      "dcterms:source": "large-datasets/processes/refresh-materialized.bpmn#Task_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_fixity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "ARCHIVAL verify fixity — never re-fetch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-compute the digest and compare. An archive is NEVER re-fetched — the source is what it exists to survive, so replacing it with today's version discards the state it was keeping. A mismatch means OUR copy rotted, and the remedy is restoration from a backup, not re-download."
        }
      ],
      "skos:notation": "Task_Fixity",
      "dcterms:source": "large-datasets/processes/refresh-materialized.bpmn#Task_Fixity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_keeplocal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep the local edit, and re-pin so it stops being asked"
        }
      ],
      "skos:definition": [
        {
          "@value": "The local edit wins, so nothing is re-materialized — and the pin moves to the upstream revision that was compared against. Re-pinning is the half that is easy to forget and is the reason this is a step rather than an absence: without it the same upstream change is detected as new on every cycle, and a contributor is asked the same settled question for ever. The record says the copy is deliberately divergent FROM a named revision, which is a different claim from being stale against an unknown one."
        }
      ],
      "skos:notation": "Task_KeepLocal",
      "dcterms:source": "large-datasets/processes/refresh-materialized.bpmn#Task_KeepLocal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_local",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "What changed LOCALLY since"
        }
      ],
      "skos:definition": [
        {
          "@value": "The half nothing answers today. A materialized copy that was edited in place is not a copy any more, and overwriting it silently destroys work whose existence the process never established."
        }
      ],
      "skos:notation": "Task_Local",
      "dcterms:source": "large-datasets/processes/refresh-materialized.bpmn#Task_Local",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_reconcile",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Reconcile the two by hand"
        }
      ],
      "skos:definition": [
        {
          "@value": "Neither side wins whole: the contributor produces content that is neither the local copy nor the remote one, and THEN it is applied. Drawn as a separate step before Task_Apply rather than folded into it, because Task_Apply re-asks the five import gates against what is being materialized — and what is being materialized here is a hand-made artefact, which is exactly the case those gates should see rather than be told about."
        }
      ],
      "skos:notation": "Task_Reconcile",
      "dcterms:source": "large-datasets/processes/refresh-materialized.bpmn#Task_Reconcile",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_recordconflict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the conflict, decide nothing, and do NOT re-pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both copies stay and the conflict is written down with what each side says. Deliberately does not re-pin, which is the one thing separating it from Task_KeepLocal: the question is unresolved, so it must be asked again next cycle. Recording is not optional here for the reason A_RecordEntry is not optional in an adjudication — a judgement nobody wrote down is indistinguishable from a check that never ran, and a DEFERRAL nobody wrote down is indistinguishable from a refresh that silently did nothing."
        }
      ],
      "skos:notation": "Task_RecordConflict",
      "dcterms:source": "large-datasets/processes/refresh-materialized.bpmn#Task_RecordConflict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_upstream",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "WORKING what changed upstream"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compare the recorded upstreamVersion against the source. `could not reach the source` is a THIRD answer and is never reported as `unchanged` — an unreachable source is the sourceLoss gate firing late. Reachability is asked by `bun run sources:liveness <instance>` against the node's resolvable IRI, its Handle first: live, gone, or could not determine, never live on an error (bean 08u4)."
        }
      ],
      "skos:notation": "Task_Upstream",
      "dcterms:source": "large-datasets/processes/refresh-materialized.bpmn#Task_Upstream",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_sampleimport.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialize remote content (the five gates)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared subprocess. It resolves the request against the source descriptor, then asks size, restrictions, copyright, retention and source loss, and either fetches with fixity or leaves the content referenced. This process does not restate any of that; it waits for the outcome."
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "large-datasets/processes/sample-import.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_sampleimport.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh materialized content"
        }
      ],
      "skos:definition": [
        {
          "@value": "Refresh is not re-import: what changed upstream, what changed locally since, and what to do when both did. The shared subprocess answers all three, and re-asks the five gates, since a licence can change and a collection can grow past the size agreed."
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "large-datasets/processes/sample-import.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_sampleimport.task_importtest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import into the store, and test the import"
        }
      ],
      "skos:definition": [
        {
          "@value": "The part only this process does. Load the landed sample into the chosen store and check what an import can get wrong: every item arrived (count against the request), identifiers survived (the descriptor's authoritative ones), structure validates against the store's schema, and provenance (source, revision, fixity) is attached to each node. A check that could not run is a failure, not a pass."
        }
      ],
      "skos:notation": "Task_ImportTest",
      "dcterms:source": "large-datasets/processes/sample-import.bpmn#Task_ImportTest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_sampleimport.task_library",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land it in library/"
        }
      ],
      "skos:definition": [
        {
          "@value": "A permanent sample joins the library as an L1 source, with the materialization record (purpose, gates, fixity) beside it. From here refresh-materialized governs it."
        }
      ],
      "skos:notation": "Task_Library",
      "dcterms:source": "large-datasets/processes/sample-import.bpmn#Task_Library",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_sampleimport.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what failed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which check failed, on which items, and the evidence. The landed copy is not removed: a failed import is information about the source or the store, and deleting the copy would destroy the evidence."
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "large-datasets/processes/sample-import.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_sampleimport.task_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the sample: which items, which store, and is it PERMANENT?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three answers, recorded before anything is fetched. WHICH ITEMS: named by the source's identifiers, or by a subset strategy its descriptor supports. WHICH STORE: the knowledge graph or other structured store the import is tested against. PERMANENT OR TRIAL: a permanent sample lands in library/ and is refreshed; a trial lands in fsh-guts/ and is not. The purpose materialize-remote asks for (working or archival) is asked there, not here."
        }
      ],
      "skos:notation": "Task_Scope",
      "dcterms:source": "large-datasets/processes/sample-import.bpmn#Task_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_sampleimport.task_trial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep it as a trial: the unpublished trashcan"
        }
      ],
      "skos:definition": [
        {
          "@value": "A trial goes to the kept trashcan: addressable, exported, never published. Its node declares `$schema: folio-fsh-guts/v1` and carries the bean or issue it was written under, since it was never moved from anywhere and a `movedFrom` would be invented provenance. It is NOT refreshed: a trial records what the source looked like when it was tried. Promoting a trial means running this process again with permanent = yes, so the gates are asked afresh."
        }
      ],
      "skos:notation": "Task_Trial",
      "dcterms:source": "large-datasets/processes/sample-import.bpmn#Task_Trial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialise the part [materialize-remote]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ONLY way bytes arrive. Purpose first, then the five gates — size, restrictions, copyright, retention, source loss — then fetch with fixity, or stay referenced with the refusing gate's basis recorded. Both ends of that subprocess return here and the walk continues: one part refused is not the subscription refused."
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh the held part [refresh-materialized]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared refresh, called, not re-described: what changed upstream, what changed locally, and what to do when both did. An archival copy is fixity-checked and never re-fetched. Whatever that process decides — refreshed, kept divergent, or deferred — is the part's new state; this loop only moves to the next part."
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose subgraphs, the asset policy, harnesses"
        }
      ],
      "skos:definition": [
        {
          "@value": "Written to the entry as `subgraphs`, `assets.policy` (none, on-demand or all) and `harnesses`. Choosing is not holding: a chosen subgraph is still referenced until the gates below let it through. Choosing nothing is legitimate — a subscription with no parts chosen is a pinned reference, the case associatedHarnesses covers today."
        }
      ],
      "skos:notation": "Task_Choose",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_instantiate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Instantiate the harness: write its config"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write `<harness>.config.json` at the repository root, plus the state directories the harness declares. That file is what harness-tiles reads as INSTANTIATED, and it is what puts the harness in the navbar's bottom region. check:instance-render must be green on the result; a config that renders nothing is an entry pointing nowhere."
        }
      ],
      "skos:notation": "Task_Instantiate",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_Instantiate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_pin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name the substrate, pin a full commit SHA"
        }
      ],
      "skos:definition": [
        {
          "@value": "`owner/repo` and a 40-character commit SHA — never a branch, never an abbreviated SHA. The schema refuses anything else (SubscriptionSchema.ref), and this step exists so the refusal is met while choosing rather than at commit time. A tag replaces the SHA only once the substrate publishes releases."
        }
      ],
      "skos:notation": "Task_Pin",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_Pin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the entry and cache the declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `subscriptions` entry in the subscriber's instance declaration — id, repository, ref, and nothing chosen yet — plus a cached copy of the substrate's declaration at the pin. The entry holds the choice and the pin, never state: whether a part is held is answered by its materialisation record, and a second answer here would be free to disagree with it."
        }
      ],
      "skos:notation": "Task_Record",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_refuse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record why it is not a substrate; write no entry"
        }
      ],
      "skos:definition": [
        {
          "@value": "No subscription entry is written for a repository that is not a substrate. What is recorded is the reason (non-conforming, no harness, or unreachable) and the pin it was asked at, so a later attempt at a different commit starts from what failed."
        }
      ],
      "skos:notation": "Task_Refuse",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_Refuse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_repin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move the entry's ref and re-cache the declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only after every held part has been through the refresh. Moving the ref first would make the records of parts not yet refreshed describe a commit the entry no longer names. The cached declaration is replaced so the review that follows shows what the NEW pin offers, including subgraphs that did not exist at the old one."
        }
      ],
      "skos:notation": "Task_RePin",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_RePin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review what the substrate offers"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every subgraph, asset class and harness the cached declaration names, each with its current state — referenced, materialised, unknown, stale, or refused by a gate. Shown whole, because a reader who sees only what was chosen cannot tell \"not offered\" from \"not taken\"."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_summarise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record how the walk ended, part by part"
        }
      ],
      "skos:definition": [
        {
          "@value": "One line per offered part: materialised, referenced by choice, or referenced because a gate refused (and which). Nothing new is decided here; it is the account the visualizer and the next refresh read, written once rather than reconstructed from the loop."
        }
      ],
      "skos:notation": "Task_Summarise",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_Summarise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities/process_subscribekg.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch the root declaration at the pin, and validate it"
        }
      ],
      "skos:definition": [
        {
          "@value": "A sparse, shallow fetch of the substrate's root declaration only. Two questions: does it parse as bootstrap's KnowledgeGraphDeclarationSchema, and does it declare at least one harness? `could not fetch` is a third answer and is never read as `conforms`."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "large-datasets/processes/subscribe-kg.bpmn#Task_Validate",
      "skos:note": "candidate"
    }
  ]
}
