          "value": "white"
        },
        {
          "property": "padding",
          "value": "10px 17px"
        },
        {
          "property": "border-radius",
          "value": "5px"
        },
        {
          "property": "position",
          "value": "relative"
        },
        {
          "property": "z-index",
          "value": "2"
        }
