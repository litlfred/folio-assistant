  "rules": [
    {
      "selector": "#ig-status.ig-status-draft",
      "from": "who.template.root",
      "declarations": [
        {
          "property": "background-image",
          "value": "url(\"data:image/svg+xml"
        },
        {
          "property": "http",
          "value": "//www.w3.org/2000/svg' width='150px' height='150px'><rect width='800%' height='100%' fill='transparent' /><text transform='translate(30, 50) rotate(-35)' fill='rgba(245,45,45,0.5)' font-family='Arial' font-weight='bold' font-size='20'>DRAFT</text></svg>\")"
        },
        {
          "property": "background-size",
          "value": "calc(50% / 5) 100px"
        },
        {
          "property": "background-repeat",
          "value": "repeat-x"
        }
      ]
    },
    {
      "selector": "#ig-status.ig-status-retired",
      "from": "who.template.root",
      "declarations": [
