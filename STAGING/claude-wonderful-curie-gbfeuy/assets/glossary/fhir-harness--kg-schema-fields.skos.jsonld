      ],
      "skos:definition": [
        {
          "@value": "Where it was seen. `min(1)` rather than `min(2)`: a `shape` conflict needs two layers by definition, but a `malformed` value needs only one, and requiring two would have made the second kind unrepresentable in the schema written to hold it."
        }
      ],
      "dcterms:source": "fhir-harness/schemas/ig-chrome.ts#IgChromeConflictSchema.sites",
