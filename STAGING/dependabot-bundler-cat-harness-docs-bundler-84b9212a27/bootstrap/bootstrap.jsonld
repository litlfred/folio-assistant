    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-bundler-cat-harness-docs-bundler-84b9212a27/bootstrap/bootstrap.jsonld#role/knowledge-graph-data-store",
      "@type": "https://litlfred.github.io/folio-assistant/bootstrap/ns#Role",
      "name": "knowledge-graph-data-store",
      "title": "Knowledge Graph Data Store",
      "description": "A git repository, reached either through the git CLI or through a forge's API. It is where a declaration and its graph are READ from and where a new instance's declaration is WRITTEN to. It is `actedUpon`: it holds and serves, and takes no part in deciding what should happen — which is why it carries no skills and why naming one for it would be a lie about what it does.",
      "sourceKind": "role-registry",
      "actorKinds": [
        "system"
      ],
      "actedUpon": true,
      "hasSkill": [],
      "alternateOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#role/knowledge-graph-data-store"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-bundler-cat-harness-docs-bundler-84b9212a27/bootstrap/bootstrap.jsonld#role/requestor",
      "@type": "https://litlfred.github.io/folio-assistant/bootstrap/ns#Role",
      "name": "requestor",
      "title": "Requestor",
      "description": "Wants to initialize — or bootstrap, or install, or load, or harness — a harness: bootstrap itself, or any Harness built on it. Carries no skills deliberately: WHICH harness this repository should become is a judgement about intent, and no instruction body produces it. The Bootstrapping Agent may narrow the list from context; only the Requestor settles it.",
      "sourceKind": "role-registry",
      "actorKinds": [
        "person"
      ],
      "judgementOnly": true,
      "hasSkill": [],
      "alternateOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#role/requestor"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-bundler-cat-harness-docs-bundler-84b9212a27/bootstrap/bootstrap.jsonld#role/logger",
      "@type": "https://litlfred.github.io/folio-assistant/bootstrap/ns#Role",
      "name": "logger",
      "title": "Logger",
      "description": "A machine that accepts log messages and puts them somewhere a person can read. Like the Knowledge Graph Data Store it is `actedUpon` — it receives and records, takes no part in what happens next, and carries no skills, because the skill belongs to whoever is DOING the thing being logged. The Logger is not the author of a log line; it is where the line goes. That distinction is why `log-message` takes `actor` as a required input: the Logger cannot infer who acted, and a log that names the logger rather than the actor records nothing worth having.",
      "sourceKind": "role-registry",
      "actorKinds": [
        "system"
      ],
      "actedUpon": true,
      "hasSkill": [],
      "alternateOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#role/logger"
    },
