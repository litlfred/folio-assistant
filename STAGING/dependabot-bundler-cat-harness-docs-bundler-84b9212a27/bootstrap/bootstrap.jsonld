      "@id": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-bundler-cat-harness-docs-bundler-84b9212a27/bootstrap/bootstrap.jsonld#role/bootstrapping-agent",
      "@type": "https://litlfred.github.io/folio-assistant/bootstrap/ns#Role",
      "name": "bootstrapping-agent",
      "title": "Bootstrapping Agent",
      "description": "An agent asked to set up a Harness with ONLY the knowledge bootstrap/README.md hands it. That constraint is the role, not a caveat on it: a Bootstrapping Agent has no MCP server, no harness, no work plan and no skills beyond those bootstrap carries, and a step that assumes any of those is a step a Bootstrapping Agent cannot perform. It stops being a Bootstrapping Agent the moment the harness is installed and it re-enters through that harness instead.",
      "sourceKind": "role-registry",
      "actorKinds": [
        "agent"
      ],
      "hasSkill": [
