      "name": "agent-instructions",
      "path": "AGENTS.md",
      "assetRole": "agent-instructions",
      "title": "AGENTS.md — bootstrap",
      "description": "Phase one of two. Valid with nothing installed: no skills, no knowledge graph, no MCP, no beans. The default behaviour of initialisation is to copy this file, and the last bootstrap step re-enters through the installed harness, which is what supplies phase two. No `source` because this is the origin — an absent source means authored here, which is a different fact from an upstream that cannot be reached.",
      "alternateOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#asset/agent-instructions"
