      "name": "swimlane-glossary",
      "path": "glossary/",
      "holdsGraph": [
        "https://litlfred.github.io/folio-assistant/cat-harness/ns#graphKind/swimlane-glossary"
      ],
      "description": "The swimlane glossary's retirement ledger. Declared rather than hidden because a consumer must be able to find what this instance has ever called a term: the glossary document is regenerated from the corpus each run and has no memory, so the one fact that cannot be re-derived — that a concept was once minted — is committed here. Keyed by the IRI's local part, never the absolute IRI, because the publication base is a deploy-time variable and a stored absolute IRI would rot the day it moved.",
      "inSubgraph": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-bundler-cat-harness-docs-bundler-84b9212a27/bootstrap/bootstrap.jsonld#directory/swimlane-glossary",
