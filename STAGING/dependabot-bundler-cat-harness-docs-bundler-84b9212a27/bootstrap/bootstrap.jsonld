      "name": "models",
      "path": "models/",
      "holdsGraph": [
        "https://litlfred.github.io/folio-assistant/cat-harness/ns#graphKind/models"
      ],
      "description": "Which languages a model is good at, and whether anybody checked. In BOOTSTRAP for the reason everything else here is: an agent reaching for the language it should communicate in has not yet loaded the harness that would otherwise answer, so a registry one layer up would be unreachable in exactly the case it exists for. `context`: read when a session opens, never written by a process — a person grants a validation, an agent never does, because a model's own claim about its languages is the thing the validation state exists to distrust.",
      "inSubgraph": "https://litlfred.github.io/folio-assistant/STAGING/dependabot-bundler-cat-harness-docs-bundler-84b9212a27/bootstrap/bootstrap.jsonld#directory/models",
