  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/ig-ast-refresh.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Dispatch an IG repository's `ig-ast-refresh.yml`, which calls fhir-harness's reusable `.github/workflows/ig-ast-refresh.yml`: mount the layers the IG's index.lock.json pins, restore and judge the cache for `ref`, and when it is not valid (or `force`) run the caller's optional `pre-export` overlay command and build the IG with the pinned Publisher AST exporter (the AST is recorded against the clean commit's inputs, the overlay's changes put back), check the new AST is valid for its commit, and seed `cat/fhir-harness/fhir-ast/<package id>` with `ig-cache seed --push` — only from a commit on the default branch with the tip's inputs. Builds no site, writes no gh-pages, dispatches nothing.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "gh workflow run ig-ast-refresh.yml --repo <owner/repo> --ref main -f ref=main [-f force=true]"
      },
      "io": {
        "inputs": [
          {
            "description": "The IG repository that carries the caller (`owner/repo`).",
            "name": "repository",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
          },
          {
            "description": "What to build; default `main`. Only a commit on the default branch with the tip's inputs is seeded.",
            "name": "ref",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          },
          {
            "description": "Rebuild even when the cache is valid.",
            "name": "force",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "The run's verdict before (`valid`, `stale`, `cannot-tell`, `missing`) and whether it seeded; the AST as a run artifact when it did not.",
            "name": "result",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "ig-ast-refresh",
      "requirements": {
        "network": true,
        "runtime": [
          "gh"
        ]
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/fhir-harness/skill/ig-build-pipeline",
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/compiled-artefact-cache"
      ],
      "title": "Refresh an IG's AST cache on a runner"
    }
  ],
