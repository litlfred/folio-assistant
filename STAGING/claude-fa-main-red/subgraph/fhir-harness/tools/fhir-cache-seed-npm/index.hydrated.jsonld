      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/fhir-cache-seed-npm.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Fill `~/.fhir/packages` (or `--cache`) for an environment that cannot reach packages.fhir.org, from trust anchors only: npm account `grahamegrieve` (owner-trusted), publishers' own published-site repositories (the seeder's list, each fetch verified against the tarball's own package.json), template repos found through FHIR/ig-registry's templates.json read live each run, and an owner `--mirror`. Exact versions only (a patch wildcard resolves as the Publisher resolves it, recorded); every tarball verified; nothing computed once and kept; provenance recorded; missing versions listed, never substituted.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run fhir-harness/scripts/fhir-cache-seed-npm.ts [--cache <dir>] [--sushi-config <file>] [--mirror <dir|git-url>] [--template-repo <name=owner/repo>] [--site-repo <prefix=owner/repo[@branch]>] [--missing-out <file>] [--dry-run] [name#version ...]"
      },
      "io": {
        "inputs": [
          {
            "description": "Seed what this IG pins: its `dependencies:` and the core package for its `fhirVersion`.",
            "name": "sushi-config",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "description": "Default `~/.fhir/packages`, which SUSHI and the IG Publisher read.",
            "name": "cache",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "description": "Resolve and report; download nothing.",
            "name": "dry-run",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "description": "A directory or git repository of `<name>#<version>.tgz` filled by `fhir-package-mirror`.",
            "name": "mirror",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "description": "Write the missing list, one `name#version` per line: the input `fhir-package-mirror` takes.",
            "name": "missing-out",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          }
        ],
        "outputs": [
          {
            "name": "installed",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "description": "Exit 1 when any is missing. Each is listed with why: not on npm, a different version only, an untrusted maintainer, or not an exact version.",
            "name": "missing",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "fhir-cache-seed-npm",
      "requirements": {
        "network": true,
        "runtime": [
          "bun",
          "npm",
          "git"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/fhir-harness/skill/ig-publisher-fork",
      "title": "Seed the FHIR package cache from trusted sources (exact versions)"
    }
