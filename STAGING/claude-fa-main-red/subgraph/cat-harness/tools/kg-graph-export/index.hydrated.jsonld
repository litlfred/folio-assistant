{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/kg-graph-export/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/kg-graph-export.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Dump this instance's knowledge graph — skills, BPMN activities and their lanes, roles, actors, directories — to one JSON-LD document for publication. The export is data; something else draws it.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat kg:export"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--base-url"
            },
            "description": "Publication base the node IRIs are minted against; a preview passes its own.",
            "name": "baseUrl",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          },
          {
            "arg": {
              "flag": "--out"
            },
            "description": "Where to write; defaults to `_kg/<stub>.jsonld`, which is build output and gitignored.",
            "name": "out",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "The written JSON-LD document.",
            "name": "graph",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "Sources that could not be read, counted rather than silently omitted.",
            "name": "problems",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "kg-graph-export",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/kg-export",
        "https://litlfred.github.io/folio-assistant/bootstrap/skill/bootstrap-graph-emission",
        "https://litlfred.github.io/folio-assistant/bootstrap/skill/bootstrap-graph-publication"
      ],
      "title": "Knowledge-graph export"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/kg-graph-export",
  "path": "tools/kg-graph-export/"
}
