      "pageStart": 15,
      "pageEnd": 15,
      "target": "../sections/sec-010-national-health-workforce-accounts-concept-and-o.md",
      "narrative": null,
      "content": "overview",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Introduces the section presenting the conceptual foundation and modular structure of the National Health Workforce Accounts.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "antigravity",
          "model": "not-disclosed"
        },
