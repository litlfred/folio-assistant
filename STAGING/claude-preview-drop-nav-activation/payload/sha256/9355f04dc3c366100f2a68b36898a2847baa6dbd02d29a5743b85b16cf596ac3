      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Provides in Annex 4 the classification and definitions of health workforce occupation groups covered by the NHWA, mapped to four-digit International Standard Classification of Occupations (ISCO-08) codes.",
