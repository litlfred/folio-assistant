      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-preview-drop-nav-activation/bootstrap/role/logger",
      "@type": "bootstrap:Role",
      "label": "Logger",
      "description": "A machine that accepts log messages and puts them somewhere a person can read. It receives and records, and takes no part in what happens next. Its skill is its contract, `logger`: record a complete message unchanged and attributed to its actor (owner, 2026-10-16). Composing the message is a different skill, `log-message`, which belongs to whoever is DOING the thing being logged. The Logger is not the author of a log line; it is where the line goes. That distinction is why `log-message` takes `actor` as a required input: the Logger cannot infer who acted, and a log that names the logger rather than the actor records nothing worth having.",
      "source": "https://litlfred.github.io/folio-assistant/STAGING/claude-preview-drop-nav-activation/bootstrap/scenarios/roles.json",
      "isPartOf": "https://litlfred.github.io/folio-assistant/STAGING/claude-preview-drop-nav-activation/bootstrap/directory/scenarios",
