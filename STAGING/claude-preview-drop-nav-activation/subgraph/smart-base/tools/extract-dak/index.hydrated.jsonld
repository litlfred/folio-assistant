{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/smart-base/tools/extract-dak/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "http://smart.who.int/base/tools/extract-dak.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Run WHO's `extract_dak.py` in a DAK or IG repository: it reads the DAK template spreadsheets (`input/decision-logic/*.xlsx` via `dt_extractor`, `input/system-requirements/*.xlsx` via `req_extractor`, `input/dictionary/*.xlsx` via `dd_extractor`) and the BPMN, and writes the DMN decision tables, the CPG recommendation PlanDefinitions with their citations, CQL library skeletons, Requirements and logical-model FSH. The authoring path the WHO IG Starter Kit (`l3_decisiontables`, `l3_cql`) prescribes: an adapted decision or scheduling table is an edited copy of the upstream DAK's spreadsheet, never a parallel format.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "python3 $SMART_BASE_HOME/input/scripts/extract_dak.py"
      },
      "io": {
        "inputs": [
          {
            "description": "The working directory: a DAK or IG repository holding `input/decision-logic/`, `input/system-requirements/` and `input/dictionary/` spreadsheets in the DAK template layout.",
            "name": "dakRepository",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          }
        ],
        "outputs": [
          {
            "description": "Decision tables in the DAK DMN format (namespace `https://www.omg.org/spec/DMN/20240513/MODEL/`), each with an `Annotations` and a `Reference(s)` output.",
            "name": "dmn",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "PlanDefinition, ActivityDefinition, Requirements and logical-model FSH, for SUSHI to compile.",
            "name": "fsh",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "CQL library skeletons, one per decision table, with the definitions already present in `input/cql/` carried over.",
            "name": "cql",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "extract-dak",
      "requirements": {
        "network": false,
        "runtime": [
          "python3"
        ]
      },
      "satisfies": "http://smart.who.int/base/skill/smart-base-tools",
      "title": "DAK spreadsheets → DMN, PlanDefinitions, CQL, requirements, logical models"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/extract-dak",
  "path": "tools/extract-dak/"
}
