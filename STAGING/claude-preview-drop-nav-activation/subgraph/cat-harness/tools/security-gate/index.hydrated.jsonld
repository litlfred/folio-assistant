  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/security-gate.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Run the repository's security checks — workflow injection, secret leaks, lockfile pinning, the toolchain pin, QA reviewer permission, materialised-asset fixity — plus two advisories (dependency advisories, third-party action SHA pinning), each by name as argv. Every check is reported as pass, fail or unknown; a blocking check that fails OR could not be run refuses the release, because could-not-check is never clean. Advisories are reported and never block. Called by `prepare-merge` before a push that will merge, and by any publish process before it publishes.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat security:gate"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--json"
            },
            "description": "Print a `folio-security-gate/v1` result on stdout instead of the human report.",
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Whether a blocking check failed or could not be run; also the exit status (1 when blocked).",
            "name": "blocked",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ]
      },
      "name": "security-gate",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/security",
      "title": "Run every existing security check as one named release step"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
