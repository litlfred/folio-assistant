      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/declaration-resolution.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Read every instance declaration in the checkout and resolve what it names: `directories` (and those declared from within) through `check:declared-dirs`, `assets` through `check:declared-assets`, `visualisers[].renderedBy` through `check:visualiser-routes`, `needs` through the instance-graph resolver, and `visualisers[].coversKinds` against the graph typologies registered IN THIS CHECKOUT — its own and those a mounted layer contributes, read from the checkout under inspection rather than from where the harness module sits (lesson 6). A declaration that does not parse is a finding. One verdict per instance and field, naming the gate that decided it. Exit 0 every reference resolves, 1 one does not, 2 could not determine; a certain finding is reported before anything undetermined.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat check:declaration-resolution"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--root"
            },
            "description": "The checkout to check; the script re-runs itself there, so kinds are read from it. Default: the working directory.",
            "name": "root",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "description": "Print the report as JSON.",
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Unresolved references per instance and field, and what could not be determined; entries examined per field.",
            "name": "findings",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "declaration-resolution",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/kg-separation",
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/kg-affordances"
      ],
      "title": "Every path a declaration names resolves — directories, assets, visualisers, needs"
    }
