  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/sub-kg-verify-clone.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Clone a separated sub-KG's repository (with submodules, and any sibling checkouts it needs) into an empty scratch directory, install, and run its gates: its `gates` script, else its `test` script (a person may pass `--gate` on the command line instead; it is not part of this contract because it is a shell command). Reports `green`, `red` or `unknown`; an empty tree, a failed clone or a repository with no gate is `unknown`, never green. Catches what a rehearsal inside this checkout cannot, because a rehearsal shares this checkout's `node_modules` and environment (#2082). Writes only inside the scratch directory.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat sub-kg:verify-clone"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--repo"
            },
            "description": "The separated repository, `owner/name`. (The script also takes a git URL or a local path, for tests.)",
            "name": "repo",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
          },
          {
            "arg": {
              "flag": "--ref"
            },
            "description": "The branch or tag to clone, e.g. the seeding PR's branch.",
            "name": "ref",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          },
          {
            "arg": {
              "flag": "--sibling"
            },
            "description": "A repository to clone beside it, for a platform linked as a sibling checkout. Repeatable.",
            "name": "sibling",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
          },
          {
            "arg": {
              "flag": "--work"
            },
            "description": "Scratch directory, kept afterwards. Absent: a temporary directory, removed afterwards.",
            "name": "work",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--text"
            },
            "description": "A report for a person instead of JSON.",
            "name": "text",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "`sub-kg-verify-clone/v1`: the commit cloned, each step with its status and output tail, and the verdict. Exit 0 green, 1 red, 2 unknown.",
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "sub-kg-verify-clone",
      "requirements": {
        "network": true,
        "runtime": [
          "bun",
          "git"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/sub-kg-lifecycle",
      "title": "Verify a separated repository from a fresh clone"
    }
  ],
