{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/kg-audit/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/kg-audit.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Audit every join in the actor→role→skill→task sentence and write a committed QA sidecar per node. A printed verdict is gone; a sidecar is what makes \"unbound since it was drawn\" distinguishable from \"broken in the commit under review\".",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat kg:audit"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--check"
            },
            "description": "Compare against the committed sidecars and fail on a critical finding or a stale one, instead of writing.",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--strict"
            },
            "description": "Promote `major` to failing as well. Not what CI runs; see the note on constant-red checks in `remote-skill-servable.test.ts`.",
            "name": "strict",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "The QA tree, mirroring each subject's own path — flat would collide, since several basenames already occur twice.",
            "name": "sidecars",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "critical, major, minor — or none. `unknown` findings are never a pass.",
            "name": "worstSeverity",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "kg-audit",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/code-node-review",
      "title": "Knowledge-graph audit"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/kg-audit",
  "path": "tools/kg-audit/"
}
