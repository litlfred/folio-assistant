      "@type": "cat-harness:Tool",
      "description": "Push a rendered Knowledge Graph to GitHub Pages at a publication root URL — a staging preview (`STAGING/<slug>/`) or the release root, the same steps either way — and report the push: a status (pushed, not pushed, could not determine) and one message carrying the commit merged onto `gh-pages` and the QA result. Its steps are bootstrap-tools' `render-kg-to-github-pages` process, which first provisions the target: an orphan `gh-pages` branch, then Pages switched on to serve it.",
      "install": {
        "none": true
      },
      "invoke": {
        "manual": true
      },
      "io": {
        "inputs": [
          {
            "description": "The instance root whose Knowledge Graph is rendered, or a tree a caller already rendered and verified.",
            "name": "root",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
