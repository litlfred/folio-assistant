            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          },
          {
            "description": "A declared directory id to render; repeatable. Absent: the whole graph.",
            "name": "subgraph",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "description": "The commit that is live: the commit on `gh-pages`.",
            "name": "sha",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/CommitSha"
          }
        ],
        "outputs": [
          {
            "description": "`pushed`, `not-pushed` or `could-not-determine` — never `pushed` over a check that could not look.",
            "name": "status",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "One line: the live commit, the root URL, and the QA of both what was staged and what is served.",
            "name": "message",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
