            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "-l"
            },
            "name": "language",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Locale"
          }
        ],
        "outputs": [
          {
            "description": "Timed transcript under the entry's `transcript/`.",
            "name": "transcript",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "transcribe-whisper-cpp",
