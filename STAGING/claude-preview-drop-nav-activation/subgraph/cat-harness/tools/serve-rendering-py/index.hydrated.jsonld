      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/serve-rendering-py.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Serve an instance's renderings over local HTTP with their declared media types using Python 3 standard library. The publication host wherever GitHub Pages is absent, and the only host that can enforce `application/ld+json` at all.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat serve:rendering:py"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--dir"
            },
            "description": "Tree to serve; defaults to the built site when present.",
            "name": "directory",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--port"
            },
            "description": "0 binds a free port, which is what the tests use.",
            "name": "port",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Port"
          }
        ],
        "outputs": [
          {
            "description": "Where the tree is being served.",
            "name": "url",
            "render": {
              "as": "url",
              "reason": "a reader opens it; the scheme is checked before it reaches an href"
            },
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          }
        ]
      },
      "name": "serve-rendering-py",
      "requirements": {
        "network": false,
        "runtime": [
          "python3"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/serving-renderings",
      "title": "Local rendering server (Python)"
    }
  ],
  "holdsGraph": [
