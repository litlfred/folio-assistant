{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/render-order/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/render-order.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Flatten the repository's renders into the order their `needs` imply, and optionally run them. Two stages: the current declared state as json/jsonld and the README derived from it are FATAL; the dynamic renderers (viewers, visualisers, doc pages, diagrams) skip and log; the dynamic-state export closes it. A cycle or a missing dependency yields NO order rather than a partial one.",
      "install": {
        "none": true
      },
      "invoke": {
        "inProcess": {
          "module": "src/tools/render-order.ts"
        },
        "mcp": {
          "tool": "render_order"
        },
        "shell": "bun run cat render"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--dry-run"
            },
            "description": "Print the flattened order and each step's failure policy without running anything.",
            "name": "dry_run",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Per step: ran, failed, skipped, or PENDING — declared with no implementation yet, which is never rendered as a pass.",
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ]
      },
      "name": "render-order",
      "requirements": {
        "network": false
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/docs-generation",
      "title": "The render pipeline, in dependency order"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/render-order",
  "path": "tools/render-order/"
}
