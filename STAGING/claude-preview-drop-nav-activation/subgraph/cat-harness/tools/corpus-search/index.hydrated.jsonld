      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/corpus-search.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Seed lexically over the authored folio and every declared library, then expand along graph edges, labelling each hit MATCHED or REACHED and by which edge. Counts are split authored vs ingested, and a root that exists but holds no graph nodes is reported rather than read as an empty answer.",
      "install": {
        "none": true
      },
      "invoke": {
        "inProcess": {
          "module": "src/tools/graph.ts"
        },
        "mcp": {
          "tool": "corpus_search"
        }
      },
      "io": {
        "inputs": [
          {
            "description": "Words to seed on. Seeding is lexical, so a short phrase works; a long query no node contains seeds nothing.",
            "name": "query",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "Expansion depth, 0-4 (default 1). 0 is a plain lexical search.",
            "name": "hops",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "description": "`out`, `in` or `both` (default).",
            "name": "direction",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "description": "`authored` or `ingested`: restricts the seeds, not the expansion.",
            "name": "provenance",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "description": "Also seed on companion Markdown bodies.",
            "name": "searchText",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "description": "Seed cap before expansion (default 20).",
            "name": "limit",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ],
        "outputs": [
          {
            "description": "JSON: summary, emptyRoots, dangling, and hits each carrying a `why`.",
            "name": "result",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ]
      },
      "name": "corpus-search",
      "requirements": {
        "network": false
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/corpus-grep",
      "title": "Search the corpus and follow the graph"
    }
