{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/search-graph/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/search-graph.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Find graph nodes, authored or ingested, whose label, title, kind or tags contain a string, with no graph expansion. corpus-search composes this with a neighbour walk.",
      "install": {
        "none": true
      },
      "invoke": {
        "inProcess": {
          "module": "src/tools/graph.ts"
        },
        "mcp": {
          "tool": "search_graph"
        }
      },
      "io": {
        "inputs": [
          {
            "description": "Substring to look for.",
            "name": "query",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "`authored` or `ingested`. Omit for both.",
            "name": "provenance",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "description": "Also scan companion Markdown bodies.",
            "name": "searchText",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "description": "Max hits (default 20).",
            "name": "limit",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ],
        "outputs": [
          {
            "description": "JSON: the matching nodes and which field matched.",
            "name": "result",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ]
      },
      "name": "search-graph",
      "requirements": {
        "network": false
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/corpus-grep",
      "title": "Lexical search over the content graph"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/search-graph",
  "path": "tools/search-graph/"
}
