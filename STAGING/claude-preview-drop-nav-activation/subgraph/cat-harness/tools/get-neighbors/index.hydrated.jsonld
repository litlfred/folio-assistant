            "description": "Node @id or authored label, e.g. `thm:main`.",
            "name": "id",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "`out` (default), `in` or `both`.",
            "name": "direction",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "description": "Traversal depth, 1-6 (default 1).",
            "name": "hops",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "description": "A LIST of edge terms (uses, interprets, cites, contains, ...) to restrict to. Omit for all.",
            "name": "edges",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ],
        "outputs": [
          {
            "description": "JSON: the neighbours, each with the edge path that reached it.",
            "name": "result",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ]
      },
