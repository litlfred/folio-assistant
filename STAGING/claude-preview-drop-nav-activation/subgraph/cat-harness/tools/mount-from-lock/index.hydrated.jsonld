{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/mount-from-lock/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/mount-from-lock.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Lay down every remote mount `index.lock.json` records — each instance fetched at the lock's full SHA (sparse, blob-filtered), each directory verified against its `treeDigest`, a mismatch undone and reported — importing only `node:*`, so it runs on a fresh clone before any layer is present. It never decides what to mount: `remote-mount` writes the lock (and checks trust); this only replays it. Refuses to write over a path with tracked files or bytes that no longer hash to the lock. Exit 0 mounted/current, 1 missing, 2 could-not-determine.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat mount:lock"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--root"
            },
            "description": "The instance root whose lock is replayed. Default: the working directory.",
            "name": "root",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--check"
            },
            "description": "No network: is every locked mount on disk and intact?",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Per instance: mounted, current, missing or could-not-determine.",
            "name": "outcomes",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "mount-from-lock",
      "requirements": {
        "network": true,
        "runtime": [
          "bun",
          "git"
        ]
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/remote-mount",
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/kg-separation"
      ],
      "title": "Replay a committed mount lock with nothing but Node"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/mount-from-lock",
  "path": "tools/mount-from-lock/"
}
