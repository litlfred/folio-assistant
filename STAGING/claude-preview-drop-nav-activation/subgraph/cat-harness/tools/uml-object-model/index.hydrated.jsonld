{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/uml-object-model/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/uml-object-model.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Draw the harness object model (Actor, Role, Skill, Process, Task, Todo, Bean, tests, schemas) with every attribute read from the schema behind it. Each relationship names the field that carries it, and the generator refuses to write if that field is gone.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat uml:object-model"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--check"
            },
            "description": "Fail if the committed diagram is stale. Needs the beans CLI; without it the result is could-not-check (exit 2).",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "The object-model diagram, in the instance's declared uml directory.",
            "name": "diagram",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "uml-object-model",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/uml-overview",
      "title": "Harness object model as PlantUML"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/uml-object-model",
  "path": "tools/uml-object-model/"
