      "@type": "cat-harness:Tool",
      "description": "The gate for the `archimate` graph typology: every model `cat-archimate.config.json` names is held, parses (Archi's native XML or its zipped archive), and resolves — every box in every view draws an element the model holds, every relationship's ends are in the model — and no `.archimate` file is held that the config does not name.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat archimate:validate"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--instance"
            },
            "description": "The instance root whose `archimate` directory is checked.",
            "name": "instance",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "One line per problem on stderr, exit 1; or one ✓ line, exit 0.",
            "name": "problems",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "archimate-check",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/archimate-models",
      "title": "Check an instance's ArchiMate models against its config"
    }
  ],
