      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/ig-folio-site-workflow.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Dispatch the IG repository's `folio-site.yml` (copied from the IG layer's `ig-repo-site` template): on a runner it composes the harness chrome for THIS instance (`compose-docs --shell --instance`, `gen-navbar-include`), composes the IG at the root of that Jekyll shell (`stage-ig-sites --compose-at-root`), builds it with Jekyll so every IG page wears the theme's side bar, search box and icon row, publishes the instance's served directories, rails any page Jekyll did not lay out (`rail-standalone-pages --foreign-site --instance`), stamps the platform that built it (`folio-build.json`), and on the default branch deploys the whole site to the `gh-pages` root. It reports platform drift against sibling sites and re-dispatches the IGs this one depends on when a token allows.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "gh workflow run folio-site.yml"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "-R"
            },
            "description": "The IG repository whose workflow to dispatch. Default: the current repository.",
            "name": "repo",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
          },
          {
            "arg": {
              "flag": "--ref"
            },
            "description": "The branch to build. Only the default branch deploys; any other builds and reports.",
            "name": "ref",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          }
        ],
        "outputs": [
          {
            "description": "The dispatch, and the run it starts; the site is served once that run and GitHub's Pages deploy have finished.",
            "name": "status",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "ig-folio-site-workflow",
      "requirements": {
        "network": true,
        "runtime": [
          "gh"
        ]
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/feature-staging",
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/harness-tiles"
      ],
      "title": "Build and publish an IG repository's own site with its folio-site.yml workflow"
    }
