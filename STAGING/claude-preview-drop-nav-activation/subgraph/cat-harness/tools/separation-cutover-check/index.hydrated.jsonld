  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/separation-cutover-check.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Run in a separated repository. Six conditions, each decided by an existing gate: `mounts` (every declared layer on disk at its pin — `remote-mount --check`), `declarations` (every path a declaration names resolves — `declaration-resolution`), `monorepo-paths` (no wiring still names the monorepo: `livesAt` on it, a submodule of it, a reusable workflow called from it, a path into its old checkout — the one condition implemented here), `import-direction` and `reference-direction` (no layer reaches a layer above it), and `site` (the site builds from the mounts alone, every link resolving — `build-instance-site --no-mount`, only with `--site`). Findings inside a MOUNTED layer are listed and not counted: a defect in a layer pinned from upstream is fixed upstream and re-pinned. Exit 0 complete, 1 a condition failed, 2 a condition could not be determined or was not run — without `--site` the answer is never 0.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat separation:cutover:check"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--root"
            },
            "description": "The separated checkout. Default: the working directory.",
            "name": "root",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--site"
            },
            "description": "Build the site from the mounts on disk (minutes); without it the `site` condition is not run and the verdict cannot be complete.",
            "name": "site",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--monorepo"
            },
            "description": "The repository the separation left, `<owner>/<repo>`. Default: litlfred/folio-assistant.",
            "name": "monorepo",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
          },
          {
            "arg": {
              "flag": "--monorepo-dir"
            },
            "description": "Its old checkout directory name, as paths spell it. Default: the repository's name.",
            "name": "monorepoDir",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "description": "Print the report as JSON, mounted-layer findings included.",
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Per condition: pass, fail, could-not-determine or not-run, the gate that decided it, and its findings.",
            "name": "conditions",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "separation-cutover-check",
      "requirements": {
        "network": false,
        "runtime": [
          "bun",
          "git"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/kg-separation",
      "title": "Is this repository's cutover from the monorepo complete? Measured, condition by condition"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
