            },
            "description": "The review comment's id, `review-pr<N>-c<commentId>`.",
            "name": "id",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/NodeId"
          },
          {
            "arg": {
              "flag": "--to"
            },
            "description": "The status to move it to: open, addressed, resolved, adjudicated or withdrawn. Checked against the closed list by the script; the list is core vocabulary, so it is not a harness Tool type.",
