{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness-tools/tools/bpmn-engine/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/tools/bpmn-engine.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Run a declared BPMN process as an instance: `workflow_start` opens one for a subject, `workflow_next` reports what is enabled, `workflow_complete` records a step or answers a decision (a DMN-computed one from `facts`) and REFUSES a step that is not enabled. State is committed under the work plan, so which edge was taken is a record, not a memory.",
      "install": {
        "none": true
      },
      "invoke": {
        "inProcess": {
          "module": "src/tools/workflow.ts",
          "register": "registerWorkflowTools"
        },
        "mcp": {
          "tool": "workflow_*"
        }
      },
      "io": {
        "inputs": [
          {
            "description": "The process to run: a diagram's file stem or its `bpmn:process` id.",
            "name": "process",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/ProcessId"
          },
          {
            "description": "The step or decision to complete, as `workflow_next` reported it.",
            "name": "node",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/NodeId"
          }
        ],
        "outputs": [
          {
            "description": "What may be worked next, after each call.",
            "name": "enabled",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/NodeId"
          }
        ]
      },
      "name": "bpmn-engine",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/process-state",
      "title": "BPMN workflow engine"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/code",
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/bpmn-engine",
  "path": "tools/bpmn-engine/"
}
