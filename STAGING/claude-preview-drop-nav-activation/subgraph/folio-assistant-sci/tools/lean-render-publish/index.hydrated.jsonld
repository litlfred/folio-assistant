  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/lean-render-publish.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Stage a doc-gen4 render under a folio's built site (`<site>/<route>/`, default `lean/`) and give every page the harness navbar and rail by running `cat-harness/scripts/rail-standalone-pages.ts --foreign-site` over the site — the same rail `stage-folio-local.ts` applies to the folio's own pages. Leaves out Lake's `.hash`/`.trace` bookkeeping, marks doc-gen4's iframe navbar and `find/` redirect `folio-navbar: none` so no rail is drawn inside the sidebar, adds a layout shim so the rail does not cover doc-gen4's fixed sidebar, and with `--modules` prunes to the folio's own modules, repointing links into dropped ones to the community docs. Then asserts every staged page is railed or declined.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-sci/adapters/paper/lean/lean-render.ts"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--docs"
            },
            "description": "The doc-gen4 render, `lean-html-docs`'s output.",
            "name": "docs",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--site"
            },
            "description": "The folio's built site (`_site` from build-folio-site.ts).",
            "name": "site",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--route"
            },
            "description": "Where under the site. Default `lean`.",
            "name": "route",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--module"
            },
            "description": "A Lake package whose module root to keep (`qou` keeps `QOU/`, matched case-insensitively). Repeat for several. Default: keep everything.",
            "name": "module",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/PackageName"
          },
          {
            "arg": {
              "flag": "--external-base"
            },
            "description": "Where links into pruned modules go. Default the community mathlib4 docs.",
            "name": "externalBase",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          },
          {
            "arg": {
              "flag": "--home-label"
            },
            "description": "The rail's home row: the folio's instance name, e.g. `qou`.",
            "name": "homeLabel",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/InstanceId"
          },
          {
            "arg": {
              "flag": "--instance"
            },
            "description": "Rail as this instance's own site (its name, mark and graphs), as rail-standalone-pages.ts --instance.",
            "name": "instance",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/InstanceId"
          },
          {
            "arg": {
              "flag": "--platform"
            },
            "description": "The index checkout holding the rail pass. Default `$FOLIO_ASSISTANT_ROOT`, then the nearest ancestor that has it.",
            "name": "platform",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--no-rail"
            },
            "description": "Stage only; the caller rails the site itself.",
            "name": "noRail",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "`<site>/<route>/`, railed, plus the rail's shared data under `<site>/assets/navbar/`.",
            "name": "pages",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "lean-render-publish",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/skill/lean-html-docs",
      "title": "Publish a Lean render under a folio site, with the harness rail"
