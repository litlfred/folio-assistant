{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "bs": "https://litlfred.github.io/folio-assistant/bootstrap/ns#",
    "cat": "https://litlfred.github.io/folio-assistant/cat-harness/ns#",
    "fac": "https://litlfred.github.io/folio-assistant/folio-assist-core/ns#",
    "label": "rdfs:label",
    "comment": "rdfs:comment",
    "isDefinedBy": {
      "@id": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "seeAlso": {
      "@id": "rdfs:seeAlso",
      "@type": "@id"
    }
  },
  "@id": "https://litlfred.github.io/folio-assistant/folio-assist-core/ns",
  "@type": "owl:Ontology",
  "label": "folio-assistant vocabulary (core only)",
  "comment": "Every class and property the folio knowledge graph projects, one node each. Generated by scripts/ns-export.ts; graph-kind definitions are read from the declaration registry rather than restated here.",
  "@graph": [
    {
      "@id": "fac:Image",
      "@type": "rdfs:Class",
      "label": "Image",
      "comment": "A declared picture belonging to an instance, carrying its role, its layout and any text region.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:FolioGraph",
      "@type": "rdfs:Class",
      "label": "FolioGraph",
      "comment": "Authored content — the folio itself, rendered to a website.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core",
      "seeAlso": "https://litlfred.github.io/content-types.html"
    },
    {
      "@id": "fac:PreviewGraph",
      "@type": "rdfs:Class",
      "label": "PreviewGraph",
      "comment": "A staging target: the same folio built for review rather than for release.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:UnknownGraph",
      "@type": "rdfs:Class",
      "label": "UnknownGraph",
      "comment": "A declared graph kind nothing recognises — reported as its own state, never silently treated as empty.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:LibraryGraph",
      "@type": "rdfs:Class",
      "label": "LibraryGraph",
      "comment": "L1 source content — one `<bib-slug>/` per ingested document, holding `sections/*.md`, `structure.json` and, where the source was scanned, `ocr/page-NNN.txt`. Every knowledge-graph reference to a source resolves through here, never to a loose path or a bare URL.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:TodoFeedbackGraph",
      "@type": "rdfs:Class",
      "label": "TodoFeedbackGraph",
      "comment": "Feedback items — todos raised against a specific block, carrying the submitter's identity. Read by the `todo-review` skill.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:TodoGraph",
      "@type": "rdfs:Class",
      "label": "TodoGraph",
      "comment": "Human actors' outstanding work — content, owned by the folio, tagged by role, process, task and identity. Its inner directories are declared by `todos/todos.json`.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:TodoItemsGraph",
      "@type": "rdfs:Class",
      "label": "TodoItemsGraph",
      "comment": "Todo nodes — one file each, carrying `\"$schema\": \"folio-todo/v1\"`. Authored by people and by agents on their behalf.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:UploadsGraph",
      "@type": "rdfs:Class",
      "label": "UploadsGraph",
      "comment": "The incoming queue — raw files as dropped, before ingestion. NOT L1, and not greppable as corpus: a document here reads as absent to every consumer.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    },
    {
      "@id": "fac:VoiceGraph",
      "@type": "rdfs:Class",
      "label": "VoiceGraph",
      "comment": "Editorial voice profiles — one JSON each, carrying `\"$schema\": \"folio-voice/v1\"`. Every rule cites the ingested source or KG node it was derived from. Opt-in per folio.",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "core"
    }
  ]
}
