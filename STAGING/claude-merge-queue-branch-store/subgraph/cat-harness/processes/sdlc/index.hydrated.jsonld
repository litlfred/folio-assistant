      "startNode": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#process/Process_OptionsAnalysis/node/Start_Process_OptionsAnalysis",
      "summary": "A decision reached by a NAMED methodology, with its rejected options recorded."
    },
