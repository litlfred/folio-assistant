    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/bootstrap/process/Process_Discussion/node/Start_Discussion",
      "@type": "bootstrap:ProcessNode",
      "label": "Which harness, and where, is not known",
      "type": "bpmn:startEvent",
