  "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/tools/gates.jsonld",
  "partOf": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/cat-harness.jsonld",
  "staging": {
    "branch": "claude/repin-core-phw-fhir-iris",
    "sha": "eebaeac4cf5f588a78fb6cb48538c60f1b23abd1",
    "pr": "2869/merge",
    "run": "41293948968"
  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/tools/gates.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "gates",
      "title": "The platform's quality gates",
      "description": "Run the checks CI runs, derived from the workflow rather than listed here. One Tool for all of them, not one per gate: the list is computed from `.github/workflows/code-quality-gates.yml` at call time, so it cannot drift from what CI actually enforces.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat gates"
      },
      "io": {
        "inputs": [
          {
            "name": "all",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Add the jobs that need a browser; the default is the fast set.",
            "required": false,
            "arg": {
              "flag": "--all"
            }
          },
          {
            "name": "list",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Print the derived gates and exit, running none.",
            "required": false,
            "arg": {
              "flag": "--list"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "One line per gate, then a pass count or the failures. Three exit codes, because two cannot carry the distinction: 0 every gate passed, 1 a gate failed, 2 the gate set could NOT BE DERIVED — the workflow it reads is absent or yields nothing. A caller must not read 2 as either verdict; it matters most downstream, where this Tool is inherited and `.github/workflows/` is not."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/skill/platform-gates",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/skill/prepare-merge",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-core-phw-fhir-iris/cat-harness/skill/continual-progress"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/gates.jsonld"
    }
  ]
}
