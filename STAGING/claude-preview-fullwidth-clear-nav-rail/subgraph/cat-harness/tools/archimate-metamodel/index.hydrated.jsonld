      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/archimate-metamodel.jsonld",
      "@type": "cat-harness:Tool",
      "description": "For each model an instance's `cat-archimate.config.json` names: the element types it uses, with counts; every (source type, relationship, target type) pattern its relationships follow, with counts and ids; whether ArchiMate's relationship table (Appendix B of ArchiMate 3.2, as Archi holds it, committed as `archimate/schemas/archimate-relationships.json` in the tools layer) allows each pattern; and the placeholder elements, named after their own type, that a hand-drawn metamodel leaves in a model. Prints a report, JSON, Graphviz DOT or a Mermaid class diagram. `archimate-pages` draws the same result on each model's \"Metamodel in use\" page, so the metamodel is derived, never drawn.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat archimate:metamodel"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--instance"
            },
            "description": "The instance root whose ArchiMate models are read.",
            "name": "instance",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--model"
            },
            "description": "One model's id from the config; absent, every model. Required for `--format dot` and `mmd`.",
            "name": "model",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/ArchimateModelId"
          },
          {
            "arg": {
              "flag": "--format"
            },
            "description": "`text` (default), `json`, `dot` or `mmd`.",
            "name": "format",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/ArchimateMetamodelFormat"
          },
          {
            "arg": {
              "flag": "--check"
            },
            "description": "Exit 1 when any relationship follows a pattern ArchiMate does not allow. Placeholders are reported, never fatal.",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "The report, or the metamodel as `archimate-metamodel/v1` JSON, DOT or Mermaid, on stdout.",
            "name": "metamodel",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
