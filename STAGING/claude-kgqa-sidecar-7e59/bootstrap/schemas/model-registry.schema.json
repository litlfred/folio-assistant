{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/bootstrap/schemas/model-registry.schema.json",
  "title": "Model Registry",
  "description": "Which languages a model is good at, and whether a person checked. Only `human-validated` is ever acted on, and only a person can grant it.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "folio-model-registry/v1"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "preferredLanguages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "validation": {
            "type": "string",
            "enum": [
              "unverified",
              "self-reported",
              "human-validated"
            ]
          },
          "validatedBy": {
            "type": "string"
          },
          "validatedOn": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "preferredLanguages",
          "validation"
        ]
      }
    }
  },
  "required": [
    "$schema",
    "models"
  ]
}
