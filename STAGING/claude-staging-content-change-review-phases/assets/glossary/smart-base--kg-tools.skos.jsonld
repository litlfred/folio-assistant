    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/extract-dak",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "DAK spreadsheets → DMN, PlanDefinitions, CQL, requirements, logical models"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run WHO's `extract_dak.py` in a DAK or IG repository: it reads the DAK template spreadsheets (`input/decision-logic/*.xlsx` via `dt_extractor`, `input/system-requirements/*.xlsx` via `req_extractor`, `input/dictionary/*.xlsx` via `dd_extractor`) and the BPMN, and writes the DMN decision tables, the CPG recommendation PlanDefinitions with their citations, CQL library skeletons, Requirements and logical-model FSH. The authoring path the WHO IG Starter Kit (`l3_decisiontables`, `l3_cql`) prescribes: an adapted decision or scheduling table is an edited copy of the upstream DAK's spreadsheet, never a parallel format."
        }
      ],
      "skos:notation": "extract-dak",
      "dcterms:source": "smart-base/tools/extract-dak/extract-dak.ts#extract-dak",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/immz-schedule-app-local",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the immunization schedule-check app locally, on a WHO or country adaptation IG"
        }
      ],
      "skos:definition": [
        {
          "@value": "Start the schedule-check web form from litlfred/awho-mcp on this machine: a HAPI FHIR server in Docker on 127.0.0.1, the WHO SMART Immunizations IG loaded, then a country adaptation IG after it (its decision-logic tables replace WHO's, and its country profile is generated from its `input/l2/dependencies.yaml`), the CQL cache warmed, and the form served on 127.0.0.1. Unbuilt IGs are built with SUSHI first, and each Library's CQL is embedded from `input/cql/` as the IG Publisher would. Re-running reuses a server already loaded from the same commits; `--down` stops both."
        }
      ],
      "skos:notation": "immz-schedule-app-local",
      "dcterms:source": "smart-base/tools/immz-schedule-app-local/immz-schedule-app-local.ts#immz-schedule-app-local",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/l1-extraction-pages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the L1 extraction viewer: a page per instance holding `l1-extraction` directories, and a hub"
        }
      ],
      "skos:definition": [
        {
          "@value": "For every visualiser an instance declares `renderedBy: l1-extraction-pages`, write the hub at `<locale>/<harness>/<id>/` and, with `subgraphs: \"instance\"`, one page per instance that declares an `l1-extraction` directory. Each shows what was extracted, read from the files by what they declare: the L1 statements (graph nodes carrying a `statement`, and an authored L1 source's `recommendations`), the candidate work list's counts, coverage and decisions, each graph document's nodes by type and edges by predicate (the L2 scenario candidates among them), the curation, mapping, vocabulary, exclusions and run context counted, and every file linked to its published copy (cat-harness's `library:viz`) when the site holds it and to its source at the pinned commit. A declared directory not on disk is reported UNKNOWN, never as zero."
        }
      ],
      "skos:notation": "l1-extraction-pages",
      "dcterms:source": "smart-base/tools/l1-extraction-pages/l1-extraction-pages.ts#l1-extraction-pages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/l1-recommendation-candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "L1 guideline → recommendation candidates (L1 3.0)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Find every normative sentence of an ingested `library/` entry (folio-assistant-core's `l1-coverage` markers), hint where a reading is uncertain, and propose the publication's identity. Given an agent's `l1-recommendation-curation/v1`, refuse a non-verbatim statement or an unknown location, and write the recommendations and remarks as an L1 3.0 graph, checked with `kg/src/validate.ts`, with coverage and the proposed (unsigned) exclusions."
        }
      ],
      "skos:notation": "l1-recommendation-candidates",
      "dcterms:source": "smart-base/tools/l1-recommendation-candidates/l1-recommendation-candidates.ts#l1-recommendation-candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/l1-recommendation-scenarios",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "L1 recommendations → L2 user-scenario candidates"
        }
      ],
      "skos:definition": [
        {
          "@value": "One smart-kg L2 `user-scenario` candidate per L1 recommendation, joined to a `persona` and a `business-process` by the edges smart-kg L2 already licenses, from an agent's `l1-scenario-mapping/v1`. Reuses the guide's own personas and processes, then smart-base's generic `DAK.Persona.*`; otherwise a glossary candidate or `could-not-determine`, each with a WARNING. Never invents a process."
        }
      ],
      "skos:notation": "l1-recommendation-scenarios",
      "dcterms:source": "smart-base/tools/l1-recommendation-scenarios/l1-recommendation-scenarios.ts#l1-recommendation-scenarios",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/l1-transcription-verbatim",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Authored L1 → verbatim against transcriptions and image narratives"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check authored L1 (`*.l1.yaml`, the measles pattern) for a source with no usable text layer: each statement must be verbatim in the image narrative (`images.json`) or the `transcription` block it names, every transcription word (digits aside) must be corroborated by the entry's text layer unless listed under `inspectionOnly`, and keys must be unique."
        }
      ],
      "skos:notation": "l1-transcription-verbatim",
      "dcterms:source": "smart-base/tools/l1-transcription-verbatim/l1-transcription-verbatim.ts#l1-transcription-verbatim",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/smart-fhir-cache-seed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the FHIR package cache, with WHO's published site as a source"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run fhir-harness's `fhir-cache-seed-npm` with smart-base's publisher-site rules (`SMART_PUBLISHER_SITE_REPOS`): `smart.who.int.*` packages are also read from WHO's published-site repository, each fetch verified against the tarball's own package.json. Every other source and check is the seeder's own."
        }
      ],
      "skos:notation": "smart-fhir-cache-seed",
      "dcterms:source": "smart-base/tools/smart-fhir-cache-seed/smart-fhir-cache-seed.ts#smart-fhir-cache-seed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/smart-liquid-variables",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "IG metadata → Liquid variables"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scan the Publisher's `output/` for `{ResourceType}-{id}.json` and emit a Liquid include assigning `smart__<ResourceType>__<id>__<category>__<key>` for each published resource."
        }
      ],
      "skos:notation": "smart-liquid-variables",
