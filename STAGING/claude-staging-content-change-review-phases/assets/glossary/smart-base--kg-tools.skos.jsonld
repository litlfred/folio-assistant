      "skos:definition": [
        {
          "@value": "Generate FHIR `Questionnaire` resources from a DAK's DMN decision tables. Authoring, not rendering: its output is validated and indexed by the IG Publisher like any other resource."
        }
      ],
      "skos:notation": "dmn-to-questionnaire",
