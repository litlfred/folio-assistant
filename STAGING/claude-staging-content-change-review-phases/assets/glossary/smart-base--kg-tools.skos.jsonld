      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools/terminology-lookup",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Reuse-first terminology and code-list lookup"
        }
      ],
      "skos:definition": [
        {
          "@value": "Look up a concept or code token for a semantic slot (`condition`, `intervention`, `persona`, `medicine`, `domain`, `business-process`, `recommendation-strength`, `recommendation-direction`, `evidence-certainty`) across the four reuse-first precedence rungs of the `terminology-coding` methodology: (1) target guide's `l1-scenario-vocabulary/v1`, (2) `smart-base` generic personas (`DAK.Persona.*`), GRADE `code-lists/*.json` and `guideline-domain` SKOS glossary, (3) local WHO/ILO FSH CodeSystems (`ISCO08`, `CDHIv2`, `CDHIv1`, `CDSCv2`, `KGTerminologySystem`), and (4) a proposed `glossary-terms` candidate (`status: \"candidate\"`) or `could-not-determine` for `business-process`."
        }
      ],
      "skos:notation": "terminology-lookup",
      "dcterms:source": "smart-base/tools/terminology-lookup/terminology-lookup.ts#terminology-lookup",
      "skos:note": "candidate"
    }
  ]
