      "dcterms:source": "who-iris/processes/iris-cdn-sign-publish.bpmn#Task_PublishTags",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities/process_iriscdnsignpublish.task_revert",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Revert to the previous release"
        }
      ],
      "skos:notation": "Task_Revert",
      "dcterms:source": "who-iris/processes/iris-cdn-sign-publish.bpmn#Task_Revert",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities/process_iriscdnsignpublish.task_sign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign the release tag manifest (ES256)"
        }
      ],
      "skos:definition": [
        {
          "@value": "scripts/iris-cdn/signing.ts signDetached. kid is a did:web DID URL listed under assertionMethod."
        }
      ],
      "skos:notation": "Task_Sign",
      "dcterms:source": "who-iris/processes/iris-cdn-sign-publish.bpmn#Task_Sign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities/process_iriscdnsignpublish.task_signitems",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign each changed item manifest (ES256)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Owner, Q4 A: a signature on each library item. items/<handle>/manifest-sha256.txt lists the item record and its files; its detached JWS sits beside it. Only items whose manifest bytes changed are signed: ES256 is randomised, so re-signing an unchanged item would be churn. The item manifests and their signatures join the payload, so the tag files are refreshed to cover them before the release is signed."
        }
      ],
      "skos:notation": "Task_SignItems",
      "dcterms:source": "who-iris/processes/iris-cdn-sign-publish.bpmn#Task_SignItems",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities/process_iriscdnsignpublish.task_upload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Store new objects (never overwrite)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Content-addressed: an object whose SHA-256 is already stored is skipped. Published objects are never deleted by a nightly run."
        }
      ],
      "skos:notation": "Task_Upload",
      "dcterms:source": "who-iris/processes/iris-cdn-sign-publish.bpmn#Task_Upload",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities/process_iriscdnsignpublish.task_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve did:web; verify JWS and digests"
        }
      ],
      "skos:definition": [
        {
          "@value": "scripts/iris-cdn/signing.ts verifyDetached against the DID document fetched from its did:web URL, then a sample of payload digests."
        }
      ],
      "skos:notation": "Task_Verify",
      "dcterms:source": "who-iris/processes/iris-cdn-sign-publish.bpmn#Task_Verify",
      "skos:note": "candidate"
    }
  ]
}
