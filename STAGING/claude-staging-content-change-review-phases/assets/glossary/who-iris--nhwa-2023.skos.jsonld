    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023/community-health-workers",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023"
      },
      "skos:prefLabel": [
        {
          "@value": "Community Health Workers"
        }
      ],
      "skos:altLabel": [
        "Community health workers"
      ],
      "skos:definition": [
        {
          "@value": "Health workers who provide health education, referral and follow-up, case management, basic preventive health care and home visiting services to specific communities. They provide support and assistance to individuals and families in navigating the health and social services system."
        }
      ],
      "skos:scopeNote": "From the Glossary of the handbook (p. 88; PDF page 102). The library ingest of this edition has no Glossary section, so the definition was extracted from the PDF text layer on 2026-10-31 and needs a person to confirm it. The handbook cites its reference 46 for this entry.",
      "dcterms:source": "uploads/9789240081291-eng/9789240081291-eng.pdf#page=102",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023/continuing-professional-development",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023"
      },
      "skos:prefLabel": [
        {
          "@value": "Continuing Professional Development"
        }
      ],
      "skos:altLabel": [
        "Continuing professional development"
      ],
      "skos:definition": [
        {
          "@value": "Training that is beyond clinical update and includes wide-ranging competences like research and scientific writing; multidisciplinary context of patient care; professionalism and ethical practice; communication, leadership, management and behavioural skills; team building; information technology; auditing; and appropriate attitudinal change to ensure improved patient service, research outcomes, and attainment of the highest degree of satisfaction by stakeholders. The form of continuing professional development (CPD) may include: courses and lectures; training days; peer review; clinical audit; reading journals; attending conferences; e-learning activity. CPD may be included in national standards of conduct, performance and ethics that govern health workers."
        }
      ],
      "skos:scopeNote": "From the Glossary of the handbook (p. 88; PDF page 102). The library ingest of this edition has no Glossary section, so the definition was extracted from the PDF text layer on 2026-10-31 and needs a person to confirm it. The handbook cites its reference 105 for this entry.",
      "dcterms:source": "uploads/9789240081291-eng/9789240081291-eng.pdf#page=102",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023/contract-type",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023"
      },
      "skos:prefLabel": [
        {
          "@value": "Contract Type"
        }
      ],
      "skos:altLabel": [
        "Contract type"
      ],
      "skos:definition": [
        {
          "@value": "The contract type is a key employment characteristic of all workers, including health workers. Personnel may be categorized as full-time workers or part-time workers, depending on their specific contract types. Part-time workers refers to those employed persons whose normal hours of work (calculated weekly or on average over a given period of employment) are less than those of comparable full-time workers."
        }
      ],
      "skos:scopeNote": "From the Glossary of the handbook (p. 88; PDF page 102). The library ingest of this edition has no Glossary section, so the definition was extracted from the PDF text layer on 2026-10-31 and needs a person to confirm it. The handbook cites its reference 66 for this entry.",
      "dcterms:source": "uploads/9789240081291-eng/9789240081291-eng.pdf#page=102",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023/dual-practice",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023"
      },
      "skos:prefLabel": [
        {
          "@value": "Dual Practice"
        }
      ],
      "skos:altLabel": [
        "Dual practice"
      ],
      "skos:definition": [
        {
          "@value": "Multiple health-related practices by a health worker in the same or different sites. Dual practice in this sense may be public-on-public, public-on-private, or private-on-private."
        }
      ],
      "skos:scopeNote": "From the Glossary of the handbook (p. 88; PDF page 102). The library ingest of this edition has no Glossary section, so the definition was extracted from the PDF text layer on 2026-10-31 and needs a person to confirm it. The handbook cites its reference 106 for this entry.",
      "dcterms:source": "uploads/9789240081291-eng/9789240081291-eng.pdf#page=102",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023/duration-of-health-workforce-education-and-training",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023"
      },
      "skos:prefLabel": [
        {
          "@value": "Duration of Health Workforce Education and Training"
        }
      ],
      "skos:altLabel": [
        "Duration of health workforce education and training"
      ],
      "skos:definition": [
        {
          "@value": "This is defined as the number of years required to complete a full curriculum for each health workforce education and training programme."
