    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023/childcare-support",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/nhwa-2023"
      },
      "skos:prefLabel": [
        {
          "@value": "Childcare Support"
        }
      ],
      "skos:altLabel": [
