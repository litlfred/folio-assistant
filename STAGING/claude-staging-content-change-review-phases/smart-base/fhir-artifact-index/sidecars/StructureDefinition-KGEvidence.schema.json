{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://smart.who.int/base/StructureDefinition-KGEvidence.schema.json",
  "title": "Knowledge graph L1: Evidence",
  "description": "One row of an evidence profile: the evidence for one outcome of one key question, with its certainty (handbook §9.2). Class IRI: http://smart.who.int/kg/evidence.",
  "type": "object",
  "properties": {
    "resourceType": {
      "type": "string",
      "const": "KGEvidence",
      "description": "Resource type identifier for KGEvidence logical model"
    },
    "@context": {
      "description": "JSON-LD context for this logical model with ValueSet vocabularies",
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "description": "URI reference to external JSON-LD context"
        },
        {
          "type": "object",
          "description": "Inline JSON-LD context",
          "properties": {
            "@version": {
              "type": "number",
              "const": 1.1
            },
            "fhir": {
              "type": "string",
              "const": "http://hl7.org/fhir/"
            }
          },
          "additionalProperties": {
            "type": "string",
            "format": "uri"
          }
        },
        {
          "type": "array",
          "description": "Array of JSON-LD context objects/URIs",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "object"
              }
            ]
          }
        }
      ]
    },
    "@type": {
      "type": "string",
      "description": "JSON-LD type identifier for KGEvidence logical model",
      "examples": [
        "LogicalModel-KGEvidence"
      ]
    },
    "evidenceType": {
      "$ref": "./ValueSet-KGEvidenceTypeVS.schema.json",
      "description": "Which kind of evidence a row is, and so which scale its certainty is on: GRADE for effects, GRADE-CERQual for qualitative findings."
    },
    "certainty": {
      "$ref": "./ValueSet-KGCertaintyVS.schema.json",
      "description": "GRADE certainty of evidence."
    },
    "summary": {
      "type": "string",
      "description": "Summary of the body of evidence."
    },
    "studyCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of studies in the body of evidence."
    },
    "citation": {
      "type": "string",
      "description": "Bibliographic citation of the evidence review."
    },
    "contentHash": {
      "type": "string",
      "description": "sha256 of the normalised summary."
    }
  },
  "required": [
    "resourceType"
  ],
  "allOf": [
    {
      "$ref": "./StructureDefinition-FHIRSchemaBase.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "resourceDefinition": {
          "type": "string",
          "format": "uri",
          "const": "http://smart.who.int/base/StructureDefinition/KGEvidence"
        },
        "fhir:parent": {
          "type": "string",
          "const": "http://hl7.org/fhir/StructureDefinition/Base"
        },
        "jsonld:valuesets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "const": [
            "KGCertaintyVS",
            "KGEvidenceTypeVS"
          ]
        },
        "jsonld:contextTemplate": {
          "type": "object",
          "const": {
            "@version": 1.1,
            "fhir": "http://hl7.org/fhir/",
            "KGCertaintyVS": "http://smart.who.int/base/ValueSet-KGCertaintyVS.jsonld",
            "KGEvidenceTypeVS": "http://smart.who.int/base/ValueSet-KGEvidenceTypeVS.jsonld"
          }
        }
      }
    }
  ]
}