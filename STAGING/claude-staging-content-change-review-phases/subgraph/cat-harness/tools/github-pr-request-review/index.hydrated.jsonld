      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/github-pr-request-review.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Ask one or more accounts to review a pull request. Adds to the reviewers already requested.",
      "install": {
        "cli": "gh"
      },
      "invoke": {
        "shell": "gh pr edit"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "Absent: the change proposal of the current branch.",
            "name": "number",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/ChangeProposalNumber"
          },
          {
            "arg": {
              "flag": "--add-reviewer"
            },
            "name": "reviewers",
            "repeated": true,
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Login"
          }
        ],
        "outputs": [
          {
            "description": "The pull request.",
            "name": "url",
            "render": {
              "as": "url",
              "reason": "a reader follows it to the proposal; the scheme is checked before it reaches an href"
            },
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          }
        ]
      },
      "name": "github-pr-request-review",
      "requirements": {
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/pickup",
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/prepare-merge-auto"
      ],
      "title": "Request review on a pull request (GitHub)"
    }
  ],
