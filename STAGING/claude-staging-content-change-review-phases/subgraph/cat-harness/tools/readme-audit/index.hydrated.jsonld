{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/readme-audit/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/readme-audit.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Verify every Markdown link in a folio's README still resolves — relative paths against the tree, repo refs against a real ls-tree, Pages URLs against the publish ref. Writes nothing.",
      "install": {
        "none": true
      },
      "invoke": {
        "inProcess": {
          "module": "src/tools/readme-audit.ts"
        },
        "mcp": {
          "tool": "readme_audit"
        },
        "shell": "bun run cat readme:audit"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "The file to audit; the README by default.",
            "name": "file",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--fetch"
            },
            "description": "Also dereference external URLs.",
            "name": "fetch",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "description": "The folio root, when not the working directory.",
            "name": "dir",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          }
        ],
        "outputs": [
          {
            "description": "Resolved, dead, or NOT CHECKED — the third state is never rendered as either of the other two.",
            "name": "findings",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ]
      },
      "name": "readme-audit",
      "requirements": {
        "network": false
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/docs-generation",
      "title": "Audit README links"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
