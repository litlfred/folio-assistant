{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/folio-assistant-sci/tools/latex-overfull/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/tools/latex-overfull.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Turn a pdflatex log's Overfull \\hbox warnings into a located, actionable report, with a threshold so a long tail of trivial overruns does not bury the real ones.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat latex:overfull"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "The pdflatex log to read. Nothing to read means no answer, not a pass.",
            "name": "log",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--min"
            },
            "description": "Ignore overruns below this size — the long tail is noise, and reporting it hides the rest.",
            "name": "min",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Dpi"
          },
          {
            "arg": {
              "flag": "--max"
            },
            "description": "Fail above this count, for use as a gate.",
            "name": "max",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Dpi"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Located overfull boxes. Requires a build log: with no log there is nothing to read, which is could-not-determine rather than clean.",
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "latex-overfull",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/folio-assistant-sci/skill/latex-validation",
      "title": "LaTeX overfull-box report"
    }
  ],
