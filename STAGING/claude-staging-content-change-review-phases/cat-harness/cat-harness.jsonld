    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/secrets-check.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "secrets-check",
      "title": "Check declared credential needs against workflow use and expiry, by name",
      "description": "Compare each repository's declared credential needs (`credentials/needs.json`, profile and registry) with the `secrets.NAME` expressions its workflows reference (GitHub Actions' dollar-and-double-brace form, said in words because this text is rendered on a Jekyll page), with the secret names GitHub lists when a token allows it, and with any recorded expiry. NAMES ONLY — no value is ever read. Findings per §6.2: used-not-declared, declared-not-used, declared-not-present, present-not-declared (reported, never deleted), naming advisories, and expiry (≤30 days minor, ≤7 major, expired critical). Exits 2 when anything could not be determined, which outranks clean; else 1 on a major or critical finding; else 0.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat secrets:check"
      },
      "io": {
        "inputs": [
          {
            "name": "repos",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Repository checkouts to check. Default: every repository the index mounts.",
            "required": false,
            "repeated": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Print the result as JSON instead of the human report.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "verdict",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "The exit status: 0 clean, 1 a major or critical finding, 2 could not determine."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/security"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/secrets-check.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/security-gate.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "security-gate",
      "title": "Run every existing security check as one named release step",
      "description": "Run the repository's security checks — workflow injection, secret leaks, lockfile pinning, the toolchain pin, QA reviewer permission, materialised-asset fixity — plus two advisories (dependency advisories, third-party action SHA pinning), each by name as argv. Every check is reported as pass, fail or unknown; a blocking check that fails OR could not be run refuses the release, because could-not-check is never clean. Advisories are reported and never block. Called by `prepare-merge` before a push that will merge, and by any publish process before it publishes.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat security:gate"
      },
      "io": {
        "inputs": [
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Print a `folio-security-gate/v1` result on stdout instead of the human report.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "blocked",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Whether a blocking check failed or could not be run; also the exit status (1 when blocked)."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/security"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/security-gate.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/separation-cutover-check.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "separation-cutover-check",
      "title": "Is this repository's cutover from the monorepo complete? Measured, condition by condition",
      "description": "Run in a separated repository. Six conditions, each decided by an existing gate: `mounts` (every declared layer on disk at its pin — `remote-mount --check`), `declarations` (every path a declaration names resolves — `declaration-resolution`), `monorepo-paths` (no wiring still names the monorepo: `livesAt` on it, a submodule of it, a reusable workflow called from it, a path into its old checkout — the one condition implemented here), `import-direction` and `reference-direction` (no layer reaches a layer above it), and `site` (the site builds from the mounts alone, every link resolving — `build-instance-site --no-mount`, only with `--site`). Findings inside a MOUNTED layer are listed and not counted: a defect in a layer pinned from upstream is fixed upstream and re-pinned. Exit 0 complete, 1 a condition failed, 2 a condition could not be determined or was not run — without `--site` the answer is never 0.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat separation:cutover:check"
      },
      "io": {
        "inputs": [
          {
            "name": "root",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The separated checkout. Default: the working directory.",
            "required": false,
            "arg": {
              "flag": "--root"
            }
          },
          {
            "name": "site",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Build the site from the mounts on disk (minutes); without it the `site` condition is not run and the verdict cannot be complete.",
            "required": false,
            "arg": {
              "flag": "--site"
            }
          },
          {
            "name": "monorepo",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoFullName",
            "description": "The repository the separation left, `<owner>/<repo>`. Default: litlfred/folio-assistant.",
            "required": false,
            "arg": {
              "flag": "--monorepo"
            }
          },
          {
            "name": "monorepoDir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Its old checkout directory name, as paths spell it. Default: the repository's name.",
            "required": false,
            "arg": {
              "flag": "--monorepo-dir"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Print the report as JSON, mounted-layer findings included.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "conditions",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Per condition: pass, fail, could-not-determine or not-run, the gate that decided it, and its findings."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/kg-separation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/separation-cutover-check.jsonld"
    },
    {
