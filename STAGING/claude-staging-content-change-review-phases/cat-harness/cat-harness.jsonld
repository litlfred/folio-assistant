      "localId": "reviewer",
      "actorKind": "person",
      "title": "Reviewer",
      "description": "A person who reads a change and judges it. Acting as `reviewer` does not carry the authority to accept — that is the editor's lane.",
      "hasCapability": [],
      "mayTakeRole": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/reviewer",
