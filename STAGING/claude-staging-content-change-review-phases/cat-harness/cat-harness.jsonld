      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/pdf-cover.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "pdf-cover",
      "title": "PDF page raster",
      "description": "Render one page of a PDF to a PNG — the thumbnail a repository listing shows — and print the provenance a catalogue needs to record it as DERIVED: source, digest, page, geometry, renderer.",
      "install": {
        "cli": "pip install pymupdf"
      },
      "invoke": {
        "shell": "bun run cat pdf:cover"
      },
      "io": {
        "inputs": [
          {
            "name": "pdf",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The PDF to render from. Its bytes must be here; nothing is fetched.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The PNG to write.",
            "required": true,
            "arg": {
              "flag": "--out"
            }
          },
          {
            "name": "page",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "1-based page to render, default 1. Asking for a page past the end is refused, not clamped.",
            "required": false,
            "arg": {
              "flag": "--page"
            }
          },
          {
            "name": "width",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Output width in pixels, default 300. `Count` admits zero and a zero width does not; the script refuses it rather than writing a 0x0 PNG, which is the tighter bound stated at the port as `CountSchema` asks. Height follows the page's own aspect and is never forced.",
            "required": false,
            "arg": {
              "flag": "--width"
            }
          },
          {
            "name": "checkOnly",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Write nothing; exit non-zero if the target differs from what would be written.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "facts",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "With `--json`: source path and sha256, page, page count, point geometry, pixel geometry, output bytes and sha256, media type, renderer version. Everything a provenance record needs and nothing it has to guess."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3",
          "pymupdf"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/asset-extraction"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/pdf-cover.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/pdf-viewer-embed.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "pdf-viewer-embed",
      "title": "Embed a PDF inline in a page",
      "description": "Print the HTML fragment that shows a PDF in the installed viewer: a lazily loaded frame whose address is derived from the page's own location (so one page works at the site root, under a project base and under a staging preview), plus plain open and download links that work without it.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat pdf:viewer --embed"
      },
      "io": {
        "inputs": [
          {
            "name": "spec",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "One JSON object: `src` (the PDF's URL, which must fall under a prefix `pdf-viewer-install` was given, or the viewer refuses it on screen), `title` (what the document is; the frame's accessible name), `route` (a regular expression over the page's pathname whose group 1 is the site root — the `folio-mount.ts` convention) and optionally `page` (open at this 1-based page). On stdin because a title and a regular expression are free text.",
            "required": true,
            "arg": {
              "stdin": true
            }
          }
        ],
        "outputs": [
          {
            "name": "fragment",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "The HTML fragment on stdout. TypeScript callers import `embed` from the module that implements this Tool instead, as the IRIS replica's `scripts/gen-iris-pages.ts` does."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/pdf-inline-viewer"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/pdf-viewer-embed.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/pdf-viewer-install.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "pdf-viewer-install",
      "title": "Install the inline PDF viewer into a built site",
      "description": "Download the pinned pdf.js release (legacy build), verify its SHA-256, copy the parts a site needs into `<site>/assets/vendor/pdfjs/`, and add the shim that opens `?src=` only for the allowlisted URL prefixes or the site's own origin. Nothing is committed: the viewer exists only in the built site.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat pdf:viewer"
      },
      "io": {
        "inputs": [
          {
            "name": "site",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The built site directory, `_site` in both site workflows.",
            "required": true,
            "arg": {
              "flag": "--site"
            }
          },
          {
            "name": "allow",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "An https URL prefix the viewer may open, ending in `/`. Repeat the flag for more than one. `same-origin-only` is the explicit way to allow none — an omitted flag is a usage error, because a viewer that refuses every CDN document would otherwise ship green.",
            "required": true,
            "arg": {
              "flag": "--allow"
            }
          },
          {
            "name": "zip",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A local copy of the release zip, for offline runs and tests. Its hash is checked exactly as a download's would be.",
            "required": false,
            "arg": {
              "flag": "--zip"
            }
          }
        ],
        "outputs": [
          {
            "name": "summary",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "One line on stdout: version, destination, file count, and the prefixes it will open. Exit 2 on a usage error; a hash mismatch or a release missing a kept path throws, refusing the install."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "unzip"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/pdf-inline-viewer"
      ],
