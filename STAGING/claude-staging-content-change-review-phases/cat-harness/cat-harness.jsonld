      "name": "handover-screen",
      "title": "Screen a hand-over for injected instructions, field by field",
      "description": "Before a model reads a sub-agent's report, a delegated prompt, a tool result or a comment from someone who is not the principal, screen it against a declared schema whose top-level fields are `control` (steers what the receiver does) or `data` (content it reads). A finding in a control field, or any field the strict schema does not declare, is REFUSED, so a report cannot extend the delegator's plan. A finding in a data field is QUARANTINED: the original is kept and marked, never stripped. The patterns are a deterministic tripwire (instruction overrides, role and turn spoofs, fence breaks, tool-call syntax, hidden Unicode, exfiltration links, pipe-to-shell), a mitigation and not a guarantee. Exit 0 clean, 1 refused, 3 quarantined, 2 could not determine.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat handover:screen"
      },
      "io": {
        "inputs": [
          {
            "name": "schema",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "JSON `{ fields: { name: \"control\" | \"data\" }, strict?: boolean }`.",
            "required": false,
            "arg": {
              "flag": "--schema"
            }
          },
          {
            "name": "payload",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The hand-over, as a JSON object.",
            "required": false
          },
          {
            "name": "text",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A single free-text input, screened as one DATA field.",
            "required": false,
            "arg": {
              "flag": "--text"
            }
          }
        ],
        "outputs": [
          {
            "name": "verdict",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "`clean`, `quarantined` or `refused`, with every finding's path, field role and kind; also the exit status."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/security"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/handover-screen.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/harness-state.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "harness-state",
      "title": "Per-harness setup position and health",
      "description": "For every harness in the checkout, run bootstrap's setup check without performing anything or touching the network, and write one `folio-harness-state/v1` file: each step in its state, the first step not done (its position) with what to do next, and health badges that are the harness's own (setup steps; the instance's committed health report, unknown without one). A recommendation is said, never acted on.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat harness:state"
      },
      "io": {
