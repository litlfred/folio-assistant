            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Unresolved references per instance and field, and what could not be determined; entries examined per field."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
