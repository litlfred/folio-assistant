    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/sub-kg-verify-clone.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "sub-kg-verify-clone",
      "title": "Verify a separated repository from a fresh clone",
      "description": "Clone a separated sub-KG's repository (with submodules, and any sibling checkouts it needs) into an empty scratch directory, install, and run its gates: its `gates` script, else its `test` script (a person may pass `--gate` on the command line instead; it is not part of this contract because it is a shell command). Reports `green`, `red` or `unknown`; an empty tree, a failed clone or a repository with no gate is `unknown`, never green. Catches what a rehearsal inside this checkout cannot, because a rehearsal shares this checkout's `node_modules` and environment (#2082). Writes only inside the scratch directory.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat sub-kg:verify-clone"
      },
      "io": {
        "inputs": [
          {
            "name": "repo",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoFullName",
            "description": "The separated repository, `owner/name`. (The script also takes a git URL or a local path, for tests.)",
            "required": true,
            "arg": {
              "flag": "--repo"
            }
          },
          {
            "name": "ref",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Branch",
            "description": "The branch or tag to clone, e.g. the seeding PR's branch.",
            "required": false,
            "arg": {
              "flag": "--ref"
            }
          },
          {
            "name": "sibling",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoFullName",
            "description": "A repository to clone beside it, for a platform linked as a sibling checkout. Repeatable.",
            "required": false,
            "arg": {
              "flag": "--sibling"
            }
          },
          {
            "name": "work",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Scratch directory, kept afterwards. Absent: a temporary directory, removed afterwards.",
            "required": false,
            "arg": {
              "flag": "--work"
            }
          },
          {
            "name": "text",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "A report for a person instead of JSON.",
            "required": false,
            "arg": {
              "flag": "--text"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "`sub-kg-verify-clone/v1`: the commit cloned, each step with its status and output tail, and the verdict. Exit 0 green, 1 red, 2 unknown."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/sub-kg-lifecycle"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/sub-kg-verify-clone.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/subgraph-index-package.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "subgraph-index-package",
      "title": "Package one pin's subgraph index files for a hydrated mount",
      "description": "Pack every built `index.jsonld` and `index.hydrated.jsonld` under an instance's `<docs>/subgraph/<harness>/` into ONE npm package for one pin — `<harness>-subgraph-index@0.0.0-pin.<sha>`, with a `folio-subgraph-index/v1` manifest giving each file's sha256 — through `pack-tarball` (`bun pm pack`), which also writes the tarball's `folio-binary-release/v1` record. The reusable workflow `layer-publish-subgraph-index.yml` attaches both to the GitHub release `subgraph-index-<sha>`, where `remote-mount` finds them for a `hydrated` source whose pin's git tree holds no index file (they are `builtAtPublish`, so none does). It builds nothing: run `subgraph:jsonld` first. No subgraph files under the instance is a refusal, never an empty package.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat subgraph-index:pack"
      },
      "io": {
        "inputs": [
          {
            "name": "root",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The instance root whose `<docs>/subgraph/<name>/` is packed.",
            "required": true,
            "arg": {
              "flag": "--root"
            }
          },
          {
            "name": "repository",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoFullName",
            "description": "owner/name of the repository the pin is a commit of.",
            "required": true,
            "arg": {
              "flag": "--repository"
            }
          },
          {
            "name": "ref",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/CommitSha",
            "description": "The pin: the full 40-character commit the files were built from.",
            "required": true,
            "arg": {
              "flag": "--ref"
            }
          },
          {
            "name": "outDir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where the tarball and its release record are written.",
            "required": true,
            "arg": {
              "flag": "--out-dir"
            }
          },
          {
            "name": "builtIn",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/PinnedRepo",
            "description": "`<owner/name>@<40-char sha>` of the checkout the files were built in, recorded as provenance.",
            "required": false,
            "arg": {
              "flag": "--built-in"
            }
          }
        ],
        "outputs": [
          {
            "name": "tarball",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The package `.tgz`."
          },
          {
            "name": "release",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Its `folio-binary-release/v1` record."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/npm-kg-distribution",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/remote-mount"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/subgraph-index-package.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/subgraph-readmes.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "subgraph-readmes",
      "title": "Directory READMEs from the Knowledge Graph",
      "description": "Write a README for every directory an instance declares, from the declaration and the files themselves: the declared title and description, the Graph Typologies, and one row per file described from the file, with 'used by' only where a diagram records it. Renders the Liquid templates in `tools/templates/readme/`, part of the tools graph, which may include one another with Jekyll-style include tags. Writes only between `<!-- kg:subgraph:begin -->` and `:end`; a README without the markers is left alone and reported. Records every missing title, missing or over-long description, absent directory and unmarked README in `test/results/subgraph-readmes.qa-results.json`.",
      "install": {
        "none": true
      },
      "invoke": {
