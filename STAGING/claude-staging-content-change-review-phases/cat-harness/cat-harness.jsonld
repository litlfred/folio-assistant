      "name": "merge-train",
      "title": "Merge train",
      "description": "Build a train branch from a base SHA: merge each member (a PR number or branch) with `merge-base.ts --no-regen`, refusing — never hand-resolving — a member whose conflicts no declared pattern covers; then one `bun run cat regen`, `check:l1-complete --write`, every check an instance declares `afterMerge` (its declared writer run when red), and `kg:audit:all:check`; then merge `origin/main`, taking main's side of generated conflicts and regenerating once more. Emits a `merge-train-report/v1` JSON report. Never pushes, opens or merges a PR.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat merge:train"
      },
      "io": {
        "inputs": [
          {
            "name": "base",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/CommitSha",
            "description": "The commit the train branch starts from.",
            "required": true,
            "arg": {
              "flag": "--base"
            }
          },
          {
            "name": "branch",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Branch",
            "description": "The train branch to create; default `merge-train/<base>-<time>`.",
            "required": false,
            "arg": {
              "flag": "--branch"
            }
          },
          {
            "name": "dry-run",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Simulate with `git merge-tree`: classify each member's conflicts against the simulated train and change nothing.",
            "required": false,
            "arg": {
              "flag": "--dry-run"
            }
          },
          {
            "name": "no-main",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Skip merging `origin/main` into the train.",
            "required": false,
            "arg": {
              "flag": "--no-main"
            }
          },
          {
            "name": "members",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Branch",
            "description": "PR numbers or branches, in train order. On the command line a PR may be pinned to the head CI saw as `N:<sha>`.",
            "required": true,
            "repeated": true,
            "arg": {
              "positional": 0
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "`merge-train-report/v1` on stdout: members merged, refused with reasons and conflicted paths, the checks run, main's merge, and the head. Exit 0 built, 1 needs a person, 2 could not start."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/merge-conflict-patterns",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/prepare-merge"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/merge-train.jsonld"
    },
