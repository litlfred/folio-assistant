      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/bean-claim-check.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "bean-claim-check",
      "title": "Check a bean is free, then claim it on every copy",
      "description": "For one bean: fetch every bean copy, read the last three commits on its file, skip it if another agent committed within the window or its last note is a claim, look for an open PR naming it in every listed repository, and only then set it in-progress with a dated claim note as a plain commit on every copy. A rejected push is fetched, rebased and re-checked, never forced.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat beans:claim-check",
        "inProcess": {
          "module": "scripts/bean-claim-check.ts"
        }
      },
      "io": {
        "inputs": [
          {
            "name": "id",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/BeanId",
            "description": "The bean, full or short id.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "copy",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A local checkout of a bean copy. Repeat once per copy. Defaults to the current checkout.",
            "required": false,
            "repeated": true,
            "arg": {
              "flag": "--copy"
            }
          },
          {
            "name": "repo",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoFullName",
            "description": "A repository whose open PRs are searched for the id. Repeat. Defaults to the copies' repositories.",
            "required": false,
            "repeated": true,
            "arg": {
              "flag": "--repo"
            }
          },
          {
            "name": "minePr",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "The link of an open PR that is the caller's own, when resuming a bean it already holds. Every cloud thread's PR has the same author, so without this any open PR naming the bean is a skip.",
            "required": false,
            "repeated": true,
            "arg": {
              "flag": "--mine-pr"
            }
          },
          {
            "name": "as",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Which agent is asking, by its name in the agents table. Defaults to `cloud`.",
            "required": false,
            "arg": {
              "flag": "--as"
            }
          },
          {
            "name": "session",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "The caller's session link, matched against the `Claude-Session:` trailer so a sibling thread of the same agent is told apart. Defaults to $CLAUDE_SESSION_URL.",
            "required": false,
            "arg": {
              "flag": "--session"
            }
          },
          {
            "name": "agents",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A JSON file of agents and their commit authors, as in the skill's input schema.",
            "required": false,
            "arg": {
              "flag": "--agents"
            }
          },
          {
            "name": "window",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/TimeWindow",
            "description": "Defaults to 24h.",
            "required": false,
            "arg": {
              "flag": "--window"
            }
          },
          {
            "name": "dryRun",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Check only; report `would-claim` and write nothing.",
            "required": false,
            "arg": {
              "flag": "--dry-run"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Emit `definitions.claimCheck` as JSON.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Markdown",
            "description": "One of claimed, would-claim, skip-recent-commit, skip-claim-note, skip-open-pr, skip-closed or unknown, with the evidence per copy and the open PRs found. Exit 0 for claimed or would-claim, 1 for a skip, 2 for unknown. Unknown is never reported as free. With --json, `definitions.claimCheck` of schemas/skills/bean-drain/output.schema.json."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/bean-coordination"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/bean-claim-check.jsonld"
    },
