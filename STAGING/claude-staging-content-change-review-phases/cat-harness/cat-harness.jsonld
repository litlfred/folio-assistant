      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/open-work-lookup.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "open-work-lookup",
      "title": "Does a path or bean exist on main or any open PR",
      "description": "Answer whether a path, a path prefix or a bean id appears on a repository's default branch or on the head of any of its open pull requests, and where: the PR number, head branch, first commit author and creation time. A path or prefix matches files at the default branch and files each open PR changes; a bean id matches PR titles, bodies and head branch names. Repositories or PRs that could not be read are listed, so an empty answer is never mistaken for absence.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat lookup:open-work",
        "inProcess": {
          "module": "scripts/open-work-lookup.ts"
        }
      },
      "io": {
        "inputs": [
          {
            "name": "path",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "An exact repository path.",
            "required": false,
            "arg": {
              "flag": "--path"
            }
          },
          {
            "name": "prefix",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A directory or file-name prefix; every path under or starting with it matches.",
            "required": false,
            "arg": {
              "flag": "--prefix"
            }
          },
          {
            "name": "bean",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/BeanId",
            "description": "A bean id, full or short.",
            "required": false,
            "arg": {
              "flag": "--bean"
            }
          },
          {
            "name": "repo",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoFullName",
            "description": "Repositories to search. Repeat. Defaults to the current checkout's origin.",
            "required": false,
            "repeated": true,
            "arg": {
              "flag": "--repo"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Emit `definitions.lookup` as JSON.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "lookup",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Markdown",
            "description": "One line per hit: repository, default branch or PR number, head, author, when, and what matched. Then what could not be read. Exactly one of path, prefix or bean must be given. With --json, `definitions.lookup` of schemas/skills/bean-drain/output.schema.json."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/bean-coordination",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/issue-working"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/open-work-lookup.jsonld"
    },
