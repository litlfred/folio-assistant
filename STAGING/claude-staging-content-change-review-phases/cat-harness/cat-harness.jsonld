    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/remote-mount.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "remote-mount",
      "title": "Mount remote harnesses at a pinned commit, only when trusted",
      "description": "Lay down each declared remote mount — a `source.remote` instance in the root `index.config.json`, or, in a folio with no index, a `remoteMounts` entry on its declaration (both at once is refused) — and its dependency closure, from another repository at a full commit SHA. Write the lock, `index.lock.json` (a legacy `<name>.mount-lock.json` is read, and renamed onto it when rewritten), and, with an index, regenerate the root `.gitignore` block that ignores each mount path. It READS the declared mounts and never writes them: a tool that changes a mount writes through `writeDeclaredMounts` into `index.config.json`. Before anything is checked out, each mount must pass the trust gate (`schemas/kg/mount-trust.ts`, rule H8): a person's consent recorded for THIS pin, or a signature in a declared trust network. No signature verifier exists yet, so a signature alone is could-not-determine and does not mount. Unsigned and unconsented is refused. `--staging` mounts for a preview and needs neither, by the owner's ruling. A directory id an override or `mountDefaults` names may be one the instance declares in its `<name>.json` or one it declares FROM WITHIN a declared directory (`skills/skills.json` naming `voices`), resolved at the pin through `instanceDirectories` (bean `mo75` G3); an id in neither is refused at plan time. `tools` on an override names Tools by id and mounts each one runnable (bean `mo75` G3; owner, 2026-10-24): its definition (`<tools dir>/<id>/<id>.ts`), its implementation (the `inProcess.module`, or the script its `bun run cat <key>` resolves to) and their import closure, walked by bootstrap-tools' `importClosure` (the one closure walker), as every declared directory that closure touches — the lock still records directories only. A `hydrated` mount (bean `mo75`) lays each chosen directory down as its published `index.hydrated.jsonld` only: read from the pin's git tree when a commit carries it, otherwise fetched from the pin's subgraph index package (the `subgraph-index-<sha>` release asset `subgraph-index-package` publishes), its tarball checked against its `folio-binary-release/v1` record, its manifest against the repository, pin and harness asked for, and each file against its sha256, `SubgraphHydratedSchema` and the subgraph IRI; the lock records the package's URL and sha256 so a replay fetches the same bytes. `--check` compares the disk against the lock and never fetches. When a run CHANGES the lock, it then re-renders the agent surface (`skill:commands` → `.claude/commands/`, `agent-memory` → `.claude/agent-memory/` and `.agents/`) from the checkout root, so a re-pin commit carries the skills and memory the new layers define; a generator that fails fails the run, and `--no-agent-surface` opts out.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat mount:remote"
      },
      "io": {
        "inputs": [
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The downstream instance root; omitted, every declaring instance in the checkout.",
            "required": false,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "staging",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Mount for a staging preview: no signature or consent required.",
            "required": false,
            "arg": {
              "flag": "--staging"
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Compare the disk against the lock; fetch nothing.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          },
          {
            "name": "noAgentSurface",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Do not re-render `.claude/commands/` and the agent memory after a mount that changed the lock.",
            "required": false,
            "arg": {
              "flag": "--no-agent-surface"
            }
          },
          {
            "name": "noInstall",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Lay the pinned bytes down without `bun install` in each mounted instance that carries a `package.json`. By default the install runs (`--production`; `--install-all` keeps devDependencies), so the mounted tools run; it writes only `node_modules/`, which no mount digest covers, so `--check` still passes.",
            "required": false,
            "arg": {
              "flag": "--no-install"
            }
          },
          {
            "name": "seed",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/MountSeed",
            "description": "`<name>=<owner/repo>@<40-char sha>`: create or re-pin that remote instance in `index.config.json` instead of mounting, writing its `trust.consent` for that pin in the same write (needs `consentBy` and `evidence`; repeatable; `--whole` mounts every tracked file). Refused while a mount it moves has edits the lock does not hold, since the next mount would leave that mount at the old commit (folio-assistant#2682); `fresh` lets it through.",
            "required": false,
            "arg": {
              "flag": "--seed"
            }
          },
          {
            "name": "fresh",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Replace a mount whose bytes no longer hash to the lock instead of leaving it untouched; with `seed`, re-pin over such edits. The edits are discarded.",
            "required": false,
            "arg": {
              "flag": "--fresh"
            }
          },
          {
            "name": "choose",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/MountChoice",
            "description": "`<harness>[:<instance>]`: write a review's choice (`directories` and/or `tools`) into that mount entry's `overrides.<instance>` instead of mounting, so a fresh clone replays it (bean `mo75`). The pin and its consent are untouched; the next mount resolves the choice and the lock records what it resolved to.",
            "required": false,
            "arg": {
              "flag": "--choose"
            }
          },
          {
            "name": "directories",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/IdList",
            "description": "With `choose`: comma-separated directory ids, nested ids or concern names.",
            "required": false,
            "arg": {
              "flag": "--directories"
            }
          },
          {
            "name": "tools",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/IdList",
            "description": "With `choose`: comma-separated Tool ids, each mounted runnable.",
            "required": false,
            "arg": {
              "flag": "--tools"
            }
          },
          {
            "name": "consentBy",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Login",
            "description": "With `seed`: who consented, as `consent.by`.",
            "required": false,
            "arg": {
              "flag": "--consent-by"
            }
          },
          {
            "name": "evidence",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "With `seed`: where the consent was given, readable (a session, an issue comment), as `consent.evidence`. On stdin because it is free prose: it quotes what was said.",
            "required": false,
            "arg": {
              "stdin": true
            }
          }
        ],
        "outputs": [
          {
            "name": "outcomes",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Per instance: mounted, local, skipped, missing (including refused by the trust gate) or could-not-determine."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git",
          "curl",
          "tar"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/security",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/agent-memory"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/remote-mount.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/render-log.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "render-log",
      "title": "Record what the publish branch served",
      "description": "Append one entry to the render log on the publish branch: what was published or taken down, when, from which commit, and — for a removal or a retention — WHY. The log is the only place a preview that vanished leaves a trace.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat render:log"
      },
      "io": {
        "inputs": [
          {
            "name": "dir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A checkout of the publish branch, or a publish directory about to become one. This tool NEVER fetches, commits or pushes: the workflows that call it already hold the checkout with their own retry and concurrency handling, and a second pusher racing those is a new way to lose a deploy.",
            "required": true,
            "arg": {
              "flag": "--dir"
            }
          },
          {
            "name": "event",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RenderEvent",
            "description": "`rendered`, `removed`, `restored` or `retained`. `retained` is the one that makes the log worth reading — a removal CONSIDERED and refused, which otherwise leaves no trace at all.",
            "required": true,
            "arg": {
              "flag": "--event"
            }
          },
          {
            "name": "kind",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "What was rendered — `staging-preview`, `site`, `export`. Open on purpose: the publish branch carries more than previews, and a closed enum would put a schema change between somebody and logging what they published.",
            "required": true,
            "arg": {
              "flag": "--kind"
            }
          },
          {
            "name": "path",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The path on the publish branch. Checked as a VALUE, never trusted by provenance: the slug sanitiser can emit `..`, and that is only safe for a slug taken from a git ref — a dispatch input is not one (bean `fuzm`).",
            "required": true,
            "arg": {
              "flag": "--path"
            }
          },
          {
            "name": "slug",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "The staging slug, where the subject has one.",
            "required": false,
            "arg": {
              "flag": "--slug"
            }
          },
          {
            "name": "branch",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Branch",
            "description": "The branch the render came from.",
            "required": false,
            "arg": {
              "flag": "--branch"
            }
          },
          {
            "name": "commit",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/CommitSha",
            "description": "The commit the artefact was built from.",
            "required": false,
            "arg": {
              "flag": "--commit"
            }
          },
          {
            "name": "run",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "The workflow run that wrote this, so a reader can open the log.",
            "required": false,
            "arg": {
              "flag": "--run"
            }
          },
          {
            "name": "prose",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Markdown",
            "description": "One JSON object on STDIN: `{summary, reason?, detail?, format?}`. `summary` is required and one line. `reason` is required by the SCRIPT for `removed` and `retained` — an entry saying an artefact went and not why is the ambiguity the log exists to prevent. `format` declares how the prose reads (absent means plain text, never sniffed). Build it with `jq -n --arg`, never by concatenation.",
            "required": true,
            "arg": {
              "stdin": true
            }
          }
        ],
        "outputs": [
          {
            "name": "entry",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The day's JSONL the entry was APPENDED to. Append is the only verb: there is no `--remove`, no `--edit` and no `--id`, so a takedown is a `removed` ENTRY rather than the erasure of the `rendered` one before it — the never-delete rule made structural instead of a guard three cleanup paths have to remember."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "jq"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/render-logging"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/render-log.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/render-order.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "render-order",
      "title": "The render pipeline, in dependency order",
      "description": "Flatten the repository's renders into the order their `needs` imply, and optionally run them. Two stages: the current declared state as json/jsonld and the README derived from it are FATAL; the dynamic renderers (viewers, visualisers, doc pages, diagrams) skip and log; the dynamic-state export closes it. A cycle or a missing dependency yields NO order rather than a partial one.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat render",
        "mcp": {
          "tool": "render_order"
        },
        "inProcess": {
          "module": "src/tools/render-order.ts"
        }
      },
      "io": {
        "inputs": [
          {
            "name": "dry_run",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Print the flattened order and each step's failure policy without running anything.",
            "required": false,
            "arg": {
              "flag": "--dry-run"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Markdown",
            "description": "Per step: ran, failed, skipped, or PENDING — declared with no implementation yet, which is never rendered as a pass."
          }
        ]
      },
      "requirements": {
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/docs-generation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/render-order.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/rewrite-moved-paths.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "rewrite-moved-paths",
      "title": "Rewrite paths that still name a moved file's old layer — never in a record",
      "description": "After a move between two layers lands, find every mention `<from>/<prefix>/<rest>` in the scanned tree's tracked files and rewrite it to `<to>/<prefix>/<rest>` only when the file exists under the destination root and not under the source root. Records are never read: beans, todos, memory, proposals, wireframes, QA results, upstream pins, vocab mappings, provenance figures and terminologies, and test fixtures (`DEFAULT_RECORD_GLOBS`; the CLI's `--keep <glob>` adds more, generated trees among them, which their generators rewrite — a glob is not a shell-safe argument type, so it is not a declared input). Reports by default with file and line; `--write` applies; `--check` exits 1 while a rewrite is owed.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat paths:rewrite-moved"
      },
      "io": {
        "inputs": [
          {
            "name": "fromName",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "The moved files' old layer, as paths spell it (e.g. the harness).",
            "required": true,
            "arg": {
              "flag": "--from-name"
            }
          },
          {
            "name": "fromRoot",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "That layer's root on disk.",
            "required": true,
            "arg": {
              "flag": "--from-root"
            }
          },
          {
            "name": "toName",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "The layer the files moved to.",
            "required": true,
            "arg": {
              "flag": "--to-name"
            }
          },
          {
            "name": "toRoot",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "That layer's root on disk.",
            "required": true,
            "arg": {
              "flag": "--to-root"
            }
          },
          {
            "name": "prefix",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A moved directory, repeatable (e.g. `scripts`, `pipeline`).",
            "required": true,
            "arg": {
              "flag": "--prefix"
            }
          },
          {
            "name": "scan",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The git checkout whose tracked files are read; default the source root.",
            "required": false,
            "arg": {
              "flag": "--scan"
            }
          },
          {
            "name": "write",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Apply the rewrites.",
            "required": false,
            "arg": {
              "flag": "--write"
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Exit 1 while any rewrite is owed; write nothing.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "rewrites",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Rewrites made or owed, each with file and line; mentions left alone; record files not read."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/kg-separation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/rewrite-moved-paths.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/schema-docs.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "schema-docs",
      "title": "Skill contract reference",
      "description": "Render each skill's input/output JSON Schema as a browsable Markdown reference page, with an index. The generated pages are committed so they are readable on the forge as well as on the site.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat schema:docs"
      },
      "io": {
        "inputs": [
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Compare against the committed pages and fail if stale, instead of writing.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "schemaReference",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The generated reference directory. Never hand-edited."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/docs-generation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/schema-docs.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/schemas-viewer.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "schemas-viewer",
      "title": "Schemas viewer",
      "description": "Render each declared schema directory as a page per subject instance, over one shared data index.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat schema:viz"
      },
      "io": {
        "inputs": [
          {
            "name": "check",
