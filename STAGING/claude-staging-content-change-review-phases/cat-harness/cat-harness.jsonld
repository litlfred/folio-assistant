      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/package-exports.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "package-exports",
      "title": "A package's exports are its declared, shipped code directories",
      "description": "Derive a package's `package.json` `exports` from the instance declaration beside it: a directory declared with graph typology `code` (top level or from within) AND named in `files` is exported as `./<dir>/*.js → ./<dir>/*.ts` and `./<dir>/* → ./<dir>/*`; a declared code directory that is not shipped (`test/`) stays private. Keys without `*` are named entry points, kept as written and checked to point into an exported directory. Without `--write` it reports each difference; with it, it rewrites `exports`. Exit 0 in agreement, 1 drift, 2 cannot tell (no declaration, no `package.json`, or no shipped code directory).",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat check:package-exports"
      },
      "io": {
        "inputs": [
          {
            "name": "root",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The instance whose package to check. Default: the instance holding the script.",
            "required": false,
            "arg": {
              "flag": "--root"
            }
          },
          {
            "name": "write",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Rewrite `exports` to the derived set.",
            "required": false,
            "arg": {
              "flag": "--write"
            }
          }
        ],
        "outputs": [
          {
            "name": "findings",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Each difference between the written and the derived `exports`, or the directories exported and those declared but not shipped."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/kg-separation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/package-exports.jsonld"
    },
