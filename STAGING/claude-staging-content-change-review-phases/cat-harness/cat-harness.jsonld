            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The Jekyll source to write (replaced).",
            "required": true
          },
          {
            "name": "staging",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "A local build or a staging preview: staging-only visualisations are included.",
            "required": false,
            "arg": {
              "flag": "--staging"
            }
          },
          {
            "name": "changed-files",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The branch's changed paths, one per line: instances it does not reach are stubbed.",
            "required": false
          },
          {
            "name": "shell",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "The chrome only: Jekyll machinery and assets, no page and no composed instance; generated includes written empty.",
            "required": false,
            "arg": {
              "flag": "--shell"
            }
          }
        ],
        "outputs": [
          {
            "name": "files",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Files composed, with every override, merge, withheld file and carried or stubbed instance named."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/harness-tiles"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/compose-docs.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/content-context.jsonld",
