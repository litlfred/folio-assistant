    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/actor/untainted-adjudicator",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Actor",
      "localId": "untainted-adjudicator",
      "actorKind": "agent",
      "title": "Untainted adjudicator",
      "description": "The dispatched party that rules — given the original intent and the checker's output, and never the artefact itself. It names each drift against the criterion's declared `drift` statement and returns pass / warn / fail. It holds `qa-reporting` and its witness leads the criterion, because the first entry per criterion is the operative one. It does NOT hold `content-authoring`: the party that produced the artefact does not write the verdict on it, which is the whole discipline in one line.",
      "hasCapability": [],
      "mayTakeRole": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/qc-reviewer",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/adjudicator"
      ],
      "permissionName": [
        "qa-reporting",
        "adjudication"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/actor/untainted-adjudicator"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/actor/untainted-checker",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Actor",
      "localId": "untainted-checker",
      "actorKind": "agent",
      "title": "Untainted checker",
      "description": "The dispatched party that renders an artefact independently — a back-translation, an independent finding — given only what `UntaintedDispatch.checker_sees` allows and nothing that would let it shortcut. It RULES ON NOTHING: its witness carries `result: \"n/a\"` and the intermediate text a reader needs to ask 'on what basis?'. It deliberately does NOT hold `qa-reporting`, and that absence is the point — a checker that emits a verdict is comparing a thing with its own paraphrase of itself, and `check:qa-reviewer-permission` refuses it structurally rather than by convention.",
      "hasCapability": [],
      "mayTakeRole": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/feedback-provider",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/qc-reviewer",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/untainted-checker"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/actor/untainted-checker"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/actor/local-sweep",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Actor",
      "localId": "local-sweep",
      "actorKind": "system",
      "title": "Local sweep",
      "description": "The same QA sweep programs as `ci-pipeline`, run on a contributor's or agent's machine rather than in CI. It runs a fixed program and exercises no judgement. It is a SEPARATE actor because the verdict it produces rests on a working tree nobody else can reconstruct: a CI verdict is reproducible from the commit it records, while a local one may rest on an uncommitted edit. Recording which one ruled is what keeps `reviewed_sha` an address rather than a decoration.",
      "hasCapability": [],
      "mayTakeRole": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/build-pipeline",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/validation-pipeline",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/feedback-provider"
      ],
      "permissionName": [
        "qa-reporting"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/actor/local-sweep"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/github-connector",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "github-connector",
      "name": "GitHub connector (host-provided)",
      "description": "Ability to reach the forge through a connector the HOST supplies — an MCP server the agent did not configure and cannot inspect. DISTINCT FROM github-api: the agent holds no credential of its own, so what it may do is whatever the connector was granted, and that is knowable only by trying. An mcp-probe against the server is therefore the honest detection: it answers 'is the connector reachable', which is the only question this capability can settle. It does NOT answer 'may I write' — that is a permission on the actor, and a session can hold this capability and still be refused. Declared 2026-09-20 alongside github-api, on the owner's answer that the write path is several tools chosen by capability and permission.",
      "detection": {
        "method": "mcp-probe",
        "endpoint": "github"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/github-connector"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/signing-api",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "signing-api",
      "name": "Signing API",
      "description": "An attestation endpoint that will sign a QA report's run hashes. Probed by configuration, not by calling it: a probe that made a live request would be indistinguishable from an outage on the one machine this matters for, and would call an external service just to answer a question about setup.",
      "detection": {
        "method": "env-var",
        "variable": "FOLIO_SIGNING_ENDPOINT"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/signing-api"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/docling",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "docling",
      "name": "Docling (layout-aware PDF parsing)",
      "description": "IBM's MIT-licensed document parser: layout analysis, TableFormer table structure, formula enrichment. Stage 3 of docs/proposals/rag-document-ingestion.md §10 — the ~20 documents pypdf cannot serve (7 no-TOC, 17 unsectioned, 7 likely-scanned) plus the WHO L1 guidelines, where boxed recommendations and GRADE tables are layout facts. IMPORTANT: `pip install docling` succeeds but a first parse fetches weights from huggingface.co, which returns `CONNECT tunnel failed, response 403` under organisation policy (re-measured 2026-08-26). So the import is NOT the capability, and this probe does not stop there: it passes when the weights are already cached locally, and otherwise falls back to a 5-second reachability check. A sandboxed session therefore reports ABSENT and a workstation with models downloaded passes offline and instantly. Run it where egress allows and commit the artefacts.",
      "detection": {
        "method": "command",
        "command": "python3 -c 'import docling' && { [ -d \"$HOME/.cache/docling/models\" ] || curl -sf --max-time 5 -o /dev/null https://huggingface.co; }"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/docling"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/github-api",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "github-api",
      "name": "GitHub API (token or OAuth)",
      "description": "Ability to write to the forge over its HTTP API — create or update a file, open a pull request, comment — authenticated by a token or an OAuth grant rather than by holding a checkout. DISTINCT FROM git-push: this writes with no working tree, so it is the path available to a process that has a credential and no clone, and its reach is whatever the credential was granted rather than whatever the filesystem allows. Probed by CONFIGURATION, not by calling the API: a probe that issued a request would be indistinguishable from an outage or a rate limit, and would touch an external host to answer a question about local setup — the same reading deploy-access and signing-api take. Declared 2026-09-20 on the owner's answer that the write path is several tools chosen by capability and permission, not one design.",
      "detection": {
        "method": "env-var",
        "variable": "GITHUB_TOKEN"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/github-api"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/python3",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "python3",
      "name": "Python 3",
      "description": "Python 3 runtime with pip package manager.",
      "detection": {
        "method": "command",
        "command": "python3 --version"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/python3"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/pdfplumber",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "pdfplumber",
      "name": "pdfplumber (deterministic table extraction)",
      "description": "Pure-Python PDF geometry reader, the default backend of scripts/pdf-tables.py. Extracts ruled and alignment-based tables with exact column edges and bounding boxes, which pdf-structure/v1 does not model. No model weights and no egress after install, so unlike Docling it runs in a sandboxed session. Install: pip install pdfplumber.",
      "detection": {
        "method": "command",
        "command": "python3 -c 'import pdfplumber'"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/pdfplumber"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/git-read",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "git-read",
      "name": "Git Read",
      "description": "Ability to read the Git repository — history, refs and working tree. Required by every skill that reasons about what changed. It was referenced by 17 skills and declared by NO capability until 2026-09-20, when executing the degradation model found it on the first run (bean folio-assistant-ahvw): a reference-shaped value resolving to nothing, so those skills could not be shown to run at all.",
      "detection": {
        "method": "command",
        "command": "git rev-parse --git-dir"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/git-read"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/deploy-access",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "deploy-access",
      "name": "Deployment Access",
      "description": "Credentials and configuration to deploy this instance — the OAuth client id/secret and cookie secret that deploy/.env holds. Probed by CONFIGURATION rather than by attempting a deployment, the same reading signing-api takes: a probe that tried to deploy would be indistinguishable from an outage, and would act on an external host just to answer a question about setup. The path is not invented — deploy/deploy.sh gates on exactly this file ([ ! -f \"$DEPLOY_DIR/.env\" ]) before it will run, so the probe agrees with the script it describes. Declared 2026-09-20, bean folio-assistant-q6ud: it was referenced by deployment-auth and declared by nothing, which executing the degradation model found on its first run.",
      "detection": {
        "method": "file-exists",
        "path": "cat-harness/deploy/.env"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/deploy-access"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/pymupdf",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "pymupdf",
      "name": "PyMuPDF (preferred PDF reader backend for pdf-structure.py)",
      "description": "Optional PDF reader backend for scripts/pdf-structure.py, preferred over pypdf when present. Its text layer is cleaner on math PDFs (fewer split words, correct accents, correct CJK where pypdf yields mojibake), and it reads the embedded outline directly via get_toc() rather than walking pypdf's outline object. pdf-structure.py auto-detects it and falls back to pypdf when absent, so it is never required. LICENCE: PyMuPDF is AGPL-3.0 (or commercial); the shipped Docker image installs pypdf (BSD-3-Clause), not PyMuPDF, so this stays an opt-in accelerator. Install: pip install pymupdf.",
      "detection": {
        "method": "command",
        "command": "python3 -c 'import pymupdf'"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/pymupdf"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/git-push",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "git-push",
      "name": "Git Push",
      "description": "Ability to push commits to the remote Git repository.",
      "detection": {
        "method": "command",
        "command": "git remote -v"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/git-push"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/camelot",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Capability",
      "localId": "camelot",
      "name": "camelot-py (table extraction with a confidence score)",
      "description": "Optional second backend for scripts/pdf-tables.py, preferred when present. Extracts the same cells and column edges as pdfplumber on a ruled grid, and additionally reports a per-table parsing accuracy that lands in the artefact's `confidence` field, which pdfplumber has no equivalent for. Camelot 2.0 moved Ghostscript to an optional extra; the base install is numpy/pandas/opencv-headless/pypdfium2 and needs no egress after install. Install: pip install camelot-py.",
      "detection": {
        "method": "command",
        "command": "python3 -c 'import camelot'"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/capability/camelot"
    },
    {
