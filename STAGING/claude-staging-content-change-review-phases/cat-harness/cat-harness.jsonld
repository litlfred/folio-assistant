    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/content-graph-analysis.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "content-graph-analysis",
      "title": "Editorial content-graph analysis",
      "description": "Build the block- and section-level editorial dependency graph of one paper from its `.ts` manifests and report forward references, cross-chapter coupling, sparse or dense sections and isolated blocks, ranked. Reads `uses[]`/`interprets` only — the editorial relation, never the formal one.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat content:graph-analysis"
      },
      "io": {
        "inputs": [
          {
            "name": "paper",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "The paper: a directory name under the folio directory, or a path to it. When omitted, the folio's only paper; required when the folio holds several.",
            "required": false,
            "arg": {
              "flag": "--paper"
            }
          },
          {
            "name": "chapter",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Restrict the analysis to one chapter directory.",
            "required": false,
            "arg": {
              "flag": "--chapter"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Emit the whole graph as JSON on stdout and exit.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          },
          {
            "name": "md",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Write the report to /tmp/content-graph-report.md.",
            "required": false,
            "arg": {
              "flag": "--md"
            }
          },
          {
            "name": "visualise",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Render the Graphviz SVGs (needs graphviz).",
            "required": false,
            "arg": {
              "flag": "--visualise"
            }
          },
          {
            "name": "proposals",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Write concrete reorganisation proposals to /tmp/content-graph-proposals.md.",
            "required": false,
            "arg": {
              "flag": "--proposals"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "The ranked findings, or the graph as JSON with `--json`."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/content-graph"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/content-graph-analysis.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/content-graph-build.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "content-graph-build",
      "title": "Content graph",
      "description": "Build the content graph under a path and report its edges, separated into the EDITORIAL relation an author maintains and the FORMAL one derived from Lean. Reading the two as one number is how the editorial signal gets overwritten.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat content:graph"
      },
      "io": {
        "inputs": [
          {
            "name": "targetPath",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Content root to walk; defaults to the folio's `content/`.",
            "required": false,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Block count, then edge counts reported separately and never summed: EDITORIAL (`uses[]`, `interprets` — author-maintained) and FORMAL (derived from `lean.ref`). The formal line distinguishes `0` from `cache ABSENT`, so an unavailable formal graph cannot be read as a graph with no formal edges."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/content-validate"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/content-graph-build.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/content-graph-uml.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "content-graph-uml",
      "title": "A paper's block graph as UML",
      "description": "Draw a paper's block graph from buildContentGraph: chapters as packages, editorial edges (uses / interprets) solid and formal Lean edges (type / value) dashed purple, never one derived from the other, and each block filled by its formalization status from proof-objects.json when given. One diagram for the paper and one per chapter, each in portrait and landscape, stamped with its source's hash. Run from a folio: the platform carries no paper.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat content:graph:uml"
      },
      "io": {
        "inputs": [
          {
            "name": "root",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio's content directory, where the block manifests are.",
            "required": true,
            "arg": {
              "flag": "--root"
            }
          },
