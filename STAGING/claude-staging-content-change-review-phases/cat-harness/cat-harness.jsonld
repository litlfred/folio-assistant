    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/archimate-crossings.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "archimate-crossings",
      "title": "Count the tangles in ArchiMate views: lines crossing lines, and lines through boxes",
      "description": "For each view, as `render-view.ts` draws it, count the pairs of lines that cross and the lines that run through a box they do not connect (groups, and boxes that hold one of the line's ends, excepted). With `--view` it lists each tangle by the boxes it joins; with `--max` it is a gate.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat archimate:crossings"
      },
      "io": {
        "inputs": [
          {
            "name": "model",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The `.archimate` file (plain XML or Archi's zipped archive).",
            "required": true,
            "arg": {
              "flag": "--model"
            }
          },
          {
            "name": "view",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "One view, by its Archi id (`id-<hex>`) or its page slug (e.g. `1-central-health-workforce-registry`). A slug, not free text, so no shell payload can ride on it. Absent: every view in the model.",
            "required": false,
            "arg": {
              "flag": "--view"
            }
          },
          {
            "name": "max",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Exit 1 if any view has more tangles than this.",
            "required": false,
            "arg": {
              "flag": "--max"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Print JSON instead of one line per view.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "tangles",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Per view: crossings and lines through a box."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/archimate-models"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/archimate-crossings.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/archimate-detangle.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "archimate-detangle",
      "title": "Lower the tangles in ArchiMate views: re-route lines and swap same-size boxes in a row",
      "description": "Searches for a less tangled drawing of each view: a line may be re-routed straight or orthogonally (an L, or a Z through a free lane between boxes), and two same-size boxes in the same parent and row or column may swap places. A change is kept only if it lowers crossings + lines through boxes + lines drawn on top of each other. Without `--apply` it reports before and after per view; with it, the model is written back in place, only the moved boxes' bounds and the re-routed lines' bendpoints changing.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat archimate:detangle"
      },
      "io": {
        "inputs": [
          {
            "name": "model",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The `.archimate` file (plain XML or Archi's zipped archive).",
            "required": true,
            "arg": {
              "flag": "--model"
            }
          },
          {
            "name": "view",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "One view, by its Archi id (`id-<hex>`) or its page slug (e.g. `1-central-health-workforce-registry`). A slug, not free text, so no shell payload can ride on it. Absent: every view in the model.",
            "required": false,
            "arg": {
              "flag": "--view"
            }
          },
          {
            "name": "routes-only",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Never move a box; only re-route lines.",
            "required": false,
            "arg": {
              "flag": "--routes-only"
            }
          },
          {
            "name": "apply",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Write the model back in place.",
            "required": false,
            "arg": {
              "flag": "--apply"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Print JSON instead of one line per view.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Per view: tangles before and after, and the swaps and routes made."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/archimate-models"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/archimate-detangle.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/archimate-metamodel.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "archimate-metamodel",
      "title": "Derive the metamodel an ArchiMate model uses, and check it against ArchiMate's relationship table",
      "description": "For each model an instance's `cat-archimate.config.json` names: the element types it uses, with counts; every (source type, relationship, target type) pattern its relationships follow, with counts and ids; whether ArchiMate's relationship table (Appendix B of ArchiMate 3.2, as Archi holds it, committed as `archimate/schemas/archimate-relationships.json` in the tools layer) allows each pattern; and the placeholder elements, named after their own type, that a hand-drawn metamodel leaves in a model. Prints a report, JSON, Graphviz DOT or a Mermaid class diagram. `archimate-pages` draws the same result on each model's \"Metamodel in use\" page, so the metamodel is derived, never drawn.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat archimate:metamodel"
      },
      "io": {
        "inputs": [
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The instance root whose ArchiMate models are read.",
            "required": true,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "model",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/ArchimateModelId",
            "description": "One model's id from the config; absent, every model. Required for `--format dot` and `mmd`.",
            "required": false,
            "arg": {
              "flag": "--model"
            }
          },
          {
            "name": "format",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/ArchimateMetamodelFormat",
            "description": "`text` (default), `json`, `dot` or `mmd`.",
            "required": false,
            "arg": {
              "flag": "--format"
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Exit 1 when any relationship follows a pattern ArchiMate does not allow. Placeholders are reported, never fatal.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "metamodel",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "The report, or the metamodel as `archimate-metamodel/v1` JSON, DOT or Mermaid, on stdout."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/archimate-models"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/archimate-metamodel.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/archimate-pages.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "archimate-pages",
      "title": "Give every ArchiMate view, element and relationship a page and an IRI, and draw every view",
      "description": "Write a JSON-LD node and a thin page for each model an instance's `cat-archimate.config.json` names and for every view, element and relationship in it — keyed by Archi's own ids — plus the normalised model the pages' one loader draws from, and every view drawn as SVG from the model's own bounds and bendpoints in ArchiMate's notation, each box a link to its element. `--out` writes into a site being built — the data at the graph's path, the pages at the route of the visualiser the instance declares for this Tool, `<locale>/<harness>/<id>/`; without it the files go into the graph and `--check` gates them.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat archimate:pages"
      },
      "io": {
        "inputs": [
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The instance root.",
            "required": true,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A site being built: the data lands at `<out>/<graph path>/` and the pages at `<out>/<locale>/<harness>/<id>/`, the route of the instance's one visualiser `renderedBy` this Tool (none declared: nothing is written). Absent, they are written into the graph, which must be `served: true`.",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Without `--out`: fail if a committed page is missing, stale or orphaned; write nothing.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "pages",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Pages and view drawings written (or found current)."
          }
        ]
