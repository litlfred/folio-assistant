    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/corpus-search.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "corpus-search",
      "title": "Search the corpus and follow the graph",
      "description": "Seed lexically over the authored folio and every declared library, then expand along graph edges, labelling each hit MATCHED or REACHED and by which edge. Counts are split authored vs ingested, and a root that exists but holds no graph nodes is reported rather than read as an empty answer.",
      "install": {
        "none": true
      },
      "invoke": {
        "mcp": {
          "tool": "corpus_search"
        },
        "inProcess": {
          "module": "src/tools/graph.ts"
        }
      },
      "io": {
        "inputs": [
          {
            "name": "query",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Words to seed on. Seeding is lexical, so a short phrase works; a long query no node contains seeds nothing.",
            "required": true
          },
          {
            "name": "hops",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Expansion depth, 0-4 (default 1). 0 is a plain lexical search.",
            "required": false
          },
          {
            "name": "direction",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "`out`, `in` or `both` (default).",
            "required": false
          },
          {
            "name": "provenance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "`authored` or `ingested`: restricts the seeds, not the expansion.",
            "required": false
          },
          {
            "name": "searchText",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Also seed on companion Markdown bodies.",
            "required": false
          },
          {
            "name": "limit",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Seed cap before expansion (default 20).",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "result",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Markdown",
            "description": "JSON: summary, emptyRoots, dangling, and hits each carrying a `why`."
          }
        ]
