            "description": "The instance root whose Knowledge Graph is rendered, or a tree a caller already rendered and verified.",
            "required": true
          },
          {
            "name": "url",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "The publication root URL. Default: the declaration's `iriBase`, else `https://<owner>.github.io/<repo>/`.",
            "required": false
          },
          {
            "name": "subgraph",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "A declared directory id to render; repeatable. Absent: the whole graph.",
            "required": false
          },
          {
            "name": "sha",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/CommitSha",
            "description": "The commit that is live: the commit on `gh-pages`.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "status",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "`pushed`, `not-pushed` or `could-not-determine` — never `pushed` over a check that could not look."
          },
          {
            "name": "message",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "One line: the live commit, the root URL, and the QA of both what was staged and what is served."
          }
        ]
