      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Role",
      "prefLabel": "Tester",
      "title": "Tester",
      "notation": "tester",
      "description": "Runs a `test-plan/v1` against a system under test: resolves the plan, binds its test data (fixed and reviewed, or generated from template + params + seed, per `vm6m`), executes every case or skips it with a reason, and writes the `folio-test-run/v1` and the `test-report/v1`. UNTAINTED from the system under test — never the same actor — and it does not certify: the rollup it writes is what the certifier decides ON. Bean `3o5b`.",
      "sourceKind": "role-registry",
      "actorKinds": [
        "person",
        "agent",
        "system"
      ],
      "hasSkill": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/test-plan-execution",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/test-data-sets",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/test-engineer",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/content-test"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/role/tester"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/role/untainted-checker",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Role",
      "prefLabel": "Untainted checker",
      "title": "Untainted checker",
      "notation": "untainted-checker",
      "description": "Re-executes a SAMPLE of a plan's cases from the plan and the data alone — never the tester's verdicts — and reports whether it agrees. It rules on nothing: agreement is a fact the certification table reads, not a verdict the checker writes (`untainted-verification` rule 3: one party doing both halves is not this check). Lane `Lane_Checker` in `test-plan-execution.bpmn`, bean `3o5b`.",
      "sourceKind": "role-registry",
      "actorKinds": [
        "person",
        "agent"
      ],
      "hasSkill": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/untainted-verification",
