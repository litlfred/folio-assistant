    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/wireframe-check.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "wireframe-check",
      "title": "Wireframe check at web and mobile viewports",
      "description": "Render each mid-fidelity wireframe candidate of one topic at a web viewport (1280x800) and a mobile viewport (390x844). For each viewport it records `script` entries for renders, no-overflow and no-placeholder, each pass or fail with a note. It writes a screenshot per viewport and a report.json carrying the use, topic and surface, and exits 1 on any fail and 2 when the candidate set is not one the use admits.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat wireframe:check"
      },
      "io": {
        "inputs": [
          {
            "name": "use",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/WireframeUse",
            "description": "`design` or `as-is`. Design needs at least two candidates, compared blind; as-is candidates are drawings of what renders on main, each marked `as-is` in its file name. Anything else exits 2.",
            "required": true,
            "arg": {
              "flag": "--use"
            }
          },
          {
            "name": "topic",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Which wireframe is checked: its asset directory, docs/wireframes/<topic>/ for as-is use and docs/proposals/<topic>/wireframes/ for design use (docs/wireframes/<topic>/ is also accepted there). With no candidates, every .html in it is checked; a candidate outside it is refused.",
            "required": true,
            "arg": {
              "flag": "--topic"
            }
          },
          {
            "name": "surface",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/SurfaceRef",
            "description": "What is drawn: a visualiser route key or a chrome name. Recorded in report.json; for as-is use it must be the topic itself or a ref docs/wireframes/index.json says the topic covers.",
            "required": true,
            "arg": {
              "flag": "--surface"
            }
          },
          {
            "name": "candidates",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Wireframe HTML files, all in the topic's directory. Absent: every .html there. Each must carry both a web and a mobile layout (responsive CSS or two layouts).",
            "required": false,
            "repeated": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where screenshots and report.json go; default <the topic's directory>/checks.",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "report.json: per candidate, per viewport, per criterion. The screenshots are beside it."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "chromium"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/wireframe-viewport-check"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/wireframe-check.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/witness-conformance.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "witness-conformance",
      "title": "Witness conformance report",
      "description": "Check every `*.witness.json` in the folio's declared `computation-witness` directories against the two schemas in `schemas/computation-witness.ts`: the envelope every witness should meet (a failure is a malformed file) and the producer contract (a failure is a finding against the producer, grouped by the fields at fault). Also lists files that are not strict JSON, which Python's reader accepts and every other consumer rejects. Report-only: it never edits a witness, which is generator output.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat witness:conformance"
      },
      "io": {
        "inputs": [
          {
            "name": "dir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Check this directory instead of the declared ones, e.g. before a folio declares the kind.",
            "required": false,
            "arg": {
              "flag": "--dir"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Machine-readable output, every finding group listed.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          },
          {
            "name": "strict",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Exit 1 when any witness is malformed or not strict JSON. Contract findings never fail the run.",
            "required": false,
            "arg": {
              "flag": "--strict"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "Counts of witnesses, malformed files, non-strict-JSON files and contract conformance, then the contract findings by field. Exit 2 when no directory declares the kind and no `--dir` was given: a clean report over nothing is not a pass."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/directory-conventions"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/witness-conformance.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/witness-parity.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "witness-parity",
      "title": "Witness reproduction check",
      "description": "Re-run a computation witness's producer and say whether it reproduces the committed witness. Reads the command from `invocation.reproduce` (else `python3 <scriptFile>`) and the recorded package versions from `environment`; on a version mismatch it stops at `unknown`, since a different environment is not a reproduction test. Otherwise it runs the COMMITTED producer in a scratch git worktree, so the folio's own checkout is never written, and compares the result with the committed witness with run-specific fields (commit, timing, environment) masked at every depth. `pass`, `fail` (with the differing JSON paths), or `unknown` (mismatch, non-zero exit, timeout, no witness written).",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat witness:parity"
      },
      "io": {
        "inputs": [
          {
            "name": "witness",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "One or more `*.witness.json` paths, committed at HEAD.",
            "required": true
          },
          {
            "name": "timeout",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Seconds before a run counts as `unknown`. Default 300.",
            "required": false,
            "arg": {
              "flag": "--timeout"
            }
          },
          {
            "name": "force",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Run despite an environment mismatch; the verdict is then marked advisory.",
            "required": false,
            "arg": {
              "flag": "--force"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Machine-readable output.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "verdicts",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "One line per witness: pass, fail or unknown, with the reason, any environment mismatch and the differing paths. Exit 1 when any witness fails; `unknown` alone exits 0."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git",
          "bash"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/skill/directory-conventions"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/witness-parity.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-staging-content-change-review-phases/cat-harness/tools/work-plan-prime.jsonld",
