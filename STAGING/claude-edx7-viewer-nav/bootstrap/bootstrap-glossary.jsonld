  "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap-glossary.jsonld",
  "@type": "skos:ConceptScheme",
  "prefLabel": "bootstrap swimlane glossary",
  "title": "bootstrap swimlane glossary",
  "definition": "Every persona this instance's BPMN diagrams place in a swimlane, one concept each. Labels come from the lanes, definitions from the role registry, and scope notes from each lane's own <bpmn:documentation>. Generated by scripts/glossary-export.ts.",
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/bootstrapping-agent",
      "@type": "skos:Concept",
      "prefLabel": "Bootstrapping Agent",
      "definition": "An agent asked to set up a Harness with ONLY the knowledge bootstrap/README.md hands it. That constraint is the role, not a caveat on it: a Bootstrapping Agent has no MCP server, no harness, no work plan and no skills beyond those bootstrap carries, and a step that assumes any of those is a step a Bootstrapping Agent cannot perform. It stops being a Bootstrapping Agent the moment the harness is installed and it re-enters through that harness instead.",
      "notation": "bootstrapping-agent",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap-glossary.jsonld",
      "usage": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_Discussion/Lane_BootstrappingAgent",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_InitializeHarness/Lane_BootstrappingAgent"
      ]
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_Discussion/Lane_BootstrappingAgent",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/bootstrapping-agent",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#process/Process_Discussion",
      "label": "Bootstrapping Agent",
      "scopeNote": "Holds the one judgement this process refuses to compute: whether an answer actually settles the question, which is why G_Settled carries no folio:decision unlike the DMN-backed gateways elsewhere in this corpus. It narrows candidates before spending the one question a reader is entitled to, and closes either with a determination or, on a decline, with what is still open — never a guess standing in for either.",
      "source": "bootstrap/processes/discussion.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_InitializeHarness/Lane_BootstrappingAgent",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/bootstrapping-agent",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#process/Process_InitializeHarness",
      "label": "Bootstrapping Agent",
      "scopeNote": "Everything this process performs other than confirming which harness and reading the target location belongs here. It narrows candidates without choosing among them (A_ListHarnesses's own documentation says narrows, not decides), follows the CHOSEN harness's own instructions rather than any bootstrap holds, and logs failure on all three refusal paths rather than retrying — a guessed harness produces a repository set up as the wrong thing, which this process treats as worse than stopping.",
      "source": "bootstrap/processes/initialize-harness.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/knowledge-graph-data-store",
      "@type": "skos:Concept",
      "prefLabel": "Knowledge Graph Data Store",
      "definition": "A git repository, reached either through the git CLI or through a forge's API. It is where a declaration and its graph are READ from and where a new instance's declaration is WRITTEN to. It is `actedUpon`: it holds and serves, and takes no part in deciding what should happen — which is why it carries no skills and why naming one for it would be a lie about what it does.",
      "notation": "knowledge-graph-data-store",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap-glossary.jsonld",
      "actedUpon": true,
      "usage": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_InitializeHarness/Lane_DataStore"
      ]
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_InitializeHarness/Lane_DataStore",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/knowledge-graph-data-store",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#process/Process_InitializeHarness",
      "label": "Knowledge Graph Data Store",
      "scopeNote": "Not an actor: the location itself, read rather than acting. Whether it already carries a declaration at its root — already an instance — and, if not, where its chosen harness's own instructions live at the predetermined path, are both read here before the Bootstrapping Agent writes anything.",
      "source": "bootstrap/processes/initialize-harness.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/requestor",
      "@type": "skos:Concept",
      "prefLabel": "Requestor",
      "definition": "Wants to initialize — or bootstrap, or install, or load, or harness — a harness: bootstrap itself, or any Harness built on it. Carries no skills deliberately: WHICH harness this repository should become is a judgement about intent, and no instruction body produces it. The Bootstrapping Agent may narrow the list from context; only the Requestor settles it.",
      "notation": "requestor",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap-glossary.jsonld",
      "usage": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_Discussion/Lane_Requestor",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_InitializeHarness/Lane_Requestor"
      ]
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_Discussion/Lane_Requestor",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/requestor",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#process/Process_Discussion",
      "label": "Requestor",
      "scopeNote": "Filled interchangeably by a person or a sibling agent that already holds the answer — the output records which, since the two are evidence of different weight, but this lane's standing to answer is the same either way. Declining is a legitimate exit here, not a failure: it is what turns the outcome into \"unsettled\" rather than forcing a guess.",
      "source": "bootstrap/processes/discussion.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_InitializeHarness/Lane_Requestor",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/requestor",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#process/Process_InitializeHarness",
      "label": "Requestor",
      "scopeNote": "The only judgement in the whole process, per A_ConfirmHarness's own documentation: takes the Bootstrapping Agent's list of zero or more harnesses and locations and returns zero or exactly ONE harness — never two, since a list of two is not an answer and the Bootstrapping Agent may not break that tie itself.",
      "source": "bootstrap/processes/initialize-harness.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/logger",
      "@type": "skos:Concept",
      "prefLabel": "Logger",
      "definition": "A machine that accepts log messages and puts them somewhere a person can read. Like the Knowledge Graph Data Store it is `actedUpon` — it receives and records, takes no part in what happens next, and carries no skills, because the skill belongs to whoever is DOING the thing being logged. The Logger is not the author of a log line; it is where the line goes. That distinction is why `log-message` takes `actor` as a required input: the Logger cannot infer who acted, and a log that names the logger rather than the actor records nothing worth having.",
      "notation": "logger",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap-glossary.jsonld",
      "actedUpon": true,
      "usage": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_LogMessage/Lane_Logger"
      ]
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_LogMessage/Lane_Logger",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/logger",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#process/Process_LogMessage",
      "label": "Logger",
      "scopeNote": "Records and decides nothing — the composing and the completeness judgement both happen in the Actor's lane before anything reaches here. In bootstrap the one destination available to it is the discussion the human actor is already in.",
      "source": "bootstrap/processes/log-message.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#lane/Actor",
      "@type": "skos:Concept",
      "prefLabel": "Actor",
      "performerVaries": true,
      "notation": "Actor",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap-glossary.jsonld",
      "usage": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_LogMessage/Lane_Actor"
      ]
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#glossary-usage/Process_LogMessage/Lane_Actor",
      "@type": "https://litlfred.github.io/folio-assistant/cat-harness/ns#LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#lane/Actor",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#process/Process_LogMessage",
      "label": "Actor",
      "scopeNote": "Whichever process called this sub-process, composing the five required fields and nothing more. GW_Complete then refuses an incomplete message rather than logging it anyway, because a partial entry that reads as a whole one is worse than no entry at all.",
      "source": "bootstrap/processes/log-message.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap.jsonld#role/initiator",
      "@type": "skos:Concept",
      "prefLabel": "Initiator",
      "notation": "initiator",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-edx7-viewer-nav/bootstrap/bootstrap-glossary.jsonld",
      "deprecated": true,
