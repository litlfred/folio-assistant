  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-content-finding",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-content-finding",
      "prefLabel": "Disputed review finding outcomes",
      "definition": "The answers an adjudicator may give when the editor and a reviewer, or two reviewers, disagree about one finding in a content change review.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/1073"
      },
      "changeNote": "bean bvuk; owner approved the answer set 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-content-finding/stands",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-content-finding",
      "notation": "stands",
      "prefLabel": "The finding stands",
      "definition": "The finding is right; the author addresses it before the change can be approved."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-content-finding/withdrawn",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-content-finding",
      "notation": "withdrawn",
      "prefLabel": "The finding is withdrawn",
      "definition": "The finding is wrong; the review comment closes as adjudicated, with the decision that closed it."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-criterion",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-criterion",
      "prefLabel": "Criterion adjudication outcomes",
      "definition": "The answers an adjudicator may give when a reviewer or author disagrees with ONE QA criterion's finding. Declared by Process_CriterionAdjudication; each code selects the work that follows it.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/1073"
      },
      "changeNote": "named by #1019 (bean 5vo9); moved to the QA-criterion specialisation by bean bvuk, 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-criterion/stands",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-criterion",
      "notation": "stands",
      "prefLabel": "The finding stands",
      "definition": "The criterion applies to this subject and its finding is right; the subject is what changes.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/issues/1073"
      }
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-criterion/scope",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-criterion",
      "notation": "scope",
      "prefLabel": "The criterion does not apply here",
      "definition": "The criterion is scoped so it stops applying to subjects like this one: one edit to the criterion rather than repeated overrules on blocks it should never have covered."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-criterion/dispensation",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-criterion",
      "notation": "dispensation",
      "prefLabel": "It applies; this is an exception",
      "definition": "The rule applies and this subject is a stated exception. The dispensation carries its reason and lapses when the source changes, so it is scoped to the version it was granted for."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-materialized-conflict",
      "prefLabel": "Materialized-copy conflict outcomes",
      "definition": "The answers an adjudicator may give when a materialized copy changed both locally and upstream since it was fetched. Never a merge rule: which side wins depends on why the local edit was made.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/pull/1156"
      },
      "changeNote": "bean bvuk; the owner's own answer set and design, 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict/remote",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "notation": "remote",
      "prefLabel": "The remote wins",
      "definition": "Take the upstream version; the local copy is re-materialized from it (Task_Apply)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict/local",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "notation": "local",
      "prefLabel": "The local edit wins",
      "definition": "Keep the local edit AND re-pin, so the same settled question stops being asked on every refresh (Task_KeepLocal)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict/merge",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "notation": "merge",
      "prefLabel": "Neither whole — reconcile",
      "definition": "Reconcile the two by hand, then apply, so the five import gates see the hand-made artefact rather than being told about it (Task_Reconcile)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict/defer",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-materialized-conflict",
      "notation": "defer",
      "prefLabel": "Not decidable today",
      "definition": "Decide nothing and do NOT re-pin — the only thing separating it from local. The conflict is recorded, because a deferral nobody wrote down is indistinguishable from a refresh that silently did nothing (Task_RecordConflict)."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-drift",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-translation-drift",
      "prefLabel": "Round-trip drift outcomes",
      "definition": "The answers an adjudicator may give on ONE passage round-trip QA flagged. All three are reasons recorded against the L1 completeness verdict, which Lane_0 owns; what differs is the obligation each creates.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/pull/1156"
      },
      "changeNote": "bean bvuk; the owner's own answer set and design, 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-drift/real",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-drift",
      "notation": "real",
      "prefLabel": "The drift is real",
      "definition": "The translation lost or changed the source's meaning, or used the wrong term; recorded as the reason against the completeness verdict."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-drift/spurious",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-drift",
      "notation": "spurious",
      "prefLabel": "False positive",
      "definition": "The two readings say the same thing. Recorded so the passage stops being re-flagged on every run."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-drift/source-wrong",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-drift",
      "notation": "source-wrong",
      "prefLabel": "The SOURCE is wrong",
      "definition": "The flag is right but the fault is in the source, not the translation. The one answer that sends work out of this process: re-translating a wrong source cannot produce a right target."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-passage",
      "@type": "skos:ConceptScheme",
      "notation": "adjudication-translation-passage",
      "prefLabel": "Flagged translation passage outcomes",
      "definition": "The answers a human reviewer may give on a passage the translation workflow's QA flagged.",
      "source": {
        "@id": "https://github.com/litlfred/folio-assistant/pull/1156"
      },
      "changeNote": "bean bvuk; the owner's own answer set and design, 2026-09-23"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-passage/accept",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-passage",
      "notation": "accept",
      "prefLabel": "Accept as-is",
      "definition": "The flag was a false positive; the translation stands and the workflow writes an unofficial status."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-passage/edit",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-passage",
      "notation": "edit",
      "prefLabel": "Edit and re-run QA",
      "definition": "Correct the passage in place; Task_EditTranslation re-injects it, so QA re-runs over the corrected PO file rather than discarding a good translation wholesale."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-passage/retranslate",
      "@type": "skos:Concept",
      "inScheme": "https://litlfred.github.io/folio-assistant/STAGING/claude-magical-archimedes-4qkfxp-w82m/cat-harness-code-lists.jsonld#adjudication-translation-passage",
      "notation": "retranslate",
      "prefLabel": "Reject — re-translate",
      "definition": "Reject the translation and request a new one; it goes back to Task_Translate."
    },
    {
