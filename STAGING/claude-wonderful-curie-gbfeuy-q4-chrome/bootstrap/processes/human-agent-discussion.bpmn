      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_PutQuestion" bpmnElement="A_PutQuestion">
        <dc:Bounds x="935" y="220" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Answer" bpmnElement="A_Answer">
        <dc:Bounds x="1125" y="500" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_WhatCameBack" bpmnElement="GW_WhatCameBack" isMarkerVisible="true">
        <dc:Bounds x="1365" y="235" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_FollowUp" bpmnElement="A_FollowUp">
        <dc:Bounds x="1315" y="330" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_DefaultAllowed" bpmnElement="GW_DefaultAllowed" isMarkerVisible="true">
        <dc:Bounds x="1555" y="125" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_RecordAnswer" bpmnElement="A_RecordAnswer">
        <dc:Bounds x="1695" y="220" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ApplyDefault" bpmnElement="A_ApplyDefault">
        <dc:Bounds x="1695" y="110" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_RecordUnsettled" bpmnElement="A_RecordUnsettled">
        <dc:Bounds x="1695" y="330" width="150" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Answered" bpmnElement="End_Answered">
        <dc:Bounds x="1942" y="242" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Defaulted" bpmnElement="End_Defaulted">
        <dc:Bounds x="1942" y="132" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Unsettled" bpmnElement="End_Unsettled">
        <dc:Bounds x="1942" y="352" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_1" bpmnElement="SF_HAD_1">
        <di:waypoint x="268" y="260"/>
        <di:waypoint x="365" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_2" bpmnElement="SF_HAD_2">
        <di:waypoint x="515" y="260"/>
        <di:waypoint x="555" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_3" bpmnElement="SF_HAD_3">
        <di:waypoint x="705" y="260"/>
        <di:waypoint x="745" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_4" bpmnElement="SF_HAD_4">
        <di:waypoint x="895" y="260"/>
        <di:waypoint x="935" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_5" bpmnElement="SF_HAD_5">
        <di:waypoint x="1010" y="300"/>
        <di:waypoint x="1010" y="540"/>
        <di:waypoint x="1125" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_6" bpmnElement="SF_HAD_6">
        <di:waypoint x="1200" y="500"/>
        <di:waypoint x="1200" y="260"/>
        <di:waypoint x="1365" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_7" bpmnElement="SF_HAD_7">
        <di:waypoint x="1415" y="260"/>
        <di:waypoint x="1695" y="260"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_8" bpmnElement="SF_HAD_8">
        <di:waypoint x="1390" y="285"/>
        <di:waypoint x="1390" y="330"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_9" bpmnElement="SF_HAD_9">
        <di:waypoint x="1390" y="410"/>
        <di:waypoint x="1390" y="540"/>
        <di:waypoint x="1275" y="540"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_10" bpmnElement="SF_HAD_10">
