      "skos:prefLabel": [
        {
          "@value": "5 · Formalise in Lean [lean-formalization]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Give each formal block (definition, theorem, lemma, proposition, corollary, conjecture, proof) a .lean sibling that Lean 4 accepts, in the order lean-formalization sets out. A compiling declaration is not a formalised claim: check vacuity and narrative drift before calling it done, and record the status with proof-verification."
        }
      ],
      "skos:notation": "Task_Formalize",
