          "@value": "7 · Render PDF / HTML [latex-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Typeset the paper through LaTeX to PDF and HTML. Run latex_preflight first — missing packages, fonts or engine — rather than discovering them twenty minutes in. The preamble, class and macros belong to the folio, never to the platform."
        }
      ],
      "skos:notation": "Task_Render",
