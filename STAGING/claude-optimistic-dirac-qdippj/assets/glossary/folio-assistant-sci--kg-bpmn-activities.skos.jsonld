      "skos:prefLabel": [
        {
          "@value": "8 · Review and feedback [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review the rendered paper, not a description of it, and record the feedback. The outcome is iterate — back to authoring — or approved for the publication path."
