    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/typologies",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "typologies",
      "renderable": false,
      "summary": "The graph typologies a harness declares it owns, one node per kind, so no central registry names another harness's subgraph types. Loaded across the instances on first use."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/validators",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "validators",
      "renderable": false,
      "summary": "The validators a harness's code provides, one node each naming the graph typology and $schema family it checks and the Zod export that checks it, joined onto the kinds on first use."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/block-kinds",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "block-kinds",
      "renderable": false,
      "summary": "The block kinds a harness's adapter owns, one node per kind carrying its label prefix, RDF types, profile and builder. Discovered across the instances; no module lists them."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/tools",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "tools",
      "renderable": false,
      "summary": "Tool definitions — themselves nodes in the KG, per the repo taxonomy."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/cat-harness",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "cat-harness",
      "renderable": false,
      "summary": "A Subgraph holding a Harness's own parts, such as Skills, Processes and Roles, where one directory holds more than one of them."
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#graphTypology/skills",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "skills",
      "renderable": false,
      "summary": "A Subgraph of Skills: the instructions an Actor follows to carry out a Task."
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#graphTypology/processes",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "processes",
      "renderable": false,
      "summary": "A Subgraph of Processes: BPMN diagrams that coordinate Tasks, and the decision tables their gateways compute from."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/methodology",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "methodology",
      "renderable": false,
      "summary": "Judgement methodologies, adopted whole and kept independent — parallel ways to reach a decision, selected by context."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/docs",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "docs",
      "renderable": true,
      "summary": "Documentation ABOUT the knowledge graph — how the harness works, what its directories hold, how a process runs. Rendered by the plain just-the-docs pipeline. Distinct from `folio`, which is content an author CREATES using the graph; the difference is the SUBJECT, not the format. The who-iris catalogue is `library/`; a note about it is a `folio`; the page explaining how ingestion works is `docs`."
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#graphTypology/schemas",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "schemas",
      "renderable": false,
      "summary": "A Subgraph of Node Schemas: files that state the shape other files must have."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/qa",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "qa",
      "renderable": false,
      "summary": "QA verdicts and their projections — kg-qa audits, block and translation QA, qa-witness documents for the docs site, the viewer-navbar audit, result roll-ups and test runs; every `$schema` family is named in `nodeSchemas`, which is the list — a count here would be a second one, and it was already wrong by one before `viewer-nav-qa/v1` was added. Generated; never hand-edited."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/code",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "code",
      "renderable": false,
      "summary": "Source code -- the modules, scripts and entry points an instance holds. Declared so that code is scannable at all: an undeclared file is one no checker has a reason to look at. Being declared here says nothing about whether a Tool node claims it, which is a separate question and a separate axis."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#graphTypology/library",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "library",
      "renderable": false,
      "summary": "L1 source content — one `<bib-slug>/` per ingested document, holding `sections/*.md`, `structure.json` and, where the source was scanned, `ocr/page-NNN.txt`. Every knowledge-graph reference to a source resolves through here, never to a loose path or a bare URL."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#graphTypology/voices",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "voices",
      "renderable": false,
      "summary": "Editorial voice profiles — one JSON each, carrying `\"$schema\": \"folio-voice/v1\"`. Every rule cites the ingested source or KG node it was derived from. Opt-in per folio."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/translation-sources",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "translation-sources",
      "renderable": false,
      "summary": "POT templates, PO catalogues and their `TranslationNode` manifests, one directory per target locale. The INPUT to injection; the rendered output is ordinary content that declares its own `lang`."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#graphTypology/folio",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "folio",
      "renderable": true,
      "summary": "Authored content, rendered to a website by the just-the-docs pipeline."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#graphTypology/glossary",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology",
      "name": "glossary",
      "renderable": false,
      "summary": "SKOS terms (folio-glossary/v1): local terms with definitions and codes, linked to external SKOS schemes by exactMatch rather than copied. Rendered on the glossary/ page."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-awesome-fermi-ua31th-foreign-rail-scope/folio-assistant-core/folio-assistant-core.jsonld#directory/folio-assistant-core-docs",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subgraph",
      "name": "folio-assistant-core-docs",
      "path": "docs/",
      "contentSource": {
        "kind": "directory",
        "declaredIn": "default"
      },
      "holdsGraph": [
        "https://litlfred.github.io/cat-harness/0.1.0/ns#graphTypology/docs"
      ],
      "description": "This instance's own reader-facing pages, and the page `/folio-assistant-core/` serves. Added 2026-10-05 with `folio-assistant-core.config.json` (issue #2196, bean c5fm), when the owner asked for the instance to be staged and instantiated so the navbar's Harnesses list shows it. Without a docs directory the harness tile can only open this instance's section of the landing (`/#harness-folio-assistant-core`), and `harness-tiles.ts` reports that as a finding. Authored markdown, composed THROUGH just-the-docs like smart-base's and smart-trust's pages, so it gets the sidebar, search and layout. Declared HERE, in this instance's own file, rather than in the root's or cat-harness's: `compose-docs.docsLayers` treats every docs-kind entry in `cat-harness.json` as a composition layer, so declaring it there would overlay this `index.md` onto the site's own.",
      "readmePath": "docs/README.md",
