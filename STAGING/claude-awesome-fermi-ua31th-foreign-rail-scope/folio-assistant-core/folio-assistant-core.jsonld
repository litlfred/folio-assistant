    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-awesome-fermi-ua31th-foreign-rail-scope/folio-assistant-core/folio-assistant-core.jsonld#directory/core-adapters",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subgraph",
      "name": "core-adapters",
      "path": "adapters/",
      "contentSource": {
        "kind": "directory",
