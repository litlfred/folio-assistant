    {
      "@id": "http://smart.who.int/base/skill/dak-preprocessing",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Skill",
      "name": "dak-preprocessing",
      "title": "dak-preprocessing",
      "description": "What the DAK pre-processing phase actually accomplishes, step by step, before the IG Publisher runs — and which of its steps exist only to satisfy the Publisher's own page index — and how it runs as the overlay on fhir-harness's AST cache refresh (`dak-pre-export.sh`). Read before changing a pre-processing step, before assuming one is needed, and before moving one to another layer.",
      "instructionsPath": "skills/content/authoring-who-smart-guidelines/dak-preprocessing.md",
      "instructionLines": 267,
