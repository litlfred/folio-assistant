    {
      "@id": "http://smart.who.int/base/skill/grade",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Skill",
      "name": "grade",
      "title": "grade",
      "description": "GRADE — the grading system a WHO guideline folio declares for certainty of evidence, and the Evidence-to-Decision judgement a recommendation rests on. Read when a folio's `Task_AppraiseGrade` runs under GRADE, before recording a certainty, an EtD judgement or a recommendation's direction and strength.",
      "instructionsPath": "skills/content/authoring-who-smart-guidelines/grade.md",
      "instructionLines": 109,
      "hasInstructions": true,
      "hasIOContract": false,
      "ambiguous": false,
      "inSubgraph": "http://smart.who.int/base/directory/smart-base-skills"
    },
    {
      "@id": "http://smart.who.int/base/skill/l3-readiness",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Skill",
      "name": "l3-readiness",
      "title": "l3-readiness",
      "description": "The check between stages 5 and 6 of smart-guideline-end-to-end (Gateway_L3Ready): may the agent write L3 assets yet? Yes only when every source of the use case has its L1 extraction, every L2 asset names the L1 node it rests on, every L3 artefact about to be written names the L2 asset it implements, and the review of each extraction and L2 asset has been requested. Returns the answer, every finding with the stage that fixes it, and what was checked. Read before writing any FSH, CQL or other L3 file for a guideline or an adaptation.",
      "instructionsPath": "skills/content/authoring-who-smart-guidelines/l3-readiness.md",
      "instructionLines": 60,
      "inputSchema": "http://smart.who.int/base/schema/skills/l3-readiness/input.schema.json",
      "outputSchema": "http://smart.who.int/base/schema/skills/l3-readiness/output.schema.json",
      "hasInstructions": true,
      "hasIOContract": true,
      "ambiguous": false,
      "inSubgraph": "http://smart.who.int/base/directory/smart-base-skills"
    },
    {
      "@id": "http://smart.who.int/base/skill/toolchain-ownership",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Skill",
      "name": "toolchain-ownership",
      "title": "toolchain-ownership",
      "description": "Taking ownership of the WHO smart-base scripts in a litlfred fork, rewriting them to the Skill I/O contract, and the one gate that governs when a script may actually move. Read before touching, copying or rewriting any upstream smart-base script.",
      "instructionsPath": "skills/content/authoring-who-smart-guidelines/toolchain-ownership.md",
      "instructionLines": 137,
      "hasInstructions": true,
      "hasIOContract": false,
      "ambiguous": false,
      "inSubgraph": "http://smart.who.int/base/directory/smart-base-skills"
    },
    {
      "@id": "http://smart.who.int/base/skill/l2-dak-authoring",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Skill",
      "name": "l2-dak-authoring",
      "title": "l2-dak-authoring",
      "description": "Author the L2 layer of a WHO SMART Guideline — the Digital Adaptation Kit between the narrative L1 guideline and the L3 FHIR artefacts — one DAK component per pass (personas, user scenarios, business processes, data dictionary, decision and scheduling logic, indicators, requirements), each edited and then reviewed alongside through l2-component-edit-review. Stage 4 of smart-guideline-end-to-end and the authoring steps of l2-dak-authoring.bpmn. Read before authoring or adapting any DAK component.",
      "instructionsPath": "skills/content/authoring-who-smart-guidelines/l2-dak-authoring.md",
      "instructionLines": 110,
      "inputSchema": "http://smart.who.int/base/schema/skills/l2-dak-authoring/input.schema.json",
      "outputSchema": "http://smart.who.int/base/schema/skills/l2-dak-authoring/output.schema.json",
      "hasInstructions": true,
      "hasIOContract": true,
      "ambiguous": false,
      "inSubgraph": "http://smart.who.int/base/directory/smart-base-skills"
    },
    {
      "@id": "http://smart.who.int/base/skill/dak-postprocessing",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Skill",
      "name": "dak-postprocessing",
      "title": "dak-postprocessing",
      "description": "What the DAK post-processing phase accomplishes after the IG Publisher runs — the JSON/JSON-LD surface, the DAK API hub, and the metadata-to-Liquid bridge that is the seam the just-the-docs transition cuts at. Read before changing a post-processing step, and before assuming the Publisher produced something it did not.",
      "instructionsPath": "skills/content/authoring-who-smart-guidelines/dak-postprocessing.md",
      "instructionLines": 241,
      "hasInstructions": true,
      "hasIOContract": false,
      "ambiguous": false,
      "inSubgraph": "http://smart.who.int/base/directory/smart-base-skills"
    },
    {
      "@id": "http://smart.who.int/base/skill/l4-application-run-local",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#Skill",
      "name": "l4-application-run-local",
      "title": "l4-application-run-local",
      "description": "Run an L4 application that is already built, on the agent's own machine, against a clean IG build, so a person can try or demonstrate it before anything is hosted. Read before starting a local copy of an L4 app for a review, a demo or a country adaptation check.",
      "instructionsPath": "skills/content/authoring-who-smart-guidelines/l4-application-run-local.md",
