    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/typologies",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "typologies",
      "renderable": false,
      "summary": "The graph typologies a harness declares it owns, one node per kind, so no central registry names another harness's subgraph types. Loaded across the instances on first use."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/validators",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "validators",
      "renderable": false,
      "summary": "The validators a harness's code provides, one node each naming the graph typology and $schema family it checks and the Zod export that checks it, joined onto the kinds on first use."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/qa-checkers",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "qa-checkers",
      "renderable": false,
      "summary": "The QA checkers a harness provides, one node per criterion naming the table that holds the code; registered for a folio through its dependency tree."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/block-kinds",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "block-kinds",
      "renderable": false,
      "summary": "The block kinds a harness's adapter owns, one node per kind carrying its label prefix, RDF types, profile and builder. Discovered across the instances; no module lists them."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/content-adapters",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "content-adapters",
      "renderable": false,
      "summary": "The block vocabularies a harness owns, one node per vocabulary carrying its companion roles and whether the platform's code types it. Discovered across the instances; no module lists them."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns#graphTypology/tools",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#GraphTypology",
      "name": "tools",
      "renderable": false,
      "summary": "Tool definitions — themselves nodes in the KG, per the repo taxonomy."
    },
    {
