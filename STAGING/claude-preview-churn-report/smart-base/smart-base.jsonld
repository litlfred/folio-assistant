    {
      "@id": "http://smart.who.int/base/tools/smart-fhir-cache-seed.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "smart-fhir-cache-seed",
      "title": "Seed the FHIR package cache, with WHO's published site as a source",
      "description": "Run fhir-harness's `fhir-cache-seed-npm` with smart-base's publisher-site rules (`SMART_PUBLISHER_SITE_REPOS`): `smart.who.int.*` packages are also read from WHO's published-site repository, each fetch verified against the tarball's own package.json. Every other source and check is the seeder's own.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run fhir-harness/scripts/fhir-cache-seed-npm.ts --site-repo smart.who.int.=WorldHealthOrganization/smart-html@main [--cache <dir>] [--sushi-config <file>] [--mirror <dir|git-url>] [--template-repo <name=owner/repo>] [--missing-out <file>] [--dry-run] [name#version ...]"
      },
      "io": {
        "inputs": [
          {
            "name": "sushi-config",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath",
            "description": "Seed what this IG pins: its `dependencies:` and the core package for its `fhirVersion`.",
            "required": false
          },
          {
            "name": "cache",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath",
            "description": "Default `~/.fhir/packages`, which SUSHI and the IG Publisher read.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "installed",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "name": "missing",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Exit 1 when any is missing, each listed with why."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "npm",
          "git"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/ig-publisher-fork"
      ]
    },
    {
      "@id": "http://smart.who.int/base/tools/smart-liquid-variables.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "smart-liquid-variables",
      "title": "IG metadata → Liquid variables",
      "description": "Scan the Publisher's `output/` for `{ResourceType}-{id}.json` and emit a Liquid include assigning `smart__<ResourceType>__<id>__<category>__<key>` for each published resource.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "python3 input/scripts/generate_smart_liquid.py"
      },
      "io": {
        "inputs": [
          {
            "name": "igOutput",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The Publisher's `output/`; the script names this its source of truth.",
            "required": true
          },
          {
            "name": "igRoot",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Repository root, where `input/` lives. Defaults to `.`.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "include",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`input/includes/smart.liquid`, copied to `output/smart.liquid`."
          },
          {
            "name": "categories",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "`url__canonical`, `url__page`, `url__json`, `text__display`, `link__html`, `elements__<key>`."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3"
        ],
        "network": false
      },
      "satisfies": [
        "http://smart.who.int/base/skill/dak-postprocessing"
      ]
    },
    {
      "@id": "http://smart.who.int/base/tools/terminology-lookup.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "terminology-lookup",
      "title": "Reuse-first terminology and code-list lookup",
      "description": "Look up a concept or code token for a semantic slot (`condition`, `intervention`, `persona`, `medicine`, `domain`, `business-process`, `recommendation-strength`, `recommendation-direction`, `evidence-certainty`) across the four reuse-first precedence rungs of the `terminology-coding` methodology: (1) target guide's `l1-scenario-vocabulary/v1`, (2) `smart-base` generic personas (`DAK.Persona.*`), GRADE `code-lists/*.json` and `guideline-domain` SKOS glossary, (3) local WHO/ILO FSH CodeSystems (`ISCO08`, `CDHIv2`, `CDHIv1`, `CDSCv2`, `KGTerminologySystem`), and (4) a proposed `glossary-terms` candidate (`status: \"candidate\"`) or `could-not-determine` for `business-process`.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run smart-base/scripts/terminology-lookup.ts --slot <slot> --query <query> [--vocabulary <guide.json>] [--generic <generic.json>] [--scheme <scheme>] [--out <out.json>]"
      },
      "io": {
        "inputs": [
          {
            "name": "slot",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "The semantic slot to classify and code (`condition`, `intervention`, `persona`, `medicine`, `domain`, `business-process`, `recommendation-strength`, `recommendation-direction`, `evidence-certainty`).",
            "required": true
          },
          {
            "name": "query",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/DocId",
            "description": "The concept term, identifier, or code token to look up across the reuse-first precedence rungs.",
            "required": true
          },
          {
            "name": "vocabulary",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Optional path to the target guide's personas and business processes (`l1-scenario-vocabulary/v1`), Rung 1.",
            "required": false
          },
          {
            "name": "generic",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Optional path to smart-base's generic personas (`l1-scenario-vocabulary/v1`), Rung 2.",
            "required": false
          },
          {
            "name": "scheme",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/DocId",
            "description": "Optional scheme identifier filter (e.g. `guideline-domain`, `ISCO08`, `CDHIv2`, `grade-recommendation-strength`).",
            "required": false
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Optional repository path where the lookup result JSON is written.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "result",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Lookup result JSON conforming to `schemas/skills/classify-and-code-content/output.schema.json`."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "http://smart.who.int/base/skill/classify-and-code-content"
      ]
    },
