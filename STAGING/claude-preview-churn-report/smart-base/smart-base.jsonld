            "description": "The recommendations: the first tool's L1 3.0 graph, or an authored L1 YAML.",
            "required": true
          },
          {
            "name": "vocabulary",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The target guide's personas and processes (`l1-scenario-vocabulary/v1`).",
            "required": true
          },
          {
            "name": "generic",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "smart-base's generic personas, the second rung.",
            "required": false
          },
          {
            "name": "mapping",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
