    {
      "@id": "http://smart.who.int/base/tools/extract-dak.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "extract-dak",
      "title": "DAK spreadsheets → DMN, PlanDefinitions, CQL, requirements, logical models",
      "description": "Run WHO's `extract_dak.py` in a DAK or IG repository: it reads the DAK template spreadsheets (`input/decision-logic/*.xlsx` via `dt_extractor`, `input/system-requirements/*.xlsx` via `req_extractor`, `input/dictionary/*.xlsx` via `dd_extractor`) and the BPMN, and writes the DMN decision tables, the CPG recommendation PlanDefinitions with their citations, CQL library skeletons, Requirements and logical-model FSH. The authoring path the WHO IG Starter Kit (`l3_decisiontables`, `l3_cql`) prescribes: an adapted decision or scheduling table is an edited copy of the upstream DAK's spreadsheet, never a parallel format.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "python3 $SMART_BASE_HOME/input/scripts/extract_dak.py"
      },
      "io": {
        "inputs": [
          {
            "name": "dakRepository",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath",
            "description": "The working directory: a DAK or IG repository holding `input/decision-logic/`, `input/system-requirements/` and `input/dictionary/` spreadsheets in the DAK template layout.",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "dmn",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Decision tables in the DAK DMN format (namespace `https://www.omg.org/spec/DMN/20240513/MODEL/`), each with an `Annotations` and a `Reference(s)` output."
          },
          {
            "name": "fsh",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "PlanDefinition, ActivityDefinition, Requirements and logical-model FSH, for SUSHI to compile."
          },
          {
            "name": "cql",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "CQL library skeletons, one per decision table, with the definitions already present in `input/cql/` carried over."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3"
        ],
        "network": false
      },
      "satisfies": [
        "http://smart.who.int/base/skill/smart-base-tools"
      ]
    },
    {
      "@id": "http://smart.who.int/base/tools/immz-schedule-app-local.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "immz-schedule-app-local",
      "title": "Run the immunization schedule-check app locally, on a WHO or country adaptation IG",
      "description": "Start the schedule-check web form from litlfred/awho-mcp on this machine: a HAPI FHIR server in Docker on 127.0.0.1, the WHO SMART Immunizations IG loaded, then a country adaptation IG after it (its decision-logic tables replace WHO's, and its country profile is generated from its `input/l2/dependencies.yaml`), the CQL cache warmed, and the form served on 127.0.0.1. Unbuilt IGs are built with SUSHI first, and each Library's CQL is embedded from `input/cql/` as the IG Publisher would. Re-running reuses a server already loaded from the same commits; `--down` stops both.",
      "install": {
        "cli": "git clone https://github.com/litlfred/awho-mcp && cd awho-mcp && python3 -m pip install -e ."
      },
      "invoke": {
        "shell": "awho-mcp/scripts/local_up.sh --who-ig <dir> [--country-ig <dir>] [--fhir-port <n>] [--web-port <n>] [--down]"
      },
      "io": {
        "inputs": [
          {
            "name": "who-ig",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A checkout of the WHO SMART Immunizations IG, relative to the working directory (the folder holding the checkouts, e.g. `~/space_cats`).",
            "required": true,
            "arg": {
              "flag": "--who-ig"
            }
          },
          {
            "name": "country-ig",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A country adaptation IG checkout, e.g. `smart-immunizations-uganda`, relative to the working directory. Without it the app follows WHO's own schedule.",
            "required": false,
            "arg": {
              "flag": "--country-ig"
            }
          },
          {
            "name": "fhir-port",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Port",
            "description": "The HAPI port on 127.0.0.1. Default 8081.",
            "required": false,
            "arg": {
              "flag": "--fhir-port"
            }
          },
          {
            "name": "web-port",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Port",
            "description": "The form's port on 127.0.0.1. Default 8090.",
            "required": false,
            "arg": {
              "flag": "--web-port"
            }
          },
          {
            "name": "down",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Stop the form and the server.",
            "required": false,
            "arg": {
              "flag": "--down"
            }
          }
        ],
        "outputs": [
          {
            "name": "url",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url",
            "description": "The form, on 127.0.0.1. It stores nothing; each check is one inline `$apply` round.",
            "render": {
              "as": "url",
              "reason": "a reader opens the running app; the scheme is checked before it reaches an href"
            }
          }
        ]
      },
      "requirements": {
        "runtime": [
          "docker",
          "python3",
          "git"
        ],
        "network": true
      },
      "satisfies": [
        "http://smart.who.int/base/skill/l4-application-run-local"
      ]
    },
    {
      "@id": "http://smart.who.int/base/tools/l1-extraction-pages.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "l1-extraction-pages",
      "title": "Write the L1 extraction viewer: a page per instance holding `l1-extraction` directories, and a hub",
      "description": "For every visualiser an instance declares `renderedBy: l1-extraction-pages`, write the hub at `<locale>/<harness>/<id>/` and, with `subgraphs: \"instance\"`, one page per instance that declares an `l1-extraction` directory. Each shows what was extracted, read from the files by what they declare: the L1 statements (graph nodes carrying a `statement`, and an authored L1 source's `recommendations`), the candidate work list's counts, coverage and decisions, each graph document's nodes by type and edges by predicate (the L2 scenario candidates among them), the curation, mapping, vocabulary, exclusions and run context counted, and every file linked to its published copy (cat-harness's `library:viz`) when the site holds it and to its source at the pinned commit. A declared directory not on disk is reported UNKNOWN, never as zero.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run smart-base/scripts/gen-l1-extraction-pages.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "site",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "A site being built: the pages go under it (`visualiser-writers.ts` in cat-harness-tools passes it). Absent, they go under the checkout's site directory.",
            "required": false,
            "arg": {
              "flag": "--site"
            }
          },
          {
            "name": "root",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The checkout whose declarations are read. Default: the checkout holding the working directory.",
            "required": false,
            "arg": {
              "flag": "--root"
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Write nothing; exit 1 when a page is stale, missing or orphaned.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "pages",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Pages written: the hub and one per instance."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/graph-rendering"
      ]
    },
    {
      "@id": "http://smart.who.int/base/tools/l1-recommendation-candidates.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "l1-recommendation-candidates",
      "title": "L1 guideline → recommendation candidates (L1 3.0)",
      "description": "Find every normative sentence of an ingested `library/` entry (folio-assistant-core's `l1-coverage` markers), hint where a reading is uncertain, and propose the publication's identity. Given an agent's `l1-recommendation-curation/v1`, refuse a non-verbatim statement or an unknown location, and write the recommendations and remarks as an L1 3.0 graph, checked with `kg/src/validate.ts`, with coverage and the proposed (unsigned) exclusions.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run smart-base/scripts/l1-recommendation-candidates.ts --entry <library entry> [--curation <curation.yaml>] --out <dir> [--check]"
      },
      "io": {
        "inputs": [
          {
            "name": "entry",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "An ingested `library/<id>/` with page-tagged `sections/*.md` and `structure.json`.",
            "required": true
          },
          {
            "name": "curation",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The agent's decisions per candidate location (`l1-recommendation-curation/v1`). Absent: only the work list is written.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "candidates",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`recommendation-candidates.json` — every normative sentence, its hints and its decision; cites the run context."
          },
          {
            "name": "graph",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`l1.json` — L1 3.0 publication, recommendation and remark nodes, every one `inferred`."
          },
          {
            "name": "exclusions",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`exclusions.proposed.json`, in `l1-coverage`'s shape; none counts until a person signs it."
          },
          {
            "name": "warnings",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`extraction-warnings.md` — undecided candidates, unsigned exclusions, statements taken from a layout fragment."
          },
          {
            "name": "runContext",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`run-context.json`, cat-harness `folio-run-context/v1`."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "http://smart.who.int/base/skill/recommendation-candidates"
      ]
    },
    {
      "@id": "http://smart.who.int/base/tools/l1-recommendation-scenarios.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "l1-recommendation-scenarios",
      "title": "L1 recommendations → L2 user-scenario candidates",
      "description": "One smart-kg L2 `user-scenario` candidate per L1 recommendation, joined to a `persona` and a `business-process` by the edges smart-kg L2 already licenses, from an agent's `l1-scenario-mapping/v1`. Reuses the guide's own personas and processes, then smart-base's generic `DAK.Persona.*`; otherwise a glossary candidate or `could-not-determine`, each with a WARNING. Never invents a process.",
      "install": {
        "none": true
      },
      "invoke": {
