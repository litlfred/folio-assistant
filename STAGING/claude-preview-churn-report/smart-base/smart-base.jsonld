    },
    {
      "@id": "http://smart.who.int/base/process/Process_DIIG#flow/SF_DIIG_05",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns#SequenceFlow",
      "partOf": "http://smart.who.int/base/process/Process_DIIG",
      "from": "http://smart.who.int/base/process/Process_DIIG/node/A_DetermineInterventions",
      "to": "http://smart.who.int/base/process/Process_DIIG/node/GW_ProgressCheck4",
      "inSubgraph": "http://smart.who.int/base/directory/processes"
