            "required": true
          }
        ],
        "outputs": [
          {
            "name": "hub",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`dak-api.html`."
          },
          {
            "name": "sidecars",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "`.openapi.json` and `.displays.json` under `schemas/`."
