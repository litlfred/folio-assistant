    "bibliographyFile": {
      "type": "string",
      "description": "Path to the .bib bibliography file."
    },
    "outputFormat": {
      "type": "string",
      "enum": [
        "pdf",
        "dvi",
        "ps"
      ],
      "default": "pdf"
    }
  },
