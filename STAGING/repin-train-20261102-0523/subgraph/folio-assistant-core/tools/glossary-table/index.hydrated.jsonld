      "@type": "cat-harness:Tool",
      "description": "Rewrite the glossary and acronyms tables of a document from its folio-glossary/v1 schemes, as `glossary/glossary-tables.json` (folio-glossary-tables/v1) lists them: terms with their altLabels, definitions and editorial notes, or acronyms (notation and prefLabel). The block's caption and footnotes are left alone. `--check` writes nothing and fails when a table is stale.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat glossary:table"
      },
      "io": {
        "inputs": [
          {
            "arg": {
