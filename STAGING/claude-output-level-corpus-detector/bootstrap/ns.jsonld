  "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns",
  "@type": [
    "owl:Ontology",
    "skos:ConceptScheme"
  ],
  "label": "folio-assistant vocabulary (bootstrap only)",
  "comment": "Every class and property the folio knowledge graph projects, one node each. Generated by scripts/ns-export.ts; graph-kind definitions are read from the declaration registry rather than restated here.",
  "@graph": [
    {
      "@id": "bootstrap:Actor",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Actor",
      "comment": "A person, an agent or a program that can carry out work.",
      "prefLabel": "Actor",
      "definition": "A person, an agent or a program that can carry out work.",
      "notation": "bootstrap:Actor",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:Role",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Role",
      "comment": "The Node Kind whose instances name a responsibility an Actor takes on when carrying out Tasks, and list the Skills that responsibility needs.",
      "prefLabel": "Role",
      "definition": "The Node Kind whose instances name a responsibility an Actor takes on when carrying out Tasks, and list the Skills that responsibility needs.",
      "notation": "bootstrap:Role",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:Skill",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Skill",
      "comment": "The Node Kind whose instances are natural-language instructions an Actor follows to carry out one Task.",
      "prefLabel": "Skill",
      "definition": "The Node Kind whose instances are natural-language instructions an Actor follows to carry out one Task.",
      "notation": "bootstrap:Skill",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:Process",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Process",
      "comment": "The Node Kind whose instances coordinate Tasks: a BPMN diagram whose Process Nodes are joined by Sequence Flows, in lanes that each name the Role an Actor takes to carry out that lane's Tasks.",
      "prefLabel": "Process",
      "definition": "The Node Kind whose instances coordinate Tasks: a BPMN diagram whose Process Nodes are joined by Sequence Flows, in lanes that each name the Role an Actor takes to carry out that lane's Tasks.",
      "notation": "bootstrap:Process",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:ProcessNode",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "ProcessNode",
      "comment": "One element of a BPMN diagram: a Task, a decision, a start or an end.",
      "prefLabel": "ProcessNode",
      "definition": "One element of a BPMN diagram: a Task, a decision, a start or an end.",
      "notation": "bootstrap:ProcessNode",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:SequenceFlow",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "SequenceFlow",
      "comment": "An arrow in a BPMN diagram, from one Process Node to the next.",
      "prefLabel": "SequenceFlow",
      "definition": "An arrow in a BPMN diagram, from one Process Node to the next.",
      "notation": "bootstrap:SequenceFlow",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:Directory",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Directory",
      "comment": "A named subset of Node Instances: a Declaration's directory entry, with its id, its directory and its Graph Kinds.",
      "prefLabel": "Directory",
      "definition": "A named subset of Node Instances: a Declaration's directory entry, with its id, its directory and its Graph Kinds.",
      "notation": "bootstrap:Directory",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:Asset",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Asset",
      "comment": "A Declaration's file entry: one file about the repository itself, such as its README, with its stated purpose.",
      "prefLabel": "Asset",
      "definition": "A Declaration's file entry: one file about the repository itself, such as its README, with its stated purpose.",
      "notation": "bootstrap:Asset",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:GraphKind",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "GraphKind",
      "comment": "A named set of Node Kinds whose instances may be held together.",
      "prefLabel": "GraphKind",
      "definition": "A named set of Node Kinds whose instances may be held together.",
      "notation": "bootstrap:GraphKind",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:KGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "KGraph",
      "comment": "A Subgraph holding a Harness's own parts, such as Skills, Processes and Roles, where one directory holds more than one of them.",
      "prefLabel": "KGraph",
      "definition": "A Subgraph holding a Harness's own parts, such as Skills, Processes and Roles, where one directory holds more than one of them.",
      "notation": "bootstrap:KGraph",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:ModelGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "ModelGraph",
      "comment": "A Subgraph describing the language models an Actor may be: which languages each is good at, and whether a person checked.",
      "prefLabel": "ModelGraph",
      "definition": "A Subgraph describing the language models an Actor may be: which languages each is good at, and whether a person checked.",
      "notation": "bootstrap:ModelGraph",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:ProcessGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "ProcessGraph",
      "comment": "A Subgraph of Processes: BPMN diagrams that coordinate Tasks, and the decision tables their gateways compute from.",
      "prefLabel": "ProcessGraph",
      "definition": "A Subgraph of Processes: BPMN diagrams that coordinate Tasks, and the decision tables their gateways compute from.",
      "notation": "bootstrap:ProcessGraph",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:ScenarioGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "ScenarioGraph",
      "comment": "A Subgraph of Roles: the responsibilities an Actor takes on, and who takes them on.",
      "prefLabel": "ScenarioGraph",
      "definition": "A Subgraph of Roles: the responsibilities an Actor takes on, and who takes them on.",
      "notation": "bootstrap:ScenarioGraph",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:SchemaGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "SchemaGraph",
      "comment": "A Subgraph of Node Schemas: files that state the shape other files must have.",
      "prefLabel": "SchemaGraph",
      "definition": "A Subgraph of Node Schemas: files that state the shape other files must have.",
      "notation": "bootstrap:SchemaGraph",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:SkillGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "SkillGraph",
      "comment": "A Subgraph of Skills: the instructions an Actor follows to carry out a Task.",
      "prefLabel": "SkillGraph",
      "definition": "A Subgraph of Skills: the instructions an Actor follows to carry out a Task.",
      "notation": "bootstrap:SkillGraph",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:SwimlaneGlossaryGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "SwimlaneGlossaryGraph",
      "comment": "A Subgraph recording every term a Knowledge Graph's Processes have ever named, and when each stopped being used, so a retired term is never silently reused.",
      "prefLabel": "SwimlaneGlossaryGraph",
      "definition": "A Subgraph recording every term a Knowledge Graph's Processes have ever named, and when each stopped being used, so a retired term is never silently reused.",
      "notation": "bootstrap:SwimlaneGlossaryGraph",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:performerVaries",
      "@type": [
        "rdf:Property",
        "skos:Concept"
      ],
      "label": "performerVaries",
      "comment": "Whether this lane declines to name a persona because its performer is whoever invoked the process. A term so marked has no definition, and that absence is an assertion rather than a gap.",
      "prefLabel": "performerVaries",
      "definition": "Whether this lane declines to name a persona because its performer is whoever invoked the process. A term so marked has no definition, and that absence is an assertion rather than a gap.",
      "notation": "bootstrap:performerVaries",
      "inScheme": "https://litlfred.github.io/bootstrap/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
