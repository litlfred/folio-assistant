      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Directory",
      "comment": "A declared place to look, naming the kinds of graph found in it.",
      "prefLabel": "Directory",
      "definition": "A declared place to look, naming the kinds of graph found in it.",
      "notation": "bootstrap:Directory",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
