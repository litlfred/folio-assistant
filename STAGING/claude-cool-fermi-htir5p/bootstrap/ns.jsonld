        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Asset",
      "comment": "A file an instance declares as its own, with the role that file plays for it — the instance saying what something IS rather than a scan inferring it.",
      "prefLabel": "Asset",
      "definition": "A file an instance declares as its own, with the role that file plays for it — the instance saying what something IS rather than a scan inferring it.",
      "notation": "bootstrap:Asset",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
