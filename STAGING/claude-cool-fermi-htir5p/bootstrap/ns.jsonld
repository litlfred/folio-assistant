      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap"
    },
    {
      "@id": "bootstrap:performerVaries",
      "@type": [
        "rdf:Property",
        "skos:Concept"
      ],
      "label": "performerVaries",
      "comment": "Whether this lane declines to name a persona because its performer is whoever invoked the process. A term so marked has no definition, and that absence is an assertion rather than a gap.",
      "prefLabel": "performerVaries",
      "definition": "Whether this lane declines to name a persona because its performer is whoever invoked the process. A term so marked has no definition, and that absence is an assertion rather than a gap.",
      "notation": "bootstrap:performerVaries",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
