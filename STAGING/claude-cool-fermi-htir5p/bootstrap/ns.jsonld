  "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
  "@type": [
    "owl:Ontology",
    "skos:ConceptScheme"
  ],
  "label": "folio-assistant vocabulary (bootstrap only)",
  "comment": "Every class and property the folio knowledge graph projects, one node each. Generated by scripts/ns-export.ts; graph-kind definitions are read from the declaration registry rather than restated here.",
  "@graph": [
    {
      "@id": "bootstrap:Actor",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Actor",
      "comment": "A concrete participant — human, agentic or mechanical — that persists across processes and takes on a role in each.",
      "prefLabel": "Actor",
      "definition": "A concrete participant — human, agentic or mechanical — that persists across processes and takes on a role in each.",
      "notation": "bootstrap:Actor",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap",
      "seeAlso": "https://litlfred.github.io/agentic-harness.html"
    },
    {
      "@id": "bootstrap:Role",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Role",
      "comment": "A BPMN swimlane: the persona an actor takes on because of the lane it is acting in, carrying that lane's skills.",
      "prefLabel": "Role",
      "definition": "A BPMN swimlane: the persona an actor takes on because of the lane it is acting in, carrying that lane's skills.",
      "notation": "bootstrap:Role",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap",
      "seeAlso": "https://litlfred.github.io/agentic-harness.html"
    },
    {
      "@id": "bootstrap:Skill",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Skill",
      "comment": "The instruction body an actor needs to perform a task.",
      "prefLabel": "Skill",
      "definition": "The instruction body an actor needs to perform a task.",
      "notation": "bootstrap:Skill",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
      "layer": "bootstrap",
      "seeAlso": "https://litlfred.github.io/skills.html"
    },
    {
      "@id": "bootstrap:Process",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Process",
      "comment": "A BPMN process: lanes that bind roles, activities that name skills, and the flow between them.",
      "prefLabel": "Process",
      "definition": "A BPMN process: lanes that bind roles, activities that name skills, and the flow between them.",
      "notation": "bootstrap:Process",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
