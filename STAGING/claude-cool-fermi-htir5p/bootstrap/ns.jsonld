        "skos:Concept"
      ],
      "label": "SequenceFlow",
      "comment": "A directed edge between two process nodes.",
      "prefLabel": "SequenceFlow",
      "definition": "A directed edge between two process nodes.",
      "notation": "bootstrap:SequenceFlow",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant/ns/vocabulary.jsonld",
