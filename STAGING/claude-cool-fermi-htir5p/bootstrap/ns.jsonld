        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "GraphKind",
      "comment": "What a declared directory holds — the vocabulary a consumer matches on to decide whether to scan it.",
      "prefLabel": "GraphKind",
      "definition": "What a declared directory holds — the vocabulary a consumer matches on to decide whether to scan it.",
      "notation": "bootstrap:GraphKind",
