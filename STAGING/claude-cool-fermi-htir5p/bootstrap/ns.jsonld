      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "ProcessNode",
      "comment": "One element of a process — an activity, a gateway, a start or end event.",
      "prefLabel": "ProcessNode",
      "definition": "One element of a process — an activity, a gateway, a start or end event.",
      "notation": "bootstrap:ProcessNode",
      "inScheme": "https://litlfred.github.io/folio-assistant/bootstrap/ns",
