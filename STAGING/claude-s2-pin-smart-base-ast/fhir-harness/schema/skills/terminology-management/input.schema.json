        "LOINC",
        "IPS",
        "WHO-FIC",
        "WHO-ATC"
      ],
      "description": "Target standard terminology for mapping."
    },
    "inputFile": {
      "type": "string",
      "description": "Path to input terminology resource (FSH, JSON, CSV)."
    }
  },
