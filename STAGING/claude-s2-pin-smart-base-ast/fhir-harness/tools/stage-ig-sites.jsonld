  "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/stage-ig-sites.jsonld",
  "partOf": "https://litlfred.github.io/folio-assistant/fhir-harness/fhir-harness.jsonld",
  "staging": {
    "branch": "claude/s2-pin-smart-base-ast",
    "sha": "fb1c92f6cdd729c4553f7688a9a5cf5669bad3c0",
    "pr": "2887/merge",
    "run": "41335188874"
  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/stage-ig-sites.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "stage-ig-sites",
      "title": "Stage every IG whose instance records its source, one Jekyll site each",
      "description": "For every instance holding `fhir-artifact-index/menu.json` with a sushi-config source, clone the IG at the recorded commit and stage it with `build-ig-site`: the instance's webpage theme (inherited along `needs` when it declares none), its artefact pages and `artifacts` page, its post-processing fills, and an edit link to the IG's default branch. An instance whose docs directory declares `igSite` is staged to be served AT `/<instance>/` with its artefact pages copied in (a collision is refused); otherwise beside it at `/<instance>/ig/`. Prints one `<instance> <jekyll source> <at>` line per IG for the caller's `jekyll build` (beans `bamf`, `mftp`).",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run fhir-harness/scripts/stage-ig-sites.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "work",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Scratch directory: each IG's clone and its Jekyll source.",
            "required": true
          },
          {
            "name": "baseurl",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The site's base URL; each IG is served under it at `/<instance>/` or `/<instance>/ig/`.",
            "required": true
          },
          {
            "name": "plantuml-jar",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Render `input/images-source/*.plantuml` as the Publisher does.",
            "required": false
          },
          {
            "name": "changed-files",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Build only the IGs a changed file reaches (the staging cone, bean `4j86`).",
            "required": false
          },
          {
            "name": "compose-into",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "Move each staged IG into this host Jekyll source at `<instance>/`, so the host's build renders it: in the thin layout with the host's rail linked (the default), or with the host's full chrome (sidebar, search, language selector) under `--full-pages`.",
            "required": false
          },
          {
            "name": "compose-at-root",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "With `--compose-into` and `--only`: the IG IS the site — compose it at the host's ROOT, based at `--baseurl` itself. An IG repository's own site uses this with a `compose-docs --shell` host, so it wears the main site's chrome (#2235).",
            "required": false,
            "arg": {
              "flag": "--compose-at-root"
            }
          },
          {
            "name": "only",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug",
            "description": "Build one IG instance.",
            "required": false
          },
          {
            "name": "source",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "With `--only`: a local checkout of the IG's source to build from instead of cloning the recorded commit — an IG repository building its own site in CI.",
            "required": false
          },
          {
            "name": "full-pages",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "The opt-out. Without it (the default since 2026-10-12, owner: \"make thin default\") `artifacts.html` and `toc.html` are thin pages over the artefact index node, and composed IG pages wear the thin layout with the host's chrome linked, not inlined. With it, the full pages as before; it needs `gen-ig-pages --full-pages` too, and a mismatch is refused.",
            "required": false,
            "arg": {
              "flag": "--full-pages"
            }
          }
        ],
        "outputs": [
          {
            "name": "sites",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "IGs staged, one stdout line each; an instance with no recorded source is skipped and reported, never silently."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/fhir-harness/skill/ig-build-pipeline"
      ]
    }
  ]
}
