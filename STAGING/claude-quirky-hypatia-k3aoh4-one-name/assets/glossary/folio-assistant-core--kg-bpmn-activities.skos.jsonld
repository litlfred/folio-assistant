      },
      "skos:prefLabel": [
        {
          "@value": "Close the window back to its avatar"
        }
      ],
      "skos:definition": [
        {
          "@value": "[x] closes the window back to its avatar. Only a person's [x] does this; a zoom-out never closes a window, or [x] and zooming become indistinguishable to the reader."
        }
      ],
      "skos:notation": "A_Close",
      "dcterms:source": "folio-assistant-core/processes/ui/board-open-close.bpmn#A_Close",
      "skos:note": "candidate"
