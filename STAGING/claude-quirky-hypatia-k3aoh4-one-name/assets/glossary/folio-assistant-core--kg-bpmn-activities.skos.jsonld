      },
      "skos:prefLabel": [
        {
          "@value": "Comment staging URL on PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bot comments or updates the staging URL on the PR. Includes commit SHA, branch name, and build log link."
        }
      ],
      "skos:notation": "Task_CommentPR",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_CommentPR",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_commitpush",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Commit, push, update PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Agent commits all changes to the feature branch and pushes. The feature-staging.yml workflow automatically deploys to STAGING/<branch-slug>/ and comments the URL on the PR. For a rendered change the agent also produces the before/after preview (skill before-after-preview) and links it in the PR body."
        }
      ],
      "skos:notation": "Task_CommitPush",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_CommitPush",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_comparebeforeafter",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compare main vs staging"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review committee opens both URLs side by side: - Main site: <pages-url>/ (current published state) - Staging: <pages-url>/STAGING/<branch-slug>/ The staging banner shows the commit SHA so they can verify what they are reviewing matches the PR. A changed figure, diagram or table is also pictured before and after on the review page, with the share of changed pixels in words (skill visual-diff, Tool folio-block-screenshots). Anything the staging job cannot picture (page chrome, scroll behaviour, a PDF page, an IG page) is in the agent's before/after preview (skill before-after-preview)."
        }
      ],
      "skos:notation": "Task_CompareBeforeAfter",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_CompareBeforeAfter",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_createbranch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create feature branch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Agent creates a feature branch from main. Branch naming: feature/<short-description> Opens a PR immediately (AGENTS.md: \"open the PR at the first commit\")."
        }
      ],
      "skos:notation": "Task_CreateBranch",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_CreateBranch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_deploystaging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy to STAGING/<slug>/"
        }
      ],
      "skos:definition": [
        {
          "@value": "peaceiris/actions-gh-pages deploys to gh-pages branch under STAGING/<branch-slug>/ with keep_files: true so other staging deployments and the main site are preserved."
        }
      ],
      "skos:notation": "Task_DeployStaging",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_DeployStaging",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_describechange",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Describe the desired change"
        }
      ],
      "skos:definition": [
        {
          "@value": "Author describes the content change in natural language. Example: \"Update the immunization schedule to add a booster at 18 months.\""
        }
      ],
      "skos:notation": "Task_DescribeChange",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_DescribeChange",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_detectscope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect change scope & impact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Agent analyses the requested change: - Which content blocks are affected? - Are there downstream implications (indicators, referral logic, visit schedules)? - Will deterministic logic (CQL/DMN) need updating? skill: content-graph, integration-watcher"
        }
      ],
      "skos:notation": "Task_DetectScope",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_DetectScope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_editcontent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit narrative content blocks"
        }
      ],
      "skos:definition": [
        {
          "@value": "Agent modifies the relevant content blocks (.md files, block manifests). Validates each edit against the schema (content_validate). skill: content editing, block builders"
        }
      ],
      "skos:notation": "Task_EditContent",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_EditContent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_editlogic",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit deterministic logic (if needed)"
        }
      ],
      "skos:definition": [
        {
          "@value": "If the content change affects decision logic, indicators, or workflows: - Update CQL expressions - Update DMN decision tables - Adjust indicator definitions skill: dak-authoring, fhir-pipeline"
        }
      ],
      "skos:notation": "Task_EditLogic",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_EditLogic",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_ingestcomments",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ingest tagged review comments [folio-review-comments]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every PR conversation comment that starts with `block: <label>` becomes a `folio-review-comment/v1` todo (open), idempotently, and is published with the preview as `review-comments.json`. The staging workflow runs this on every push and on every tagged comment; the coordinator owns that it has run before slicing, because the slices are cut around what reviewers have already said. This is the `ingest` transition of REVIEW_TRANSITIONS."
        }
      ],
      "skos:notation": "Task_IngestComments",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_IngestComments",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_iterate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Iterate on author feedback"
        }
      ],
      "skos:definition": [
        {
          "@value": "Agent receives revision requests from the author and applies changes. Each push triggers a new staging deployment with updated SHA stamp. A revision push does not pass through Task_CommitPush, so for a rendered change the agent refreshes the before/after preview here (skill before-after-preview), and the next review round never reads a stale one."
        }
      ],
      "skos:notation": "Task_Iterate",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_Iterate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge, on explicit confirmation"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner says \"merge it\", and only then is the branch merged. Merge to main triggers: 1. the main site rebuilds with the changes; 2. the staging preview's cleanup runs; 3. the review comments committed on the feature branch land on main, as the review record."
        }
      ],
      "skos:notation": "Task_Merge",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_rebuildmain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Rebuild main site"
        }
      ],
      "skos:definition": [
        {
          "@value": "docs-site.yml triggers on the merge commit to main, rebuilding the root of gh-pages with the accepted changes. The build SHA stamp now reflects the merged state."
        }
      ],
      "skos:notation": "Task_RebuildMain",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_RebuildMain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_requestchanges",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Request changes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Committee provides feedback. PR stays open. Author and agent iterate further."
        }
      ],
      "skos:notation": "Task_RequestChanges",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_RequestChanges",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_requestrevision",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Request further revisions"
        }
      ],
      "skos:definition": [
        {
          "@value": "Author provides feedback on what needs adjustment. Agent iterates on the feature branch."
        }
      ],
      "skos:notation": "Task_RequestRevision",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_RequestRevision",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_reviewimpact",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review impact assessment"
        }
      ],
      "skos:definition": [
        {
          "@value": "Committee reviews the agent's impact assessment: - Were all downstream effects identified? - Are the indicator changes acceptable? - Does the logic change match the narrative intent?"
        }
      ],
      "skos:notation": "Task_ReviewImpact",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_ReviewImpact",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_reviewstaging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review staged rendering"
        }
      ],
      "skos:definition": [
        {
          "@value": "Author reviews the rendered feature branch at <pages-url>/STAGING/<branch-slug>/ and compares against the main site. The staging banner shows the commit SHA. The agent's before/after preview (skill before-after-preview) sits beside the URLs, with its counts and status line."
        }
      ],
      "skos:notation": "Task_ReviewStaging",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_ReviewStaging",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_reviewuses",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the editorial dependencies"
        }
      ],
      "skos:definition": [
        {
          "@value": "`uses[]` is what a READER must have read to follow the block — never populated from the formal dependency graph. Once every changed block is covered, the committee checks the editorial dependencies of the change as a whole before judging its impact. Moved here from the harness's `review-narrative` by placement PR3 (bean `63wl`): reading order is a property of folio content, so the step belongs to the content process, which reaches the harness's review by calling DOWN into `review-task`."
        }
      ],
      "skos:notation": "Task_ReviewUses",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_ReviewUses",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_sliceandassign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Slice the change and assign reviewers"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the ChangeSet and the heat map on the review page: cut the change into slices a reviewer can hold (usually a section, or a run of sections where the heat map clusters), and assign each slice to a review lane by what it contains — clinical content to a clinical SME, a decision table to a QC reviewer, prose to a narrative reviewer. A block that needs no review (a pure rename, say) is WAIVED here with a written reason, which is what the coverage gate counts. Re-entered from GW_Covered when coverage is incomplete: the uncovered blocks become new slices."
        }
      ],
      "skos:notation": "Task_SliceAndAssign",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_SliceAndAssign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_submitforreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Submit to review committee"
        }
      ],
      "skos:definition": [
        {
          "@value": "Author submits the PR for formal review by the guidance review committee. The STAGING URL is the review surface."
        }
      ],
      "skos:notation": "Task_SubmitForReview",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_SubmitForReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_watchbranchci",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the branch-watch bean [watch]"
        }
      ],
      "skos:definition": [
        {
          "@value": "First dispatch point for a CI watcher: the feature branch has changed and a staging build now exists to watch. The watcher is DISPATCHED BY OPENING A BEAN, not by a workflow_dispatch -- per the owner on bean 29ij, this is a task/workflow initiation. That is the whole reason it is an activity rather than a line of prose. A bean makes the watch durable past the session that opened it: the container is reclaimed, and what survives is the claim. Starting the watcher and recording that it is running are ONE declared step, so the two cannot disagree about whether anything is watching. Claim rather than note: the watch is work in progress, and it is idempotent, so re-entering on a subsequent push does not duplicate it."
        }
      ],
      "skos:notation": "Task_WatchBranchCI",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_WatchBranchCI",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_watchmainci",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Note the main-branch watch [watch]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Second dispatch point: the change was approved and merged, and the root of the site has been rebuilt from main. This is the moment docs-site.yml failed all 30 times over two months (bean xom7) while looking exactly like a green run from inside the repo. `note` rather than `claim`, and the difference is not cosmetic. By here the branch-watch bean already exists, and whether the publish SUCCEEDED is a judgement this step cannot make -- the build reports its own exit code, and xom7 is the record of that being believed. AGENTS.md: a bean is not closed on someone else's say-so. So the step records what it observed and leaves the verdict to the watcher."
        }
      ],
      "skos:notation": "Task_WatchMainCI",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_WatchMainCI",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_withdrawcomment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Withdraw a review comment [folio-review-comment-move]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer who made a comment takes it back (it was a misreading, or a later slice answered it). Recorded with `folio-review-comment-move --to withdrawn`, committed to the edit-set's feature branch like every status change. This is the `withdraw` transition of REVIEW_TRANSITIONS."
        }
      ],
      "skos:notation": "Task_WithdrawComment",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_WithdrawComment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_deepdocumentresearch.a_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Filter the corpus, choose the granularity, decompose the question"
        }
      ],
      "skos:definition": [
        {
          "@value": "The paper's Planner. Three outputs, and the middle one is the method's substance: a filtered document subset, the granularity to search at, and the sub-questions. CHOOSING THE GRANULARITY PER QUESTION is the whole point of parsing at several. A broad question is answered from summaries and a specific one from chunks; a pipeline that picks once has answered every future question the same way. This checkout cannot yet offer the choice — `l1-blocks.ts` produces blocks, there is no summary level — so this step SAYS which granularity it searched rather than implying the corpus offered alternatives. Re-entered on every iteration, not only the first: the sub-questions are re-derived from what has been found so far, which is what makes the loop a search rather than a retry."
        }
      ],
      "skos:notation": "A_Plan",
      "dcterms:source": "folio-assistant-core/processes/library/deep-document-research.bpmn#A_Plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_deepdocumentresearch.a_refine",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deduplicate, and keep what is actually relevant"
        }
      ],
      "skos:definition": [
        {
          "@value": "The paper's Refiner. Accumulates into the evidence set the report is built from — so what is dropped here is invisible downstream, which is why it is a step somebody performs rather than a filter buried in retrieval."
        }
      ],
      "skos:notation": "A_Refine",
      "dcterms:source": "folio-assistant-core/processes/library/deep-document-research.bpmn#A_Refine",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_deepdocumentresearch.a_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Synthesise, cite to a location, and say what was not found"
        }
      ],
      "skos:definition": [
        {
          "@value": "The paper's Reporter, with two obligations it does not state. CITE TO A LOCATION, not to a document — the page and bounding box the parse preserved, so a reader verifies a claim where it was made rather than being sent to a PDF. AND SAY WHAT WAS NOT FOUND. The failure this method makes easy is that a search which ended quietly looks exactly like one that succeeded. Sub-questions that returned nothing are reported, distinguishing \"not in the corpus\" from \"not found by this search\" — only the first is a fact about the folio. A figure description an agent drafted is NOT reported as what the figure shows. `schemas/narrative.ts` holds that line and this step does not cross it."
        }
      ],
      "skos:notation": "A_Report",
      "dcterms:source": "folio-assistant-core/processes/library/deep-document-research.bpmn#A_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_deepdocumentresearch.a_search",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retrieve for each sub-question"
        }
      ],
      "skos:definition": [
        {
          "@value": "The paper's Searcher, at the granularity A_Plan chose. Which retrieval paradigm — text-only, vision-only or hybrid — is recorded in the methodology node as an open trade-off rather than settled here: the paper's comparison was measured on its own corpus and says nothing about a folio's."
        }
      ],
      "skos:notation": "A_Search",
      "dcterms:source": "folio-assistant-core/processes/library/deep-document-research.bpmn#A_Search",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_authorblocks",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "4 · Author blocks [document-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every block edit runs the HCI validation gate — see editing-hci-validation.bpmn. A normative statement goes through normative-statements."
        }
      ],
      "skos:notation": "Task_AuthorBlocks",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_AuthorBlocks",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "1 · Plan the document [content-plan]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scope it: chapters, the blocks each needs, which statements are normative."
        }
      ],
      "skos:notation": "Task_Plan",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_Plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_profilecheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "5 · Check the profile [content-validate]"
        }
      ],
      "skos:definition": [
        {
          "@value": "content_profile_check: no math kind, no lean field, no .lean sibling. This is the step a paper folio does not have, and the reason a document folio never needs Lean or TeX to publish."
        }
      ],
      "skos:notation": "Task_ProfileCheck",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_ProfileCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "9 · Publish [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "See draft-to-publication.bpmn for the review and release path this expands into. Release authorisation is not relaxable."
        }
      ],
      "skos:notation": "Task_Publish",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_Publish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "7 · Render MD / HTML / PDF [document-publishing]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assemble to Markdown, then pandoc. The PDF goes through an HTML engine — never latexmk."
        }
      ],
      "skos:notation": "Task_Render",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_Render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "8 · Review and feedback [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer this folio binds. authoring-document relaxes the base SME step precisely because no single lane fits every document."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_scaffold",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "3 · Scaffold the folio [folio_init]"
        }
      ],
      "skos:definition": [
        {
          "@value": "folio_init writes content/, uploads/, library/, the manifests, the builder shim and AGENTS.md. Skipped when the folio already exists."
        }
      ],
      "skos:notation": "Task_Scaffold",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_Scaffold",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_seedplan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2 · Seed the work plan [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The plan becomes beans, so a resumed session or a sibling agent can pick it up."
        }
      ],
      "skos:notation": "Task_SeedPlan",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_SeedPlan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_documentauthoring.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "6 · Validate [content-validate]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Schema and constraint checks over every block."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "folio-assistant-core/processes/content/authoring-a-document.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.call_optionsanalysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Options analysis accept · revise · discard"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the edge out of `Task_ReviewFindings` and before `Task_RecordDecision`: the findings are the evidence, so the options can only be weighed once they exist, and after `Task_RecordDecision` the decision is already written down. NOT between `Gateway_EditorDecision` and `Task_RecordDecision`, which is the pair the work-plan named — in this diagram those run the OTHER WAY ROUND. `Flow_21b` goes `Task_RecordDecision` -> `Gateway_EditorDecision`, so the gateway reads a decision that has already been recorded, and interposing there would analyse options after the choice was made. In the Agent lane, and this diagram makes the reason sharp. `Task_RecordDecision` is a `userTask` in `Lane_Editor` that already names `decision-audit`, and `Process_OptionsAnalysis` ends with its own `decision-audit` note. Those are two different acts — the subprocess records that the options were WEIGHED, the editor records WHAT WAS CHOSEN — and putting the analysis in the editor's lane would collapse them, making the same party both analyse and decide. The subprocess's own documentation refuses that: it produces options and a recommendation, and the authorisation belongs to the calling step. `CallActivity_Evidence` sits in `Lane_Editor` instead, and that is not an inconsistency: the author performs the evidence retrieval, whereas here the point is that the analyst is not the decider. On the trigger: `A_Frame` opens the subprocess on `opening-brief`'s trigger — irreversibility and surprise — and leaving there is a correct outcome. A spelling fix that reached `Task_ReviewFindings` with one mechanical finding exits immediately; a revise-or-discard on a block other content depends on does not."
        }
      ],
      "skos:notation": "Call_OptionsAnalysis",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Call_OptionsAnalysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.callactivity_evidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Gather and verify the evidence [evidence-retrieval]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before anything is drafted: the author reads the guidance ALREADY in this content, frames the question as PICO, retrieves candidates across the three evidence classes, and has each candidate's authority resolved against its publisher's own API. A recommendation reaches the drafting step with its evidence attached, or with the gap recorded. This step has nothing to do for content that carries no recommendations -- a mathematics folio has none -- and is skipped there rather than satisfied vacuously."
        }
      ],
      "skos:notation": "CallActivity_Evidence",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#CallActivity_Evidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_agentreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Agent review of the change [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "A review agent judges what no checker can: accuracy, voice, exposition, whether the change says what the editor meant."
        }
      ],
      "skos:notation": "Task_AgentReview",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_AgentReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_buildgates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build and QA gates [content-test]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lean build and proof status, LaTeX compile, FHIR/SUSHI validation, QA axes."
        }
      ],
      "skos:notation": "Task_BuildGates",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_BuildGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_claimbean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Claim or open the bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every edit is tracked as a bean in beans/. Check for an existing bean by exact title first; claim it (status in-progress) rather than minting a duplicate."
        }
      ],
      "skos:notation": "Task_ClaimBean",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_ClaimBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_collatefindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Collate findings into a report"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mechanical results and review findings are merged into one report against the proposed change."
        }
      ],
      "skos:notation": "Task_CollateFindings",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_CollateFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_commit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Commit into the corpus"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only now does the change become corpus content, together with its QA sidecars. Subject to the commit-hygiene requirement."
        }
      ],
      "skos:notation": "Task_Commit",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_Commit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_describechange",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Describe the intended change"
        }
      ],
      "skos:definition": [
        {
          "@value": "The editor states the change in natural language; no content has moved yet."
        }
      ],
      "skos:notation": "Task_DescribeChange",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_DescribeChange",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_draftedit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Draft the block edit [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The authoring agent produces a PROPOSED change. Nothing is written to the corpus yet. For a rendered change it also produces the before/after preview (skill before-after-preview) here, before Gateway_ValidationFork, so the preview exists when the parallel review starts."
        }
      ],
      "skos:notation": "Task_DraftEdit",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_DraftEdit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_logfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log findings on the bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings are appended to the bean, so the next agent or human sees what is outstanding."
        }
      ],
      "skos:notation": "Task_LogFindings",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_LogFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_recorddecision",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the decision and its audit note [decision-audit]"
        }
      ],
      "skos:definition": [
        {
          "@value": "A decision is an act ABOUT the findings, not a finding. Record the outcome, every finding it weighed, every finding it overrules — and an audit note saying why it was made, or why a finding in it was left. Each note cites corpus evidence: a witness, another finding, a QA report, a block, a file range. An overruled mechanical finding stays on the record; a gate whose findings vanish when somebody disagrees with them cannot be audited. An agent may assemble the citations and is recorded as `proposed_by`; the author is whoever decided."
        }
      ],
      "skos:notation": "Task_RecordDecision",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_RecordDecision",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_resolvebean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve or re-open the bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Resolved when the change landed clean; left open with the residue when it did not."
        }
      ],
      "skos:notation": "Task_ResolveBean",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_ResolveBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_reviewfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE GATE: the editor sees every finding BEFORE anything reaches the corpus."
        }
      ],
      "skos:notation": "Task_ReviewFindings",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_ReviewFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_reviseedit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Revise the proposed change [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The editor chose revise: rework the proposed change against the findings the editor reviewed, then send it back through validation as a new proposal. The before/after preview is refreshed with it (skill before-after-preview)."
        }
      ],
      "skos:notation": "Task_ReviseEdit",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_ReviseEdit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_schemavalidate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Schema and constraint checks [content-validate]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Block schema, label prefixes, required fields, constraint rules."
        }
      ],
      "skos:notation": "Task_SchemaValidate",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_SchemaValidate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_smereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Human / SME review [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Escalated to a human reviewer or subject-matter expert when the change turns on clinical or scientific judgement. A rendered change reaches the reviewer with its before/after preview (skill before-after-preview)."
        }
      ],
      "skos:notation": "Task_SmeReview",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_SmeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_editing.task_syntaxspell",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Syntax, spelling and links [content-validate]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Syntax, spelling, cross-references, citation and link resolution."
        }
      ],
      "skos:notation": "Task_SyntaxSpell",
      "dcterms:source": "folio-assistant-core/processes/content/editing-hci-validation.bpmn#Task_SyntaxSpell",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_appraisegrade",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Appraise and grade the body of evidence"
        }
      ],
      "skos:definition": [
        {
          "@value": "Certainty of evidence per the grading system the folio declares. The grade attaches to the BODY of evidence for one PICO question, not to an individual citation -- which is why this step is after the join and not inside the fan-out."
        }
      ],
      "skos:notation": "Task_AppraiseGrade",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_AppraiseGrade",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_attachevidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Attach the evidence to the recommendation [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The PICO, the graded body of evidence, each verified citation and its resolved authority record are written onto the recommendation block, so a reader can retrace the whole chain from the sentence back to the source."
        }
      ],
      "skos:notation": "Task_AttachEvidence",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_AttachEvidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_datarepos",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Query data repositories and statistical datasets"
        }
      ],
      "skos:definition": [
        {
          "@value": "Indicator and microdata sources. Distinct from the two above because the unit of evidence is a MEASUREMENT with a population, a period and a method, not a claim in prose."
        }
      ],
      "skos:notation": "Task_DataRepos",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_DataRepos",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_framepico",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Frame the question as PICO [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Population, Intervention, Comparator, Outcome. The PICO is what makes the search reproducible and the evidence auditable: without it, 'we looked for evidence' is not a claim anyone can check. WHO guideline development states the question this way before any retrieval."
        }
      ],
      "skos:notation": "Task_FramePico",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_FramePico",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_l1sources",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search trusted SOURCES — L1 [document-intake]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ingested primary literature under library/: the sections/*.md tree and, where a document was scanned, ocr/page-NNN.txt. NOTE the known blind spot — a document OCR'd but never re-run through pdf-structure.py has only a stub in sections/, so a sections-only search misses it."
        }
      ],
      "skos:notation": "Task_L1Sources",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_L1Sources",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_l2l3content",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search trusted CONTENT — L2 DAKs, L3 IGs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Already-adjudicated guidance: WHO SMART DAKs at L2 and FHIR Implementation Guides at L3. A recommendation adopted in a published DAK is evidence of a different kind from a primary study -- it is a prior decision, with its own provenance, and must be cited as that rather than laundered into primary evidence. NOT YET SKILL-BACKED. This step named `corpus-search`, which has never existed. It is not `corpus-grep`, whose job is the pre-declaration check that something really is an open gap — searching adjudicated L2/L3 content for evidence is a different task, so pointing the ref there would have been a plausible-looking wrong answer. Left uncovered until the skill is written."
        }
      ],
      "skos:notation": "Task_L2L3Content",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_L2L3Content",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_recordgap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the evidence gap [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Insufficient evidence is a RESULT. It is recorded as such -- an honest gap the guideline can state -- rather than being closed by weakening the recommendation until the available evidence supports it."
        }
      ],
      "skos:notation": "Task_RecordGap",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_RecordGap",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_recordunverified",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open a bean for the unverified citation [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "An unresolvable citation is not dropped and not silently kept. It becomes a tracked item, so the gap is visible in the work plan rather than surviving as a footnote nobody re-checks."
        }
      ],
      "skos:notation": "Task_RecordUnverified",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_RecordUnverified",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_reviewexisting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the guidance already in this content [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The author reads what the document, DAK or IG ALREADY says on this question, before looking outward. A recommendation that contradicts a sibling recommendation in the same artefact is a defect no external evidence will reveal."
        }
      ],
      "skos:notation": "Task_ReviewExisting",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_ReviewExisting",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_evidenceretrieval.task_verifyauthority",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify authority against the observatory / registry API"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each candidate is resolved against the standard API of the body that publishes it, so that 'authoritative' is a RESOLVED FACT rather than an assertion in the citation. What is checked: that the identifier resolves at the publisher; that the retrieved record matches what the citation claims; that the version and date are the ones cited; and that the publisher is one this folio has declared trusted. STRAWPERSON: the concrete registry list and endpoints are not settled here -- see the cat-harness.processes:policy note."
        }
      ],
      "skos:notation": "Task_VerifyAuthority",
      "dcterms:source": "folio-assistant-core/processes/content/evidence-retrieval.bpmn#Task_VerifyAuthority",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_askintent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose from the offered options"
        }
      ],
      "skos:definition": [
        {
          "@value": "The question is presented as a short list of selectable options, never as free prose, and the list names the top-level content types the agent knows about. The answer becomes the statedIntent fact and the table is evaluated again — the user's answer is read as evidence, like any other fact."
        }
      ],
      "skos:notation": "Task_AskIntent",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_AskIntent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_confirmimport",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import what, where, and who does it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three questions the scan cannot answer: import these or not; library or content for each group; leave the files where they are or reorganize to declutter. Plus whether to dispatch one ingestion agent or a small swarm. Non-relaxable: nobody's files are moved or imported on inference."
        }
      ],
      "skos:notation": "Task_ConfirmImport",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_ConfirmImport",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_createrepo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create the repository"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only on the new-repo branch, and only after the user has named it. An empty working directory is scaffolded in place instead."
        }
      ],
      "skos:notation": "Task_CreateRepo",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_CreateRepo",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_detectmodality",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect the interaction modality"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before the first question is asked, establish HOW to ask it: audio, ordinary chat, selectable options for a user with limited hand function, large-type for low vision. A user who finds the questions unusable never reaches the rest of this diagram."
        }
      ],
      "skos:notation": "Task_DetectModality",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_DetectModality",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_pagesbootstrap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Start the Pages build and derive the URL"
        }
      ],
      "skos:definition": [
        {
          "@value": "scripts/pages-bootstrap.ts: derive the site URL from the git remote or <name>.config.json, report whether a publish workflow exists, and optionally probe until the site answers."
        }
      ],
      "skos:notation": "Task_PagesBootstrap",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_PagesBootstrap",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_readfacts",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the repository facts"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mechanical, read-only: does a `<name>.config.json` declare a contentType, does the working tree hold somebody's existing project, and what has the user actually said. These are the three inputs to folio-intent.dmn. Non-relaxable: scaffolding without looking first is how a folio gets written over somebody's project."
        }
      ],
      "skos:notation": "Task_ReadFacts",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_ReadFacts",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_reportpending",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Say where it will be"
        }
      ],
      "skos:definition": [
        {
          "@value": "A measured 404. The author is told the address and that the first build has not landed there yet — which is useful, and is not the same as being told it is live."
        }
      ],
      "skos:notation": "Task_ReportPending",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_ReportPending",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_reportunknown",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Say it could not be confirmed"
        }
      ],
      "skos:definition": [
        {
          "@value": "No URL, no probe, or a failed request. Reported as \"could not check\", never as \"not yet\" and never as \"live\"."
        }
      ],
      "skos:notation": "Task_ReportUnknown",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_ReportUnknown",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_reporturl",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand over the live link"
        }
      ],
      "skos:definition": [
        {
          "@value": "Confirmed live. The link is given as a link, and the author is told what is on it."
        }
      ],
      "skos:notation": "Task_ReportUrl",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_ReportUrl",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_scaffold",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scaffold the folio (folio_init)"
        }
      ],
      "skos:definition": [
        {
          "@value": "content/, uploads/, library/, the first manifests, <slug>.json and <slug>.config.json, the builder shim, AGENTS.md with its stubs, .mcp.json, the session-start hook and the beans store. Refuses rather than overwrites when a folio is already present."
        }
      ],
      "skos:notation": "Task_Scaffold",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_Scaffold",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_scanrepo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the repo for content worth importing"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read-only. Classifies candidates into library/ (external source) and content/ (authored here), and reports what it could not classify as its own bucket rather than forcing every file into one of the two."
        }
      ],
      "skos:notation": "Task_ScanRepo",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_ScanRepo",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_gettingstarted.task_seedplan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the work plan"
        }
      ],
      "skos:definition": [
        {
          "@value": "The first beans: what the author said they want to get started on, one bean per top-level content object they named."
        }
      ],
      "skos:notation": "Task_SeedPlan",
      "dcterms:source": "folio-assistant-core/processes/conduct/getting-started.bpmn#Task_SeedPlan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_lifecycle.callactivity_editing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Editing and HCI validation [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "See editing-hci-validation.bpmn. Runs once per proposed change, not once per cycle."
        }
      ],
      "skos:notation": "CallActivity_Editing",
      "dcterms:source": "folio-assistant-core/processes/content/content-lifecycle.bpmn#CallActivity_Editing",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_lifecycle.callactivity_publication",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Draft, review and publish [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "See draft-to-publication.bpmn."
        }
      ],
      "skos:notation": "CallActivity_Publication",
      "dcterms:source": "folio-assistant-core/processes/content/content-lifecycle.bpmn#CallActivity_Publication",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_lifecycle.task_feedback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Triage published feedback [content-feedback]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Implementer and reader feedback on the published folio, triaged by severity and scope."
        }
      ],
      "skos:notation": "Task_Feedback",
      "dcterms:source": "folio-assistant-core/processes/content/content-lifecycle.bpmn#Task_Feedback",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_lifecycle.task_feedbackbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "File feedback as beans [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Triaged feedback re-enters the work plan as beans, which is how the next cycle knows what it is for."
        }
      ],
      "skos:notation": "Task_FeedbackBeans",
      "dcterms:source": "folio-assistant-core/processes/content/content-lifecycle.bpmn#Task_FeedbackBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_lifecycle.task_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Plan scope, team, artifacts [content-plan]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scope the work, identify artifacts and actors, form the team, set the timeline."
        }
      ],
      "skos:notation": "Task_Plan",
      "dcterms:source": "folio-assistant-core/processes/content/content-lifecycle.bpmn#Task_Plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_lifecycle.task_retire",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retire or archive [content-retire]"
        }
      ],
      "skos:definition": [
        {
          "@value": "No more content is planned: deprecate the folio. Post a deprecation notice and timeline, update its status metadata, archive it, point references at any successor, and remove it from active publication. The programme manager decides; retirement archives rather than deletes."
        }
      ],
      "skos:notation": "Task_Retire",
      "dcterms:source": "folio-assistant-core/processes/content/content-lifecycle.bpmn#Task_Retire",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_lifecycle.task_seedbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the work plan [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The plan becomes beans. From here on, beans/ is the shared answer to 'what is done, what is next' — for humans and agents alike."
        }
      ],
      "skos:notation": "Task_SeedBeans",
      "dcterms:source": "folio-assistant-core/processes/content/content-lifecycle.bpmn#Task_SeedBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_lifecycle.task_test",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Integration test and QA sweep [content-test]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Corpus-wide checks that a single-block gate cannot make: cross-references, build green, proof status, QA axes across the whole folio."
        }
      ],
      "skos:notation": "Task_Test",
      "dcterms:source": "folio-assistant-core/processes/content/content-lifecycle.bpmn#Task_Test",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.callactivity_editing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Editing and HCI validation [content-author]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The editing sub-process. Every change to the corpus goes through its HCI validation gate — a red draft is fixed there, never by patching the built artifact."
        }
      ],
      "skos:notation": "CallActivity_Editing",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#CallActivity_Editing",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_authorizerelease",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the release [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Publication requires authorisation by the programme manager or designated authority."
        }
      ],
      "skos:notation": "Task_AuthorizeRelease",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_AuthorizeRelease",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_builddraft",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the draft publication [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render the corpus into the draft form of the folio: PDF, HTML site, or FHIR IG."
        }
      ],
      "skos:notation": "Task_BuildDraft",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_BuildDraft",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_circulatedraft",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Circulate the draft [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The draft publication is circulated to the review team for formal review."
        }
      ],
      "skos:notation": "Task_CirculateDraft",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_CirculateDraft",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_closereleasebeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the release beans [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "What shipped is resolved; what slipped stays open and carries into the next cycle."
        }
      ],
      "skos:notation": "Task_CloseReleaseBeans",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_CloseReleaseBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_openchangebeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open beans for the change requests [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each requested change becomes a bean, so the editors and agents picking the work up next see exactly what review asked for and what is still open."
        }
      ],
      "skos:notation": "Task_OpenChangeBeans",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_OpenChangeBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_openreleasebean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or claim the release bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The release itself is a bean: it carries what is in this draft, what is outstanding, and who is holding it."
        }
      ],
      "skos:notation": "Task_OpenReleaseBean",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_OpenReleaseBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_publicationqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run publication QA gates [content-test]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Publication-readiness QA across layers — QC reports, IG Publisher QA, proof status, broken links, build warnings."
        }
      ],
      "skos:notation": "Task_PublicationQa",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_PublicationQa",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_publishrelease",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Version, tag and publish [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Version bump, release notes, tag, build the final artifacts, deploy to the publication platform. The deploy is the general render-kg-to-cdn step with the RELEASE root as its publication root URL — the same step a staging preview takes with a root under it; the target (GitHub Pages, or a folio's own platform) is chosen by its Tool."
        }
      ],
      "skos:notation": "Task_PublishRelease",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_PublishRelease",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_reviewdraft",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the draft publication [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Content reviewer, QC reviewer and technical officer review the draft as a whole — coherence, phase-gate criteria, breaking vs non-breaking change."
        }
      ],
      "skos:notation": "Task_ReviewDraft",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_ReviewDraft",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_publication.task_smesignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Clinical / scientific sign-off [content-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Domain sign-off: clinical SMEs for a guideline, subject-matter reviewers for a paper."
        }
      ],
      "skos:notation": "Task_SmeSignoff",
      "dcterms:source": "folio-assistant-core/processes/content/draft-to-publication.bpmn#Task_SmeSignoff",
      "skos:note": "candidate"
    }
  ]
}
