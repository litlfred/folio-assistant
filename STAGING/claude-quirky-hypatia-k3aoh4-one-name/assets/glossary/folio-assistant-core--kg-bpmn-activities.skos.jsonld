    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardopenclose.a_offerwayback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave a reachable way back"
        }
      ],
      "skos:definition": [
        {
          "@value": "Leave the way back reachable: the collapsed window becomes a control in its own position and focus moves to it — left alone, focus lands on <body> and the keyboard position is lost. An action whose inverse is not reachable is not a toggle (bean l4zi)."
        }
      ],
      "skos:notation": "A_OfferWayBack",
      "dcterms:source": "folio-assistant-core/processes/ui/board-open-close.bpmn#A_OfferWayBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardopenclose.a_open",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Project a window onto the board"
        }
      ],
      "skos:definition": [
        {
          "@value": "Project a window onto the board for the chosen card. A window is not the card grown large: it survives zooming out, and only [x] closes it. The frame is fixed ([x] always present, always in the same place); the kind fills in its declared controls."
        }
      ],
      "skos:notation": "A_Open",
      "dcterms:source": "folio-assistant-core/processes/ui/board-open-close.bpmn#A_Open",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardopenclose.a_raise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise the window the reader selected"
        }
      ],
      "skos:definition": [
        {
          "@value": "Raise the selected window to the top. Selecting ANY part raises it, not just a title bar. Z-order is session-only by stated default: no z is written to the layout, so a raise is never a file write."
        }
      ],
      "skos:notation": "A_Raise",
      "dcterms:source": "folio-assistant-core/processes/ui/board-open-close.bpmn#A_Raise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardopenclose.a_renderavatars",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render every card as its avatar"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render every card as its avatar — the starting state. Each content kind controls its own avatar; the board decides only that nothing starts open."
        }
      ],
      "skos:notation": "A_RenderAvatars",
      "dcterms:source": "folio-assistant-core/processes/ui/board-open-close.bpmn#A_RenderAvatars",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardopenclose.a_resolvethreshold",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the kind's zoom threshold"
        }
      ],
      "skos:definition": [
        {
          "@value": "Resolve the semantic-zoom threshold for each card's kind: the folio default unless the kind overrides it with a stated because. Return the source alongside the value, so a card that flipped too early can be traced to a decision or to a default."
        }
      ],
      "skos:notation": "A_ResolveThreshold",
      "dcterms:source": "folio-assistant-core/processes/ui/board-open-close.bpmn#A_ResolveThreshold",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardopenclose.a_swaptoavatar",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Swap cards below the threshold; leave open windows alone"
        }
      ],
      "skos:definition": [
        {
          "@value": "Cards whose rendered width is strictly below the threshold swap to their avatar — automatic, driven by size. Open windows are left alone: semantic zoom and open/close are two mechanisms and must not be conflated."
        }
      ],
      "skos:notation": "A_SwapToAvatar",
      "dcterms:source": "folio-assistant-core/processes/ui/board-open-close.bpmn#A_SwapToAvatar",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardplacenote.a_createnote",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the note into the folio — with no coordinate"
        }
      ],
      "skos:definition": [
        {
          "@value": "A new note: write it into the folio with no x, no y, no board and no position. A folio is complete with no board, and one note may sit on several boards, which a coordinate on the note could not express."
        }
      ],
      "skos:notation": "A_CreateNote",
      "dcterms:source": "folio-assistant-core/processes/ui/board-place-note.bpmn#A_CreateNote",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardplacenote.a_place",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record x,y for this note on THIS board"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record the note's x,y in the layout layer for THIS board, naming the note by id. An existing card dragged here only gets a new position — placing is not creating, so no content is duplicated."
        }
      ],
      "skos:notation": "A_Place",
      "dcterms:source": "folio-assistant-core/processes/ui/board-place-note.bpmn#A_Place",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardplacenote.a_sweeporphans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sweep positions whose note is gone"
        }
      ],
      "skos:definition": [
        {
          "@value": "Remove every position in this board's layer whose note no longer exists. The sweep edits only the layer — one file, one pass — and never a note a person owns; a stale position must not keep a note alive."
        }
      ],
      "skos:notation": "A_SweepOrphans",
      "dcterms:source": "folio-assistant-core/processes/ui/board-place-note.bpmn#A_SweepOrphans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardrelocate.a_askconfirm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name what will move, and where it lands"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before anything moves, name the content that would move — what it is, with its size and age — and where it lands. The confirmation sits in front of the move: an agent never relocates a durable artefact on its own initiative."
        }
      ],
      "skos:notation": "A_AskConfirm",
      "dcterms:source": "folio-assistant-core/processes/ui/board-relocate.bpmn#A_AskConfirm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardrelocate.a_cancel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave the content exactly where it is"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reader said no: nothing moves, no position is dropped, and the board is left exactly as it was. Drawn as its own end state because a destructive action whose refusal is not drawn gets performed by accident."
        }
      ],
      "skos:notation": "A_Cancel",
      "dcterms:source": "folio-assistant-core/processes/ui/board-relocate.bpmn#A_Cancel",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardrelocate.a_movecontent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Relocate the content to the trashcan"
        }
      ],
      "skos:definition": [
        {
          "@value": "Relocate the confirmed content — that one thing, not the class it belongs to — to the trashcan. The folio changes first, because the folio carries what is true."
        }
      ],
      "skos:notation": "A_MoveContent",
      "dcterms:source": "folio-assistant-core/processes/ui/board-relocate.bpmn#A_MoveContent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardrelocate.a_reportmove",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Say what moved and where it went"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tell the reader what moved and where it went, so the content can be found in the trashcan rather than inferred missing from a card that disappeared."
        }
      ],
      "skos:notation": "A_ReportMove",
      "dcterms:source": "folio-assistant-core/processes/ui/board-relocate.bpmn#A_ReportMove",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_boardrelocate.a_updatelayer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Drop its positions and sweep orphans"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only after the content has moved: drop its positions from the layout layer and sweep any position whose note is now gone. Sweeping first would make the board authoritative over the folio for one step."
        }
      ],
      "skos:notation": "A_UpdateLayer",
      "dcterms:source": "folio-assistant-core/processes/ui/board-relocate.bpmn#A_UpdateLayer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.call_adjudication",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the disagreement [adjudication]"
        }
      ],
      "skos:definition": [
        {
          "@value": "adjudication.bpmn. When the editor and a reviewer, or two reviewers, disagree about a finding, an adjudicator settles it and records why; the review comment moves to `adjudicated` with the Decision that closed it. Permitted answers (bean `bvuk`, owner 2026-09-23): `stands` — the finding is right and the author addresses it; `withdrawn` — the finding is wrong and the comment closes. Recorded on the comment, not branched: either way the flow goes on to the coverage check."
        }
      ],
      "skos:notation": "Call_Adjudication",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Call_Adjudication",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.call_optionsanalysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Options analysis how to absorb the impact"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the edge OUT of `Task_AssessImpact` and before `Task_CommitPush`, because the impact assessment is the evidence the options are weighed against. An analysis before it would compare ways of absorbing a downstream effect nobody has measured yet; one after the commit would be a rationalisation of a choice already pushed. NOT between `Task_AssessImpact` and `Task_ReviewImpact`, although that is the handoff the work-plan named. Those two tasks are in DIFFERENT LANES with no sequence flow between them — the agent's assessment reaches the committee through `Task_CompareBeforeAfter`, not directly — so there was no edge there to interpose on. The conceptual handoff is real; the edge was not. In the Agent lane, matching `upstream-version-adoption`: this step produces the options and their trade-offs, and `GW_Approved` in the Review Committee lane is where a decision is taken. A subprocess in the reviewer's lane would read as the committee analysing its own options, which is a different process. On the trigger: reaching this call is not the same as running the whole of it. `Process_OptionsAnalysis` opens with `A_Frame`, whose trigger is `opening-brief`'s — irreversibility and surprise, not size — and leaving at that first activity is a correct outcome rather than a skipped step. A copy-edit exits immediately; a logic change that moves an indicator does not, and this is the diagram where that distinction has teeth, since `Task_EditLogic` feeds straight into the assessment."
        }
      ],
      "skos:notation": "Call_OptionsAnalysis",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Call_OptionsAnalysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.call_reviewslices",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review each slice [review-task]"
        }
      ],
      "skos:definition": [
        {
          "@value": "review-task.bpmn, once per slice, in parallel lanes by role. What kind of thing changed decides which review the slice descends into; the reviewer takes on that inner lane's role for the call only. Each reviewer gives the slice's blocks a verdict, and comments on the pull request with the `block:` tag where something needs saying."
        }
      ],
      "skos:notation": "Call_ReviewSlices",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Call_ReviewSlices",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_approve",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Approve"
        }
      ],
      "skos:definition": [
        {
          "@value": "The committee approves the change: the judgement, recorded with the evidence it rests on. Approving is not merging. They were one task (\"Approve and merge\") until bean en2d split them, because a self-authored change cannot be approved through GitHub's own review (the approver may not be the PR's author), and a merge needs the owner's explicit confirmation whoever approved."
        }
      ],
      "skos:notation": "Task_Approve",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_Approve",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_assessimpact",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Assess downstream impact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Agent reviews downstream implications: - Will indicators need adjustment? - Will referral/follow-up for next visit be impacted? - Are translations affected (re-extract POT)? - Do Lean proofs still hold? skill: integration-watcher, translation-manager"
        }
      ],
      "skos:notation": "Task_AssessImpact",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_AssessImpact",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities/process_contentchangereview.task_buildstaging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build staging site"
        }
      ],
      "skos:definition": [
        {
          "@value": "feature-staging.yml triggers: 1. Regenerate docs (schema, skills, content-backed pages) 2. Render BPMN diagrams 3. Stamp build with commit SHA + timestamp + branch 4. Build Jekyll site with STAGING/ baseurl 5. Inject yellow staging banner into every HTML page"
        }
      ],
      "skos:notation": "Task_BuildStaging",
      "dcterms:source": "folio-assistant-core/processes/content/content-change-review.bpmn#Task_BuildStaging",
      "skos:note": "candidate"
    },
