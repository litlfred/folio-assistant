      "type": "string",
      "description": "Lean module path for the output (e.g. 'Qou.CategoryTheory.Functors')."
    },
    "proofStrategy": {
      "type": "string",
      "enum": [
        "tactic",
        "term",
        "mixed"
      ],
      "default": "tactic",
      "description": "Preferred proof style."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lean package dependencies (lake packages)."
    }
  },
