        {
          "@value": "BPMN workflow engine"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run a declared BPMN process as an instance: `workflow_start` opens one for a subject, `workflow_next` reports what is enabled, `workflow_complete` records a step or answers a decision (a DMN-computed one from `facts`) and REFUSES a step that is not enabled. State is committed under the work plan, so which edge was taken is a record, not a memory."
        }
      ],
