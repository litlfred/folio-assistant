      "ofConcept": "https://litlfred.github.io/folio-assistant/STAGING/claude-wire-audit-reachability/bootstrap/bootstrap.jsonld#process/Process_HumanAgentDiscussion/lane/Lane_Agent",
      "inProcess": "https://litlfred.github.io/folio-assistant/STAGING/claude-wire-audit-reachability/bootstrap/bootstrap.jsonld#process/Process_HumanAgentDiscussion",
      "label": "Agent",
      "scopeNote": "Whichever agent called this sub-process. It determines where it is, prepares the question, rules on whether an answer settles it, and records the outcome in the form its caller asked for. It never supplies the answer itself.",
      "source": "bootstrap/processes/human-agent-discussion.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-wire-audit-reachability/bootstrap/bootstrap.jsonld#process/Process_LogMessage/lane/Lane_Actor",
      "@type": "skos:Concept",
      "prefLabel": "Actor",
