      },
      "skos:prefLabel": [
        {
          "@value": "Glossary page"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render every declared glossary — authored SKOS schemes, the swimlane ledger and the terms extracted from knowledge-graph assets — as the glossary page and one page per asset type, at the route of the visualiser core declares for it."
        }
      ],
      "skos:notation": "glossary-page",
      "dcterms:source": "folio-assistant-core/tools/glossary-page/glossary-page.ts#glossary-page",
