      "skos:prefLabel": [
        {
          "@value": "Bibliography page"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render every reference in the checkout (each declared `references` directory's folio-reference/v1 nodes and each `catalogue` directory's Dublin Core records) as the bibliography page and one page per sub-graph, each with its BibTeX, CSL-JSON, RIS and Dublin Core JSON-LD exports and a per-reference export, at the route of the visualiser core declares for it."
        }
      ],
      "skos:notation": "bibliography-page",
      "dcterms:source": "folio-assistant-core/tools/bibliography-page/bibliography-page.ts#bibliography-page",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/block-actions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Block edit and feedback links"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each labelled block's links back to where it can be changed: [edit] opens the block's Markdown source in GitHub's editor on `main`, and [feedback] opens a new GitHub issue about the block, from the folio's `.github/ISSUE_TEMPLATE/block-feedback.yml` when it has one (prefilling only the fields it declares: block, section, source, page, url) or as a plain issue whose body carries the same facts. The document build draws these on every block; this Tool prints them as JSON for one block or all. Governed by the `block-actions` skill (bean `uphx`, REQ-17)."
        }
      ],
      "skos:notation": "block-actions",
      "dcterms:source": "folio-assistant-core/tools/block-actions/block-actions.ts#block-actions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/catalogue-from-references",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Catalogue a library from its bibliography"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write one `folio-dublin-core/v1` record and one `folio-catalogue-node/v1` item per library entry that the source ledger joins to a CSL-JSON reference, into the folio's declared `catalogue` directory, so `gen-library-jsonld` reads the title from the catalogue's `dc.title` instead of falling to the PDF or the slug. The join is exact: a ledger row naming the entry's `structure.json` source file, one reference id, and the same sha256 where both record one. Unjoined entries are reported and left alone. Never touches a node it did not write (folio-assistant-core#72)."
        }
      ],
      "skos:notation": "catalogue-from-references",
      "dcterms:source": "folio-assistant-core/tools/catalogue-from-references/catalogue-from-references.ts#catalogue-from-references",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/dublin-core-render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Dublin Core renderings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render every `folio-dublin-core/v1` record a catalogue item names as Dublin Core XML (qualified DC, per DCMI's XML guidelines) and as JSON-LD bound to DCMI Metadata Terms. Both are written into the instance's published root (`<instanceRoot>/dublin-core/<stem>.dc.xml` and `.dc.jsonld`), so the site mount publishes them beside the item pages. Deterministic. `--check` fails on a missing, stale or orphaned rendering. Governed by the `dublin-core-renderings` skill (bean `7eak`)."
        }
      ],
      "skos:notation": "dublin-core-render",
      "dcterms:source": "folio-assistant-core/tools/dublin-core-render/dublin-core-render.ts#dublin-core-render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/folio-block-qa-summary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio block QA summary"
        }
      ],
      "skos:definition": [
        {
          "@value": "Summarise a folio's committed per-block QA verdicts into one `block-qa.json` a staging preview publishes: each block is failing (a FRESH verdict failed, with the worst severity), stale (a verdict predates the block's current files), passing, or unaudited. Freshness is the QA sweep's own rule, including the uses-graph hash for graph-scoped criteria. Runs no checker and writes no verdict."
        }
      ],
      "skos:notation": "folio-block-qa-summary",
      "dcterms:source": "folio-assistant-core/tools/folio-block-qa-summary/folio-block-qa-summary.ts#folio-block-qa-summary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/folio-block-screenshots",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio block screenshots"
        }
      ],
      "skos:definition": [
        {
          "@value": "Picture each changed figure, diagram, table, equation or simulator block on the published main site and on a staging build, and compare the two pictures pixel by pixel in Chromium's canvas. Writes `visual-diff.json` (`folio-visual-diff/v1`: per block, the share of pixels changed beyond anti-aliasing, and the before, after and diff pictures) and `visual/*.png`, which the review page's visual renderer shows. A side that cannot be pictured (page or anchor missing) is recorded as missing, never drawn blank. Adds no dependency: Playwright is already the platform's browser driver."
        }
      ],
      "skos:notation": "folio-block-screenshots",
      "dcterms:source": "folio-assistant-core/tools/folio-block-screenshots/folio-block-screenshots.ts#folio-block-screenshots",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/folio-changeset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio ChangeSet"
        }
      ],
      "skos:definition": [
        {
          "@value": "What changed in a folio between two git refs, block by block: each block added, removed, or changed — and for a changed block, every aspect that applies (renamed, prose, manifest, moved). Keyed on the block label, which the `id-unique` / `id-stable` QA criteria guard, not on file paths."
        }
      ],
      "skos:notation": "folio-changeset",
      "dcterms:source": "folio-assistant-core/tools/folio-changeset/folio-changeset.ts#folio-changeset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/folio-review-comment-move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Move a review comment's status"
        }
      ],
      "skos:definition": [
        {
          "@value": "A review-process task moves one `review-comment/1.0.0` todo's status (address, send back, resolve, adjudicate, withdraw) through `transition()`, which refuses any move the named BPMN task may not make. The comment is written to the folio's todos graph (its declared `todo-feedback` directory) and, with `--commit`, committed to the edit-set's FEATURE branch. Refused on the base branch and on a detached HEAD."
        }
      ],
      "skos:notation": "folio-review-comment-move",
      "dcterms:source": "folio-assistant-core/tools/folio-review-comment-move/folio-review-comment-move.ts#folio-review-comment-move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/folio-review-comments",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio review comments"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ingest a pull request's tagged conversation comments (`block: <label>` on the first line) into `review-comment/1.0.0` todos, and write them as `review-comments.json`. Idempotent over its previous output, whose statuses it keeps. Re-anchors every comment against the head's blocks, following `renamedFrom`, and orphans a comment whose block is gone rather than dropping it."
        }
      ],
      "skos:notation": "folio-review-comments",
      "dcterms:source": "folio-assistant-core/tools/folio-review-comments/folio-review-comments.ts#folio-review-comments",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/folio-review-coverage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio review coverage"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compute the two facts `content-change-review.bpmn`'s coverage gate (`GW_Covered`) reads: `uncoveredBlocks`, the changed blocks with no reviewer verdict on their CURRENT hash, and `openDefects`. Reads a preview's `changeset.json`, `blocks.json` and `review-comments.json`. With `--commit`, writes the ingested `folio-review-verdict/v1` verdicts into the todos graph's declared `review-verdicts` directory and commits them to the edit-set's FEATURE branch; refused on the base branch and a detached HEAD. Prints the facts as JSON on stdout."
        }
      ],
      "skos:notation": "folio-review-coverage",
      "dcterms:source": "folio-assistant-core/tools/folio-review-coverage/folio-review-coverage.ts#folio-review-coverage",
      "skos:note": "candidate"
    },
