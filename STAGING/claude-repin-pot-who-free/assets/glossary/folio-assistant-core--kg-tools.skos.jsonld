        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "L1 extraction coverage"
        }
      ],
      "skos:definition": [
        {
          "@value": "Of the normative sentences in a publication (the closed marker list of smart-kg's `docs/COVERAGE.md` §1), count how many an L1 extraction CAPTURED, how many are EXCLUDED for a fixed-list reason a person signed off, and how many are UNACCOUNTED — per page and in total. Writes the contract's §4 report and exits non-zero below 100% accounted-for. Issue #2405 FR-009."
        }
      ],
      "skos:notation": "l1-coverage",
      "dcterms:source": "folio-assistant-core/tools/l1-coverage/l1-coverage.ts#l1-coverage",
      "skos:note": "candidate"
