      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/tabular-csv",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "CSV tabular metadata"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read a delimited text file into a `folio-tabular-csvw/v1` record: one table, its columns and their CSVW datatypes, each measured or explicitly undetermined. Routing is by content, never by extension: the first rows must agree on one field count of two or more, under exactly one of `,` `;` TAB `|`. A CSV's `fac:anchor` sheet and cell are a determined null. Governed by the `tabular-metadata` skill (bean `eief`)."
        }
      ],
      "skos:notation": "tabular-csv",
      "dcterms:source": "folio-assistant-core/tools/tabular-csv/tabular-csv.ts#tabular-csv",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools/tabular-xlsx",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Spreadsheet tabular metadata"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read a workbook into a `folio-tabular-csvw/v1` record, one CSVW table per rectangular block of cells. Blocks are split on empty rows, then on empty columns, so several tables on one sheet are found, each anchored at its real top-left cell (`fac:anchor`: sheet, A1 cell, row, column). Dates are read through the number formats in `styles.xml`, not misread as integer serials. A malformed part is refused rather than half-read. No new dependency: ZIP via `node:zlib`, SpreadsheetML via `fast-xml-parser`. Governed by the `tabular-metadata` skill (bean `eief`)."
        }
      ],
      "skos:notation": "tabular-xlsx",
      "dcterms:source": "folio-assistant-core/tools/tabular-xlsx/tabular-xlsx.ts#tabular-xlsx",
      "skos:note": "candidate"
    }
