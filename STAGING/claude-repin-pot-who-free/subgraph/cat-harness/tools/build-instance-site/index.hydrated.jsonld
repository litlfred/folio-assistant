  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/build-instance-site.jsonld",
      "@type": "cat-harness:Tool",
      "description": "From a checkout whose layers arrive by remote mount: mount the pinned closure, install, run the instance's own gates (`--pre`), compose the harness chrome for THIS instance, run its source steps, build with Jekyll at the base path read from the git remote (`/<repo>`, or `/<repo>/STAGING/<branch>` for a preview), run the post-build steps (mount-instance-docs, pdf-viewer, set-html-lang, publish-id-lookup, rail-standalone-pages), and check that every relative or base-rooted link in every page resolves to a file under the site, reading each page with an HTML parser. Any failing step stops the run; a link that does not resolve means nothing is published. It never decides to publish: only `--publish` does, and then a root publish keeps `STAGING/` and `_render-log/` on the branch, and a preview replaces only its own `STAGING/<branch>/`.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat site:instance"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--root"
            },
            "description": "The instance checkout (holds `index.config.json`). Default: the working directory.",
            "name": "root",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--instance"
            },
            "description": "The declared instance name; must match the checkout's declaration.",
            "name": "instance",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--home"
            },
            "description": "A page that becomes the site's index.md.",
            "name": "home",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--pre"
            },
            "description": "A package script to run in the checkout first, as `bun run <name>` (repeatable): the instance's own gates. Any non-zero exit stops the build.",
            "name": "pre",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/ScriptName"
          },
          {
            "arg": {
              "flag": "--source-step"
            },
            "description": "A package script that writes into the site source, run as `bun run <name> <site source>` (repeatable).",
            "name": "sourceStep",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/ScriptName"
          },
          {
            "arg": {
              "flag": "--site-step"
            },
            "description": "A package script that writes finished pages into the BUILT site, run as `bun run <name> <built site>` after Jekyll (repeatable): Jekyll drops `_`-prefixed directories, so a generator whose pages sit under one runs here.",
            "name": "siteStep",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/ScriptName"
          },
          {
            "arg": {
              "flag": "--staging"
            },
            "description": "Build (and with --publish, publish) a preview of this branch at STAGING/<branch>/.",
            "name": "staging",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          },
          {
            "arg": {
              "flag": "--no-mount"
            },
            "description": "Use the mounts already on disk.",
            "name": "noMount",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--publish"
            },
            "description": "Publish after every check passes; needs --remote.",
            "name": "publish",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--remote"
            },
            "description": "The https git URL the caller can push the pages branch to.",
            "name": "remote",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          }
        ],
        "outputs": [
          {
            "description": "The built site directory, and its base path.",
            "name": "site",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "Pages checked, unresolved links (must be 0), files.",
            "name": "links",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
