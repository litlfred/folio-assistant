  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/github-pr-comment.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Add a comment to one pull request. The comment is read from stdin, never from the command line.",
      "install": {
        "cli": "gh"
      },
      "invoke": {
        "shell": "gh pr comment --body-file -"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "Absent: the change proposal of the current branch.",
            "name": "number",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/ChangeProposalNumber"
          },
          {
            "arg": {
              "stdin": true
            },
            "description": "The comment.",
            "name": "body",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ],
        "outputs": [
          {
            "description": "The comment created, as the forge CLI prints it.",
            "name": "url",
            "render": {
              "as": "url",
              "reason": "a reader follows it to the comment; the scheme is checked before it reaches an href"
            },
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          }
        ]
      },
      "name": "github-pr-comment",
      "requirements": {
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/prepare-merge-auto",
        "https://litlfred.github.io/folio-assistant/cat-harness/skill/coordinate"
      ],
      "title": "Comment on a pull request (GitHub)"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/github-pr-comment",
  "path": "tools/github-pr-comment/"
