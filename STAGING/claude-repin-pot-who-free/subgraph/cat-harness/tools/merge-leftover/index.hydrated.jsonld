      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/merge-leftover.jsonld",
      "@type": "cat-harness:Tool",
      "description": "After a train merged, compare a PR's head with the base path by path and say whether what it still changes is ONLY generated files, generated README regions, or changes the base already carries (its patch applies in reverse to the base): `landed`, `not-landed` with the authored paths still different, or `could-not-determine`, which is never shown as clean. Only reports; closing the PR stays a steward action.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat merge:leftover"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "The PR number or branch. On the command line a PR may be pinned as `N:<sha>`.",
            "name": "member",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          },
          {
            "arg": {
              "flag": "--base"
            },
            "description": "The base the train landed on; default `origin/main`.",
            "name": "base",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          }
        ],
        "outputs": [
          {
            "description": "`merge-leftover/v1` on stdout. Exit 0 landed, 1 not-landed, 2 could not determine.",
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "merge-leftover",
      "requirements": {
        "network": true,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/merge-conflict-patterns",
      "title": "Merge leftover (has a PR's intent landed?)"
    }
  ],
