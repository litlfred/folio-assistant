              {
                "description": "The directory of authored `*.l1.yaml`; each names its library entry in `graph.source.entry`.",
                "name": "dir",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ],
            "outputs": [
              {
                "description": "One summary line per file and one `FINDING` line per failure. Exit 0 clean, 1 findings, 2 nothing to check (not a pass).",
                "name": "report",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
              }
            ]
          },
          "name": "l1-transcription-verbatim",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "http://smart.who.int/base/skill/transcription-verbatim",
          "title": "Authored L1 → verbatim against transcriptions and image narratives"
        }
      ],
