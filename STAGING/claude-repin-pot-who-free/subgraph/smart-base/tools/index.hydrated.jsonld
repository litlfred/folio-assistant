      "@id": "https://litlfred.github.io/folio-assistant/subgraph/smart-base/tools/l1-extraction-pages/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "http://smart.who.int/base/tools/l1-extraction-pages.jsonld",
          "@type": "cat-harness:Tool",
          "description": "For every visualiser an instance declares `renderedBy: l1-extraction-pages`, write the hub at `<locale>/<harness>/<id>/` and, with `subgraphs: \"instance\"`, one page per instance that declares an `l1-extraction` directory. Each shows what was extracted, read from the files by what they declare: the L1 statements (graph nodes carrying a `statement`, and an authored L1 source's `recommendations`), the candidate work list's counts, coverage and decisions, each graph document's nodes by type and edges by predicate (the L2 scenario candidates among them), the curation, mapping, vocabulary, exclusions and run context counted, and every file linked to its published copy (cat-harness's `library:viz`) when the site holds it and to its source at the pinned commit. A declared directory not on disk is reported UNKNOWN, never as zero.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run smart-base/scripts/gen-l1-extraction-pages.ts"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--site"
                },
                "description": "A site being built: the pages go under it (`visualiser-writers.ts` in cat-harness-tools passes it). Absent, they go under the checkout's site directory.",
                "name": "site",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--root"
                },
                "description": "The checkout whose declarations are read. Default: the checkout holding the working directory.",
                "name": "root",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "Write nothing; exit 1 when a page is stale, missing or orphaned.",
                "name": "check",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ],
            "outputs": [
              {
                "description": "Pages written: the hub and one per instance.",
                "name": "pages",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
              }
            ]
          },
          "name": "l1-extraction-pages",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/graph-rendering",
