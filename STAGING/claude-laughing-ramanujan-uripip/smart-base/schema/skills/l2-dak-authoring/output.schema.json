{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L2 DAK Authoring Output",
  "description": "Output schema for L2 DAK authoring.",
  "type": "object",
  "required": [
    "artifacts",
    "status"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "type"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "bpmn",
              "dmn",
              "spreadsheet",
              "markdown",
              "fsh"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready-for-review",
        "approved"
      ]
    },
    "validationIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "message": {
            "type": "string"
          },
          "location": {
            "type": "string"
          }
        }
      }
    }
  },
  "$id": "http://smart.who.int/base/schema/skills/l2-dak-authoring/output.schema.json",
  "staging": {
    "branch": "claude/laughing-ramanujan-uripip",
    "sha": "068375632f8a833eb3ca1b13da0ce27b1b5b70dc",
    "pr": "2261/merge",
    "run": "37470280150"
  }
}
