    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#actor/untainted-checker",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor",
      "localId": "untainted-checker",
      "actorKind": "agent",
      "title": "Untainted checker",
      "description": "The dispatched party that renders an artefact independently — a back-translation, an independent finding — given only what `UntaintedDispatch.checker_sees` allows and nothing that would let it shortcut. It RULES ON NOTHING: its witness carries `result: \"n/a\"` and the intermediate text a reader needs to ask 'on what basis?'. It deliberately does NOT hold `qa-reporting`, and that absence is the point — a checker that emits a verdict is comparing a thing with its own paraphrase of itself, and `check:qa-reviewer-permission` refuses it structurally rather than by convention.",
      "hasCapability": [],
      "mayTakeRole": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#role/feedback-provider",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#role/qc-reviewer",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#role/untainted-checker"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#actor/untainted-checker"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#actor/collaborator",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor",
      "localId": "collaborator",
      "actorKind": "person",
      "title": "Collaborator (gateway session)",
      "description": "A person signed in through the auth-gateway's GitHub OAuth and listed in deploy/github-collaborators.txt. The gateway's `collaborator` tier as an actor (issue #1207): what it may do over HTTP is cat-harness/policies/http-gateway.jsonld, not a rung compared in code. Takes on no BPMN role; a person who works in a lane does so as the actor that lane's role names.",
      "hasCapability": [],
      "mayTakeRole": [],
      "permissionName": [
        "content-authoring",
        "review-comments",
        "adjudication",
        "perform-task"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#actor/collaborator"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#actor/owner",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor",
      "localId": "owner",
      "actorKind": "person",
      "title": "Owner (gateway session)",
      "description": "The repository owner signed in through the auth-gateway's GitHub OAuth. The gateway's `owner` tier as an actor (issue #1207). Over HTTP it holds exactly what `collaborator` holds, because no route distinguishes them; `commit to main` is GitHub's branch protection, not a route. Its grants are cat-harness/policies/http-gateway.jsonld. Workflow history names this actor, never the login (owner, 2026-09-24): the repository owner's steps are recorded as `owner`, and the login-to-`owner` mapping is the data store's alone. Without a login the same person is a reader/browser (`cat-harness:anyone`: visualize and render only).",
      "hasCapability": [],
      "mayTakeRole": [],
      "permissionName": [
        "content-authoring",
        "review-comments",
        "adjudication",
        "perform-task"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#actor/owner"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#actor/admin",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor",
      "localId": "admin",
      "actorKind": "person",
      "title": "Administrator",
      "description": "Full administrative access. `roles` is what it may act AS and `capabilities` what its machine has. What it may DO is no longer written here: it is an ODRL rule in cat-harness/policies/folio-defaults.jsonld (issue #1180).",
      "hasCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/git-push"
