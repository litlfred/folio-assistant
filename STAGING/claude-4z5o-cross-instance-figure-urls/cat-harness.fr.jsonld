      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/java-runtime",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "java-runtime",
      "name": "Java Runtime",
      "description": "Java Runtime Environment for running Java-based tools (IG Publisher, validators).",
      "detection": {
        "method": "command",
