    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#actor/ci-health-watcher",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor",
      "localId": "ci-health-watcher",
      "actorKind": "system",
      "title": "CI health watcher",
      "description": "Reads whether a workflow is actually working on the default branch, and reports it. A mechanical participant in the CI process: it runs a fixed program and exercises no judgement, so anything needing a decision belongs in another lane. Its three reporting rules are the judgement-free ones — \"could not check\" is never rendered as green, a red that has not re-run in a week is flagged as possibly stale rather than as an active fire, and a red whose workflow file changed after the failing run is reported superseded. Each is a statement about evidence, not a verdict on what to do about it.",
      "hasCapability": [],
      "mayTakeRole": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#role/build-pipeline",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#role/validation-pipeline"
      ],
      "permissionName": [
        "qa-reporting"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#actor/ci-health-watcher"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#actor/untainted-adjudicator",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor",
      "localId": "untainted-adjudicator",
      "actorKind": "agent",
      "title": "Untainted adjudicator",
      "description": "The dispatched party that rules — given the original intent and the checker's output, and never the artefact itself. It names each drift against the criterion's declared `drift` statement and returns pass / warn / fail. It holds `qa-reporting` and its witness leads the criterion, because the first entry per criterion is the operative one. It does NOT hold `content-authoring`: the party that produced the artefact does not write the verdict on it, which is the whole discipline in one line.",
      "hasCapability": [],
      "mayTakeRole": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#role/qc-reviewer",
