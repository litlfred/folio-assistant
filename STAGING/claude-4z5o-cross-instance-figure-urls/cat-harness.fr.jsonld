        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/untainted-verification"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#role/adjudicator"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#role/feedback-provider",
