      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/sibling-sessions",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "sibling-sessions",
      "title": "Sibling sessions in a window",
      "description": "List the Claude Code sessions that have committed to this repository in a time window, from the `Claude-Session:` trailer on commits across ALL branches — with each one's commit count, first and last commit, latest subject, and the branches containing its tip. The session API cannot see a sibling session, so the trailer is the only durable session identity here and a session's state is INFERRED from its branch; whether a session is still running is not knowable from a checkout and is deliberately not reported.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run sessions",
        "inProcess": {
          "module": "scripts/sibling-sessions.ts"
        }
      },
      "io": {
        "inputs": [
          {
            "name": "since",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/TimeWindow",
            "description": "The window: `4h`, `2d`, `1w`, or an ISO date. Defaults to one day.",
            "required": false,
            "arg": {
              "flag": "--since"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Emit the sweep as JSON rather than the report.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Markdown",
            "description": "One entry per session, most recently active first, plus the number of commits examined and how many carried no trailer. A window with NO commits exits non-zero rather than reporting 'no siblings' — a sweep over nothing has not found anything."
          }
        ]
      },
      "requirements": {
        "network": false
