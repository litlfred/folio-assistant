    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/sub-kg-verify-clone",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "sub-kg-verify-clone",
      "title": "Verify a separated repository from a fresh clone",
      "description": "Clone a separated sub-KG's repository (with submodules, and any sibling checkouts it needs) into an empty scratch directory, install, and run its gates: its `gates` script, else its `test` script (a person may pass `--gate` on the command line instead; it is not part of this contract because it is a shell command). Reports `green`, `red` or `unknown`; an empty tree, a failed clone or a repository with no gate is `unknown`, never green. Catches what a rehearsal inside this checkout cannot, because a rehearsal shares this checkout's `node_modules` and environment (#2082). Writes only inside the scratch directory.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run sub-kg:verify-clone"
      },
      "io": {
        "inputs": [
          {
            "name": "repo",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoFullName",
            "description": "The separated repository, `owner/name`. (The script also takes a git URL or a local path, for tests.)",
            "required": true,
            "arg": {
              "flag": "--repo"
            }
          },
          {
            "name": "ref",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Branch",
            "description": "The branch or tag to clone, e.g. the seeding PR's branch.",
            "required": false,
            "arg": {
              "flag": "--ref"
            }
          },
          {
            "name": "sibling",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoFullName",
            "description": "A repository to clone beside it, for a platform linked as a sibling checkout. Repeatable.",
            "required": false,
            "arg": {
              "flag": "--sibling"
            }
          },
          {
            "name": "work",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "Scratch directory, kept afterwards. Absent: a temporary directory, removed afterwards.",
            "required": false,
            "arg": {
              "flag": "--work"
            }
          },
          {
            "name": "text",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "A report for a person instead of JSON.",
            "required": false,
            "arg": {
              "flag": "--text"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "`sub-kg-verify-clone/v1`: the commit cloned, each step with its status and output tail, and the verdict. Exit 0 green, 1 red, 2 unknown."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/sub-kg-lifecycle"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/sub-kg-verify-clone"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/witness-conformance",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "witness-conformance",
      "title": "Witness conformance report",
      "description": "Check every `*.witness.json` in the folio's declared `computation-witness` directories against the two schemas in `schemas/computation-witness.ts`: the envelope every witness should meet (a failure is a malformed file) and the producer contract (a failure is a finding against the producer, grouped by the fields at fault). Also lists files that are not strict JSON, which Python's reader accepts and every other consumer rejects. Report-only: it never edits a witness, which is generator output.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run witness:conformance"
      },
      "io": {
        "inputs": [
          {
            "name": "dir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "Check this directory instead of the declared ones, e.g. before a folio declares the kind.",
            "required": false,
            "arg": {
              "flag": "--dir"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Machine-readable output, every finding group listed.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          },
          {
            "name": "strict",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Exit 1 when any witness is malformed or not strict JSON. Contract findings never fail the run.",
            "required": false,
            "arg": {
              "flag": "--strict"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "Counts of witnesses, malformed files, non-strict-JSON files and contract conformance, then the contract findings by field. Exit 2 when no directory declares the kind and no `--dir` was given: a clean report over nothing is not a pass."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/directory-conventions"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/witness-conformance"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/witness-parity",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "witness-parity",
      "title": "Witness reproduction check",
      "description": "Re-run a computation witness's producer and say whether it reproduces the committed witness. Reads the command from `invocation.reproduce` (else `python3 <scriptFile>`) and the recorded package versions from `environment`; on a version mismatch it stops at `unknown`, since a different environment is not a reproduction test. Otherwise it runs the COMMITTED producer in a scratch git worktree, so the folio's own checkout is never written, and compares the result with the committed witness with run-specific fields (commit, timing, environment) masked at every depth. `pass`, `fail` (with the differing JSON paths), or `unknown` (mismatch, non-zero exit, timeout, no witness written).",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run witness:parity"
      },
      "io": {
        "inputs": [
          {
            "name": "witness",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "One or more `*.witness.json` paths, committed at HEAD.",
            "required": true
          },
          {
            "name": "timeout",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Count",
            "description": "Seconds before a run counts as `unknown`. Default 300.",
            "required": false,
            "arg": {
              "flag": "--timeout"
            }
          },
          {
            "name": "force",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Run despite an environment mismatch; the verdict is then marked advisory.",
            "required": false,
            "arg": {
              "flag": "--force"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Machine-readable output.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "verdicts",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "One line per witness: pass, fail or unknown, with the reason, any environment mismatch and the differing paths. Exit 1 when any witness fails; `unknown` alone exits 0."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "git",
          "bash"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/directory-conventions"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/witness-parity"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/subgraph-readmes",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "subgraph-readmes",
      "title": "Directory READMEs from the Knowledge Graph",
      "description": "Write a README for every directory an instance declares, from the declaration and the files themselves: the declared title and description, the Graph Typologies, and one row per file described from the file, with 'used by' only where a diagram records it. Renders the Liquid templates in `tools/templates/readme/`, part of the tools graph, which may include one another with Jekyll-style include tags. Writes only between `<!-- kg:subgraph:begin -->` and `:end`; a README without the markers is left alone and reported. Records every missing title, missing or over-long description, absent directory and unmarked README in `test/results/subgraph-readmes.qa-results.json`.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run readme:subgraphs"
      },
      "io": {
        "inputs": [
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Fail if any directory README or the QA record is stale; write nothing.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "readmes",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "`<directory>/README.md` for each declared directory, and the QA record."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/docs-generation",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/upload-routes"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/subgraph-readmes"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/folio-block-screenshots",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "folio-block-screenshots",
      "title": "Folio block screenshots",
      "description": "Picture each changed figure, diagram, table, equation or simulator block on the published main site and on a staging build, and compare the two pictures pixel by pixel in Chromium's canvas. Writes `visual-diff.json` (`folio-visual-diff/v1`: per block, the share of pixels changed beyond anti-aliasing, and the before, after and diff pictures) and `visual/*.png`, which the review page's visual renderer shows. A side that cannot be pictured (page or anchor missing) is recorded as missing, never drawn blank. Adds no dependency: Playwright is already the platform's browser driver.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/scripts/block-screenshots.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "changeset",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The preview's `changeset.json`: which blocks changed, and their kind on each side.",
            "required": true,
            "arg": {
              "flag": "--changeset"
            }
          },
          {
            "name": "base",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The published main site, as a directory (the publish branch's root).",
            "required": false,
            "arg": {
              "flag": "--base"
            }
          },
          {
            "name": "head",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The staging build's site directory.",
            "required": false,
            "arg": {
              "flag": "--head"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where to write `visual-diff.json` and `visual/`: the site root, so the review page finds them.",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          },
          {
            "name": "count",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Print how many changed blocks would be pictured, and stop, so a caller installs a browser only when there is work.",
            "required": false,
            "arg": {
              "flag": "--count"
            }
          }
        ],
        "outputs": [
          {
            "name": "visual-diff",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "`<out>/visual-diff.json` and `<out>/visual/*.png`. A per-block summary goes to stderr."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "chromium"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/visual-diff"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/folio-block-screenshots"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/discuss",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "discuss",
      "title": "discussion",
      "description": "Put a question to a person or a sibling agent and receive an answer, to determine which harness this repository should become and which repositories are read from and written to. The two facts no file holds.",
      "install": {
        "none": true
      },
      "invoke": {
        "manual": true
      },
      "io": {
        "inputs": [
          {
            "name": "question",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "The question as put, with its candidates named. One question where one will do.",
            "required": true
          },
          {
            "name": "askedOf",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "`person` or `agent` — symmetric participants, recorded because the answers are evidence of different weight.",
            "required": true
          }
        ],
        "outputs": [
          {
            "name": "answer",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "The reply as received. Absent is a real result: it routes to `outcome: unsettled`, never to a guess."
          }
        ]
      },
      "requirements": {},
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/bootstrap/bootstrap.jsonld#skill/discussion"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/discuss"
    },
