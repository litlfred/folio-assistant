      "localId": "attestation-service",
      "actorKind": "system",
      "title": "Attestation service",
      "description": "The signing endpoint. Declares `reach: \"internet\"` because an API signer that cannot reach out is not a signer — this is the one actor whose reach is part of what it IS, rather than a fact about where it happens to run.",
      "reach": "internet",
