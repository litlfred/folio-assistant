      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#capability/java-runtime"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/github-connector",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "github-connector",
      "name": "GitHub connector (host-provided)",
      "description": "Ability to reach the forge through a connector the HOST supplies — an MCP server the agent did not configure and cannot inspect. DISTINCT FROM github-api: the agent holds no credential of its own, so what it may do is whatever the connector was granted, and that is knowable only by trying. An mcp-probe against the server is therefore the honest detection: it answers 'is the connector reachable', which is the only question this capability can settle. It does NOT answer 'may I write' — that is a permission on the actor, and a session can hold this capability and still be refused. Declared 2026-09-20 alongside github-api, on the owner's answer that the write path is several tools chosen by capability and permission.",
      "detection": {
        "method": "mcp-probe",
        "endpoint": "github"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#capability/github-connector"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/fhir-validator",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "fhir-validator",
      "name": "HL7 FHIR Validator",
      "description": "HL7's standalone FHIR resource validator. Distinct from ig-publisher, which builds a whole IG: this validates individual resources and profiles against a package, and is what an L3 authoring loop runs between builds.",
      "detection": {
