            "arg": {
              "flag": "--paper"
            }
          },
          {
            "name": "file",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "A single `.md` block, for the narrow case.",
            "required": false,
            "arg": {
              "flag": "--file"
            }
          },
          {
            "name": "compile",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Also compile each snippet with pdflatex — needs a TeX distribution, which the base `requires` does NOT claim.",
            "required": false,
