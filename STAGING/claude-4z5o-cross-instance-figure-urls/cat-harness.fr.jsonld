            "description": "Where logs and the status sidecar go.",
            "required": false,
            "arg": {
              "flag": "--log-dir"
            }
          }
        ],
        "outputs": [
          {
            "name": "status",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "`lean-build-status.json` — committable, so a green build is distinguishable from one nobody ran."
          }
        ]
      },
      "requirements": {
        "runtime": [
