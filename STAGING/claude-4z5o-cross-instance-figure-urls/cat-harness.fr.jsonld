      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#directory/skills",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subgraph",
