    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/pdf-cover",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "pdf-cover",
      "title": "PDF page raster",
      "description": "Render one page of a PDF to a PNG — the thumbnail a repository listing shows — and print the provenance a catalogue needs to record it as DERIVED: source, digest, page, geometry, renderer.",
      "install": {
        "cli": "pip install pymupdf"
      },
      "invoke": {
        "shell": "python3 cat-harness/scripts/pdf-cover.py"
      },
      "io": {
        "inputs": [
          {
            "name": "pdf",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The PDF to render from. Its bytes must be here; nothing is fetched.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The PNG to write.",
            "required": true,
            "arg": {
              "flag": "--out"
            }
          },
          {
            "name": "page",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Count",
            "description": "1-based page to render, default 1. Asking for a page past the end is refused, not clamped.",
            "required": false,
            "arg": {
              "flag": "--page"
            }
          },
          {
            "name": "width",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Count",
            "description": "Output width in pixels, default 300. `Count` admits zero and a zero width does not; the script refuses it rather than writing a 0x0 PNG, which is the tighter bound stated at the port as `CountSchema` asks. Height follows the page's own aspect and is never forced.",
            "required": false,
            "arg": {
              "flag": "--width"
            }
          },
          {
            "name": "checkOnly",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Write nothing; exit non-zero if the target differs from what would be written.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "facts",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "With `--json`: source path and sha256, page, page count, point geometry, pixel geometry, output bytes and sha256, media type, renderer version. Everything a provenance record needs and nothing it has to guess."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3",
          "pymupdf"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/asset-extraction"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/pdf-cover"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/pdf-viewer-install",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "pdf-viewer-install",
      "title": "Install the inline PDF viewer into a built site",
      "description": "Download the pinned pdf.js release (legacy build), verify its SHA-256, copy the parts a site needs into `<site>/assets/vendor/pdfjs/`, and add the shim that opens `?src=` only for the allowlisted URL prefixes or the site's own origin. Nothing is committed: the viewer exists only in the built site.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/scripts/pdf-viewer.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "site",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The built site directory, `_site` in both site workflows.",
            "required": true,
            "arg": {
              "flag": "--site"
            }
          },
          {
            "name": "allow",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Url",
            "description": "An https URL prefix the viewer may open, ending in `/`. Repeat the flag for more than one. `same-origin-only` is the explicit way to allow none — an omitted flag is a usage error, because a viewer that refuses every CDN document would otherwise ship green.",
            "required": true,
            "arg": {
              "flag": "--allow"
            }
          },
          {
            "name": "zip",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "A local copy of the release zip, for offline runs and tests. Its hash is checked exactly as a download's would be.",
            "required": false,
            "arg": {
              "flag": "--zip"
            }
          }
        ],
        "outputs": [
          {
            "name": "summary",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "One line on stdout: version, destination, file count, and the prefixes it will open. Exit 2 on a usage error; a hash mismatch or a release missing a kept path throws, refusing the install."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "unzip"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/pdf-inline-viewer"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/pdf-viewer-install"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/pdf-viewer-embed",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "pdf-viewer-embed",
      "title": "Embed a PDF inline in a page",
      "description": "Print the HTML fragment that shows a PDF in the installed viewer: a lazily loaded frame whose address is derived from the page's own location (so one page works at the site root, under a project base and under a staging preview), plus plain open and download links that work without it.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/scripts/pdf-viewer.ts --embed"
      },
      "io": {
        "inputs": [
          {
            "name": "spec",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "One JSON object: `src` (the PDF's URL, which must fall under a prefix `pdf-viewer-install` was given, or the viewer refuses it on screen), `title` (what the document is; the frame's accessible name), `route` (a regular expression over the page's pathname whose group 1 is the site root — the `folio-mount.ts` convention) and optionally `page` (open at this 1-based page). On stdin because a title and a regular expression are free text.",
            "required": true,
            "arg": {
              "stdin": true
            }
          }
        ],
        "outputs": [
          {
            "name": "fragment",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "The HTML fragment on stdout. TypeScript callers import `embed` from `cat-harness/scripts/pdf-viewer.ts` instead, as `who-iris/scripts/gen-iris-pages.ts` does."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/pdf-inline-viewer"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/pdf-viewer-embed"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/upload-url",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "upload-url",
      "title": "Where to drop a file — the queue's upload URL",
      "description": "Compose the forge URL a person can drop a file at, from the instance's own declaration: the `uploads` graph's directory, resolved against the ROOT its scope names, expressed relative to the repository, and appended to the origin remote as GitHub's `/upload/<branch>/<path>`. Every failure is NAMED and no URL is guessed — no declaration, no declared `uploads` graph, a declared queue absent from disk, no `origin` remote, and a non-github.com remote each return a reason and a remedy instead. It exists because the obvious composition mints a live 404: the declared path `uploads/` is relative to the INSTANCE and a forge URL needs it relative to the REPOSITORY, so pasting the declared path drops the `cat-harness/` segment. Owner, 2026-09-20, on the hand-written form: \"were it to exist, but it doesmt on main!!!!!\"",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/scripts/upload-url.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "branch",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Branch",
            "description": "The branch the upload form targets. Defaults to `main`, which is what a forge's web upload form targets when nobody says otherwise — pass the working branch to send somebody at a pull request's head instead, which is the difference between a commit CI judges and one it never sees.",
            "required": false,
            "arg": {
              "positional": 0
            }
          }
        ],
        "outputs": [
          {
            "name": "url",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "The upload URL on stdout, exit 0 — or, on stderr and exit 1, the reason it could not be composed and the remedy for that reason. Never a guessed URL: a URL is believed, and somebody sent to a wrong one cannot tell it from an empty directory."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/upload-routes",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/content-acquisition"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/upload-url"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/ingest-stdlib",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "ingest-stdlib",
      "title": "Ingest, standard library only",
      "description": "Ingest an upload into `library/` using only the Python standard library — archive listings, CSV and spreadsheet records, technical file metadata, and the content sniff that routes a file to its rung.",
      "install": {
        "none": true
      },
      "invoke": {
