    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/folio-block-qa-summary",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "folio-block-qa-summary",
      "title": "Folio block QA summary",
      "description": "Summarise a folio's committed per-block QA verdicts into one `block-qa.json` a staging preview publishes: each block is failing (a FRESH verdict failed, with the worst severity), stale (a verdict predates the block's current files), passing, or unaudited. Freshness is the QA sweep's own rule, including the uses-graph hash for graph-scoped criteria. Runs no checker and writes no verdict.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/scripts/publish-block-qa.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "folio",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio's `folio` graph directory.",
            "required": true,
            "arg": {
              "flag": "--folio"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where to write `block-qa.json`.",
            "required": true,
            "arg": {
              "flag": "--out"
            }
          },
          {
            "name": "repo",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The folio's instance root, where verdicts are anchored. Default: found from `folio` exactly as the QA sweep finds it.",
            "required": false,
            "arg": {
              "flag": "--repo"
            }
          }
        ],
        "outputs": [
          {
            "name": "block-qa",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "A `folio-block-qa-summary/v1` file keyed by block label. Its counts go to stderr."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/review-heatmap"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/folio-block-qa-summary"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/gh-pages",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "gh-pages",
      "title": "GitHub Pages (gh-pages)",
      "description": "Push a rendered Knowledge Graph to GitHub Pages at a publication root URL — a staging preview (`STAGING/<slug>/`) or the release root, the same steps either way — and report the push: a status (pushed, not pushed, could not determine) and one message carrying the commit merged onto `gh-pages` and the QA result. Its steps are bootstrap-tools' `render-kg-to-github-pages` process, which first provisions the target: an orphan `gh-pages` branch, then Pages switched on to serve it.",
      "install": {
        "none": true
      },
      "invoke": {
        "manual": true
      },
      "io": {
        "inputs": [
          {
            "name": "root",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The instance root whose Knowledge Graph is rendered, or a tree a caller already rendered and verified.",
            "required": true
          },
          {
            "name": "url",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Url",
            "description": "The publication root URL. Default: the declaration's `iriBase`, else `https://<owner>.github.io/<repo>/`.",
            "required": false
          },
          {
            "name": "subgraph",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Slug",
            "description": "A declared directory id to render; repeatable. Absent: the whole graph.",
            "required": false
          },
          {
            "name": "sha",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/CommitSha",
            "description": "The commit that is live: the commit on `gh-pages`.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "status",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "`pushed`, `not-pushed` or `could-not-determine` — never `pushed` over a check that could not look."
          },
          {
            "name": "message",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "One line: the live commit, the root URL, and the QA of both what was staged and what is served."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/render-kg-to-cdn"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/gh-pages"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/rail-standalone-pages",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "rail-standalone-pages",
      "title": "Give every page Jekyll did not lay out the folio-assistant navbar",
      "description": "A LAST pass over the finished site: inject the shared navbar (`lib/navbar.ts`, the same component the site sidebar draws) into every page that carries none — standalone viewers, generated instance pages, and each IG site built by `stage-ig-sites`. A page under an `igSite` instance's route is railed as THAT instance's page (its name, mark and graphs); a page may declare its own section (`data-fa-visualiser-nav`) and its label (`fa-visualiser-label`). Mount routes are left to the mount pass, and a page that declines (`folio-navbar: none`) is left bare.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/scripts/rail-standalone-pages.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "site",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The finished site directory.",
            "required": true
          },
          {
            "name": "built",
