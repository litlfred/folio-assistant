      "io": {
        "inputs": [],
        "outputs": [
          {
            "name": "triage",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "Four tiers with A, B and C listed by name and their evidence, D as a count. Always exit 0: this REPORTS a judgement queue and never gates — an uncovered skill is not a defect, and failing on one would make stubbing a gap turn CI red."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/code-node-review"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/tool-coverage"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/mcp-capture",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "mcp-capture",
      "title": "What this instance's MCP server serves",
      "description": "Read the real tool surface from the registrars by mounting each against a capture object — the same objects the server asks, so the Zod shapes and their optionality are the served ones rather than a reading of the source.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run mcp:capture"
      },
      "io": {
        "inputs": [
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Emit `{tools, problems}` as JSON for a consumer, instead of the table for a reader.",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "surface",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "One row per served tool with its module and its required/optional keys. Three exit codes: 0 the surface was captured whole, 2 one or more modules COULD NOT BE READ so the capture is incomplete, and no equivalence verdict may be drawn from it. There is no exit 1 — this tool reports what is served and never judges it."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/mcp-contract"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/mcp-capture"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/render-log",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "render-log",
      "title": "Record what the publish branch served",
      "description": "Append one entry to the render log on the publish branch: what was published or taken down, when, from which commit, and — for a removal or a retention — WHY. The log is the only place a preview that vanished leaves a trace.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/scripts/render-log.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "dir",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "A checkout of the publish branch, or a publish directory about to become one. This tool NEVER fetches, commits or pushes: the workflows that call it already hold the checkout with their own retry and concurrency handling, and a second pusher racing those is a new way to lose a deploy.",
            "required": true,
            "arg": {
              "flag": "--dir"
            }
          },
          {
            "name": "event",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RenderEvent",
            "description": "`rendered`, `removed`, `restored` or `retained`. `retained` is the one that makes the log worth reading — a removal CONSIDERED and refused, which otherwise leaves no trace at all.",
            "required": true,
            "arg": {
              "flag": "--event"
            }
          },
          {
            "name": "kind",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Slug",
            "description": "What was rendered — `staging-preview`, `site`, `export`. Open on purpose: the publish branch carries more than previews, and a closed enum would put a schema change between somebody and logging what they published.",
            "required": true,
            "arg": {
              "flag": "--kind"
            }
          },
          {
            "name": "path",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The path on the publish branch. Checked as a VALUE, never trusted by provenance: the slug sanitiser can emit `..`, and that is only safe for a slug taken from a git ref — a dispatch input is not one (bean `fuzm`).",
            "required": true,
            "arg": {
              "flag": "--path"
            }
          },
          {
            "name": "slug",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Slug",
            "description": "The staging slug, where the subject has one.",
            "required": false,
            "arg": {
              "flag": "--slug"
            }
          },
          {
            "name": "branch",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Branch",
            "description": "The branch the render came from.",
            "required": false,
            "arg": {
              "flag": "--branch"
            }
          },
          {
            "name": "commit",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/CommitSha",
            "description": "The commit the artefact was built from.",
            "required": false,
            "arg": {
              "flag": "--commit"
            }
          },
          {
            "name": "run",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Url",
            "description": "The workflow run that wrote this, so a reader can open the log.",
            "required": false,
            "arg": {
              "flag": "--run"
            }
          },
          {
            "name": "prose",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Markdown",
            "description": "One JSON object on STDIN: `{summary, reason?, detail?, format?}`. `summary` is required and one line. `reason` is required by the SCRIPT for `removed` and `retained` — an entry saying an artefact went and not why is the ambiguity the log exists to prevent. `format` declares how the prose reads (absent means plain text, never sniffed). Build it with `jq -n --arg`, never by concatenation.",
            "required": true,
            "arg": {
              "stdin": true
            }
          }
        ],
        "outputs": [
          {
            "name": "entry",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The day's JSONL the entry was APPENDED to. Append is the only verb: there is no `--remove`, no `--edit` and no `--id`, so a takedown is a `removed` ENTRY rather than the erasure of the `rendered` one before it — the never-delete rule made structural instead of a guard three cleanup paths have to remember."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun",
          "jq"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/render-logging"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/render-log"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/ci-health",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "ci-health",
      "title": "Is CI passing on the default branch?",
      "description": "Report each workflow's state on the default branch, which a checkout cannot see: a red workflow looks exactly like a green one from in here. One API call over the recent run history, not one request per workflow — fanning out would exhaust the unauthenticated 60/hr limit and make it unusable at session start.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run check:ci-health"
      },
      "io": {
        "inputs": [
          {
            "name": "markdown",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Emit the block the session-start sweep prints. ALWAYS exits 0, deliberately: the sweep runs it as `if ! …; then` and would otherwise print the report AND declare it unchecked every time CI is red.",
            "required": false,
            "arg": {
              "flag": "--markdown"
            }
          },
          {
            "name": "warn",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Report only, never fail. For a caller that wants the state without a verdict.",
            "required": false,
            "arg": {
              "flag": "--warn"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "Write the markdown report to a file AND keep the exit code — which `--markdown` cannot do, since it always exits 0. The notifier gets its own flag rather than one API call being spent twice.",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Markdown",
            "description": "One row per workflow. Five verdicts, not two: green, red, `running`, `superseded` (a red whose workflow file changed after the failing run, so the verdict is against code that no longer exists), and possibly-stale (a red that has not re-run in a week). Three exit codes carry them to a caller that reads no rows: 0 nothing is red, 1 something is, 2 COULD NOT LOOK — the API was unreachable, or `--out` could not be written. A caller must never read 2 as either verdict. `--markdown` and `--warn` always exit 0 by design, so a caller wanting the verdict uses neither.",
            "render": {
              "as": "markdown",
              "reason": "a table a reader reads; rendered with raw HTML off"
            }
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": true
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/ci-health"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/ci-health"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/slice-sqlite",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "slice-sqlite",
      "title": "Per-slice SQLite builder",
      "description": "Build a named slice of a graph (beans, todos, library, or the whole-repo kg) as one SQLite file a browser mounts without parsing it, beside a manifest carrying its sha256, a row-content digest, its row counts and the search block the one search page reads. Heavy text is indexed by a contentless FTS5 and not stored; each row points at a content-addressed payload. `--check` builds every slice twice, requires one sha256, and requires the row digest read back from the file to equal the one computed from the source.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run slice:sqlite"
      },
      "io": {
        "inputs": [
          {
            "name": "slice",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Slug",
            "description": "A slice to build; repeatable. Absent: every slice in the builder's table.",
            "required": false,
            "arg": {
              "flag": "--slice"
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where the files and `index.json` go; defaults to the gitignored `docs/assets/slices/`. The deploy passes `./_site/assets/slices`.",
            "required": false,
            "arg": {
              "flag": "--out"
            }
          },
          {
            "name": "payloadOut",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "Where the deploy payloads are written (`<hex>` plus its `<hex>.json` sidecar). Never the committed `docs/payload/`.",
            "required": false,
            "arg": {
              "flag": "--payload-out"
            }
          },
          {
            "name": "check",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Build twice and verify instead of writing: one sha256, the row digest against the source, an FTS5 phrase query, the payload audit.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "slices",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "`<slice>.<sha256>.sqlite3` (content-addressed) and its fixed-name `<slice>.sqlite3.json` manifest per slice, and `index.json` listing them."
          },
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "One line per slice: bytes, row counts, payloads, and any source findings; with `--check`, one verdict line per slice. Exit 1 on a red slice or an unreadable source."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/kg-export"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/slice-sqlite"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/kg-validate",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "kg-validate",
      "title": "Validate a node in the graph",
      "description": "Check one file against the schema for its graph typology. ONE tool rather than one per schema: the declaration already says which directory holds which kind, so the kind is the parameter and the lookup does the rest.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run kg:validate"
      },
      "io": {
        "inputs": [
          {
            "name": "path",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "The node to check. Its graph typology is resolved from the declared directory that contains it.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "lenient",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Accept partial coverage knowingly: downgrade could-not-determine from an error to a warning.",
            "required": false,
            "arg": {
              "flag": "--lenient"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "One line per file — valid, invalid with the failing paths, or could-not-determine with the reason. Exit 0 valid, 1 invalid or undetermined, 2 misuse."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/kg-navigation"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/kg-validate"
    },
