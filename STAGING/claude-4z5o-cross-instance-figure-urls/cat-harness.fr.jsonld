    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#asset/agent-instructions",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Asset",
      "name": "agent-instructions",
      "path": "AGENTS.md",
      "assetRole": "agent-instructions",
      "title": "AGENTS.md — cat-harness",
      "description": "The cold-start file for an agent working IN this layer, and it is THIS LAYER'S own as of 2026-09-20 (issue #592). It was declared `scope: \"repository\"`, so it resolved to the repository root's AGENTS.md — one file answering both \"what binds everywhere\" and \"what binds in the harness layer\", which is the conflation `readmeFinding` calls MAJOR for a non-root instance and could not report, because the asset DID resolve. It resolved to the wrong file's job. No `source`: this file is authored here. The root's carries the bootstrap provenance, because the root's is the file bootstrap copies at initialisation.",
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#asset/agent-instructions"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#asset/instance-readme",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Asset",
      "name": "instance-readme",
      "path": "README.md",
      "assetRole": "instance-readme",
      "title": "cat-harness",
      "description": "What this LAYER is, for a reader — as distinct from what the repository is, which is the root's README. Split from it on 2026-09-20 (issue #592); before that this instance had no README of its own and claimed the repository's. It does not list this instance's directories: `harness.json` is that list, and a second copy in prose is free to disagree with it the day a directory moves.",
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#asset/instance-readme"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#asset/bootstrap-initialization",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Asset",
      "name": "bootstrap-initialization",
      "path": "docs/bootstrap/initialization.md",
      "assetRole": "bootstrap-initialization",
      "title": "Initializing into folio-assistant",
      "description": "What bootstrap's step 2 reads once it has been pointed at THIS instance. Published at the fixed convention every cat-harness instance honours, composed by `initializationDoc()` rather than spelled, so bootstrap needs no per-target knowledge and can initialise into a SPECIALISED harness it was never written against. Declared as an asset as well as conventional, so `check:declared-assets` verifies it is there and that its links resolve: a convention nothing checks is a convention that is honoured until it quietly is not. The path is INSTANCE-relative here, not `<stub>/docs/...`: this instance has its own directory (`cat-harness/`), so `siteDir` is plain `docs`, and the stub names published artefacts rather than a directory. Whether bootstrap can still find it from one reference is open — see bean `wggr`.",
      "inSubgraph": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#directory/docs",
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#asset/bootstrap-initialization"
    },
