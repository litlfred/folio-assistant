      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/lsi-index",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "lsi-index",
      "title": "Build the Latent Semantic Indexing index of a prose graph",
      "description": "Build the per-graph LSI index sidecar for every declared prose graph (or the one named): input fingerprint, parameters, dimension summaries, nearest neighbours and near-duplicate findings, never the vectors. Records each run's outcome and input fingerprint, success or failure, as a `folio-tool-run/v1` record.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run lsi index"
      },
      "io": {
        "inputs": [
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Slug",
            "description": "Instance declaring the graph, e.g. `cat-harness`.",
            "required": false,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "graph",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Slug",
            "description": "Graph id within the instance, e.g. `skills`.",
            "required": false,
            "arg": {
              "flag": "--graph"
            }
          }
        ],
        "outputs": [
          {
            "name": "index",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "`test/results/lsi/<instance>/<graph>.lsi.json`, and the run record under `test/results/tool-runs/lsi-index/`."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/lsi-indexing"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/lsi-index"
    },
    {
