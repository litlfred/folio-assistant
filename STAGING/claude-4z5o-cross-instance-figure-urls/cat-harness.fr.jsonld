            "description": "A declared directory id. Repeatable; absent with `--all`.",
            "required": false
          },
          {
            "name": "all",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Every subgraph the checkout declares.",
            "required": false,
            "arg": {
              "flag": "--all"
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Machine-readable output.",
