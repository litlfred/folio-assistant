      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/log-message",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "log-message",
      "title": "Log a message to the discussion",
      "description": "Write a log line where the human actor will read it: the discussion you are already in. Takes the five required fields and the optional body, and renders them as one entry.",
      "install": {
        "none": true
      },
      "invoke": {
        "manual": true
      },
      "io": {
        "inputs": [
          {
            "name": "timestamp",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Timestamp",
            "description": "When it happened, as an ISO-8601 UTC instant.",
            "required": true
          },
          {
            "name": "actor",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "WHO acted. Never the Logger: it receives and records, so it cannot know.",
            "required": true
          },
          {
            "name": "process",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/ProcessId",
            "description": "The process the actor was inside, e.g. initialize-harness.",
            "required": true
          },
          {
            "name": "task",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/NodeId",
            "description": "The step within it, e.g. A_Install.",
            "required": true
          },
          {
            "name": "message",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "What happened, in the one line somebody scanning will read.",
            "required": true
          },
          {
            "name": "body",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Markdown",
            "description": "The detail — a diff, an error, what was not where it should have been.",
            "required": false
          }
        ],
        "outputs": [
          {
            "name": "entry",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Markdown",
            "description": "The entry as posted.",
            "render": {
              "as": "markdown",
              "reason": "a log entry is prose with formatting; rendered with raw HTML off"
            }
          }
        ]
      },
      "requirements": {
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/bootstrap/bootstrap.jsonld#skill/log-message"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/log-message"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/content-graph-build",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "content-graph-build",
      "title": "Content graph",
      "description": "Build the content graph under a path and report its edges, separated into the EDITORIAL relation an author maintains and the FORMAL one derived from Lean. Reading the two as one number is how the editorial signal gets overwritten.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat-harness/content/pipeline/content-graph.ts"
      },
      "io": {
        "inputs": [
          {
            "name": "targetPath",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "description": "Content root to walk; defaults to the folio's `content/`.",
            "required": false,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "json",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "required": false,
            "arg": {
              "flag": "--json"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "Block count, then edge counts reported separately and never summed: EDITORIAL (`uses[]`, `interprets` — author-maintained) and FORMAL (derived from `lean.ref`). The formal line distinguishes `0` from `cache ABSENT`, so an unavailable formal graph cannot be read as a graph with no formal edges."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "bun"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/content-validate"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#tool/content-graph-build"
    },
    {
