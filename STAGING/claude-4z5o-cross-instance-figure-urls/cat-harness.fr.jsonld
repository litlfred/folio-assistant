            }
          },
          {
            "name": "history",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Count",
            "description": "Report the blast radius over the last N commits instead of a static cone.",
            "required": false,
            "arg": {
