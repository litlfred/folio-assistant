            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Flag",
            "description": "Simulate with `git merge-tree`: classify each member's conflicts against the simulated train and change nothing.",
            "required": false,
            "arg": {
