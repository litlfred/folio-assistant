    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#directory/cat-harness-tests",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subgraph",
      "name": "cat-harness-tests",
