      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/git-read",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "git-read",
      "name": "Git Read",
      "description": "Ability to read the Git repository — history, refs and working tree. Required by every skill that reasons about what changed. It was referenced by 17 skills and declared by NO capability until 2026-09-20, when executing the degradation model found it on the first run (bean folio-assistant-ahvw): a reference-shaped value resolving to nothing, so those skills could not be shown to run at all.",
      "detection": {
        "method": "command",
        "command": "git rev-parse --git-dir"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#capability/git-read"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/lean-atlas",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "lean-atlas",
      "name": "Lean Atlas",
      "description": "Extracts the Lean constant-dependency graph, classified into type (statement-level) and value (proof-level) edges — the authoritative source for the formal dependency relation. MIT. Added as a Lake require in the CONTENT repo's lakefile.toml (scope NyxFoundation, https://github.com/NyxFoundation/lean-atlas), not installed as a standalone binary, so `lake update` needs github.com egress. Export with `lake exe atlas graph-data --output graph.json --pretty`, then adapt to JSONL for `content/pipeline/lean-atlas-ingest.ts --ingest`. Requires Lean >= 4.17.0 (v4.28.0 tested); the folio image and CI now pin v4.24.0, matching qou. When unavailable, `lean-atlas-ingest.ts --scan` gives an approximate syntactic fallback and every consumer degrades to n/a rather than a false pass.",
      "install": "scripts/install-lean-atlas.sh [content-repo-root]",
      "detection": {
        "method": "command",
        "command": "lake exe atlas --help"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/lean-toolchain"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#capability/lean-atlas"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/plantuml",
