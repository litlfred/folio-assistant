    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#package/authoring-core",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#SkillPackage",
      "name": "authoring-core",
      "version": "0.1.0",
      "description": "Content authoring and content QA that no single content type owns: editorial and voice review (one-voice, voice overlays, readability, Milnor exposition), review comments and heatmaps, evidence and scientific-accuracy review, content profiles and the content graph, block density, and the integration watchers that audit exposition. Moved out of folio-core into the authoring topic (bean 9umr, owner ruling 2026-09-30); the content-type adapters, content-lifecycle and the math and WHO authoring packages are its siblings in the same topic.",
      "path": "skills/authoring/authoring-core",
      "hasManifest": true,
      "declaresSkill": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/block-density",
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#skill/canonical-watcher",
