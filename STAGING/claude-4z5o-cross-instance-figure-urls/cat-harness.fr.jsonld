      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "html-pdf-engine",
      "name": "TeX-free PDF engine",
      "description": "An HTML-to-PDF engine pandoc can drive without LaTeX — weasyprint, prince, or wkhtmltopdf. Probed as weasyprint, the recommended one; document_render_pdf accepts any of the three and names the missing ones rather than falling back to latexmk.",
      "detection": {
        "method": "command",
        "command": "weasyprint --version"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#capability/html-pdf-engine"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/smart-base",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "smart-base",
      "name": "WHO SMART Guidelines smart-base toolchain",
      "description": "A checkout of WorldHealthOrganization/smart-base, whose input/scripts/ carries the DAK extractors, generators and XSLT transforms. Loaded from, never vendored: the scripts are invoked by the DAK repositories' own GitHub Actions, so smart-base stays their authoritative home and this platform depends on it rather than copying it. Resolved from SMART_BASE_HOME, defaulting to /opt/smart-base.",
      "detection": {
        "method": "command",
        "command": "test -f ${SMART_BASE_HOME:-/opt/smart-base}/input/scripts/extract_dak.py"
      },
