        "cli": "pip install faster-whisper (model weights download on first use)"
      },
      "invoke": {
        "shell": "python3 -m faster_whisper"
      },
      "io": {
        "inputs": [
          {
            "name": "file",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "language",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Locale",
            "required": false,
            "arg": {
              "flag": "--language"
            }
          }
        ],
        "outputs": [
          {
            "name": "transcript",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3",
          "faster-whisper"
        ],
        "network": true
      },
