    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#tool/lsi-query",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Tool",
      "name": "lsi-query",
      "title": "Latent Semantic Indexing over a prose graph",
      "description": "Find units of a declared prose graph (a library, the skills, the beans, docs) that discuss a query in OTHER words — the vocabulary gap lexical search cannot reach. Each hit is labelled lexical+latent or latent only, and the score is a cosine in the latent space, never merged with a lexical result.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run lsi query",
        "mcp": {
          "tool": "lsi_query"
        },
        "inProcess": {
          "module": "src/tools/lsi-query.ts"
        }
      },
      "io": {
        "inputs": [
          {
            "name": "text",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Text",
            "description": "The query, in any words, on STDIN — free text never goes on a command line.",
            "required": true,
            "arg": {
              "stdin": true
            }
          },
          {
            "name": "instance",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Slug",
            "description": "Instance declaring the graph, e.g. `who-iris`.",
            "required": false,
            "arg": {
              "flag": "--instance"
            }
          },
          {
            "name": "graph",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Slug",
            "description": "Graph id within the instance, e.g. `library`.",
            "required": false,
            "arg": {
              "flag": "--graph"
            }
          }
        ],
        "outputs": [
          {
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/tool-types.schema.json#/$defs/Markdown",
            "description": "Per graph: the top hits by cosine, each marked lexical+latent or latent only."
          }
        ]
      },
      "requirements": {
        "network": false
      },
