    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/pdfplumber",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "pdfplumber",
      "name": "pdfplumber (deterministic table extraction)",
      "description": "Pure-Python PDF geometry reader, the default backend of scripts/pdf-tables.py. Extracts ruled and alignment-based tables with exact column edges and bounding boxes, which pdf-structure/v1 does not model. No model weights and no egress after install, so unlike Docling it runs in a sandboxed session. Install: pip install pdfplumber.",
      "detection": {
        "method": "command",
        "command": "python3 -c 'import pdfplumber'"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#capability/pdfplumber"
    },
