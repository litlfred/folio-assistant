    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/pymupdf",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "pymupdf",
      "name": "PyMuPDF (preferred PDF reader backend for pdf-structure.py)",
      "description": "Optional PDF reader backend for scripts/pdf-structure.py, preferred over pypdf when present. Its text layer is cleaner on math PDFs (fewer split words, correct accents, correct CJK where pypdf yields mojibake), and it reads the embedded outline directly via get_toc() rather than walking pypdf's outline object. pdf-structure.py auto-detects it and falls back to pypdf when absent, so it is never required. LICENCE: PyMuPDF is AGPL-3.0 (or commercial); the shipped Docker image installs pypdf (BSD-3-Clause), not PyMuPDF, so this stays an opt-in accelerator. Install: pip install pymupdf.",
      "detection": {
        "method": "command",
        "command": "python3 -c 'import pymupdf'"
      },
      "requiresCapability": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/python3"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#capability/pymupdf"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-4z5o-cross-instance-figure-urls/cat-harness.jsonld#capability/lean-mcp",
      "@type": "https://litlfred.github.io/cat-harness/0.1.0/ns#Capability",
      "localId": "lean-mcp",
      "name": "Lean MCP Server",
      "description": "MCP server providing Lean 4 diagnostics, proof state, and goal information. It does NOT require a local lean-toolchain: the Lean runs server-side and detection is an mcp-probe against the endpoint. It used to declare that requirement, which made it unavailable on any machine without a local Lean even when the server was reachable — and, because `lean-toolchain.fallbackTo` names this capability, made that fallback unable to fire at all (it was absent in exactly the case it existed for). Removed 2026-09-20, bean folio-assistant-sym3.",
      "detection": {
        "method": "mcp-probe",
        "endpoint": "lean-mcp",
        "healthPath": "/health"
      },
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#capability/lean-mcp"
    },
