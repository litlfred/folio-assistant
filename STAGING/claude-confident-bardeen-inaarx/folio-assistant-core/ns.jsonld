  "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
  "@type": [
    "owl:Ontology",
    "skos:ConceptScheme"
  ],
  "label": "folio-assistant vocabulary (core only)",
  "comment": "Every class and property the folio knowledge graph projects, one node each. Generated by scripts/ns-export.ts; graph-typology definitions are read from the declaration registry rather than restated here.",
  "@graph": [
    {
      "@id": "folio-assistant-core:Image",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "Image",
      "comment": "A declared picture belonging to an instance, carrying its role, its layout and any text region.",
      "prefLabel": "Image",
      "definition": "A declared picture belonging to an instance, carrying its role, its layout and any text region.",
      "notation": "folio-assistant-core:Image",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:FolioGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "FolioGraph",
      "comment": "Authored content — the folio itself, rendered to a website.",
      "prefLabel": "FolioGraph",
      "definition": "Authored content — the folio itself, rendered to a website.",
      "notation": "folio-assistant-core:FolioGraph",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core",
      "seeAlso": "https://litlfred.github.io/content-types.html"
    },
    {
      "@id": "folio-assistant-core:GlossaryGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "GlossaryGraph",
      "comment": "A graph of SKOS terms (folio-glossary/v1): local terms with definitions and codes, linked to external SKOS concepts rather than copying them. Registered by core, not the harness.",
      "prefLabel": "GlossaryGraph",
      "definition": "A graph of SKOS terms (folio-glossary/v1): local terms with definitions and codes, linked to external SKOS concepts rather than copying them. Registered by core, not the harness.",
      "notation": "folio-assistant-core:GlossaryGraph",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:PreviewGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "PreviewGraph",
      "comment": "A staging target: the same folio built for review rather than for release.",
      "prefLabel": "PreviewGraph",
      "definition": "A staging target: the same folio built for review rather than for release.",
      "notation": "folio-assistant-core:PreviewGraph",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:UnknownGraph",
      "@type": [
        "rdfs:Class",
        "skos:Concept"
      ],
      "label": "UnknownGraph",
      "comment": "A declared graph typology nothing recognises — reported as its own state, never silently treated as empty.",
      "prefLabel": "UnknownGraph",
      "definition": "A declared graph typology nothing recognises — reported as its own state, never silently treated as empty.",
      "notation": "folio-assistant-core:UnknownGraph",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/computation-witness",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "computation-witness",
      "comment": "What a folio's computations recorded: one `<name>.witness.json` per producer run, naming the engine, the script and its hash, the commit, and each assertion with its computed and expected values. Written by the producer and regenerated by re-running it; addressable from prose and wired to a content block through `computation.witness`.",
      "prefLabel": "computation-witness",
      "definition": "What a folio's computations recorded: one `<name>.witness.json` per producer run, naming the engine, the script and its hash, the commit, and each assertion with its computed and expected values. Written by the producer and regenerated by re-running it; addressable from prose and wired to a content block through `computation.witness`.",
      "notation": "folio-assistant-core:graphTypology/computation-witness",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/folio",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "folio",
      "comment": "Authored content, rendered to a website by the just-the-docs pipeline.",
      "prefLabel": "folio",
      "definition": "Authored content, rendered to a website by the just-the-docs pipeline.",
      "notation": "folio-assistant-core:graphTypology/folio",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/glossary",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "glossary",
      "comment": "SKOS terms (folio-glossary/v1): local terms with definitions and codes, linked to external SKOS schemes by exactMatch rather than copied. Rendered on the glossary/ page.",
      "prefLabel": "glossary",
      "definition": "SKOS terms (folio-glossary/v1): local terms with definitions and codes, linked to external SKOS schemes by exactMatch rather than copied. Rendered on the glossary/ page.",
      "notation": "folio-assistant-core:graphTypology/glossary",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/library",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "library",
      "comment": "L1 source content — one `<bib-slug>/` per ingested document, holding `sections/*.md`, `structure.json` and, where the source was scanned, `ocr/page-NNN.txt`. Every knowledge-graph reference to a source resolves through here, never to a loose path or a bare URL.",
      "prefLabel": "library",
      "definition": "L1 source content — one `<bib-slug>/` per ingested document, holding `sections/*.md`, `structure.json` and, where the source was scanned, `ocr/page-NNN.txt`. Every knowledge-graph reference to a source resolves through here, never to a loose path or a bare URL.",
      "notation": "folio-assistant-core:graphTypology/library",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/public-comments",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "public-comments",
      "comment": "A public-comment record — one `folio-public-comment/v1` JSON per comment under `comments/`, and one `folio-public-comment-changeset/v1` JSON per change-set under `changesets/`. Written by the public-comment tool as comments are triaged and change-sets agreed.",
      "prefLabel": "public-comments",
      "definition": "A public-comment record — one `folio-public-comment/v1` JSON per comment under `comments/`, and one `folio-public-comment-changeset/v1` JSON per change-set under `changesets/`. Written by the public-comment tool as comments are triaged and change-sets agreed.",
      "notation": "folio-assistant-core:graphTypology/public-comments",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/review-verdicts",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "review-verdicts",
      "comment": "Reviewers' per-block verdicts — one `folio-review-verdict/v1` JSON each, pinned to the block's content hash and committed on the edit-set's feature branch. Read by the review coverage gate (`folio-review-coverage`), which counts a verdict only while its hash is current.",
      "prefLabel": "review-verdicts",
      "definition": "Reviewers' per-block verdicts — one `folio-review-verdict/v1` JSON each, pinned to the block's content hash and committed on the edit-set's feature branch. Read by the review coverage gate (`folio-review-coverage`), which counts a verdict only while its hash is current.",
      "notation": "folio-assistant-core:graphTypology/review-verdicts",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/todo-feedback",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "todo-feedback",
      "comment": "Feedback items — todos raised against a specific block, carrying the submitter's identity. Read by the `todo-review` skill.",
      "prefLabel": "todo-feedback",
      "definition": "Feedback items — todos raised against a specific block, carrying the submitter's identity. Read by the `todo-review` skill.",
      "notation": "folio-assistant-core:graphTypology/todo-feedback",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/todo-items",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "todo-items",
      "comment": "Todo nodes — one file each, carrying `\"$schema\": \"folio-todo/v1\"`. Authored by people and by agents on their behalf.",
      "prefLabel": "todo-items",
      "definition": "Todo nodes — one file each, carrying `\"$schema\": \"folio-todo/v1\"`. Authored by people and by agents on their behalf.",
      "notation": "folio-assistant-core:graphTypology/todo-items",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/todos",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "todos",
      "comment": "Human actors' outstanding work — content, owned by the folio, tagged by role, process, task and identity. Its inner directories are declared by `todos/todos.json`.",
      "prefLabel": "todos",
      "definition": "Human actors' outstanding work — content, owned by the folio, tagged by role, process, task and identity. Its inner directories are declared by `todos/todos.json`.",
      "notation": "folio-assistant-core:graphTypology/todos",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/uploads",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "uploads",
      "comment": "The incoming queue — raw files as dropped, before ingestion. NOT L1, and not greppable as corpus: a document here reads as absent to every consumer.",
      "prefLabel": "uploads",
      "definition": "The incoming queue — raw files as dropped, before ingestion. NOT L1, and not greppable as corpus: a document here reads as absent to every consumer.",
      "notation": "folio-assistant-core:graphTypology/uploads",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/voice-vendors",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "voice-vendors",
      "comment": "Vendor voice profiles — a base voice specialised for one agent vendor, `folio-voice/v1` with `extends` naming the base. A sub-graph of `voices`, declared from within by `voices.json`, each vendor declared by `vendors.json`.",
      "prefLabel": "voice-vendors",
      "definition": "Vendor voice profiles — a base voice specialised for one agent vendor, `folio-voice/v1` with `extends` naming the base. A sub-graph of `voices`, declared from within by `voices.json`, each vendor declared by `vendors.json`.",
      "notation": "folio-assistant-core:graphTypology/voice-vendors",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    },
    {
      "@id": "folio-assistant-core:graphTypology/voices",
      "@type": [
        "bootstrap:GraphTypology",
        "skos:Concept"
      ],
      "label": "voices",
      "comment": "Editorial voice profiles — one JSON each, carrying `\"$schema\": \"folio-voice/v1\"`. Every rule cites the ingested source or KG node it was derived from. Opt-in per folio.",
      "prefLabel": "voices",
      "definition": "Editorial voice profiles — one JSON each, carrying `\"$schema\": \"folio-voice/v1\"`. Every rule cites the ingested source or KG node it was derived from. Opt-in per folio.",
      "notation": "folio-assistant-core:graphTypology/voices",
      "inScheme": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "isDefinedBy": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns",
      "layer": "core"
    }
  ]
}
