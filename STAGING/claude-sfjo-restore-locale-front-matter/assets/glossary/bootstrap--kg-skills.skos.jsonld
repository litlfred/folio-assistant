  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "Skills, extracted (bootstrap)",
      "skos:definition": "Candidate terms extracted from every skill's front matter: `name` as the label, `description` as the definition. Generated by folio-assistant-core/scripts/glossary-extract.ts; not curated, and never hand-edited: a person promotes a term by authoring it in a glossary of their own.",
      "dcterms:source": "Skills of bootstrap"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills/bootstrap-graph-emission",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bootstrap-graph-emission"
        }
      ],
      "skos:definition": [
        {
          "@value": "What bootstrap's own Knowledge Graph must be when it is written out as a data file, `.jsonld` with a `.json` copy. bootstrap renders no pages for a person to browse, so this file is how it shows it is a Knowledge Graph at all."
        }
      ],
      "skos:notation": "bootstrap-graph-emission",
      "dcterms:source": "bootstrap/skills/bootstrap-graph-emission.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills/bootstrap-graph-publication",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bootstrap-graph-publication"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where bootstrap's Knowledge Graph file is published, why its `@id` must be exactly that address, why a `.json` copy sits beside the `.jsonld`, and why the file is not kept in the repository."
        }
      ],
      "skos:notation": "bootstrap-graph-publication",
      "dcterms:source": "bootstrap/skills/bootstrap-graph-publication.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills/bootstrap-kg-navigation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bootstrap-kg-navigation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read and navigate a knowledge graph with nothing installed — no MCP server, no tools, no harness. The first skill bootstrap hands you, because the second step of the handoff cannot be followed without it. Named `bootstrap-` so it cannot be confused with a navigation Skill of a Harness that is installed."
        }
      ],
      "skos:notation": "bootstrap-kg-navigation",
      "dcterms:source": "bootstrap/skills/bootstrap-kg-navigation.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills/confirm-harness",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "confirm-harness"
        }
      ],
      "skos:definition": [
        {
          "@value": "Narrow the harnesses and locations this could be, then have the Requestor settle it. Takes a list; returns at most ONE harness. It needs a person: the Requestor settles it, never the agent."
        }
      ],
      "skos:notation": "confirm-harness",
      "dcterms:source": "bootstrap/skills/confirm-harness.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills/discussion",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "discussion"
        }
      ],
      "skos:notation": "discussion",
      "dcterms:source": "bootstrap/skills/discussion.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills/log-message",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "log-message"
        }
      ],
      "skos:definition": [
        {
          "@value": "Say what you are doing, to the Logger, in a form a reader can act on. Five required fields and one optional body; an incomplete message is not logged. Callable from any task in any process, and required by some."
        }
      ],
      "skos:notation": "log-message",
      "dcterms:source": "bootstrap/skills/log-message.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills/root-readme",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "root-readme"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the repository's root README when there is none, carrying a link to the harness that was installed and the overall install status. Never replaces one that exists. It runs only once the install has succeeded."
        }
      ],
      "skos:notation": "root-readme",
      "dcterms:source": "bootstrap/skills/root-readme.md",
      "skos:note": "candidate"
    }
  ]
