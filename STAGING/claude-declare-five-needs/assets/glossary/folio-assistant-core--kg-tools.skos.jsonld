{
  "@context": {
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/"
  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "Tools, extracted (folio-assistant-core)",
      "skos:definition": "Candidate terms extracted from every Tool node: `title` as the label, `description` as the definition, the Tool id as the code. Generated by folio-assistant-core/scripts/glossary-extract.ts; not curated, and never hand-edited: a person promotes a term by authoring it in a glossary of their own.",
      "dcterms:source": "Tools of folio-assistant-core"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools/folio-changeset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio ChangeSet"
        }
      ],
      "skos:definition": [
        {
          "@value": "What changed in a folio between two git refs, block by block: each block added, removed, or changed — and for a changed block, every aspect that applies (renamed, prose, manifest, moved). Keyed on the block label, which the `id-unique` / `id-stable` QA criteria guard, not on file paths."
        }
      ],
      "skos:notation": "folio-changeset",
      "dcterms:source": "folio-assistant-core/tools/index.ts#folio-changeset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools/folio-review-comment-move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Move a review comment's status"
        }
      ],
      "skos:definition": [
        {
          "@value": "A review-process task moves one `folio-review-comment/v1` todo's status (address, send back, resolve, adjudicate, withdraw) through `transition()`, which refuses any move the named BPMN task may not make. The comment is written to the folio's todos graph (its declared `todo-feedback` directory) and, with `--commit`, committed to the edit-set's FEATURE branch. Refused on the base branch and on a detached HEAD."
        }
      ],
      "skos:notation": "folio-review-comment-move",
      "dcterms:source": "folio-assistant-core/tools/index.ts#folio-review-comment-move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools/folio-review-comments",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio review comments"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ingest a pull request's tagged conversation comments (`block: <label>` on the first line) into `folio-review-comment/v1` todos, and write them as `review-comments.json`. Idempotent over its previous output, whose statuses it keeps. Re-anchors every comment against the head's blocks, following `renamedFrom`, and orphans a comment whose block is gone rather than dropping it."
        }
      ],
      "skos:notation": "folio-review-comments",
      "dcterms:source": "folio-assistant-core/tools/index.ts#folio-review-comments",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools/folio-review-coverage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Folio review coverage"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compute the two facts `content-change-review.bpmn`'s coverage gate (`GW_Covered`) reads: `uncoveredBlocks`, the changed blocks with no reviewer verdict on their CURRENT hash, and `openDefects`. Reads a preview's `changeset.json`, `blocks.json` and `review-comments.json`. With `--commit`, writes the ingested `folio-review-verdict/v1` verdicts into the todos graph's declared `review-verdicts` directory and commits them to the edit-set's FEATURE branch; refused on the base branch and a detached HEAD. Prints the facts as JSON on stdout."
        }
      ],
      "skos:notation": "folio-review-coverage",
      "dcterms:source": "folio-assistant-core/tools/index.ts#folio-review-coverage",
      "skos:note": "candidate"
    }
  ]
}
