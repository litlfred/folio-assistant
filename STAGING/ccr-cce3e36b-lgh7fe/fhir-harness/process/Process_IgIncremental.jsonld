      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/process/Process_IgIncremental",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/Process",
      "name": "Incremental IG build",
      "summary": "An incremental build for a FHIR Implementation Guide: compile, validate and re-render only the dependency cone of a change, then gate on QA and deploy.",
      "description": "An incremental build for a FHIR Implementation Guide: compile, validate and re-render only the dependency cone of a change, then gate on QA and deploy. One change (a PR push or a push to main) runs:\nrestore the derived state, compute the change's dependency cone, compile and\nvalidate only the cone against the warm validator, re-render the cone's\nrecords, rebuild the meta-index, assemble the site, gate on QA, then deploy;\non main or a release only, seed the cache from the green build. An unusable\ncache falls back to a full build; an environment error stops the run and logs\nwhy. Advisory, like the other content-type pipelines: the package that owns\nthe content owns what adequate means.",
      "enforcement": "advisory",
      "sourcePath": "processes/content/ig-incremental-build.bpmn",
      "sourceUrl": "https://github.com/litlfred/fhir-harness/blob/main/processes/content/ig-incremental-build.bpmn",
