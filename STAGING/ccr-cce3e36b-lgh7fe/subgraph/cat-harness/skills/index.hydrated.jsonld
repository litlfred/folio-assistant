            },
            {
              "@id": "https://litlfred.github.io/folio-assistant/cat-harness/skill/hand-back-to-discussion",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "A sibling agent, spawned during or working beside a live agent-human discussion, hands every card, question, decision, result, blocker or piece of context back to the discussion agent that is talking with the person, and never leaves it only in its own thread. The discussion agent asks the person (ask-the-person), marks every copy answered, and routes the answer back. A review sheet or issue in play is an extra channel. Use whenever an agent that is not the one talking with the person has something the person must see.",
              "hasIOContract": true,
              "hasInstructions": true,
