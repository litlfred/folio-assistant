  "@graph": [
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/docs",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "docs",
      "renderable": true,
      "summary": "Documentation ABOUT the knowledge graph — how the harness works, what its directories hold, how a process runs. Rendered by the plain just-the-docs pipeline. Distinct from `folio`, which is content an author CREATES using the graph; the difference is the SUBJECT, not the format. An L1 library's catalogue is `library/`; a note about it is a `folio`; the page explaining how ingestion works is `docs`."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/library",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "library",
      "renderable": false,
      "summary": "L1 source content — one `<bib-slug>/` per ingested document, holding `sections/*.md`, `structure.json` and, where the source was scanned, `ocr/page-NNN.txt`. Every knowledge-graph reference to a source resolves through here, never to a loose path or a bare URL."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/document-kinds",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "document-kinds",
      "renderable": false,
      "summary": "Document kinds — named structures of sections (fixed or semi-fixed) that a document authored with a harness follows, one `document-kind/1.0.0` JSON each, plus computed `document-kind-coverage/1.0.0` reports of how a subject realises one. Every kind and section names its sources; `computedFrom` names the declared graphs a section derives from."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/translation-sources",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "translation-sources",
      "renderable": false,
      "summary": "POT templates, PO catalogues and their `TranslationNode` manifests, one directory per target locale. The INPUT to injection; the rendered output is ordinary content that declares its own `lang`."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/openapi",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "openapi",
      "renderable": false,
      "summary": "OpenAPI 3 documents an instance holds, each verbatim beside a provenance node naming the repository, path and commit it was ingested from (cat-harness's `openapi` subgraph). Every operation in a document is a node of its own: a page and an IRI under the instance's docs."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/fhir-artifact-index",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "fhir-artifact-index",
      "renderable": false,
      "summary": "The artefact index of a published FHIR Implementation Guide, reconstructed from its published output — every artefact by canonical URL and published representation, with the IG API's JSON Schema / JSON-LD sidecars as an overlay where the IG publishes them. No IG publishes such an index itself, so every field records which file it came out of."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/ig-ast",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "ig-ast",
      "renderable": false,
      "summary": "The IG Publisher's abstract syntax tree of a FHIR Implementation Guide (its resources, their dependency edges and the build plan), ingested into the folio that uses the IG. One branch per IG package id; the IG's own source need not be materialised."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/ig-pages",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "ig-pages",
      "renderable": false,
      "summary": "The pages of a FHIR Implementation Guide mirror, generated from its artefact index and the chrome of its template chain. Carried beside `docs` on the same directory: `docs` is how the site mounts them, and this kind is what says they are derived."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/catalogue",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "catalogue",
      "renderable": false,
      "summary": "A remote catalogue modelled by reference — communities, collections and items of a corpus the instance does not hold. Every node declares whether its bytes are here (`materialized`), elsewhere (`referenced`) or unestablished (`unknown`), with no default. Distinct from `library`, which is content that IS here."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/v0/ns/graphTypology/glossary",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "glossary",
      "renderable": false,
      "summary": "SKOS terms (folio-glossary/v1): local terms with definitions and codes, linked to external SKOS schemes by exactMatch rather than copied. Rendered on the glossary/ page."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/ccr-cce3e36b-lgh7fe/smart-trust/directory/smart-trust-ast",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/Subgraph",
      "name": "smart-trust-ast",
      "path": "fhir-ast/",
