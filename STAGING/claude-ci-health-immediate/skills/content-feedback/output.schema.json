{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/STAGING/claude-ci-health-immediate/skills/content-feedback/output.schema.json",
  "title": "Content Feedback Output",
  "description": "Output schema for triaged feedback.",
  "type": "object",
  "required": [
    "triagedItems"
  ],
  "properties": {
    "triagedItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "priority",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "backlog",
              "next-sprint",
              "wont-fix",
              "duplicate",
              "needs-info"
            ]
          },
          "assignee": {
            "type": "string"
          },
          "linkedIssue": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer"
        },
        "critical": {
          "type": "integer"
        },
        "major": {
          "type": "integer"
        },
        "minor": {
          "type": "integer"
        },
        "enhancement": {
          "type": "integer"
        }
      }
    }
  },
  "staging": {
    "branch": "claude/ci-health-immediate",
    "sha": "f2b3d519cee06a3f760ad7991702c54fb7d6c0df",
    "pr": "1725/merge",
    "run": "36793512013"
  }
}
