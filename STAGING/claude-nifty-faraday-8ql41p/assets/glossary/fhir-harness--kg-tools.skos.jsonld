      "skos:prefLabel": [
        {
          "@value": "Stage one IG as its own just-the-docs Jekyll site"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turn an IG source repository into ONE Jekyll source for just-the-docs, as the IG Publisher builds one IG per site: `input/pagecontent` pages with title, parent and order from `sushi-config.yaml` `pages:`, the files the Publisher resolves `{% include %}` against, images, `_data/fhir.json` from `ig-site-data`, and a `_config.yml`. The pages render unchanged, `{{ site.data.fhir.* }}` included (bean `bamf`, owner's choice of one site per IG)."
        }
      ],
      "skos:notation": "build-ig-site",
      "dcterms:source": "fhir-harness/tools/index.ts#build-ig-site",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/fhir-cache-seed-npm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the FHIR package cache from trusted sources (exact versions)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fill `~/.fhir/packages` (or `--cache`) for an environment that cannot reach packages.fhir.org, from trust anchors only: npm account `grahamegrieve` (owner-trusted), publishers' own published-site repositories (the seeder's list, each fetch verified against the tarball's own package.json), template repos found through FHIR/ig-registry's templates.json read live each run, and an owner `--mirror`. Exact versions only (a patch wildcard resolves as the Publisher resolves it, recorded); every tarball verified; nothing computed once and kept; provenance recorded; missing versions listed, never substituted."
        }
      ],
      "skos:notation": "fhir-cache-seed-npm",
      "dcterms:source": "fhir-harness/tools/index.ts#fhir-cache-seed-npm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/fhir-package-mirror",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Mirror FHIR packages from packages.fhir.org into a git repository"
        }
      ],
      "skos:definition": [
        {
          "@value": "On a machine that reaches packages.fhir.org, fetch exactly a missing list (from `fhir-cache-seed-npm --missing-out`), check each tarball names itself exactly, record SHA512SUMS, and commit and push to a git repository that an environment without packages.fhir.org reads with `--mirror`. The person running it is the trust anchor for what it adds."
        }
      ],
      "skos:notation": "fhir-package-mirror",
      "dcterms:source": "fhir-harness/tools/index.ts#fhir-package-mirror",
      "skos:note": "candidate"
    },
    {
