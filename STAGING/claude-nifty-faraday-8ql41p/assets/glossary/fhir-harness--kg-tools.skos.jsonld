        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "List and view the delta between two IG ASTs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Diff two ASTs by resource key: added, removed, changed (with a structural element-level differential) and version-changed resources, plus edges added and removed; optionally fold in the incremental plan, and render just-the-docs pages (an index that lists, a page per resource that shows) every one of which carries the provisional mark. `list <ast>` summarises one AST."
        }
      ],
      "skos:notation": "ig-ast-diff",
      "dcterms:source": "fhir-harness/tools/index.ts#ig-ast-diff",
      "skos:note": "candidate"
    },
    {
