              "name": "symbiotic-interaction",
              "partOf": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#directory/skills",
              "title": "symbiotic-interaction — the three registers of author input"
            },
            {
              "@id": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#skill/untrusted-input",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "Keep attacker-controlled values out of program text — in GitHub Actions, in command lines, in anything that is parsed before it runs. Read before interpolating any value into a script, and before giving a Tool a command-line input.",
              "hasIOContract": false,
