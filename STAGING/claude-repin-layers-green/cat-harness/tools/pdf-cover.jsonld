  "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/tools/pdf-cover.jsonld",
  "partOf": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/cat-harness.jsonld",
  "staging": {
    "branch": "claude/repin-layers-green",
    "sha": "cf94ff0d9ffcd3f81ed3db2f241c3a2135469aba",
    "pr": "2681/merge",
    "run": "40078913707"
  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/tools/pdf-cover.jsonld",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns#Tool",
      "name": "pdf-cover",
      "title": "PDF page raster",
      "description": "Render one page of a PDF to a PNG — the thumbnail a repository listing shows — and print the provenance a catalogue needs to record it as DERIVED: source, digest, page, geometry, renderer.",
      "install": {
        "cli": "pip install pymupdf"
      },
      "invoke": {
        "shell": "bun run cat pdf:cover"
      },
      "io": {
        "inputs": [
          {
            "name": "pdf",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The PDF to render from. Its bytes must be here; nothing is fetched.",
            "required": true,
            "arg": {
              "positional": 0
            }
          },
          {
            "name": "out",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/tool-types.schema.json#/$defs/RepoPath",
            "description": "The PNG to write.",
            "required": true,
            "arg": {
              "flag": "--out"
            }
          },
          {
            "name": "page",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "1-based page to render, default 1. Asking for a page past the end is refused, not clamped.",
            "required": false,
            "arg": {
              "flag": "--page"
            }
          },
          {
            "name": "width",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/tool-types.schema.json#/$defs/Count",
            "description": "Output width in pixels, default 300. `Count` admits zero and a zero width does not; the script refuses it rather than writing a 0x0 PNG, which is the tighter bound stated at the port as `CountSchema` asks. Height follows the page's own aspect and is never forced.",
            "required": false,
            "arg": {
              "flag": "--width"
            }
          },
          {
            "name": "checkOnly",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/tool-types.schema.json#/$defs/Flag",
            "description": "Write nothing; exit non-zero if the target differs from what would be written.",
            "required": false,
            "arg": {
              "flag": "--check"
            }
          }
        ],
        "outputs": [
          {
            "name": "facts",
            "schema": "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/tool-types.schema.json#/$defs/Text",
            "description": "With `--json`: source path and sha256, page, page count, point geometry, pixel geometry, output bytes and sha256, media type, renderer version. Everything a provenance record needs and nothing it has to guess."
          }
        ]
      },
      "requirements": {
        "runtime": [
          "python3",
          "pymupdf"
        ],
        "network": false
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/STAGING/claude-repin-layers-green/cat-harness/skill/asset-extraction"
      ],
      "alternateOf": "https://litlfred.github.io/folio-assistant/cat-harness/tools/pdf-cover.jsonld"
    }
  ]
}
