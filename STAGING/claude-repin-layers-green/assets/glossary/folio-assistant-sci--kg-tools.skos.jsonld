          "@value": "Proof status from a Lean build"
        }
      ],
      "skos:definition": [
        {
          "@value": "Update each proof object's status in `proof-objects.json` from a Lean build log — which objects built, which carry `sorry`, which failed. Exits 1 on a manifest with no objects rather than writing an empty status."
        }
      ],
      "skos:notation": "proof-status-update",
      "dcterms:source": "folio-assistant-sci/tools/proof-status-update/proof-status-update.ts#proof-status-update",
      "skos:note": "candidate"
