      "skos:prefLabel": [
        {
          "@value": "Lean build"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build every Lean project in the workspace from the root Lake manifest, so cross-package dependencies resolve against it rather than a possibly-stale per-paper manifest. Writes a committable build-status sidecar every run."
        }
      ],
      "skos:notation": "lean-build",
