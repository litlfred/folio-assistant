      "skos:definition": [
        {
          "@value": "Restore, verify, seed and diagnose the prebuilt `.lake/` artefacts for a Lean package. Always try `restore` first: a from-source Mathlib build is 30–60 minutes, a restore about two."
        }
      ],
      "skos:notation": "lean-cache",
