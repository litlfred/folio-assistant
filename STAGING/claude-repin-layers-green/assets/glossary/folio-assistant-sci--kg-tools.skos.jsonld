        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Paper build to LaTeX chapters"
        }
      ],
      "skos:definition": [
