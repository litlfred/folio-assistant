        {
          "@value": "Lean vacuity audit"
        }
      ],
      "skos:definition": [
        {
          "@value": "Inspect Lean declarations chapter by chapter for proofs that type-check, are sorry-free and axiom-clean, and still carry no mathematical content — assuming what they claim, concluding something trivially true, or resting on a false premise."
        }
      ],
      "skos:notation": "lean-audit",
      "dcterms:source": "folio-assistant-sci/tools/lean-audit/lean-audit.ts#lean-audit",
