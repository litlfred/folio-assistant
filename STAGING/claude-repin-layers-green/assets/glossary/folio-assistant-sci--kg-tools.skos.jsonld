      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "TeX snippet validation (AST)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Parse every `tex` snippet in a folio's blocks and report what will not compile — structural, not textual: it reads an AST rather than matching patterns. Complementary to `latex-preflight`, which gates a main.tex before a compile, and to `latex-overfull`, which reads a log after one."
        }
      ],
      "skos:notation": "tex-snippet-validate",
      "dcterms:source": "folio-assistant-sci/tools/tex-snippet-validate/tex-snippet-validate.ts#tex-snippet-validate",
