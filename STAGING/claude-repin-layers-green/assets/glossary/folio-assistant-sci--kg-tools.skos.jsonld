      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Build a Lean package's HTML docs (doc-gen4)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build the doc-gen4 HTML render of a folio's Lake package — the visualiser of a declared `lean` directory — with `lake -R -Kenv=dev build <Lib>:docs`, cache-aware: refuses while another lake/lean process holds `.lake/`, refuses on a restored tree that carries no traces (a Lake build there EVICTS the cache), checks or restores the warm cache first, and enables a sentinel-commented doc-gen4 `[[require]]` for this build only, restoring the lakefile on exit. Never runs `lake update`. Output: `<lake-root>/.lake/build/doc`."
        }
      ],
      "skos:notation": "lean-html-docs",
      "dcterms:source": "folio-assistant-sci/tools/lean-html-docs/lean-html-docs.ts#lean-html-docs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns#glossary/kg-tools/lean-kg-publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish the dynamic Lean viewer: doc-gen4 declaration data as knowledge-graph shards"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ingest doc-gen4's per-module declaration data (`.lake/build/doc-data/declaration-data-<Module>.bmp`) into JSON-LD shards — one per module, with declaration nodes, `imports` edges and `formalizes` edges to the content blocks whose `lean.ref` names each declaration — and publish them under the folio's site with a single viewer page that loads modules, signature chunks and the search list on demand. Signatures are chunked 500 declarations per file so a 12,804-declaration module stays usable. With `--base` it writes a STAGING overlay: only modules whose content hash differs from the published base, plus `overlay.json`; the viewer loads the rest from the base. Rails the viewer page with the same pass as `lean-render-publish`."
        }
      ],
      "skos:notation": "lean-kg-publish",
      "dcterms:source": "folio-assistant-sci/tools/lean-kg-publish/lean-kg-publish.ts#lean-kg-publish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns#glossary/kg-tools/lean-render-publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish a Lean render under a folio site, with the harness rail"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stage a doc-gen4 render under a folio's built site (`<site>/<route>/`, default `lean/`) and give every page the harness navbar and rail by running `cat-harness/scripts/rail-standalone-pages.ts --foreign-site` over the site — the same rail `stage-folio-local.ts` applies to the folio's own pages. Leaves out Lake's `.hash`/`.trace` bookkeeping, marks doc-gen4's iframe navbar and `find/` redirect `folio-navbar: none` so no rail is drawn inside the sidebar, adds a layout shim so the rail does not cover doc-gen4's fixed sidebar, and with `--modules` prunes to the folio's own modules, repointing links into dropped ones to the community docs. Then asserts every staged page is railed or declined."
        }
      ],
      "skos:notation": "lean-render-publish",
      "dcterms:source": "folio-assistant-sci/tools/lean-render-publish/lean-render-publish.ts#lean-render-publish",
      "skos:note": "candidate"
    },
