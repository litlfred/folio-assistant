      ],
      "skos:definition": [
        {
          "@value": "Install the toolchain pinned in `lean-toolchain`, fetching it from the GitHub release rather than through elan's downloader. Idempotent, and it detects partial state rather than re-downloading."
        }
      ],
      "skos:notation": "lean-toolchain-setup",
      "dcterms:source": "folio-assistant-sci/tools/lean-toolchain-setup/lean-toolchain-setup.ts#lean-toolchain-setup",
