{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/fhir-harness/tools/ig-repo-site/",
  "@type": "bootstrap:Subgraph",
