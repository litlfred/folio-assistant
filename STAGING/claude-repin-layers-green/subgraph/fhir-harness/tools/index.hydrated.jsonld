                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
              }
            ]
          },
          "name": "ig-repo-site",
          "requirements": {
            "network": true,
            "runtime": [
              "bun",
              "git"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/fhir-harness/skill/ig-build-pipeline",
          "title": "Build an IG repository's own site from its cached AST, with no instance declaration"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/ig-repo-site",
      "path": "tools/ig-repo-site/"
    },
