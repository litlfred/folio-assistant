              },
              {
                "description": "The site's base URL; each IG is served under it at `/<instance>/` or `/<instance>/ig/`.",
                "name": "baseurl",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
