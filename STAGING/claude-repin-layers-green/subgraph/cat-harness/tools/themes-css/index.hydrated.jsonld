            "description": "The generated stylesheet. Build output that happens to be committed, so it is readable on the forge — never hand-edited.",
            "name": "stylesheet",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
