      "@type": "cat-harness:Tool",
      "description": "Produce a translated copy of a source markdown file from a .po, using the same segmentation the extractor used.",
      "install": {
        "none": true
      },
      "invoke": {
        "inProcess": {
          "module": "src/tools/translation.ts"
        },
        "mcp": {
          "tool": "translation_inject"
        }
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "name": "source",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "positional": 1
            },
            "name": "po_file",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--locale"
            },
            "name": "locale",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Locale"
          }
        ],
        "outputs": [
          {
            "description": "The translated copy written.",
            "name": "translated",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "translation-inject",
      "requirements": {
        "network": false
      },
