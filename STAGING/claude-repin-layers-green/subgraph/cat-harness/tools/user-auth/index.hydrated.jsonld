          "module": "src/tools/auth.ts"
        },
        "mcp": {
          "tool": "auth_whoami"
        }
      },
      "io": {
        "inputs": [
          {
            "description": "A declared actor the caller is acting as.",
            "name": "actor",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "An ODRL action to ask about, e.g. content-authoring.",
            "name": "action",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "Process id, to scope the question or check a task.",
            "name": "process",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "Node id; with process, runs the task-authorization check.",
            "name": "task",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "The role the lane binds.",
            "name": "role",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "description": "The content acted on.",
            "name": "target",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ],
        "outputs": [
          {
            "description": "Identity, GitHub role, ODRL grants and decisions, and what GitHub's grain cannot express.",
            "name": "answer",
