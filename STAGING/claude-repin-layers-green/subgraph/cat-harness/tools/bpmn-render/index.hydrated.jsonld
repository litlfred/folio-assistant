{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/bpmn-render/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/bpmn-render.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Render each process diagram to SVG for the documentation site. The .bpmn file is the source of truth; the picture is generated from it, so a diagram and its image cannot disagree.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat render:bpmn"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--check"
            },
            "description": "Fail if any committed SVG is stale, instead of writing.",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "The generated SVG directory. Never hand-edited.",
            "name": "diagrams",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "bpmn-render",
      "requirements": {
        "network": false,
        "runtime": [
          "bun",
          "chromium"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/docs-generation",
      "title": "BPMN diagram rendering"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/bpmn-render",
  "path": "tools/bpmn-render/"
}
