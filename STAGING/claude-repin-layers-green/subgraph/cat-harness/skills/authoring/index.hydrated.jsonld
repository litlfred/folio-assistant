        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/skill/production-vs-exploratory-discipline",
          "@type": "bootstrap:Skill",
          "ambiguous": false,
          "description": "Distinguish PRODUCTION (derived-only, no fits) from EXPLORATORY (empirical-fit probes OK as shape-hints) from NUMEROLOGY (post-hoc fits to known constants). The hidden-extra-input / empirical-fit antipattern is a common review-churn source: agents promote empirical fits into production scripts, \"closed\" status, dashboards, and named constants without a derivation. This skill is the bright-line guide for which output goes where, the derivation-menu check, and the escalation path for off-menu coefficients.",
          "hasIOContract": false,
          "hasInstructions": true,
          "inPackage": "https://litlfred.github.io/folio-assistant/cat-harness/package/authoring-core",
