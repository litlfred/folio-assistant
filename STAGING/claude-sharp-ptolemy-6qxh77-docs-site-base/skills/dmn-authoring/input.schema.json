        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "boolean",
              "date",
              "codeable-concept"
            ]
          }
        }
      }
    },
    "sourceLogic": {
      "type": "string",
      "description": "Reference to the clinical decision logic being modeled."
    }
  },
