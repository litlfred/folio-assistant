  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/docs",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "docs",
      "renderable": true,
      "summary": "Documentation ABOUT the knowledge graph — how the harness works, what its directories hold, how a process runs. Rendered by the plain just-the-docs pipeline. Distinct from `folio`, which is content an author CREATES using the graph; the difference is the SUBJECT, not the format. The who-iris catalogue is `library/`; a note about it is a `folio`; the page explaining how ingestion works is `docs`."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/code",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "code",
      "renderable": false,
      "summary": "Source code -- the modules, scripts and entry points an instance holds. Declared so that code is scannable at all: an undeclared file is one no checker has a reason to look at. Being declared here says nothing about whether a Tool node claims it, which is a separate question and a separate axis."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/beans",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "beans",
      "renderable": false,
      "summary": "The work plan — what is being worked on, and where each running BPMN instance got to. Its inner directories are declared by `beans/beans.json`."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/bean-defs",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "bean-defs",
      "renderable": false,
      "summary": "Work items — one Markdown file each, in the layout the `beans` CLI reads. Authored and edited by people and agents."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/bean-notes",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "bean-notes",
      "renderable": false,
      "summary": "Bean notes — one Markdown file per pull request per bean, `$schema: folio-bean-note/v1` in its front matter, named `<bean>--<date>--<branch>.md` so two pull requests never write one path. Indexed by a generated README."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/session-survey",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "session-survey",
      "renderable": false,
      "summary": "Published surveys of a commit window — one JSON file each, carrying `\"$schema\": \"folio-session-survey/v1\"` and the window's two edge commits, so a later session can compute what it is NOT covered for instead of re-deriving the whole range (bean `6ptx`)."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/workflow-state",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "workflow-state",
      "renderable": false,
      "summary": "Running BPMN instances — one JSON file each, carrying `\"$schema\": \"folio-workflow-instance/v1\"`. Owned by the interpreter, never hand-edited."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/merge-queue",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "merge-queue",
      "renderable": false,
      "summary": "A merge steward's DECISIONS about an open pull request — priority, rank or override with its reason, a hold with its expiry, the train it joined, an ejection with its evidence. Never a fact GitHub owns: CI, mergeability, labels and the head SHA are read live and refused by name here."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#graphKind/todos",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "todos",
      "renderable": false,
      "summary": "Human actors' outstanding work — content, owned by the folio, tagged by role, process, task and identity. Its inner directories are declared by `todos/todos.json`."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/boards",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "boards",
      "renderable": false,
      "summary": "Boards — one JSON file each, carrying `\"$schema\": \"folio-board/v1\"`. A board is a diagram OF a folio: it declares what it shows, and a folio with no board is complete. Schema: `schemas/board.ts`."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#graphKind/board-positions",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "board-positions",
      "renderable": false,
      "summary": "Where each note sits on each board — `board-positions.json`, keyed by board then by note id, in board units. The layout layer, which points at notes and is never pointed back at. Schema: `schemas/board-positions.ts`."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#graphKind/todo-items",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "todo-items",
      "renderable": false,
      "summary": "Todo nodes — one file each, carrying `\"$schema\": \"folio-todo/v1\"`. Authored by people and by agents on their behalf."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#graphKind/uploads",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "uploads",
      "renderable": false,
      "summary": "The incoming queue — raw files as dropped, before ingestion. NOT L1, and not greppable as corpus: a document here reads as absent to every consumer."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-core/0.1.0/ns#graphKind/todo-feedback",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphKind",
      "name": "todo-feedback",
      "renderable": false,
      "summary": "Feedback items — todos raised against a specific block, carrying the submitter's identity. Read by the `todo-review` skill."
    },
    {
