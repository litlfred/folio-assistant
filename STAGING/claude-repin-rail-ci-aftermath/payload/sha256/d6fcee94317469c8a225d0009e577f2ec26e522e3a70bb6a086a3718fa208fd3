    },
    {
      "id": "library/9789241548960-eng/blocks/prose-sec-069",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "References",
      "pageStart": 50,
      "pageEnd": 51,
      "target": "../sections/sec-069-310-references.md",
      "narrative": null,
      "content": "1.\t\nWHO eManual /III - Human Resources/III.1 Duties, Obligations and Privileges/III.1.2 \nDeclaration of Interests [intranet site: available to WHO staff only]. Geneva: World Health \nOrganization; 2014 (http://emanual.who.int/p03/s01/Pages/DeclarationofInterests.aspx, \naccessed 27 November 2014).\n2.\t\nNational Institute for Health and Care Excellence (NICE) [website]. London: National \nInstitute for Health and Care Excellence; 2014 (http://www.nice.org.uk/, accessed 12 \nNovember 2014).\n3.\t\nNICE patient and public involvement policy. London: National Institute for Health and Care \nExcellence; 201",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "A numbered reference list for Chapter 3, citing items such as WHO declaration-of-interests and compliance pages, NICE materials, the Cochrane and Campbell collaborations, the review committee site and the WHO style guide.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
