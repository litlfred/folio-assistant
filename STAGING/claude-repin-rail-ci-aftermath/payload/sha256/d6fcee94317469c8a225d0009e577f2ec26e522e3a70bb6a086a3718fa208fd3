    {
      "id": "library/9789241548960-eng/blocks/prose-sec-039",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Do you have your director’s agreement?",
      "pageStart": 31,
