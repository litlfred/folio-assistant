      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Steps in the rapid review process",
      "pageStart": 155,
      "pageEnd": 155,
      "target": "../sections/sec-200-117-steps-in-the-rapid-review-process.md",
      "narrative": null,
      "content": "",
