    {
      "id": "library/9789241548960-eng/blocks/figure-img-p126-1",
      "types": [
        "folio-assistant-core:Figure",
        "doco:Figure"
      ],
      "kind": "figure",
      "title": "",
      "pageStart": 126,
      "pageEnd": 126,
      "target": "../images/img-p126-1.png",
      "narrative": "draft",
      "content": "The GRADE approach to rating confidence in an estimate of effect. Rows give study design — randomized controlled trials, which start at high confidence, and observational studies, which start at low. Between them, five reasons for lowering confidence (risk of bias, inconsistency, indirectness, imprecision, publication bias) and three for raising it (large effect, dose response, and plausible confounding that would either reduce a demonstrated effect or suggest a spurious one). The right-hand column gives the four resulting levels — high, moderate, low and very low — each shown with the circle notation, from four filled circles down to one.",
      "truncated": false,
