    {
      "id": "library/9789241548960-eng/blocks/prose-sec-162",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "References",
      "pageStart": 133,
      "pageEnd": 135,
      "target": "../sections/sec-162-98-references.md",
      "narrative": null,
      "content": "1.\t\nGuidelines Review Committee (GRC) [intranet site: available to WHO staff only]. Geneva: \nWorld Health Organization; 2014 (http://intranet.who.int/homes/ker/grc/, accessed 14 \nNovember 2014).\n2.\t\nGRADE working group [website]. The GRADE working group; 2014 (http://www.gradeworkinggroup.org/, accessed 12 November 2014).\n3.\t\nGRADE Online Learning Modules [website]. Ontario: McMaster University; 2014 (http://\ncebgrade.mcmaster.ca/, accessed 12 November 2014).\nWHO handbook for guideline development\n122\n4.\t\nGRADE series in the Journal of Clinical Epidemiology [website]. Maryland Heights: Elsevie",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "A reference list for the evidence assessment chapter, citing GRADE working group resources, the GRADE handbook and the GRADE guideline series in the Journal of Clinical Epidemiology, along with Cochrane risk of bias and inconsistency papers.",
