    {
      "id": "library/9789241548960-eng/blocks/prose-sec-160",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "How is the overall quality of the evidence determined?",
      "pageStart": 132,
      "pageEnd": 133,
      "target": "../sections/sec-160-96-how-is-the-overall-quality-of-the-evidence-de.md",
      "narrative": null,
      "content": "Guideline developers review all the information from the systematic review \nand, if needed, reassess and make a final decision about which outcomes are \ncritical and which ones are important in light of the recommendations that \nthey aim to formulate. The GDG assigns an overall quality to the evidence, \nbased on a combined rating of the quality of the evidence across all outcomes \nthat are considered critical for answering the key question (i.e. for making a \ndecision or a recommendation).\nGDGs must determine the overall quality of the evidence across all the \ncritical outcomes for each recomm",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Explains how the GDG determines overall quality of evidence across all critical outcomes for a recommendation. The lowest quality among the critical outcomes sets the overall quality, with two exceptions where an outcome proves not to be critical or where higher-quality evidence on other critical outcomes already supports the recommendation.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-10-06"
