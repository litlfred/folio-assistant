      "target": "../sections/sec-224-122-peer-review.md",
      "narrative": null,
      "content": "■■\nfollowing WHO’s production and publication processes;\n■■\ndisseminating the guideline; and\n■■\nupdating its contents.",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "A short fragment of bullets continuing a list (following WHO production and publication processes, disseminating and updating the guideline), filed under a peer review heading.",
