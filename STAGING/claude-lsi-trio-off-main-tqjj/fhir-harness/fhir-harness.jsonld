    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/fhir-harness.jsonld#skill/ig-publisher-fork",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Skill",
      "name": "ig-publisher-fork",
      "title": "ig-publisher-fork",
      "description": "Requirements for an agent working a local experimental fork of the IG Publisher — which repositories, what the AST must carry, what must not change, and the acceptance criteria. Read before forking, and before reporting a fork's work complete.",
      "instructionsPath": "skills/fhir-ig-base/ig-publisher-fork.md",
      "instructionLines": 212,
      "hasInstructions": true,
      "hasIOContract": false,
      "ambiguous": false,
      "inSubgraph": "https://litlfred.github.io/folio-assistant/fhir-harness/fhir-harness.jsonld#directory/fhir-ig-skills"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/fhir-harness.jsonld#skill/ig-binary-artefacts",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Skill",
      "name": "ig-binary-artefacts",
      "title": "ig-binary-artefacts",
      "description": "Where the IG Publisher's binary outputs go — full-ig.zip, package.tgz and its R4/R4B variants, package.db, validator packs, and the definitions, examples and expansions zips — and why a pages branch is the wrong place for them. Measure a branch with ig-binary-audit before deciding anything. Read before configuring an IG's deploy or release step, before linking a download from a page, and before a pages branch grows past its size limit.",
      "instructionsPath": "skills/fhir-ig-base/ig-binary-artefacts.md",
      "instructionLines": 104,
      "hasInstructions": true,
      "hasIOContract": false,
      "ambiguous": false,
      "inSubgraph": "https://litlfred.github.io/folio-assistant/fhir-harness/fhir-harness.jsonld#directory/fhir-ig-skills"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/fhir-harness.jsonld#skill/ig-build-pipeline",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Skill",
      "name": "ig-build-pipeline",
      "title": "ig-build-pipeline",
      "description": "The bare FHIR IG pipeline — FSH to SUSHI to the IG Publisher to a pages branch, with no pre-processing and no post-processing. What this layer runs, what it emits, and the list of things it deliberately refuses to know about. Read before adding anything to fhir-harness.",
      "instructionsPath": "skills/fhir-ig-base/ig-build-pipeline.md",
      "instructionLines": 168,
      "hasInstructions": true,
      "hasIOContract": false,
      "ambiguous": false,
      "inSubgraph": "https://litlfred.github.io/folio-assistant/fhir-harness/fhir-harness.jsonld#directory/fhir-ig-skills"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/fhir-harness.jsonld#skill/ig-site-theme",
      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Skill",
      "name": "ig-site-theme",
      "title": "ig-site-theme",
      "description": "How an IG rendered through just-the-docs wears the theme its instance ALREADY declares: the one `webpage` theme becomes the IG site's colour scheme. Says which of the three theme paths applies to which surface, what is refused, and how to verify on the built CSS rather than on a log line. Read before theming an IG site, adding a theme to an IG instance, or concluding that a staged IG is unthemed.",
      "instructionsPath": "skills/fhir-ig-base/ig-site-theme.md",
      "instructionLines": 88,
      "hasInstructions": true,
