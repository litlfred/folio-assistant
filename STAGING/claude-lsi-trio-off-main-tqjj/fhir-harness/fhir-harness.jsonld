      "@type": "https://litlfred.github.io/bootstrap/0.1.0/ns#Skill",
      "name": "ig-render-jekyll",
      "title": "ig-render-jekyll",
      "description": "Rendering a FHIR IG's content through the just-the-docs pipeline instead of mounting the IG Publisher's finished HTML — the JSON-only representation contract, navigation derived from sushi-config.yaml, and the LHS rail. Read before adding a representation, a menu entry, or a page kind.",
      "instructionsPath": "skills/fhir-ig-base/ig-render-jekyll.md",
