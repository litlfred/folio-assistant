{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/render-log/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/render-log.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Append one entry to the render log on the publish branch: what was published or taken down, when, from which commit, and — for a removal or a retention — WHY. The log is the only place a preview that vanished leaves a trace.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat render:log"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--dir"
            },
            "description": "A checkout of the publish branch, or a publish directory about to become one. This tool NEVER fetches, commits or pushes: the calling workflows hold the checkout with their own retry and concurrency handling, and a second pusher racing them could lose a deploy.",
            "name": "dir",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--event"
            },
            "description": "`rendered`, `removed`, `restored` or `retained`. `retained` records a removal CONSIDERED and refused, which would otherwise leave no trace.",
            "name": "event",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RenderEvent"
          },
          {
            "arg": {
              "flag": "--kind"
            },
            "description": "What was rendered — `staging-preview`, `site`, `export`. Open, not an enum: the publish branch carries more than previews, and an enum would make logging a new kind wait on a schema change.",
            "name": "kind",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--path"
            },
            "description": "The path on the publish branch. Checked as a VALUE, never trusted by provenance: the slug sanitiser can emit `..`, which is only safe for a slug taken from a git ref, and a dispatch input is not one.",
            "name": "path",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--slug"
            },
            "description": "The staging slug, where the subject has one.",
            "name": "slug",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--branch"
            },
            "description": "The branch the render came from.",
            "name": "branch",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          },
          {
            "arg": {
              "flag": "--commit"
            },
            "description": "The commit the artefact was built from.",
            "name": "commit",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/CommitSha"
          },
          {
            "arg": {
              "flag": "--run"
            },
            "description": "The workflow run that wrote this, so a reader can open the log.",
            "name": "run",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          },
          {
            "arg": {
              "stdin": true
            },
            "description": "One JSON object on STDIN: `{summary, reason?, detail?, format?}`. `summary` is required and one line. `reason` is required by the SCRIPT for `removed` and `retained`, because an entry saying an artefact went and not why is the ambiguity the log exists to prevent. `format` declares how the prose reads (absent means plain text, never sniffed). Build it with `jq -n --arg`, never by concatenation.",
            "name": "prose",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ],
        "outputs": [
          {
            "description": "The day's JSONL the entry was APPENDED to. Append is the only verb: there is no `--remove`, no `--edit` and no `--id`, so a takedown is a `removed` ENTRY rather than the erasure of the `rendered` one before it, and the never-delete rule is structural rather than a guard every cleanup path must remember.",
            "name": "entry",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "render-log",
      "requirements": {
        "network": false,
        "runtime": [
          "bun",
          "jq"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/render-logging",
      "title": "Record what the publish branch served"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/render-log",
  "path": "tools/render-log/"
}
