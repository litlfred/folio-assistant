    <dcterms:title xml:lang="en">IHE IT Infrastructure Technical Framework Supplement — Verifiable Health Links (VHL)</dcterms:title>
    <dcterms:creator>IHE IT Infrastructure Technical Committee</dcterms:creator>
    <dcterms:issued xsi:type="dcterms:W3CDTF">2026-06-14</dcterms:issued>
