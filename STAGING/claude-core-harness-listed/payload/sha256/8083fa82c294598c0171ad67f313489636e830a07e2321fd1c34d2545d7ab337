      "kind": "prose",
      "title": "Page 9",
      "pageStart": 9,
      "pageEnd": 9,
      "target": "../sections/page-009.md",
      "narrative": null,
      "content": "EXAMPLE 1\n{\n  \"@context\" : [ {\n    \"xsd\" : \"http://www.w3.org/2001/XMLSchema#\",\n    \"dcterms\" : \"http://purl.org/dc/terms/\",\n    \"ex\" : \"http://example/\",\n    \"prov\" : \"http://www.w3.org/ns/prov#\",\n    \"foaf\" : \"http://xmlns.com/foaf/0.1/\"\n  }, \"https://openprovenance.org/prov-jsonld/context.jsonld\" ],\n  \"@graph\" : [ {\n    \"@type\" : \"Entity\",\n    \"@id\" : \"ex:dataSet1\"\n  }, {\n    \"@type\" : \"Entity\",\n    \"@id\" : \"ex:article1\",\n    \"dcterms:title\" : [ {\n\"@value\" : \"Crime rises in cities\",\n\"@language\" : \"EN\"\n    } ]\n  }, {\n    \"@type\" : \"Derivation\",\n    \"generatedEntity\" : \"ex:article1\",\n    \"use",
      "truncated": true,
      "provenance": "ingested",
