    {
      "@id": "docs/concepts/es/architecture.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Access control — ODRL, checked before every task",
      "prov:value": "Hasta el issue #1207 (23-09-2026), `rbac.ts` era una escala independiente de visor < colaborador\n< propietario y el ejecutor no comprobaba nada.",
