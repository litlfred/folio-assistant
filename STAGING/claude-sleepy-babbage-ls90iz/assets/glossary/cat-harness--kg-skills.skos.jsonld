      },
      "skos:prefLabel": [
        {
          "@value": "kg-navigation"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a cold agent finds and loads the skill that governs its task. The two Tools that serve the knowledge graph — the MCP pair and the filesystem fallback — what counts as a skill, and the three ways the search goes wrong."
        }
      ],
      "skos:notation": "kg-navigation",
      "dcterms:source": "cat-harness/skills/kg-navigation/kg-navigation.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/kg-to-portal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-to-portal"
        }
      ],
      "skos:definition": [
        {
          "@value": "Getting a knowledge graph out to a public portal — the six stages between \"the graph is in the repository\" and \"a reader's browser has the bytes\", why a CDN is a layer rather than a publication host, and which decisions are the deployment's to make rather than the pipeline's."
        }
      ],
      "skos:notation": "kg-to-portal",
      "dcterms:source": "cat-harness/skills/folio-core/kg-to-portal.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/kg-viewer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "kg-viewer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render a published knowledge-graph document so a person can read it — faceted index, node detail, followable edges, and an honest account of what the document is missing. Host-agnostic; the publishing is a separate Tool."
        }
      ],
      "skos:notation": "kg-viewer",
      "dcterms:source": "cat-harness/skills/folio-core/kg-viewer.md",
      "skos:note": "candidate"
