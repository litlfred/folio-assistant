      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/adjudication",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "adjudication"
        }
      ],
      "skos:definition": [
        {
          "@value": "Settle a review that reached no mechanical or consensus agreement. What makes a disagreement adjudicable, the shape seven implementations here already share, why the adjudication LEADS the criterion while the checker's entry is kept beneath it, and the dispensation that records the reason — scoped to a version, never precedent."
        }
      ],
      "skos:notation": "adjudication",
      "dcterms:source": "cat-harness/skills/folio-core/adjudication.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/adopt-methodology-from-source",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "adopt-methodology-from-source"
        }
      ],
      "skos:definition": [
        {
          "@value": "The general process for turning a shared paper, book or standard into an adopted methodology: establish origin and licence, ingest the source, find and summarize related beans and issues and ask whether to coordinate, render the method with its adopted and refused parts, place it by ownership, integrate it by calling existing processes, give every tool it uses a Tool node, and put it to the owner. Process: processes/methodology-from-source.bpmn."
        }
      ],
      "skos:notation": "adopt-methodology-from-source",
      "dcterms:source": "cat-harness/skills/folio-core/adopt-methodology-from-source.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/agent-memory",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "agent-memory"
        }
      ],
      "skos:definition": [
        {
          "@value": "Durable memory for a subagent — the three entry labels and what each promises, why entries are authored as graph nodes rather than in the generated file, the injection budget that silently truncates, and archiving as the third state between \"reaches everybody\" and \"deleted\"."
        }
      ],
      "skos:notation": "agent-memory",
      "dcterms:source": "cat-harness/skills/folio-core/agent-memory.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/archiving-arxiv",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "archiving-arxiv"
        }
      ],
      "skos:definition": [
        {
          "@value": "Materializing a paper from arXiv — why the version suffix is part of the identity rather than a detail, what to keep beside the PDF, and which facts must be read from the published API rather than recalled."
        }
      ],
      "skos:notation": "archiving-arxiv",
      "dcterms:source": "cat-harness/skills/folio-core/archiving-arxiv.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/archiving-web-pages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "archiving-web-pages"
        }
      ],
      "skos:definition": [
        {
          "@value": "Capturing a web page so it can be cited later — the two fidelities, what each one is evidence of, and why capturing only one of them loses something that cannot be recovered. A URL is not an archive."
        }
      ],
      "skos:notation": "archiving-web-pages",
      "dcterms:source": "cat-harness/skills/folio-core/archiving-web-pages.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/asset-extraction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "asset-extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reading a container — a zip, a PDF, a saved web page — into the knowledge graph. What goes in by default (metadata), what does not (contents), the three timestamps that sit near each other and mean different things, and why a producer string is evidence."
        }
      ],
      "skos:notation": "asset-extraction",
      "dcterms:source": "cat-harness/skills/folio-core/asset-extraction.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/associate-harness",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "associate-harness"
        }
      ],
      "skos:definition": [
        {
          "@value": "Declare a harness this one knows about and does not hold (`associatedHarnesses`): a folio in another repository, published at its own site. Referenced, never loaded, never materialized. Issue #1146."
        }
      ],
      "skos:notation": "associate-harness",
      "dcterms:source": "cat-harness/skills/folio-core/associate-harness.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/audit-coverage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "audit-coverage"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which audits reach which KIND of node, measured rather than inferred. Read before concluding that a corpus is unaudited, before writing a criterion for one, and before building any coverage report — the gate half must be declared, an undeclared declarer is counted, and the committed record holds the relation rather than the census."
        }
      ],
      "skos:notation": "audit-coverage",
      "dcterms:source": "cat-harness/skills/folio-core/audit-coverage.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/bean-blocking",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bean-blocking"
        }
      ],
      "skos:definition": [
        {
          "@value": "Default to non-blocking when updating a bean's status. Mark blocked only when the work genuinely cannot proceed, and then always with what it waits on, when the wait expires, and what the next agent should do."
        }
      ],
      "skos:notation": "bean-blocking",
      "dcterms:source": "cat-harness/skills/folio-core/bean-blocking.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/bean-coordination",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bean-coordination"
        }
      ],
      "skos:definition": [
        {
          "@value": "Pointer to the bean-based session work-plan system (the `beans` CLI flat-file issue tracker, data under `beans/`). Operational usage lives in todo-manager.md / session-intent.md; the generic coordinator/orchestrator logic is owned by the folio-assistant platform."
        }
      ],
      "skos:notation": "bean-coordination",
      "dcterms:source": "cat-harness/skills/folio-core/bean-coordination.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/bib-human-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bib-human-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Human-validated bibliography workflow. Flag references that have not been human-reviewed against their source; drive the acquisition ladder (source-in-repo → acquire-legally → physical-library); open one GitHub issue per reference needing physical review (full project context + bibliographic data + page-photo request, assigned to the repo owner); hand off uploaded photos to the bib-photo-ingestion watcher. Use when auditing bib human-review status, ingesting an uploaded paper's results, or preparing a physical-review issue."
        }
      ],
      "skos:notation": "bib-human-review",
      "dcterms:source": "cat-harness/skills/folio-core/bib-human-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/bib-photo-ingestion-watcher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bib-photo-ingestion-watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Integration-watcher for bib physical-review issues. When a page photo is uploaded to a `bib-physical-review` issue (or an in-repo source passage is agent-identified), OCR/read it, formalise the cited result (if the project has a formal-proof pipeline), confirm the project's usage matches the source, run machine + agent bib validation, then set the reference status to `validated` and refresh references.review.json. Use when processing a bib-physical-review issue that has an attached photo, or when ingesting an uploaded paper."
        }
      ],
      "skos:notation": "bib-photo-ingestion-watcher",
      "dcterms:source": "cat-harness/skills/folio-core/bib-photo-ingestion-watcher.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/bib-qa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bib-qa"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bibliography quality-assurance agent — validates every reference in content/schema/references.ts against several QA checks: URL availability, URL resolution, metadata completeness, citation coverage, and screenshot/image evidence. Generates bib-qa.json consumed by the standalone bib-qa.html dashboard."
        }
      ],
      "skos:notation": "bib-qa",
      "dcterms:source": "cat-harness/skills/folio-core/bib-qa.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/block-density",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "block-density"
        }
      ],
      "skos:definition": [
        {
          "@value": "Audits individual content blocks for single-topic coherence, length, and embedded tables. Blocks that cover multiple topics or exceed ~2/3 of a page should be split; large tables (>5 rows) must be their own `table` block. Child blocks from a split may belong in different chapters than the parent."
        }
      ],
      "skos:notation": "block-density",
      "dcterms:source": "cat-harness/skills/folio-core/block-density.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/board-diagram-interchange",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "board-diagram-interchange"
        }
      ],
      "skos:definition": [
        {
          "@value": "A board is a DIAGRAM OF a folio, not a container of one. The OMG split between the semantic model and its layout, why the arrow runs one way, and what a note may never carry."
        }
      ],
      "skos:notation": "board-diagram-interchange",
      "dcterms:source": "cat-harness/skills/folio-core/board-diagram-interchange.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/board-windows",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "board-windows"
        }
      ],
      "skos:definition": [
        {
          "@value": "Everything starts as its avatar; opening projects a window onto the board. The two mechanisms that must not be conflated, z-order, and the fixed chrome a content kind fills in."
        }
      ],
      "skos:notation": "board-windows",
      "dcterms:source": "cat-harness/skills/folio-core/board-windows.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/bpmn-authoring",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bpmn-authoring"
        }
      ],
      "skos:notation": "bpmn-authoring",
      "dcterms:source": "cat-harness/skills/workflow/bpmn-authoring.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/bpmn-processes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "bpmn-processes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every process here is BPMN, the diagrams are executable, and the base processes are strict. How to author one, how to run it, how a package relaxes a step and what it may never relax, and which gateways are computed rather than chosen."
        }
      ],
      "skos:notation": "bpmn-processes",
      "dcterms:source": "cat-harness/skills/workflow/bpmn-processes.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/branch-freshness",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "branch-freshness"
        }
      ],
      "skos:definition": [
        {
          "@value": "Periodically rebase or merge main into the feature branch, detect what changed upstream, and re-analyse the session workplan. Prevents stale assumptions, merge conflicts, and duplicated work — especially after session restarts, long idle periods, or heavy sibling activity on main."
        }
      ],
      "skos:notation": "branch-freshness",
      "dcterms:source": "cat-harness/skills/workflow/branch-freshness.md",
      "skos:note": "candidate"
    },
    {
