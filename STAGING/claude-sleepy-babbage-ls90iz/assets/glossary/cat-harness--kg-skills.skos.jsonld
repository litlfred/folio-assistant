      },
      "skos:prefLabel": [
        {
          "@value": "build-docs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Builds the Lean HTML documentation (doc-gen4) locally in the workspace, for any paper folio's Lean package."
        }
      ],
      "skos:notation": "build-docs",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/build-docs.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/build-pdf",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "build-pdf"
        }
      ],
      "skos:definition": [
        {
          "@value": "Builds a paper folio's PDF locally in the workspace — the monolithic PDF plus split per-chapter PDFs."
        }
      ],
      "skos:notation": "build-pdf",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/build-pdf.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/canonical-watcher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "canonical-watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Derivation-discipline integration watcher — watches the default branch + open active PRs + newly-opened PRs for non-canonical empirical / fitting / calibration inputs beyond the project's declared set, numerology, or justification/rationalization in place of derivation. Inherits shared mechanics (Monitor, subscriptions, queue, ledger, idle sweep, author-ask, watch-prepared-PRs, witness-drift recovery, billing-quick-fail flake, post-completion one-voice, sibling-PR comment protocol, backlog-found PR spin-up, handover docs) from `local/integration-watcher`."
        }
      ],
      "skos:notation": "canonical-watcher",
      "dcterms:source": "cat-harness/skills/folio-core/canonical-watcher.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/category-theory",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "category-theory"
        }
      ],
      "skos:definition": [
        {
          "@value": "Category Theory formalization skill — handles diagram chasing, universal properties, functorial translation, and whiskering in Lean 4. Integrates with Mathlib's typeclass-centric category theory and provides tactic strategies for commutativity proofs."
        }
      ],
      "skos:notation": "category-theory",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/category-theory.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/chapter-analysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "chapter-analysis"
        }
      ],
      "skos:definition": [
        {
          "@value": "Thorough analysis and Lean 4 formalization of a single manuscript chapter. Extracts all narrative definitions/propositions (excluding remarks), identifies missing glossary terms, writes comprehensive Lean stubs using mathlib, and proves limiting-case and structural theorems where possible."
        }
      ],
      "skos:notation": "chapter-analysis",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/chapter-analysis.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/chapter-complexity-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "chapter-complexity-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Analyse a chapter's internal dependency graph to find backward edges (blocks that reference something defined later), compute graph energy, and suggest section/block reorderings that minimise complexity. Uses Graphviz for visualisation and brute-force permutation search for optimal section ordering."
        }
      ],
      "skos:notation": "chapter-complexity-review",
      "dcterms:source": "cat-harness/skills/folio-core/chapter-complexity-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/ci-health",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "ci-health"
        }
      ],
      "skos:definition": [
        {
          "@value": "A red workflow looks exactly like a green one from inside a checkout. How to read a default-branch health report, the three verdicts that keep it honest, why a watchdog needs both a session-start print and an unattended run, and the separate external question the Pages deployments need."
        }
      ],
      "skos:notation": "ci-health",
      "dcterms:source": "cat-harness/skills/folio-core/ci-health.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/code-lists",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "code-lists"
        }
      ],
      "skos:definition": [
        {
          "@value": "Author, extend or consume a code list: a closed set of codes, each with a label, a definition and a source, kept as a node and published as SKOS. Use when a diagram, a schema or a script needs a fixed set of values (adjudication answers, namespace IRIs) instead of strings in code."
        }
      ],
      "skos:notation": "code-lists",
      "dcterms:source": "cat-harness/skills/folio-core/code-lists.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/code-node-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "code-node-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review the knowledge graph's CODE nodes — Tool definitions in the `tools` graph and schema definition nodes under `schemas/` — for the joins a reader cannot see: that a node declares what it is, that what it names resolves, and that the mechanism it describes is the one that actually runs."
        }
      ],
      "skos:notation": "code-node-review",
      "dcterms:source": "cat-harness/skills/folio-core/code-node-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/code-review-process",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "code-review-process"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where code review sits in the release lifecycle. Review types, who reviews what, how feedback maps to beans, and the path from review to approval to release. Works with prepare-merge-auto for mechanics and release-lifecycle for the broader flow."
        }
      ],
      "skos:notation": "code-review-process",
      "dcterms:source": "cat-harness/skills/workflow/code-review-process.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/communication-language",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "communication-language"
        }
      ],
      "skos:definition": [
        {
          "@value": "Determine the language an agent SPEAKS IN — the language of a turn, as against the language of content. Covers the four inputs and their order, why a model's own languages are never the answer, the boundary between speaking to the person and writing durable artefacts, where the determination is recorded so a sibling session does not re-ask, and when to re-ask."
        }
      ],
      "skos:notation": "communication-language",
      "dcterms:source": "cat-harness/skills/folio-core/communication-language.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/compute-audit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "compute-audit"
        }
      ],
      "skos:definition": [
        {
          "@value": "Audit compute scripts for a catalogue of correctness and performance antipatterns extracted from a long review of the project's compute history. Distinguishes CORRECTNESS antipatterns from PERFORMANCE antipatterns. Produces a ranked workplan citing concrete files+lines."
        }
      ],
      "skos:notation": "compute-audit",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/compute-audit.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/compute-author",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "compute-author"
        }
      ],
      "skos:definition": [
        {
          "@value": "Pre-work briefing + durable patterns for anyone writing or modifying compute scripts (or the native crates they call). Read this BEFORE you write or change compute code — it covers precision discipline, the native↔script boundary cost, exact-arithmetic choices (big-integer vs big-rational vs arbitrary-precision float), algebraic-preflight requirements before optimization shortcuts, and witness-emission discipline. Sibling to `compute-audit` (post-hoc); this skill is pre-work."
        }
      ],
      "skos:notation": "compute-author",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/compute-author.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/compute-integration-watcher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "compute-integration-watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Cross-layer wiring auditor — watches for newly-landed formal/analytic improvements (proofs, propositions, lemmas, axiom→theorem upgrades, witness data) on the default branch AND on open PRs, and checks whether each one has been wired into the production compute chain. Complements `local/compute-audit` (which scans for performance/correctness antipatterns inside scripts). Runs in two modes: REACTIVE (watch new commits / PR events) and IDLE-SWEEP (walk all existing content blocks and audit wiring)."
        }
      ],
      "skos:notation": "compute-integration-watcher",
      "dcterms:source": "cat-harness/skills/folio-core/compute-integration-watcher.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/confirmation-waiver",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "confirmation-waiver"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human may waive a confirmation they are owed — for a session, for a process run, or until a stated time. Covers what a waiver is made of, where it is recorded (the context graph, never the work plan), the gates that can be waived and the rules that cannot, why every waiver carries an expiry, and the one thing an agent may never do: grant itself one."
        }
      ],
      "skos:notation": "confirmation-waiver",
      "dcterms:source": "cat-harness/skills/folio-core/confirmation-waiver.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/content-acquisition",
