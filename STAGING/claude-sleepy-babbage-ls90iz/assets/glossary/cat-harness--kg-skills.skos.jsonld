      },
      "skos:prefLabel": [
        {
          "@value": "crdm-data-model"
        }
      ],
      "skos:definition": [
        {
          "@value": "The CRDM data-modelling phase — when in the requirements process a model is built, what it is built from, who confirms it, and what it hands to the phases either side. The technique it invokes is `data-modelling`; this skill carries only the sequencing and the sign-off."
        }
      ],
      "skos:notation": "crdm-data-model",
      "dcterms:source": "cat-harness/skills/crdm/crdm-data-model.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/crdm-detect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "crdm-detect"
        }
      ],
      "skos:definition": [
        {
          "@value": "Detect when a request needs requirements agreed before anything is built, and which of the two parallel requirements methodologies governs it."
        }
      ],
