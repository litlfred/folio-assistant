      },
      "skos:prefLabel": [
        {
          "@value": "placement"
        }
      ],
      "skos:definition": [
        {
          "@value": "Establish where a new node belongs BEFORE you create it — which instance, which declared graph, which kind of node, and which of the two \"stub\" conventions applies. Read before adding a skill, role, actor, workflow, decision table, schema, tool or content object, and before writing any literal that names one folio."
        }
      ],
      "skos:notation": "placement",
      "dcterms:source": "cat-harness/skills/folio-core/placement.md",
      "skos:note": "candidate"
    },
    {
