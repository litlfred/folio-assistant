      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/theme-art-intake",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-art-intake"
        }
      ],
      "skos:definition": [
        {
          "@value": "Accept or refuse a set of three theme/avatar layouts arriving through document ingestion, with a named reason for every refusal."
        }
      ],
      "skos:notation": "theme-art-intake",
      "dcterms:source": "cat-harness/skills/theming/theme-art-intake.md",
