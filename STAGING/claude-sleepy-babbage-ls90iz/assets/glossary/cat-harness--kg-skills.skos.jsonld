        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "document-intake"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process uploaded documents (PDFs, scans, LaTeX, structured/normative guidelines, etc.) from uploads/ into structured content objects. Handles OCR extraction, environment detection, structural analysis, and content-object generation. Supports multi-stage pipelines: raw upload → extracted text → structured blocks → .ts/.md content objects."
        }
      ],
      "skos:notation": "document-intake",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/document-intake.md",
      "skos:note": "candidate"
