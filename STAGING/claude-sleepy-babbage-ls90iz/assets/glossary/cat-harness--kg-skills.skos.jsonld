      },
      "skos:prefLabel": [
        {
          "@value": "swot-analysis"
        }
      ],
      "skos:definition": [
        {
          "@value": "Running a SWOT situation analysis — the four activities of `swot-analysis.bpmn`, what each step must produce, and the one thing the technique must never be used for. The method itself lives in the `methodology` graph and is not repeated here."
        }
      ],
      "skos:notation": "swot-analysis",
      "dcterms:source": "cat-harness/skills/folio-core/swot-analysis.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/symbiotic-interaction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "symbiotic-interaction"
        }
      ],
      "skos:definition": [
        {
          "@value": "Recognize and respond to the three epistemic registers of author input — Socratic steer (known-answer correction), honest gap (flagged unknown), and intuition seed (tenuous cross-domain identification) — with the coactive-learning measurement spec (per-arc correction quality and turns-to-convergence) and the prompt-lexicon convention. Carries the STRICT rule that a steer correcting a RULE is written into the skill that governs it, in the same turn, quoted and dated — use whenever the author corrects, settles or overrules anything. Generic folio-assistant platform skill."
        }
      ],
      "skos:notation": "symbiotic-interaction",
      "dcterms:source": "cat-harness/skills/folio-core/symbiotic-interaction.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/tabular-metadata",
      "@type": "skos:Concept",
      "skos:inScheme": {
