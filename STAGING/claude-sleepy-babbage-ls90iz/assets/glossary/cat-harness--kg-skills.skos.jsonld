      },
      "skos:prefLabel": [
        {
          "@value": "proof-narrative-lean-equivalence"
        }
      ],
      "skos:definition": [
        {
          "@value": "For each content block with both a narrative proof (.md) and a Lean sibling (.lean), verify the two prove the same thing. Detect stub-weakening (Lean claims less than the paper), overreach (Lean claims more than the paper), hypothesis mismatches, and notation drift. Produces a structured equivalence report; no edits."
        }
      ],
      "skos:notation": "proof-narrative-lean-equivalence",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/proof-narrative-lean-equivalence.md",
      "skos:note": "candidate"
