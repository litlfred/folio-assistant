      },
      "skos:prefLabel": [
        {
          "@value": "where-a-proposal-goes"
        }
      ],
      "skos:notation": "where-a-proposal-goes",
      "dcterms:source": "cat-harness/skills/folio-core/where-a-proposal-goes.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/where-does-this-go",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "where-does-this-go"
        }
      ],
      "skos:definition": [
        {
          "@value": "The router for filing decisions. This repository answers \"where does this go?\" nine separate times, each well, and nothing says WHICH question you are asking — so an agent who does not know a rule exists cannot look it up. One discriminating question per row, and the skill that owns the answer."
        }
      ],
      "skos:notation": "where-does-this-go",
      "dcterms:source": "cat-harness/skills/folio-core/where-does-this-go.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/wireframe-design-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "wireframe-design-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Design a user interface (a page, a visualiser, a navbar) by the WireGen methodology: a written design intent, at least two mid-fidelity HTML candidates, each with a web AND a mobile layout, mechanical checks at both viewports, a blind per-criterion review, adjudication where reviewers disagree, and a recorded choice. Also how an EXISTING visualiser is wireframed as-is, so that every declared visualiser has a wireframe with a QA sidecar. Process: processes/wireframe-design-review.bpmn."
        }
      ],
      "skos:notation": "wireframe-design-review",
      "dcterms:source": "cat-harness/skills/folio-core/wireframe-design-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/witnessed-values",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "witnessed-values"
        }
      ],
      "skos:notation": "witnessed-values",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/witnessed-values.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/workflow-state",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "workflow-state"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where a running process keeps what it knows, and which store answers which question. The three records a step may touch, the one it may not, what `<cat-harness.processes:bean op>` actually performs, and why an instance and a bean must be one answer rather than two."
        }
      ],
      "skos:notation": "workflow-state",
      "dcterms:source": "cat-harness/skills/workflow/workflow-state.md",
      "skos:note": "candidate"
    }
  ]
}
