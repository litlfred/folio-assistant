      },
      "skos:prefLabel": [
        {
          "@value": "theming"
        }
      ],
      "skos:definition": [
        {
          "@value": "The map of this subgraph: theming is split on PIPELINE STAGE first — intake, declaration, generation, contrast — with producer/consumer as the direction each stage faces, and per-artefact specialisation last. Read this to find which stage owns the fact you need; read the stage for the fact."
        }
      ],
      "skos:notation": "theming",
      "dcterms:source": "cat-harness/skills/theming/theming.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/todo-manager",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "todo-manager"
        }
      ],
      "skos:definition": [
        {
          "@value": "Maintain and display work-in-progress task lists using the `beans` CLI issue tracker. Track implementation progress, open tasks, missing artifacts, and blocked items across a session."
        }
      ],
      "skos:notation": "todo-manager",
      "dcterms:source": "cat-harness/skills/folio-core/todo-manager.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/todo-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "todo-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Monitor and triage open feedback across all content blocks. At session start, ask the author if they'd like to work on feedback. Provide overview, let them pick a chapter/section, then review and iterate until done."
        }
      ],
      "skos:notation": "todo-review",
      "dcterms:source": "cat-harness/skills/folio-core/todo-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/toolchain-ownership",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "toolchain-ownership"
        }
      ],
      "skos:definition": [
        {
          "@value": "Taking ownership of the WHO smart-base scripts in a litlfred fork, rewriting them to the Skill I/O contract, and the one gate that governs when a script may actually move. Read before touching, copying or rewriting any upstream smart-base script."
        }
      ],
      "skos:notation": "toolchain-ownership",
      "dcterms:source": "cat-harness/skills/authoring-who-smart-guidelines/toolchain-ownership.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/translation-manager",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "translation-manager"
        }
      ],
      "skos:definition": [
        {
          "@value": "Translation lifecycle management for folio content. Covers gettext PO/POT extraction and injection, TranslationNode manifests as KG nodes, official vs unofficial translations, staleness tracking, sign-off workflow, automatic badge rendering, and the poSources fallback resolution chain."
        }
      ],
      "skos:notation": "translation-manager",
      "dcterms:source": "cat-harness/skills/folio-core/translation-manager.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/turn-reporting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "turn-reporting"
        }
      ],
      "skos:definition": [
        {
          "@value": "Say which bean you are on, every turn — the opening and closing report formats, the rules that make a report worth reading (two sentences and a link per bean, every mention), and the STRICT rule that the \"next\" line is a question and must carry its own context."
        }
      ],
      "skos:notation": "turn-reporting",
      "dcterms:source": "cat-harness/skills/folio-core/turn-reporting.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/ui-accessibility",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "ui-accessibility"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every user interface this project produces must be operable by keyboard, legible at measured contrast, and comfortable to hit. How to build to that, how to check it, and why an automated pass is not the standard."
        }
      ],
      "skos:notation": "ui-accessibility",
      "dcterms:source": "cat-harness/skills/folio-core/ui-accessibility.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/uml-overview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uml-overview"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read, regenerate or extend the UML class diagrams of a harness: one per harness and one per named sub-graph it declares, plus the harness object model. Every box is generated from a declaration and a schema, never drawn by hand, so a wrong diagram is fixed at the declaration or the schema, and a dashed \"could not determine\" box is a finding about the registry."
        }
      ],
      "skos:notation": "uml-overview",
      "dcterms:source": "cat-harness/skills/folio-core/uml-overview.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/untainted-verification",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "untainted-verification"
        }
      ],
      "skos:definition": [
        {
          "@value": "The party that produced an artefact does not write the verdict on it. How a checker and an adjudicator are dispatched with controlled context, the three rules that make it a measurement rather than a ritual, and the third state that lets it gate at all."
        }
      ],
      "skos:notation": "untainted-verification",
      "dcterms:source": "cat-harness/skills/folio-core/untainted-verification.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/untrusted-input",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "untrusted-input"
        }
      ],
      "skos:definition": [
        {
          "@value": "Keep attacker-controlled values out of program text — in GitHub Actions, in command lines, in anything that is parsed before it runs. Read before interpolating any value into a script, and before giving a Tool a command-line input."
        }
      ],
      "skos:notation": "untrusted-input",
      "dcterms:source": "cat-harness/skills/folio-core/untrusted-input.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/unverified-constraints",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "unverified-constraints"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never encode a constraint you have not verified — a rule that refuses a working setup is worse than no rule. Read before adding a check to a schema, a validator, a gate or an incompatibility table, and whenever you are about to write down that something \"is not supported\"."
        }
      ],
      "skos:notation": "unverified-constraints",
      "dcterms:source": "cat-harness/skills/folio-core/unverified-constraints.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/uploads-watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uploads-watch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Notice what has landed in the acquisition queue, and tell an arrival from a backlog. Reports; it never deletes, and never ingests on its own say-so."
        }
      ],
      "skos:notation": "uploads-watch",
      "dcterms:source": "cat-harness/skills/folio-core/uploads-watch.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/upstream-version-adoption",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "upstream-version-adoption"
        }
      ],
      "skos:definition": [
        {
          "@value": "Watch a pinned upstream dependency for a new release, and take a candidate version through impact analysis, an MVP build, review and a person's adopt/hold/decline decision. Reusable per pin — the theme is the first tenant, not the only one."
        }
      ],
      "skos:notation": "upstream-version-adoption",
      "dcterms:source": "cat-harness/skills/folio-core/upstream-version-adoption.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/uses-editorial-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uses-editorial-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Adjudicate `uses-editorial-completeness` — read a block as a reader would and judge whether its `uses[]` is complete and genuinely expository. The human/agent half of the `uses` QA axis; the mechanical half runs in `qa-checkers-uses.ts`."
        }
      ],
      "skos:notation": "uses-editorial-review",
      "dcterms:source": "cat-harness/skills/folio-core/uses-editorial-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/verify-local-substrate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "verify-local-substrate"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify that every result block of a designated class traces back to a designated anchor definition through the uses[] dependency graph. Identifies gaps where claims lack a formal connection to the anchor, and suggests fixes."
        }
      ],
      "skos:notation": "verify-local-substrate",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/verify-local-substrate.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/visual-diff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "visual-diff"
        }
      ],
      "skos:definition": [
        {
          "@value": "Pictures of a changed figure, diagram or table, before and after, and how much of it changed. Says when to use it, what the percentage means and must NOT be read as, what a missing picture means, and how the staging job and the review process call it. Use when a reviewer asks \"what does this figure look like now\", when a table's markup diff is unreadable, or when a staging preview's pictures are missing."
        }
      ],
      "skos:notation": "visual-diff",
      "dcterms:source": "cat-harness/skills/folio-core/visual-diff.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/vocabulary-authority",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "vocabulary-authority"
        }
      ],
      "skos:definition": [
        {
          "@value": "One vocabulary is authoritative for one kind of fact, and every other is a derived rendering reached by a declared mapping. Which vocabulary owns what here, the pros and cons behind each ruling, how DC and SKOS overlap and what stops them drifting, and the normalisation-first rule for any modelling or mapping exercise."
        }
      ],
      "skos:notation": "vocabulary-authority",
      "dcterms:source": "cat-harness/skills/folio-core/vocabulary-authority.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/voice-authoring-guidance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "voice-authoring-guidance"
        }
      ],
      "skos:definition": [
        {
          "@value": "Load the active voices' rules BEFORE writing, so a block is drafted in the register it will be reviewed against. The authoring half of the voice overlay; `voice-overlay-review` is the half that runs after."
        }
      ],
      "skos:notation": "voice-authoring-guidance",
      "dcterms:source": "cat-harness/skills/folio-core/voice-authoring-guidance.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/voice-editorial-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "voice-editorial-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Adjudicate a `voice-*` finding — read the flagged passage as a reader of THAT genre would and decide whether the register is wrong, the criterion is out of scope, or the block is a stated exception. The human/agent half of the voice QA axis; the mechanical half runs in `qa-checkers-voice.ts`."
        }
      ],
      "skos:notation": "voice-editorial-review",
      "dcterms:source": "cat-harness/skills/folio-core/voice-editorial-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/voice-overlay-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "voice-overlay-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review a block against the active voices' rules and record the verdict on its QA sidecar. The human/agent half of the voice overlay; the mechanical half is whatever `patterns` and `terminology` a rule carries."
        }
      ],
      "skos:notation": "voice-overlay-review",
      "dcterms:source": "cat-harness/skills/folio-core/voice-overlay-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "watch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Background-watch a branch (default origin/main) or a GitHub PR for new activity while you work, and on every event report whether to integrate / whether it conflicts with the current branch / whether it lets you simplify exposition / proofs / computations"
        }
      ],
      "skos:notation": "watch",
      "dcterms:source": "cat-harness/skills/folio-core/watch.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/where-a-proposal-goes",
      "@type": "skos:Concept",
