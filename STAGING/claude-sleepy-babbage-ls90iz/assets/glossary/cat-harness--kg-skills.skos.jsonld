      },
      "skos:prefLabel": [
        {
          "@value": "path-containment"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turning a value from outside into a path. The two different questions — a URL path versus a single identifier — why collapsing them is a defect, and the three sinks in this repository that had neither check."
        }
      ],
      "skos:notation": "path-containment",
      "dcterms:source": "cat-harness/skills/security/path-containment.md",
