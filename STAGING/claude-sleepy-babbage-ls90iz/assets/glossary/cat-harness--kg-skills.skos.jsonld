      },
      "skos:prefLabel": [
        {
          "@value": "proof-integration-watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Proof-QA integration watcher — watches origin/main + open active PRs + newly-opened PRs for narrative-proof (`.md`) or Lean-proof (`.lean`) changes, runs the proof QA skill suite on every detected change, queues gaps, attempts auto-discharge for easy sorries / naked conjectures with provable scaffolding, and escalates the rest to the author. Inherits shared mechanics (Monitor, subscriptions, queue, ledger, idle sweep, author-ask, watch-prepared-PRs, witness-drift recovery, billing-quick-fail flake, post-completion one-voice, sibling-PR comment protocol) from `local/integration-watcher`."
        }
      ],
      "skos:notation": "proof-integration-watcher",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/proof-integration-watcher.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/proof-narrative-lean-equivalence",
      "@type": "skos:Concept",
