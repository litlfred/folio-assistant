      },
      "skos:prefLabel": [
        {
          "@value": "skills-and-tools"
        }
      ],
      "skos:definition": [
        {
          "@value": "A skill states a capability generically; a Tool node carries the concrete mechanism. Read before writing or editing any skill, and whenever a skill is about to name a vendor, a CLI, a binary or an API endpoint."
        }
      ],
      "skos:notation": "skills-and-tools",
