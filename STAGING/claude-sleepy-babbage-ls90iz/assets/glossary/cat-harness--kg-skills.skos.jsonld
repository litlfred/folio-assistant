      },
      "skos:prefLabel": [
        {
          "@value": "skill-registration"
        }
      ],
      "skos:definition": [
        {
          "@value": "Adding a skill is never a one-file change. What a new skill file owes, the one command that performs the derived half, the one declaration it deliberately leaves to you, why running it once is not enough, and the two orphan directions it reports rather than fixes. Read this before adding, renaming or removing a skill."
        }
      ],
      "skos:notation": "skill-registration",
      "dcterms:source": "cat-harness/skills/folio-core/skill-registration.md",
      "skos:note": "candidate"
    },
    {
