      },
      "skos:prefLabel": [
        {
          "@value": "publish-verification"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify what a publish produced BEFORE it is deployed, and alert the publication manager whenever any step after the publish button fails — the verifier set, how to add a verifier, what is in scope, and how the publication manager triages the one alert."
        }
      ],
      "skos:notation": "publish-verification",
