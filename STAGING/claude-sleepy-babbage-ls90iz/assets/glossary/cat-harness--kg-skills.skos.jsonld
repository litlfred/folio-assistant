      },
      "skos:prefLabel": [
        {
          "@value": "paper-importer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Import external papers from PDF, LaTeX, or arXiv into the content object system. Scans for theorems, definitions, propositions, lemmas, and other formal environments. Generates .ts manifests and .md content files, optionally creates .lean stubs with sorry-bridged proofs citing the original source. Integrates with proof-writer skills so imported theorems can inform and accelerate formalization of the main paper."
        }
      ],
      "skos:notation": "paper-importer",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/paper-importer.md",
      "skos:note": "candidate"
    },
