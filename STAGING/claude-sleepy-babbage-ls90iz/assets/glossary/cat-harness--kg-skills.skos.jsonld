      },
      "skos:prefLabel": [
        {
          "@value": "proof-simplifier"
        }
      ],
      "skos:definition": [
        {
          "@value": "Analyse small clusters (2–4) of connected proofs to find simplifications: shared lemmas, redundant constructions, factored abstractions, or shorter proof paths through the dependency graph."
        }
      ],
      "skos:notation": "proof-simplifier",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/proof-simplifier.md",
