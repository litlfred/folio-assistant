      },
      "skos:prefLabel": [
        {
          "@value": "proof-gap-audit"
        }
      ],
      "skos:definition": [
        {
          "@value": "Audit individual proofs and the network of proofs for gaps. Detects intra-proof gaps (unproved assertions, existence without proof, uniqueness asserted but not shown, hand-waving, missing citations) and inter-proof gaps (missing bridging lemmas, broken chains of implication, unstated propositions needed to tie results together)."
        }
      ],
      "skos:notation": "proof-gap-audit",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/proof-gap-audit.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/proof-integration-watcher",
      "@type": "skos:Concept",
