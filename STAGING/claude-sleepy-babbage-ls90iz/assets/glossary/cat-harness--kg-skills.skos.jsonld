      "skos:definition": [
        {
          "@value": "Maintain the proof-objects.json manifest tracking formalization status, review records, and LaTeX-to-Lean linkages. Generate status dashboards and enforce review policies."
        }
      ],
      "skos:notation": "proof-status-tracking",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/proof-status-tracking.md",
