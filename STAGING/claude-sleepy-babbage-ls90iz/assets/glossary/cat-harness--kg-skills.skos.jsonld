      ],
      "skos:definition": [
        {
          "@value": "RACI over this repository's processes — who is Responsible, Accountable, Consulted and Informed for each activity. Three declared edge kinds over the roles and BPMN activities that already exist, not a new party registry. Use it to work out involvement when a project is initiated, and to sketch its breakdown."
        }
      ],
      "skos:notation": "raci",
      "dcterms:source": "cat-harness/skills/raci/raci.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/readability-editing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "readability-editing"
        }
      ],
      "skos:notation": "readability-editing",
      "dcterms:source": "cat-harness/skills/folio-core/readability-editing.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/readme-sections",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "readme-sections"
        }
      ],
      "skos:definition": [
        {
          "@value": "A folio's README is the author's file; the platform owns only the marked regions it generates. How the sync/audit split works, why the whole-file generator it replaced could not, and the third state both tools must report."
        }
      ],
      "skos:notation": "readme-sections",
      "dcterms:source": "cat-harness/skills/folio-core/readme-sections.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/related-work-coordination",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "related-work-coordination"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before new work takes shape, find the work it touches. Search beans, issues and open PRs for relevance; categorize and summarize every hit; then ask the user whether and how to coordinate. Judgement decides the categories and the recommendation, and the user decides the coordination. Called by CRDM when a requirement is initiated or updated in chat, and by methodology adoption. Process: processes/related-work.bpmn."
        }
      ],
      "skos:notation": "related-work-coordination",
      "dcterms:source": "cat-harness/skills/folio-core/related-work-coordination.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/release-epic-planning",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "release-epic-planning"
        }
      ],
      "skos:definition": [
        {
          "@value": "Plan and track releases using bean epics. Covers epic creation, story/task decomposition, release readiness tracking, and the relationship between epics and GitHub milestones. Applies to code releases, paper publications, and project milestones."
        }
      ],
      "skos:notation": "release-epic-planning",
      "dcterms:source": "cat-harness/skills/workflow/release-epic-planning.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/release-lifecycle",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "release-lifecycle"
        }
      ],
      "skos:definition": [
        {
          "@value": "Governs the release lifecycle: semver policy, draft/named releases, changelogs, release gating, and the relationship between feature branches, PRs, beans, and releases. Applies to code releases, paper publications, and project milestones. Complements package-release (which handles the mechanics of cutting a release) with the process and policy layer."
        }
      ],
      "skos:notation": "release-lifecycle",
      "dcterms:source": "cat-harness/skills/workflow/release-lifecycle.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/remark-audit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "remark-audit"
        }
      ],
      "skos:definition": [
        {
          "@value": "Audit remarks for provable content. Every remark must interpret a mathematical statement that can be formalized in Lean. Detects dangling remarks (no `interprets` link), ambiguous domain terms, and missing formalization."
        }
      ],
      "skos:notation": "remark-audit",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/remark-audit.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/render-logging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "render-logging"
        }
      ],
      "skos:definition": [
        {
          "@value": "Log every render to the publish branch — what was published, removed, restored or deliberately retained — to an append-only log that lives beside what it describes. Use when adding or removing anything on `gh-pages`, when asking \"what happened to this preview\", or before writing a workflow step that deletes a published artefact."
        }
      ],
      "skos:notation": "render-logging",
      "dcterms:source": "cat-harness/skills/folio-core/render-logging.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/render-order",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "render-order"
        }
      ],
      "skos:notation": "render-order",
      "dcterms:source": "cat-harness/skills/folio-core/render-order.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/rendered-verification",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "rendered-verification"
        }
      ],
      "skos:definition": [
        {
          "@value": "Confirm a UI change by LOOKING at it in a browser and sending the screenshots to the author, rather than describing it. Use whenever a change touches CSS, a Liquid/HTML template, a generated page, the navbar, a board, a sticky or any rendered surface — before claiming it works, and before asking the author to review it. Covers building the site locally, taking the REAL CI build off `gh-pages` when the question is theme chrome or layout, driving it with Playwright in this environment, measuring computed style rather than reading the stylesheet, hit-testing a control's centre because visible is not usable, asserting the conditions so a check cannot pass over an unstyled page, and the defect classes that are invisible to a green gate set."
        }
      ],
      "skos:notation": "rendered-verification",
      "dcterms:source": "cat-harness/skills/folio-core/rendered-verification.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/rendering-auditor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "rendering-auditor"
        }
      ],
      "skos:definition": [
        {
          "@value": "Multi-pass rendering auditor for content blocks. Validates markdown+TeX syntax, notation consistency, compilation, layout, and visual output across both HTML and PDF pipelines. Used by author agents after edits and as part of QC reports."
        }
      ],
      "skos:notation": "rendering-auditor",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/rendering-auditor.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/rendering-fixes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "rendering-fixes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Quick-fix reference for common rendering errors found by the rendering-auditor. Agents should consult this when editing content blocks to avoid introducing issues and to fix flagged problems efficiently."
        }
      ],
      "skos:notation": "rendering-fixes",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/rendering-fixes.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/repo-conversion",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "repo-conversion"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lay folio-assistant over a repository that already exists, without losing or silently moving what is in it. Scans the tree read-only, classifies candidate files into library (external source) and content (authored here) with an explicit third bucket for what it cannot classify, puts the three questions the scan cannot answer to the author as selections, and hands ingestion to one agent or a small swarm. Use when a user wants an existing repo converted to a folio, asks to import what is already there, or asks whether their PDFs/notes/drafts can come along."
        }
      ],
      "skos:notation": "repo-conversion",
      "dcterms:source": "cat-harness/skills/folio-core/repo-conversion.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/retry-backoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "retry-backoff"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every error gets a falling-off retry rate — each wait doubles, with jitter. Read before writing any call that can fail transiently, and before deciding that a failure is worth retrying at all. Exhausting the retries does not change the verdict."
        }
      ],
      "skos:notation": "retry-backoff",
      "dcterms:source": "cat-harness/skills/folio-core/retry-backoff.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/review-comments",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-comments"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reviewer comments on a folio's edit-set, from a tagged pull-request comment to a structured todo on the review page. Covers the tag a reviewer types, how the comments are ingested into `folio-review-comment/v1` todos, where the published `review-comments.json` comes from and when it refreshes, how a comment follows a renamed block and survives a removed one, who may change a comment's status, and how to change this process. Use when a reviewer asks how to comment on a block, when the review page shows no comments or a wrong one, when editing the ingestion, or when a folio's staging workflow is set up."
        }
      ],
      "skos:notation": "review-comments",
      "dcterms:source": "cat-harness/skills/folio-core/review-comments.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/review-heatmap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-heatmap"
        }
      ],
      "skos:definition": [
        {
          "@value": "The review page's heat map: a section-by-metric table that tells a reviewer of a large document where to look first. Says what each column MEANS and what it must NOT be read as, where each number comes from, what a column says when a build lacks its data, and how the colour was chosen. Use when a reviewer or author asks \"where do I start\", reads a number off the heat map, or asks why coverage or QA say \"no data\"; and before adding a column."
        }
      ],
      "skos:notation": "review-heatmap",
      "dcterms:source": "cat-harness/skills/folio-core/review-heatmap.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/role-model",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "role-model"
        }
      ],
      "skos:definition": [
        {
          "@value": "Actors, roles and skills — who performs a BPMN task, under which swimlane, with which skills. How a role's skill set is resolved through `inherits` and through a subprocess call chain, how a lane binds to a declared role, and how `kg:audit` finds a dangling skill, lane, role or decision."
        }
      ],
      "skos:notation": "role-model",
      "dcterms:source": "cat-harness/skills/folio-core/role-model.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/sample-import",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "sample-import"
        }
      ],
      "skos:definition": [
        {
          "@value": "Testing an import of a SAMPLE of a remote source into a knowledge graph or other structured store: scope it, let materialize-remote gate it, land it in the library (permanent) or the kept, unpublished trashcan (trial), import it, and test the import. The gates are called, never copied."
        }
      ],
      "skos:notation": "sample-import",
      "dcterms:source": "cat-harness/skills/content-lifecycle/sample-import.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/schema-management",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "schema-management"
        }
      ],
      "skos:definition": [
        {
          "@value": "Manage a schema over its life — add one, change one, read the schema graph and its viewer, and act on what the reader could not determine. The layout rule lives in `directory-conventions`; the entity question lives in `data-modelling`; this is the work in between."
        }
      ],
      "skos:notation": "schema-management",
      "dcterms:source": "cat-harness/skills/folio-core/schema-management.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/scientific-accuracy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "scientific-accuracy"
        }
      ],
      "skos:notation": "scientific-accuracy",
      "dcterms:source": "cat-harness/skills/folio-core/scientific-accuracy.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/scientific-critical-thinking",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "scientific-critical-thinking"
        }
      ],
      "skos:definition": [
        {
          "@value": "Evaluate scientific claims and evidence quality. Use for assessing experimental design validity, identifying biases and confounders, applying evidence grading frameworks (GRADE, Cochrane Risk of Bias), or teaching critical analysis. Best for understanding evidence quality, identifying flaws. For formal peer review writing use peer-review."
        }
      ],
      "skos:notation": "scientific-critical-thinking",
      "dcterms:source": "cat-harness/skills/scientific-critical-thinking/scientific-critical-thinking.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/scientific-visualization",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "scientific-visualization"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create and audit truthful, accessible, publication-ready scientific figures with Matplotlib, Seaborn, or Plotly. Use for figure design, multi-panel layouts, uncertainty and missing-data displays, color/contrast review, image metadata validation, and journal export planning."
        }
      ],
      "skos:notation": "scientific-visualization",
      "dcterms:source": "cat-harness/skills/scientific-visualization/scientific-visualization.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/security",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "security"
        }
      ],
      "skos:definition": [
        {
          "@value": "The security sub-KG's entry point. What the boundaries are, which machinery already guards each one, and the single rule that unifies them — refuse, never repair. Read this before adding a check, so the answer that already exists is reused rather than rebuilt in a fourth place."
        }
      ],
      "skos:notation": "security",
      "dcterms:source": "cat-harness/skills/security/security.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/semantic-review-scoping",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "semantic-review-scoping"
        }
      ],
      "skos:definition": [
        {
          "@value": "Decide what to review FIRST. Computes which blocks' semantic correctness can actually affect a target theorem, so agent-adjudicated criteria are spent where they matter instead of swept in file order."
        }
      ],
      "skos:notation": "semantic-review-scoping",
      "dcterms:source": "cat-harness/skills/folio-paper-adapter/semantic-review-scoping.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/serving-renderings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "serving-renderings"
        }
      ],
      "skos:notation": "serving-renderings",
      "dcterms:source": "cat-harness/skills/folio-core/serving-renderings.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/session-context",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "session-context"
        }
      ],
      "skos:definition": [
        {
          "@value": "What a state machine tracks across a session, as against one process instance. What the record carries, why `actor` is required and the rest are not, why the session's view of a node is advisory, and what a sibling session reads it for."
        }
      ],
      "skos:notation": "session-context",
      "dcterms:source": "cat-harness/skills/workflow/session-context.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/session-intent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "session-intent"
        }
      ],
      "skos:definition": [
        {
          "@value": "Session-start intent declaration + session-end results recording, against the goal-scoped master ledger and queue file. Enforces the durable-handoff discipline so any agent can pick up another's thread."
        }
      ],
      "skos:notation": "session-intent",
      "dcterms:source": "cat-harness/skills/folio-core/session-intent.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills/session-state-machine",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "session-state-machine"
        }
      ],
      "skos:definition": [
        {
          "@value": "An agent PLAYING a state machine rather than an engine executing one. Where the non-determinism actually lives, why the diagram stays strict, the `cat-harness.processes:judgement` marker that makes a judgement point countable, and what the machine must never do on the actor's behalf."
        }
      ],
      "skos:notation": "session-state-machine",
