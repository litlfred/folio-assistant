      "type": "string",
      "enum": [
        "tactic",
        "term",
        "mixed"
      ],
      "default": "tactic",
      "description": "Preferred proof style."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lean package dependencies (lake packages)."
    }
  },
