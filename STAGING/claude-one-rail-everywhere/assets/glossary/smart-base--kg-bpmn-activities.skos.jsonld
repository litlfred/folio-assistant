      },
      "skos:prefLabel": [
        {
          "@value": "Verify automated publication workflow succeeded"
        }
      ],
      "skos:notation": "Task_VerifyAutomation",
      "dcterms:source": "smart-base/processes/content/SGAuthoring.DAKLifecycle.bpmn#Task_VerifyAutomation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_planning.task_verifyl2input",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify L2 input availability and consistency"
        }
      ],
      "skos:notation": "Task_VerifyL2Input",
      "dcterms:source": "smart-base/processes/content/SGAuthoring.DAKLifecycle.bpmn#Task_VerifyL2Input",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_adjapp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the L4 wireframes and application"
        }
      ],
      "skos:definition": [
        {
          "@value": "Business analyst and clinical SME walk it through each L2 user scenario; FHIR modeller checks L3 conformance."
        }
      ],
      "skos:notation": "Task_AdjApp",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_AdjApp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_adjdepsl2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate L2 dependencies"
        }
      ],
      "skos:definition": [
        {
          "@value": "Programme manager and business analyst: one row per candidate DAK, rejected ones included."
        }
      ],
      "skos:notation": "Task_AdjDepsL2",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_AdjDepsL2",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_adjdepsl3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate L3 dependencies"
        }
      ],
      "skos:definition": [
        {
          "@value": "FHIR modeller and terminologist: one row per candidate IG, rejected ones included."
        }
      ],
      "skos:notation": "Task_AdjDepsL3",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_AdjDepsL3",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_adjkg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the L1 KG"
        }
      ],
      "skos:definition": [
        {
          "@value": "l1-extraction-reviewer signs exclusions and coverage; Clinical SME reviews recommendations beside the printed page."
        }
      ],
      "skos:notation": "Task_AdjKg",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_AdjKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_adjl1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the L1 source list"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clinical SME: each source with why it was included or left out."
        }
      ],
      "skos:notation": "Task_AdjL1",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_AdjL1",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_adjl2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review each L2 asset (before / after if adapted)"
        }
      ],
      "skos:definition": [
        {
          "@value": "One review item per created or changed asset, shown as its reviewer reads it (diagram, table, data-dictionary rows); each form's wireframe candidates are reviewed blind and one is chosen (Process_Adjudication, Process_OptionsAnalysis); an adapted asset as a diff against its pinned upstream. For each L2 component this is the review that forks inside its own edit-and-review subprocess (l2-component-edit-review.bpmn, called by every l2-dak-authoring.bpmn track), with the renderer, checker and reviewing role that skill tables."
        }
      ],
      "skos:notation": "Task_AdjL2",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_AdjL2",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_adjl3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review each L3 asset (before / after if adapted)"
        }
      ],
      "skos:definition": [
        {
          "@value": "One review item per created or changed resource: differential, each Questionnaire against the L2 wireframe it was derived from (field to item: fhir-harness fhir-questionnaire-wireframe, whose check is check-wireframe-questionnaire), CQL beside its DMN rule with test results, terminology expansions."
        }
      ],
      "skos:notation": "Task_AdjL3",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_AdjL3",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_buildapp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "8b · L4: build the consuming application"
        }
      ],
      "skos:definition": [
        {
          "@value": "Against the stage-6 IG build, with conformance tests from the IG's examples and test cases."
        }
      ],
      "skos:notation": "Task_BuildApp",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_BuildApp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_depsl2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "3 · Choose L2 dependencies (WHO / jurisdiction DAKs)"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the L1 KG: which existing DAKs to reuse, adapt, extend or reject, each with evidence and reason. Reuse first; prefer the jurisdiction's adaptation, recording the WHO original as its upstream."
        }
      ],
      "skos:notation": "Task_DepsL2",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_DepsL2",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_depsl3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "5 · Choose L3 dependencies (WHO / jurisdiction IGs) [ig-artifact-ingestion]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Index each candidate IG, then match the L1 KG and the L2 assets against it: reuse, adapt, extend or reject per IG."
        }
      ],
      "skos:notation": "Task_DepsL3",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_DepsL3",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_describeapp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "7 · L4: describe the consuming application"
        }
      ],
      "skos:definition": [
        {
          "@value": "Who uses it, on what device, which L2 processes and L3 resources it covers, connectivity, the systems it talks to. The agent offers options drawn from the L2 personas and processes. This is the written intent wireframe-design-review starts from."
        }
      ],
      "skos:notation": "Task_DescribeApp",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_DescribeApp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_describeusecase",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "0 · Describe the use case"
        }
      ],
      "skos:definition": [
        {
          "@value": "Population, setting, jurisdiction, interventions in scope. The user's own words; the agent asks a numbered question if the request did not say."
        }
      ],
      "skos:notation": "Task_DescribeUseCase",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_DescribeUseCase",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_identifyl1",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "1 · Identify L1 guidelines and recommendations [dak-l1-library]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 1 sources of any DAK already in scope first, then WHO IRIS and the jurisdiction's own guidelines. Each candidate marked in-library / in-KG / not yet."
        }
      ],
      "skos:notation": "Task_IdentifyL1",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_IdentifyL1",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_ingestkg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2 · Ingest into the L1 KG [dak-l1-library · recommendation-extraction]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Per source not yet extracted: cat ingest into library/, the generic-document layer (l1-library), then the L1 layer (recommendations, remarks, practices, scenario candidates) into library/<bib>/l1-extraction/."
        }
      ],
      "skos:notation": "Task_IngestKg",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_IngestKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_l2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "4 · Create / adapt L2 DAK assets [l2-dak-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The authoring steps of l2-dak-authoring.bpmn (personas and scenarios, BPMN, DMN, data dictionary, indicators and requirements, terminology), plus the design of each data-entry form as wireframe candidates (wireframe-design-review, design use) from the persona, the user scenario and the core data elements. Its clinical validation is this stage's adjudication and does not hold up stage 5. The IG is built through fhir-harness's AST cache lifecycle (ig-ast-refresh.yml), with the DAK pre-processing as smart-base's pre-export overlay (dak-preprocessing, dak-pre-export.sh) and the DAK sidecars made from the AST (dak-postprocessing)."
        }
      ],
      "skos:notation": "Task_L2",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_L2",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_l3",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "6 · Produce L3 assets [l3-fhir-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The mapping and pipeline of dak-l3-ig.bpmn, up to a clean IG build. Each Questionnaire is derived from the chosen L2 wireframe of its form. Publication continues in that process and is not on the path to stage 8."
        }
      ],
      "skos:notation": "Task_L3",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_L3",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities/process_sgendtoend.task_wireframeapp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "8a · L4: wireframe the application [wireframe-design-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "To-be mode, from the stage-7 intent: two or more candidates, web and mobile, with real content from the L2 personas and scenarios. The agent goes on with its recommended candidate; the requester may choose another during adjudication."
        }
      ],
      "skos:notation": "Task_WireframeApp",
      "dcterms:source": "smart-base/processes/content/smart-guideline-end-to-end.bpmn#Task_WireframeApp",
      "skos:note": "candidate"
    }
  ]
}
