      "skos:prefLabel": [
        {
          "@value": "Assemble and validate the DAK [content-validate]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assemble the validated components and run content validation: schemas, cross-component consistency and terminology bindings. The smart-base extractors read the authored artefacts; with SMART_BASE_HOME unset they report skip, never a clean run."
        }
      ],
      "skos:notation": "Task_AssembleDak",
