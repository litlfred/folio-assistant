          "@value": "Create example resources per UN language"
        }
      ],
      "skos:notation": "Task_TranslateExamples",
      "dcterms:source": "smart-base/processes/content/SGAuthoring.DAKLifecycle.bpmn#Task_TranslateExamples",
      "skos:note": "candidate"
    },
