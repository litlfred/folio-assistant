{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Complete SDC Questionnaire Output",
  "description": "The completed response, and what the form filler raised.",
  "type": "object",
  "required": [
    "questionnaireResponse"
  ],
  "properties": {
    "questionnaireResponse": {
      "type": "object",
      "required": [
        "resourceType"
      ],
      "properties": {
        "resourceType": {
          "const": "QuestionnaireResponse"
        },
        "questionnaire": {
          "type": "string",
          "description": "The Questionnaire's canonical, url|version."
        },
        "status": {
          "enum": [
            "in-progress",
            "completed",
            "amended",
            "entered-in-error",
            "stopped"
          ]
        }
      },
      "description": "The FHIR R4 QuestionnaireResponse (https://hl7.org/fhir/R4/questionnaireresponse.html): completed, or in-progress when saved unfinished."
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "message"
        ],
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning",
              "information"
            ]
          },
          "linkId": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "description": "What the form filler raised that the person left; only for a response saved in-progress."
    }
  },
  "additionalProperties": false,
  "$id": "http://smart.who.int/base/schema/skills/complete-sdc-questionnaire/output.schema.json",
  "staging": {
    "branch": "repin-train/20261108-0044",
    "sha": "f9ee0621f98e1874dd63768a76b3afa9650020dd",
    "pr": "repin-train/20261108-0044",
    "run": "42431204560"
  }
}
