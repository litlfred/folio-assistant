{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Client History Input",
  "type": "object",
  "required": [
    "records"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "description": "A FHIR R4 Reference.",
      "properties": {
        "reference": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      }
    },
    "purpose": {
      "type": "string"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provenance"
        ],
        "properties": {
          "resource": {
            "type": "object",
            "description": "A FHIR R4 resource (e.g. an IPS Bundle, an Immunization, an AllergyIntolerance)."
          },
          "summary": {
            "type": "string",
            "description": "For a paper record or the client's word: what it says."
          },
          "provenance": {
            "enum": [
              "verified",
              "unverified",
              "reported"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
