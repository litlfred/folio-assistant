      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/tools/c-value-terms.jsonld",
      "@type": "cat-harness:Tool",
      "description": "The scoring step of the `automatic-term-extraction` method: count the word n-grams of one or more Markdown or text files (not across punctuation, front matter or code), and rank them by C-value as Frantzi & Ananiadou 1996 define it, so nested multi-word terms are not swamped by the longer phrases that contain them. Tested against the paper's own worked example (Table 2). Every row is a candidate; it writes nothing and promotes nothing.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-core/scripts/c-value.ts"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "One or more Markdown or text files whose prose is read.",
            "name": "files",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--max-length"
            },
            "description": "Longest n-gram, in words; 1 or more. Default 5.",
            "name": "maxLength",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "arg": {
              "flag": "--min-freq"
            },
            "description": "Fewest occurrences an n-gram needs to be scored. Default 3, the paper's cut-off; 1 or more.",
            "name": "minFreq",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "arg": {
              "flag": "--top"
            },
            "description": "How many candidates to print; 1 or more. Default 50.",
            "name": "top",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "arg": {
              "flag": "--edge-stopwords"
            },
            "description": "Drop n-grams that begin or end with a common English function word. Off by default, because the 1996 method has no such filter.",
            "name": "edgeStopwords",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "description": "Print the candidates as JSON, each with its frequency, nesting counts and C-value.",
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "A ranked table, or JSON with `status: candidate`, of n-grams with a C-value above 0.",
            "name": "candidates",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "c-value-terms",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": [
        "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/glossary-terms",
        "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/ontologist"
      ],
      "title": "Rank candidate glossary terms in prose by C-value"
    }
  ],
