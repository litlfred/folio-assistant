{
  "@context": "https://litlfred.github.io/folio-assistant/ns/subgraph/v1.jsonld",
  "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/web-app-build/",
  "@type": "bootstrap:Subgraph",
  "_generated": "gen-subgraph-jsonld.ts — do not hand-edit; run `bun run cat subgraph:jsonld`",
  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/web-app-build.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Build every declared `web-app` directory in the checkout and publish each at its own route, `<locale>/<harness>/apps/<id>/`, with no site chrome (every page marked `folio-navbar: none`), plus an `apps/` index in the site's chrome listing each app with its languages and size. Before building, each locale's translated UI strings are written from the layer's `translations/<locale>/apps/<id>.po` to the app's `i18n.out`, so building is the injection. `--extract` writes the translation templates; `--check` validates the declarations and translations and builds nothing.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat web-apps:build"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--check"
            },
            "description": "Validate every declaration (manifest, build script, lockfile, route clashes) and translation (templates current, placeholders kept, no stale entries); build nothing.",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--extract"
            },
            "description": "Write each app's translation templates, `translations/<locale>/apps/<id>.pot`, in the declaring layer: the app's \"refresh the templates\" step of the translation process.",
            "name": "extract",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--site"
            },
            "description": "A site being built: write the apps and the index at their declared route under it instead of under the harness's own site directory.",
            "name": "site",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "Each app's build under `<locale>/<harness>/apps/<id>/`, and the index page at `<locale>/<harness>/apps/`.",
            "name": "pages",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "web-app-build",
      "requirements": {
        "network": true,
        "runtime": [
          "bun",
          "node"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/graph-rendering",
      "title": "Web app build"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/web-app-build",
  "path": "tools/web-app-build/"
}
