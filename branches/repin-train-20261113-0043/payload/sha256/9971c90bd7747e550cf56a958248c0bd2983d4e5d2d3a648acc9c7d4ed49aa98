      ],
      "kind": "prose",
      "title": "Introduction",
      "pageStart": 7,
      "pageEnd": 7,
      "target": "../sections/sec-000-introduction.md",
      "narrative": null,
      "content": "cer. In particular, it highlights the contributions that\nnational immunization programmes, sexual and\nreproductive health programmes, and cancer con-\ntrol programmes can make in preparing for national\nintroduction of the vaccines in the context of the\nGlobal Immunization Vision and Strategy.",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Explains that the guidance highlights how immunization, sexual and reproductive health and cancer control programmes can prepare for national HPV vaccine introduction under the Global Immunization Vision and Strategy.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
