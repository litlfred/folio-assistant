      "narrative": null,
      "content": "CONSTRAINTS AND RECOMMENDATIONS TO OVERCOME THEM\nConstraints and \nrecommendations to \novercome them\n7 \n7.1",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "A section heading on constraints and recommendations to overcome them.",
