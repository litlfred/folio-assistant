      "target": "../sections/sec-020-6-directions-suggested-by-epidemiological-modell.md",
      "narrative": null,
      "content": "DIRECTIONS SUGGESTED BY EPIDEMIOLOGICAL MODELLING\nDirections suggested by \nepidemiological modelling\n6 \n6.1",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "A section heading on directions suggested by epidemiological modelling.",
        "state": "draft",
        "draftedBy": {
