    {
      "id": "library/10665-67839/blocks/prose-sec-003",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "New developments",
      "pageStart": 12,
      "pageEnd": 12,
      "target": "../sections/sec-003-12-new-developments.md",
      "narrative": null,
      "content": "The secretariat managed the following developments between the first\nand the second WG meetings.\n• The Strategic Framework to Decrease the Burden of TB/HIV was published and \ndisseminated. Two WHO regional offices (EURO and WPRO) have made \nprogress in adapting the framework for their regions. \n• The Scientific Panel of the WG prepared guidelines for implementing \ncollaborative TB and HIV programme activities. These were presented to the \nsecond WG meeting at second-draft stage.\n• In February 2002 a protocol development workshop was held in Nairobi, where \neight countries (four from the origin",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Lists developments since the first meeting, such as publication of the Strategic Framework, draft guidelines on collaborative activities, a protocol workshop in Nairobi, TB modelling work, a new core group and updated estimates of HIV-associated TB.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
