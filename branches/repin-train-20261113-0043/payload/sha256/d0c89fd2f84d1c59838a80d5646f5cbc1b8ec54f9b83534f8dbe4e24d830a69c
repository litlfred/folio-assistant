    {
      "id": "library/10665-94830/blocks/prose-sec-004",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Executive summary",
      "pageStart": 14,
      "pageEnd": 16,
      "target": "../sections/sec-004-executive-summary.md",
      "narrative": null,
      "content": "Cervical intraepithelial neoplasia (CIN) is a premalignant lesion that may exist at any one of three \nstages: CIN1, CIN2, or CIN3. If left untreated, CIN2 or CIN3 (collectively referred to as CIN2+) \ncan progress to cervical cancer. Instead of screening and diagnosis by the standard sequence \nof cytology, colposcopy, biopsy, and histological confirmation of CIN, an alternative method is to \nuse a ‘screen-and-treat’ approach in which the treatment decision is based on a screening test \nand treatment is provided soon or, ideally, immediately after a positive screening test. Available \nscreening",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Explains that untreated CIN2 or CIN3 lesions can progress to cervical cancer and describes the screen-and-treat approach, in which treatment follows soon after a positive screening test. It names the available screening tests (HPV test, VIA, cytology) and treatments (cryotherapy, LEEP, cold knife conization), and notes the guideline builds on earlier WHO guidance. It ends with research priorities and states that the recommendations apply to all women, with specific ones for women living with HIV.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
