      "content": "followed the WHO handbook for guideline \ndevelopment (11, 12).",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "A fragment stating that development followed the WHO handbook for guideline development.",
