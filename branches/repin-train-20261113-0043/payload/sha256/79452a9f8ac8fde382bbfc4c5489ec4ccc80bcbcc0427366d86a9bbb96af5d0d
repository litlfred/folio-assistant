    {
      "id": "library/10665-311941/blocks/prose-sec-022",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Presentation of the guideline",
      "pageStart": 56,
      "pageEnd": 57,
      "target": "../sections/sec-022-29-presentation-of-the-guideline.md",
      "narrative": null,
      "content": "The recommendations are presented in the executive summary of this guideline. For each \nrecommendation, a summary of the evidence is given in Chapter 3 on the positive and negative \neffects of the intervention, its acceptability and feasibility, the equity, gender and human rights \nimpacts, resource use, and on any other considerations reviewed at the GDG meeting. The \nlanguage that was used to interpret the evidence on effects is consistent with the approach \nrecommended by the Cochrane EPOC Group (42). Where the WHO steering group identified any \nexisting WHO recommendations relevant to this",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Explains that recommendations appear in the executive summary, with evidence summaries in Chapter 3, and that relevant existing WHO recommendations are quoted exactly with added remarks where needed.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
