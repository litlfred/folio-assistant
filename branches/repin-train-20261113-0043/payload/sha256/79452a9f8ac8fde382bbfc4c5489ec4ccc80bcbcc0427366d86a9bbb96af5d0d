    {
      "id": "library/10665-311941/blocks/prose-sec-018",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Roles and responsibilities of contributors",
      "pageStart": 50,
      "pageEnd": 52,
      "target": "../sections/sec-018-25-roles-and-responsibilities-of-contributors.md",
      "narrative": null,
      "content": "The guideline development process was guided by the WHO steering group, the technical team, \nthe GDG, the external review group, and external partners and observers (see Annex 3 for the list of \ncontributors in these main groups). An advisory group representing global experts also contributed \nto the guideline development process prior to establishing the formal GDG. \nWHO steering group\nThe WHO steering group comprised WHO staff members and consultants representing WHO \nregional offices, and WHO departments, including the following (in alphabetical order): \nȺȺ Alliance for Health Policy and Sy",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Sets out the roles of the groups that guided guideline development, including the WHO steering group drawn from many departments, the technical team of methodologists, the guideline development group and the external review group. It describes how members were chosen for geographical and gender balance. It also explains how declarations of interest were collected and managed, with biographies posted on the WHO website.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
    },
    {
      "id": "library/10665-311941/blocks/prose-sec-019",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Consolidation of evidence",
      "pageStart": 52,
      "pageEnd": 53,
      "target": "../sections/sec-019-26-consolidation-of-evidence.md",
      "narrative": null,
      "content": "The technical team supervised and finalized the preparation of the evidence profiles and evidence \nsummaries. These were then consolidated into an evidence-to-decision framework for each \nguideline question. The evidence-to-decision frameworks (see Web Supplement 1) provided \nexplicit and systematic presentations of the evidence for each question on the following criteria.\nȺȺ Effectiveness – the evidence on the critical outcomes was summarized to answer the \nquestions: “What are the desirable and undesirable effects of the intervention/option?” and \n“What is the certainty of the evidence on ef",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Explains how evidence profiles were consolidated into evidence-to-decision frameworks covering effectiveness, acceptability, feasibility, resource use, and gender, equity and rights. Judgements on these criteria guided the guideline development group's decisions.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
