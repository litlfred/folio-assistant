    {
      "id": "library/10665-311941/blocks/prose-sec-038",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Overarching research gaps",
      "pageStart": 110,
      "pageEnd": 112,
      "target": "../sections/sec-038-51-overarching-research-gaps.md",
      "narrative": null,
      "content": "Overarching research gaps\nThe following sections describe the overarching research priorities identified through this \nguideline process. These reflect the general areas in which the available evidence was found \nto be of low or very low certainty or confidence, or where no direct evidence was identified. \nWhere studies were available, in some cases the certainty or confidence of the evidence was \naffected by poor reporting of outcomes, studies with small numbers of participants, and limited \nrepresentation across different settings. \nAnnex 5 maps the state of evidence and its gaps based on th",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Describes overarching research gaps found during guideline development, where evidence was of low or very low certainty or absent, often owing to poor reporting, small studies and limited settings. It calls for future research on health system process improvements, resource use and equity effects. It also raises questions on implementing interventions faithfully at scale and suggests frameworks such as RE-AIM to structure implementation research.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
