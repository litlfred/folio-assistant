        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log a message or an error",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write a message or error entry whenever a later reader would need it. A command run goes in `execution` (command, exit code, where output went) — never the output itself, and never a secret, token or credential: capture on puts entries in git.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_LogMessage",
      "dcterms:source": "cat-harness/sdlc/processes/activity-log.bpmn#A_LogMessage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_activitylog.a_logstart",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log task-start",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write a task-start entry before touching anything: summary, actor, and the process/task/bean/branch/session it belongs to where they exist. role, process and task are optional on purpose — do not invent a lane for work done outside a process.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_LogStart",
      "dcterms:source": "cat-harness/sdlc/processes/activity-log.bpmn#A_LogStart",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_activitylog.a_persistlog",
