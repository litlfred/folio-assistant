      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or close a role to an actor",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The join every other diagram depends on. An empty `roles` is a DETERMINED empty — it says the actor takes on none — and is not the same as an absent one, which asserts nothing.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AssignRoles",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_AssignRoles",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.task_grantorrevoke",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grant or revoke a permission",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A permission travels with the PARTICIPANT and cross-cuts every lane, so unlike a role it cannot be scoped by the diagram it is used in. Granting one is a standing decision, which is why this lane is person-only and why the log capture on this process is on.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_GrantOrRevoke",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_GrantOrRevoke",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.task_retireactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retire an actor — never delete one",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An actor id is referenced from roles, diagrams, beans and commits, so removing the file leaves every one of those unable to tell retirement from accident. Same rule, and the same reason, as a scrapped bean.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RetireActor",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_RetireActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_actorroleadministration.task_runkgaudit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Audit the graph",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "AFTER the change, not before. Every criterion here is a join — role to lane, actor to role, activity to skill — so what an administrative edit breaks is not in the file it edited. The sidecars under `test/results/kg-qa/` are committed for the reason a printed verdict is not: without them, \"unbound since it was drawn\" and \"broken by this change\" are indistinguishable. Runs `kg:audit`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RunKgAudit",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_RunKgAudit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_adjudication.a_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the disagreement",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The judgement itself, and the one step nothing here can check: if a mechanism could decide it, the process would not have been entered. It declares NO `cat-harness.processes:adjudication codes` on purpose, and that absence is the whole of bean `bvuk`. This step used to name three — stands, scope, dispensation — and six diagrams called it: `review-narrative` and `voice-review`, whose question those three answer, and four whose question they do not. `refresh-materialized` asks which side wins a local-vs-remote conflict; there is no criterion to scope there and no dispensation to grant, yet the outcome half ran regardless. Since the caller's question decides the permitted answers, the caller declares them: `cat-harness.processes:adjudication codes` on its OWN call activity, with its own gateway acting on them. `criterion-adjudication.bpmn` is that for the QA-criterion question. What could NOT be fixed by passing the codes as data, which was this bean's first recommendation: the three branches ran three different TASKS, so a caller handed `local-wins` would have had it pointing at `A_ScopeCriterion`. The branches had to move, not the enum.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Adjudicate",
      "dcterms:source": "cat-harness/processes/process/adjudication.bpmn#A_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_adjudication.a_dispatch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dispatch with adjudicator_sees — never the artefact",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`UntaintedDispatch` on the criterion declares what each party is given; the caller names a subject and a criterion and does not hand-assemble a brief, because the party composing a brief by hand is the producer. `untaintedPartitionDefects` reports `overlap` when the checker and the adjudicator can read the same file — one of them is then grading its own input, and the verdict measures nothing while raising no error.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Dispatch",
      "dcterms:source": "cat-harness/processes/process/adjudication.bpmn#A_Dispatch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_adjudication.a_statefinding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "State the finding and what it read",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each provider says what it found and on what evidence. A finding that does not show what it read is an opinion, and an adjudicator cannot tell it from a finding about some other version of the block.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_StateFinding",
      "dcterms:source": "cat-harness/processes/process/adjudication.bpmn#A_StateFinding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_archimatepublish.a_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the model parses and resolves",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `archimate-check` (`archimate:validate`, on the layer root): every model the config names is held and parses, every box in every view draws an element the model holds, every relationship's ends are in the model.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Check",
      "dcterms:source": "cat-harness/processes/ui/archimate-publish.bpmn#A_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_archimatepublish.a_fixmodel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix the relationship in Archi",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The author changes the relationship's type or ends in Archi and commits the model again. The pipeline never rewrites a model.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_FixModel",
      "dcterms:source": "cat-harness/processes/ui/archimate-publish.bpmn#A_FixModel",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_archimatepublish.a_metamodel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Derive the metamodel in use",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `archimate-metamodel` (`archimate:metamodel --check`, on the layer root): the element types the model uses and every (source type, relationship, target type) pattern, each checked against ArchiMate's relationship table. Placeholder elements named after their own type are reported, never fatal: removing them is the author's call.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Metamodel",
      "dcterms:source": "cat-harness/processes/ui/archimate-publish.bpmn#A_Metamodel",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_archimatepublish.a_pages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write pages, drawings and the metamodel page",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `archimate-pages` (`archimate:pages --out`, into the site being built): a JSON-LD node and a thin page for every view, element and relationship, every view drawn as SVG, and each model's \"Metamodel in use\" page with its diagram laid out from DOT by Graphviz in WebAssembly, plus the same diagram as DOT, Mermaid and JSON.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Pages",
      "dcterms:source": "cat-harness/processes/ui/archimate-publish.bpmn#A_Pages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_asktheperson.a_compose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compose the full question",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What is being decided, stated as what will differ; every id, path and coined name glossed; every option with its letter, a one-line explanation and its trade-off; the recommendation, first and marked; what will happen if no answer comes. Can the reader answer without opening anything? If not, it is not ready. More than one decision open: ask the next one in full and give a count for the rest.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Compose",
      "dcterms:source": "cat-harness/processes/process/ask-the-person.bpmn#A_Compose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_asktheperson.a_handback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand back to the discussion",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The composed question goes, unchanged, to the discussion agent, which asks it through this same process on its `yes` branch and routes the answer back: the sibling's half of `Process_HandBackToDiscussion` (a task here, not a call, because that process calls this one). The sibling also shows it in its own thread, never only there.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_HandBack",
      "dcterms:source": "cat-harness/processes/process/ask-the-person.bpmn#A_HandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_asktheperson.call_discuss",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Discuss it with the person",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bootstrap's human-agent discussion, given the composed question. Its `Ask ONE question` step is where this harness's delivery rule applies: Post the whole composed question as ordinary chat text BEFORE any card. This is the copy that survives: a card, once answered, shows only the chosen option, and a dismissed card shows nothing. Never \"see the card\", never a request for a typed reply such as \"1y 2n\". Then the card: Whatever the host calls its selection tool (`AskUserQuestion`, `request_decision`, a button card): the same letters and labels as the chat text, the recommended option marked. No host card tool: say so in the chat and keep each answer to one short choice. Its answer step: One tap on the card, or any answer the person prefers to give. Free text is always available and never required. A dismissal is NOT an answer and never selects the default as a choice; the question stays open in the chat. On an answer: Hand the answer back to the calling step, quoted. If it settles how a kind of thing is decided, it is a rule: write it into the governing skill in the same turn. On no answer: Do what the question said would happen with no answer, and say so. Nothing irreversible proceeds on a default: such a step waits for the person.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Discuss",
      "dcterms:source": "cat-harness/processes/process/ask-the-person.bpmn#Call_Discuss",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanclose.close_archive",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Archive the bean (completed or scrapped)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Move the bean, now completed or scrapped, into the archive, with a line saying which process closed it. A bean still open stays where it is with a note saying why: only a completed or scrapped bean may be archived (check:bean-archive), and only once the calling process has finished. The periodic sweep (`beans archive`) still archives anything this step leaves — it stays the floor, this op the exception (`todo-manager` § Archiving). The owner's 2026-10-20 ruling keeps archive a per-activity op; this is that activity, shared by both terminal outcomes and by every caller.",
          "@language": "en"
        }
      ],
      "skos:notation": "Close_Archive",
      "dcterms:source": "cat-harness/sdlc/processes/bean-close.bpmn#Close_Archive",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanclose.close_complete",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Complete (no unchecked todos left)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once nothing is unchecked, and with a summary of what changed. The engine's `resolve` completes a bean only after the instance itself has completed, or has nothing left but archive steps — whether work is done is a judgement, and a bean is not closed on someone else's say-so. The only `resolve` op in the corpus (`check:bean-calls`).",
          "@language": "en"
        }
      ],
      "skos:notation": "Close_Complete",
      "dcterms:source": "cat-harness/sdlc/processes/bean-close.bpmn#Close_Complete",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanclose.close_recordblocker",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the blocker and hand back",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Blocked is not scrapped. Set `--blocked-by`, say in the body what would unblock it, and return it to `todo` so it is visible to whoever can act. An in-progress bean nobody is progressing reads as active work. Not archived: the work is still wanted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Close_RecordBlocker",
      "dcterms:source": "cat-harness/sdlc/processes/bean-close.bpmn#Close_RecordBlocker",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanclose.close_scrap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scrap with reasons NEVER delete",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`status: scrapped`, plus a \"Reasons for Scrapping\" section. This is what \"disable\" means here — the CLI has no disabled state; its vocabulary is draft, todo, in-progress, completed, scrapped. The agent's own `beans update`; the engine has no scrap op. DELETION IS NEVER THE ANSWER, even though `beans delete` exists. A scrapped bean records that the work was considered and rejected, and why; a deleted one leaves a sibling session unable to tell abandonment from accident, and leaves the next agent free to re-open the same dead end.",
          "@language": "en"
        }
      ],
      "skos:notation": "Close_Scrap",
      "dcterms:source": "cat-harness/sdlc/processes/bean-close.bpmn#Close_Scrap",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beandrain.drain_buildqueue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the queue, grouped by owner",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read every bean copy, not only the one this checkout mounts; where copies disagree the newest `updated_at` wins and the disagreement is listed. Leave out goals and epics, blocked beans, closed or draft ones, owner-held or parked ones, and beans the drainers cannot reach — each with its reason, so nothing vanishes silently. Group the rest by owner in priority order, mark beans other agents hold as skip, and write one shared queue file. The `drain-queue` Tool (bean n7x7) builds this; until it is defined, the step is the skill's.",
          "@language": "en"
        }
      ],
      "skos:notation": "Drain_BuildQueue",
      "dcterms:source": "cat-harness/sdlc/processes/bean-drain.bpmn#Drain_BuildQueue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beandrain.drain_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanClose on the bean just worked: complete and archive it on evidence, scrap it with its reasons, or record its blocker and hand it back to `todo`. On every bean copy. More of the drain follows, so on the drain's own bean the engine notes rather than resolves (see the process comment); then the drainer takes the next bean.",
          "@language": "en"
        }
      ],
      "skos:notation": "Drain_Close",
      "dcterms:source": "cat-harness/sdlc/processes/bean-drain.bpmn#Drain_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beandrain.drain_open",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanOpen on the bean just taken: check it, find out whose it is, and claim it — or leave it alone when another agent holds it. OPEN's check is where the drain's claim check runs (the `bean-claim-check` Tool, bean n7x7): recent commits on every bean copy and any open PR naming the bean, before the claim. The gateway after this reads which end OPEN reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Drain_Open",
      "dcterms:source": "cat-harness/sdlc/processes/bean-drain.bpmn#Drain_Open",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beandrain.drain_refill",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refill from the deepest queue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Refresh the queue file from every bean copy — beans closed, claimed or unblocked since it was built change it — and move beans from the deepest owner's list to the drainer that ran dry. The `drain-queue` Tool (bean n7x7) rebuilds the queue; until it is defined, the step is the skill's.",
          "@language": "en"
        }
      ],
      "skos:notation": "Drain_Refill",
      "dcterms:source": "cat-harness/sdlc/processes/bean-drain.bpmn#Drain_Refill",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beandrain.drain_skip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mark it skip on the queue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record on the queue file that the bean is held elsewhere, and by whom, so no other drainer takes it next. The bean itself is not touched: closing or noting on someone else's bean is how a sibling loses work it had not finished reporting.",
          "@language": "en"
        }
      ],
      "skos:notation": "Drain_Skip",
      "dcterms:source": "cat-harness/sdlc/processes/bean-drain.bpmn#Drain_Skip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beandrain.drain_takenext",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Take the next bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The highest-priority bean on this drainer's list that is not marked skip. Taking it is not claiming it: the queue is advisory, so the bean still goes through OPEN's check before any work, including reading code for it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Drain_TakeNext",
      "dcterms:source": "cat-harness/sdlc/processes/bean-drain.bpmn#Drain_TakeNext",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beandrain.drain_work",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Work the bean (PR at the first commit)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Work only the bean OPEN claimed. Open the PR at the first commit with `Closes-bean: <id>` in its body — the open PR is the claim every other agent can see without the bean branch — and add its link to the bean on every copy. A cause found inside the bean that is separate work becomes a new bean, checked and claimed in its own right. A bean that waits on the owner is asked through `ask-the-person`, keeps its claim while the question is open, and goes to CLOSE as blocked if it will wait long.",
          "@language": "en"
        }
      ],
      "skos:notation": "Drain_Work",
      "dcterms:source": "cat-harness/sdlc/processes/bean-drain.bpmn#Drain_Work",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanlifecycle.call_beanclose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "End the bean in a state that says why: done is completed and archived, not wanted is scrapped with its reasons and archived, blocked records what it waits on and goes back to `todo`. Process_BeanClose is the one place resolve and archive are drawn.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanClose",
      "dcterms:source": "cat-harness/sdlc/processes/bean-lifecycle.bpmn#Call_BeanClose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanlifecycle.call_beanopen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check before you create (exact-title search), create the bean when none exists, find out whose it is, and claim it — or leave it alone when a sibling holds it. Process_BeanOpen is the one place a claim is drawn.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanOpen",
      "dcterms:source": "cat-harness/sdlc/processes/bean-lifecycle.bpmn#Call_BeanOpen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanlifecycle.task_work",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Work, keeping the body current (this is 'edit')",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Editing a bean is not a separate ceremony: check off todo items as they happen, append measurements with the command and date that produced them, and record what you now know that the next agent does not. A bean whose body is a title is a placeholder, not a plan.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Work",
      "dcterms:source": "cat-harness/sdlc/processes/bean-lifecycle.bpmn#Task_Work",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanopen.open_checkexists",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check before you create (exact-title search)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "STRICT. `beans create` is not idempotent: it mints a fresh id every call and dedupes on nothing, so re-entering a step duplicates the plan instead of no-op'ing. In the qou folio an unguarded re-run produced 14,688 duplicate beans — 92% of every open bean — which starved the idle-backlog policy of signal and collided with 15 real ids.",
          "@language": "en"
        }
      ],
      "skos:notation": "Open_CheckExists",
      "dcterms:source": "cat-harness/sdlc/processes/bean-open.bpmn#Open_CheckExists",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanopen.open_claim",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Claim it (status: in-progress)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Idempotent. Claim BEFORE working, and note the branch, so a sibling session can see the item is taken rather than discovering it by collision. The only `claim` op in the corpus: every process that claims calls this process (`check:bean-calls`).",
          "@language": "en"
        }
      ],
      "skos:notation": "Open_Claim",
      "dcterms:source": "cat-harness/sdlc/processes/bean-open.bpmn#Open_Claim",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanopen.open_create",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create the bean (agent CLI, not an engine op)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`beans create \"<title>\"`. This is the AGENT's call. The workflow engine has no `create` op — its vocabulary is claim, note, resolve and archive, all of which act on an instance's existing bean.",
          "@language": "en"
        }
      ],
      "skos:notation": "Open_Create",
      "dcterms:source": "cat-harness/sdlc/processes/bean-open.bpmn#Open_Create",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_beanopen.open_leavealone",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it alone (coordinate instead)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never resolve, scrap or delete a bean another session or a human owns. Claiming is how two sessions avoid picking the same item; closing someone else's is how one of them loses work it had not finished reporting.",
          "@language": "en"
        }
      ],
      "skos:notation": "Open_LeaveAlone",
      "dcterms:source": "cat-harness/sdlc/processes/bean-open.bpmn#Open_LeaveAlone",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_deps",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "bun / pip dependencies",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 2b. RESTORE: the package managers' download caches, keyed by the lockfile digest (`bun.lock`; the pip requirements file) and the tool version — never by a hand-listed version string. A restored download is re-verified by the package manager against the lockfile's integrity hashes: class (a). SAVE: main; a PR into its own ref scope. Owner role: the integrator (CI speed 14). `cache` node: `bun-deps`, `pip-deps`. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Deps",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_Deps",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Gate results: restore / save",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 2c. RESTORE: the result store (`build/result-store/`) and the CI cone records, by prefix — a WARM start: the cone (`ci-cone.ts`) then matches each stored entry exactly (fingerprint from `cache:key --base`, every recorded path state, every replayed git answer) and only an exact match is reported SKIPPED, never passed. A committer's local gate record is class (b): honoured on the critical path, then re-verified off it. SAVE: main only (class c for CI's records). Owner roles: the gate-reuse session (CI speed 8) and the committer-side session (CI speed 3). `cache` nodes: `result-store`, `ci-cone`, `local-gate-records`. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Gates",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_igast",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "FHIR IG ASTs: Process_IgAstCache",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 4b, in its own lane: the FHIR IG layer's IG AST cache, `Process_IgAstCache` (declared by that layer), integrated, not replaced. It is drawn as a task because this layer may not name a process of a layer above it; the steps are that process's. RESTORE: read the cached AST from its branch store and judge it — that process's \"valid for this commit?\" IS this component's verify (class a: the AST is judged against this commit's IG sources and tooling); valid → the site is built from it. SAVE: that process's own path, not `cached-step` — a miss dispatches an AST refresh on a Java runner with 10 GB, which rewrites the branch store. The branch store is a `cache` node (`fhir-ast`, fhir-harness `caches/fhir-ast.cache.json`). Owner: CI speed 12, the IG layers' session. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_IgAst",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_IgAst",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_image",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepared image + node_modules",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 2a. RESTORE: the prepared CI image `ghcr.io/<owner>/<repo>-ci`, keyed by `.github/ci-image/key.sh` (the lock, `bun.lock`, `package.json`, the recipe files, the bun version and `ImageOS`) — computed BEFORE anything is mounted, so it is not `cache:key`; `cache:key --check image` asserts the two agree. Each layer's sha256 is checked as it streams and `mount:lock:check` re-hashes the result: class (a). SAVE: main or a dispatch only (the one job with `packages: write`). Owner role: the prepared-image session (CI speed 9). `cache` node: `ci-image`. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Image",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_Image",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_jekyll",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Jekyll cache: restore / save",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 5, last: it caches the rendering of what the components above produce. RESTORE: `.jekyll-cache`, keyed by the theme, the layouts, includes and plugins, `Gemfile.lock` and the Ruby version, by exact key only. Jekyll invalidates an entry whose source changed, but a template change is not visible to it, which is why the templates are in the key. SAVE: main only — class (c). Owner role: the preview session (CI speed 2). `cache` node: `jekyll-cache`. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Jekyll",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_Jekyll",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_layers",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Layers ref: restore / save",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 1, which everything else needs. RESTORE: `mount-from-lock` replays the lock from `refs/cat/layers/<key>` (key = sha256 of the lock's layers), verifying every layer's tree digest, declaration and asset sha256 against the committed lock — class (a), verified against THIS tree, so a bad entry is only a miss, and a stale `refs/cat/layers/main` still serves every layer that did not move. SAVE: the committer (`layers:publish`, run by `mount:remote` after it changes the lock), with the re-pin train and main as fallbacks. Not wrapped in `cached-step`: its per-layer verify is finer than one hit. Owner role: the layers-ref session (CI speed 13). `cache` node: `layers`. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Layers",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_Layers",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_lean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Lean .oleans: restore / save",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 3, after the layers (the Lean packages are mounted content). RESTORE: the compiled `.olean`s of each declared Lean package, keyed by the package, the toolchain AND the lake manifest (the Mathlib revision) — the manifest is part of the key, so an entry from another revision is a miss. `lake build` re-checks every restored module's trace, so a stale module is rebuilt, not trusted: class (a). SAVE: main; a contributor's warm build may be offered back (`compiled-artefact-cache`) and is accepted only through that same trace check. Owner role: the integrator (CI speed 14). `cache` node: `lean-oleans`. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Lean",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_Lean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_renderseed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render seed: writer records",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 4a, the seed of CI's render (owner, 2026-11-05: CI does not run `render`; its render is `derive:publish`). SAVE: main's `writer-records.yml` records each publish-time writer under trace (`writer-cone`): its read set, the state of every path it read, and the outputs it wrote. RESTORE: a run with `CAT_WRITER_SKIP=1` (a pull request, staging, the preview) skips every writer whose recorded reads all still match and puts back main's recorded outputs; a writer whose reads moved runs. The key is the writer's recorded read set; trust (a′): the outputs are the recording's own, so their PROVENANCE is checked — they come only from main's recording run, never from a run a pull request could write. Owner roles: the integrator and the preview session (CI speed 2). `cache` node: `writer-records`. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RenderSeed",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_RenderSeed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cache.task_sets",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Generated sets: QA copy, pages",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Component 2d. RESTORE: the QA working copy and the publish-time pages, keyed by `bundle-cache.sh digest` (the tree and the exact tool versions). A bundle is checked against the manifest it carries AND a source rule (the source run's head is this head, a parent, or a commit with this tree; or a main-scoped save) — class (a′), because a manifest alone proves a bundle intact, not built from these inputs. Hits across commits wait on the producers being byte-reproducible (the determinism audit). SAVE: the run that built it, recorded; main's records are read by every branch. Owner role: the generated-sets session (CI speed 10); the preview's copy, the preview session (CI speed 2). `cache` nodes: `qa-working-copy`, `publish-pages`. It reports one line in `cached-step`'s format — `cached-step <step>: hit|warm|miss (<trust>) — <why>. Key <key>.` — to the job summary, which the daily hit-rate report counts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Sets",
      "dcterms:source": "cat-harness/sdlc/processes/cache.bpmn#Task_Sets",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cihealth.call_watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the verdict on the tracking issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Runs the shared tracking watch with the label `ci-health`. Asked of the same `verdict`, once it is known. `clean` is verdict == 'clean' (exit 0): the open `ci-health` issue, if there is one, is closed saying main is clean. `not clean` is verdict == 'red' (exit 1 with a report): the one open issue labelled `ci-health` is edited in place with the report as its body, or created if there is none. Neither branch fails the job — a red main speaks through the issue, not through this workflow's status. Clean here means main is clean.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Watch",
      "dcterms:source": "cat-harness/sdlc/processes/ci-health-watch.bpmn#Call_Watch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_cihealth.task_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run check:ci-health, WRITING the report file",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run check:ci-health --out, writing the report file before any exit path. Exit 0 clean, 1 live failures, 2 could not check. bun also exits 1 on an uncaught exception, so an exit 1 with no report file is a crash and is treated as could-not-check. Where its verdict comes from: Asked of the `verdict` output that the `check` step of .github/workflows/ci-health.yml writes, not of the raw exit code. `check:ci-health` exits 0 clean, 1 live failure(s), 2 could not check; an exit 1 with no report file is a crash and is reclassified as could-not-check, as is any other code. `no` is verdict == 'unknown': the last step runs `exit 1` and no issue step runs, so the tracking issue is left untouched. `yes` is verdict != 'unknown', the guard on the label step and so on both issue paths. Weekly, also measure each workflow's job shape (owner, 2026-11-13, card \"A. Collapse into one job\"): from the Actions API, each job's queue wait (started_at minus created_at) and run time (completed_at minus started_at), as medians over recent default-branch runs. A job whose median wait exceeds its run time, or a serial chain of more than 2 jobs each under 1 minute, is a candidate to fold into one job as steps: open a work item naming it. Heavy or parallel shards, jobs with other permissions or runners, and jobs whose check names merge:guard, branch protection or verdict reuse read stay separate (skill ci-health).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Check",
      "dcterms:source": "cat-harness/sdlc/processes/ci-health-watch.bpmn#Task_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_addressreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Address the review",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every finding is answered — implemented, or replied to with why not. A design question does not excuse skipping the nits in the same review.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AddressReview",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_AddressReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_archivebean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanClose: end the bean in a state that says why — complete and archive it, scrap it with its reasons and archive it, or record the blocker and hand it back. The one place resolve and archive are drawn (bean m8gz, owner 2026-10-24); placed straight before the end so the engine's resolve sees nothing left but the archive step.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ArchiveBean",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_ArchiveBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_branchandannounce",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Branch, and announce it",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Announce the branch WHEN IT IS CREATED, not when the work is done. The gap between one agent's view of an issue and everyone else's is what this closes.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_BranchAndAnnounce",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_BranchAndAnnounce",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_claimbean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanOpen: check before you create, find out whose the bean is, and claim it — or leave it alone when it is someone else's. The one place a claim is drawn (bean m8gz, owner 2026-10-24); the gateway after this reads which end it reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ClaimBean",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_ClaimBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_closebean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what was done",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A closed work item is read later by somebody deciding whether to reopen the subject, so \"completed\" with nothing behind it cannot be audited. An ISSUE is never closed on the agent's own say-so.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CloseBean",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_CloseBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_commitandopenpr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Commit, push, open the PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The PR opens at the FIRST commit, even on a stub, and permission is never asked for it. Holding a green PR back for someone to look at is not caution — it is a blocked reviewer. A change to a rendered surface carries a before/after preview in the PR body (skill before-after-preview). The push runs the precheck first (`bun run cat precheck`, the pre-push hook; owner, card 2026-11-18): only the fast checks whose inputs it changed, and a red one refuses the push, since every red CI run emails the owner.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CommitAndOpenPR",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_CommitAndOpenPR",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_diagnose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Root-cause the failure",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"Flake\" is not a root cause. A red PR is work now, whatever its review state — only a green, mergeable head waits on reviewers.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Diagnose",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_Diagnose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_implement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Make the change",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The loop's only open-ended step. Everything around it is procedure; this is the work.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Implement",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_Implement",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_preparemerge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare the merge, and watch it through",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`prepare-merge` brings the base in, re-runs the gates and pushes — it does NOT merge. Bringing the base in IS `merge-base.bpmn` (`bun run cat merge:main`): conflicts a declared pattern covers are resolved and proved by the gate set; anything else aborts the merge and comes back to the agent (bean `y7b3`, #1707). `watch` follows the PR until it is merged or closed, because webhooks do not reliably deliver CI success or a merge-conflict transition.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PrepareMerge",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_PrepareMerge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the change",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human or an agent acting AS reviewer. Nothing is a reviewer; somebody acts as one for the duration of this lane. For a rendered change the reviewer reads the agent's before/after preview rather than building one. On agent-touched changes, an adversarial code review evaluates against the RED FLAG taxonomy and writes a committed verdict. A change to translatable source text marks the strings it rewrote stale in every locale (their candidates' `msgidHash` no longer matches). The translations re-enter `translation-adjudication` afterwards; they never block this PR, and the reviewer does not wait for them.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_runci",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the gates against the merge of head into base",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "CI tests the MERGE, not the branch. That is why a locally green tree can go red here: the agent's tree and the merge result are different trees, and the difference is invisible from a checkout.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RunCI",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_RunCI",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codechangereview.task_rungates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the platform's own gates",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before pushing, not after CI says so. `bun test` passing is NOT the gates passing: measured 2026-09-19, a green unit suite sat beside a `tsc` failure and a missing `@graphNode` tag, and the second broke a QA sidecar comparison as well — one cause, two symptoms, and an agent running only the tests would have pushed all three.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RunGates",
      "dcterms:source": "cat-harness/sdlc/processes/code-change-review.bpmn#Task_RunGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_e2e",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "End-to-end + accessibility (HARD)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Install Chromium, check the rendered BPMN SVGs are current, then run the Playwright suite, which includes the accessibility checks. Hard: a failure blocks the PR. SHARDED since bean `dlqu` (drawn as one task, deliberately: a multi-instance marker would add a BPMN term to every instance's UML overview, about 75 generated files, for a picture this sentence already gives): the suite runs as three `e2e-shard` jobs (`E2E_SHARD=i/3`, one Playwright worker per core in each), and each shard is its own required check, so a shard that failed, was cancelled or never ran is a red check of its own. Until bean `5p4m` (issue #2456) an `e2e` job carried one check name for the three and completed the task only when every instance succeeded; it was ~1 s of work behind a runner request that waited minutes, and was removed. Measured before the split: `playwright test` alone was 4m33s of a 5m16s job, the workflow's slowest once `bun test` ran in parallel. The BPMN-render and `.bat`-wrapper checks run in shard 1 only, so they are asked once.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_E2E",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_E2E",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_hygiene",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import hygiene (HARD) and advisories (WARN-ONLY)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "FOUR QUESTIONS, ONE RUNNER — bean `7fu5`. They were four jobs (`lean-bare-import`, `python-imports`, `rust-wildcard`, `dependency-advisories`), each about a second of work behind a ~13 s checkout and a runner request; measured on `main` run 37133247484 (2026-10-03), the run took 21.7 min while its longest job executed for 174 s, the rest waiting for runners. Now they are steps of the `hygiene` job, and every step after the first gate runs `if: !cancelled()`, so a red one masks none of the others — the `om30` rule kept inside one job rather than by splitting it. (1) Lean, HARD: fail on any bare `import Mathlib` in content/**/*.lean; in this platform repo there is no content/, so the step prints SKIP and states that nothing was scanned. (2) Python, HARD: ruff F401 (unused) and F403 (wildcard) over the Python trees that exist, then the Python tests; an absent tree is dropped rather than passed to ruff, and an empty set says SKIP. (3) Dependency advisories, WARN-ONLY by the owner's ruling on bean `j41m`: is anything in the resolved tree KNOWN-VULNERABLE? The script exits 0 in every state and keeps them apart in its output; `.github/dependabot.yml` is the other half of that ruling and is not drawn here. (4) Rust wildcard imports, WARN-ONLY: report non-test `use …::*;` in tools/**/*.rs; `continue-on-error`, and therefore the job's LAST step, where it masks nothing.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Hygiene",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_Hygiene",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_qapublish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish QA results (not a gate)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean `16ei`, arc `3fva`. After Task_RepositoryGates, WHATEVER it concluded (`needs:` its two corpus parts, with `always()`), and after Task_QaWorkingCopy, whose copy it restores and publishes rather than building a second time (bean `jtfk`), `qa:publish --github` writes this run's `test/results` trees to the orphan `qa-reports` branch: `main/<sha>/` on a push to main, `pr/<n>/<head-sha>/` on a same-repository PR (owner rulings D1, D3). A fork PR's token is read-only, so it is skipped with a `::notice` naming why. It does NOT reach GW_Join: a red publish is its own red and never decides mergeability, and the hard gates never wait on it. The only job here holding `contents: write`, which is also how `bun run cat gates` knows not to run it locally. A CALL ACTIVITY: the key derivation, the fork skip and the never-`-f` retry loop are `qa-publish.bpmn`, which also draws the retention run that takes entries off the branch again.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_QaPublish",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_QaPublish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_qaworkingcopy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "QA working copy, built once (NOT A GATE)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean `jtfk`, issue #2456. `bun run qa:working-copy` (bean `72a8`) — the bootstrap kg-export, then every declared QA writer — used to run INSIDE each job that reads the QA tree, and `qa-publish` ran the same writers again: nine builds of one tree from one commit, measured at 2,284 of 4,714 runner-seconds (48 %) on run 37659324493. Now the `qa-working-copy` job builds it once and uploads everything the build changed as an artifact with a sha256 manifest; each reader downloads it, checks the manifest against the hash this job reported and every restored file against the manifest, and only then judges. An artifact rather than a cache, because a cache key built from less than the real inputs serves stale data; an artifact is per run and exact. It judges nothing, so it is not a gate and does not reach GW_Join; a failed build fails every reader at its first step (they run `if: !cancelled()`), never a skip. Drawn feeding GW_Readers, the four tasks that wait for it; within them `typescript-static` and `gates-standalone` read no QA tree and do not wait, and `qa-publish` waits for it as well as for Task_RepositoryGates.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_QaWorkingCopy",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_QaWorkingCopy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_repositorygates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Repository gates (HARD)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The 43 repository-gate steps — workflow refs, lane and process documentation, kg:audit:check, detangle, skills, published packages — 150 `bun run` invocations in all. A SEPARATE job from Task_TypeScript since bean `om30`: they were one job in which `bun test` came second of 47 steps, and because Actions stops a job at its first failing step and no step was continue-on-error, a deliberate test failure on `main` meant none of these ran. A gate never asked and a gate that passed are indistinguishable from outside, which is `xom7` at the step rather than the workflow. No sequence dependency on Task_TypeScript is drawn because there is none: a red test must not stop these being asked. `bun run cat gates` derives its list from BOTH jobs, so the local set still cannot drift from CI's.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RepositoryGates",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_RepositoryGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_skillchain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Skill-registration chain (UNMASKED)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Runs the five `--check` commands that adding a skill stales, each on its own: gen-skill-docs, check:glossary, auto:docs:check, kg:audit:check, kg:detangle:check. CORRECTED 2026-09-26, after main split this workflow: the original justification is GONE. It read \"the only place those five are read against the tree as checked out\", because at the time all six lived in one job behind `bun test`, which runs the kg-audit and detangle WRITERS and repaired two artefacts before their checks read them (bean `ymsu`). Task_RepositoryGates is now a separate job that runs all six and never runs `bun test`, so they are unmasked THERE. What survives is narrower and is the reason this is kept: one command a skill author runs (`bun run cat skill:register`) that regenerates and verifies the chain together, a committed QA sidecar saying which steps ran, and ONE named failure instead of six unrelated generated files — which is bean `v625`'s actual complaint. The unmasking argument belongs to Task_RepositoryGates now. Its first CI run earned the place: it went red on `kg:detangle:check` and the cause was `kg-detangle.ts` counting 1214 files of a gitignored `node_modules/` as graph nodes — 1441 where a clean checkout computes 227, pinned in a committed sidecar. Not a step in front of `bun test` either: measured on main's run 36234052354, a failing step SKIPS every step behind it, so a red there would turn one named failure into forty-five unevaluated ones. 13s, in parallel. Beans `v625`, `fjwi`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_SkillChain",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_SkillChain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_typescript",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "TypeScript: lint, types and tests (HARD)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three checks: `bun run cat lint`, `tsc --noEmit` and `bun test`. The repository gates it used to carry are Task_RepositoryGates now (bean `om30`). Since bean `dlqu` it is split across jobs: `typescript-static` (lint, then typecheck), `typescript-test` (`bun test` as four SEQUENTIAL shards on separate machines — Bun's in-process `--parallel` worker pool hung at both 4 and 2 workers, measured — the shard passed in `BUN_OPTIONS` so the command stays the one `bun run cat gates` runs locally) each shard and `typescript-static` its own required check. A fourth job, `typescript`, carried one check name for all of them and was green only when the others succeeded; bean `5p4m` (issue #2456) removed it — a runner request for ~1 s of work that waited minutes for a runner — so branch protection names the five checks directly. The step-order rule the single job needed — `bun test` LAST, because Actions stops at the first failing step and a red-by-decision test would otherwise mask lint and typecheck — no longer has anything to order: separate jobs cannot mask each other. Measured on three `main` runs before the change: `bun test` alone was 7m30s-7m45s of an 8m14s-8m33s job.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TypeScript",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_TypeScript",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_unrungates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Registered gates that never run (HARD)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:gates-registered`, split out of Task_RepositoryGates by bean `dlqu`: one step of that job measured 1m46s-2m28s across four runs, the longest step in it by a factor of four, and a sequential job is as slow as the sum of its steps. In its own job it runs beside the rest rather than after them. It still asks the same question — is every gate a script registers actually run somewhere — and is still hard. It also carries `bun run cat security:gate` (bean `ieum`, owner 2026-10-07: \"security check before release\"): the security checks by name, plus third-party action SHA pinning outside staging-only workflows, as one step that merge-train's gate call reaches. A blocking fail OR could-not-check fails the job.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_UnrunGates",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_UnrunGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codequalitygates.task_verdictreuse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verdict reuse: tree already green? (NOT A GATE)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean `qbco`, issue #2456 (owner, 2026-10-07: \"1y, 2y, 3y, 4y\"). On a PUSH to `main` only; on any other event it is skipped and nothing waits for it. A merge-button merge of an up-to-date PR carries a tree CI has already tested. `verdict-reuse.sh` looks up the runs of this workflow on the merged head (the merge commit's second parent) and answers `reuse=true` only when one concluded `success`, ran every job a reuse would skip, and tested exactly this tree: for a `pull_request` run, the `tested-tree:` its Task_QaWorkingCopy job wrote into its check run's summary; for a dispatch, the head's own tree. Then the four `bun test` shards (part of Task_TypeScript), the three e2e shards (Task_E2E) and the standalone ratchet (part of Task_RepositoryGates) are skipped on this push, and the summary names the run whose verdict stands. Everything that judges the tree against `main` or reads `qa-reports` still runs. A squash, an API error, a missing record or a mismatch is `reuse=false` and every job runs: could-not-determine is never green. Drawn before the fork because the jobs it can skip wait for it; the others do not. Since the same ruling, a newer push to `main` also cancels an older main run still in progress (the workflow's `concurrency`), so main's verdict history is thinned by decision.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_VerdictReuse",
      "dcterms:source": "cat-harness/sdlc/processes/code-quality-gates.bpmn#Task_VerdictReuse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codereview.task_recordverdict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the verdict on the node",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings are advice, not commits — the same separation the generic reviewer lane keeps. Record them where the next reader meets the node.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordVerdict",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_RecordVerdict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codereview.task_reviewschema",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the schema definition node",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Does the node declare what KIND of node it is? Does a widened type carry its mirrors? Does a removed field leave a reason behind, so the next author does not re-add it in good faith? And where the node RENDERS to something the site serves — a colour, a glyph, a theme's tokens — does a Tool maintain that artefact, and does the visual fact have only one home? The node decides; the stylesheet reports.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReviewSchema",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_ReviewSchema",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codereview.task_reviewtool",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the Tool node",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Does it name skills, and do they resolve? Is the mechanism it advertises the one that actually runs? Are its IRIs minted rather than written out? And the question a covered skill hides: is the COMMAND reachable, or only the skill satisfied? A skill can be served by the neighbours of its mechanism while the mechanism itself is reachable from no node, and check:tools reports it as covered and is right to.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReviewTool",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_ReviewTool",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_codereview.task_runnodeaudits",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the node audits",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:tools`, `kg:audit` and `typecheck`. Read the kg-qa sidecar rather than the summary: it is written per node so an inherited defect and a new one are distinguishable.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RunNodeAudits",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_RunNodeAudits",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.a_accept",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accept it, and record where it came from",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both branches land here. An unprompted offer is accepted as it stands — do not make somebody follow a process to hand over what they already have. Provenance is recorded whichever channel it arrived through: a description given in chat has a source and can be wrong, exactly as a PDF does.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Accept",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#A_Accept",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.a_ask",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask for a link or a description",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both forms, named together. A person who cannot find the file often knows exactly what it is, and a description in their own words is an acquired resource rather than a consolation prize. Asking for the upload first demands the one thing they may not have, before the cheaper answers have been offered. Say what happens if they do nothing.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Ask",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#A_Ask",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.a_pointtoupload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Point at the upload target",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Composed from the declaration by the `upload-url` Tool, never written by hand: the queue is declared with INSTANCE scope, and a forge URL needs the path relative to the REPOSITORY. Every failure is named — no origin remote, a non-GitHub forge, a declared-but-absent queue — because a URL is believed, and somebody sent to a wrong one cannot tell it from an empty directory. On failure, fall back to the conversation.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_PointToUpload",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#A_PointToUpload",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.a_route",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Route it, and watch the queue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A file goes to ingestion; a link or a description goes to whatever will resolve it. Acquisition stops here — the moment a file is in the queue, library-ingestion owns it, and keeping that seam sharp is what lets a resource acquired through a channel that does not exist yet reach ingestion unchanged. An arrival may be minutes or days away, so it is watched rather than chased.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Route",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#A_Route",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.p_respond",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Give a link, a description, or neither",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"Or neither\" is a real outcome, not a failure. The ask says what happens if nothing comes, and then that happens — the work proceeds without the resource and says so.",
          "@language": "en"
        }
      ],
      "skos:notation": "P_Respond",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#P_Respond",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_contentacquisition.p_upload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Drop the file in the queue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through the forge's upload form, a commit, or any other route that lands the file in the declared queue. The agent watches rather than chases: an arrival may be minutes or days away.",
          "@language": "en"
        }
      ],
      "skos:notation": "P_Upload",
      "dcterms:source": "cat-harness/library/processes/content-acquisition.bpmn#P_Upload",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_chooseasset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Select upstream asset and target folio",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Name the upstream layer (`<owner>/<repo>`), the asset's declared path in that layer, the commit `ref` (when pinned), and the target folio declaration that will receive the copy.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ChooseAsset",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_ChooseAsset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_copyanddeclareasset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Copy asset into target folio and declare in assets[]",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the asset bytes into a declared path inside the target folio and add the `KgAsset` entry to the target folio's `<name>.json` `assets[]` list (`directory-conventions`). Never drop the copy into an undeclared scratch directory.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CopyAndDeclareAsset",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_CopyAndDeclareAsset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_inspectreadonly",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Browse in place, emit a KgAsset snippet",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clean degradation when no write capability (`git-push`, `github-api`, `github-connector`) is present: inspect the asset in place through the zero-write `browse` affordance and output the ready-to-paste `KgAsset` entry (with `source: { instance, path, ref }` populated) so the author can apply it where they have write access.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_InspectReadOnly",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_InspectReadOnly",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_probewritecapability",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Probe write capability",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check whether the session holds at least one of the three write capabilities (`git-push`, `github-api`, or `github-connector` under `scenarios/capabilities/`). Keep available, absent and could-not-determine distinct.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ProbeWriteCapability",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_ProbeWriteCapability",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_readupstreamasset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the upstream asset (no writes)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the asset bytes and its origin coordinates (`instance` as `<owner>/<repo>`, `path` within that instance, and commit `ref`) from the source knowledge graph without modifying anything in the source lane.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadUpstreamAsset",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_ReadUpstreamAsset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_stampassetsource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Stamp the asset's source",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Populate `source: { instance, path, ref }` (`AssetSourceSchema` in `schemas/kg/kg-node.ts`) on the new `KgAsset` entry in the same change. Because `source` absent is a third state meaning \"authored locally in this instance\", omitting `source` on a copied asset is forbidden.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_StampAssetSource",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_StampAssetSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_validatedeclaredasset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Validate the asset and provenance",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run `bun run cat check:declaration-resolution` (`check:declared-assets`) to verify that the copied asset exists at its declared path, its `KgAsset.source` conforms to `AssetSourceSchema`, and the upstream source graph remains untouched.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ValidateDeclaredAsset",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_ValidateDeclaredAsset",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyintofolio.task_workoncopy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit, comment or raise todos on the folio's copy",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The copied asset is now writable content of the target folio with recorded upstream provenance (`KgAsset.source`). The folio author may edit it in place, attach review comments, or raise todos (`todo-manager`) against it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_WorkOnCopy",
      "dcterms:source": "cat-harness/processes/kg/copy-into-folio.bpmn#Task_WorkOnCopy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_editdirectly",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit it in place — it is your own content",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ordinary path, drawn so the process does not read as though every edit needs a copy. Content in a writable directory is authored content and is edited where it lives; the copy-out is for somebody else's bytes, not for yours.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_EditDirectly",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_EditDirectly",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_land",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land the bytes in the copier's own folio/",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Into the copier's own declared `folio/`, never a scratch area — a directory nobody declared is a directory nobody gates, and the copy would be publishable by accident. The copy is NOT read-only: it is the copier's own content, makes no claim about anybody else's bytes, and freezing it too would mean the next person needs a copy of the copy.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Land",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_Land",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_readsource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the original — and write nothing",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A read, and the only interaction this process has with the source. Its digest and `provenance` are carried forward: the digest so Task_VerifySourceUntouched has something to check against, and `provenance` so the copy can name what it came out of without re-deriving it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadSource",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_ReadSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_recordprovenance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what this is a copy of",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The step that is easy to omit and impossible to reconstruct afterwards. `provenance` is a PAIR: `upstream` is the remote thing, `local` is the original in this repository. A copy-out writes `local`; it does not overwrite `upstream`, and it does not reuse `upstream` for a local value. Without `local`, one rename later the copy is indistinguishable from original work and nothing downstream can repair it, because the information was never written down.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordProvenance",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_RecordProvenance",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_copyoutmaterialized.task_verifysourceuntouched",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify the ORIGINAL still hashes to its digest",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:materialized-fixity`. Run against the SOURCE, not the copy — the copy is new content with no claim to verify, and the source is the thing a botched copy-out would have disturbed. A mismatch here means the copy-out was an edit in place wearing a copy's clothes, and it is the only signal that tells the two apart.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_VerifySourceUntouched",
      "dcterms:source": "cat-harness/library/processes/copy-out-materialized.bpmn#Task_VerifySourceUntouched",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.a_detect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect feature request (crdm-detect skill)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Recognise the request as a platform capability change rather than content work, from crdm-detect's signals. Never call it \"CRDM\" to the person. Mid-content-work, ask whether to pause for requirements now or record a work item for later — do not switch on your own.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Detect",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#A_Detect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.ba_submit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Describe the need (chat, issue, discussion)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA describes the capability gap in their own words. They do not need to know it is called CRDM.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_Submit",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#BA_Submit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close-out",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The stakeholders sign off, the BA confirms every criterion is met, and only then does the agent close the issue. Never the other way round: an agent must never assume completion.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Close",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_datamodel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Data model Entities + cardinalities",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Between requirements and sign-off, and the order is the argument: requirements are statements about things, and the model says what the things ARE. Drafted earlier it is invented from nothing, since the entities come from the phase-2 BPA; drafted later, sign-off approves requirements whose nouns were never pinned — which is how two stakeholders approve one sentence meaning different things.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_DataModel",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_DataModel",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_deliver",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 6 Implement + acceptance",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One phase and not three, because the loops say so: an increment the BA rejects, an MVP that is not ready, and stakeholder findings all route back into implementation. A subprocess has one exit and cannot be re-entered once finished, so splitting this region would have changed what the diagram says.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Deliver",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Deliver",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_issue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Link the work to an issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Feature work must be linked to a GitHub issue. Scan before creating, and never create one without the BA's permission — an issue is the stakeholder's record, not the agent's scratchpad.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Issue",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Issue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_needs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1 Needs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Identify the stakeholders, synthesise a needs statement from the sources, and loop until the BA and the stakeholders both recognise it. The loop is the phase: a needs statement nobody confirmed is an agent's summary, not a requirement.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Needs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Needs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_requirements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phases 2–4 BPA + requirements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Map the current workflow, then define the requirements and the impact they carry, and loop until approved. Same shape as Phase 1 and for the same reason: an unapproved requirement is a proposal.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Requirements",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Requirements",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm.call_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 5 Plan + sign-off",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The approved requirements become work-plan items, the BA signs off, and the branch is announced on the issue. The announcement is on the single edge into delivery, so the three loops back into implementation do not re-announce.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Signoff",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.a_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close issue ONLY on BA authorisation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reachable only through BA_Confirm, which is the BA saying every criterion is met. An agent must never close an issue without that explicit authorisation — the gate is the preceding task, and this name says so rather than leaving a reader to trace the flow for it.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Close",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#A_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.a_recordsignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the sign-off attestation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE RECORD, and not relaxable, because a judgement nobody wrote down is indistinguishable from one never made (`adjudication`, A_RecordEntry). Append one `requirement-signoff` record to `test/attestations/requirement-signoff/<set slug>.attestations.json` — who (kind, id, actor), at, scope (the set or one member), the outcome from the requirement-set code list, the stage it moves the set to, the reason, and the permalink to the issue comment where it was decided — and set the set's `stage` to match. GW_SignoffRecorded after this reads the record back, so this step cannot be skipped by completing it: a sign-off that left no attestation loops here again.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordSignoff",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#A_RecordSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.ba_confirm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm all criteria met",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The business analyst confirms every acceptance criterion from the requirements is met. The issue closes only on their authorisation — an agent never closes an issue on its own say-so. It IS an adjudication with the requirement-set answers: an approval here moves the set to `accepted`, which `check:requirements` refuses unless it is a human's and every approved member is `in-force`.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_Confirm",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#BA_Confirm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.call_mergetomain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land the feature's PRs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Phase 6's \"explicit confirmation before merging to main\", made a step that can refuse. Once per pull request the feature still has open, after the sign-off is recorded and before the issue is closed: an issue is not closed on a feature that is not on `main`. `merge-to-main.bpmn` reads each head's evidence live, establishes that the owner authorised THAT merge (a stakeholder sign-off or the BA's confirmation is acceptance of the feature, not authorisation to merge it, unless the owner's own words say so), records the authorisation, merges, and confirms the base. A PR the owner holds or refuses stays open, and A_Close then waits: the BA's authorisation to close does not cover a feature that did not land. An increment the owner asked to land earlier in Phase 6 went through the same sub-process at that time. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `merge-to-main` (`Process_MergeToMain`, sdlc/processes/merge-to-main.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12).",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_MergeToMain",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#Call_MergeToMain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_close.s_featuresignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Feature sign-off on issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders sign off on the delivered feature on the issue, having tested the built artefact rather than a description of it.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_FeatureSignoff",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#S_FeatureSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.a_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the model where a tool can read it",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A model in prose is a proposal; a model in the declaration is a model. Ship a reader in the same change: a model that is only documentation goes inert.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Declare",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.a_entities",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify entities from the BPA and requirements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every verb in the BPA whose object is a candidate entity, and every noun in a requirement. An entity with no identifier is an attribute of something else — that test is decisive and belongs to the technique skill.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Entities",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Entities",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.a_relations",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Relations and cardinalities, both ways",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stated in both directions, because \"one attestation per report\" and \"one report per attestation\" are different claims and a model with only the first cannot say whether a re-signature is an update or a second row.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Relations",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Relations",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.ba_confirmentities",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm the entities are the ones meant",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A naming question. The BA owns the domain vocabulary; the agent does not guess, which is CRDM's own rule for phase 1 and applies here with more force.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_ConfirmEntities",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#BA_ConfirmEntities",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_datamodel.s_confirmcardinality",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm the cardinalities",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An operational question, asked of the people who run the process because they know where the exceptions are.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_ConfirmCardinality",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#S_ConfirmCardinality",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.a_codeaudit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Audit the code nodes the increment adds",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into the review task for what this increment CHANGED IN THE GRAPH — Tool definitions in `tools/` and schema definition nodes under `schemas/`. It runs before the summary, and therefore before an MVP can be shared: a Tool or schema node shipped in an MVP is the version stakeholders start building expectations on, and a node that names a skill nobody wrote is cheaper to catch here than after sign-off. Called, not inherited: the agent keeps its implementing role and takes on the `code-reviewer` lane inside Process_CodeReview for that call path only.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_CodeAudit",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_CodeAudit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.a_deploystaging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy the MVP to staging",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An MVP is shared AS A branches/ DEPLOY, not as a description of one. `feature-staging.yml` publishes the branch under `branches/<branch-slug>/` on gh-pages and comments the URL on the PR, so the stakeholder who tests it is looking at the built artefact rather than at a screenshot — the same argument the merge discipline makes about rendered work: holding a rendered change back for assessment makes assessment harder, not safer.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_DeployStaging",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_DeployStaging",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.a_implement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 6: Implement (feature branch + PR)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Inner loop: agent claims a bean, implements on feature branch, opens PR, posts summary to the issue. When the requirement changes a rendered surface, implement against the wireframe candidate the requester or BA chose in Phases 3–4 (Process_WireframeDesignReview, called from Process_CRDM_Requirements), not against a fresh design; and the delivery summary links the chosen candidate beside the after-screenshot, so the reviewer can see the build matches what was approved.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Implement",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_Implement",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.a_summary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post summary to issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What was accomplished, what remains, and the staging links: one deep link per changed page on the preview, with the same page on main (feedback-deep-links).",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Summary",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_Summary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.ba_reviewincrement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review increment (test behaviour)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Inner loop: the BA tests each delivered increment against the acceptance criteria. They do not review code — they test behaviour.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_ReviewIncrement",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_ReviewIncrement",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.ba_sharemvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Share MVP with stakeholders",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Outer loop: the BA presents the accumulated increments to stakeholders as a testable MVP. Staging URL, demo, or walkthrough.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_ShareMVP",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_ShareMVP",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.ba_translatefeedback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate feedback into agent direction",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA translates stakeholder findings into actionable direction: new beans or bean updates for the agent.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_TranslateFeedback",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_TranslateFeedback",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.call_optionsanalysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Options analysis how to implement",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the single edge from `Start_Process_CRDM_Deliver` into `A_Implement`, so the approach is chosen before any code exists. By Phase 6 the needs, requirements and data model are signed off, which is exactly the evidence an options analysis needs and the reason it belongs here rather than earlier: at `Call_Needs` there is nothing to weigh, and after `A_Implement` the choice has been made in code. The three loop-backs into `A_Implement` — `_5` (increment rejected), `_7` (MVP not ready), `_13` (feedback translated) — deliberately BYPASS this call. Routing them through it would run the subprocess on every iteration of the inner loop, which is the ceremony this design refuses: a gate invoked on every pass stops being read. An iteration reworks an approach already chosen; if the APPROACH is what is wrong, that is not a loop iteration and it belongs to the calling step in `crdm-requirements.bpmn`. Contrast `upstream-version-adoption`, where the loop DOES re-enter the analysis. There the loop-back returns to `A_Impact`, which re-gathers the evidence, so the second pass weighs genuinely different inputs. Here the loop returns to implementation with the evidence unchanged. `A_Implement` carries a `note` on the bean (its claim is the OPEN that `Process_CRDM` calls first); this step carries no bean op, because `Process_OptionsAnalysis` ends with its own `decision-audit` note on the bean the caller claimed.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_OptionsAnalysis",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#Call_OptionsAnalysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_deliver.s_testmvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Test MVP in own context",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders test the delivered feature in their own workflow, with their own data. They report what works and what does not.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_TestMVP",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#S_TestMVP",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_issue.a_askcreate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask BA to create or link issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask — never create. Creating an issue without the BA's permission is the thing this step exists to prevent.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_AskCreate",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_AskCreate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_issue.a_linkissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Link to existing issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A match was found: ask the person whether the requirements go on #NNN, then link the work there. The issue is where stakeholders sign off, so no phase proceeds without one.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_LinkIssue",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_LinkIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_issue.a_scanissues",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan open issues for match",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Search open issues, then recently closed ones, by title and body keywords for one this request belongs to. Requirements may span several issues; note every relevant one.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ScanIssues",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_ScanIssues",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_issue.call_relatedwork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Related work: find, sort, ask",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "When the requirement is initiated or updated through a human-agent chat, search the beans and the repository's issues and open PRs for relevance, categorize and summarize them, and ask the user whether and how to coordinate. Judgement decides the categories; the user decides the coordination.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_RelatedWork",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#Call_RelatedWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_needs.a_stakeholders",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1: Identify stakeholders",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent asks the BA who is affected by this change. The BA knows the domain — the agent does not guess.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Stakeholders",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#A_Stakeholders",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_needs.a_synthesise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1: Synthesise needs from sources",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the chat, issue, uploads and library sources, write a clear, jargon-free statement of what is needed and why, tied to a concrete workflow. Post it on the GitHub issue, not in chat, and ask the requester and stakeholders to review it.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Synthesise",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#A_Synthesise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_needs.ba_reviewneeds",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review synthesised needs statement",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA reviews what the agent synthesised and checks it against what they actually need.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_ReviewNeeds",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#BA_ReviewNeeds",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_needs.s_confirmneeds",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm needs statement",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders confirm, on the issue, that the needs statement says what they need — or say what to change. A stakeholder's judgement; an agent does not record it for them.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_ConfirmNeeds",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#S_ConfirmNeeds",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.a_compareoptions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 4a: Compare the viable options",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Phase 4 often ends with a CHOICE rather than a plan, and this is the step that hands it over. Per option: what it does, its pro, its con, what it changes DOWNSTREAM, and how reversible it is — laid out where the rows can be read against each other, then one recommendation and a stated default. A step of its own rather than a line inside A_DefineReqs, because it has a different output and a different reader: the impact analysis is for the record, the comparison is the thing the BA answers from. Folding it in is how it gets skipped — the analysis feels finished, so the options go over as a list of names. When Call_Wireframe ran, its wireframe candidates are among the options: one row per candidate, with a link to its web and mobile screenshots. Skipped legitimately when the analysis yields ONE viable approach. Do not manufacture alternatives to fill a table.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_CompareOptions",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_CompareOptions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.a_definereqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phases 3–4: Define requirements + impact",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Two skills, because this step is two things: the requirements come from the CRDM process, the impact half is a question about the entities and relations the change touches, which is what data modelling answers; a folio-content skill such as `content-graph` is not one this harness diagram can bind.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_DefineReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_DefineReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.a_mapworkflow",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 2: Map current workflow (BPA)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Business-process analysis here means reading the existing diagrams under processes/ and drawing the gap, so the skill that implements this step is the BPMN one.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_MapWorkflow",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_MapWorkflow",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.ba_reviewreqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review requirements and impact analysis",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA reviews the formal requirements and the impact analysis the agent produced. When a requirement changes a rendered surface, the BA (or the requester) also reviews the wireframe candidates, web and mobile, shown wherever the requester will look (the conversation, the issue, the pull request, or several) with staging deep links and screenshots, and chooses one before implementation starts. The agent records the choice; it never makes it.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_ReviewReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#BA_ReviewReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.call_wireframe",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Wireframe candidates (web + mobile)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Design use of wireframe-design-review, before implementation: a written design intent, at least two mid-fidelity candidates each with a web and a mobile layout, the mechanical checks, and a blind review. The candidates are committed as assets of the request's proposal, under docs/proposals/<slug>/wireframes/ beside docs/proposals/<slug>.md, on the feature branch so feature-staging publishes them, and shown where the requester will look, chosen from context — the conversation, the issue the request came from, the pull request, or several of these — each place carrying the same staging deep links and screenshots (feedback-deep-links, point 5: where it goes is a judgement). The requester or BA is the human reviewer and chooses one at BA_ReviewReqs. A wireframe is part of the design process for adjudication (methodologies/wiregen.md). The candidates ARE the options A_CompareOptions lays out, so this merges into it rather than producing a second comparison.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Wireframe",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#Call_Wireframe",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_requirements.s_approvereqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Approve requirements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders approve the requirements and impact analysis on the issue, or send them back for revision. Only their approval moves the work to sign-off; an agent never records an approval on a person's behalf.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_ApproveReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#S_ApproveReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_announcebranch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Announce the branch on the issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On CREATING the feature branch, comment on the issue: the branch name, the process and phase, and the beans claimed. Visibility is the whole point — without it a sibling session or a human cannot tell that work has begun, only that it has finished. Deliberately on this edge and not inside Phase 6. The three loops back into A_Implement (increment rejected, MVP not ready, feedback translated) re-enter implementation on the SAME branch, and re-announcing on each would be noise. Announce once, when the branch is created. Before announcing, run the collision review that starts any new unit of work (coordinate, \"Starting new work\"): open PRs and in-progress beans checked against the branch's files and subject, scaled to the blast radius, and the result recorded in the bean before the first edit.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_AnnounceBranch",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_AnnounceBranch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_createbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 5: Create beans",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent mints the implementation beans itself with `beans create`, running the exact-title existence check first. The engine has no `create` op — it claims, notes and resolves the instance's OWN bean — so what this step records here is a note that the plan now exists.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_CreateBeans",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_CreateBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_offerkg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Offer KG destinations for the agreed set",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Without this step, agreed and signed-off requirements exist only as an issue and a conversation, and the knowledge graph never learns them. ONE question for the SET, not one per requirement: a six-phase run can agree many, and asking six times is the same failure as a form that re-asks what it was already told. The options are DERIVED from the graphs this layer declares in `<name>.json`, read at the time of asking, so a layer that adds a graph gets it in the offer without anybody editing a skill. Never a list typed from memory.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_OfferKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_OfferKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_recordkg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run placement, file a bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The offer produces a DECISION, not a node. `placement` then decides layer, graph and node kind — it is the step that catches a hardcoded path or a literal naming one folio — and the authoring itself becomes a bean, because work here is a bean before it is a file. `op=\"note\"` and not `create`, for the reason `A_CreateBeans` above states: the engine has no `create` op — it claims, notes and resolves the instance's OWN bean. The agent mints the authoring bean itself with `beans create`, running the exact-title existence check first, and what this step records is a note that the decision was taken.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_RecordKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.a_recordsignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the sign-off attestation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE RECORD, and not relaxable, because a judgement nobody wrote down is indistinguishable from one never made (`adjudication`, A_RecordEntry). Append one `requirement-signoff` record to `test/attestations/requirement-signoff/<set slug>.attestations.json` — who (kind, id, actor), at, scope (the set or one member), the outcome from the requirement-set code list, the stage it moves the set to, the reason, and the permalink to the issue comment where it was decided — and set the set's `stage` to match. GW_SignoffRecorded after this reads the record back, so this step cannot be skipped by completing it: a sign-off that left no attestation loops here again.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordSignoff",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_RecordSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.ba_choosekg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose a destination, or none",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PERSON'S STEP, and `none` is one of the answers rather than a refusal to answer. A requirement whose whole content is carried by the code becomes a commit and nothing else; a graph that acquires a node for it is a graph with a node nobody will ever read. The default creates NOTHING. An agent that decides on its own that a requirement \"is really a skill\" has manufactured a node nobody asked for, in a graph somebody else maintains — which is what this step exists to prevent.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_ChooseKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#BA_ChooseKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_crdm_signoff.ba_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off on requirements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The business analyst / requester signs off on the agreed requirement set, on the issue: what was agreed and what was deferred. Recorded as their decision, with its reason, never by an agent on their behalf. It IS an adjudication: it calls Process_Adjudication with the requirement-set answers, and every answer goes through A_RecordSignoff before anything follows it.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_Signoff",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#BA_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_criterionadjudication.a_dispensation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grant a dispensation, with its reason",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The rule applies and this subject is a stated exception. A `kind: \"human\"` entry with `result: \"pass\"` overrides the script's `fail` for that criterion, and ONLY while its `field_hash` matches the current source — so the dispensation is scoped to the version it was granted against, lapses when the block changes, and never becomes precedent. There is nothing to overturn later; the source moving overturns it. A dispensation with no `notes` is not a dispensation. It is an override somebody applied to get to green, and nobody can review it afterwards — which is why this step is not relaxable.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Dispensation",
      "dcterms:source": "cat-harness/processes/process/criterion-adjudication.bpmn#A_Dispensation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_criterionadjudication.a_recordentry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the entry that LEADS — keeping the checker's beneath it",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Not relaxable, and the one step here that is not. A judgement nobody wrote down is indistinguishable from a checker that was never run, so the judgement is free and the record is not. Do not resolve the disagreement away: both entries stay, the adjudication on top under the sweep's most-recent-matching-hash rule. A disagreement between a checker and a reviewer is information, and somebody re-running the check next month needs to find that a checker read it differently rather than a clean pass. `/api/relevance/adjudicate` reached the same rule independently — `human_adjudicated` written alongside, never over, the agent's `assessed_by`.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordEntry",
      "dcterms:source": "cat-harness/processes/process/criterion-adjudication.bpmn#A_RecordEntry",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_criterionadjudication.a_scopecriterion",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the criterion so it stops applying here",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One edit to the criterion rather than ten overrules on the blocks it should never have covered. This branch is the one an adjudicator under time pressure converts into a dispensation, and the conversion is a defect: a dispensation lapses when the source moves, so a mis-scoped criterion granted its way past comes back every time anybody touches the block.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ScopeCriterion",
      "dcterms:source": "cat-harness/processes/process/criterion-adjudication.bpmn#A_ScopeCriterion",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_criterionadjudication.call_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the criterion disagreement",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared judgement — entry condition, untainted dispatch, person-or-agent restriction — asked with THIS question's permitted answers. `cat-harness.processes:adjudication codes` sits here rather than on `A_Adjudicate` inside it because the answers depend on what was asked, and the gateway below is what acts on them: the engine refuses a mismatch between the two. `Process_Adjudication` may also leave at `End_NotAdjudicable` — one entry and no other side is a review or a gate, not a disagreement — in which case nothing below runs and there is nothing to record.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Adjudicate",
      "dcterms:source": "cat-harness/processes/process/criterion-adjudication.bpmn#Call_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.call_alert",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Alert the publication manager",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_PublishAlert — the ONE alert every failing step after the publish button goes through, whichever step it was.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Alert",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Call_Alert",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.call_instancesites",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compose each layer's site [its Tool]",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`compose-docs.ts` composes the docs layers into one Jekyll source (`cat-harness/docs/` as the base, the checkout root's `docs/` laid over it); then each layer that builds a site of its own composes it into that source at `<instance>/`, so the result is one site with one sidebar, search and language selector. The step is bound by the Tool, not by a `calledElement`: the step names skill `docs-generation`, each Tool that satisfies it and composes a site lists its own `subprocesses`, and those carry the steps; which layers compose a site is data in their declarations. A composing Tool may name a post-build pass, which `Task_Build` runs after the Jekyll build. With nothing to compose, the source is left as `compose-docs` wrote it, and that is reported.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_InstanceSites",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Call_InstanceSites",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.call_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify the export",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_PublishVerification: the verifier set over the built tree (`publish-verify.ts`), before the deploy. Its outcome is recorded, not acted on: the deploy goes ahead, and `Task_Judge` judges it after the push.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Verify",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Call_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.task_build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the Jekyll site and the API reference",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Builds the composed source with Jekyll 4 and just-the-docs (`bundle exec jekyll build`), runs each composing Tool's post-build pass, mounts instance-rendered content (`mount-instance-docs.ts`), publishes the translation review projections wherever the checkout has translations (`publish-translation-review.ts`: `assets/translation-status/review.json` and each catalogue's strings projection under `assets/translation-status/strings/`, which a block's 🌐 pane reads), and generates the TypeScript API reference with TypeDoc (`.github/actions/typedoc-api`). The main deploy is a full build: every index is rebuilt from the tree being published. See skill `feature-staging`, section Build types.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Build",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Task_Build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.task_closealert",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the publication manager's alert, if open",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A clean publish resolves whatever the last failure raised: close the open publication-manager tracking issue with a comment naming this run.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CloseAlert",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Task_CloseAlert",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.task_export",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Export the knowledge graph and its schema",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Exports the knowledge graph and its schema into the published tree (`kg-export.ts`, `harness-schema-export.ts`, `kg-viewer.ts`), stripping the unpublished graph typologies, then runs the built-site checks: every maintained artefact is present (`bun run cat check:maintained-artefacts`), no block-level markup escaped (`check:escaped-markup`), the QA witnesses and results are published, and the navbar tiles resolve. Each outcome is recorded, not acted on: `Task_Judge` judges them after the push.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Export",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Task_Export",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.task_judge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Judge the built-site checks",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reads the outcomes `Task_Export` and `Call_Verify` recorded (maintained artefacts, escaped markup, QA witnesses and results, navbar tiles, the export verification) and fails the run if any failed. The site is already live, so a failure here means a published site with a known problem, not a withheld one.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Judge",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Task_Judge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.task_publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Push to the CDN (full replace)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Calls Process_RenderKgToCdn with the built tree, the site root as publication root URL, and GitHub Pages as target, so its `gh-pages` Tool (`publish-gh-pages.sh`) replaces the branch and returns the push's status and message. A status other than `pushed` takes `no` at Did the deploy succeed?.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Publish",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Task_Publish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.task_regenerate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Regenerate every derived reference from its source",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Regenerates every derived reference from its source, so the site is never built from committed copies that may be stale: the derived artefacts kept off the commit (`bun run cat derive:publish`), the skill schema and instruction pages (`gen-schema-docs.ts`, `gen-skill-docs.ts`), the content-backed docs pages (`gen-docs-pages.ts`), the graph projections and viewers (`schema:viz`, `library:viz`, `uploads:viz`, `voices:viz` and others), the handler and translation indexes (`handler:index`, `translation:index`), and the BPMN drawings and process pages (`render:bpmn`, `processes:viz`). After a main deploy, `writer-records` reruns every writer and QA step under strace to record its reads, so a preview reruns only those whose reads changed; the main deploy runs everything.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Regenerate",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Task_Regenerate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.task_restore",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Restore the OPEN PRs' staging previews",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Copies every open pull request's `branches/<slug>/` preview from `gh-pages` into the publish directory before the replace, once per publish attempt (`restore-staging.ts`, run inside `publish-gh-pages.sh`). Only open PRs' previews are carried; a branch that cannot be read refuses the publish.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Restore",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Task_Restore",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_docssite.task_securitygate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the release security gate",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat security:gate`, before the site is built. It runs every security check the repository names: workflow injection, secret leaks, lockfile and toolchain pins, QA reviewer permission, materialised fixity, and third-party action SHA pinning outside staging-only workflows. Each reports pass, fail or unknown; a blocking fail or unknown refuses the publish.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_SecurityGate",
      "dcterms:source": "cat-harness/sdlc/processes/docs-site-publish.bpmn#Task_SecurityGate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.h_confirm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Repeat the slug, exactly, to confirm",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step in this process that is a person's. Repeating the slug is not ceremony: it names the artefact being confirmed, so a confirmation cannot be inherited by a later run pointed at a different preview.",
          "@language": "en"
        }
      ],
      "skos:notation": "H_Confirm",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#H_Confirm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the docs site",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build the preview from the PR's head (or, on an off-critical-path verify_pr dispatch, rebuild refs/pull/<n>/merge in full to verify an agent-built preview) and write _build-record.json: regenerate the generated docs, trim what this preview does not need, render the BPMN diagrams, then Jekyll, TypeDoc and the knowledge-graph export, with the staging banner and SEO identity claims stripped. It is a PREVIEW build (CAT_BUILD_TYPE=preview, owner 2026-11-01): only what the change reaches, and every whole-corpus index (builtAtPublish entries marked index: true, and the search index) is main's copy, put back rather than rebuilt. A branch frozen for public comment is dispatched with build_type: full instead. Skill feature-staging, section Build types. A PREVIEW REBUILDS ONLY ITS DEPENDENCY CONE (owner cards Q-CONE-1 C and Q-CONE-2 B, 2026-11-01): main's writer records say what each derive:publish writer and each step of the QA working copy READ. A writer or QA step whose recorded reads all match is not run, and main's outputs for it are put back. Every other one runs. QA is not left out of a preview, only narrowed to what the change can reach. Inside a preview's QA build, `skill:register` also leaves to derive:publish the two pages that derive:publish builds anyway and that no later QA step reads (`skills:docs` and `lsi:viz`), so they are built once.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Build",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment the preview URL on the PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Post, or update in place, one comment on the PR giving the preview URL (branches/<slug>/) and the commit it was built from. On an off-critical-path verify run (verify_pr), also set the preview/agent-build commit status on the PR head (success when the agent build matched and built-site checks passed, failure when files differed or built-site checks failed) and record the verification outcome in the PR comment.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Comment",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_defer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Defer build and queue verify sweep",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Set the preview/agent-build commit status on the PR head to pending, post the preview-build-verify notice on the PR, and exit the critical-path run so the runner is free. Off the critical path, preview-verify-sweep.yml (on staging workflow completion and every 15 minutes) waits until no Feature Staging run is active or queued, selects the oldest open PR whose head still has preview/agent-build = pending, and dispatches feature-staging.yml with verify_pr to rebuild and verify the agent's preview.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Defer",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Defer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_deploy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Push to the CDN under branches/",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PREVIEW IS THE GENERAL STEP WITH A DIFFERENT ROOT (owner, 2026-09-30: \"independent of staging vs publication … just rendering\"). Process_RenderKgToCdn, entered with the tree Task_Build rendered, `branches/<slug>/` under the site root as the publication root URL, and GitHub Pages as the target, so its `gh-pages` Tool pushes. For this target the push is `keep_files: true` with a `destination_dir`, so it adds one directory beside whatever else is on the branch; it is also RETRIED once: five other workflows push to `gh-pages` without joining this one's concurrency group, and a queue does not help because GitHub CANCELS a pending job when a newer one arrives for the same group rather than queueing it. Measured 2026-09-19: three staging runs from three different branches inside 17 seconds, two cancelled. The call returns the push's status and message; the render log and the PR comment that follow are this process's own. THE PREVIEW CAP rides in the same commit (owner ruling 2026-10-02, issue #1868: \"cap the maximum number of previews (<= 10) and rotate old ones off\", amended 2026-10-04 to a SIZE budget: \"Cap by size, not count\", \"3gb\"): `staging-rotate.ts` keeps this preview plus the most recently updated others while their total fits MAX_PREVIEW_BYTES = 3 GB and removes the rest, oldest first, each with a `removed` render-log entry and its record retired into branches/_retired/. Every push attempt re-reads `gh-pages` and re-decides rather than rebasing, so a lost race never pushes a stale removal. A rotated-off preview is regenerated by the next push to its PR branch.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Deploy",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Deploy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_logrendered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `rendered` to the render log",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Its OWN commit, not part of the deploy. The publish action writes only into `destination_dir`, so an entry riding in `_site` would land at `branches/<slug>/_render-log/` — inside the directory a cleanup removes, which is the one place a record of the removal must not be. `continue-on-error`: a preview that deployed and whose entry did not is a gap in the record, not a failed deploy.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_LogRendered",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_LogRendered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_logretained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `retained`, with why it stays",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_LogRetained",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_LogRetained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_notice",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the retention notice on the PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Removal was not confirmed, so the preview stays: post a retention notice on the PR giving its URL and saying it has NOT been removed, and the two ways to remove it: the staging:cleanup label while the PR is open, or, once it is closed, a Run workflow dispatch with cleanup_slug and a matching cleanup_confirm.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Notice",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Notice",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_preflight",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-evaluate liveness AT REMOVAL TIME",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-evaluated AT REMOVAL TIME, through the same `previewLiveness` the health sweep uses rather than a second implementation of it. The sweep runs daily and proposes; this acts. Between them a branch can come back to life — bean `w2g5` documents exactly that, a session reusing one branch across five successive pull requests.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Preflight",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Preflight",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_remove",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove the preview and log it",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "ONE COMMIT for the removal and its record. A separate log push can fail on its own and leave a preview that vanished with nothing saying why — which is the exact state bean `plj1` left the branch in. `render-log.ts` refuses a `removed` entry with no reason, so this step fails loudly rather than writing a record that says an artefact went and not why.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Remove",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Remove",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_removedisp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove it AND append `removed` — one commit",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Say what is going — size and file count — then remove branches/<slug>/ and append `removed` to the render log in the SAME commit, so a preview cannot vanish without a record of who dispatched it and why. The slug is a dispatch input, so the tool re-checks it by value rather than trusting the guard.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RemoveDisp",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_RemoveDisp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_slug",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Derive the slug from the head ref",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Derive the slug from the PR's head ref: every character outside [a-zA-Z0-9._-] becomes '-', runs of '-' collapse, and leading or trailing '-' is trimmed. It must be one safe path segment, checked by value.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Slug",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Slug",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_featurestaging.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the slug and its confirmation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Guarded three ways because a dispatch input is a DELETION TRIGGER. `workflow_dispatch` is available only to an actor with write access; the slug must match exactly the characters the sed pipeline can produce, with `.` and `..` refused by name; and the confirmation must repeat the slug, so a confirmation cannot be carried over from an earlier run against a different preview.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "cat-harness/sdlc/processes/feature-staging.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_generatedfiledrift.task_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Regenerate from the source and diff",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the caller's generator with --check: regenerate the file from its source in memory and diff it against the committed copy. Several independent generators run in one job are still one step, because they have no order between them.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Check",
      "dcterms:source": "cat-harness/sdlc/processes/generated-file-drift.bpmn#Task_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the extraction",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step no package may relax. A repository cut changes the substrate every other diagram's lanes bind to, and that is a person's decision.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Authorise",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief the topic before touching anything",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What am I doing and why is it worth doing; what do I already know, with each measurement's provenance; how do I plan to do it and WHAT WOULD FALSIFY THE APPROACH. A falsifier that never fires is decoration.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "1 · Declare in place (nothing moves)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `<name>.json` entry with its `graphs[]` kinds. A sub-graph that owns its own layout gains a NESTED declaration whose paths resolve against its own directory, so the whole graph relocates by moving one folder.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "4 · Extract — a directory move, not a file-by-file sift",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once edges are zero and the declaration stands alone: move the sub-graph out as one directory move, not a file-by-file sift. Its nested declaration resolves paths against its own directory, so moving the folder moves the graph. The five-point gate is in migration-plan.md Phase II.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Extract",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_isolate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "3 · Isolate — own declaration, namespace, artefact",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once cross-edges measure zero: give the sub-graph its own declaration, its own namespace and its own published artefact, as bootstrap/ has (its own declaration, bs: namespace and graph document). Nothing moves yet; the sub-graph now stands alone in place.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Isolate",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Isolate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2a · Measure — unassigned column FIRST",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat check:partition`. Read the unassigned column before the edge count, and quote BOTH numbers rather than only the one that improved. The edge count can rise when the measurement improves (previously unjudged edges are folded in); that is correct.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Measure",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2b · Prune, merge, factor — or the classification is wrong",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The only four moves. Move the shared TARGET first and the importers after; check the target's layer before the importer's; a schema moves with its script. The fix is never an exemption, it is the right owner.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Move",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_graphdetanglement.task_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what would move — sizes, and what breaks",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports and waits: what would move, how large, what in the parent breaks, and the rollback. `deletion-requires-confirmation` is not a courtesy to waive: an agent never removes or relocates a durable artefact on its own initiative.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Propose",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.d_ask",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask the person",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The sibling's ask, unchanged in letters and recommendation, through `Process_AskThePerson`: the full chat text first, naming the sibling and that the answer will be passed on, then the card. A tap on the sibling's own card or a Blue-column answer in the sheet answers it too; take the first.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_Ask",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#D_Ask",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.d_inform",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post it in the discussion",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Say it comes from the sibling (title and link) and give the context or result in full. State `informed`.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_Inform",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#D_Inform",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.d_markanswered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mark every copy answered",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Chat copies keep their text: the question struck through and \"[Edit: <letter> chosen by <who>, <time>]\" added. Cards closed with the chosen option. The sheet's \"Decision needed\" block replaced by the decision and who made it. Withdrawn or superseded hand-backs marked the same way, with the reason.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_MarkAnswered",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#D_MarkAnswered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.d_routeback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Route the answer back, quoted",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On `answerRoute`, with the person's own message attached by id where the host allows, so the sibling can treat it as the person's approval. A paraphrase is never approval.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_RouteBack",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#D_RouteBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.s_act",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Act on the answer",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never ask the person again for what they answered. A rule-level answer goes into the governing skill in the same turn.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_Act",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#S_Act",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.s_compose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compose the hand-back and post it in own thread",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compose it once, against the input schema: a question is the full ask-the-person input (what will differ, context, lettered options with a one-line trade-off each, the recommendation, what happens with no answer); context, a result or a blocker gets the same stand-alone test. Post it in your own thread too, chat text then card. Your own thread is never the only copy.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_Compose",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#S_Compose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.s_handback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand it back to the discussion agent",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "By the host's route: `message_coordinator` or `message_thread` in Claude projects; the final report (a json block valid against the input schema) for a subagent; `SendMessage` for a sibling session. Then keep working on the recommended option where it can be undone, or stop if `blocking`.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_HandBack",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#S_HandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_handbacktodiscussion.s_mirror",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mirror it to the feedback channel",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review sheet: the \"Decision needed\" block in the row's agent column, Agentic status `Needs you` (the document layer's `review-sheet-script` skill). Issue or PR: a comment. An extra copy, never instead of the discussion.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_Mirror",
      "dcterms:source": "cat-harness/processes/process/hand-back-to-discussion.bpmn#S_Mirror",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_board",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Draw the board of todos and beans",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The todo board mounts inside the landing board, so harness cards and todo stickies share one surface. Each card carries an edit link only when the build composed one.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Board",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Board",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_ground",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve each harness's page ground",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The theme art for that harness's pages, all three crops or none, and the URL scopes that make a page that harness's (`pageGround`). The site owner's ground is the fallback for a page no scope claims.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Ground",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Ground",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_nodeviews",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report node-view coverage",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Tool `node-view-coverage` (`bun run cat node-views:report -- --site <built site>`) counts, per layer, folder and kind, which nodes have an IRI, a `.jsonld`, a page and a row on their folder page, and which folder links are dead or point at the raw repository. A QA report, not a gate: it always exits 0 and feeds no gateway, and its results go to `test/results/node-views/` and on to the `qa-reports` branch. A graph with no viewer is still shown inert and labelled by the tile step; this says how many of its nodes are owed a page.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_NodeViews",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_NodeViews",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Propose the change",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through whichever write tool the session has. The change is a proposal: it goes into the content change review, which decides whether it is published.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Propose",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish docs on their theme's art",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`head_custom.html` sets the ground behind every page of the harness, under two scrims of the page's own colour, so text and links keep the plain page's contrast.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Publish",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Publish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_read",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read a page or a card",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The floor of the interface: everything a harness publishes can be read with no account and no tool.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Read",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Read",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_tiles",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compose each harness's nav and tile",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One themed section per layer in dependency order, from its declaration: its docs, its declared subgraphs (a graph with no viewer is shown inert and labelled), and its theme. Written to `_data/harness.json` by `sync-docs-harness.ts`.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Tiles",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Tiles",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_harnessrendering.a_todo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it as feedback",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "With no write tool the reader's point is not lost: it is recorded as feedback for someone who can write.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Todo",
      "dcterms:source": "cat-harness/processes/ui/harness-default-rendering.bpmn#A_Todo",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_appenddisclaimer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append WHO disclaimer (if DAK)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "For WHO SMART Guidelines content, automatically appends the WHO legal disclaimer: - Translation not created by WHO - English edition is authoritative original - WHO not responsible for translation accuracy Only applies when folio contentType includes WHO/DAK content.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AppendDisclaimer",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_AppendDisclaimer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_assigntranslator",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Assign to qualified human translator",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The coordinator assigns the translation to a qualified translator, ideally a domain SME for the content area. For WHO content, the translator should be familiar with WHO SMART Guidelines terminology. The assignment includes: - The .pot file(s) from extraction - The domain glossary - Context notes (block kind, chapter, content area) - The deadline",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AssignTranslator",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_AssignTranslator",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_checkcompleteness",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check translation completeness",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify that all msgid entries have msgstr translations. Partial translations are acceptable for initial submissions but must be flagged for follow-up. The coordinator checks: - % of strings translated - Any fuzzy-flagged entries - Missing critical sections",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CheckCompleteness",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_CheckCompleteness",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_extractpot",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract the POT",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ExtractPOT",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_ExtractPOT",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_identifycontent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify content and target locale",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The coordinator selects: - Which content nodes need translation (block, section, chapter, or folio) - The target locale (one of the supportedLocales in <name>.config.json) - The priority and deadline",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_IdentifyContent",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_IdentifyContent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_injectpo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject the PO",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_InjectPO",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_InjectPO",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_prepareglossary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare domain glossary",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Builds the locale term base for the target locale from the layered glossaries, has it reviewed, and hands it to the translator with the POT. Each layer's glossary is the directory it declares with the `glossary` graph typology. Precedence, within one subject area (the scheme's `subject`): the more authoritative (lower) layer fixes a term's translation; a layer only adds, and may not give a fixed term a second translation. A match in another subject area is a sense check for the reviewer, not a violation. Previous translations of related content are evidence for a term with no fixed form, not a source that overrides one. A fixed translation is an authored term with a non-empty, non-fuzzy msgstr in its scheme's catalogue (translation-manager, \"The locale term base\").",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PrepareGlossary",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_PrepareGlossary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_receiveassignment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Receive assignment and materials",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator receives: - .pot file with source strings (msgid) - Domain glossary with approved term translations - Context notes per string - Style guide and WHO terminology references Tools: Poedit, Weblate, Crowdin, or direct .po editing.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReceiveAssignment",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_ReceiveAssignment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_requestmorework",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Request completion of remaining strings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Return to the translator with a list of untranslated or fuzzy strings that need attention.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RequestMoreWork",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_RequestMoreWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_returnforcorrection",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Return for correction with annotations",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer annotates specific passages that need correction and returns to the translator with detailed feedback. Each annotation includes: - The passage in question - What is wrong (terminology, meaning, style) - The suggested correction or reference",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReturnForCorrection",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_ReturnForCorrection",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "No gateway follows: drift or clean, the translation goes to Task_SMEReview with the findings attached. Which of two readings is right is a human call (translation-manager, \"route drift to a human reviewer\"), and every translation in this workflow is reviewed and signed off anyway, so a clean result is evidence for the reviewer and never a way around them. The findings include `translation:glossary:check`'s: every glossary term translated against the locale term base, fixed before sign-off, with its glossary section in the KG QA report.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RoundTripQA",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_RoundTripQA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off translation as official",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer signs off the translation, making it official. This records: - signedOffBy: the reviewer's identity - signedOffAt: the current timestamp - sourceHash: SHA-256 of the source .md - level: block | section | chapter | folio Tool: translation_signoff MCP tool",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Signoff",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_smereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review translation for accuracy",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A subject-matter expert reviews the injected translated markdown for: - Clinical/technical accuracy of terminology - Preservation of meaning from the source - Cultural appropriateness for the target locale - Consistency with the domain glossary For WHO content: the SME verifies that normative statements (\"SHALL\", \"SHOULD\", \"MAY\") are translated with the correct force in the target language.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_SMEReview",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_SMEReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_submitpo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Submit completed .po file",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator submits the completed .po file back to the pipeline. This may happen via: - Git commit + push - Weblate/Crowdin sync - File upload to the coordinator",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_SubmitPO",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_SubmitPO",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_translateintool",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate strings in preferred tool",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator works through each msgid, producing msgstr translations. They: - Follow the domain glossary for technical terms - Preserve placeholder tokens ({1}, {2}) in position - Mark uncertain translations as #fuzzy - Note any source ambiguities for the coordinator",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TranslateInTool",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_TranslateInTool",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_humantranslation.task_writestatus",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (official)",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_WriteStatus",
      "dcterms:source": "cat-harness/library/processes/human-translation-workflow.bpmn#Task_WriteStatus",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingestion.task_cataloguereference",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record it in library/ as referenced",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The referenced branch. Nothing is fetched and no bytes are written: the catalogue record says where the asset is and that we hold none. A reference is not a fetch — it stays navigable without being held, and materializing it later is `materialize-remote.bpmn`'s decision, with its purpose and five gates, not this flow's.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CatalogueReference",
      "dcterms:source": "cat-harness/library/processes/document-ingestion.bpmn#Task_CatalogueReference",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingestion.task_extractmetadata",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract its metadata into the KG",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE METADATA STEP. What enters the knowledge graph is the asset's INDEX — what it is, how big, what type, when it says it was written — and, for a container, what is in it; its contents do not go in unless somebody asks, with a reason. The tool is `cat-harness-tools/scripts/extract-assets.ts`, writing a `folio-extraction/v1` record (`schemas/content/extraction.ts`). The media type is sniffed from the leading bytes, never taken from the extension.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ExtractMetadata",
      "dcterms:source": "cat-harness/library/processes/document-ingestion.bpmn#Task_ExtractMetadata",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingestion.task_place",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place it in uploads/ by a declared route",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE FIRST LINK: everything downstream of here takes a file that is already in the queue, so without this step how the file got there is governed by nothing. WHAT THIS STEP IS. The basic flow's ACCEPT step: choosing an arrival route, writing the bytes into the declared queue of the layer that will own them, and discharging what that route does not discharge for you. The routes, what each writer owes, and the two that are mechanisms against the one that is a persona are in the `upload-routes` skill; `upload-url` composes the forge URL for the web route from the declaration rather than from a literal, because a hand-written one can 404. WHY A PLAIN `bpmn:task` AND NOT A `userTask`. A `userTask` asserts a human performs it, and this lane is \"Contributor (human or agent)\" because both do; asserting human-only would be an `activity-fulfilment-kind` contradiction. A plain task asserts nothing about the performer. WHY THE BEAN OP IS `note` AND NOT `claim`. Placing a file claims nothing; it adds to a queue. What it owes the work plan is visibility. A note against the ingestion bean is what makes the queue's growth something another session can see.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Place",
      "dcterms:source": "cat-harness/library/processes/document-ingestion.bpmn#Task_Place",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingestion.task_placeinlibrary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place the asset in library/<slug>/",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The materialized branch. The asset lands in library/<slug>/ with its metadata record, its provenance and its fixity. The folder name IS the citation key, so a citation and a directory are the same string. The upload is then RETIRED, not left and not deleted: it moves to fsh-guts/uploads/ beside a sidecar naming where it came from and when, and `check:uploads-retired` finds one that was not. A refining process that derives content from the bytes does so before that retirement; `library-ingestion` carries the rule.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PlaceInLibrary",
      "dcterms:source": "cat-harness/library/processes/document-ingestion.bpmn#Task_PlaceInLibrary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_contradictions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record contradictions IN the source",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A step because sources do contradict themselves (one colour given two values on different pages). A contradiction silently resolved is indistinguishable from one nobody noticed, so it is kept as data and the reading taken is stated as a choice.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Contradictions",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_Contradictions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_maproles",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Map values onto palette roles",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "surface / ink / edge / accent, shared across every kind. A palette per kind would be three spellings of \"accent colour\", free to disagree about what an accent IS. Where the source is SILENT on a role, say so and mark the value a choice rather than dressing an invention as a measurement.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_MapRoles",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_MapRoles",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_readguide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the guide's own stated rules",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the INGESTED document's sections, not from a screenshot and not inferred from a site that happens to use the brand. Units stay as the source gives them: rewriting 29.7cm as millimetres is a conversion nobody asked for and a chance to be wrong.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadGuide",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_ReadGuide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_readstylesheet",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the served stylesheet's declarations",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the ROLE, never the prettiest value. Bootstrap's --blue is a scale entry and --primary is the role; DSpace sets them differently, and taking the brand-looking one is the hardcoding schemas/ui/theme.ts exists to end. Column widths come from declared columns, never from breakpoints: a breakpoint is a viewport.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadStylesheet",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_ReadStylesheet",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_ingesttheme.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Theme and UI review",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "THEME REVIEW HAPPENS HERE AND NOWHERE ELSE: graphical assets are reviewed at ingestion, in the context of the website or app design they are for. So this step CALLS `theme-ui-review.bpmn`. WHAT THE CALL COSTS, stated rather than hidden. The subprocess has a human step, `R_Judge`: a person looks at the ingested assets laid out in their design at a web and a mobile width. So ingesting a THEME SOURCE is attended at that step. Ingesting anything else stays unattended: it never reaches this subprocess. THE AUTOMATED CHECK IS INSIDE THE CALL. \"A theme sets the stripe's hue; it never sets its width to zero\" — colour alone carrying a whole signal fails WCAG SC 1.4.1, and the WHO guide agrees (\"Never red with green, never blue with yellow\"). That check is `A_Accessibility` in the called process, which measures contrast against the real ground and requires a non-colour channel wherever colour carries meaning.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_jsonlddrift.call_drift",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the .jsonld siblings are in sync",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the five --check generators in one job — the JSON-LD context, block siblings, library nodes, site graph, then the label-resolution and emitter tests. Any committed .jsonld that differs from what its generator now produces fails the PR, because a stale generated file is still consulted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Drift",
      "dcterms:source": "cat-harness/sdlc/processes/jsonld-drift-check.bpmn#Call_Drift",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.call_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the extraction",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Report what moves and ask the administrator. A repository cut changes the substrate every other process binds to; that is a person's decision.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Authorise",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Call_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.call_cutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cut over",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Retire the parent's copy and measure the cutover until it is complete or cannot be shown complete.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Cutover",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Call_Cutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.call_move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move it into its repositories",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the repositories, drain, seed, consume additively, release, and check every identifier dereferences.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Move",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Call_Move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.call_prepare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare it to stand alone",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Identity, hosted output, the content-tools split, the publication plan, and the standalone rehearsal.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Prepare",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Call_Prepare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief the work",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the work is and why, what is already measured with its provenance, how it will be done, and what would falsify the approach. The work item is already taken up when the process starts, so a sibling session sees the work before the brief is written. Here the work is a separation: what is separating, and why.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.task_decide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask whether to separate it",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner decides from the measured signals, and also decides the address base for its identifiers, where verdicts about it live, and what its tools repository owns. Declining is a real outcome: the graph stays where it is.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Decide",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Decide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.task_detangle",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare, detangle, isolate",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The graph-detanglement practice, all of its gates: declared in place, zero wrong-direction edges on every axis, and standing alone with its own declaration, namespace and artefact. A plain task on purpose, not a call to graph-detanglement.bpmn: that process ends in its own authorise-and-extract steps, which here are stages 9-13 of this one, and calling it would run them twice.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Detangle",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Detangle",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparation.task_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Measure the signals",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Files and bytes per layer, clone cost (`bun run cat health`), gate time, merge contention, the candidate's cohesion and cut (`kg:detangle`), wrong-direction edges, and the would-be tools package's import cone. Recorded in the work context; none alone is a trigger.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Measure",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationauthorise.task_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask to authorise the extraction",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A repository cut changes the substrate every other process binds to; that is a person's decision. Declining leaves the graph declared, detangled, isolated and split in place.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Authorise",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-authorise.bpmn#Task_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationauthorise.task_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what moves — sizes, what breaks",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports and waits: what would move, how large, what in the parent breaks, and the rollback. `deletion-requires-confirmation` is not a courtesy to waive: an agent never removes or relocates a durable artefact on its own initiative.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Propose",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-authorise.bpmn#Task_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationcutover.task_cutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cutover: retire the parent's copy",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one commit worth reverting, made only after the parent consumes the release and every identifier dereferences. It retires the parent's copy, frozen, never refreshed and never rendered, rather than deleting it. Where the copy goes is the sub-kg-lifecycle skill's stage 13; this diagram does not name that store, because the published graph must not.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Cutover",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-cutover.bpmn#Task_Cutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationcutover.task_cutovercheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Measure the cutover: separation:cutover:check",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run `bun run cat separation:cutover:check --site` in the SEPARATED repository (Tool `separation-cutover-check`). Six conditions, each decided by an existing gate and none assumed: every declared layer mounted at its pin; every path a declaration names resolves (`check:declaration-resolution` — directories, assets, visualisers, needs); no wiring still names the monorepo (`livesAt`, a submodule, a reusable workflow, a path into the old checkout); no import or reference against the layer order; and the site builds from the mounts alone. A finding inside a mounted layer is upstream's and is listed, not counted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CutoverCheck",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-cutover.bpmn#Task_CutoverCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_consume",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Parent consumes, additively",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The parent pins the pair (a commit while staging, a version once released) — a code dependency as a `source.remote` instance in its root `index.config.json` (remote-mount skill), never a submodule — repoints its imports, and keeps its own copy until it is green with the dependency declared. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `upstream-version-adoption` (`Process_UpstreamAdoption`, sdlc/processes/upstream-version-adoption.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Consume",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Consume",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_create",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create the repositories",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner creates the content and tools repositories and their Pages. Nothing is committed to them before this.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Create",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Create",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_drain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Drain: land, close or re-target the open PRs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Work the PRs `seed:ready` named until the source settles: land or close the heavy movers and the next layer's PRs, bring the layer's open PRs to five or fewer, and finish any move in flight. Fix a red rehearsal or a discovery miss where it is. Nothing is seeded from here; it goes back to the gateway, which re-asks.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Drain",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Drain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_freshclone",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify on a fresh clone",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat sub-kg:verify-clone --repo <owner>/<name> --ref <branch>` (Tool sub-kg-verify-clone): clone into an empty scratch directory with submodules and any sibling it needs, install, and run its own gates. Green, red or unknown, and unknown is never green. Nothing in a seed runs standalone until the seam is re-pointed, so a missing module shows here.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_FreshClone",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_FreshClone",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_release",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "First release",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tag each repository, publish /v<major>/. From here the two are versioned independently; a tools release lists the content majors it supports.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Release",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Release",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_repoint",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-point: livesAt, seam, mount or subscription",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the new repository `livesAt` goes (absent means it sits at the root of `repository`) and `platform.ts` points at where the platform now is. The host consumes it as a remote mount (a `source.remote` instance in its root `index.config.json`) if it imports its code, or a subscription if it only reads its content, pinned to a commit while staging. Additive: the host keeps its copy.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Repoint",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Repoint",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_seed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed both repositories",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Seed main, then bring the content and the tools in as reviewed pull requests with their history, so neither repository's first commit is unreviewable. The seed includes every publisher the declaration promises (`sub-kg-lifecycle` stage 10): a `qa` directory with `storage` needs `.github/workflows/publish-qa.yml`, the caller of the tools layer's `layer-qa-publish.yml`, and `test/results/` ignored. Without it the declared store is never written, and once the layer stops committing its results no reader finds them. Once `main` is on each new repository, create the state branches its declaration names (`bun run cat state:seed --init` from a checkout of that repository, the same step `state:mount` and `folio_init` run): the layer that declares a state branch creates it, and a layer that mounts it never does.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Seed",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Seed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationmove.task_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Every identifier dereferences",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "After the release is live, every published identifier resolves to the file it names. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `publish-verification` (`Process_PublishVerification`, sdlc/processes/publish-verification.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Verify",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-move.bpmn#Task_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_hosted",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move harness output about it to the host",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "QA verdicts, translation templates, the exported graph and the glossary ledger are harness output ABOUT the graph: they live with the harness (kgQaHomeFor, translationsHomeFor). The content keeps only what its own checks need; the leak test's pending list is empty. The one exception is a separated layer that declares a `qa` directory of its own with `storage`: its verdicts are its own repository's, published to that repository's qa-reports branch (step 10), and read by a host at the commit it pins.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Hosted",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Hosted",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_identity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identity: version, iriBase, nodeSchemas",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The declaration carries name, version, iriBase, needs and nodeSchemas. A base move is `bun run iri:sync -- --from <old base>`, once; then `iri:sync:check` and `check:node-iris` are green.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Identity",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Identity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Plan publication",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every identifier the content mints is a file some step publishes: /v<major>/, for what programs read and pages people read alike; the exact release is the pin's. Name collisions between published files are resolved here.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Plan",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_rehearse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Rehearse standalone",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Copy the content and the tools alone into a temporary directory, with nothing else on the path, and run the tools' checks there. An empty tree must exit non-zero, so a rehearsal over nothing cannot pass.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Rehearse",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Rehearse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgseparationprepare.task_split",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Split content from tools",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create <name>-tools as a sibling directory and move the code: the Zod source, the generators, the README and diagram writers, the content checks. Cut its import cone to its own files and declared packages. Both start at the content's version.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Split",
      "dcterms:source": "cat-harness/processes/kg/kg-separation-prepare.bpmn#Task_Split",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.a_distribute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish to the origin (a cache may front it)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reach host behaviour through publication.host, never by assuming GitHub Pages' behaviour — Pages CANNOT serve application/ld+json and a local server can. A CDN in front is a layer, not the host: the canonical URL stays the origin's, and the cache is an accelerated route to the same bytes. Uploading and exposing are separable steps on purpose, because collapsing them removes the last moment at which a bad URL layout can still be caught.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Distribute",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Distribute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.a_package",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Package with digests",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The serialization alone is not a package. A package is an addressable set — the JSON-LD, the assets it references, and a manifest naming every file with its digest and byte count. The manifest is what makes a REMOVED file detectable, which a per-file signature cannot do on its own.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Package",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Package",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.a_select",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cut the subgraph that leaves",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Apply the editorial scope mechanically and report what it removed. A selection that reports nothing cannot be told from one that ran over an empty rule.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Select",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Select",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.a_serialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Serialize to JSON-LD",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "kg-export, already built and host-agnostic by design. Every edge term declared {\"@type\": \"@id\"} — without that coercion the document is a list of records that merely LOOKS linked, and the node IRIs are fragments of the document's own @id so the graph is mergeable with anyone else's.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Serialize",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Serialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.d_constraints",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "State the constraints, with denominators",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Money, network traffic, graph size, latency. Each needs a NUMBER and each number needs a denominator, because a constraint with no denominator is a preference: \"the graph is too big\" is not a finding, \"6.2 MB per publication against a 100 GB free tier\" is. Say which figures were measured, which were quoted from a vendor, and which could not be obtained; a figure from a chat message is none of the three.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_Constraints",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#D_Constraints",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.d_undetermined",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the decision as still open",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An undetermined decision is DATA, not silence. It is recorded with what it waits on and what would settle it, so the next session can tell \"nobody has chosen\" from \"somebody chose and did not write it down\" — the same third state bean-blocking keeps for a block with no expiry.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_Undetermined",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#D_Undetermined",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.e_humaneyes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Human eyes on the rendered artefact",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Easy to drop because merging to main looks like an approval. It is not: merging approves the CHANGE, and this approves what a reader will actually see. A description cannot stand in for it (`continual-progress`).",
          "@language": "en"
        }
      ],
      "skos:notation": "E_HumanEyes",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#E_HumanEyes",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.e_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Decide what may leave the repository",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "EDITORIAL, and it is stage 1 rather than a filter bolted to the exporter. kg-export produces the WHOLE graph because inspection wants the whole graph; a portal wants what its readers may see. Running the second as the first is how a QA verdict, a bean's blocking note or an unpublished draft reaches a public cache. Decided once, here, rather than at each consumer.",
          "@language": "en"
        }
      ],
      "skos:notation": "E_Scope",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#E_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.p_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify what arrived against what was signed",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Against a GDHCN DID trustlist, which means the verifier needs THE NETWORK and not only the bytes — the key is resolved from the trustlist rather than read out of the package. The trustlist is itself static JSON served from a CDN (`tng-cdn.who.int`), and its path is a hierarchical filter — domain, participant, key usage, with `-` as a wildcard — so a verifier fetches the slice it needs rather than the whole list. The stage that gets dropped, because every other stage produces something visible and this one produces nothing when it passes. A package that is signed and never verified is a package whose signature is decoration. A portal that CANNOT verify reports `unknown` — a portal nobody asked is not a portal that checked.",
          "@language": "en"
        }
      ],
      "skos:notation": "P_Verify",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#P_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_kgtoportal.s_sign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign the package and/or each asset",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE TRUST ANCHOR IS GDHCN, SPECIFIED BY THE WHO SMART TRUST IG. READ OFF THAT IG rather than from general knowledge: a GDHCN trustlist distributes KEY MATERIAL as W3C DID documents, and says nothing about what you wrap your bytes in — the health-certificate envelope is a separate specification in the same IG, and a document package is not a health certificate. So what is settled is where a verifier GETS THE KEY, not what it verifies. A portal that can fetch the bytes but not reach the trustlist cannot verify, which is `unknown` and not a failure — air-gapped is a declared deployment value, so that case is answered rather than assumed away. Still OPEN and unread: the rotation and revocation model, and whether a document-package signature can be expressed for a GDHCN-aware verifier at all. Two schemes with different properties remain to choose between, and the trustlist does not choose between them. A PACKAGE signature over the manifest verifies the SET — nothing added, removed or altered — and must be reissued whenever any file changes. A PER-ASSET signature verifies one file independently, which is what an edge cache serving one asset can actually check, and it cannot detect a removal because there is nothing left to verify. They compose; composing them is the safer and more expensive default, and it is the deployment's choice rather than the pipeline's.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_Sign",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#S_Sign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_answergates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Answer the other four gates",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Restrictions, copyright, retention and source loss, each answered permitted, refused or unknown. They are four answers to one decision, and Gateway_Gates reads them with size through decisions/materialization-gate.dmn. RESTRICTIONS. 'No restrictions known in context' is a STATE, not a green light. GateVerdict is three-valued for this reason alone, and `unknown` is never rendered as `permitted`. COPYRIGHT. What the licence permits for THIS bitstream, and separately whether it permits the derivation. LICENSE-CONTENT.md exists in this repository and the ingestion pipeline does not read it. RETENTION. A copy with no expiry cannot be told from an abandoned one — the same argument bean-blocking makes about a block with no expiry. An ARCHIVAL copy is the exception and it is a specification rather than an omission: freshness() reports it `permanent`, not `no-expiry`. SOURCE LOSS. Not hypothetical. The one IRIS record this repository holds carries a handle on iris.wpro.who.int, a regional instance merged into the global one. Only an ARCHIVAL copy of the original bytes discharges this; a working copy cannot, because the derived sections are not the publication.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AnswerGates",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_AnswerGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the node materialized",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The node's state moves from `referenced` to `materialized`, carrying purpose, localPath, gates and (archival) fixity. There is NO default state: a node that has not said is invalid, because 'the author did not say' and 'the author said they could not tell' are different facts.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_enumerate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Enumerate the source descriptor",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Resolve the request against the source's descriptor (one per corpus, in the declared sources/ of the layer that owns it, e.g. who-iris/sources/), read against cat-harness/schemas/library/source-descriptor.ts BEFORE any gate. Three things come from it and none may be guessed. (1) Which subset strategies the source supports — supportsSubset(). (2) Whether a subset stands on its own: when subsetIsSelfContained is false (mathlib), the request is closed over its dependencies here, and every gate after this one is asked about the CLOSURE, because a subset that omits what its members depend on is not a smaller corpus, it is one that does not build. (3) What enumerating the whole costs — enumerationCost(), which is undefined when the descriptor has no measured denominator; SIZE then refuses rather than estimates. A source with no descriptor is not an error here: it is an unknown, and SIZE refuses on it. The descriptor is CALLED here rather than restated.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Enumerate",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Enumerate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_fetch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch, and record fixity",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch, then record sha256 and byte count. Fixity is REQUIRED for an archival copy: an archive that cannot demonstrate it is unchanged is a copy, and it cannot be re-fetched to check, because the thing it would be re-fetched from is what it exists to survive. The data already exists — every structure.json carries sha256 and bytes, and nothing reads them as fixity.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Fetch",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Fetch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_purpose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the purpose: working or archival",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "working or archival, and it is asked FIRST because three of the five gates mean different things under each. An archival copy keeps the original bytes, never expires, requires fixity, and is the only thing that discharges sourceLoss; a working copy keeps derived content and discharges none of that. A process that gated first and asked afterwards would be judging a copy whose obligations it did not yet know.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Purpose",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Purpose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_size",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Size the take and the whole",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What is being taken, and what the whole collection would cost. REFUSES when it cannot tell: 'three items' with no denominator is not a size answer. 0.7 TB is the measured reason the IRIS import is by reference.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Size",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_Size",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_materializeremote.task_stayref",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it referenced, record why",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A refusal is not a failure of the process — it is the process working. The node stays `referenced`, which means the graph still knows it exists and where, and the refusing gate's basis is recorded so the next caller does not re-litigate it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_StayRef",
      "dcterms:source": "cat-harness/library/processes/materialize-remote.bpmn#Task_StayRef",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergebase.task_abort",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Abort, restore the tree, list what was refused",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`git merge --abort`. Each refused path is listed with its pattern's reason, or \"no declared pattern\".",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Abort",
      "dcterms:source": "cat-harness/sdlc/processes/merge-base.bpmn#Task_Abort",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergebase.task_byhand",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve by hand, then regenerate",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ByHand",
      "dcterms:source": "cat-harness/sdlc/processes/merge-base.bpmn#Task_ByHand",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergebase.task_classify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Classify every conflicted path against the declared patterns",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The first matching pattern decides: take-base, owned-tree, generated-regions, or refuse. A path no pattern names refuses.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Classify",
      "dcterms:source": "cat-harness/sdlc/processes/merge-base.bpmn#Task_Classify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergebase.task_commit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Commit the merge",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Commit",
      "dcterms:source": "cat-harness/sdlc/processes/merge-base.bpmn#Task_Commit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergebase.task_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge the base in, without committing",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`git merge --no-ff --no-commit origin/main` on a clean tree (untracked files refuse too, so the final stage cannot sweep in a scratch file).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Merge",
      "dcterms:source": "cat-harness/sdlc/processes/merge-base.bpmn#Task_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergebase.task_regen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Regenerate, asking every CI gate",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat regen`: every check/writer pair the CI workflow runs, repeated until the tree settles.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Regen",
      "dcterms:source": "cat-harness/sdlc/processes/merge-base.bpmn#Task_Regen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergebase.task_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what the run found, once",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every member's verdict, in one table in the run's summary: merged, already up to date, refused, an expected race, a repeat of a failure already reported, something new, or a member that could not say. `cat-harness-tools/scripts/merge-main-comment.ts --aggregate`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Report",
      "dcterms:source": "cat-harness/sdlc/processes/merge-base.bpmn#Task_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergebase.task_resolve",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve each by its declared strategy",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "take-base paths take the base's copy; generated-regions files take the base's side of each hunk, which lies inside a generated region by construction.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Resolve",
      "dcterms:source": "cat-harness/sdlc/processes/merge-base.bpmn#Task_Resolve",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.call_meta",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Saturation meta-merge",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Offer the card and land only on the owner's tap.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Meta",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Call_Meta",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.call_stalled",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Stalled-agent triage",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PR owner who stalled: tell the owner, then take the stalled PR over.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Stalled",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Call_Stalled",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.call_train",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge train",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run Process_MergeTrain across the queued ready PRs: in a CI-runner repository add the merge-train label (or run merge:train) so CI judges the combined batch once; in a local-gate or dispatch-only repository compose 4-8 mutually independent PRs (merge-overlap on authoredPaths) onto merge-train/<base>-<n>, regenerate declared regions once, run Task_LocalGates once on the stack, bisect and eject only any culprit via Process_MergeRefusal, and land surviving members in train order with verify-merge-replay.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Train",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Call_Train",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.owner_approve",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Approve the batch card",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the merge manager's session only: one card per batch, naming each PR, after its six lines were posted in that chat. An approval given in a sibling's session does not authorise a merge (owner ruling, 2026-11-07, card Approvals, B).",
          "@language": "en"
        }
      ],
      "skos:notation": "Owner_Approve",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Owner_Approve",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.task_card",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the request in chat, then the batch card",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The sibling's six lines go into the merge manager's chat first; a request with no rendered preview and no reason goes back to the sibling (owner ruling, 2026-11-07). Then one card per batch, naming each PR, in priority order: P0 main-red fixes and the re-pin chain, P1 work they unblock, P2 CI speed, P3 the rest.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Card",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Task_Card",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.task_direct",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge single PR to main",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A lone ready PR (queue depth 1), a .github/workflows/ PR (when MERGE_TRAIN_CARRIES_WORKFLOWS is unset), or a subscriptions/ PR lands individually through Process_MergeToMain (merge:guard where present, or head-SHA-pinned merge after Task_LocalGates on no-CI repositories). A workflow PR needs no approval beyond the batch card (owner ruling, 2026-11-07, card Workflow PRs, A).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Direct",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Task_Direct",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.task_dispatchfixer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dispatch a fixer",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One fixer agent per cause, never one per repository. Give it the failing run, the cause and the repository: pins out of step go to the next re-pin train on the index; the layer's own bug to a fix PR in that layer; a lower layer's bug to a fix PR in the lower layer, then a re-pin. It opens a draft fix PR, linked from the main-red issue. The fix is a non-content P0 PR and follows the normal merge rules: the six-line request, the owner's batch card, full-tier CI green as judged. Close the loop when the next main run is green and the main-red issue closes. Never silence the failure, and never skip, disable or quarantine a gate or a test.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_DispatchFixer",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Task_DispatchFixer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.task_lapse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Announce the hand-over",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tell every sibling and the owner, and update the durable note with the session that holds the lane now. Nobody merges between holders.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Lapse",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Task_Lapse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.task_read",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the queue, acknowledge requests",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read live, never from a stored copy: the open PRs (draft, head, mergeable, owed checks, open owner decisions), the queued and running runs with the age of the oldest, the latest main push run, each PR owner's last push or comment, and every harness repository's open main-red issue with its newest failed runs on main and gh-pages, whether or not the lane holds a PR there (gh api repos/<owner>/<repo>/actions/runs?branch=<default>&event=push: the latest completed push run per workflow, conclusion failure). One sweep runs merge:watch over every repository it holds, in dependency order (lowest first); merge:watch leaves out PRs labelled content. Liveness duty: acknowledge each new merge request within holding.heartbeatMinutes, and post a heartbeat with each sweep, so siblings can tell a live merge manager from a stalled one. A repin+merge: request is re-pinned by the merge manager itself, as its own re-pin PR in a re-pin train, before the requested PR lands; only the merge manager merges or re-pins, and a scheduled routine never merges (owner rulings, 2026-11-13).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Read",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Task_Read",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.task_relieve",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Relieve the runners",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Enforce the pacing rule of continual-progress (owner ruling, 2026-11-07, card Cancel CI): close superseded or duplicate PRs, such as a re-pin whose commits another open PR already carries, and cancel their runs; cancel stale queued runs that never started, never a main push run that has started; ask the owners of P3 PRs to return them to draft.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Relieve",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Task_Relieve",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergemanagerwatch.task_rerun",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-run the failed job once",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Infrastructure is re-run, not fixed: re-run the failed job once. A second failure is real and goes back through the sort; a Pages timeout goes to the site-size work. A train that fails only on infrastructure gets its failed job re-run once. Never cancel a main push run that has started.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Rerun",
      "dcterms:source": "cat-harness/sdlc/processes/merge-manager-watch.bpmn#Task_Rerun",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.call_beanclose_2",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanClose: end the bean in a state that says why — complete and archive it, scrap it with its reasons and archive it, or record the blocker and hand it back. The one place resolve and archive are drawn (bean m8gz, owner 2026-10-24); placed straight before the end so the engine's resolve sees nothing left but the archive step.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanClose_2",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Call_BeanClose_2",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.call_beanopen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanOpen: check before you create, find out whose the bean is, and claim it — or leave it alone when it is someone else's. The one place a claim is drawn (bean m8gz, owner 2026-10-24); the gateway after this reads which end it reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanOpen",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Call_BeanOpen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_agentfix",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge main in, regenerate, fix mechanical gates",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Merge commits only; never a force-push.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AgentFix",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_AgentFix",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_askowner",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask the owner on the PR, both sides quoted",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AskOwner",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_AskOwner",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the merge commit as evidence",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Close",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment on the PR once, linking the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One comment per refused PR, edited in place on every later event.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Comment",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_dispatch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dispatch one agent, recorded on the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before the agent starts: the date, why the fail condition fired, the agent's id, its budget. Never while the first writer may still be live. Two failed attempts with the same cause go to the owner instead.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Dispatch",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_Dispatch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_fix",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix the PR, report on the PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Claims the refusal bean, brings main in with `merge:main`, settles what it refused, pushes. Completed with the outcome `fail condition` by the steward when the condition fires first.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Fix",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_Fix",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_handback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand back, with a fail condition",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `agent-handoff` format (#1884): Roles, Report to (the PR), Done when, Fails if. The fail condition: no `started` line within 4 h, no push within 24 h, the session gone, or `blocked` on something it cannot settle. One line to the session; the instructions are in the bean.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_HandBack",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_HandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the refusal on the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The PR, the head sha the train used, the train and its other members, each refused path or failing gate and why. A repeat refusal goes under `## Attempts` with `--body-append`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Record",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_retrain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-enter a train on the new head",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The next train is the verifier: the executor's own log is evidence, not the close.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Retrain",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_Retrain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerefusal.task_scrap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scrap the bean, with the reason",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent's own `beans update --status scrapped`; never deleted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Scrap",
      "dcterms:source": "cat-harness/sdlc/processes/merge-refusal.bpmn#Task_Scrap",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerequest.sib_announce",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Announce and note the merge manager",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Send \"merge manager: <session id>\" to every sibling and the owner, and note it durably on the coordination work item, so it is used by all, including siblings started later.",
          "@language": "en"
        }
      ],
      "skos:notation": "Sib_Announce",
      "dcterms:source": "cat-harness/sdlc/processes/merge-request.bpmn#Sib_Announce",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerequest.sib_callstalled",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Stalled-agent triage",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tell the owner that the merge manager stalled, then re-elect with the stalled session excluded. The new holder announces itself, takes over the queue and tells the owner.",
          "@language": "en"
        }
      ],
      "skos:notation": "Sib_CallStalled",
      "dcterms:source": "cat-harness/sdlc/processes/merge-request.bpmn#Sib_CallStalled",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerequest.sib_callwatch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge manager watch",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The elected session holds the merge steward lane and runs its loop until it hands over or the lane lapses.",
          "@language": "en"
        }
      ],
      "skos:notation": "Sib_CallWatch",
      "dcterms:source": "cat-harness/sdlc/processes/merge-request.bpmn#Sib_CallWatch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerequest.sib_elect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Elect the merge manager with the siblings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The deterministic rule (electHolder): the active session that owns the P0 PR, else the earliest-created active session, the session id breaking a tie. Stalled sessions are not candidates. Every sibling computes the same answer from the same listing (owner ruling, 2026-11-07).",
          "@language": "en"
        }
      ],
      "skos:notation": "Sib_Elect",
      "dcterms:source": "cat-harness/sdlc/processes/merge-request.bpmn#Sib_Elect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerequest.sib_ready",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Make the PR ready",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Its own work is done and its full tier is green as judged; it is marked ready by the queue rule (continual-progress, Pace the ready marking).",
          "@language": "en"
        }
      ],
      "skos:notation": "Sib_Ready",
      "dcterms:source": "cat-harness/sdlc/processes/merge-request.bpmn#Sib_Ready",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerequest.sib_retarget",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "When the base lands, retarget",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Retarget the PR onto main and merge main in; across layers, send repin+merge: the merge manager re-pins to the dependency's merge commit on main, so pins only move forward (owner ruling, 2026-11-13). Never merge the stacked PR into its base branch, and never mark it ready while it pins an unmerged commit.",
          "@language": "en"
        }
      ],
      "skos:notation": "Sib_Retarget",
      "dcterms:source": "cat-harness/sdlc/processes/merge-request.bpmn#Sib_Retarget",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerequest.sib_send",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Send the six-line merge request",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "To the merge manager: the PR URL and full head SHA, the session URL, 1-3 sentences on the change, the rendered preview URL or no preview with a reason, what to look for, and full tier green as judged (owner ruling, 2026-11-07). Never merge it yourself, and never push to another session's branch. A PR green except for a re-pin is sent as repin+merge: <owner/repo>#<n> <sha> with the same six lines; never re-pin it yourself, and never merge (owner ruling, 2026-11-13).",
          "@language": "en"
        }
      ],
      "skos:notation": "Sib_Send",
      "dcterms:source": "cat-harness/sdlc/processes/merge-request.bpmn#Sib_Send",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergerequest.sib_stack",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Stack on it and keep working",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Same repository: branch from the dependency PR's branch and open a draft PR whose base is that branch; pull the dependency in with merge commits, never rebase or force-push another session's branch. Across layers: develop against the dependency's branch laid over a fresh mount; a draft may pin the dependency PR's full head SHA, never a branch. Write \"stacked on <repo>#<n>\" in the PR body. A re-pin is its own PR holding only pins; work that needs the new pins stacks on it, and a fix the re-pin needs lands in its owning layer (owner ruling, 2026-11-07).",
          "@language": "en"
        }
      ],
      "skos:notation": "Sib_Stack",
      "dcterms:source": "cat-harness/sdlc/processes/merge-request.bpmn#Sib_Stack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.call_handback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand it back",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Red CI, a conflict or a blocking review is the PR owner's to fix, not the merger's: `merge-refusal.bpmn` records the reason on the bean and returns the PR. The merger does not fix the PR to make it pass.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_HandBack",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Call_HandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_ask",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Put the merge to the owner",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Context, options, recommendation, question (interaction-modality §4.1). One row per PR: repo, PR, head, CI on head, mergeable, review, local gates. A repository with no CI is named as such, in words. One question may cover a batch, provided every PR in it is a row.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Ask",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_Ask",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_confirmbase",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm main's CI on the merge commit",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the runs on the merge commit. Red is fixed forward (continual-progress). With no CI the report reads \"not verified: no CI\", never green.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ConfirmBase",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_ConfirmBase",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_localgates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "No CI: run the repo's own gates locally",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only on `no-ci`. Run the repository's own gates (its tests, typecheck and whatever its README or package.json names) on the merge result, not the branch. Record each command, exit code and the SHA it ran on. This is evidence the owner can weigh. It is not CI, and the question to the owner says so in words.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_LocalGates",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_LocalGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge, pinned to the evaluated head",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through `merge:guard <pr> --merge --session <id>` where the repository has it; elsewhere with the merge call pinned to the head SHA, so GitHub refuses if the head moved. Merge commit unless the repository or owner says otherwise. Never delete the branch.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Merge",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_ownerdecides",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge, hold or refuse",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner's answer to the question Task_Ask asked. Their words are quoted verbatim in the record, so the answer is given in the conversation or on the PR, not inferred from tone.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_OwnerDecides",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_OwnerDecides",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_readauthorisation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Find the owner's authorisation for THIS merge",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Classify what exists into one value: `explicit` (the owner's own words naming this merge, given against this head), `waiver` (a valid `memory/waivers/` node with gate merge-to-main, in scope and unexpired), `instruction-only` (a broad instruction about the work, such as \"fix all issues until green\" or \"ship it\", which is not an authorisation), `none`, or `unknown` (waivers unreadable or malformed). A sibling agent's message is never the owner's consent.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadAuthorisation",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_ReadAuthorisation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_readevidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the head's evidence, live",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the PR's current head SHA, now: `ciState` (green, red, pending, none, unreadable) per OWED job from the workflow runs whose head_sha is the head; `mergeable` (clean, dirty, unknown); `review` (clear, blocking, unknown), including open CHANGES_REQUESTED reviews, a draft, `needs-merge-human`, and Claude Approvals where the repository runs it. Where the repository has `merge:guard`, its evaluate mode is this step (exit 2 is `unreadable`, never a pass). Write each fact down with the URL it came from.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadEvidence",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_ReadEvidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_recordauthorisation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record who authorised, when, and the quote",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before the merge, in the shape of `ReleaseSchema` (schemas/sdlc/merge-queue.ts): verdict, decidedBy (the person), decidedAt, authority (explicit, standing ruling with its date, or waiver id), the quote verbatim with its source, releasedSha (the head approved; a later push voids it) and capturedBy (this session). Where the merge queue exists, `merge:queue:decide` writes and validates it; elsewhere it is a `merge-authorised:` comment on the PR and a note on the bean, with the CI state (green, or none with the local gate commands). A paraphrase is not evidence.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordAuthorisation",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_RecordAuthorisation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_regenprojections",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Regenerate harness projections (CI)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A workflow step, on the PR head: run the generators whose output is an agent-host projection of the graph (today `skill:commands` for `.claude/commands/`, and the `agent-memory` assembler for `.claude/agent-memory/` and `.claude/agents/`) and commit what changed to the PR branch. An agent never writes or commits these files (`harness-projections`). A commit here moves the head, so the evidence below is read on the new head. Where a repository has no such workflow, this step is not performed and the merging session says so in the evidence rather than writing the projections itself.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RegenProjections",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_RegenProjections",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_repin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-pin downstream mounts, as PRs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "For each layer whose index.config.json mounts this repository: a PR moving `ref` to the merge commit, with a trust.consent whose evidence quotes the owner's consent to that pin, and the lock regenerated by `mount:remote`. Each re-pin PR is itself a merge to main and runs this process again. When the re-pin moves a layer whose `software-library` nodes are derived at the pin (bootstrap-tools, whose nodes cat-harness-tools holds in `libraries/held/`), the same PR runs `bun run cat libraries:derive`, and `libraries:check` fails until it does (owner, 2026-10-30, bootstrap-tools#44). None found is recorded with where it looked.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Repin",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_Repin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Note the bean, summarise on the issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The merge SHA and the authorisation block on the bean; a round summary on the issue (issue-working). The issue is not closed here: in CRDM, crdm-close closes it after this process returns, on the BA's authorisation.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Report",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetomain.task_republish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Rebuild and republish the repository's site",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A merge that changes what a published site shows is not done until the site shows it (owner, 2026-10-30: \"merged PRs by agent should trigger page rebuild in process\"). When the merged repository declares `site.build` in its `index.config.json`, the merging session rebuilds the site from the merge commit and publishes it: `bun run cat-harness-tools/scripts/build-instance-site.ts --root . --instance <name> --publish --remote <repository>`. It is agent-run, never a GitHub Actions workflow (owner). The build's own gates stay in force: an unresolved link refuses the publish, and the refusal is reported on the issue and fixed forward, never published over. A repository whose site is published by its own workflow (docs-site-publish) needs nothing here. A repository that declares no `site.build` records \"no site to republish\".",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Republish",
      "dcterms:source": "cat-harness/sdlc/processes/merge-to-main.bpmn#Task_Republish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.call_checkspresent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Find members with no CI on their head",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "GitHub runs no `pull_request` CI while a PR conflicts, so a member can arrive with nothing on its head (bean `u7be` item 3). That member is T2's first suspect if the train goes red.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_ChecksPresent",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Call_ChecksPresent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.call_ejecthandback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand the culprit back",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The same hand-back as a refused placement (#1888), carrying the ejection's evidence (R4). Then the train re-runs without it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_EjectHandBack",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Call_EjectHandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.call_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the gate set on the train",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every gate CI runs, on the combination (R2): a member that passes alone can still break `main` with another. The merge-gate epic (`nok9`, #1887) adds its gates here when they land. The release security gate (`bun run cat security:gate`, bean `ieum`) is one of them: it runs inside the gate set, so no train merges past a blocking security finding or a security check that could not run.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Gates",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Call_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.call_handback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand it back",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`merge-refusal.bpmn` (PR #1888, bean `zacz`): a bean under the right epic, a hand-back to the owning session with a fail condition (agent-handoff, #1884), or a dispatch when nobody owns it. R4: the PR returns with its reason.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_HandBack",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Call_HandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.call_mergemembers",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge each member onto the base",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`merge-base.bpmn` once per member, in order, `--no-regen`; then ONE `bun run cat regen` over the result. Tool: `merge:train`. Always onto the current base, never a cached one (R5).",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_MergeMembers",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Call_MergeMembers",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.call_mergetomain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land each member",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Once per member, in train order, at the SHA the train's gate set tested. `merge-to-main.bpmn` is where merging is a step with its own gate: it reads the head's evidence live (the train's green run is that evidence, and `merge:guard` re-evaluates it), establishes that the owner authorised THIS merge (explicitly, or by a standing ruling quoted verbatim with its date, e.g. 2026-10-01 \"you may merge green PRs\", which covers green heads only and only the queue as it stood), records the authorisation, merges pinned to the head, and then confirms `main`, re-pins downstream mounts and notes the bean. Until 2026-10-09 this was two steps here, `Task_Release` in the owner's lane bound to interaction-modality and `Task_Land` bound to prepare-merge; neither could refuse a merge, and neither said what happens when a repository has no CI. R1 still holds: what lands is exactly what CI tested. If `main` moved after the train's CI started, re-run rather than land. Each member's `trainId` is cleared, and its preview is then taken down by `feature-staging.bpmn`. A member the sub-process does not merge (held, refused, handed back) leaves the train with its reason on its queue entry.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_MergeToMain",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Call_MergeToMain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_admit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Admit it to the train, record the train id",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Writes the queue entry's `trainId` and `placement` (rule, class, rank) with who decided and when. A decision, so it is stored; the facts it was decided on are not. PRECONDITION, CHECKED RATHER THAN ASSUMED: the worktree carries no untracked, non-ignored file before the member is merged and the tree regenerated. `git status --porcelain` must be empty. The reason is specific: generated directory READMEs carry a per-subdirectory file count, and the writer counts the files GIT WOULD COMMIT -- `git ls-files --cached --others --exclude-standard` (bootstrap-tools/scripts/git-files.ts:23). `--exclude-standard` already keeps IGNORED junk out, which is the `__pycache__` case that drove that line, but `--others` still counts an untracked file nobody has ignored. So a transient written by an earlier train step moves a committed count, `readme:subgraphs:check` goes red, and the red belongs to nobody. Train 6 hit this. The count is volatile for a second reason the precondition cannot fix: two members each adding a file write different integers to one line. Measured in bean `y7b3` -- 76 of 300 replayed merges conflicted on `beans/README.md`, every one on the `| defs/ | N files |` line -- and the exposure is wider than that bean states: 54 generated READMEs across 14 layers carry 207 such rows (measured 2026-10-02). `merge:main` already resolves them (`readme-generated-regions`), so the cost falls on merges made by plain git. The chosen fix is bean `ba9e`: take the integer off `main` into the KG's `_data` layer, which classifies `take-base` and is therefore auto-resolved, leaving the README with a marker that is invariant until the directory crosses LIST_LIMIT. Not done here -- it spans the pinned `bootstrap-tools` submodule.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Admit",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_Admit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_attribute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Attribute the failure: each member's own CI first",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "T2 (SQ19 §2.1 pp. 2-3). A member whose own PR CI is red, or never ran on its head, is the prime suspect, and the evidence is already on GitHub. Only when every member is green alone is the failure a real conflict between them.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Attribute",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_Attribute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_bisect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Bisect the train",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Halve the members and re-run the gates on each half until the conflicting one is found: two or three CI runs for three to six members. Only reached when the cheap evidence is silent.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Bisect",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_Bisect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_eject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Eject the culprit, record why",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "T1 (R3; SQ19 §2.2 p. 3): the culprit leaves, the rest re-run. Writes `ejection` on its queue entry (train id, reason, evidence URL, when) and a dated evidence snapshot on this instance. The train is never rejected whole for one member.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Eject",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_Eject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_override",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place it by hand, with a reason",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Recorded as a queue entry whose placement is `override` with a position and a reason; the schema refuses one without a reason. It enters the next placement as the table's `ownerOverride` input.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Override",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_Override",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_readlive",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read each queued PR's live facts",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "From GitHub and the checkout, now: authored paths, shared declarations, size, conflict risk and overlap KIND against the other queued PRs (T3), own CI and whether it ran on the head (T2). Tools: `merge:overlap` for the overlap facts, `check:head-has-run` for `ownCi`. Nothing read here is written to a queue entry; it is the input to the placement table. `ownCi` IS NOT A VERDICT READ. Never ask whether anything is red: ask which workflow runs are OWED for the head's event and whether each one is present and successful. The two readings come apart, measured 2026-10-02 on #1889's head 7ab6119405 -- 9 runs present, all 9 gating job NAMES matching, 3 of them in_progress with a null conclusion, and 3 check SUITES completed as `action_required` having executed nothing. A filter for conclusion = failure finds zero, and counting the runs does not catch it either. `check:head-has-run` is the only thing here that asks the owed question (bean `3pqn`), and the five states it distinguishes are the five values of `ownCi`. `Rule_HeadNotGreen` in merge-priority.dmn then hands back anything but `green`, so this is a gate the engine applies rather than advice a steward remembers. Overlap kind matters as much as overlap: `merge:overlap` over all 36 open PRs on 2026-10-02 (459 pairs) found #1907 x #1909 NOT independent on `package.json` alone, with zero authored content shared. `generated-only` needs a regeneration and `shared-declaration` needs ordering; only `authored` needs a train.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadLive",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_ReadLive",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_retryflaky",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retry a declared-flaky gate once",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "T7, narrow (R11; TAP17 Table II p. 5): only gates on a declared flaky list (browser e2e), once, both outcomes recorded. A deterministic gate is never retried: that would spend a CI cycle to learn nothing.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RetryFlaky",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_RetryFlaky",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_siblingfix",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix the PR, then re-signal ready",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the sibling's own branch: merge main in, fix, push, and re-mark ready (`ready: <head sha>`). It re-enters the queue as a new placement; the ejection stays on its entry until a later train lands it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_SiblingFix",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_SiblingFix",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mergetrain.task_takenext",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Take the next PR in queue order",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Owner overrides at their positions first, then by the table's rank, then by PR number, oldest first (`scripts/merge-queue.ts` `orderQueue`).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TakeNext",
      "dcterms:source": "cat-harness/sdlc/processes/merge-train.bpmn#Task_TakeNext",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_integrate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Integrate: call existing processes",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The method's steps become a process whose judgement points call the processes that already exist (adjudication, options analysis, review) by calledElement. Nothing is re-implemented. A needed change to an existing process becomes a bean against its owner.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Integrate",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Integrate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_origin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish origin and licence",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Authors, publication, identifier, and the licence the source itself states. No stated licence means reference only: headings, page ranges and a summary in our own words; the file stays in uploads/ (git-ignored) pinned by checksum. A method with no origin is a house process; write a skill instead.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Origin",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Origin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_place",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place by ownership; declare the directory",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A domain-neutral method belongs to the harness and a domain method to the folio that owns the domain. If the session cannot write where it belongs, draft it where it can, say so in the file, and open a bean to move it.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Place",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Place",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render the method: adopted vs refused",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the source says, section by section, then a table of what this platform adopts and what it refuses, each with a reason. Extensions beyond the source (such as web plus mobile where the paper studied mobile) are stated as ours. Reported results are not imported as facts.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Render",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.a_tools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Every skill and tool used becomes a Tool",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each script, CLI or checker the process relies on gets a Tool node (`tools/<id>/<id>.json`) that satisfies a named skill, validated by folio-assistant's ToolDefinitionSchema.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Tools",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#A_Tools",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.call_ingest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ingest into library/",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The harness's basic ingestion flow (`document-ingestion.bpmn`, `Process_Ingestion`): the source is accepted, its metadata goes into the KG, and it is catalogued in library/ — held if materialized, recorded as referenced if not. The flow makes no content-type decision: reading a document into sections and blocks — choosing the rung mechanically (embedded outline, pages, OCR), and writing section text only when the licence allows it — is a refinement in the layer above, which calls this same flow first.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Ingest",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#Call_Ingest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.call_relatedwork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Related work: find, sort, ask",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Search beans, issues and open PRs for work the method touches, categorize and summarize them, and ask the owner whether and how to coordinate. CRDM calls the same sub-process.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_RelatedWork",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#Call_RelatedWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_methodologyfromsource.o_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the adoption",
          "@language": "en"
        }
      ],
      "skos:notation": "O_Review",
      "dcterms:source": "cat-harness/library/processes/methodology-from-source.bpmn#O_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_checkagainstlock",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check disk against lock against declaration",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`mount:remote:check`, with no network: the lock's pins are the declaration's, and every locked directory is on disk and hashes to its digest. Could-not-determine outranks missing, which outranks mounted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CheckAgainstLock",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_CheckAgainstLock",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_declaremount",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the mount: harness, repository, pin",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A layer `{ name, source: { remote: { repository, ref } } }` in the downstream's root `index.config.json`, written through `writeDeclaredMounts`. A folio with no index still reads `remoteMounts` on its declaration; both at once is refused. `ref` is a full 40-character commit. Overrides, if any, are keyed by layer name and then by directory id — never by path. The index itself is the index-config skill's. Decide first whether you want a remote mount at all: reading another graph without holding its code is a SUBSCRIPTION, not a mount.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_DeclareMount",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_DeclareMount",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_mountinstances",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mount each layer at its declared path",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Sparse checkout of the declaration and the chosen directories, copied to the mount path (by default the layer's home path, so relative imports and sibling discovery hold). Never onto tracked bytes; never onto a directory no lock says this mount made; never over edits to a previous mount — those are left untouched and reported. A replay of the lock tries the index's layers cache ref first (`refs/cat/layers/<key>`, then `refs/cat/layers/main`): one shallow fetch, every byte verified against the lock, and any layer that does not verify is fetched from its own repository.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_MountInstances",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_MountInstances",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_renderagentsurface",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-render the agent surface",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "When the lock changed, the layers an agent's skills and memory are generated from changed with it. `mount:remote` re-runs the generators of what an agent actually reads — `skill:commands` (`.claude/commands/`) and `agent-memory` (`.claude/agent-memory/` and the `.agents/` copies) — from the checkout root, and a generator that fails fails the run. A re-pin commit therefore carries the new layers AND the surface rendered from them, because new layers shipped without their rendered surface fail the agent-memory tests.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RenderAgentSurface",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_RenderAgentSurface",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_resolveclosure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the closure at the pin",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch the pinned tree (shallow, blobless). Read the harness's declaration from it; for each `needs` name, find that layer in the same tree, else follow a GITLINK at that tree as a pin into its own repository. A need found in neither is missing; one the downstream already holds is local. Paths and directories come from `mountDefaults` unless overridden.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ResolveClosure",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_ResolveClosure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountdependency.task_writelock",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the lock",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`index.lock.json` beside the downstream's `index.config.json` (the legacy `<instance>.mount-lock.json` is still read, and is renamed onto the new name when rewritten; both present is an error): the pins it was written for, each layer's repository, SHA and how the pin was found, each directory's tree digest — and what was NOT mounted, with why, so an offline check cannot read a gap as clean. Whoever writes the lock writes its layers cache ref (`layers:publish`, which refuses unless every mount hashes to the lock); on main, the index's workflow does it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_WriteLock",
      "dcterms:source": "cat-harness/processes/kg/mount-dependency.bpmn#Task_WriteLock",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_createstatebranch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create the declared state branch if missing",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A state branch the root layer declares and its own remote lacks is created by `bun run cat state:seed --init`, seeded empty with the standard layout. The layer that declares a state branch creates it at initialization (owner, 2026-11-17): `state:mount`, the session-start hook and a new layer's scaffold all run this step. The seed is a `state-manifest/v1` manifest with `authoritative: true`, a README, and the graph's starting files. A branch that exists is left as it is, and no branch is pushed onto an empty remote, where it would become the default branch. A MOUNTED layer's branch is never created from a downstream checkout: its miss names that layer's repository and the command to run there. Where the token cannot push, the mount stops with one line naming `state:seed --init`, rather than three gates failing downstream.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CreateStateBranch",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_CreateStateBranch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_mountbranchtip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mount the branch tip at the declared path",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `branch` source keyed by `tip`: `branch-store mount --id <dir-id>` writes the tip's files at the declared path, so every reader finds the directory where it always was; `push` splices edits back onto the tip, never forcing, and a same-file race is a conflict. The branch's NAME is the declaring directory's `storage` (or `source`) — a branch no declaration names is refused rather than guessed. A `commit`-keyed branch is read per commit through its own store (`qa-store`), not mounted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_MountBranchTip",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_MountBranchTip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_mountremotepin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mount the remote tree at its pin",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `remote` source: another repository's tree at a full 40-character commit. `bun run cat mount:remote` lays it down at the declared path and locks its tree digest; it is never written back, because the bytes are somebody else's at somebody else's pin. Usually reached through a `source.remote` layer in the root `index.config.json` (legacy: `remoteMounts`), which expands a whole harness and its closure — `Process_MountDependency`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_MountRemotePin",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_MountRemotePin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_refuseunknownkind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refuse: no flow for this source kind",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A kind added to the union (a graph database, say) before this diagram and the mount tool learn it. Refused with its own exit code — reading it as a directory would scan an empty path and report it clean.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RefuseUnknownKind",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_RefuseUnknownKind",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_resolvesource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the subgraph's content source",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`declaredSubgraph(start, id)`: the declaring layer, the entry, and the resolved source with `declaredIn` saying which layer answered. Never read `source` off the declaration directly — the config override and the legacy `storage` field are folded in by the resolver and nowhere else. A contradiction (both `source` and `storage`; a `qa` subgraph keyed by tip) throws here, before anything is mounted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ResolveSource",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_ResolveSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_retrievenpmpackage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retrieve the npm package or tarball",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An `npm` source (`schemas/kg/subgraph-source.ts`, `npm-kg-distribution`): an npm package specifier or tarball path (`.tgz`). `kg-retrieve-npm` or `npm` fetches and unpacks the package contents into the declared path.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RetrieveNpmPackage",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_RetrieveNpmPackage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_mountsubgraph.task_usecheckoutpath",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Use the checkout path in place",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `directory` source IS its declared path. Nothing is mounted; a write is an ordinary commit on the working branch, which is why `branch-store push` answers \"commit through git\" for it rather than pushing anything.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_UseCheckoutPath",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_UseCheckoutPath",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.call_ml_roundtrip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Untainted round trip on a sample",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The sample: every diagram label, the personas and scenarios, and a seeded random fraction of the rest.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_ML_RoundTrip",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Call_ML_RoundTrip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract every template once",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Once, for every locale: the `.pot` templates for the pages, the diagrams (`translate-bpmn --extract`) and the glossary schemes, each by the layer's own extractor. A locale that would need a different template is a defect in the extraction, not a reason to extract again.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_Extract",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_fixdrift",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix each drift on the PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Correct each string the adjudicator ruled drift, on the locale PR, and note the fix beside the ruling in the QA report.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_FixDrift",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_FixDrift",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the deterministic gates",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Template currency, catalogue coverage, placeholder, tag and URL preservation, officiality, `kg:locale`, and the locale's supplements compiling with no SUSHI error and passing their structural checks.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_Gates",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_glossary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check glossary consistency",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`translation:glossary:check`, against the layered term base: the normative reference glossaries first, then each layer in the order the index config lists it, the layer's own glossary last and never overriding. A platform term found in text of another subject area is a sense check for a person, not a violation.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_Glossary",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Glossary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_localepr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the locale PR to main",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One PR per locale, based on and targeting main. Never into the source branch.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_LocalePR",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_LocalePR",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Validate and merge in the window",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read each locale's QA report, confirm the PR is green, and merge it inside the owner's merge window. Outside the window it waits.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_Merge",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_qareport",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the locale's QA report",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One report per locale under `test/results/translation-qa/`: coverage, the gates, the round trip with its counts and every drift ruling, the glossary violations and sense checks, and the source errors reported.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_QAReport",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_QAReport",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Set locales, scope and merge window",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which layers, which locales, which assets (pages, diagrams, glossary, FHIR terms), and the window in which locale PRs may be merged.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_Scope",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_sourceissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "File the source errors as one issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One issue for every source-text error the translators found, each with its location and the reading the translator took. Never fixed in a translation: a fix to the source is a source PR, and the next refresh carries it to every locale.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_SourceIssue",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_SourceIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_sourcepr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge the one source PR to main",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "All the templates in one PR to main, merged before any locale starts, so every translator branches from the same main. Once it has merged, its branch receives nothing more: a later fix to the source is a new PR.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_SourcePR",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_SourcePR",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate one locale",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the merged templates, with the locale term base: `translations/<locale>/**.po`, a translation-node manifest beside each (`official: false`, `generatedBy: \"agent\"`, or `\"machine\"` where `translation:candidates` filled an empty entry with its first candidate, which stays fuzzy; no `status.json`), and the FHIR terms as CodeSystem supplements, all in one file for the locale rather than edits inside the resources.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_Translate",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_multilocaletranslation.task_ml_watcher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Schedule the refresh watcher",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Schedule a fresh session that follows `translation-refresh` on each layer, so a template that moves after today is caught by its check failing, not by a reader.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ML_Watcher",
      "dcterms:source": "cat-harness/library/processes/multi-locale-translation.bpmn#Task_ML_Watcher",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_namedqueryexecution.a_bindexecute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Bind Typed Parameters & Execute SPARQL",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Safely bind validated parameters into the audited SPARQL template with escaping. Execute SPARQL query against the Oxigraph store.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_BindExecute",
      "dcterms:source": "cat-harness/kg-ops/processes/named-query-execution.bpmn#A_BindExecute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_namedqueryexecution.a_checksubgraphs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check Graph Availability Guard (requiredSubgraphs)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Inspect query definition requiredSubgraphs list. Verify that each required subgraph is currently loaded into the Oxigraph store.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_CheckSubgraphs",
      "dcterms:source": "cat-harness/kg-ops/processes/named-query-execution.bpmn#A_CheckSubgraphs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_namedqueryexecution.a_fetchpartitions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch & Ingest Missing Subgraphs (.nq.gz)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch missing partition payloads over HTTP (servedRoute) or local files, decompress gzip streams, and ingest quads directly into store.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_FetchPartitions",
      "dcterms:source": "cat-harness/kg-ops/processes/named-query-execution.bpmn#A_FetchPartitions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_namedqueryexecution.a_formatresponse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Format Universal Result Response Envelope",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Serialize query results into NamedQueryResponseSchema envelope: queryId, executionTimeMs, rowCount, bindings (for SELECT), boolean (for ASK), or quads (for CONSTRUCT).",
          "@language": "en"
        }
      ],
      "skos:notation": "A_FormatResponse",
      "dcterms:source": "cat-harness/kg-ops/processes/named-query-execution.bpmn#A_FormatResponse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_namedqueryexecution.a_raisemissingpartition",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise MissingPartitionError (Fail-Closed Guard)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fail execution fast: throw MissingPartitionError naming the required subgraphs that are absent. Never return silent partial answers.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RaiseMissingPartition",
      "dcterms:source": "cat-harness/kg-ops/processes/named-query-execution.bpmn#A_RaiseMissingPartition",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_namedqueryexecution.a_rejectinvalidargs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Reject Request with ValidationError",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Abort execution immediately with detailed validation error describing missing or ill-typed arguments.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RejectInvalidArgs",
      "dcterms:source": "cat-harness/kg-ops/processes/named-query-execution.bpmn#A_RejectInvalidArgs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_namedqueryexecution.a_validateparams",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Validate Arguments against Parameter Schema",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Look up query definition by queryId in distribution manifest. Validate supplied arguments against parameter types, required fields, and pattern constraints.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ValidateParams",
      "dcterms:source": "cat-harness/kg-ops/processes/named-query-execution.bpmn#A_ValidateParams",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativecodereview.a_attest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Attest the pair, with a reason",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The prose holds: record it with `bun run cat pairs:attest -- --sidecar … --by agent|human --reason \"…\"`, naming what was compared. The attestation moves the pair's baseline to the current hashes, so the staleness flag clears and stays cleared until the code moves again.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Attest",
      "dcterms:source": "cat-harness/sdlc/processes/narrative-code-review.bpmn#A_Attest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativecodereview.a_raisefinding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise a finding against the wrong side",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The prose and the code really disagree: raise a finding that names which side is wrong and why. Usually the prose, because the code is what runs — but a skill can state intended behaviour correctly while the code has regressed, and then the finding is against the code.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RaiseFinding",
      "dcterms:source": "cat-harness/sdlc/processes/narrative-code-review.bpmn#A_RaiseFinding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativecodereview.a_readpairfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the pair checks' findings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the subject's kg-qa sidecar and list what is open: a failing prose-reviewed-since-code-changed (code moved, prose did not), and every false or undetermined claim from prose-claims-resolve — `bun run cat pairs:claims` prints the full list, including what it did not check. Claims that hold and pairs that are not stale need nothing.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ReadPairFindings",
      "dcterms:source": "cat-harness/sdlc/processes/narrative-code-review.bpmn#A_ReadPairFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativecodereview.a_reread",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-read the prose against the code",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "For each open item, read the prose claim beside the code it describes and decide what is true. For a stale pair, read what changed in the code and whether the prose still describes it. For an undetermined claim, say whether it points at something real outside this repository. For a false claim, check the checker's reading before trusting it.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ReRead",
      "dcterms:source": "cat-harness/sdlc/processes/narrative-code-review.bpmn#A_ReRead",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativecodereview.call_adjudication",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate against the checker",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer and a checker read the same claim differently — a disagreement about ONE kg-qa criterion (prose-claims-resolve). Descend into Process_CriterionAdjudication, which runs the shared adjudication and then one of its three outcomes: the checker's finding stands, the criterion is scoped, or a dispensation is granted with its reason. The checker's entry is kept beneath the verdict rather than overwritten (requirement R4 of issue #1042).",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Adjudication",
      "dcterms:source": "cat-harness/sdlc/processes/narrative-code-review.bpmn#Call_Adjudication",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.call_voiceoverlay",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Voice overlay review",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_VoiceReview for whichever named voices the folio has ACTIVATED — the WHO editorial style, the guideline-development register, the publication design conventions, the Milnor exposition standard. No new role is taken on: register is what this lane already judges, and a voice is a register. Placed after the base voice adjudication because a voice OVERLAYS the house voice rather than replacing it, so the house finding has to be settled first. Its own first gateway leaves immediately when no voice is active, which is this layer's case and the default everywhere.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_VoiceOverlay",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Call_VoiceOverlay",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.task_adjudicatevoice",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the voice findings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three outcomes, all legitimate: the register is wrong for this genre; the criterion does not belong in this genre and should carry `profiles`; or the block is a stated exception and a reviewer entry records why.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AdjudicateVoice",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_AdjudicateVoice",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.task_readfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the sidecar findings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the block's `.qa.json`, not just the evidence line: register is a property of the passage, and the sidecar quotes one line of it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadFindings",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_ReadFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record findings as advice",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A reviewer cannot accept a change — that is the editor's lane — so the output is findings on the sidecar, not a commit.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_narrativereview.task_reviewtranslation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the translation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Coverage, preserved terms and echoes are mechanical. A semantic round trip needs a back-translator that has not seen the original; where none has run, the criterion carries no verdict and that is the honest state.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReviewTranslation",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_ReviewTranslation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_nquadsdistribution.a_declaremanifest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare Distribution Manifest & Named Queries",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write subgraph-manifest.json conforming to folio-nquads-distribution/v1. Declare datasetIri, servedRoute, spine, subgraphs, and audited named SPARQL queries with explicit requiredSubgraphs and typed parameter definitions.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_DeclareManifest",
      "dcterms:source": "cat-harness/kg-ops/processes/nquads-distribution.bpmn#A_DeclareManifest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_nquadsdistribution.a_deploypages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish Distribution via 'served: true' to Pages",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Publish distribution directory to _site/ via mount-instance-docs.ts respecting 'served: true' declaration. Quads files become accessible identically to web clients and CLI/agent runners.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_DeployPages",
      "dcterms:source": "cat-harness/kg-ops/processes/nquads-distribution.bpmn#A_DeployPages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_nquadsdistribution.a_extractskolemize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract & Skolemize RDF Dataset",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the target RDF triples and ensure strict upstream skolemization: transform every blank node into a deterministic IRI under the dataset namespace. Zero blank nodes allowed in serialized N-Quads.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ExtractSkolemize",
      "dcterms:source": "cat-harness/kg-ops/processes/nquads-distribution.bpmn#A_ExtractSkolemize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_nquadsdistribution.a_gatecheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Audit the manifest and schemas",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Validate that subgraph-manifest.json conforms to NQuadsDistributionManifestSchema, all referenced partitions exist, and external schema w3c-n-quads is satisfied.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_GateCheck",
      "dcterms:source": "cat-harness/kg-ops/processes/nquads-distribution.bpmn#A_GateCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_nquadsdistribution.a_partitionquads",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Stream W3C N-Quads into Subgraph Partitions",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Serialize lines conforming to W3C RDF 1.1 N-Quads (subject predicate object graphIri .). Split into Tier 1 Spine (routing backbone) and Tier 2 Subgraphs (communities, domains). Compress each into .nq.gz.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_PartitionQuads",
      "dcterms:source": "cat-harness/kg-ops/processes/nquads-distribution.bpmn#A_PartitionQuads",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_nquadsdistribution.a_reportbudgetexcess",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report Budget Finding; Refine Subgraph Splitting",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record the oversized partition on the coordinating bean. Refine subgraph partitioning boundary or split into finer subgraphs. Do not ship oversized partition.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ReportBudgetExcess",
      "dcterms:source": "cat-harness/kg-ops/processes/nquads-distribution.bpmn#A_ReportBudgetExcess",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_nquadsdistribution.a_verifyqueries",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify Queries via CLI & Test Graph Availability",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Execute named queries using scripts/nquads-query.ts and the nquads-query MCP tool. Assert that missing partition triggers MissingPartitionError and typed parameters prevent injection.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_VerifyQueries",
      "dcterms:source": "cat-harness/kg-ops/processes/nquads-distribution.bpmn#A_VerifyQueries",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Apply it, and state each option's trade-offs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Follow the selected methodology as written — adopted whole, not blended with another. At least two real options: one option is not a choice, and a straw option is worse than a short list because it makes the analysis look thorough while narrowing it. Never quantify the comparison to make it look measured. Where a method scores and sums, this platform takes the structure and refuses the arithmetic: the weights are invented and a total reads as a measurement.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Apply",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_checkevidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the selected methodology's evidence base",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before applying a methodology, establish that the thing being applied is what it claims to be. A methodology is adopted because it is somebody else's named, external work; this step checks that the `origin` it cites resolves to a source in a declared library, and reads the `methodology-evidence` QA sidecar for it. WHY THE CHECK IS HERE AND NOT AT ADOPTION. Adoption happens once; selection happens every time a decision is made. A source that was reachable when the methodology was adopted can stop being so, and a methodology adopted before this axis existed was never checked at all. Measured 2026-09-22: six methodologies cited an origin and NONE had that source in any library, so every selection made until then rested on an unverifiable citation. WHAT A GAP DOES AND DOES NOT DO. A missing source does NOT block the decision, and this step has no branch that stops the process — that would make a documentation gap into an outage, and the owner decides whether an unbacked methodology may still be used. It does two things: it runs `literature-search` to try to close the gap, and it puts the evidence state into the record `A_Record` writes, so a reader can tell a decision made on a verified method from one made on a citation nobody could follow. The third state is the one that matters. \"Source ingested\", \"source located but unreachable from here\" and \"no source found\" are three different facts, and `literature-search` exists largely to stop the middle one being reported as the last.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_CheckEvidence",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_CheckEvidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_frame",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Frame the decision and check the trigger",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One sentence naming the KIND of thing being chosen, not the options — \"which cache strategy\", never \"A or B\". Then the trigger: is this irreversible, or would the answer surprise someone? If neither, say so and stop; the calling step decides without this subprocess. Stopping here is a correct outcome, not a skipped step.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Frame",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_Frame",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the chosen option AND the rejected ones",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The rejected options and why they lost are part of the output, not an appendix. A rejected option with no record is a dead end nobody marked, and the next agent walks into it — the same argument `bean-coordination` makes for `scrapped` over deleted. In a bean context the form is MADR's. Which methodology was followed is named here, so a reader can check the method rather than take the conclusion.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_optionsanalysis.a_select",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Select the methodology by context",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask the selection question in order, first yes decides: do the criteria RECUR with the same inputs having to produce the same answer; is this the CERTAINTY of a body of evidence behind a recommendation; is the context a BEAN recording a decision; otherwise a one-off choice among candidates. If none fits, that is a finding — say which question the decision is and that no adopted methodology covers it. Do not improvise one and do not stretch the nearest fit. The declared set is the contents of the `methodology` graph. Ask for it; do not remember it.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Select",
      "dcterms:source": "cat-harness/processes/process/options-analysis.bpmn#A_Select",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_prcheckspresent.call_watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the verdict on the tracking issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Runs the shared tracking watch with the label `pr-no-checks`. Asked of the same `verdict`. `none` is verdict == 'clean': every open PR's head older than 15 minutes has a run, and the tracking issue is closed. `one or more` is verdict == 'findings': the one tracking issue is opened or edited in place, and the workflow also comments once on each affected pull request. Clean here means every open pull request's head now has a CI run. The body is the sweep's report.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Watch",
      "dcterms:source": "cat-harness/sdlc/processes/pr-checks-present.bpmn#Call_Watch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_prcheckspresent.task_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment once per PR and head",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Comment on each affected open PR once per (PR, head sha): a hidden marker carrying the sha is checked first, so a re-run on the same head stays silent and a new push can be reported again. A PR that is no longer open is skipped.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Comment",
      "dcterms:source": "cat-harness/sdlc/processes/pr-checks-present.bpmn#Task_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_prcheckspresent.task_sweep",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask whether each open PR head has a run",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run check:prs-have-runs --min-age-minutes 15, writing the report file first. A head younger than 15 minutes legitimately has no run yet and is skipped. Exit 0 clean, 1 findings, 2 could not determine; an exit 1 with no report file is a crash and is treated as could-not-determine. Where its verdict comes from: Asked of the `verdict` output of the `Sweep` step in .github/workflows/pr-checks-present.yml, which runs `check:prs-have-runs --min-age-minutes 15`. Exit 0 is clean, 1 findings, 2 could not determine; an exit 1 with no report file is a crash and is reclassified as could-not-determine, as is any other code. `no` is verdict == 'unknown': 'Refuse to report success on an unchecked repository' runs `exit 1` and the tracking issue is left untouched. `yes` is verdict != 'unknown', the guard on ensuring the `pr-no-checks` label.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Sweep",
      "dcterms:source": "cat-harness/sdlc/processes/pr-checks-present.bpmn#Task_Sweep",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_publishalert.a_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment on the open issue, naming the step",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Add this failure to the open issue as a comment (which notifies), and refresh the body to the latest state.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Comment",
      "dcterms:source": "cat-harness/sdlc/processes/publish-alert.bpmn#A_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_publishalert.a_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the publication-manager label",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The alert is a tracking issue labelled `publication-manager` — the role, not a person, because no actor declares a GitHub account for it. Whoever watches that label is alerted.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Label",
      "dcterms:source": "cat-harness/sdlc/processes/publish-alert.bpmn#A_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_publishalert.a_open",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the tracking issue, naming the failed step",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the issue with the step that failed, the run link and — for a verification failure — the verifier report.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Open",
      "dcterms:source": "cat-harness/sdlc/processes/publish-alert.bpmn#A_Open",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_publishalert.u_triage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Triage the failure: hold or fix forward",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The publication manager reads what failed and decides: hold the release, or fix forward and publish again. Nothing was deployed on a failure before the deploy; a failure after it (the deploy itself, or the previews lost) is live, and says so. The next successful publish closes the issue.",
          "@language": "en"
        }
      ],
      "skos:notation": "U_Triage",
      "dcterms:source": "cat-harness/sdlc/processes/publish-alert.bpmn#U_Triage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_publishverification.a_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run every verifier over the export",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the verifier set (scripts/publish-verify.ts, `bun run cat publish:verify -- --dir <site>`) over the built tree. A SET: each verifier is one entry, and adding one changes nothing else. The first is JSON-LD expansion under a real processor, network refused — a property the context does not declare, a relative IRI or a context that will not load is a finding. Only documents of OURS are verified; third-party data in the tree is counted and cannot block.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Verify",
      "dcterms:source": "cat-harness/sdlc/processes/publish-verification.bpmn#A_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qapublish.task_applyprune",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Commit a tip without the pruned entries",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One new commit whose tree lacks the pruned entries, parented on the current tip, through the same fetch → rebuild → push loop as a publish: no `-f`, three attempts. History is not rewritten — truncating it is a deletion of a different order and the owner's call (`deletion-requires-confirmation`), not a scheduled job's.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ApplyPrune",
      "dcterms:source": "cat-harness/sdlc/processes/qa-publish.bpmn#Task_ApplyPrune",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qapublish.task_backoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Back off",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Wait the same intervals `backoff-sleep.ts` uses, then go round again: fetch the new tip and splice onto it. Three attempts in all.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Backoff",
      "dcterms:source": "cat-harness/sdlc/processes/qa-publish.bpmn#Task_Backoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qapublish.task_buildentry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the entry",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "First the working copy is produced (`qa:refresh`, bean `3hk4`): while the checkout still tracks `test/results/`, the commit's own copy is the record and nothing runs; once it does not, every declared QA writer runs into the empty tree, because the gates are in judge mode and wrote nothing a publish could carry. A refresh that leaves a writer failed, a family empty or a file unclaimed is INCOMPLETE: the job goes red and `qa:publish --completeness` refuses, so a partial tree is never stored as the commit's record — the \"Not stored\" outcome, reached before any push. Then it hashes the working copy of every declared `qa` directory (`<instance>/test/results/**`, byte-identical to the checkout's layout) into a tree through a private index, and writes `manifest.json` (`qa-reports-manifest/v1`): inputs, producers, verdict counts and the gates' result. Identical JSON is the same blob, so an unchanged family costs nothing to store again. Its git objects live in a private bare repository, never in the checkout's own store.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_BuildEntry",
      "dcterms:source": "cat-harness/sdlc/processes/qa-publish.bpmn#Task_BuildEntry",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qapublish.task_derivekey",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Derive the key",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`qa:publish --github` reads the event: a push to main publishes under `main/<sha>/`, a pull request under `pr/<n>/<head-sha>/` — the head that was tested, not the merge ref. It also reads whether the token can write, which the gateway after it routes on. The key is `main/<sha>` or `pr/<n>/<sha>`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_DeriveKey",
      "dcterms:source": "cat-harness/sdlc/processes/qa-publish.bpmn#Task_DeriveKey",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qapublish.task_planprune",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Plan the prune",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Keep every `main/<sha>` for 14 days and one per day after that; drop `pr/<n>` 7 days after the PR closed. The rule is `planPrune` in `scripts/qa-store.ts`, pinned by its tests, and the plan is printed whether or not it is applied.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PlanPrune",
      "dcterms:source": "cat-harness/sdlc/processes/qa-publish.bpmn#Task_PlanPrune",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qapublish.task_readprstates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read every PR's state",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`gh pr list --state all`: number, state and when it closed, so each `pr/<n>/` entry can be judged against its close date. A PR missing from the list is `unknown`, and an unknown is kept.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadPrStates",
      "dcterms:source": "cat-harness/sdlc/processes/qa-publish.bpmn#Task_ReadPrStates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qapublish.task_spliceandpush",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Splice onto the tip and push (never -f)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch the branch tip, splice this entry into its tree, `commit-tree -p <tip>`, and push without `-f`, with `pack.useSparse=false` so blobs already on the remote under another key are not resent. Writers own disjoint keys, so splicing onto whatever tip is current loses nobody's entry.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_SpliceAndPush",
      "dcterms:source": "cat-harness/sdlc/processes/qa-publish.bpmn#Task_SpliceAndPush",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qareportsigning.task_apisign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign over the API",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The attestation service signs the run hashes. Reached only from the one table row that has both egress and a configured endpoint.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ApiSign",
      "dcterms:source": "cat-harness/sdlc/processes/qa-report-signing.bpmn#Task_ApiSign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qareportsigning.task_buildrun",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the test run",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assemble the run record the signature will cover: the data hash and the process hash, each all-or-nothing. An UNKNOWN_HASH never reproduces another unknown, so a run that could not be hashed is signable only as what it is — unverifiable. Builds a `folio-test-run/v1`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_BuildRun",
      "dcterms:source": "cat-harness/sdlc/processes/qa-report-signing.bpmn#Task_BuildRun",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qareportsigning.task_humansign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign as release authority",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person attests the run hashes out of band. This is a userTask, not a serviceTask, and the distinction is enforced: `fulfilmentKindsForBpmnType` will not let a system actor fill it, which is what stops the air-gapped route quietly becoming another machine route.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_HumanSign",
      "dcterms:source": "cat-harness/sdlc/processes/qa-report-signing.bpmn#Task_HumanSign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qareportsigning.task_recordattestation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record which route signed it",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The attestation records the route, not only the signature. A reader who cannot tell an API signature from a human one cannot tell which trust assumption they are relying on.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordAttestation",
      "dcterms:source": "cat-harness/sdlc/processes/qa-report-signing.bpmn#Task_RecordAttestation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qareportsigning.task_resolvereach",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the performer's reach",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compute the two facts the gateway reads: effectiveReach(deployment, actor) from schemas/process/actor-reach.ts, and whether the signing-api capability is configured. Undeclared reach resolves to \"unknown\" rather than to the deployment's value — an aggregate does not determine a member. Reads `effectiveReach` and runs the signing-api probe.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ResolveReach",
      "dcterms:source": "cat-harness/sdlc/processes/qa-report-signing.bpmn#Task_ResolveReach",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_qareportsigning.task_storesigned",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Store the signed report on qa-reports",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The signed report, its signature and the route that produced it are written TOGETHER into the `qa-reports` entry keyed by the commit the report judged (`main/<sha>/` or `pr/<n>/<sha>/`), through `scripts/qa-store.ts` — never committed to main and never pushed by hand (arc `3fva`, owner ruling D1). A signature kept apart from the bytes it covers attests nothing a reader can check. A certification DECISION taken on the report is a separate node that stays on main beside `test/attestations/` (ruling D5, default (a)); it is not written here.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_StoreSigned",
      "dcterms:source": "cat-harness/sdlc/processes/qa-report-signing.bpmn#Task_StoreSigned",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the conflict",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human or agentic decision, never a merge rule. Which side wins depends on why the local edit was made, and a process that picked automatically would be choosing without the one fact that decides it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-materialize and record new fixity",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The gates are re-asked, not inherited: a licence can change, and a collection can grow past the size a caller agreed to. AND THE NEW FIXITY IS RECORDED IN THE SAME CHANGE. This step rewrites bytes that a materialization record describes, so leaving the old digest behind would make a CORRECT run of this process fail check:materialized-fixity as a mismatch — the gate reading \"somebody edited held content without saying so\" about the one process whose job is to replace it. This is the publication exception, stated as a rule rather than as a carve-out, because a list of permitted writers goes stale when a writer is added. The exception is NOT \"these actors may skip the rule\"; it is \"say what you did\". A writer that updates the digest alongside the bytes passes, and the record then describes what is actually there. A writer that does not fails, correctly, because it has forked upstream silently.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Apply",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_fixity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "ARCHIVAL verify fixity — never re-fetch",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-compute the digest and compare. An archive is NEVER re-fetched — the source is what it exists to survive, so replacing it with today's version discards the state it was keeping. A mismatch means OUR copy rotted, and the remedy is restoration from a backup, not re-download.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Fixity",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Fixity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_keeplocal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep the edit, re-pin",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The local edit wins, so nothing is re-materialized — and the pin moves to the upstream revision that was compared against. Re-pinning is the half that is easy to forget and is the reason this is a step rather than an absence: without it the same upstream change is detected as new on every cycle, and a contributor is asked the same settled question for ever. The record says the copy is deliberately divergent FROM a named revision, which is a different claim from being stale against an unknown one.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_KeepLocal",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_KeepLocal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_local",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "What changed LOCALLY since",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The half nothing answers today. A materialized copy that was edited in place is not a copy any more, and overwriting it silently destroys work whose existence the process never established.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Local",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Local",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_reconcile",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Reconcile the two by hand",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Neither side wins whole: the contributor produces content that is neither the local copy nor the remote one, and THEN it is applied. Drawn as a separate step before Task_Apply rather than folded into it, because Task_Apply re-asks the five import gates against what is being materialized — and what is being materialized here is a hand-made artefact, which is exactly the case those gates should see rather than be told about.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Reconcile",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Reconcile",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_recordconflict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the conflict: no decision, no re-pin",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both copies stay and the conflict is written down with what each side says. Deliberately does not re-pin, which is the one thing separating it from Task_KeepLocal: the question is unresolved, so it must be asked again next cycle. Recording is not optional here for the reason A_RecordEntry is not optional in an adjudication — a judgement nobody wrote down is indistinguishable from a check that never ran, and a DEFERRAL nobody wrote down is indistinguishable from a refresh that silently did nothing.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordConflict",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_RecordConflict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_refreshmaterialized.task_upstream",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "WORKING what changed upstream",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compare the recorded upstreamVersion against the source. `could not reach the source` is a THIRD answer and is never reported as `unchanged` — an unreachable source is the sourceLoss gate firing late. Reachability is asked by `bun run cat sources:liveness <instance>` against the node's resolvable IRI, its Handle first: live, gone, or could not determine, never live on an error.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Upstream",
      "dcterms:source": "cat-harness/library/processes/refresh-materialized.bpmn#Task_Upstream",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.a_categorize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Categorize and summarize",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each hit gets a category (overlaps: coordinate; affected by; out of scope; unrelated) and a one-line summary with its state. Judgement, not a keyword score: say why each is in its category.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Categorize",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#A_Categorize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record and act on the answer",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the chosen coordination where it will be found: bean links (--blocked-by, --parent), a line in the issue or PR body, or 'note only'. A declined coordination is recorded too.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.a_searchbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search beans for relevance",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "beans list --json / beans query over titles AND bodies, open and recently completed. A completed bean is evidence of a decision already made.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_SearchBeans",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#A_SearchBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.a_searchissues",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search issues and open PRs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The repository's issues (open and closed) and its open pull requests. An open PR touching the same files is the collision most worth finding early.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_SearchIssues",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#A_SearchIssues",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_relatedwork.u_coordinate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Coordinate? How?",
          "@language": "en"
        }
      ],
      "skos:notation": "U_Coordinate",
      "dcterms:source": "cat-harness/processes/process/related-work.bpmn#U_Coordinate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderkgtocdn.call_githubpages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render and push to GitHub Pages",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "BOUND BY THE TOOL, so no `calledElement` is written here: the `gh-pages` Tool lists the process this descends into, render-kg-to-github-pages, and that process is held by a layer cat-harness does not need, so naming it would bind upward. What it does: make sure gh-pages exists and Pages serves it, stage, check the staging, commit onto gh-pages, check what is served. It returns the status and the message Task_Report records.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_GitHubPages",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Call_GitHubPages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderkgtocdn.call_toolsubprocess",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render and push with that CDN's own Tool",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "BOUND BY THE TOOL, so no `calledElement` is written here, and only on this branch: the CDN is not GitHub Pages, and its Tool, which a higher layer owns (a Cloudflare publish, for one), lists the process this descends into. A lower layer cannot name a higher layer\\'s process. Whatever the Tool, it returns the same status and message.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_ToolSubprocess",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Call_ToolSubprocess",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderkgtocdn.task_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the push: status and message",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The output, on every path: `pushed`, `not-pushed` or `could-not-determine`, and one message — what is live (a commit), at which root URL, and the QA result. From the no-Tool branch the status is `not-pushed` and the message names the target nobody implements. A check that could not look is never reported as pushed.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Report",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Task_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderkgtocdn.task_resolve",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Determine which CDN, the root URL and the Subgraphs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every Subgraph id asked for must be one the declaration lists; none means the whole graph. The root URL is the one given. The target's Tool is the one that `satisfies: [\"render-kg-to-cdn\"]` for that CDN — `gh-pages` for GitHub Pages. A caller that already rendered and verified its tree hands the tree over instead of the graph, and the Tool pushes it without rendering again.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Resolve",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Task_Resolve",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_logremoved",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `removed` with the reason",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "BEFORE the removal, not after: a job that dies mid-step must leave a record of the intent rather than an artefact that vanished with no entry. A reason is REQUIRED — an entry saying an artefact went and not why is the ambiguity this log exists to prevent.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_LogRemoved",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRemoved",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_logrendered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `rendered`",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A re-deploy is a rendering, so it gets its own entry rather than overwriting the last. \"When was this last built\" is then answerable without diffing commits.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_LogRendered",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRendered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_logrestored",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `restored`",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A full-replace deploy (`docs-site.yml`, the only publisher without keep_files) wipes the branch; `restore-staging` carries the previews AND this log back in. Its own event rather than a second `rendered`, because \"somebody pushed this branch\" and \"an unrelated merge nearly deleted it\" are different facts.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_LogRestored",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRestored",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_logretained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `retained` with the reason",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records that a removal was considered and refused, or that a preview still stands because a signal fired; without the entry that leaves no trace, and nobody can tell why a preview is still up. A reason is REQUIRED — the tool refuses without one.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_LogRetained",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRetained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_preflight",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Preflight: is the preview live?",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`previewLiveness` — a disjunction over open-pr, unmerged-branch and recent-commit, shared with the health sweep so the two cannot disagree. A preview whose pull request is closed is NOT necessarily an abandoned one.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Preflight",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_Preflight",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_renderlog.a_remove",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove the artefact",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`rm -rf branches/<slug>`. Cannot reach the log, which lives outside branches/ — structural rather than guarded, because a branch named to collide with a directory under branches/ slugifies to exactly that name and git permits the ref.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Remove",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_Remove",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_repohealth.call_watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the verdict on the tracking issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Runs the shared tracking watch with the label `repo-health`. Asked of the same `verdict`. `clean` is verdict == 'clean': the `repo-health` tracking issue is closed. `not clean` is verdict == 'findings': the one tracking issue is opened or edited in place with the report. A finding does not fail the job; only `unknown` does. Clean here means every check ran and none had anything to report. The body states that nothing in it has been acted on.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Watch",
      "dcterms:source": "cat-harness/sdlc/processes/repository-health-watch.bpmn#Call_Watch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_repohealth.task_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the health checks, keeping the report either way",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run bun run cat health --out and upload the JSON report whatever the verdict — on unknown it is the only evidence of why the sweep went blind. Exit 0 clean, 1 gating findings, 2 could not check; exit 1 with no report is a crash. The checks report and never act: every finding names something a person does. Where its verdict comes from: Asked of the `verdict` output of 'Run the health checks' in .github/workflows/health-check.yml, which runs `bun run cat health --out`. Exit 0 is clean, 1 gating finding(s), 2 could not check; an exit 1 with no report file is a crash and is reclassified as could-not-check, as is any other code. `no` is verdict == 'unknown': 'Refuse to report success on an unchecked repository' runs `exit 1` and the tracking issue is left untouched. `yes` is verdict != 'unknown', the guard on ensuring the `repo-health` label. The report is uploaded as an artifact on every verdict (`if: always()`), including this one.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Check",
      "dcterms:source": "cat-harness/sdlc/processes/repository-health-watch.bpmn#Task_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_requirementsfiling.a_bindfrontmatter",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Bind Requirement front matter, statements, and 3-axis lineage",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Author or update the YAML front matter conforming to bootstrap/schemas/requirement.schema.json: `id: req:<slug>`, `title`, `status`, `statements[]` (each with stable `#<key>`, RFC 2119 modality MUST/SHOULD/MAY, normative statement, and measurable successCriteria), backward lineage (`proposedIn`, `derivedFrom`), horizontal dependencies (`dependsOn`), and forward links (`beans`, `skills`, `processes`).",
          "@language": "en"
        }
      ],
      "skos:notation": "A_BindFrontMatter",
      "dcterms:source": "cat-harness/sdlc/processes/requirements-filing.bpmn#A_BindFrontMatter",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_requirementsfiling.a_classifyfiling",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Classify filing mode, concern group, and req:<slug> ID",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Determine whether this filing promotes a proposal from docs/proposals/<slug>.md (promote), amends an existing requirement or replaces it with a new requirement (amend-or-supersede), or retires an obsolete requirement (retire). Assign the primary semantic concern group from code-lists/concern-group.json (sdlc, process, tools, kg, library, content, ui, conduct) and verify that req:<slug> does not collide across docs/proposals/ and docs/requirements/.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ClassifyFiling",
      "dcterms:source": "cat-harness/sdlc/processes/requirements-filing.bpmn#A_ClassifyFiling",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_requirementsfiling.a_promoteorupdate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "git mv proposal to docs/requirements/<slug>.md and record proposedIn",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record the last commit SHA touching docs/proposals/<slug>.md, execute `git mv docs/proposals/<slug>.md docs/requirements/<slug>.md` so git log --follow preserves the proposal's history, and record `proposedIn: { commit, path: \"docs/proposals/<slug>.md\" }` in the YAML front matter.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_PromoteOrUpdate",
      "dcterms:source": "cat-harness/sdlc/processes/requirements-filing.bpmn#A_PromoteOrUpdate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_requirementsfiling.a_recordfilingsignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the sign-off and set the stage",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Append the human sign-off decision to `test/attestations/requirement-signoff/<set-slug>.attestations.json` (recording who, at, scope, outcome, stage, reason, and issue comment permalink) and update the `RequirementSet` stage to match.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordFilingSignoff",
      "dcterms:source": "cat-harness/sdlc/processes/requirements-filing.bpmn#A_RecordFilingSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_requirementsfiling.a_runcheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the requirements check",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run `bun run cat check:requirements` to verify schema conformance (`bootstrap/schemas/requirement.schema.json`), slug uniqueness across `docs/proposals/` and `docs/requirements/`, acyclicity of `derivedFrom`, existence of all referenced `derivedFrom` / `dependsOn` / `supersededBy` / `skills` / `processes` targets, and `RequirementSet` sign-off invariants.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RunCheck",
      "dcterms:source": "cat-harness/sdlc/processes/requirements-filing.bpmn#A_RunCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_requirementsfiling.a_updateindex",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Organise entry in docs/requirements/index.md by concern group & status",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Add or update the requirement's row in `docs/requirements/index.md` under its canonical concern group (`sdlc`, `process`, `tools`, `kg`, `library`, `content`, `ui`, `conduct` from `code-lists/concern-group.json`) for `in-force` requirements, or move it to the Superseded and Retired Requirements table when superseded or retired.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_UpdateIndex",
      "dcterms:source": "cat-harness/sdlc/processes/requirements-filing.bpmn#A_UpdateIndex",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_requirementsfiling.a_updatelifecycle",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mark the record superseded or retired",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never delete (`git rm`) a superseded or retired requirement. When superseding `req:<old-slug>`, set `status: superseded` and `supersededBy: req:<new-slug>` on `docs/requirements/<old-slug>.md`. When retiring, set `status: retired` and document the retirement reason and authorising issue in prose. Update any `RequirementSet` (`docs/requirements/*.set.json`) so approved/accepted sets hold only `in-force` members.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_UpdateLifecycle",
      "dcterms:source": "cat-harness/sdlc/processes/requirements-filing.bpmn#A_UpdateLifecycle",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_requirementsfiling.ba_reviewfiling",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the filed requirement, sign off",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Business Analyst / Owner reviews the filed requirement in `docs/requirements/<slug>.md`, its concern-group organisation in `docs/requirements/index.md`, its three-axis traceability, and any supersession or retirement update, deciding `approve`, `amend`, `reject`, `defer`, or `cancel`.",
          "@language": "en"
        }
      ],
      "skos:notation": "BA_ReviewFiling",
      "dcterms:source": "cat-harness/sdlc/processes/requirements-filing.bpmn#BA_ReviewFiling",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.call_codereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Code node review",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_CodeReview. The actor takes on the `code-reviewer` lane for this call path only.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_CodeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_CodeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.call_narrativecodereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prose and the code it describes",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_NarrativeCodeReview: judge what the pair checks could not settle (a stale pair, a false or undetermined claim), and send a disagreement with a checker to adjudication. Where `cat-harness.sdlc` is switched on, this step is the opt-in process `narrative-code-review` (`Process_NarrativeCodeReview`, sdlc/processes/narrative-code-review.bpmn); it is not called from here, because a layer without that sub-graph does not have it (owner card Q-OPTIN-CALLS A, 2026-11-12).",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_NarrativeCodeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_NarrativeCodeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.call_narrativereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Narrative review",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_NarrativeReview. The actor takes on the `narrative-reviewer` lane for this call path only.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_NarrativeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_NarrativeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.task_classifychange",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Classify what changed",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Prose, code nodes, or both. This is the only decision the generic lane makes on its own: everything after it is made inside a subprocess by the role that lane binds. Binds `content-review`, the same skill as Task_Consolidate in this lane, because a paper skill belongs to the science layer, which this harness diagram cannot reach. A paper process that wants semantic scoping adds it by calling this process.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ClassifyChange",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_ClassifyChange",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.task_consolidate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Consolidate findings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One report from however many subprocesses ran. Findings are advice: a reviewer cannot accept the change.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Consolidate",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_Consolidate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_review.task_editordecides",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accept, or send back",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The editor's lane, kept separate on purpose: the reviewer who judged the change is not the position that accepts it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_EditorDecides",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_EditorDecides",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialize remote content (the five gates)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared subprocess. It resolves the request against the source descriptor, then asks size, restrictions, copyright, retention and source loss, and either fetches with fixity or leaves the content referenced. This process does not restate any of that; it waits for the outcome.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh materialized content",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Refresh is not re-import: what changed upstream, what changed locally since, and what to do when both did. The shared subprocess answers all three, and re-asks the five gates, since a licence can change and a collection can grow past the size agreed.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_importtest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import into the store, and test the import",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The part only this process does. Load the landed sample into the chosen store and check what an import can get wrong: every item arrived (count against the request), identifiers survived (the descriptor's authoritative ones), structure validates against the store's schema, and provenance (source, revision, fixity) is attached to each node. A check that could not run is a failure, not a pass.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ImportTest",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_ImportTest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_library",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land it in library/",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A permanent sample joins the library as an L1 source, with the materialization record (purpose, gates, fixity) beside it. From here refresh-materialized governs it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Library",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_Library",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what failed",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which check failed, on which items, and the evidence. The landed copy is not removed: a failed import is information about the source or the store, and deleting the copy would destroy the evidence.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the sample: items, store, permanence",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three answers, recorded before anything is fetched. WHICH ITEMS: named by the source's identifiers, or by a subset strategy its descriptor supports. WHICH STORE: the knowledge graph or other structured store the import is tested against. PERMANENT OR TRIAL: a permanent sample lands in library/ and is refreshed; a trial lands in fsh-guts/ and is not. The purpose materialize-remote asks for (working or archival) is asked there, not here.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Scope",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sampleimport.task_trial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep it as a trial: the unpublished trashcan",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A trial goes to the kept trashcan: addressable, exported, never published. Its node declares `$schema: folio-fsh-guts/v1` and carries the bean or issue it was written under, since it was never moved from anywhere and a `movedFrom` would be invented provenance. It is NOT refreshed: a trial records what the source looked like when it was tried. Promoting a trial means running this process again with permanent = yes, so the gates are asked afresh.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Trial",
      "dcterms:source": "cat-harness/library/processes/sample-import.bpmn#Task_Trial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_saturationmetamerge.task_ask",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dry-run, then ask the owner naming every PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stack the PRs on a meta-merge branch without pushing. Then post the full question (include, leave out with the reason, merge method, per repository), followed by the card: A go, B also the red ones, C dry run only, D cancel.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Ask",
      "dcterms:source": "cat-harness/sdlc/processes/saturation-meta-merge.bpmn#Task_Ask",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_saturationmetamerge.task_done",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post done to every held sibling",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Post done with what landed and what is still open, also when nothing was merged. A hold with no done is an outage.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Done",
      "dcterms:source": "cat-harness/sdlc/processes/saturation-meta-merge.bpmn#Task_Done",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_saturationmetamerge.task_hold",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Broadcast the hold to siblings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Message every sibling that pushes to the repositories involved: what is about to land, and hold pushes, merges and run cancels until done. Ask the coordinator to pass it on to any thread that cannot be reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Hold",
      "dcterms:source": "cat-harness/sdlc/processes/saturation-meta-merge.bpmn#Task_Hold",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_saturationmetamerge.task_land",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cancel queued PR runs; build, push, merge",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never cancel a main push run that has started. Build from fresh main with merge commits, skipping conflicts, .github/workflows/ and subscriptions/. Open one PR per repository, merge it with a merge commit, and comment on each member PR with the link.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Land",
      "dcterms:source": "cat-harness/sdlc/processes/saturation-meta-merge.bpmn#Task_Land",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_saturationmetamerge.task_mainrun",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run main's checks",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The merge starts main's checks. Until tools#1384, a closed PR's run can cancel them, so the steward re-runs a cancelled main run.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_MainRun",
      "dcterms:source": "cat-harness/sdlc/processes/saturation-meta-merge.bpmn#Task_MainRun",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_saturationmetamerge.task_owner",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose A, B, C or D",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only the owner's own tap or words approve the landing. A PR the card does not name gets no merge from it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Owner",
      "dcterms:source": "cat-harness/sdlc/processes/saturation-meta-merge.bpmn#Task_Owner",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_saturationmetamerge.task_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what landed and main's verdict",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One message to the owner: what merged, main's verdict per repository, and any open decision. On red, the fix goes to main as its own PR.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Report",
      "dcterms:source": "cat-harness/sdlc/processes/saturation-meta-merge.bpmn#Task_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_saturationmetamerge.task_sibhold",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hold, and name the heads to merge",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A sibling that owns a PR in the batch names the head it wants merged.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_SibHold",
      "dcterms:source": "cat-harness/sdlc/processes/saturation-meta-merge.bpmn#Task_SibHold",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_explain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Explain each missing permission, with the exact config diff",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Per permission: what it allows the agent to do without asking, why a process here needs it, the narrowest form that would do, and the exact change to the Tool's config. Context, options, recommendation, question (interaction-modality §4.1). Least privilege is the recommendation unless there is a measured reason for more.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Explain",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_Explain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_identifytools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify the agent Tool(s) acting here",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which coding-agent Tool is running this session, and which others the layer is configured for (each has its own config files: AGENTS.md is read by many; Claude Code, Gemini CLI, Cursor, Copilot and Codex each add their own). The Tool's adapter says where its permissions live and how a rule is written. A Tool with no adapter is reported, and its permissions are left to the person.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_IdentifyTools",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_IdentifyTools",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_ownergrants",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grant, narrow or refuse each",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner's answer, per permission, in their own words. Quoted verbatim in the record.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_OwnerGrants",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_OwnerGrants",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_readgrants",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Compare what the processes need with what is granted",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The needed set is the agent-permissions skill's list (write generated projections: CI only, never the agent; edit hooks or settings; run the gates; push a feature branch; open a PR), scoped to what this layer's processes actually call. The granted set is the recorded grants plus the Tool's current config, read through its adapter. A config rule with no recorded grant is reported as unrecorded, not treated as granted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadGrants",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_ReadGrants",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_recordgrant",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record each answer: who, when, scope, the quote",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One record per permission: by, on, tool, permission, scope (session, instance, or until a date), the config diff, and evidence (the owner's words verbatim, with where they were said). Refusals are recorded the same way.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordGrant",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_RecordGrant",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_secureagentpermissions.task_writeconfig",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write it through the Tool's adapter",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The exact diff the owner saw, nothing more, written by the person or by the agent under their consent to that diff. Hand-edited agent config only; generated projections are CI's (harness-projections).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_WriteConfig",
      "dcterms:source": "cat-harness/processes/process/secure-agent-permissions.bpmn#Task_WriteConfig",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_askwhoisacting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask who is acting",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step that needs a person. Asked ONCE and recorded, never re-asked: `memory/interaction.json` and the record exist so that a preference stated once is not requested again, which is WCAG 2.2 SC 3.3.7.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_AskWhoIsActing",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_AskWhoIsActing",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_closesession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the session",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records that the actor stopped. It does NOT resolve beans or complete instances: those outlive the session by design, and a machine that closed them on the way out would be asserting work finished because somebody went away.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_CloseSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_CloseSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_identifyactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish who is acting",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The first step and not a formality: `actor` is the one field of the record that nothing else can supply. Every other field is recoverable by reading the repository; who is acting is not.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_IdentifyActor",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_IdentifyActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_opensession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the session record",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Writes `id`, `actor` and `startedAt`, with `open` and `claimed` empty. An empty `open` is the NORMAL state, not an unfinished one: an agent reading, answering or deciding is in no process at all.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_OpenSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_OpenSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_readturn",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Take in the turn",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A turn is anything that arrives — a person's message, a tool result, a notification. The machine advances on turns rather than on a clock, because a session that has been told nothing has not changed.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ReadTurn",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_ReadTurn",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_touch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh `updatedAt` only",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Nothing changed, and saying so is the point. A record that stops being written looks exactly like an abandoned session; a refreshed timestamp with no other change says the session is alive and idle, which is a different fact and the commonest one.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Touch",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_Touch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.a_updatesession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write what changed",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An instance opened or closed, a bean claimed, a wait started or ended. All by REFERENCE: the bean and the instance are each the authority on themselves, and a status copied here would be free to contradict them. NO `cat-harness.processes:bean` on this step. It records that a claim happened; it does not claim.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_UpdateSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_UpdateSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_sessionstatemachine.call_securepermissions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Secure the agent's permissions",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Once the actor is known and the record is open, check that the coding agent acting here holds the permissions this layer's processes need, granted by a person and recorded, and ask for any that are missing. This is where initiating the harness for an actor secures them, rather than the first denied command. A run that finds them current returns without asking anything; the same process is called on demand when an action is denied later in the session. Vendor-neutral: the agent is a Tool, and its config is written through that Tool's adapter. Skill: agent-permissions.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_SecurePermissions",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#Call_SecurePermissions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Gate every slice: slice:sqlite:check",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "For every slice: build twice and require one sha256; read the row digest back from the file and require it to equal the digest computed from the source without SQLite; run an FTS5 phrase query for a known row; and audit the payloads with `auditPayloadTree` (deploy payloads as written, the kg slice's pointers against the committed payload tree). A slice whose rows do not match its source fails; it never passes as whole.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Check",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_define",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the slice definition",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Add one `SliceDef` to the builder's slice table: the DDL (one table per node type, edge tables, one CONTENTLESS full-detail FTS5), the order each table's rows go in, the `load` that turns the source into rows, where the payloads live (written at deploy, or already published), and the `search` block the generic page reads. Choose the heavy fields by `kg-export` §\"What is heavy\": a heavy field is a `payload_sha256` pointer, never a stored column. Never copy the builder.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Define",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Define",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_deploy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build each slice into _site at deploy",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`gen-slice-sqlite.ts --out ./_site/assets/slices --payload-out ./_site/payload/sha256 --slice <name>`, once per slice, from the tree being published: the file, its manifest, the slice index, and the deploy payloads beside the committed KG payloads. Never into the committed `docs/payload/`, whose orphan audit admits KG nodes only.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Deploy",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Deploy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build it locally and measure the file",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run `bun run cat slice:sqlite -- --slice <name> --out <scratch>` and read the manifest: `bytes`, the row counts, the payload count and bytes, `overBudget`, `duplicateIds` and `findings`. Record the measurement in the work context with its provenance (the command and the date), beside the size of the source it replaces.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Measure",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the measurement; ship nothing",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the measurement and what was tried into the work context, and ask the owner whether the slice should ship at that size, be cut further, or not exist. Nothing is wired: no manifest is published, no gate added, no deploy line written.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Report",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search the published slice in a browser",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open `slices/search.html?slice=<name>` on the deployed site, run a phrase search for a known row, open it so its payload is fetched, and look at the result; send the screenshot rather than a description of it. Report the mode the page says it used (OPFS or in memory), never an assumed one.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Verify",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_slicesqlitepublish.a_wire",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Wire it: gate, deploy line, search, tests",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Give the slice everything a slice owes: its manifest (written by the builder from the definition), its `--check` (covered by `slice:sqlite:check`), one deploy line in `docs-site.yml` and in `feature-staging.yml`, its search (the generic page needs no code, only the definition's `search` block), a unit test over a fixture and over the real source, and a search in `slice-sqlite.e2e.ts`.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Wire",
      "dcterms:source": "cat-harness/processes/kg/slice-sqlite-publish.bpmn#A_Wire",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_smetestdatareview.task_preparecohort",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare the cohort: inputs, expected and computed",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assemble the `IndicatorCohortCase` (`id`, `summary`, `indicatorRef`, `populationSize`, `inputs`, `expectedValue`, `computedValue`, and optional `period`, `numerator`, `denominator`) from the fixed data set for SME review.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PrepareCohort",
      "dcterms:source": "cat-harness/sdlc/processes/sme-test-data-review.bpmn#Task_PrepareCohort",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_smetestdatareview.task_prepareworkedcase",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare the worked case: input, logic, output",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assemble the `DecisionSupportWorkedCase` (`id`, `summary`, `decisionLogicRef`, structured `input`, `systemOutput`, and optional `expectedGuidance`) from the fixed data set so the SME can judge clinical/scientific correctness without reading raw schema internals.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PrepareWorkedCase",
      "dcterms:source": "cat-harness/sdlc/processes/sme-test-data-review.bpmn#Task_PrepareWorkedCase",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_smetestdatareview.task_recordcaseverdict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the SME's verdict and rationale",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the `sme-case-verdict/1.0.0` node (`SmeCaseVerdictKind` in `schemas/sdlc/test-data.ts`) recording `dataSetRef`, `subjectKind`, the worked `case` or `cohort`, `verdict`, `rationale`, the SME's attributable human identity (`reviewer: { kind: \"human\", provider, handle, role }`), and `reviewedAt` (ISO-8601 date/timestamp).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordCaseVerdict",
      "dcterms:source": "cat-harness/sdlc/processes/sme-test-data-review.bpmn#Task_RecordCaseVerdict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_smetestdatareview.task_smejudge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Judge whether the case or cohort is right",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Performed by the human SME in `Lane_SME` (`clinical-sme`, `judgementOnly: true`). The SME inspects the worked case (for decision support) or the cohort and expected vs computed value (for an indicator definition) and renders a domain verdict (`pass`, `fail`, or `needs-revision`) with rationale. Deliberately carries no skill reference: no procedure yields the answer, which is the whole reason a person is in this lane.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_SmeJudge",
      "dcterms:source": "cat-harness/sdlc/processes/sme-test-data-review.bpmn#Task_SmeJudge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_stalledagenttriage.a_collect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Collect or reconstruct a handover report per agent",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Use the agent's own report and check it against live state; if none, ask the agent if it is still reachable, else reconstruct with the handover-report template and mark it reconstructed. Unpushed state is unknown, never empty.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Collect",
      "dcterms:source": "cat-harness/sdlc/processes/stalled-agent-triage.bpmn#A_Collect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_stalledagenttriage.a_consolidate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Consolidate into 2-4 themes, with a recommendation each",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Group by what the work delivers, not by agent. Each theme gets its epic, members, dependencies, risk, and one of: continue, fold in, new epic, park, scrap (owner only).",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Consolidate",
      "dcterms:source": "cat-harness/sdlc/processes/stalled-agent-triage.bpmn#A_Consolidate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_stalledagenttriage.a_footprint",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Find the footprint",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "handover notes (beans/notes, title 'handover:'), open PRs and branches by session or time window, in-progress beans, workflow instances, last PR and issue comments. REST, one batched pass.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Footprint",
      "dcterms:source": "cat-harness/sdlc/processes/stalled-agent-triage.bpmn#A_Footprint",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_stalledagenttriage.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the triage and claim the picked-up work",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A 'triage: <date>' bean note on each theme's epic; new or re-parented beans; claims via beans:claim. Owning sessions still alive are notified before their branches are touched.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/sdlc/processes/stalled-agent-triage.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_stalledagenttriage.s_reroute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-route open PRs that lost their driver",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Green, up-to-date PRs join the queue; mid-merge branches are re-driven from the PR head, never guessed at; red PRs go back to the new driver.",
          "@language": "en"
        }
      ],
      "skos:notation": "S_Reroute",
      "dcterms:source": "cat-harness/sdlc/processes/stalled-agent-triage.bpmn#S_Reroute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_stalledagenttriage.u_decide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Decide each theme",
          "@language": "en"
        }
      ],
      "skos:notation": "U_Decide",
      "dcterms:source": "cat-harness/sdlc/processes/stalled-agent-triage.bpmn#U_Decide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.call_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the move",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Report what would move and how it undoes, and ask the owner to create the repository. Declining leaves it staged, ready to leave.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Authorise",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Call_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.call_cutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cut over",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Freeze the in-repo copy in the kept trashcan and measure the cutover until it is complete or cannot be shown complete.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Cutover",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Call_Cutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.call_move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move it into its repository",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the repository, drain, copy the staged contents in, re-point the declaration, verify a fresh clone, then consume, release and check every identifier dereferences.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Move",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Call_Move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief the work",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the work is and why, what is already measured with its provenance, how it will be done, and what would falsify the approach. The work item is already taken up when the process starts, so a sibling session sees the work before the brief is written. Here the work is a sub-KG: what it is, and why it is staged here rather than in a repository of its own.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_confirmcutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask to freeze the in-repo copy",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports the files that would move, their size, the new repository and the commit the copy matches, then asks: (1) freeze it in the kept trashcan now, (2) keep in place until the first release, (3) show the file list first. Default if there is no answer: (2), nothing moves. A green fresh clone is the precondition for asking, not the answer. Non-relaxable. The host keeps a FROZEN copy in the kept trashcan, not a refreshed mirror and not a deletion; the live copy is the remote mount or subscription set up at stage 10.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ConfirmCutover",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_ConfirmCutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_decideleave",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask whether it should leave now",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner decides, from what is measured, whether the sub-KG starts staging for separation now. Asked as numbered options with the recommended one first and a stated default: keeping it in place is the default, and is a real outcome.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_DecideLeave",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_DecideLeave",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare it in place, with its seam",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`<name>/<name>.json` with name, version, `repository` (the planned home), `livesAt` (where it sits today), `needs`, and only the directories that exist, each declared with its files in one commit. `<name>/platform.ts` from the first commit, so no climb out of the directory ever needs rerouting. Scaffolded by `init-folio --staged <path>`, which writes those two files and nothing at the host root; never `--instance`, which writes a whole repository.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_grow",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grow it in place",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The content type's own authoring process runs here, against the staged layer. Many sub-KGs never leave; this task can last as long as the graph does.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Grow",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Grow",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_pushdown",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Push generic down first",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Move what is generic into the harness below before the seam is closed, and consolidate what the sub-KG needs into the harness it instantiates. Wrong-direction edges hide in declarations and data as well as imports: run check:import-direction, check:reference-direction and check:process-bindings.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PushDown",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_PushDown",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_rehearse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Rehearse self-contained",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat seed:ready --layer <name> --rehearse` copies the layer and what it needs into a scratch workspace of sibling directories and runs the tests there. Run the gates rather than scanning imports: a static scan misses files the gates load at run time, and renaming the directory changes every generated page.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Rehearse",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Rehearse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subkglifecycle.task_seam",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Route every climb through platform.ts",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every platform symbol the sub-KG uses is re-exported from `<name>/platform.ts`, so re-pointing the platform is a one-file edit. A merge from main is where new climbs arrive; reroute them here.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Seam",
      "dcterms:source": "cat-harness/processes/kg/sub-kg-lifecycle.bpmn#Task_Seam",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialise the part",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ONLY way bytes arrive. Purpose first, then the five gates — size, restrictions, copyright, retention, source loss — then fetch with fixity, or stay referenced with the refusing gate's basis recorded. Both ends of that subprocess return here and the walk continues: one part refused is not the subscription refused.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh the held part",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared refresh, called, not re-described: what changed upstream, what changed locally, and what to do when both did. An archival copy is fixity-checked and never re-fetched. Whatever that process decides — refreshed, kept divergent, or deferred — is the part's new state; this loop only moves to the next part.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose subgraphs, assets, harnesses",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Written to the entry as `subgraphs`, `assets.policy` (none, on-demand or all) and `harnesses`. Choosing is not holding: a chosen subgraph is still referenced until the gates below let it through. Choosing nothing is legitimate — a subscription with no parts chosen is a pinned reference, the case associatedHarnesses covers today.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Choose",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_instantiate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Instantiate the harness: write its config",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write `<harness>.config.json` at the repository root, plus the state directories the harness declares, and — where the checkout has a root `index.config.json` — add the harness to its `instances[]` (kg:instantiate does both), because the index, not the file, is then what reads as INSTANTIATED (index-config skill); a root config the index does not list fails check:landing-instance. That instantiation is what puts the harness in the navbar's bottom region. check:instance-render must be green on the result; a config that renders nothing is an entry pointing nowhere.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Instantiate",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Instantiate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_pin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name the substrate, pin a full commit SHA",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`owner/repo` and a 40-character commit SHA — never a branch, never an abbreviated SHA. The schema refuses anything else (SubscriptionSchema.ref), and this step exists so the refusal is met while choosing rather than at commit time. A tag replaces the SHA only once the substrate publishes releases.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Pin",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Pin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the entry and cache the declaration",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `subscriptions` entry in the subscriber's layer declaration — id, repository, ref, and nothing chosen yet — plus a cached copy of the substrate's declaration at the pin. The entry holds the choice and the pin, never state: whether a part is held is answered by its materialisation record, and a second answer here would be free to disagree with it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Record",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_refuse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record why it is not a substrate; write no entry",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "No subscription entry is written for a repository that is not a substrate. What is recorded is the reason (non-conforming, no harness, or unreachable) and the pin it was asked at, so a later attempt at a different commit starts from what failed.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Refuse",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Refuse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_repin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move the entry's ref and re-cache the declaration",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only after every held part has been through the refresh. Moving the ref first would make the records of parts not yet refreshed describe a commit the entry no longer names. The cached declaration is replaced so the review that follows shows what the NEW pin offers, including subgraphs that did not exist at the old one.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RePin",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_RePin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review what the substrate offers",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every subgraph, asset class and harness the cached declaration names, each with its current state — referenced, materialised, unknown, stale, or refused by a gate. Shown whole, because a reader who sees only what was chosen cannot tell \"not offered\" from \"not taken\".",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_summarise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record how each part of the walk ended",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One line per offered part: materialised, referenced by choice, or referenced because a gate refused (and which). Nothing new is decided here; it is the account the visualizer and the next refresh read, written once rather than reconstructed from the loop.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Summarise",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Summarise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_subscribekg.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch and validate the pinned declaration",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A sparse, shallow fetch of the substrate's root declaration only. Two questions: does it parse as bootstrap's KnowledgeGraphDeclarationSchema, and does it declare at least one harness? `could not fetch` is a third answer and is never read as `conforms`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "cat-harness/library/processes/subscribe-kg.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.call_monitorsweep",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sweep, triage and sync handover",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run Process_SwarmMonitorSweep on reactive wakeups, routine check-in ticks, or on-demand status requests: inspect worker progress, queues, and compressed/swap memory, triage leaks or stalls, assign non-heavy idle-backlog items to compute-bound workers, push a fresh Cold-Start Handover Runbook to beans, and emit the two-table status report when due.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_MonitorSweep",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Call_MonitorSweep",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.mon_closebean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close or park swarm epic",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Cancel any remaining wakeup or periodic report timer and run Process_BeanClose on the parent Swarm Work Item: complete and archive once EC-1..EC-k are satisfied, or record explicit blockers and cold-takeover dispatch lines in beans and hand back cleanly.",
          "@language": "en"
        }
      ],
      "skos:notation": "Mon_CloseBean",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Mon_CloseBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.mon_refill",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refill slots and re-arm timer",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Claim the next unblocked child work items in the shared beans store (pushing updated queue and handover state to the branch store), dispatch fresh isolated-worktree workers into freed slots with the mandatory role-specific Process & Skill Launch Block and progress contract, and re-arm the 2-to-4-minute one-shot fallback timer before ending the turn.",
          "@language": "en"
        }
      ],
      "skos:notation": "Mon_Refill",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Mon_Refill",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.owner_decidespawn",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Decide swarm card",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Coordinator posts the full context, exit criteria, worker count, model tiers, relative token cost, reporting mode (on-demand vs periodic), options, and recommendation in chat, followed immediately by a tappable card; the owner approves or declines.",
          "@language": "en"
        }
      ],
      "skos:notation": "Owner_DecideSpawn",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Owner_DecideSpawn",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.steward_queuepr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Queue PR in merge watch",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Hand the verified six-line merge request (or ready-to-merge / needs-repin label) to the active merge steward for batch approval and merge-train landing; neither workers nor monitor self-merge outside the merge-steward lane.",
          "@language": "en"
        }
      ],
      "skos:notation": "Steward_QueuePr",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Steward_QueuePr",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.swarm_decompose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Decompose disjoint sub-beans",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify that a swarm is justified over serial execution (swarm-management), partition the goal into child work items with disjoint writable paths, explicit Done-when criteria, and non-compute-heavy idle-backlog items, and size worker count, model tiers (cost-aware routing), and host concurrency bounds.",
          "@language": "en"
        }
      ],
      "skos:notation": "Swarm_Decompose",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Swarm_Decompose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.swarm_openbean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the swarm epic",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Claim the parent Swarm Work Item and initial worker sub-beans in the shared beans store through Process_BeanOpen and push state to the branch store so sibling sessions see every active claim and handover header.",
          "@language": "en"
        }
      ],
      "skos:notation": "Swarm_OpenBean",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Swarm_OpenBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.task_dispatchworker",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dispatch workers with skill brief",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Spawned siblings start with a blank context: inject the mandatory role-specific Process & Skill Launch Block into every worker prompt (for a Merge Steward: repo local skills, merge-manager-watcher, merge-queue / Process_MergeTrain + merge-overlap + Process_MergeRefusal, merge-to-main + Task_LocalGates + verify-merge-replay, merge-conflict-patterns, and beans show <epic-id>; for any Task Sibling: target repo .claude/skills/local/*.md first, continual-progress, idle-backlog without passive sleep timers or mid-build git checkout, merge-request / merge-queue never-self-merge 6-line handoff, interaction-modality / hand-back-to-discussion, one-voice-style-guide, and repo fences), plus the verbatim PROGRESS contract; arm the 2-to-4-minute fallback timer.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_DispatchWorker",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Task_DispatchWorker",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.task_initorclaimswarmepic",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Bind or resume swarm epic",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Query beans for an active parent Swarm Work Item (epic or milestone, parameterized by --epic-id or --swarm-title; check before creating). On cold takeover after a stall, read its Cold-Start Handover Runbook first; otherwise define measurable exit criteria (EC-1..EC-k), structured child queues (completed, active, queued, idle-backlog), and user-selected status cadence (on-demand vs periodic).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_InitOrClaimSwarmEpic",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Task_InitOrClaimSwarmEpic",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmdispatchandmonitor.work_execute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Execute slice or idle backlog",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each worker executes its claimed disjoint slice in its worktree (or advances a right-scoped non-heavy idle-backlog item in a separate worktree while waiting on single-core compute, never checking out mid-build), emits live progress blocks, runs verification, pushes its branch and PR, and emits DONE without merging.",
          "@language": "en"
        }
      ],
      "skos:notation": "Work_Execute",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor.bpmn#Work_Execute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmmonitorsweep.mon_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish scoreboard and status table",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Publish the standardized two-table Human-Consumable Swarm Status Report with zero naked worker codes, bare PR ranges, or unglossed bean IDs: (Table 1) Live Repository Queue Scoreboard across PRs, Work Items, and Issues with host headroom, and (Table 2) Full Multi-Track End-State, Queue, and Worker Status Table stating EC-1..EC-k progress and plain-English proved or measured outcomes.",
          "@language": "en"
        }
      ],
      "skos:notation": "Mon_Report",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn#Mon_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmmonitorsweep.mon_sweep",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sweep progress, queues and swap",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the targeted JSONL progress extractor, query live forge PR/issue counts and synced beans states against origin/main, and inspect CPU load, root disk free space (df -h /), and total plus compressed/swap memory (top -l 1 -o mem -stats pid,command,mem,cmprs on macOS or VmRSS + VmSwap on Linux, never ps -o rss alone).",
          "@language": "en"
        }
      ],
      "skos:notation": "Mon_Sweep",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn#Mon_Sweep",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmmonitorsweep.mon_triage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Nudge, kill leak or pull Andon",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Immediately SIGKILL any runaway subprocess leaking into compressed memory or swapfiles and message its worker; nudge a silent worker via SendMessage; route dead sessions through stalled-agent-triage; or pull the Andon cord to halt remaining workers on structural divergence or host exhaustion.",
          "@language": "en"
        }
      ],
      "skos:notation": "Mon_Triage",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn#Mon_Triage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmmonitorsweep.task_assignidlecomputebacklog",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Assign non-heavy idle backlog",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assign a right-scoped, non-compute-heavy item from the parent Swarm Work Item's idle-backlog queue (documentation, metadata, review checklists, or disjoint lightweight edits in a separate git worktree, never running git checkout inside the active build's worktree) instead of letting the worker sleep on passive timers.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_AssignIdleComputeBacklog",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn#Task_AssignIdleComputeBacklog",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swarmmonitorsweep.task_refreshswarmhandover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh and push epic handover",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On every routine monitor check-in tick and milestone transition (whether chat reporting is periodic or quiet on-demand), update the parent Swarm Work Item's Cold-Start Handover Runbook (origin/main SHA, EC-1..EC-k exit status, merged/open PR wave queues, worktree-to-branch-to-HEAD-to-role/PID table, verbatim owner directives and safety fences, and under-60-second cold-takeover commands plus dispatch lines) and push immediately to cat/cat-harness/beans via swarm-epic-sync / state:push.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RefreshSwarmHandover",
      "dcterms:source": "cat-harness/sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn#Task_RefreshSwarmHandover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_cross",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cross the axes into SO, WO, ST, WT",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The TOWS matching step, and the only step that produces anything actionable. Strengths and weaknesses across, opportunities and threats down, and each cell names the strategy the pairing implies: SO — achieve opportunities that greatly match the strengths; WO — overcome weaknesses to attain opportunities; ST — use strengths to reduce vulnerability to threats; WT — prevent weaknesses, to avoid becoming more susceptible to threats. A SWOT that stops at four lists is the failure the source names as its central one. This step is what the process exists to reach. It produces CANDIDATE strategies, not a chosen one, and they are not ranked — see the process documentation on why no scoring activity exists.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Cross",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_Cross",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_framesubject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name the subject and the level",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One sentence naming WHAT is being analysed and at WHICH level — individual, organisational, national, international. The source requires this before anything is listed: \"the classification of a variable also depends on the purpose of the practice\", and the criteria for assigning a variable to a quadrant \"may be more difficult to clarify if the methodology is not used for a company but for a country\". It also bounds the known limitation that SWOT \"is rarely deployed at lower than the organization level\", where one scan drives strategy for units its factors do not hold equally for. Naming the level does not remove that risk; it makes it visible in the record.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_FrameSubject",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_FrameSubject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_groupreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pool knowledge across participants",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The four lists are reviewed by more than the person who wrote them. This is the method's own answer to its own bias limitation, and it is a distinct activity rather than advice attached to the scans, because an activity can be recorded as not performed and a recommendation cannot. Disagreement about which quadrant a factor belongs in is an OUTPUT of this step, not a failure of it — it feeds A_RecordAmbiguous.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_GroupReview",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_GroupReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_handoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand the candidates to a decision methodology",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The candidate strategies go to `options-analysis`, which selects the decision methodology by context and applies it. SWOT does not make that selection and does not make the decision. What is handed over includes the ambiguities from A_RecordAmbiguous and the fact that the candidates are UNRANKED. A receiving methodology that assumed an ordered list would be reading a priority SWOT never established.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_HandOff",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_HandOff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_recordambiguous",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what did not classify cleanly",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Factors that sit in two quadrants, or in none, are written down as such. The source states this as inherent rather than as analyst error: \"the same factor can be fitted in two categories. A factor can be a strength and a weakness at the same time.\" It adds the two drifts — strengths not maintained become weaknesses, and opportunities not taken but taken by competitors become threats. A scan that silently forced every factor into one quadrant would report a cleanliness the method does not have. This is the same third-state discipline the rest of this repository applies to \"could not determine\": an unclassifiable factor is a finding, not a blank.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordAmbiguous",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_RecordAmbiguous",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_scanexternal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the environment opportunities and threats",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The external axis, first, per Weihrich. Work the source's categories of environmental change rather than free-associating: societal, governmental, economic, competitive, supplier and market changes, each item recorded with what it impacts. An opportunity is an external element that gives benefit; a threat is one that could cause trouble. Both are outside the subject and largely beyond its control — that is what puts them on this axis, not whether they feel good or bad.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ScanExternal",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_ScanExternal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_swotanalysis.a_scaninternal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the subject strengths and weaknesses",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The internal axis. Work the source's functional checklist rather than a blank page: marketing, research and development, management information systems, management team, operations, finance, human resources. A strength gives advantage over others in the field; a weakness places the subject at a disadvantage relative to others. Both are attributes OF the subject. The source's warning belongs to this step specifically: listing strengths on paper \"is very different from testing the organization and experiencing the strengths at work\", so a strength recorded here is a claim, and where evidence for it exists it is cited.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ScanInternal",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_ScanInternal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.call_beanclose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanClose: end the bean in a state that says why — complete and archive it, scrap it with its reasons and archive it, or record the blocker and hand it back. The one place resolve and archive are drawn; placed straight before the end so the engine's resolve sees nothing left but the archive step.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanClose",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Call_BeanClose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.call_beanopen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanOpen: check before you create, find out whose the bean is, and claim it — or leave it alone when it is someone else's. The one place a claim is drawn; the gateway after this reads which end it reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanOpen",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Call_BeanOpen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.call_contenttypespecialisation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Synthesise the recipe with that specialisation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "BOUND BY THE CONTENT TYPE, so no `calledElement` is written here: each specialisation process belongs to the layer that owns its content type, and a lower layer cannot name a higher layer\\'s process. The specialisation is the one Task_DetermineSpecialisation found; so no single content-type `calledElement` is hardcoded here: the activity names `test-data-sets`, and each content-type adapter supplies its own specialisation subprocess. `fhir-templating` (`FHIR_TEMPLATING_SPECIALISATION`) is one named specialisation for FHIR IG / DAK content (MeasureReport cohorts, questionnaire responses, bundle templates) — named as such, not the platform design; document folios (`markdown-fixture`), proof folios (`lean-counterexample`), and tabular cohorts (`tabular-cohort`) supply their own.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_ContentTypeSpecialisation",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Call_ContentTypeSpecialisation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.call_smereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SME review of cases or cohorts",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Calls `Process_SmeTestDataReview` (`sdlc/processes/sme-test-data-review.bpmn`) so a human SME in a `judgementOnly` lane reviews each worked case (`decision-support`) or cohort plus expected value (`indicator-definition`) and records an attributable `sme-case-verdict/1.0.0` node.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_SmeReview",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Call_SmeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.task_classifyset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Classify data set: fixed (curated) or generated (recipe)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Decide whether the test case requires a small, committed, cited fixed data set (`test-data-fixed/1.0.0`, usable as certification evidence once reviewed) or a deterministic generated recipe (`test-data-generated/1.0.0`, `template` + `params` + `seed`, never stored materialised).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ClassifySet",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Task_ClassifySet",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.task_curatefixed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Author the fixed test data set",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the curated `records` and optional `citations` with `$schema: \"test-data-fixed/1.0.0\"` and `kind: \"fixed\"` into the layer's declared `test-data-fixed` directory (`schemas/sdlc/test-data.ts`). Recipe fields (`template`, `params`, `seed`) are refused by the strict schema.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CurateFixed",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Task_CurateFixed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.task_determinespecialisation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Determine the content type and its specialisation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the folio's `contentType` and the `specialisation` registered for it (`TestDataSpecialisationSchema` in `schemas/sdlc/test-data.ts`): `fhir-templating` for FHIR IG and DAK content, `markdown-fixture` for document folios, `lean-counterexample` for proof folios, `tabular-cohort` for aggregate indicator tables. None registered stops here and says so, rather than guessing one.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_DetermineSpecialisation",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Task_DetermineSpecialisation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.task_verifyselfidentifying",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify file self-identifies by $schema and kind and bind into test plan",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Parse the file with `discriminateTestDataSet` (`schemas/sdlc/test-data.ts`) to confirm a consumer can tell fixed from generated from the file content alone (never the path), verify `verifyGeneratedSetDigest` on generated sets, and bind the resulting `TestDataRef` (`toTestDataRef`) into the `test-plan/v1` case.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_VerifySelfIdentifying",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Task_VerifySelfIdentifying",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testdatacuration.task_writerecipe",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the generated-data recipe",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record `contentType`, `specialisation`, `template`, `params`, `seed`, and the canonical `sha256` digest (`computeGeneratedSetDigest`) with `$schema: \"test-data-generated/1.0.0\"` and `kind: \"generated\"` in the layer's declared `test-data-generated` directory. Never store materialised records.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_WriteRecipe",
      "dcterms:source": "cat-harness/sdlc/processes/test-data-curation.bpmn#Task_WriteRecipe",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_binddata",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Bind the test data",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Per bean `vm6m`: a fixed set is a committed path and counts as evidence only once reviewed; a generated set is template + params + seed and is never materialised. Both feed the run's data hash, and nothing that feeds the process hash may feed it too.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_BindData",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_BindData",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_execute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Execute every case, or skip it with a reason",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every case in dependency order. A case is executed or explicitly `skipped` with its reason; a case that simply has no verdict is a finding, because it cannot be told from a case nobody ran.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Execute",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_Execute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_filecertification",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "File the signed certification",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The signed certification goes under the declared `attestations` graph on main (owner ruling D2 (a), D5 default), pointing at the report it certifies. The bean resolves here, once the process has actually finished. Files it as `qa-attestations/v1`.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_FileCertification",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_FileCertification",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_recordcertification",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the certification decision",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The judgement: the certifier records, under their own name, that the system meets plan P at this version on this run. It is written under the declared `attestations` graph beside the other judgements, never on the `qa-reports` branch with derived results. A user task, so no agent or pipeline can fill it.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordCertification",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_RecordCertification",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_recordrefusal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the refusal, with the failing cases",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A complete, trusted run in which a case failed. The refusal names the failing cases and is the end of this request; nothing is signed. The bean resolves here because the process has finished — what to do about the failure is a new piece of work.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordRefusal",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_RecordRefusal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_recordundetermined",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record why it could not be decided",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The third state: which fact kept the table from deciding — a run not finished, an unknown data hash, an unexecuted case, a checker that disagreed or could not run, or nothing passed. A note and not a resolution, because the request is still open: it needs a re-run or an adjudication, not a verdict.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordUndetermined",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_RecordUndetermined",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_reexecutesample",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-execute a sample, blind to the tester's verdicts",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Given the plan, the bound data and a sample of case ids — not the report. Says `agree`, `disagree` or `unknown`; `unknown` (could not run) is said as plainly as a disagreement, because the table reads both the same way and an unknown read as agreement certifies on one party's word.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ReExecuteSample",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_ReExecuteSample",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_request",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Request certification of the system against plan P",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Name the plan by id AND version, and the system under test by actor id. The actor must carry the `systemUnderTest` facet: an actor that has not said it can be tested is not run against a plan by default. The bean this instance tracks is claimed here.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Request",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_Request",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_resolveplan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the plan",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The plan parses, names at least one `req:` requirement, its `exitCriteria` resolves to a decision in a `.dmn` that exists, and its `scope.kind` is the system's facet kind. A plan that does not resolve is not run — `test-plan-resolves` audits the same join afterwards. Reads a `test-plan/v1`.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ResolvePlan",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_ResolvePlan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.a_writerun",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the test run and the test report",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The run records `plan {id, version}` and `sut {actor, version, reach}` with its data and process hashes; the report rolls up per plan, never across plans, and goes to the `qa-reports` branch at `tests/plan/sut/run/`. No verdict in it may name the system under test as its reviewer. Writes a `folio-test-run/v1` and a `test-report/v1`.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_WriteRun",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#A_WriteRun",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.call_beanclose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanClose: end the bean in a state that says why — complete and archive it, scrap it with its reasons and archive it, or record the blocker and hand it back. The one place resolve and archive are drawn (bean m8gz, owner 2026-10-24); placed straight before the end so the engine's resolve sees nothing left but the archive step.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanClose",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#Call_BeanClose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.call_beanopen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanOpen: check before you create, find out whose the bean is, and claim it — or leave it alone when it is someone else's. The one place a claim is drawn (bean m8gz, owner 2026-10-24); the gateway after this reads which end it reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanOpen",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#Call_BeanOpen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_testplanexecution.call_sign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign the certification",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`qa-report-signing.bpmn`, unchanged: it builds the signable run record, resolves the signer's reach, and routes the signature to the API or to a human release authority.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Sign",
      "dcterms:source": "cat-harness/sdlc/processes/test-plan-execution.bpmn#Call_Sign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_accessibility",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accessibility: measure, do not assert",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Contrast COMPUTED against the real ground, including the worst case a backdrop can present; a non-colour channel wherever colour carries meaning (SC 1.4.1); an accessible name on every region; keyboard and focus order. An automated pass is necessary and not sufficient — axe accepts a non-empty placeholder as an accessible name, and a CSS selector that matches nothing raises no error at all.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Accessibility",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Accessibility",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_branding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Branding: does it read as this layer?",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Marks, palettes and art against the layer's own declaration rather than a remembered style. The question a downstream folio makes sharp: would this layer inherit something it did not choose?",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Branding",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Branding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_inventory",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inventory the ingested assets",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which graphical assets arrived, for which surfaces of the website or app design, in which locales, and at which VIEWPORTS: every surface at a web width and at a mobile width. Read off the ingested artefacts rather than off the intent — a layout the source declares but does not supply is not in the inventory, and a surface the design needs but no asset covers is the one that would ship wrong.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Inventory",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Inventory",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_locales",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Languages: extracted, rendered, and RTL",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every user-facing string reaches the .pot; every declared locale renders without clipping or overflow; right-to-left is laid out rather than mirrored by accident. New UI is where untranslated strings enter, because nothing was stale — there was nothing there before.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Locales",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Locales",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.a_raisefindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise findings before the assets land",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings go back to whoever authored the choice, because the choice was theirs: a theme is picked per note by a human or an agent, and there is no mapping to correct instead. Raised, never silently fixed — a reviewer who re-themes a note has substituted their judgement for the author's without saying so.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RaiseFindings",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_RaiseFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_themeuireview.r_judge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Judge the assets in their design",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person looks at the ingested assets laid out in the design they are for, at BOTH a web and a mobile width. THIS IS A HUMAN STEP INSIDE INGESTION, stated rather than hidden: ingestion of a THEME SOURCE is attended at this step, while ingestion of everything else never reaches it. A judgement made at one viewport is incomplete, not passed, and the wireframe of the surface (wireframe-design-review) says what each layout was meant to be. A clean build, a passing suite and every gate can all miss what only rendering the page and looking finds.",
          "@language": "en"
        }
      ],
      "skos:notation": "R_Judge",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#R_Judge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_trackedwatch.task_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the tracking issue",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Close",
      "dcterms:source": "cat-harness/sdlc/processes/tracked-watch.bpmn#Task_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_trackedwatch.task_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the tracking label exists",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Label",
      "dcterms:source": "cat-harness/sdlc/processes/tracked-watch.bpmn#Task_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_trackedwatch.task_track",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or edit the one tracking issue",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Track",
      "dcterms:source": "cat-harness/sdlc/processes/tracked-watch.bpmn#Task_Track",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the flagged passage (human)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human SME or editor reviews the flagged passage. They may: - Accept the translation as-is (false positive) - Edit the translation and re-run QA - Reject and request re-translation The round trip establishes that two readings differ. Which one is right is a human call.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_edittranslation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit the flagged passage and re-inject",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer corrects the passage in the PO rather than sending the whole translation back. Flows to Task_PoInject, so the round-trip QA runs again over the corrected text — \"edit the translation and re-run QA\", which is what the adjudication step has always offered and what this process could not do. A userTask, not a service task: this is the one step here where a person edits content, and the lane's actor is the reviewer who just adjudicated.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_EditTranslation",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_EditTranslation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_glossarycheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check glossary terms (translation:glossary:check)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "After translating: run `translation:glossary:check --instance <dir> --locale <locale>`, fix the violations, and include its glossary section in the KG QA report. A term translated against the term base is a terminology miss, so it takes the drift branch to the adjudicator.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_GlossaryCheck",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_GlossaryCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_poinject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject translations (PO → Markdown)",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PoInject",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_PoInject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_potextract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract translatable strings (POT)",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_PotExtract",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_PotExtract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA (back-translate)",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RoundTripQA",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_RoundTripQA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off translation (human adjudicator)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human reviewer signs off the translation at the chosen hierarchy level (block, section, chapter, or folio). Updates status.json: { official: true, signedOffBy: \"...\", signedOffAt: \"...\", sourceHash: \"...\" } Tool: translation_signoff MCP tool",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Signoff",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_stalenesscheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check staleness (source hash)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On source content change: computes sha256(source.md) and compares to each translation's status.json sourceHash. If they differ, sets stale: true. The translation remains visible with a \"stale — needs re-adjudication\" indicator.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_StalenessCheck",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_StalenessCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_termbase",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build and review the locale term base",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before translating: build the locale term base from the layered glossaries, review it, and translate with it. Precedence, within one subject area (the scheme's `subject`): the more authoritative (lower) layer fixes a term's translation; a layer only adds. A match in another subject area is a sense check, not a violation. Each layer's glossary is the directory it declares with the `glossary` graph typology. A fixed translation is an authored term with a non-empty, non-fuzzy msgstr in its scheme's catalogue.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TermBase",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_TermBase",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce translation (PO file)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Translation of .pot → .po, with the locale term base, by one of: 1. Existing PO from the WHO SMART Base IG (Weblate/Crowdin/Launchpad) 2. Open machine translation as candidates: `translation:candidates` (Tool translation-candidates), OPUS-MT run locally and/or a self-hosted LibreTranslate, no freemium API. Each source's text is a candidate in <catalogue>.candidates.json for the reviewer to choose among; a candidate whose placeholders do not round-trip is not recorded; an empty msgstr gets the first good candidate, tagged #, fuzzy; the node records generatedBy \"machine\", never official. A catalogue marked DO NOT MACHINE-FILL gets candidates only. 3. Agent (LLM) translation 4. Human translator Result: <locale>/block.po with msgid/msgstr pairs. A machine or agent string stays fuzzy and unofficial until a person picks or accepts it (translation review page) or signs it off (Task_Signoff).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Translate",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_writeofficial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (official)",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_WriteOfficial",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_WriteOfficial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translation.task_writeunofficial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (unofficial)",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_WriteUnofficial",
      "dcterms:source": "cat-harness/library/processes/translation-workflow.bpmn#Task_WriteUnofficial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.call_tr_roundtrip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round trip on the changed strings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The untainted round trip, with the sample restricted to the strings this run translated.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_TR_RoundTrip",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Call_TR_RoundTrip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_coldstart",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cold start: mount and attach",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lay down every pinned layer from each layer's lock, as its AGENTS.md cold start says, and attach each repository the run will change.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_ColdStart",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_ColdStart",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_detect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect what moved",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`translation:status --instance <root>` for new, obsolete and fuzzy strings, and the instance's template check. Either failing, or showing anything but zero, is a change.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_Detect",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Detect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-run the gates",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Officiality, catalogue coverage, translated links, `kg:locale`, `translation:glossary:check`, and the supplements compiling.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_Gates",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge the PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Merge the layer's PR to main, then confirm the template checks pass on main.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_Merge",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_mergelocales",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge into each locale",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Merge each refreshed template into every locale's catalogue: new strings arrive empty, changed ones fuzzy, and obsolete ones are kept as `#~` entries, never deleted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_MergeLocales",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_MergeLocales",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_prunerulings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prune the rulings of removed strings",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Drop the round-trip rulings of strings main no longer holds, with the layer's prune command (its AGENTS.md names it, by convention `translation-qa:prune`), once the PR is on main. Only a layer that keeps per-string rulings on an attestations state branch has one. Run it as a dry run first: it lists each ruling whose msgid main no longer holds but once did, and the indices it renumbers to catalogue order. Push the result (`--write`, then the state-branch push) only when the diff is purely dropped and renumbered rulings. It never changes or invents a verdict, and it keeps a ruling recorded ahead of a PR that has not merged. Never run it before the removal is on main: the state branch serves main too, and main would be left with strings that have no ruling. Nothing to prune is the usual result, and this step then writes nothing.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_PruneRulings",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_PruneRulings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "QA report and one PR to main",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write each locale's QA report, then open one PR for the layer, based on and targeting main.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_Report",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_sourceissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report source errors as one issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Any source-text error the translators found goes into one issue on the source, with its location. When there is none, this step writes nothing.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_SourceIssue",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_SourceIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_templates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh the templates",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-run the layer's extractors, once for every locale: pages, diagrams, glossary schemes.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_Templates",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Templates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationrefresh.task_tr_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate new and fuzzy only",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only the empty and fuzzy entries, in every locale, with the terms the term base fixes. A finished string is not touched. Candidates for the empty and fuzzy entries may come first from `translation:candidates` (Tool translation-candidates: open engines, OPUS-MT and/or self-hosted LibreTranslate), recorded in <catalogue>.candidates.json; an empty entry also gets the first good candidate, fuzzy, until it is re-translated here or a person picks or accepts one on the review page.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TR_Translate",
      "dcterms:source": "cat-harness/library/processes/translation-refresh.bpmn#Task_TR_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_autopick",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Auto-pick by rank",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "For each string nobody has adjudicated, its candidates are ranked: official 0, adjudicated 1, a person's proposal 2, a translation platform (Weblate, Crowdin, Transifex) 3, an agent model 4, machine translation 5; a QA failure adds 10; ties go to the newest; a stale candidate, made for another source text, is never picked. An empty `msgstr`, or one that is itself an earlier auto-pick, takes the best: fuzzy and unofficial (`chosen.how: auto`), except an official candidate whose English matches the msgid exactly, which is written as `auto-official`. A collaborator's choice, and text whose provenance is not an auto-pick, are never overwritten. `translation-strings.ts` `applyAutoPick`; the 🌐 pane ranks with the same function's rules.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_AutoPick",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_AutoPick",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_blockpane",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open a block's 🌐 translation pane",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On every page, source-language pages included, a block's 📣 panel has a 🌐 pane that lists every locale's current translation of the block, its status, and how it came to be (`chosen.how`, `chosen.by`). On a translated page its own locale comes first and the others are collapsed. ✎ Fix translation opens, per locale, each of the block's strings with its candidates ranked as the auto-pick ranks them: the text; the source's kind, id and version; who proposed it, linked to the issue it came from; the date; its QA results; a stale mark when it was made for another source text; whether an official source's English matched exactly; and which one is the default.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_BlockPane",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_BlockPane",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce candidate translations (any engine)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One or more candidate sources write alternatives per string to `translations/<locale>/<catalogue>.candidates.json` (`translation-candidates/v1`), each candidate carrying its source: an agent model, an open machine-translation model, a web service, or a person. The engines are interchangeable behind one skill, `translation-candidate-source`: whichever runs, the same sidecar comes out. Writers append; a candidate is never a verdict.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_Candidates",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_Candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pick a candidate or write your own",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "For each wrong string: pick a ranked candidate, which fills an editable box (its source is recorded with the suggestion while its text is unedited), or type your own. Anyone's text is a proposal. An owner, member or collaborator may also tick Choose as the translation and say why: the suggestion then carries `choose: true` and the `reason`, and it is recorded as the string's translation only once the workflow has confirmed who they are. The suggestion carries the text the reviewer saw (`current`), so a choice against a catalogue that changed under them is caught.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_Choose",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_fileissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "File the adjudication issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Submit opens GitHub's new-issue form prefilled with a readable summary and a `translation-adjudication/v1` JSON block, labelled `translation-adjudication` and titled `[translation review] …`. The summary says, per string, whether the author proposes or chooses. When the record is too long for a URL the page copies the body for pasting instead. Filing it is the act of proposing, or, for a collaborator who chose, of adjudicating.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_FileIssue",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_FileIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the PR; merge or close",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The maintainer checks that the PR writes down what the issue decided and nothing else, lets the layer's checks run, and merges or closes it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_Merge",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_openpr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open a ready PR and comment",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Commit on `translation-adjudication/issue-<n>`, authored by the issue's author, open a ready pull request that names the issue, and comment the summary on the issue: what was recorded and what was refused.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_OpenPR",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_OpenPR",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Plan the records (translation:adjudicate)",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`translation:adjudicate` reads the `issues` event GitHub wrote, never the body from a shell variable: the body is untrusted and is only parsed as JSON. It decides every write before making any, and refuses rather than guesses.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_Plan",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_Plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append every suggestion as a human candidate",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every suggestion, whoever filed it, is appended to the catalogue's `translation-candidates/v1` sidecar as `{kind: \"human\", id: \"github:<login>\", by, issue}`, with the `msgidHash` of the string it translates and its placeholder QA. A proposal is never refused for a changed catalogue and never conflicts with another: the sidecar keeps them all, ranked side by side. A record that does not parse, or that names another repository or another translations directory, is refused here.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_Propose",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_refuse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment why nothing was recorded",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every refusal, with its reason, as a comment on the issue (exit 3). No pull request is opened. A refusal is never a partial record dressed as a whole one; a new review is a new issue and a new instance of this process.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_Refuse",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_Refuse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the catalogue on the review page",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer opens the review page and reads one catalogue's strings against their source, with the candidates beside each.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_Review",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_reviewpage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the review page",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`translation:status` writes `review.html` beside the status page. Every site build, wherever the checkout has translations, publishes `assets/translation-status/review.json` (`folio-translation-review/v1`: every catalogue × locale, its state, and the hash of the catalogue's bytes) and, per catalogue, its strings projection (`folio-translation-strings/v1`: every string in every locale, its status, its candidates ranked, and the default pick) — `publish-translation-review.ts`, run by the site build. The catalogue hash is what an adjudication is pinned to; the strings projection is what a block's 🌐 pane draws.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_ReviewPage",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_ReviewPage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_seedfuzzy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the first candidate as a fuzzy msgstr",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Candidates are never a barrier to having a translation. The first candidate becomes the `msgstr`, marked `#, fuzzy`: the page shows it, the status page counts it as needing review, and it stays the default until a person adjudicates the catalogue.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_SeedFuzzy",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_SeedFuzzy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationreviewadjudication.task_tra_write",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the choices and sign-offs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A chosen suggestion becomes the string's `msgstr`, not fuzzy, and its sidecar entry's `chosen` records `how: adjudicated`, by whom, when, in which issue, why, and which candidate. `acceptable`: the catalogue's translation node gets `signedOffBy` / `signedOffAt`, and each fuzzy string in it is adjudicated as it stands. Each adjudication appends an entry to the catalogue's `translation-qa` attestation (criterion `human-adjudication`) naming the issue and the hash the person saw, and a proposal one under `human-proposal`; the attestation is append-only and checked against `qa-attestations/v1` before it is written. The PO header `X-Folio-Official` and the locale's `status.json` are never touched.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TRA_Write",
      "dcterms:source": "cat-harness/library/processes/translation-review-adjudication.bpmn#Task_TRA_Write",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_backtranslate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Back-translate the target text",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Render each target string into the source language, from the target text alone, using no tools, and say so in a TOOLS_USED line that is recorded. A string that cannot be rendered is reported as such, not guessed.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RT_BackTranslate",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_BackTranslate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_prescreen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pre-screen every pair",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mechanically, over every (source, back-translation) pair: flag a pair whose negation, modal, quantifier, number or code tokens differ, and a pair whose word overlap is low. The pre-screen only chooses what is read first; it rules on nothing, and an unflagged pair is still in the sample.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RT_PreScreen",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_PreScreen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record both witnesses",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record the adjudicator's verdict first and the back-translator's rendering behind it (`translation:roundtrip --payload`), so a reader can ask both who ruled and on what basis. The counts (sampled, flagged, drift, not drift) go into the locale's QA report.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RT_Record",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_recordna",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record could not dispatch",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write one entry, `result: \"n/a\"`, `metrics.dispatch: \"unavailable\"`, with the reason. The producer may write this entry and no other. It is never a pass, and the QA report says so.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RT_RecordNA",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_RecordNA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_rule",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read and rule each flagged pair",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read every flagged pair in full and rule it drift or not drift, with the reason. Not drift: synonyms, articles, word order, inflection, a purpose clause rendered in the subjunctive, an acronym left uninflected, an acronym spelled out with the acronym kept. Drift: a claim added, dropped, weakened, strengthened or reversed; a term of art swapped for one that means something else; a named entity, number or quantifier moved.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RT_Rule",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_Rule",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_translationroundtrip.task_rt_sample",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Draw the sample",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On a first translation: every diagram label, every persona and scenario string, and a seeded random fraction of the rest, with the seed written down so the sample can be drawn again. On a refresh: only the strings that were new or fuzzy. Hand the back-translator the msgstr values alone, keyed by an opaque id.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RT_Sample",
      "dcterms:source": "cat-harness/library/processes/translation-round-trip.bpmn#Task_RT_Sample",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.a_applypin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move the pin and open the PR",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The pin literal moves in the one file `upstream-pins.json` declares, and the PR body says what the version range changed in RENDERED output — the evidence, not just the verdict.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_ApplyPin",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#A_ApplyPin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.a_evidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the MVP evidence staging URL + gate results",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Staging URL, gate results and the impact analysis, on the PR. Enough for the reviewer to answer without opening anything else.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Evidence",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#A_Evidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.a_impact",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Impact analysis what of ours binds it",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The half a changelog cannot supply, because upstream does not know what you reached into. Worked from the row's `binds` list in `upstream-pins.json`. For the theme: `site-chrome/assets/js/docs-ui.js` MOVES the theme's own search markup into the action launcher and binds `.search`, `#search-input` and `.search-label`; `docs-ui.css` overrides `.side-bar`, `.site-header` and `.main-header`; three e2e specs assert the structure the theme emits. An upstream rename of any of those is not a build failure — it is a shipped feature that quietly stops working.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Impact",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#A_Impact",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.a_recordoutcome",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the hold or the decline",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A HOLD is a block with an expiry and a revisit trigger: a hold with neither cannot be told from abandoned work, and the next watcher run re-raises the same pin with no memory of why it was left. A DECLINE is a scrapped bean carrying its reasons — what stops the next agent re-entering the same dead end. Either way the decision is written down before the process ends, and the bean is resolved from here: a run that stops at \"we looked and said no\" is as finished as one that moved the pin.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_RecordOutcome",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#A_RecordOutcome",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.a_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the delta pinned → candidate",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Restricted to the directories that reach our output — for a Jekyll theme `_sass`, `_includes`, `_layouts`, `assets`. Upstream's own docs, CI and tests cannot reach us, and counting them makes a harmless release look alarming. The changelog is the claim; `git diff --stat pinned..candidate` over those paths is the evidence.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Scope",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#A_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.call_beanclose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanClose: end the bean in a state that says why — complete and archive it, scrap it with its reasons and archive it, or record the blocker and hand it back. The one place resolve and archive are drawn (bean m8gz, owner 2026-10-24); placed straight before the end so the engine's resolve sees nothing left but the archive step.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanClose",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#Call_BeanClose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.call_beanopen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanOpen: check before you create, find out whose the bean is, and claim it — or leave it alone when it is someone else's. The one place a claim is drawn (bean m8gz, owner 2026-10-24); the gateway after this reads which end it reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanOpen",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#Call_BeanOpen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.call_optionsanalysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Options analysis adopt · hold · decline",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the single edge into `PM_Decide`, and deliberately not earlier: the MVP build and its gates are HOW the options' costs are measured, so an analysis before `Task_Mvp` would weigh alternatives against no evidence. Everything the decider needs exists by the time the reviewer has finished and the fixable findings are fixed. In the Agent lane, because this step produces the analysis and does not make the decision — `PM_Decide` is a `userTask` whose lane admits `person` only, and putting the analysis in the agent's lane is what keeps that separation legible rather than implied. A subprocess that decided would be a second accepting party. Reached through the loop as well as straight through: `SF_UA_8` re-enters at `A_Impact`, so a run where the reviewer found something fixable arrives here a second time with different evidence. That is a genuine re-analysis and its `op=\"note\"` appends rather than deduping, which is the behaviour wanted — a second note records that the options were weighed again against changed inputs.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_OptionsAnalysis",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#Call_OptionsAnalysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.pm_decide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adopt, hold or decline",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PERSON decides. The lane admits `person` only, so `activity-fulfilment-kind` fails the moment somebody makes an agent the accepting party, and `relaxable=\"false\"` means no package may relax the step. The publication manager rather than the editor because a pin is not a change to the corpus — it is a change to what the published artefact is BUILT FROM, and that role is the one accountable for what is live. Deliberately NOT a DMN-backed gateway. Every computed gateway in this repository reduces to arithmetic over tool output; this one weighs a rendering nobody can score against the cost of staying behind, and a table here would look authoritative without being so.",
          "@language": "en"
        }
      ],
      "skos:notation": "PM_Decide",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#PM_Decide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.r_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the MVP against what we bind to",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A narrower question than \"is the new version good\": does everything in `binds` still hold, checked against the deployed page. A `userTask`, and the lane admits `person` and `agent` — a review agent is a legitimate reviewer here, and the separation that matters is the next lane's: a reviewer cannot accept.",
          "@language": "en"
        }
      ],
      "skos:notation": "R_Review",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#R_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.task_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the row's gates tests · e2e · site-links",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `mvp` commands declared for this tenant. For the theme: `bun test`, `CI=1 bunx playwright test` (a11y, action tiles, sidebar panels, QA panel) and `scripts/site-links.ts --site ./_site`, which checks the navbar tiles against the BUILT site rather than against the attribute — the distinction that let a 404 ship unnoticed once already. A red gate is EVIDENCE, not an exit. It does not end the process and it does not loop by itself: \"this version breaks us\" is a finding the decider needs, not a reason to stop before they see it.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Gates",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#Task_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreamadoption.task_mvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "MVP: build the candidate on a staging branch",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An MVP is a DEPLOYED BUILD, not a description of one. The pin is moved on a branch and `feature-staging.yml` publishes it under `branches/<branch-slug>/`, so the reviewer looks at the artefact rather than at a screenshot — the same argument the merge discipline makes about rendered work.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Mvp",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-version-adoption.bpmn#Task_Mvp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreampinwatch.a_pickup",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pick up the stale pin",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The hand-off from the mechanical lane to the one that can exercise judgement. Claiming the bean here is what stops two sessions adopting the same bump.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_PickUp",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-pin-watch.bpmn#A_PickUp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreampinwatch.call_adopt",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adopt the version bump",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reusable subprocess. Every pinned dependency enters it the same way, so a new tenant is a registry row and a call — never a second diagram saying the same thing in different words.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Adopt",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-pin-watch.bpmn#Call_Adopt",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreampinwatch.call_beanclose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanClose: end the bean in a state that says why — complete and archive it, scrap it with its reasons and archive it, or record the blocker and hand it back. The one place resolve and archive are drawn (bean m8gz, owner 2026-10-24); placed straight before the end so the engine's resolve sees nothing left but the archive step.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanClose",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-pin-watch.bpmn#Call_BeanClose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreampinwatch.call_beanopen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanOpen: check before you create, find out whose the bean is, and claim it — or leave it alone when it is someone else's. The one place a claim is drawn (bean m8gz, owner 2026-10-24); the gateway after this reads which end it reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanOpen",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-pin-watch.bpmn#Call_BeanOpen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreampinwatch.task_closeissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the tracking issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Closed automatically when every pin is current, so the issue's existence is the state rather than a log of past states.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_CloseIssue",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-pin-watch.bpmn#Task_CloseIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreampinwatch.task_queryupstream",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "List upstream releases and compare to the pin",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`git ls-remote --tags`, filtered by the row's `tagPattern` and ordered by version. Nothing is cloned and no API token is needed, so the check runs the same way on a laptop and in CI.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_QueryUpstream",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-pin-watch.bpmn#Task_QueryUpstream",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreampinwatch.task_readpins",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the pin registry upstream-pins.json",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The registry lists the tenants and says, per row, WHICH FILE holds the pin literal and how to read it. It deliberately does not store the version: one answer to \"what are we running\", read from the file the build reads.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_ReadPins",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-pin-watch.bpmn#Task_ReadPins",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_upstreampinwatch.task_trackissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one tracking issue",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "One issue, edited in place. GitHub's own failure mail is the channel that was already ignored thirty times, so this adds none: an edit does not notify, and a pin that stays behind for two months stays one unread item rather than nine.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_TrackIssue",
      "dcterms:source": "cat-harness/sdlc/processes/upstream-pin-watch.bpmn#Task_TrackIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate: prose, scope, or exception",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The same three outcomes as the base voice axis. The register is wrong for this block (fix the prose); the rule does not apply to this content (scope it on the voice, one edit rather than ten overrules); or the rule applies and this block is an exception (a reviewer entry saying why).",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_loadactive",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Load the active voices",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The activated set only, never everything shipped. An id naming no shipped voice is an error rather than a skip — a folio that believes it is applying a voice and is applying nothing has the cleanest-looking output of the three.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_LoadActive",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_LoadActive",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_mechanicalhalf",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the rule's mechanical half",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whatever `patterns` and `terminology` the rule carries. A `judgementOnly` rule has no mechanical half by declaration, which is different from nobody having written one yet.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_MechanicalHalf",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_MechanicalHalf",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_opencitation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the rule's citation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every rule resolves to a real `library/` section or a KG node, and carries the quote it was read from. Opening it is what lets a reviewer say WHY the rule applies — and it is the only way to catch a rule that misread its own source.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_OpenCitation",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_OpenCitation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_recordonsidecar",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record on the block's QA sidecar",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through `qa-merge-findings`, so the icon and the published witness agree with the decision. The adjudication LEADS the criterion and the script entry is kept beneath it: a disagreement between a checker and a reviewer is information.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordOnSidecar",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_RecordOnSidecar",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_voicereview.task_ruleiswrong",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "The RULE is the defect — bean it",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A rule its own quote does not support is a finding against the voice, not against the block.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RuleIsWrong",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_RuleIsWrong",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build into its own chrome-less route",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `web-app-build` (`web-apps:build`, run with the other declared visualiser writers): each locale's strings are written to `<i18n.out>/<locale>.json` from the `.po` (building is the injection), the app installs from its lockfile and builds, and the build is copied to `<locale>/<harness>/apps/<id>/` with every page marked `folio-navbar: none` and `rendered-by: web-app-build`; the `apps/` index lists every app with its size. No other page embeds an app, so it loads only when a reader opens its route.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Build",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the declaration and translations",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `web-app-build` (`web-apps:build --check`): the manifest parses, `package.json` has the build script, a lockfile pins exact versions, no two layers claim one app id, every template is current, and no translation drops or adds a `{placeholder}`. Untranslated strings are reported, not failed: the app falls back to the source text per string.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Check",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the web-app directory",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The layer declares a directory of kind `web-app` in its `<name>.json` and puts a `web-app.json` (`web-app/0.1.0`) at its root: id, title, description, how it builds, the languages it ships (the site's six UN languages: ar, en, es, fr, ru, zh), the layer directories it reads at build time (`contentFrom`), a size budget, and for a copied app its licence and source. Its UI strings are one flat catalog in the source language (`i18n.catalog`). No publish script, no `site.build.keep`, no harness of its own.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Declare",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract the app's translation templates",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `web-app-build` (`web-apps:build --extract`): the catalog becomes `translations/<locale>/apps/<id>.pot` in the declaring layer, one `ui-string` entry per key with the key as `msgctxt`. This is the app's \"refresh the templates\" step, named in the layer's AGENTS.md so the translation watcher runs it too.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Extract",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_fix",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix the declaration or the catalog",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The author fixes what the check named (the manifest, the lockfile, a clashing id, a stale template) and commits again. A translation that dropped a placeholder goes back to its locale's translator through the same PR route.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Fix",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Fix",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.a_size",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the size against its budget",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The index flags an app over its `sizeBudgetMB`; the site size review reads it with the rest of the site. Over budget is a finding for the author, never a silent publish.",
          "@language": "en"
        }
      ],
      "skos:notation": "A_Size",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#A_Size",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_webapppublish.call_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate into each locale",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The harness's multi-locale translation, unchanged: the templates are merged into each locale's `.po`, new and fuzzy strings are translated with the fixed terms, the gates run, and each locale is its own PR. Afterwards the translation watcher (`Process_TranslationRefresh`) keeps them current as the catalog moves.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Translate",
      "dcterms:source": "cat-harness/processes/ui/web-app-publish.bpmn#Call_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.call_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudication",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "folio-assistant's adjudication: the adjudication leads, the checker's entry is kept, and the dispensation carries its reason. Reviewers disagreeing on ONE criterion is a criterion disagreement, so this calls the QA-criterion specialisation: the failing entry stands, the criterion does not apply to this screen, or a dispensation is granted with its reason. The entry condition matches exactly rather than approximately: GW_Agree asks whether the blind reviewers' entries agree and takes `no` here, and `Process_CriterionAdjudication` starts at \"entries for one criterion disagree\" — R_Review records pass, warn or fail PER CRITERION with a reason, so the disagreement reaching this step is a per-criterion disagreement between reviewer entries and nothing else.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Adjudicate",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#Call_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.call_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose a candidate",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A one-off choice between surviving candidates. Rejected candidates are kept, with the reason each lost.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_Choose",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#Call_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.d_candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce >= 2 candidates, web + mobile",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mid-fidelity HTML: monochrome, real folio content, semantic icons, no placeholder text. Each candidate has both a web layout and a mobile layout.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_Candidates",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.d_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mechanical checks, both viewports",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool wireframe-check renders every candidate at a web and a mobile viewport. It fails on horizontal overflow at mobile width, on placeholder text, and on a missing viewport, and writes screenshots and a script entry per criterion.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_Check",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.d_intent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the design intent",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A short statement of who the screen is for, what they need to do, and what it must show. It is the criterion every candidate is judged against.",
          "@language": "en"
        }
      ],
      "skos:notation": "D_Intent",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Intent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities/process_wireframedesignreview.r_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Blind review per criterion",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Criteria: intent-fit, web usability, mobile usability, accessibility, and alternatives considered. A review at one viewport only is incomplete.",
          "@language": "en"
        }
      ],
      "skos:notation": "R_Review",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#R_Review",
      "skos:note": "candidate"
    }
  ]
}
