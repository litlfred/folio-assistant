          "sourceUrl": "https://github.com/litlfred/cat-harness/blob/main/kg-ops/processes/named-query-execution.bpmn",
          "startNode": "https://litlfred.github.io/folio-assistant/cat-harness/process/Process_NamedQueryExecution/node/Start_QueryRequest",
          "summary": "Universal execution of audited named SPARQL queries against W3C RDF 1.1 N-Quads distributions across CLI, MCP, and Web runtimes."
