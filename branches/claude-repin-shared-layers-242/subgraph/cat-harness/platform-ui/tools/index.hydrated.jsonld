    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/platform-ui/tools/pdf-viewer-install/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/pdf-viewer-install.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Download the pinned pdf.js release (legacy build), verify its SHA-256, copy the parts a site needs into `<site>/assets/vendor/pdfjs/`, and add the shim that opens `?src=` only for the allowlisted URL prefixes or the site's own origin. Nothing is committed: the viewer exists only in the built site.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat pdf:viewer"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--site"
                },
                "description": "The built site directory, `_site` in both site workflows.",
                "name": "site",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--allow"
                },
                "description": "An https URL prefix the viewer may open, ending in `/`. Repeat the flag for more than one. `same-origin-only` is the explicit way to allow none — an omitted flag is a usage error, because a viewer that refuses every CDN document would otherwise ship green.",
                "name": "allow",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
              },
              {
                "arg": {
                  "flag": "--zip"
                },
                "description": "A local copy of the release zip, for offline runs and tests. Its hash is checked exactly as a download's would be.",
                "name": "zip",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ],
            "outputs": [
              {
                "description": "One line on stdout: version, destination, file count, and the prefixes it will open. Exit 2 on a usage error; a hash mismatch or a release missing a kept path throws, refusing the install.",
                "name": "summary",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
              }
            ]
          },
          "name": "pdf-viewer-install",
          "requirements": {
            "network": true,
            "runtime": [
              "bun",
              "unzip"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/pdf-inline-viewer",
          "title": "Install the inline PDF viewer into a built site"
        }
      ],
