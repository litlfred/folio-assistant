      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/publish-gh-pages.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Lay a built `_site` onto a `gh-pages` checkout as a FULL REPLACE and push it, keeping the open pull requests' staging previews: each attempt re-reads the branch, re-runs restore-staging and keep-shared-payloads against what is on it now, replaces the tree, commits `docs(gh-pages): site from <sha>` and pushes. A rejected push is rebuilt, never rebased (a rebase would re-apply the replace over a preview a sibling just deployed), up to three attempts. A restore that cannot read the branch stops the publish. A site that matches the branch is a no-op, not a failure. It publishes and does not verify: the workflow's verify step runs after it.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat pages:publish"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--site"
            },
            "description": "The built site to publish (env SITE).",
            "name": "site",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--state"
            },
            "description": "restore-staging's record file; keep-shared-payloads keeps its directory at `<state>.keep` (env STATE).",
            "name": "state",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--commit"
            },
            "description": "The commit the site was built from, named in the pages commit message (env COMMIT_SHA).",
            "name": "commit",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/CommitSha"
          },
          {
            "arg": {
              "flag": "--pages-dir"
            },
            "description": "A git checkout whose `origin` holds the `gh-pages` branch (env PAGES_DIR).",
            "name": "pagesDir",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "`published on attempt <n>`, or `nothing to publish`; any other exit is a publish that did not happen.",
            "name": "result",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "publish-gh-pages",
      "requirements": {
        "network": true,
        "runtime": [
          "bash",
          "bun",
          "git"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/render-kg-to-cdn",
      "title": "Publish a built site to gh-pages as a full replace"
    }
  ],
