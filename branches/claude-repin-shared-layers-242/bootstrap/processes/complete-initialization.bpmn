      <bpmndi:BPMNEdge id="Edge_DIA_A_ReadDeclarations" bpmnElement="DIA_A_ReadDeclarations"><di:waypoint x="330" y="770"/><di:waypoint x="330" y="680"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
