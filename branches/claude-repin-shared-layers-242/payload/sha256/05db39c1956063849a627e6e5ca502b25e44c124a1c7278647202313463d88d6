      ],
      "kind": "prose",
      "title": "Page 10",
      "pageStart": 10,
      "pageEnd": 10,
      "target": "../sections/page-010.md",
      "narrative": null,
      "content": "Counselling for HIV/AIDS: A key to caring\n\nFor whom should HIV/AIDS counselling services be provided?\nThe clients of HIV/AIDS counselling services are likely to be any of the following:\n\n- people with AIDS and their families.\n\n- those who are HIV-positive, and their families;\n\n- those seeking, or agreeing to undergo, an HIV test; and\n\n- those who are concerned that they are at risk or have been at risk of acquiring\nHIV infection, e.g. those whose partners are HIV-infected or have symptoms\nof HIV infection, those who may have been exposed through blood, those who\nhave had unprotected sex with m",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Lists those who should receive HIV/AIDS counselling, including people with AIDS or HIV and their families, people seeking an HIV test and those worried about their risk. It also identifies others who may be involved, such as partners, household members and wider family.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
