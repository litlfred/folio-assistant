    {
      "id": "library/10665-97885/blocks/prose-sec-005",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Mumps virus",
      "pageStart": 12,
      "pageEnd": 12,
      "target": "../sections/sec-005-12-mumps-virus.md",
      "narrative": null,
      "content": "Mumps virus \nMumps virus is a single-stranded, negative sense, enveloped ribonucleic acid \n(RNA) virus in the Paramyxoviridae family, Paramyxovirinae sub-family, genus \nRubulavirus. Mumps virions are pleomorphic but generally spherical structures, and \nrange in size from 85 nm to 300 nm in diameter (Cantell, 1961). The viral genome is \n15 384 nucleotides in length and encodes nine proteins from seven genes. The \nmumps genome is encapsidated by nucleoprotein (NP) and the phosphoprotein \n(P) and large (L) protein are associated with the encapsidated RNA to comprise the \nribonucleoprotein complex",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Describes the mumps virus as an enveloped, negative-sense RNA virus in the Paramyxoviridae family, with its size, genome and the proteins encoded by its genes. It notes the roles of the structural and nonstructural proteins and the genotyping scheme.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
