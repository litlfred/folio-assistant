    {
      "id": "library/10665-354400/blocks/prose-sec-029",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Accessibilité des établissements de santé et des ressources humaines pour la santé : télémédecine prestataire-prestataire",
