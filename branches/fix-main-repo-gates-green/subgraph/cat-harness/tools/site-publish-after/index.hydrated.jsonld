  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/site-publish-after.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Print the repository's workflows that a site publish must wait for, on the same commit, before it builds: every workflow that calls a reusable workflow a declared site publisher names in `after` (for example an IG's AST refresh, which seeds the cache the site is built from), plus `site.publishAfter` from `index.config.json`. A workflow that calls the shared site publish is never named: it is the publish itself. The shared `folio-site-publish.yml` runs it and then waits for each workflow it names.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat site:publish-after"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--repo"
            },
            "description": "The repository checkout whose workflows to read. Default: the current directory.",
            "name": "repo",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "The workflow file names to wait for, space-separated on one line; empty when there is none.",
            "name": "workflows",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "site-publish-after",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/feature-staging",
      "title": "Name the workflows a site publish waits for on the same commit"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
  ],
  "name": "tools/site-publish-after",
