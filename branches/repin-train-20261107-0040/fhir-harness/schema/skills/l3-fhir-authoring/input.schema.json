{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "L3 FHIR Authoring Input",
  "description": "Input schema for L3 FHIR IG authoring. Creates machine-readable FHIR artifacts from a source model.",
  "type": "object",
  "required": [
    "artifactType",
    "sourceModel"
  ],
  "properties": {
    "artifactType": {
      "type": "string",
      "enum": [
        "logical-model",
        "profile",
        "questionnaire",
        "cql-library",
        "structure-map",
        "plan-definition",
        "measure",
        "test-case",
        "actor-definition",
        "requirements"
      ],
      "description": "Type of FHIR artifact to author."
    },
    "sourceModel": {
      "type": "string",
      "description": "Path or reference to the source model the FHIR artifacts are derived from: a logical model, a business specification, a data dictionary. The layer above supplies which (a WHO SMART guideline passes its DAK's L2 content)."
    },
    "fshOutputDir": {
      "type": "string",
      "default": "input/fsh",
      "description": "Directory for FSH output files."
    },
    "igRoot": {
      "type": "string",
      "description": "IG repository root directory."
    }
  },
  "$id": "https://litlfred.github.io/folio-assistant/fhir-harness/schema/skills/l3-fhir-authoring/input.schema.json",
  "staging": {
    "branch": "repin-train/20261107-0040",
    "sha": "60ac254c14d805d847978a17871310fab41e5430",
    "pr": "repin-train/20261107-0040",
    "run": "42319724203"
  }
}
