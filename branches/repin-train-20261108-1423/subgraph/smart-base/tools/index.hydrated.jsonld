    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/smart-base/tools/extract-dak/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "http://smart.who.int/base/tools/extract-dak.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Run WHO's `extract_dak.py` in a DAK or IG repository. It reads the DAK template spreadsheets (`input/decision-logic/*.xlsx` via `dt_extractor`, `input/system-requirements/*.xlsx` via `req_extractor`, `input/dictionary/*.xlsx` via `dd_extractor`) and the BPMN, and writes DMN decision tables, CPG recommendation PlanDefinitions with citations, CQL library skeletons, Requirements and logical-model FSH. Per the WHO IG Starter Kit (`l3_decisiontables`, `l3_cql`), an adapted decision or scheduling table is an edited copy of the upstream DAK's spreadsheet, never a parallel format.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "python3 $SMART_BASE_HOME/input/scripts/extract_dak.py"
          },
          "io": {
            "inputs": [
              {
                "description": "The working directory: a DAK or IG repository with `input/decision-logic/`, `input/system-requirements/` and `input/dictionary/` spreadsheets in the DAK template layout.",
                "name": "dakRepository",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
              }
            ],
            "outputs": [
              {
                "description": "Decision tables in the DAK DMN format (namespace `https://www.omg.org/spec/DMN/20240513/MODEL/`), each with an `Annotations` and a `Reference(s)` output.",
                "name": "dmn",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "PlanDefinition, ActivityDefinition, Requirements and logical-model FSH, for SUSHI to compile.",
                "name": "fsh",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "CQL library skeletons, one per decision table, with the definitions already present in `input/cql/` carried over.",
                "name": "cql",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ]
          },
          "name": "extract-dak",
          "requirements": {
            "network": false,
            "runtime": [
              "python3"
            ]
          },
          "satisfies": "http://smart.who.int/base/skill/smart-base-tools",
          "title": "DAK spreadsheets → DMN, PlanDefinitions, CQL, requirements, logical models"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/extract-dak",
      "path": "tools/extract-dak/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/smart-base/tools/immz-schedule-app-local/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "http://smart.who.int/base/tools/immz-schedule-app-local.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Start litlfred/awho-mcp's schedule-check web form on this machine: a HAPI FHIR server in Docker, the WHO SMART Immunizations IG loaded, then optionally a country adaptation IG (its decision-logic tables replace WHO's; its country profile is generated from its `input/l2/dependencies.yaml`), the CQL cache warmed, and the form served. Both listen on 127.0.0.1. Unbuilt IGs are built with SUSHI first, and each Library's CQL is embedded from `input/cql/` as the IG Publisher would. A re-run reuses a server loaded from the same commits; `--down` stops both.",
          "install": {
            "cli": "git clone https://github.com/litlfred/awho-mcp && cd awho-mcp && python3 -m pip install -e ."
          },
          "invoke": {
            "shell": "awho-mcp/scripts/local_up.sh --who-ig <dir> [--country-ig <dir>] [--fhir-port <n>] [--web-port <n>] [--down]"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--who-ig"
                },
                "description": "A WHO SMART Immunizations IG checkout, relative to the working directory (the folder holding the checkouts, e.g. `~/space_cats`).",
                "name": "who-ig",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--country-ig"
                },
                "description": "A country adaptation IG checkout, e.g. `smart-immunizations-uganda`, relative to the working directory. Without it the app follows WHO's own schedule.",
                "name": "country-ig",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--fhir-port"
                },
                "description": "The HAPI port on 127.0.0.1. Default 8081.",
                "name": "fhir-port",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Port"
              },
              {
                "arg": {
                  "flag": "--web-port"
                },
                "description": "The form's port on 127.0.0.1. Default 8090.",
                "name": "web-port",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Port"
              },
              {
                "arg": {
                  "flag": "--down"
                },
                "description": "Stop the form and the server.",
                "name": "down",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ],
            "outputs": [
              {
                "description": "The form on 127.0.0.1. It stores nothing; each check is one inline `$apply` round.",
                "name": "url",
                "render": {
                  "as": "url",
                  "reason": "a reader opens the running app; the scheme is checked before it reaches an href"
                },
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
              }
            ]
          },
          "name": "immz-schedule-app-local",
          "requirements": {
            "network": true,
            "runtime": [
              "docker",
              "python3",
              "git"
            ]
          },
          "satisfies": "http://smart.who.int/base/skill/l4-application-run-local",
          "title": "Run the immunization schedule-check app locally on a WHO or country IG"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/immz-schedule-app-local",
      "path": "tools/immz-schedule-app-local/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/smart-base/tools/l1-extraction-pages/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "http://smart.who.int/base/tools/l1-extraction-pages.jsonld",
          "@type": "cat-harness:Tool",
          "description": "For every visualiser an instance declares with `renderedBy: l1-extraction-pages`, write the hub at `<locale>/<harness>/<id>/` and, with `subgraphs: \"instance\"`, one page per instance that declares an `l1-extraction` directory. Each page shows, from what the files declare: the L1 statements (graph nodes with a `statement`, and an authored L1 source's `recommendations`); the candidate work list's counts, coverage and decisions; each graph document's nodes by type and edges by predicate (L2 scenario candidates included); counts of curation, mapping, vocabulary, exclusions and run context; and a link from every file to its published copy (cat-harness's `library:viz`), when the site has it, and to its source at the pinned commit. A declared directory not on disk is reported UNKNOWN, never zero.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run smart-base/scripts/gen-l1-extraction-pages.ts"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--site"
                },
                "description": "The site being built; pages go under it (cat-harness-tools' `visualiser-writers.ts` passes it). Default: the checkout's site directory.",
                "name": "site",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--root"
                },
                "description": "The checkout whose declarations are read. Default: the checkout holding the working directory.",
                "name": "root",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "Write nothing; exit 1 when a page is stale, missing or orphaned.",
                "name": "check",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ],
            "outputs": [
              {
                "description": "Pages written: the hub and one per instance.",
                "name": "pages",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
              }
            ]
          },
          "name": "l1-extraction-pages",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/graph-rendering",
          "title": "L1 extraction viewer: a hub and a page per instance with `l1-extraction` directories"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/l1-extraction-pages",
      "path": "tools/l1-extraction-pages/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/smart-base/tools/l1-recommendation-candidates/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "http://smart.who.int/base/tools/l1-recommendation-candidates.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Find every normative sentence of an ingested `library/` entry (folio-assistant-core's `l1-coverage` markers), flag uncertain readings, and propose the publication's identity. Given an agent's `l1-recommendation-curation/v1`, refuse a non-verbatim statement or an unknown location, and write the recommendations and remarks as an L1 3.0 graph (checked with `kg/src/validate.ts`) with coverage and proposed, unsigned exclusions.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run smart-base/scripts/l1-recommendation-candidates.ts --entry <library entry> [--curation <curation.yaml>] --out <dir> [--check]"
          },
          "io": {
            "inputs": [
              {
                "description": "An ingested `library/<id>/` with page-tagged `sections/*.md` and `structure.json`.",
                "name": "entry",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "The agent's decisions per candidate location (`l1-recommendation-curation/v1`). Absent: only the work list is written.",
                "name": "curation",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ],
            "outputs": [
              {
                "description": "`recommendation-candidates.json` — every normative sentence, its hints and its decision; cites the run context.",
                "name": "candidates",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "`l1.json` — L1 3.0 publication, recommendation and remark nodes, every one `inferred`.",
                "name": "graph",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "`exclusions.proposed.json`, in `l1-coverage`'s shape; none counts until a person signs it.",
