  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LaTeX Authoring Input",
  "description": "Input schema for the latex-authoring skill.",
  "type": "object",
  "required": [
    "documentClass",
    "mainFile"
  ],
