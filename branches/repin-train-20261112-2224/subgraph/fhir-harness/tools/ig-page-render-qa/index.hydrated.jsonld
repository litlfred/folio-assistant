      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/ig-page-render-qa.jsonld",
      "@type": "cat-harness:Tool",
      "description": "The checkout script `ig-site:page-render-qa`, the IG site build's last final step: it serves the built site locally, opens the root pages and the artefact pages (not the JSON views, mappings views or redirect stubs) in headless Chromium, waits for each to draw, and lists every text block that shows markdown as text (bold, list markers, links, images, code, headings, tables, HTML tags), code and preformatted text left out. It writes `assets/fhir-qa/page-render.json` and the script the QA report's \"Page scan\" panel draws it with. It reports and never fails the build: without a browser it writes why.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run fhir-harness/scripts/ig-page-render-qa.ts"
      },
      "io": {
        "inputs": [
          {
            "description": "The built site directory.",
            "name": "site",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--limit"
            },
            "description": "Scan at most this many pages.",
            "name": "limit",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "arg": {
              "flag": "--concurrency"
            },
            "description": "Pages open at once; 4 by default.",
            "name": "concurrency",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ],
        "outputs": [
          {
            "description": "Text blocks that show markup as text.",
            "name": "findings",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "ig-page-render-qa",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/fhir-harness/skill/ig-build-pipeline",
      "title": "Scan every page of a built IG site in a headless browser for markup shown as text"
