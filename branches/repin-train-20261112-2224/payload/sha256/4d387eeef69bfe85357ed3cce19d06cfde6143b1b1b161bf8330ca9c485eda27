      "pageStart": 21,
      "pageEnd": 21,
      "target": "../sections/sec-017-hiv-self-testing-hivst-for-prep.md",
      "narrative": null,
      "content": "(HIVST) for PrEP",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "A heading fragment for the section on HIV self-testing for PrEP.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
