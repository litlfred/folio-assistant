    {
      "id": "library/10665-331525/blocks/prose-sec-002",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Definitions",
      "pageStart": 10,
      "pageEnd": 13,
      "target": "../sections/sec-002-definitions.md",
      "narrative": null,
      "content": "Note: Unless otherwise specified, the definitions listed below apply to the terms as used in this \nhandbook. They may have different meanings in other contexts.\nActive case finding (ACF): is synonymous with systematic screening for TB disease, although it \nnormally implies screening that is implemented outside of health facilities.\nAdolescent: is a person aged 10–19 years.\nAdult: is a person over 19 years of age.\nBacteriologically confirmed TB: is TB diagnosed in a biological specimen by smear microscopy, \nculture or a WHO-approved molecular test such as Xpert MTB/RIF®.\nChild: is a person unde",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Defines key terms used in the TB preventive treatment handbook, such as age groups, contact, household and close contact, index patient, high transmission setting and latent TB infection. Further definitions cover programmatic management, screening and treatment completion. It closes with a call to deliver preventive treatment to 30 million people by 2022 in line with the UN high-level meeting commitments.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
