    {
      "id": "library/10665-374940/blocks/prose-page-007",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Page 7",
      "pageStart": 7,
      "pageEnd": 7,
      "target": "../sections/page-007.md",
      "narrative": null,
      "content": "страны за пределами Европейского региона, такие как Канада, США, Япония и \nАвстралия. \n \nЗа период с 2008 по 2011 год вспышки краснухи регистрировались в нескольких странах, \nвключая Австрию, Боснию и Герцеговину, Кыргызстан, Польшу, Российскую Федерацию \nи Украину.  На рисунке 2 показана заболеваемость краснухой из расчета на миллион \nжителей в 2010 году с более 10 зарегистрированных случаев на миллион жителей в \nчетырех странах (Боснии и Герцеговине, Грузии, Польше и Румынии).  На рисунке также \nпоказано отсутствие данных по краснухе по ряду стран. \n \nВ Европейском регионе национальные уровн",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Notes measles exports from Europe to countries such as Canada, the United States, Japan and Australia, and rubella outbreaks in several European countries in 2008–2011. It introduces WHO Europe's four main strategies for eliminating measles and rubella.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
