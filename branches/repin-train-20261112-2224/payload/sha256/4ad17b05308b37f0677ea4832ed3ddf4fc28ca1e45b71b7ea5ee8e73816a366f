    {
      "id": "library/10665-374940/blocks/prose-page-015",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Page 15",
      "pageStart": 15,
      "pageEnd": 15,
      "target": "../sections/page-015.md",
      "narrative": null,
      "content": "данные о лабораторно подтвержденных подозрительных случаях для активного поиска \nновых случаев и осуществления системных мер по борьбе с вспышкой заболевания.  Все \nуведомления и дополнительная информация должны направляться в ФВОЗ.  \nСпецифичность системы эпиднадзора также нуждается в улучшении.  Врачам \nрекомендовано проводить подтверждающее тестирование каждого подозрительного \nслучая.  Также от них требуется улучшить полноту отчетности путем включения деталей \nоб источнике инфекции (завозная, связанная с завозом, местная инфекция), а также о \nсимптомах, необходимых для классификации случае",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Recommends that Swiss doctors confirm every suspected measles case by laboratory testing and report infection source, and that cantons gain direct access to the federal database with better feedback. It then describes Germany's decentralized notification system across 16 federal states and 413 districts, with incidence by state and a shift of cases to older ages.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
