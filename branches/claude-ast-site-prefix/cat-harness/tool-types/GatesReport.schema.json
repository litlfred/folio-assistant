{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/branches/claude-ast-site-prefix/cat-harness/tool-types/GatesReport.schema.json",
  "title": "GatesReport",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "folio-gates-report/v1"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not-clean",
        "undetermined"
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "number",
          "const": 0
        },
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "set": {
      "type": "string",
      "enum": [
        "fast",
        "whole"
      ]
    },
    "gates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "writers": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heldOut": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "job": {
            "type": "string"
          },
          "step": {
            "type": "string"
          },
          "why": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "command",
          "job",
          "step",
          "why"
        ]
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "command",
          "why"
        ]
      }
    },
    "mutatedBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "undetermined": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unclassified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "command"
        ]
      }
    },
    "unrun": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "$schema",
    "outcome",
    "exitCode",
    "set",
    "gates",
    "writers",
    "failed",
    "skipped",
    "mutatedBy",
    "undetermined",
    "unclassified",
    "unrun"
  ],
  "additionalProperties": false,
  "description": "One gate run: outcome and exit code, the failed gates with their salient lines, the skipped ones and why, and what changed the tree.",
  "staging": {
    "branch": "claude/ast-site-prefix",
    "sha": "c9bf7f63e4e5b09c06c2574ac5febae944c9f927",
    "pr": "3014/merge",
    "run": "42355570137"
  }
}
