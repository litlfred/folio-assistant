      "skos:prefLabel": [
        {
          "@value": "IgSection.trustedSvgs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Same-site SVG drawings the IG's own pages embed with `<object>`, as each element's `data` writes them, so the drawing's links work (owner, 2026-11-12: the onboarding diagrams' drill-down). The injection gate accepts, on a page and only there, an `<object>` opening tag whose `data` is on this list, whose `type` (if any) is `image/svg+xml`, and whose other attributes are presentational (`style`, `width`, `height`, `class`, `id`, `title`, `role`, `aria-*`). The element's body is still scanned. Absent means none.",
          "@language": "en"
        }
      ],
      "dcterms:source": "fhir-harness/schemas/ig-content-type.ts#IgSection.trustedSvgs",
