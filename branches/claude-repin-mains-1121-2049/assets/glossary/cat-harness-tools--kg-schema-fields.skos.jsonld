        {
          "@value": "PermissionDef.includedIn",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The broader actions this one is part of: another action here, or one of ODRL's common vocabulary (`schemas/content/odrl.ts#ODRL_ACTIONS`). This is what makes the vocabulary an ODRL profile (issue #1180): a permission to a broader action permits every action included in it. Required and non-empty, so every action has a way up to `odrl:use`.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/process/role-graph.ts#PermissionDef.includedIn",
