          "@value": "WorkshopPresentationSchema.ig",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where the FHIR implementation guide the walkthrough demonstrates is published, so a step's examples, profiles and processes link to their pages. `href` is the IG's base: a URL, or a path from the site's root (`\"\"` when the IG is the site). `example` and `profile` are page patterns under it, with `{type}` and `{id}` filled in (the IG Publisher's own: `{type}-{id}.html`, `StructureDefinition-{id}.html`); `processes` is the page listing the business processes, each under a heading named for its BPMN process.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/process/workshop.ts#WorkshopPresentationSchema.ig",
      "skos:note": "candidate"
