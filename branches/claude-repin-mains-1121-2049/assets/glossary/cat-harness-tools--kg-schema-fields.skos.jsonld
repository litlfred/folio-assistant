        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "SubscriptionSchema.upstreamPath",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The repository-relative DIRECTORY holding the substrate's declaration, when that is not the root — `shared` for a fork whose declaration is `shared/<name>.json` (bean `437w`). Absent: the root. The same name and meaning as `upstreamPath` on a remote subgraph source (`schemas/kg/subgraph-source.ts`, PR #2326), so one word means one thing across both, and the same pattern (a trailing slash is admitted and means nothing). Recorded so `kg:subscribe:check` and a re-subscribe judge the same subtree that was judged the first time.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/cat-harness.ts#SubscriptionSchema.upstreamPath",
      "skos:note": "candidate"
    },
