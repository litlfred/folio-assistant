        }
      ],
      "skos:definition": [
        {
          "@value": "WHICH SOFTWARE produced the text, cited by digest: the `folio-run-context/v1` of the run that wrote it (`schemas/sdlc/run-context.ts`), reused rather than restated — the one optional `runContext: { sha256 }` reference that `docs/proposals/tool-releases-2026-10-07.md` gives every run and report record (owner, C1 = a).",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/ui/pdf-structure.ts#PdfSourceSchema.runContext",
      "skos:note": "candidate"
    },
