        }
      ],
      "skos:definition": [
        {
          "@value": "The document's languages as the ingest was told them (`--lang-hint`, ISO 639-1). A reader asks this, not the entry's slug: 10665/202203 is Russian and its slug has no language suffix, because an item's first edition keeps the bare slug (owner, 2026-11-11, card Q-ODD-1 = A). Absent when the ingest was given none.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/ui/pdf-structure.ts#PdfSourceSchema.languages",
      "skos:note": "candidate"
    },
