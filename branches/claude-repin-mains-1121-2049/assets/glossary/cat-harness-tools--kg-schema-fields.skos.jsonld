      },
      "skos:prefLabel": [
        {
          "@value": "MountOverrideSchema.trust",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Consent for THIS layer at its own pin. Required for a layer reached through a GITLINK: that is another repository at another commit, and the parent mount's consent does not cover it (roast `1ygp` L4.2). Ignored for the declared harness and same-tree layers, which the mount's own `trust` covers.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/remote-mount.ts#MountOverrideSchema.trust",
