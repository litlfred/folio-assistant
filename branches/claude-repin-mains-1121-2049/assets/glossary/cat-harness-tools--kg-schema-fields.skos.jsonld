    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/index-config.indexsiteschema.agentrun",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IndexSiteSchema.agentRun",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "This repository is AGENT-RUN: an agent builds and publishes its site (`stage-local.ts`), and its publish workflows keep only `workflow_dispatch`, as documentation of what the agent path must match rather than something to dispatch (owner, 2026-10-10, bean `n3h9`; the `feature-staging` skill, \"Agent-run repositories\").",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/index-config.ts#IndexSiteSchema.agentRun",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/index-config.indexsiteschema.landing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IndexSiteSchema.landing",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An instance name, or {@link HUB_LANDING}. Must name an instance this file lists.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/index-config.ts#IndexSiteSchema.landing",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/index-config.indexsiteschema.publishafter",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IndexSiteSchema.publishAfter",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Workflow files under `.github/workflows/` whose run on the SAME commit the push-to-main publish waits for, before it builds (cat-harness-tools#1879). An IG's site is built from its AST cache, which its `ig-ast-refresh.yml` seeds on the same push. A publish that starts first finds the cache stale and is refused. A workflow that did not run on that commit is not waited for.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/index-config.ts#IndexSiteSchema.publishAfter",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/index-config.indexsiteschema.publisher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IndexSiteSchema.publisher",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which site publisher `stage-local.ts` uses for this checkout when no `--publisher` is given: `folio`, or the kind of a publisher a mounted layer declares (`ig`, an IG layer's `site-publisher-ig`). Absent: the declared `site.build` recipe, else the publisher the repository's own workflows call, as before. It exists for a repository that has both, such as a DAK whose instance declares a folio recipe while its site is the IG (smart-trust-demo). Agents had to remember `--publisher ig` for that repository, and the shared `folio-site-publish.yml` that runs on every push to main had no way of knowing it (owner, 2026-11-11: \"i want that it publishes once merge to main, update QA reports etc.\"; cat-harness-tools#1879).",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/index-config.ts#IndexSiteSchema.publisher",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/index-config.indexsiteschema.sharedassets",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IndexSiteSchema.sharedAssets",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where this site loads the assets every IG site shares, instead of carrying its own copy (owner, 2026-11-09, Q-SZ-7 \"A\"): a site on the same github.io origin that publishes them, such as `https://litlfred.github.io/smart-html-jtd/`. Each shared directory is served at `<sharedAssets>shared/<dir>/<digest>/`, so a site keeps loading the exact bytes it was built with. A build whose copy the host does not serve keeps it local (`scripts/lib/shared-assets.ts`).",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/index-config.ts#IndexSiteSchema.sharedAssets",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/index-config.indexsiteschema.taskskills",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IndexSiteSchema.taskSkills",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whether the ⓘ task panel on this site's BPMN drawings shows skills: the skills a task requires and the skills its lane's role has. Absent or `true` shows them, as every knowledge-graph site does; `false` hides them, for a site whose processes are not modelled with skills, such as an implementation guide's business processes (owner, 2026-11-06: \"i dont think skills are modelled in DAK ... dont necc turn those on but i want common styling\"; \"maybe in future DAK personas get skills\"). The rest of the panel (the step, its lane and role, the process, a called process) is shown either way. A fact about how THIS checkout publishes, so it sits on the index's `site` beside `landing` and `agentRun`. Read by `task-panel.ts` `taskSkillsDeclared`.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/index-config.ts#IndexSiteSchema.taskSkills",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/index-config.indexsiteschema.workflows",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IndexSiteSchema.workflows",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The workflow files that publish this repository's site and stage a preview of it, by file name under `.github/workflows/`. The `pages-publish` and `feature-staging` Tools run them through `bun run cat site:workflow publish|stage`, so a Tool names no repository's file (owner, 2026-10-30, \"Make them generic\"). An agent-run repository declares none: `stage-local.ts` is its path. `check:tools` fails when a file named here does not exist.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/index-config.ts#IndexSiteSchema.workflows",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/ingest-candidates.ingestcandidateschema.aspect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IngestCandidateSchema.aspect",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The aspect that proposed it; absent for a class extractor's or a hand-written candidate.",
          "@language": "en"
