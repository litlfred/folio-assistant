      },
      "skos:prefLabel": [
        {
          "@value": "PdfStructureSchema.container",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A bound volume split into its papers by qou's `split-bound-volume.py`: the volume keeps `container: true`, names the per-paper entries in `container_children` and says why in `container_note`. Ranking and the library index skip a container, so its pages are not counted twice.",
          "@language": "en"
        }
      ],
