    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/diff-renderers.diffrendererschema.defaultfor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "DiffRendererSchema.defaultFor",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Block kinds this renderer is the DEFAULT for, from `BLOCK_KINDS`. `*` is the fallback, and exactly one renderer carries it. {@link STRUCTURED} is any block with structured sides, and comes after its kind and `*`: it is chosen only when those cannot run on the block. Two renderers may list the same kind: order is preference, and the page takes the first one that can run on the block. A test holds every other entry to a kind that exists, so a renamed kind cannot silently lose its default.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/ui/diff-renderers.ts#DiffRendererSchema.defaultFor",
      "skos:note": "candidate"
    },
