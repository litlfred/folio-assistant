      },
      "skos:prefLabel": [
        {
          "@value": "PdfSourceSchema.ocr_pages",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Pages whose embedded text layer failed `scripts/_text_quality.py` and were read from the OCR cache instead, each with the reason (owner, 2026-11-11, who-iris card Q-ODD-1 = A: \"force OCR when a page's text layer fails a quality check\"). The rest of the document keeps its embedded text, so `text_source` stays `embedded`. Absent when no page was replaced.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/ui/pdf-structure.ts#PdfSourceSchema.ocr_pages",
