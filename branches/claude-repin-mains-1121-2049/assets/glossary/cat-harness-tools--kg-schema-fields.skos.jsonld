    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/block-qa.qacriterionentry.reviewed_at",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "QaCriterionEntry.reviewed_at",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "When the audit ran (ISO-8601 UTC). Optional, and no longer written by the platform's writers (owner rulings 2026-11-06: card \"QA dates\", option 1, derive the date; card \"Date source\", option 1, derive it ON READ): the date a verdict is shown and ordered by is DERIVED from {@link reviewed_tree} — the commit date of the commit carrying that tree (`tree-commits.json`, `entryDate` in `pipeline/qa-utils.ts`) — so the verdict's bytes carry no clock and a PR's QA output can be reused on main. The run's own time is in its run record. Kept readable for existing sidecars.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/sdlc/block-qa.ts#QaCriterionEntry.reviewed_at",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/block-qa.qacriterionentry.reviewed_sha",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "QaCriterionEntry.reviewed_sha",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Repo HEAD at audit time (full git SHA). No longer written — superseded by `reviewed_tree` (bean 69lr) — and kept readable so existing sidecars validate. Legacy agent entries (pre-2026-06) omit it too.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/sdlc/block-qa.ts#QaCriterionEntry.reviewed_sha",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/block-qa.qacriterionentry.reviewed_tree",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "QaCriterionEntry.reviewed_tree",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tree of repo HEAD at audit time (`HEAD^{tree}`, full git id, or the `unknown` sentinel outside git). Producers must set this on every new entry; optional in the type only because older entries carry `reviewed_sha` instead. The tree, not the commit, because a PR run's HEAD is GitHub's synthetic merge commit, which can vanish — the tree survives onto main unchanged (bean 69lr; owner card Q4, 2026-11-05).",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/sdlc/block-qa.ts#QaCriterionEntry.reviewed_tree",
      "skos:note": "candidate"
    },
