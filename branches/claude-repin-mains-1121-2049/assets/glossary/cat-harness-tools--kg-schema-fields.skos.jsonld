    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/block-qa.qacriterionentry.metrics",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "QaCriterionEntry.metrics",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Optional structured numeric/heuristic measures a checker emits alongside its verdict — e.g. the detangler axis records per-block graph metrics (`fwd_emitted`, `out_degree`, `in_degree`, `cone_size`, `edge_span_max`, `graph_energy`, `topic_*`). Unlike `score` (a quality rubric to improve over time) these are descriptive structural measures of the block's position in the dependency graph. Keys are checker-defined; values are scalars or short strings (e.g. a worst-offending target label). Persisted so the sidecar carries the heuristic snapshot, not just pass/fail.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/sdlc/block-qa.ts#QaCriterionEntry.metrics",
      "skos:note": "candidate"
    },
