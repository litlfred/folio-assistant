    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/cat-harness.harnessvisualiserschema.builtonhostsite",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "HarnessVisualiserSchema.builtOnHostSite",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Its pages are built at publish on the HOST site (the site owner's, e.g. cat-harness's), at `<site>/<locale>/<harness>/<id>/`, so the publish plan derives those routes from this entry and the host lists none of them (bean folio-assistant-uldr, owner option \"1\", 2026-11-06). `translated`: it also writes one route per locale the checkout's translation sources hold, besides the page locale. The writer is the `renderedBy` Tool's `invoke.shell` script, and it marks each route it writes with a self-ignoring `.gitignore` (`*`), which keeps the route out of git and out of the mount digest.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/cat-harness.ts#HarnessVisualiserSchema.builtOnHostSite",
      "skos:note": "candidate"
    },
