          "@value": "MountLockSchema.mounts",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `remoteMounts` it was written for, so a changed pin reads as stale.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/remote-mount.ts#MountLockSchema.mounts",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/remote-mount.mountlockschema.pinnedat",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "MountLockSchema.pinnedAt",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "When `mount:remote` wrote this content, pins included (UTC, ISO 8601, whole seconds): T, the time `lock:coherence:check` judges freshness against. A commit's date is not T: a squash merge dates the commit that carries the lock at the MERGE, so every layer main that moved between the re-pin and the merge read as \"moved before T\" and the pin as stale (merge-manager, 2026-11-17: three WHO syncs lost that race). Kept when a mount rewrites the same content, so a re-run does not churn the lock; written anew whenever anything else in it changes. The check accepts it only when it is no later than the commit that carries the lock and no earlier than any pin's own commit; optional so a lock written before it was recorded still parses.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/remote-mount.ts#MountLockSchema.pinnedAt",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/remote-mount.mountlockschema.unmounted",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "MountLockSchema.unmounted",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the closure reached and did NOT mount, with why — so the check, which reads the lock and never the network, cannot report clean over a layer the mount never laid down. `local` and `skipped` are recorded too: they are answers, and a reader should see them as such.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/remote-mount.ts#MountLockSchema.unmounted",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/remote-mount.mountoverrideschema.hydrated",
      "@type": "skos:Concept",
      "skos:inScheme": {
