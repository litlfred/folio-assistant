        {
          "@value": "CacheSchema.refresh",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a stale entry is brought up to date: `incremental` (only what changed — the changed writers, modules, layers or IG delta — over the restored entry) or `whole`. A refresh never rebuilds wholesale when an incremental one is valid (owner, 2026-11-05).",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/sdlc/cache.ts#CacheSchema.refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/cache.cacheschema.stateinputs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "CacheSchema.stateInputs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whether the producer reads MUTABLE STATE the tree does not pin — a branch-kept graph (`state:mount`: the work plan `beans/`, `qa-reports`, fsh-guts…). A producer that reads one must carry that ref's commit in its key, or its entry is never current (#2966: the publish pages read the work plan's finished instances, and a cache keyed on the tree alone served a stale page). REQUIRED, so no node is silent on it: - `none`: shown to read no state mount (by construction, or by a recorded read set that touches no state path); - `keyed`: every state ref it reads is in the key (`refs`); - `unkeyed`: it reads state the key does not carry — never current; - `unmeasured`: not shown either way yet — never current.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/sdlc/cache.ts#CacheSchema.stateInputs",
      "skos:note": "candidate"
    },
