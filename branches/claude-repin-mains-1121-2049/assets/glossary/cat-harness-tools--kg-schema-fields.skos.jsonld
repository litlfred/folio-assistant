      },
      "skos:prefLabel": [
        {
          "@value": "IndexConfigObject.mountApprovers",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Who may consent to a remote mount in this checkout: `consent.by` on an instance's `trust` must be one of them (`schemas/kg/mount-trust.ts`, roast `1ygp` L4.2). The same field an instance declaration carries, here for the checkout whose mounts the index lists and which may declare no instance of its own (folio-assistant#2389). Declaring it in both is an error, never a pick.",
          "@language": "en"
        }
      ],
