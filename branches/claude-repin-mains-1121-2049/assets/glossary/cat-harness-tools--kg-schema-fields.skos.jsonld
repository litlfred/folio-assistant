    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/workshop.workshoppresentationschema.architecture",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "WorkshopPresentationSchema.architecture",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "How it works opens with the architecture panel (JV-13): the countries side by side, one row per layer of a reference architecture, each box a system part, all read from the ArchiMate model `model` of the layer's `cat-archimate.config.json`. Element refs are the model's ids. `root` is the grouping whose child groupings are the rows; each of `countries` a grouping that aggregates a country's systems; `shared` the grouping drawn as the foundation band under both. A part's row and box label come from the reference block its country's instance specializes; its moments from the steps realised by the BPMN of the processes its system serves.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/process/workshop.ts#WorkshopPresentationSchema.architecture",
      "skos:note": "candidate"
    },
