      },
      "skos:prefLabel": [
        {
          "@value": "PdfMetadataSchema.title_source",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where `title` came from (bean `w6fu`, `scripts/_pdf_title.py`): the PDF's `Title` metadata, its first-page heading or its outline when another source CORROBORATES it, else the text walk's title (`text`) or nothing (`filename`, and the manifest falls back to the entry id).",
          "@language": "en"
        }
      ],
