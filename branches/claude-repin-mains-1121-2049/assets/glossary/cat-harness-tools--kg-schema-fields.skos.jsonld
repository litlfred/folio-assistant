        {
          "@value": "SubscriptionSchema.kind",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What kind of Knowledge Graph this subscribes to — `substrate` (absent) or `content` (owner, 2026-10-06): a declaration with Subgraphs and NO harness, such as a FHIR IG. Bootstrap's definition of a substrate is unchanged; a content subscription is a separate kind, written explicitly, and contributes no skills, processes or roles — so it may choose no `harnesses`. `SUBSCRIPTION_KINDS` in `schemas/kg/substrate-snapshot.ts` carries the rule once.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/cat-harness.ts#SubscriptionSchema.kind",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/cat-harness.subscriptionschema.upstreampath",
      "@type": "skos:Concept",
