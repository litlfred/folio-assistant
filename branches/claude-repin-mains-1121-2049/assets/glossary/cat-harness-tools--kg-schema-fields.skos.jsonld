        {
          "@value": "WorkshopPresentationSchema.deviceDemo",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The layer's own device demo: an app that shows each moment's screen. The viewer does not draw the screens; its Device Demo view frames the app's own page for each (`href` + `#/demo/<id>` unless `route` says otherwise) and links each screen and the steps it shows both ways. `href` is a URL, or a path from the site's root (`vaxlink/`).",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/process/workshop.ts#WorkshopPresentationSchema.deviceDemo",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/workshop.workshoppresentationschema.ig",
