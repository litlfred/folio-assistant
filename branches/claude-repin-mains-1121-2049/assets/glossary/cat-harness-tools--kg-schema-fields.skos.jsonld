      },
      "skos:prefLabel": [
        {
          "@value": "MountOverrideSchema.hydrated",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mount this layer's directories as their published `index.hydrated.jsonld` only — metadata, no files (bean `mo75` G2). Overrides the mount entry's own `hydrated` either way. `directories` still chooses which subgraphs; `whole` and `hydrated` together are refused at plan time, since one asks for every file and the other for none.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/remote-mount.ts#MountOverrideSchema.hydrated",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/remote-mount.mountoverrideschema.tools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "MountOverrideSchema.tools",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool ids THIS layer declares, each mounted runnable: its definition, its implementation and their import closure, as the declared directories that closure touches (module note, §\"Tools\"). An id the layer does not declare at the pin is refused at plan time, never dropped. Not with `hydrated` (metadata brings no code) or `skip`.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/kg/remote-mount.ts#MountOverrideSchema.tools",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/ns/glossary/kg-schema-fields/remote-mount.mountoverrideschema.trust",
      "@type": "skos:Concept",
