        {
          "@value": "PdfMetadataSchema.title_verified",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "False when no source corroborated the title: the raw title was kept, not guessed at.",
          "@language": "en"
        }
      ],
      "dcterms:source": "cat-harness-tools/schemas/ui/pdf-structure.ts#PdfMetadataSchema.title_verified",
