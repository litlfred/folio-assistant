      "skos:prefLabel": "National eHealth strategy toolkit"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/establishing-a-national-ehealth-vision",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "Establishing a national eHealth vision",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Strategic goals and challenges Strategic health sector goals and challenges and/or other national development goals that can be best supported by eHealth. While there may be many different goals and challenges, only some of these can be directly supported by eHealth.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L18",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/ehealth-outcomes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "eHealth outcomes",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "What will be achieved or changed through using eHealth, and how will the health system and services change by: ∞ ∞improving the information flows within the health sector ∞ ∞improving electronic access to health services and information.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L27",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/ehealth-vision",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "eHealth vision",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "High-level statement that describes the strategic benefits and outcomes for the country in general or for the health system and population through the strategic changes to health system and services introduced by eHealth (eHealth outcomes).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L34",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/national-ehealth-environment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "National eHealth environment",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The national eHealth environment is made up of eHealth components representing the enabling and foundation elements for eHealth as well as technical capabilities that form together an ‘ecosystem’ for eHealth in a country.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L39",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/ehealth-components",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "eHealth components",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The building blocks of a national eHealth environment which will allow the eHealth outcomes to be achieved. They describe what is needed to be introduced or strengthened to achieve the eHealth vision in terms of: ∞ ∞leadership and governance ∞ ∞strategy and investment ∞ ∞services and applications ∞ ∞infrastructure ∞ ∞standards and interoperability ∞ ∞legislation, policy and compliance ∞ ∞workforce.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L45",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/strategic-recommendations",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "Strategic recommendations",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Strategic recommendations describe the high–level actions required to deliver the national eHealth environment. These actions may describe how new eHealth components will be delivered, or how existing eHealth components will be repurposed or extended.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L63",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/developing-an-ehealth-action-plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "Developing an eHealth action plan",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Action lines Broad areas to group national activities of similar focus and intent that are required to deliver a nation’s eHealth vision.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L70",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/ehealth-outputs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "eHealth outputs",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The specific achievements, deliverables, results or changes required to deliver a strategic recommendation.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L75",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/activities",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "Activities",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The set of activities which need to be undertaken to deliver a particular output.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L78",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/national-ehealth-monitoring-and-evaluation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "National eHealth monitoring and evaluation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "guidelines Output indicators Indicators that provide insights into the adoption and take-up of eHealth within the country’s health sector.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L82",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211/outcome-indicators",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/10665-75211"
      },
      "skos:prefLabel": [
        {
          "@value": "Outcome indicators",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Indicators that provide insights into the tangible results for stakeholders that arise from the adoption and use of eHealth. Worldwide, the application of information and communication technologies to support national health-care services is rapidly expanding and increasingly important. This is especially so at a time when all health systems face stringent economic challenges and greater demands to provide more and better care, especially to those most in need. The National eHealth Strategy Toolkit is an expert, practical guide that provides governments, their ministries and stakeholders with a solid foundation and method for the development and implementation of a national eHealth vision, action plan and monitoring framework. All countries, whatever their level of development, can adapt the Toolkit to suit their own circumstances. Representing one of the most significant collaborations in recent years between the World Health Organization and the International Telecommunication Union, the Toolkit is a landmark in understanding what eHealth is, what it can do, and why and how it should be applied to health care today.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/10665-75211/sections/sec-066-annex-g-definition-of-terms-used-in-the-toolkit.md#L89",
      "skos:note": "candidate"
    }
  ]
}
