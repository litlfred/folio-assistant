      "skos:prefLabel": [
        {
          "@value": "activate-accepted-guidance"
        }
      ],
      "skos:definition": [
        {
          "@value": "The point-of-care system carries out the health worker's decisions on decision-support guidance: each accepted action's request becomes active (intent plan or order) and joins the client's CarePlan; a declined action is not written. Input is the guidance and the decisions; output is the transaction Bundle saved."
        }
      ],
      "skos:notation": "activate-accepted-guidance",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/activate-accepted-guidance.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/apply-decision-support",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "apply-decision-support"
        }
      ],
      "skos:definition": [
        {
          "@value": "The point-of-care system applies a DAK decision table's PlanDefinition to one client ($apply) and gets the proposed actions back as a RequestGroup (R4; RequestOrchestration in R5), or as CDS Hooks cards when the guidance comes from a CDS service. Input is the PlanDefinition and the client; output is the proposal, every request in it still a proposal."
        }
      ],
      "skos:notation": "apply-decision-support",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/apply-decision-support.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/classify-and-code-content",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "classify-and-code-content"
        }
      ],
      "skos:definition": [
        {
          "@value": "Classify and code L1 narrative content (recommendations, implementation practices, remarks, and proposed coverage exclusions) and L2 DAK slots (personas, business processes, guideline domains, conditions, interventions, medicines, and GRADE ratings) using the `terminology-coding` methodology and the `terminology-lookup` Tool. Covers the authoring-agent's four-rung reuse-first lookup, the `l1-extraction-reviewer` lane that reads and signs proposed L1 coverage exclusions against the printed page, and the `terminologist` / ontologist lane that adjudicates candidate codings and local glossary candidates."
        }
      ],
      "skos:notation": "classify-and-code-content",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/classify-and-code-content.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/complete-sdc-questionnaire",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "complete-sdc-questionnaire"
        }
      ],
      "skos:definition": [
        {
          "@value": "A health worker (or a client, on their own device) completes a FHIR R4 Questionnaire conforming to Structured Data Capture as their device renders it, and the result is a QuestionnaireResponse. Generic for any DAK form: a registration, a visit, a referral. Input is the Questionnaire as rendered, with any pre-populated answers; output is the completed QuestionnaireResponse."
        }
      ],
      "skos:notation": "complete-sdc-questionnaire",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/complete-sdc-questionnaire.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/dak-l1-library",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "dak-l1-library"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build a DAK's library from the L1 sources its Component 1 cites, and the L1 knowledge graph that records them. Read when starting or extending a DAK library, when a DAK's guidance changes, and before writing any L1 graph for a DAK. Covers fetching a cited WHO IRIS item, ingesting it, deciding whether it is L1 (declared > context > inferred), extracting the Component 1 graph, the L1 graph of each L1 source as a specialisation of its library entry, and the layering rule: the library is upstream of L1."
        }
      ],
      "skos:notation": "dak-l1-library",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/dak-l1-library.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/dak-postprocessing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "dak-postprocessing"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the DAK post-processing phase produces after the IG Publisher runs — the JSON/JSON-LD surface, the DAK API hub, and the metadata-to-Liquid bridge — and how an IG repository's own site gets the same sidecars from the cached AST (`ig-site:sidecars`). Read before changing a post-processing step, and before assuming the Publisher produced something it did not."
        }
      ],
      "skos:notation": "dak-postprocessing",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/dak-postprocessing.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/dak-preprocessing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "dak-preprocessing"
        }
      ],
      "skos:definition": [
        {
          "@value": "What each DAK pre-processing step does before the IG Publisher runs, which steps exist only to feed the Publisher's page index, and how the phase runs as the overlay on fhir-harness's AST cache refresh (`dak-pre-export.sh`). Also which files in a DAK repository are authored and which are generated, and the SEMVER rule for DAK and IG versions. Read before changing, assuming or moving a pre-processing step."
        }
      ],
      "skos:notation": "dak-preprocessing",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/dak-preprocessing.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/dth-authoring",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "dth-authoring"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a WHO Digital Transformation Handbook (DTH) is produced, from sources to publication, in the seven stages and milestones of dth-authoring.bpmn — and the rules the diagram cannot carry: which review sheet each stage uses, the DAK kinds every DTH is written in, and how a term is deprecated. Read before starting a new DTH, before moving one to its next stage, and before setting up its feedback or public-comment sheet."
        }
      ],
      "skos:notation": "dth-authoring",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/dth-authoring.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/dth-l1-to-l2-ingest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "dth-l1-to-l2-ingest"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turn a WHO Digital Transformation Handbook that exists only as an L1 publication (ingested in who-iris) into an L2 DTH in its own repository that depends on smart-ra: write the handbook's workplan first (what goes in its repo, what goes in smart-ra, which BPMN, roles and DMN to model), then scaffold and seed it. Read before starting work on any dth-* handbook repo."
        }
      ],
      "skos:notation": "dth-l1-to-l2-ingest",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/dth-l1-to-l2-ingest.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/extract-questionnaire-response",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "extract-questionnaire-response"
        }
      ],
      "skos:definition": [
        {
          "@value": "The point-of-care system turns a completed QuestionnaireResponse into the FHIR resources it stands for, by the extraction its SDC Questionnaire declares (StructureMap-based, definition-based or observation-based $extract), and saves them. Input is the response and its Questionnaire; output is a transaction Bundle. Generic for any DAK form."
        }
      ],
      "skos:notation": "extract-questionnaire-response",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/extract-questionnaire-response.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/grade",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "grade"
        }
      ],
      "skos:definition": [
        {
          "@value": "GRADE — the grading system a WHO guideline folio declares for certainty of evidence, and the Evidence-to-Decision judgement a recommendation rests on. Read when a folio's `Task_AppraiseGrade` runs under GRADE, before recording a certainty, an EtD judgement or a recommendation's direction and strength."
        }
      ],
      "skos:notation": "grade",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/grade.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/guideline-use-case",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "guideline-use-case"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stage 0 of smart-guideline-end-to-end: turn a request for a SMART Guideline into a use case — population, setting, jurisdiction and interventions in scope, new or an adaptation — in the requester's own words. The agent asks numbered questions for what the request did not say, and never invents the answer. Read when a guideline request arrives, before any L1 source is looked for."
        }
      ],
      "skos:notation": "guideline-use-case",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/guideline-use-case.md",
      "skos:note": "candidate"
    },
