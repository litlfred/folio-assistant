        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "l4-application-build"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stage 8b of smart-guideline-end-to-end: build the consuming application against the stage-6 IG build (a clean build, not a publication), from the brief and the chosen stage-8a wireframes, with conformance tests from the IG's examples and test cases and a walk through each L2 user scenario it serves. Read before building an L4 application on a guideline."
        }
      ],
