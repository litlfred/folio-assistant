      },
      "skos:prefLabel": [
        {
          "@value": "l4-application-run-local"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run an L4 application that is already built, on the agent's own machine, against a clean IG build, so a person can try or demonstrate it before anything is hosted. Read before starting a local copy of an L4 app for a review, a demo or a country adaptation check."
        }
      ],
      "skos:notation": "l4-application-run-local",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/l4-application-run-local.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/recommendation-candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "recommendation-candidates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turn one ingested L1 source into L1 3.0 recommendation nodes: list every normative sentence as a candidate, let the agent decide each in a curation file, then refuse a non-verbatim statement or unknown location and write the graph, coverage and proposed exclusions. Step 1 of recommendation-extraction, run once per included source; the `l1-recommendation-candidates` Tool satisfies it."
        }
      ],
      "skos:notation": "recommendation-candidates",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/recommendation-candidates.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/recommendation-extraction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "recommendation-extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the recommendations of an L1 source as L1 3.0 recommendation and remark nodes, then describe each one's scenario: the persona (role) who acts on it, the business process they act in, and the user story, as smart-kg L2 user-scenario candidates that reuse the target guide's own vocabulary. Read before extracting recommendations from a WHO guideline or position paper with no printed \"Recommendation N\" labels, before linking a recommendation to a DAK persona or process, and whenever a recommendation has to say who does it and where. Covers the hybrid extraction (mechanical candidates, agent structuring, verbatim and 100 % coverage gates), the reuse-first precedence for personas and processes, the WARNING format, and sign-off."
        }
      ],
      "skos:notation": "recommendation-extraction",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/recommendation-extraction.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/recommendation-scenarios",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "recommendation-scenarios"
        }
      ],
      "skos:definition": [
        {
          "@value": "Join each L1 recommendation to who acts on it and during which business process: one smart-kg L2 user-scenario candidate per recommendation, from the agent's mapping, reusing the target guide's personas and processes first, then smart-base's generic personas, and never inventing a process. Step 2 of recommendation-extraction; the `l1-recommendation-scenarios` Tool satisfies it."
        }
      ],
      "skos:notation": "recommendation-scenarios",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/recommendation-scenarios.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/record-decision-rationale",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "record-decision-rationale"
        }
      ],
      "skos:definition": [
        {
          "@value": "OPTIONAL and never blocking: a health worker who chooses to may note why they accepted or declined decision-support guidance, in one tap plus an optional coded or free-text reason. Input is the decision; output is one FHIR Provenance (or nothing, when skipped, which is the default). The care plan is updated whether or not this is ever done."
        }
      ],
      "skos:notation": "record-decision-rationale",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/record-decision-rationale.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/review-client-history",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-client-history"
        }
      ],
      "skos:definition": [
        {
          "@value": "A health worker reads the client's history as their device shows it (an International Patient Summary, imported records, or a paper card and what the client reports) and takes into account what bears on today's care, weighing each item by where it came from: verified, unverified or reported. Input is the records with their provenance; output is what the health worker relies on."
        }
      ],
      "skos:notation": "review-client-history",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/review-client-history.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/review-decision-support-guidance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "review-decision-support-guidance"
        }
      ],
      "skos:definition": [
        {
          "@value": "A health worker sees the decision-support guidance for one client on their device (the proposed actions of a RequestGroup or CDS Hooks cards) and accepts or declines each action; modifies one only where the device offers it. Input is the guidance as rendered; output is the decision per action. At most one tap per action; nothing else is asked."
        }
      ],
      "skos:notation": "review-decision-support-guidance",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/review-decision-support-guidance.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/smart-base-tools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-base-tools"
        }
      ],
      "skos:notation": "smart-base-tools",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-base-tools.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/smart-guideline-create",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-guideline-create"
        }
      ],
      "skos:definition": [
        {
          "@value": "Somebody asked for a new WHO SMART Guideline (an IG built on smart-base, or a DAK that will feed one). Specialises fhir-ig-create: the same three facts, the same numbered question with the same default (stage it inside this repository first), and the same routes, plus the SMART rules: every guideline repository instantiates smart-base identically, forks under litlfred come before any WHO repository, the identity comes from the declaration and never from the directory, and the WHO template's theme and chrome come from smart-base by `needs`, never copied. Use whenever a user asks to create, start or set up a SMART Guideline, a SMART IG, a WHO IG or a DAK."
        }
      ],
      "skos:notation": "smart-guideline-create",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-guideline-create.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/smart-guideline-end-to-end",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-guideline-end-to-end"
        }
      ],
      "skos:definition": [
        {
          "@value": "The whole road from a use case to a running application on WHO SMART Guidelines, for a new guideline or a jurisdiction's adaptation, as an orchestrator of ten named stage skills, each with its own input and output contract: guideline-use-case, dak-l1-library, recommendation-extraction, l2-dependency-choice, l2-dak-authoring, l3-dependency-choice, l3-fhir-authoring, l4-application-brief, wireframe-design-review and l4-application-build. Each stage's output is the next stage's input. Human adjudication follows every stage as QA, not as a gate, but the order of the stages is a rule: no L3 asset before the L1 extraction and L2 assets it derives from exist with their review requested. Read before starting any end-to-end authoring or adaptation, and to find which skill runs each stage. A request to adapt a WHO guideline, DAK or IG to a country or programme (\"adapt the immunization guidelines to Uganda using these schedules\") is this process, even when it reads like an IG or coding task."
        }
      ],
      "skos:notation": "smart-guideline-end-to-end",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-guideline-end-to-end.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/smart-stack-layering",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-stack-layering"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which layer a WHO SMART asset, rule, script or page belongs to — fhir-harness, smart-base (with its L1 and DAK document kinds) or smart-ig — and the one question that settles it. Read before adding anything to fhir-harness, smart-base or smart-ig, before creating a per-IG harness, and before moving a pre/post-processing step."
        }
      ],
      "skos:notation": "smart-stack-layering",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-stack-layering.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/toolchain-ownership",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "toolchain-ownership"
        }
      ],
      "skos:definition": [
        {
          "@value": "Taking ownership of the WHO smart-base scripts in litlfred, rewriting them to the Skill I/O contract, and the one gate that governs when a script may actually move. Read before touching, copying or rewriting any upstream smart-base script."
        }
      ],
      "skos:notation": "toolchain-ownership",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/toolchain-ownership.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills/transcription-verbatim",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "transcription-verbatim"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check L1 authored from pictures (a schedule poster, a slide deck: a source with no usable text layer) against the image narratives and transcriptions it names: every statement verbatim in one of them, every transcription word corroborated by the entry's text layer unless listed under inspectionOnly, and unique keys. A step of recommendation-extraction, in place of recommendation-candidates when that step found no normative sentence; the `l1-transcription-verbatim` Tool satisfies it."
        }
      ],
      "skos:notation": "transcription-verbatim",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/transcription-verbatim.md",
      "skos:note": "candidate"
    }
  ]
}
