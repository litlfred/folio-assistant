      "@id": "https://litlfred.github.io/folio-assistant/cat-harness-tools/asset/npm-manifest",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/Asset",
      "name": "npm-manifest",
      "path": "package.json",
