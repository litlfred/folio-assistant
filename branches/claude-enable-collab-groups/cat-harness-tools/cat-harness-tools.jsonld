  "@graph": [
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/validators",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "validators",
      "renderable": false,
      "summary": "The validators a harness's code provides, one node each naming the graph typology and $schema family it checks and the Zod export that checks it, joined onto the kinds on first use."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/tools",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "tools",
      "renderable": false,
      "summary": "Tool definitions — themselves nodes in the KG, per the repo taxonomy.",
      "validator": "https://litlfred.github.io/folio-assistant/cat-harness-tools/schema/tool"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/v0/ns/graphTypology/schemas",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "schemas",
      "renderable": false,
      "summary": "A Subgraph of Node Schemas: files that state the shape other files must have."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/health",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "health",
      "renderable": false,
      "summary": "Repository health reports — one `health-report/v1` document per sweep, carrying every check's three-state verdict, the thresholds it applied and the basis each threshold was chosen on. Generated by `test/health/run.ts`; never hand-edited.",
      "validator": "https://litlfred.github.io/folio-assistant/cat-harness-tools/schema/health-report"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/code",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "code",
      "renderable": false,
      "summary": "Source code -- the modules, scripts and entry points an instance holds. Declared so that code is scannable at all: an undeclared file is one no checker has a reason to look at. Being declared here says nothing about whether a Tool node claims it, which is a separate question and a separate axis.",
      "validatorNotApplicable": "its nodes are TypeScript — 1793 files, counted 2026-09-24. `tsc` is the validator for code, and `check:partition` plus `check-code-accounting` grade the graph over it."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/beans",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "beans",
      "renderable": false,
      "summary": "The work plan — what is being worked on, and where each running BPMN instance got to. Its inner directories are declared by `beans/beans.json`."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/bean-defs",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "bean-defs",
      "renderable": false,
      "summary": "Work items — one Markdown file each, in the layout the `beans` CLI reads, carrying `$schema: bean/1.0.0` in its front matter. Authored and edited by people and agents.",
      "validator": "https://litlfred.github.io/folio-assistant/cat-harness-tools/schema/bean-graph"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/bean-notes",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "bean-notes",
      "renderable": false,
      "summary": "Bean notes — one Markdown file per pull request per bean, `$schema: folio-bean-note/v1` in its front matter, named `<bean>--<date>--<branch>.md` so two pull requests never write one path. Indexed by a generated README.",
      "validatorNotApplicable": "no instance declares a directory of this kind — it is nested inside `beans/`, declared by `beans/beans.json`, and its nodes are Markdown with YAML front matter. `beans:notes:check` parses each against `BeanNoteFrontMatterSchema` and re-derives its file name."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/sweep-marks",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "sweep-marks",
      "renderable": false,
      "summary": "When a sweep step last ran — one JSON per check, carrying `\"$schema\": \"folio-sweep-mark/v1\"`, so a skipped `check:session-staleness` is visible after the terminal scrolls (bean `rq8s`)."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/workflow-state",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "workflow-state",
      "renderable": false,
      "summary": "Running BPMN instances — one JSON file each, carrying `\"$schema\": \"folio-workflow-instance/v1\"`. Owned by the interpreter, never hand-edited."
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/v0/ns/graphTypology/cache",
      "@type": "https://litlfred.github.io/bootstrap/v0/ns/GraphTypology",
      "name": "cache",
      "renderable": false,
