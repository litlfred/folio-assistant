{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Indicator Extraction Output",
  "description": "What indicator-extraction produced for one source.",
  "type": "object",
  "required": [
    "entry",
    "indicators",
    "subIndicators",
    "programIndicators"
  ],
  "properties": {
    "entry": {
      "type": "string"
    },
    "indicators": {
      "type": "integer",
      "minimum": 0,
      "description": "L1 indicator nodes for top-level indicators."
    },
    "subIndicators": {
      "type": "integer",
      "minimum": 0,
      "description": "L1 indicator nodes for sub-indicators."
    },
    "programIndicators": {
      "type": "string",
      "description": "Path of the L2 program-indicator drafts."
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "L2 ids with a ProgramIndicator 1..1 element the source does not print."
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sheets skipped, e.g. no printed number."
    }
  },
  "additionalProperties": false,
  "$id": "http://smart.who.int/base/schema/skills/indicator-extraction/output.schema.json",
  "staging": {
    "branch": "claude/enable-collab-groups",
    "sha": "5e3af590eb4ec0af63f863ef344f2ce6a62da90a",
    "pr": "3107/merge",
    "run": "43423856937"
  }
}
