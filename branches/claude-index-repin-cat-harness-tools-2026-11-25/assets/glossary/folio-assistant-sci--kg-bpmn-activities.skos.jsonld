        {
          "@value": "Challenge the block",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An independent adversarial reviewer builds the strongest mathematical and formal case that the statement, proof or model framing is false, vacuous, over-claimed or missing a hypothesis.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Adversarial",
      "dcterms:source": "folio-assistant-sci/processes/content/formalized-publication-authoring.bpmn#Task_Adversarial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities/process_formalizedpublicationauthoring.task_blindleantoprose",
