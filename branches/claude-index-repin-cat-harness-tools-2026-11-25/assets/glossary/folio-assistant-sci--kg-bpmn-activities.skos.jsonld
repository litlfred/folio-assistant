      "skos:prefLabel": [
        {
          "@value": "Judge two-way equivalence",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Same hypotheses, same quantifier order, same conclusion, same objects, in both directions. The narrative proof's logical skeleton is compared with the Lean proof's in the same way. A difference either way is a finding.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_JudgeEquivalence",
