    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities/process_leandocspublish.task_build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the doc-gen4 render over the warm cache",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `lean-html-docs` (`adapters/paper/lean/lean-docs-build.sh --lake-root <pkg> --lib <Lib>`). Reads the SOURCE, the folio's Lake packages. Refuses while another lake/lean process holds `.lake/`, refuses over a restored tree with no traces, checks or restores the warm cache, enables the sentinel-commented doc-gen4 require for this build only, then `lake -R -Kenv=dev build <Lib>:docs`. Output: `<pkg>/.lake/build/doc-data` (the per-module declaration data the viewer is made from) and `<pkg>/.lake/build/doc` (the static HTML, kept only as the fallback): working directories, not yet anything a site reads.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Build",
      "dcterms:source": "folio-assistant-sci/processes/content/lean-docs-publish.bpmn#Task_Build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities/process_leandocspublish.task_mount",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mount the Lean branch store",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run cat state:mount` (or `branch-store.ts mount --id <id>`) at the start of the site build, as for `beans/`: puts the branch tip on disk at the declared path. Reads the RENDER; writes nothing to the branch. A site build of a folio whose Lean did not change starts here.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Mount",
      "dcterms:source": "folio-assistant-sci/processes/content/lean-docs-publish.bpmn#Task_Mount",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities/process_leandocspublish.task_publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish the render at its route, railed",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A site step of the folio's declared build (`site.build.siteSteps`). Reads the mounted RENDER, writes the PUBLISHED pages at `<site>/<route>/`, the route the declaration's `coverage.visualiser` names: the KG viewer and its `data/` shards are copied as they are, and the site build's own rail pass (`rail-standalone-pages.ts --foreign-site`, which runs after every site step) puts the harness rail on the viewer page, so the rail's assets are the site's and nothing extra lands at its root. Fallback, when the store holds doc-gen4's static HTML instead: Tool `lean-render-publish` (`adapters/paper/lean/lean-render.ts --docs <mount path> --site <site> --route <route> --no-rail`) stages it without Lake's bookkeeping, marks its iframe navbar and `find/` redirect rail-declined and adds the layout shim. The document site's ∀ panel links each declaration to the viewer opened at it, `<route>/#/m/<Module>/<name>`.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Publish",
      "dcterms:source": "folio-assistant-sci/processes/content/lean-docs-publish.bpmn#Task_Publish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities/process_leandocspublish.task_store",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the KG render to the Lean branch store",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool `lean-kg-publish` (`adapters/paper/lean/lean-kg-publish.ts --doc-data <pkg>/.lake/build/doc-data --site <checkout> --route <store path> --no-rail`) writes the viewer page and its `data/` shards into the mounted store's path (the folio's declared `lean` graph, e.g. `lean/`), then `bun folio-assistant/cat-harness-tools/scripts/branch-store.ts push --id <id>`. The store is tip-keyed: the branch tip IS the current render, with a root `manifest.json` (`state-manifest/v1`); the push splices onto the tip and never forces. The render is never committed to the folio's main.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_Store",
      "dcterms:source": "folio-assistant-sci/processes/content/lean-docs-publish.bpmn#Task_Store",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities/process_paperauthoring.call_beanclose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanClose: end the bean in a state that says why — complete and archive it, scrap it with its reasons and archive it, or record the blocker and hand it back. The one place resolve and archive are drawn; placed straight before the end so the engine's resolve sees nothing left but the archive step.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanClose",
      "dcterms:source": "folio-assistant-sci/collab/processes/content/authoring-a-paper.bpmn#Call_BeanClose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities/process_paperauthoring.call_beanopen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the bean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_BeanOpen: check before you create, find out whose the bean is, and claim it — or leave it alone when it is someone else's. The one place a claim is drawn; the gateway after this reads which end it reached.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_BeanOpen",
      "dcterms:source": "folio-assistant-sci/collab/processes/content/authoring-a-paper.bpmn#Call_BeanOpen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities/process_paperauthoring.call_publishstatements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish extracted statements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The paper draws on library sources; every statement quoted or extracted from them is published in an appendix page of the paper and in the shared extraction viewer, each linked to its library entry and section, before the paper is rendered. These pages are EXPOSITION about sources, never part of a proof: nothing published here enters a formal statement or its Lean sibling. The sub-process is core's, the same for every content type; the paper supplies only the page look.",
          "@language": "en"
        }
      ],
      "skos:notation": "Call_PublishStatements",
      "dcterms:source": "folio-assistant-sci/collab/processes/content/authoring-a-paper.bpmn#Call_PublishStatements",
      "skos:note": "candidate"
    },
