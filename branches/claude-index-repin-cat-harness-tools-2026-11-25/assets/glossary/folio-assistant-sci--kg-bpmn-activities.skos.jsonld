      },
      "skos:prefLabel": [
        {
          "@value": "Record gap or conjecture",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Demote the block to a conjecture, or state the open step with `sorry` and a citation, and record the gap in the work plan. Never weaken the statement until it passes.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_RecordGap",
      "dcterms:source": "folio-assistant-sci/processes/content/formalized-publication-authoring.bpmn#Task_RecordGap",
