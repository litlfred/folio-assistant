      "skos:prefLabel": [
        {
          "@value": "Draft triple: prose and Lean",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the narrative statement and narrative proof in the block's `.md` and the formal statement and proof in its `.lean`. Write the Lean statement first and ask whether it could be false. An unproved step is `sorry` with a citation; a dependence on a conjecture is an explicit class hypothesis. A number in prose is read from its witness.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_DraftTriple",
      "dcterms:source": "folio-assistant-sci/processes/content/formalized-publication-authoring.bpmn#Task_DraftTriple",
      "skos:note": "candidate"
    },
