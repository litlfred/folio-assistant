      },
      "skos:prefLabel": [
        {
          "@value": "Set claim",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The author names the claim, the objects it is about, and the sources it rests on, before any text is drafted.",
          "@language": "en"
        }
      ],
      "skos:notation": "Task_StateIntent",
      "dcterms:source": "folio-assistant-sci/processes/content/formalized-publication-authoring.bpmn#Task_StateIntent",
