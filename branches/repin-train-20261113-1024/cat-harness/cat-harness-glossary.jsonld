      "title": "External registry",
      "notation": "external-registry",
      "definition": "Trusted registries and observatories outside this layer's control. Nothing here instructs it; its skill is the contract the diagrams rely on it for.",
      "altLabel": [
        "Portal (external consumer)"
      ],
      "inScheme": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld",
