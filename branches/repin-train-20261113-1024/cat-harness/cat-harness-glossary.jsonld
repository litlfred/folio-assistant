      ]
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_CopyOutMaterialized/Lane_Source",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns/LaneUsage",
