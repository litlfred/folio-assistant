      "label": "Model author",
      "scopeNote": "The person who draws the model in Archi, on their own machine. A finding from the pipeline is theirs to act on: the pipeline never edits a model.",
      "source": "cat-harness/processes/ui/archimate-publish.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_WebAppPublish/Lane_Author",
