      "source": "cat-harness/processes/content/review-task.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_KgToPortal/Lane_Editorial",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns/LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/editor",
      "inProcess": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/process/Process_KgToPortal",
      "label": "Editorial",
      "scopeNote": "Two decisions, not one: E_Scope bounds what may leave the repository before the pipeline runs, and E_HumanEyes — reached only after S_Sign — approves what a reader will actually see, which merging to main does not. When GW_Budget rejects a package as over budget, narrowing scope here is the only way back in, so this lane is doing gatekeeping at both ends of the pipeline rather than once.",
      "source": "cat-harness/processes/kg/kg-to-portal.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/reviewer",
      "@type": "skos:Concept",
      "prefLabel": "Reviewer / SME",
      "title": "Reviewer / SME",
      "notation": "reviewer",
      "definition": "Reads a change and judges it. Cannot accept it — that is the editor's lane — and the separation is why review findings are advice rather than commits. The GENERIC review position: what kind of thing changed decides which subprocess it descends into (review-task.bpmn), and the actor takes on that inner lane's role for the call path only.",
      "altLabel": [
        "Reviewer",
        "Subject-Matter Expert / Reviewer"
      ],
      "inScheme": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld",
      "usage": [
