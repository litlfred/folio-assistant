    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/editor",
      "@type": "skos:Concept",
      "prefLabel": "Editor",
      "title": "Editor",
      "notation": "editor",
      "definition": "Author plus the authority to accept a change into the corpus. The lane that sees QA findings and decides.",
      "altLabel": [
        "Editorial",
        "Editors + authoring agents"
