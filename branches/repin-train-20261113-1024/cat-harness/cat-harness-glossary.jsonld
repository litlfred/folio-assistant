      "inProcess": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/process/Process_HarnessRendering",
      "label": "Board renderer",
      "scopeNote": "Runs where the reader is, once per page. It draws and performs what the reader decided; every choice sits in the reviewer's lane.",
      "source": "cat-harness/processes/ui/harness-default-rendering.bpmn"
    },
    {
