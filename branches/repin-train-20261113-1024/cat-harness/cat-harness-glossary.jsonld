  "prefLabel": "cat-harness glossary",
  "title": "cat-harness glossary",
  "definition": "The words this instance defines: every persona its BPMN diagrams place in a swimlane, every graph kind and node kind it declares, and the harness itself, one concept each. A persona's labels come from the lanes, its definition from the role registry and its scope notes from each lane's own <bpmn:documentation>; a graph kind's label and definition from its graph typology; a node kind's from the kind, with its parents as broader terms; the harness's from its declaration. Generated by scripts/glossary-export.ts.",
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/user",
      "@type": "skos:Concept",
      "prefLabel": "User",
      "title": "User",
      "notation": "user",
      "definition": "The person the assistant is working for. States intent, answers the questions the agent cannot decide from the filesystem, and confirms anything irreversible.",
      "altLabel": [
        "Contributor",
        "Contributor (human or agent)",
        "Human actor",
        "Log operator (human)",
        "Owner",
        "Reader (any actor)",
        "Subscriber (the folio's owner)"
      ],
