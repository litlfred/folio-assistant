      "source": "cat-harness/library/processes/copy-out-materialized.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_CopyIntoFolio/Lane_Source",
