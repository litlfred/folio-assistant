        "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_KgSeparationMove/Lane_Pipeline",
        "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_KgSeparationPrepare/Lane_Pipeline",
        "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_KgToPortal/Lane_Pipeline",
