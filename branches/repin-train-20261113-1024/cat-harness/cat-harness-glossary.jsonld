    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_KgToPortal/Lane_Target",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns/LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/publish-target",
      "inProcess": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/process/Process_KgToPortal",
      "label": "Publish target",
      "scopeNote": "The one lane whose action makes a URL live, which is exactly why a CDN in front of it is not drawn as a second lane — folding the cache in as a participant would make its URL look like the published one, and the canonical URL is this lane's promise to keep, not the cache's. Uploading and exposing stay two separate moments here rather than one, so a bad layout is still catchable before a reader can reach it.",
      "source": "cat-harness/processes/kg/kg-to-portal.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/attestation-service",
      "@type": "skos:Concept",
      "prefLabel": "Attestation service",
      "title": "Attestation service",
      "notation": "attestation-service",
      "definition": "Signs a QA report's run hashes over an API. A MECHANICAL role, and the one that DISAPPEARS when the actor performing it cannot reach out — which is why the signing process carries a second, human lane rather than a retry.",
      "altLabel": [
        "Attestation (GDHCN / WHO SMART Trust)",
        "Attestation service (API)"
      ],
      "inScheme": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld",
      "usage": [
        "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_KgToPortal/Lane_Attestation",
        "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_QaReportSigning/Lane_Api",
        "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_TestPlanExecution/Lane_Attestation"
      ]
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_KgToPortal/Lane_Attestation",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns/LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/attestation-service",
      "inProcess": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/process/Process_KgToPortal",
      "label": "Attestation (GDHCN / WHO SMART Trust)",
      "scopeNote": "Signs after A_Package and before E_HumanEyes, so what a human approves downstream is exactly what got signed — reordering the two would let a reviewer approve bytes the signature no longer covers. Whether that signature covers the whole package, each asset, or both composed is a deployment choice this lane executes rather than makes.",
      "source": "cat-harness/processes/kg/kg-to-portal.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_QaReportSigning/Lane_Api",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns/LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/attestation-service",
      "inProcess": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/process/Process_QaReportSigning",
      "label": "Attestation service (API)",
      "scopeNote": "Reached only from the DMN table's one row where both egress and a configured endpoint are true — everything else in Gateway_SigningRoute's table routes around this lane entirely, so its presence in a trace is itself already the answer to whether egress existed. It carries exactly one task and no branch of its own, because the routing decision was already made before this lane was entered.",
      "source": "cat-harness/sdlc/processes/qa-report-signing.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/cat-harness-glossary.jsonld#glossary-usage/Process_TestPlanExecution/Lane_Attestation",
      "@type": "https://litlfred.github.io/cat-harness/v0/ns/LaneUsage",
      "ofConcept": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/attestation-service",
      "inProcess": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/process/Process_TestPlanExecution",
      "label": "Attestation service",
      "scopeNote": "Signs the certification and files it. Reached only from `certified`: a refusal and an undetermined result are recorded by the certifier and signed by nobody. The signature itself is `qa-report-signing.bpmn`, called unchanged, whose own gateway chooses the API or a human release authority by the signer's reach.",
      "source": "cat-harness/sdlc/processes/test-plan-execution.bpmn"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/branches/repin-train-20261113-1024/cat-harness/role/work-plan",
