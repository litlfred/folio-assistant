      ],
      "dcterms:title": "Malaria vaccine: WHO position paper – March 2022 – Rapport mensuel des cas de dracunculose, janvier 2022",
      "dcterms:creator": [
        "World Health Organization = Organisation mondiale de la Santé"
      ],
      "dcterms:issued": "2022-03-04",
