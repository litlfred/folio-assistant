      "dcterms:title": "DeepSeek-Prover-V2: Advancing Formal Mathematical Reasoning via Reinforcement Learning for Subgoal Decomposition",
      "dcterms:creator": [
        "Ren, Z. Z.",
        "Shao, Zhihong",
        "Song, Junxiao",
        "Xin, Huajian",
        "Wang, Haocheng",
