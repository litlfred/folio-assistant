      "dcterms:title": "Way and Means of Implementing Resolutions of Regional Interest Adopted by the World Health Assembly and the Executive Board  Report of the Regional Director",
      "dcterms:creator": [
        "Regional Committee for Africa, 54"
      ],
      "dcterms:issued": "2004-12-31",
      "dcterms:publisher": "World Health Organization. Regional Office for Africa",
