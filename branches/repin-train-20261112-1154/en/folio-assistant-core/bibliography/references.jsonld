    {
      "@id": "references/eu-implementing-decision-2021-1073",
      "@type": [
        "fabio:Work",
        "bibo:Legislation"
      ],
      "dcterms:title": "Implementing Decision (EU) 2021/1073, Annex I",
      "dcterms:identifier": "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=uriserv%3AOJ.L_.2021.230.01.0032.01.ENG",
