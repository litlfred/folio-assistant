    {
      "@id": "references/arxiv-2406.01940v2.r17",
      "@type": [
        "fabio:Work",
        "bibo:Document"
      ],
      "dcterms:title": "Textbooks are all you need",
      "dcterms:creator": [
        "Gunasekar, Suriya",
        "Zhang, Yi",
        "Aneja, Jyoti",
        "Caio César Teodoro Mendes",
        "Allie Del Giorno",
