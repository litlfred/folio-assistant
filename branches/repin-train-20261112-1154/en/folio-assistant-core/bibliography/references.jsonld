      ],
      "dcterms:title": "WHO guidelines for screening and treatment of precancerous lesions for cervical cancer prevention",
      "dcterms:creator": [
        "Edition, Corporate"
      ],
      "dcterms:issued": "D:20150117",
      "dcterms:source": "who-iris/library/10665-94830-per/manifest.jsonld",
