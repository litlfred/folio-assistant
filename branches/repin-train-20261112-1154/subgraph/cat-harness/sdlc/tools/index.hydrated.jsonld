            "https://litlfred.github.io/folio-assistant/cat-harness/skill/prepare-merge"
          ],
          "title": "Judge a tree and record the verdict by digest"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "sdlc/tools/judge-tree",
      "path": "sdlc/tools/judge-tree/"
