                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--sha"
                },
                "description": "The head commit: whose tree is read from --caller-dir, and where the status is published.",
                "name": "sha",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/CommitSha"
              },
              {
                "arg": {
                  "flag": "--root"
                },
                "description": "The mounted index with the caller swapped in, where run-gates.py runs.",
                "name": "root",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--instance"
                },
                "description": "The own layer(s) run-gates.py judges; repeatable.",
                "name": "instance",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/InstanceId"
              },
              {
                "arg": {
                  "flag": "--base-verdict"
                },
                "description": "A stored verdict record standing in for the base run; refused unless its treeDigest is the base tree's (--base-tree).",
                "name": "base-verdict",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--base-root"
                },
                "description": "A mounted base tree to run the gates on instead.",
                "name": "base-root",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--test-path"
                },
                "description": "What `bun test` runs on each side; none means no tests.",
                "name": "test-path",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--publish"
                },
