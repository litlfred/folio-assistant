              "path": "library/10665-196326/blocks/prose-sec-005.jsonld",
              "title": "Core competence 1: Ability to analyse the boundaries between public health practice, including surveillance, and research and their ethical implications in emergencies"
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-006",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-006.jsonld",
              "title": "Learning objective 1.1: Distinguish between public health surveillance and public health research."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-007",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-007.jsonld",
              "title": "Learning objective 1.2: Identify the scope of activities that could qualify as “research” during emergency response and would normally require research ethics review."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-008",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-008.jsonld",
              "title": "Learning objective 1.3: Demonstrate understanding of the ethical principles and requirements addressed in current normative instruments relative to research and surveillance in emergencies."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-009",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-009.jsonld",
              "title": "Learning objective 1.4: Identify the shortcomings of current normative instruments for use in emergency situations, and evaluate alternatives."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-010",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-010.jsonld",
              "title": "Core competence 2: Ability to define adequate processes for ethics review in public health interventions, surveillance and research in emergencies"
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-011",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-011.jsonld",
              "title": "Learning objective 2.1: Describe “standard” procedures that should govern an ethics review of research activities, including public health research."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-012",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-012.jsonld",
              "title": "Learning objective 2.2: Identify circumstances in which public health surveillance activities should possibly undergo formal ethics review."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-013",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-013.jsonld",
              "title": "Learning objective 2.3: Describe possible variations to standard procedures of ethics review that are applicable to research in emergencies."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-014",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-014.jsonld",
              "title": "Core competence 3: Ability to identify conflict between the common good and individual autonomy in surveillance during emergency response"
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-015",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-015.jsonld",
              "title": "Learning objective 3.1: Identify possible harm and benefit to individuals and communities resulting from public health practice and surveillance."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-016",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-016.jsonld",
              "title": "Learning objective 3.2: Assess the factors to be considered in determining when public health surveillance requires explicit informed consent from individuals or communities."
            },
