              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-017",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-017.jsonld",
              "title": "Learning objective 3.3: Evaluate the measures required to protect privacy and confidentiality in an emergency."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-018",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-018.jsonld",
              "title": "Learning objective 3.4: Describe specific measures required to protect and collect data and biological materials during public health surveillance."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-019",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-019.jsonld",
              "title": "Learning objective 3.5: Describe circumstances in which the common good might overrule individual autonomy during public health surveillance."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-020",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-020.jsonld",
              "title": "Core competence 4: Ability to identify conflict between the common good and individual autonomy in research and clinical trials during emergency response"
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-021",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-021.jsonld",
              "title": "Learning objective 4.1: Identify potential harm and benefit to individuals and communities resulting from conducting research in emergencies."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-022",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-022.jsonld",
              "title": "Learning objective 4.2: Discuss moral theories, and identify frameworks applicable to research in emergencies."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-023",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-023.jsonld",
              "title": "Learning objective 4.3: Explain the current norms under which a waiver of consent could be deemed acceptable for research in critical care settings, and assess when they could be applicable to research in emergencies."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-024",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-024.jsonld",
              "title": "Learning objective 4.4: Explain the processes required to improve informed consent to research in emergencies, with particular consideration of traditional communities and low‑resource settings."
            },
