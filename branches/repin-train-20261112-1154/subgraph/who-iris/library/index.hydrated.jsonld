              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-025",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-025.jsonld",
              "title": "Core competence 5: Ability to explain how publication ethics are related to public health surveillance or research in emergencies"
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-026",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-026.jsonld",
              "title": "Learning objective 5.1: Explain the conditions in which data gathered during public health surveillance or routine clinical management can be published as scientific knowledge."
            },
            {
              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-027",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-027.jsonld",
              "title": "Learning objective 5.2: Explain what is meant by “publication bias” and how it might affect the response to emergencies."
            },
