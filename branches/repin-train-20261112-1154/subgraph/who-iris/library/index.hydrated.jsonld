              "@id": "https://litlfred.github.io/folio/library/10665-196326/blocks/prose-sec-028",
              "@type": "https://litlfred.github.io/folio-assistant-core/v0/ns/Prose",
              "path": "library/10665-196326/blocks/prose-sec-028.jsonld",
              "title": "Learning objective 5.3: Explain the ethical obligations of researchers, public health practitioners and publishers regarding ownership of scientific data."
            },
