    {
      "id": "library/10665-92871/blocks/prose-sec-012",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "REQUESTS the Director-General: to take action within the framework of the “Three",
      "pageStart": 10,
      "pageEnd": 12,
      "target": "../sections/sec-012-47-requests-the-director-general-to-take-action.md",
      "narrative": null,
      "content": "REQUESTS the Director-General: to take action within the framework of the “Three \nOnes” principle. \n \n48. \n(a) to provide support to countries in order to maximize opportunities for the delivery \nof all relevant interventions for prevention, care, support and treatment of \nHIV/AIDS and related conditions, including tuberculosis. \n \n49. \nThe Regional Office will continue to utilize its presence at national and international \nlevels to forge and strengthen partnerships to improve resource mobilization and provide \ngreater technical support to countries’ HIV/AIDS programmes. In this regard, the W",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Continues regional action on HIV/AIDS under WHA57.14, including the Three Ones principle, partnerships and resource mobilization, and prevention including condoms and sterile injecting equipment. It covers scaling up prevention of mother-to-child transmission and improving access to medicines and diagnostics through national medicines policies and prequalification. It also covers supply chain assessments, strengthening health systems and reporting to the Regional Committee and the Health Assembly.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
