    {
      "id": "library/10665-208888/blocks/prose-sec-014",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Étape 1 : Critères d’inclusion",
      "pageStart": 21,
      "pageEnd": 23,
