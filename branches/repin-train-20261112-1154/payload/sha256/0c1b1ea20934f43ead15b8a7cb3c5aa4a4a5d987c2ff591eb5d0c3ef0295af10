    {
      "id": "library/10665-332907/blocks/prose-sec-005",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Tuberculosis",
      "pageStart": 13,
      "pageEnd": 15,
      "target": "../sections/sec-005-tuberculosis.md",
      "narrative": null,
      "content": "The incidence of TB in a cohort of children living \nwith HIV in Uganda and Zimbabwe ranged from \n1.2 to 8.8 per 100 child-years, and an estimated \n15% of children starting antiretroviral therapy in \nsub-Saharan Africa develop TB (14,15). Although \nantiretroviral therapy reduces children’s risk of \nTB infection, its full protective potential is only \nevident 1–2 years after starting antiretroviral \ntherapy (8). TB is especially common in the \nfirst three months after starting antiretroviral \ntherapy (16).\nCareful history (including contact history) \nand examination should be performed for all",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Describes the high incidence of TB in children with HIV and the symptoms used to screen for it, noting the overlap with other HIV-related signs. It covers the limits of urine LF-LAM testing in children, the 2019 LAM recommendations and the advantages of rapid molecular tests such as Xpert MTB/RIF, while stressing the continuing role of clinical diagnosis.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
    },
    {
      "id": "library/10665-332907/blocks/prose-sec-006",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Cryptococcal disease",
      "pageStart": 15,
      "pageEnd": 16,
      "target": "../sections/sec-006-cryptococcal-disease.md",
      "narrative": null,
      "content": "In contrast to adults, cryptococcal disease is \nrare, especially among children younger than \nfive years of age. In a laboratory-based survey \nperformed in South Africa, the incidence of \ncryptococcal disease was estimated to be 47 per \n100 000 children living with HIV in 2007 (26), \nand within two trial cohorts of children living \nwith HIV, no cases of cryptococcal disease were \nreported for children younger than five years \n(27). Screening for cryptococcal antigen and pre-\nemptive therapy is therefore only recommended \nfor adolescents.\nUseful resources\nRapid communication: molecular assays a",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Explains that cryptococcal disease is rare in young children with HIV, so antigen screening is recommended only for adolescents, and lists useful WHO resources on TB diagnostics and HIV guidelines.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
