      "@id": "https://litlfred.github.io/folio-assistant/subgraph/who-iris/tools/translation-qa-prune/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/who-iris/tools/translation-qa-prune.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Drop the translation-semantic-roundtrip rulings of strings the catalogues no longer hold, and renumber the rest to catalogue order. Rulings are paired with strings by the hash of their msgid, so removing strings invalidates none and needs no agent re-run; this is the upkeep that follows. It only drops or renumbers: a verdict is never changed or invented, and a ruling for a string the ref's history never held (one recorded ahead of its PR) is kept.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat translation-qa:prune"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--write"
                },
                "description": "Apply the change to test/attestations/translation-qa/. Absent, it is a dry run that prints each dropped ruling and the renumbered spans.",
                "name": "write",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--ref"
                },
                "description": "Whose catalogues decide what was removed. Default origin/main: the state branch serves main and every branch, so a ruling goes only once main no longer holds its string.",
                "name": "ref",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
              }
            ],
            "outputs": [
              {
                "description": "With --write, the rewritten `test/attestations/translation-qa/<catalogue>.<locale>.attestations.json`, to be pushed to `cat/who-iris/attestations`.",
                "name": "attestations",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ]
          },
          "name": "translation-qa-prune",
          "requirements": {
            "network": false,
            "runtime": [
              "bun",
              "git"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/translation-manager",
          "title": "Prune round-trip rulings of removed strings"
        }
      ],
