    {
      "@id": "http://smart.who.int/base/process/Process_SgEndToEnd",
      "@type": "bootstrap:Process",
      "depiction": "https://litlfred.github.io/folio-assistant/assets/img/workflows/smart-guideline-end-to-end.svg",
      "description": "From a use case to a consuming application: identify the L1 guidelines, ingest them into an L1 knowledge graph, choose the L2 DAKs to build on, create or adapt the L2 assets, choose the L3 IGs to build on, produce the L3 assets, then build the L4 consuming application the requester describes. Adjudication follows every stage as QA, not as a gate, but the order is strict: no L3 asset before the L1 extraction and L2 assets it derives from exist with their review requested (Gateway_L3Ready). Each stage forks into the next stage and its adjudication, and each adjudication has its own end event, so the instance completes only when all are recorded. Each stage runs the skill named on its activity, with its own input and output contract (l2-dak-authoring.bpmn for stage 4, dak-l3-ig.bpmn for stage 6), and its output is the next stage's input. The smart-guideline-end-to-end skill orchestrates the stages and says who adjudicates each.",
      "enforcement": "advisory",
      "flowCount": 38,
      "inSubgraph": "http://smart.who.int/base/directory/collab",
      "name": "SMART Guideline end to end",
      "nodeCount": 37,
