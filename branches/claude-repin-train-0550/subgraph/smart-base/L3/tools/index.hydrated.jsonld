      "hasMember": [
        {
          "@id": "http://smart.who.int/base/tools/kg-extract-l3.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Extract the L3 index from a SMART Guidelines IG's source tree (`smart-base/L3/schemas/extract-l3.ts`, ported from WHO smart-kg `tools/extract-l3.mjs`): one thin node per FHIR artefact (PlanDefinition, ActivityDefinition, Library, Measure, Questionnaire, StructureMap/Definition, ValueSet, CodeSystem, ConceptMap, ActorDefinition, Requirements, CQL) read from FSH, FML and JSON with RuleSets expanded, the real `uses` and `citesSource` canonical references, and the `implementedBy` edges that tie each artefact to the L2 component its Title names by the SOP's id convention. Coverage is reported across every artefact type.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "npx --prefix smart-base/L1/schemas tsx smart-base/L3/schemas/extract-l3.ts"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--ig"
                },
                "description": "The IG root (holds `sushi-config.yaml` and `input/`).",
                "name": "ig",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--out"
                },
                "description": "Where the graph document goes; stdout when absent.",
                "name": "out",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ],
            "outputs": [
              {
                "description": "The L3 graph document; each node carries the SHA-256 of the file it came from.",
                "name": "graph",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ]
          },
          "name": "kg-extract-l3",
          "satisfies": "http://smart.who.int/base/skill/smart-base-tools",
          "title": "FHIR IG → L3 knowledge graph"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "L3/tools/kg-extract-l3",
      "path": "L3/tools/kg-extract-l3/"
