    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/smart-base/L3/tools/terminology-lookup/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "http://smart.who.int/base/tools/terminology-lookup.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Look up a concept or code token for a semantic slot across the four reuse-first rungs of the `terminology-coding` methodology: (1) the target guide's `l1-scenario-vocabulary/v1`; (2) smart-base's generic personas (`DAK.Persona.*`), GRADE `code-lists/*.json` and the `guideline-domain` SKOS glossary; (3) local WHO/ILO FSH CodeSystems (`ISCO08`, `CDHIv2`, `CDHIv1`, `CDSCv2`, `KGTerminologySystem`); (4) a proposed `glossary-terms` candidate (`status: \"candidate\"`), or `could-not-determine` for `business-process`.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run smart-base/scripts/terminology-lookup.ts --slot <slot> --query <query> [--vocabulary <guide.json>] [--generic <generic.json>] [--scheme <scheme>] [--out <out.json>]"
          },
          "io": {
            "inputs": [
              {
                "description": "The slot to code (`condition`, `intervention`, `persona`, `medicine`, `domain`, `business-process`, `recommendation-strength`, `recommendation-direction`, `evidence-certainty`).",
                "name": "slot",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
              },
              {
                "description": "The term, identifier or code token to look up.",
                "name": "query",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/DocId"
              },
              {
                "description": "The target guide's personas and business processes (`l1-scenario-vocabulary/v1`), rung 1.",
                "name": "vocabulary",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "smart-base's generic personas (`l1-scenario-vocabulary/v1`), rung 2.",
                "name": "generic",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "Restrict to one scheme (e.g. `guideline-domain`, `ISCO08`, `CDHIv2`, `grade-recommendation-strength`).",
                "name": "scheme",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/DocId"
              },
              {
                "description": "Where to write the result JSON.",
                "name": "out",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ],
            "outputs": [
              {
                "description": "Result JSON conforming to `L1/schemas/skills/classify-and-code-content/output.schema.json`.",
                "name": "result",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ]
          },
          "name": "terminology-lookup",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "http://smart.who.int/base/skill/classify-and-code-content",
          "title": "Reuse-first terminology and code-list lookup"
        }
      ],
