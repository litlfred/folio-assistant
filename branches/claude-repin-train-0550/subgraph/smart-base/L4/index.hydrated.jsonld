              "outputSchema": "http://smart.who.int/base/schema/skills/complete-sdc-questionnaire/output.schema.json",
              "payload": {
                "@id": "https://litlfred.github.io/folio-assistant/payload/sha256/9839e255ec293f556921af9d89aff321f4a450c864000814c29177a510ad4805",
                "bytes": 3895,
                "sha256": "9839e255ec293f556921af9d89aff321f4a450c864000814c29177a510ad4805"
              },
              "title": "Complete an SDC questionnaire"
            },
            {
              "@id": "http://smart.who.int/base/skill/extract-questionnaire-response",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "The point-of-care system turns a completed QuestionnaireResponse into the FHIR resources it stands for, by the extraction its SDC Questionnaire declares (StructureMap-based, definition-based or observation-based $extract), and saves them. Input is the response and its Questionnaire; output is a transaction Bundle. Generic for any DAK form.",
              "hasIOContract": true,
              "hasInstructions": true,
              "inSubgraph": "http://smart.who.int/base/directory/smart-base-L4",
              "inputSchema": "http://smart.who.int/base/schema/skills/extract-questionnaire-response/input.schema.json",
