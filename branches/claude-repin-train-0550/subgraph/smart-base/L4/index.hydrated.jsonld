            },
            {
              "@id": "http://smart.who.int/base/skill/complete-sdc-questionnaire",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "A health worker (or a client, on their own device) completes a FHIR R4 Questionnaire conforming to Structured Data Capture as their device renders it, and the result is a QuestionnaireResponse. Generic for any DAK form: a registration, a visit, a referral. Input is the Questionnaire as rendered, with any pre-populated answers; output is the completed QuestionnaireResponse.",
              "hasIOContract": true,
              "hasInstructions": true,
              "inSubgraph": "http://smart.who.int/base/directory/smart-base-L4",
              "inputSchema": "http://smart.who.int/base/schema/skills/complete-sdc-questionnaire/input.schema.json",
