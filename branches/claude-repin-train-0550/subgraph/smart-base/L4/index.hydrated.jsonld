              },
              "title": "Extract resources from a questionnaire response"
            },
            {
              "@id": "http://smart.who.int/base/skill/inform-client",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "A health worker tells the client (or caregiver) what was decided and what happens next, in words and, where the DAK gives one, on a slip or card: a referral, a return date, a result. Input is what to tell and the client's language; output is that the client was told, and what they were handed. Generic for any DAK step that ends with the client being informed.",
              "hasIOContract": true,
              "hasInstructions": true,
              "inSubgraph": "http://smart.who.int/base/directory/smart-base-L4",
              "inputSchema": "http://smart.who.int/base/schema/skills/inform-client/input.schema.json",
