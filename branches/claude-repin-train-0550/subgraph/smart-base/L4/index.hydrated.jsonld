              },
              "title": "Activate accepted guidance"
            },
            {
              "@id": "http://smart.who.int/base/skill/apply-decision-support",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "The point-of-care system applies a DAK decision table's PlanDefinition to one client ($apply) and gets the proposed actions back as a RequestGroup (R4; RequestOrchestration in R5), or as CDS Hooks cards when the guidance comes from a CDS service. Input is the PlanDefinition and the client; output is the proposal, every request in it still a proposal.",
              "hasIOContract": true,
              "hasInstructions": true,
              "inSubgraph": "http://smart.who.int/base/directory/smart-base-L4",
              "inputSchema": "http://smart.who.int/base/schema/skills/apply-decision-support/input.schema.json",
