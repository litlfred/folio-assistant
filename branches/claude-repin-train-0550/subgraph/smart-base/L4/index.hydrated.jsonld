                "sha256": "4a552420518b6202f97b319e31e2a52176625e28e499b99094158e9c07ae808f"
              },
              "title": "l4-application-brief"
            },
            {
              "@id": "http://smart.who.int/base/skill/l4-application-build",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "Stage 8b of smart-guideline-end-to-end: build the consuming application against the stage-6 IG build (a clean build, not a publication), from the brief and the chosen stage-8a wireframes, with conformance tests from the IG's examples and test cases and a walk through each L2 user scenario it serves. Read before building an L4 application on a guideline.",
              "hasIOContract": true,
              "hasInstructions": true,
              "inSubgraph": "http://smart.who.int/base/directory/smart-base-L4",
              "inputSchema": "http://smart.who.int/base/schema/skills/l4-application-build/input.schema.json",
