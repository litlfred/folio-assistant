            },
            {
              "@id": "http://smart.who.int/base/skill/l4-application-brief",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "Stage 7 of smart-guideline-end-to-end: get from the requester a description of the consuming application — who uses it, on what device, which L2 processes and L3 resources it covers, connectivity, the systems it talks to — and turn it into the design intent wireframe-design-review starts from. The agent offers options drawn from the L2 personas and processes, and never invents the application. Read before wireframing or building an L4 application on a guideline.",
              "hasIOContract": true,
              "hasInstructions": true,
              "inSubgraph": "http://smart.who.int/base/directory/smart-base-L4",
              "inputSchema": "http://smart.who.int/base/schema/skills/l4-application-brief/input.schema.json",
