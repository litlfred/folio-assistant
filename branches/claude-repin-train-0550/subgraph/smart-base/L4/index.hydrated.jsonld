              },
              "title": "l4-application-build"
            },
            {
              "@id": "http://smart.who.int/base/skill/l4-application-run-local",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "Run an L4 application that is already built, on the agent's own machine, against a clean IG build, so a person can try or demonstrate it before anything is hosted. Read before starting a local copy of an L4 app for a review, a demo or a country adaptation check.",
              "hasIOContract": false,
