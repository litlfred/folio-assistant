              "@id": "http://smart.who.int/base/skill/activate-accepted-guidance",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "The point-of-care system carries out the health worker's decisions on decision-support guidance: each accepted action's request becomes active (intent plan or order) and joins the client's CarePlan; a declined action is not written. Input is the guidance and the decisions; output is the transaction Bundle saved.",
              "hasIOContract": true,
              "hasInstructions": true,
              "inSubgraph": "http://smart.who.int/base/directory/smart-base-L4",
              "inputSchema": "http://smart.who.int/base/schema/skills/activate-accepted-guidance/input.schema.json",
