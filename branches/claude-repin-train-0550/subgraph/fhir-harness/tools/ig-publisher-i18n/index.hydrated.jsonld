      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/ig-publisher-i18n.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Fetches the IG Publisher's own message bundles (`Messages_<lang>.properties` in `org.hl7.fhir.utilities-<core>.jar`, Maven Central) at exactly the core version the AST recorded, and translates each QA message by its `message-id`: the Publisher's translation where it has one whose placeholders match the English, else this layer's catalogue `translations/<locale>/publisher/messages.po` (machine translation, marked as such), else the English. `needs --merge` appends to each locale's catalogue the strings a build lacks, each with an example and deep links to the rows that print it. The site build (`ig-qa-page.ts`) calls it for every locale the IG translates its pages into and publishes `qa-messages.<locale>.json` and `i18n-usage.json` beside the QA report.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run fhir-harness/scripts/ig-publisher-i18n.ts"
      },
      "io": {
        "inputs": [
          {
            "description": "`fetch <core-version> <dir>`, or `needs <qa-messages.json> <bundle-dir> <translations-dir> <locale>...`.",
            "name": "command",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "arg": {
              "flag": "--merge"
            },
            "description": "With `needs`: append what each locale lacks to its catalogue.",
            "name": "merge",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--site"
            },
            "description": "With `needs`: the published site's URL, so a catalogue's links open the rendered rows.",
            "name": "site",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          }
        ],
        "outputs": [
          {
            "description": "Strings each locale lacks a translation for.",
            "name": "needs",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "ig-publisher-i18n",
      "requirements": {
        "network": true,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/fhir-harness/skill/ig-build-pipeline",
      "title": "Put the IG Publisher's QA messages in each language an IG translates into, from the Publisher's own translations first"
