      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/tools/fhir-core.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Read each stable FHIR release's core package (`hl7.fhir.r4.core#4.0.1`, `hl7.fhir.r4b.core#4.3.0`, `hl7.fhir.r5.core#5.0.0`) at the version, sha1 and sha512 `fhir-core/pins.json` pins, and keep its resources, complex and primitive types and root types (Base, Element, BackboneElement, DomainResource, Resource) under `fhir-core/<release>/`, keyed by canonical URL. `index` writes the release's manifest (each definition's kind, type, base and sha256); `materialise` writes the bodies byte for byte as the package holds them; `check` holds the two to the pins offline; `resolve` answers which file a canonical URL is kept in. A package that cannot be fetched or verified is recorded as `unread` with the reason, never as an empty graph.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run fhir-harness/scripts/fhir-core.ts <index|materialise|check|resolve <url>>"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--root"
            },
            "description": "The fhir-harness layer root. Default: the layer this script is in.",
            "name": "root",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--release"
            },
            "description": "One release (R4, R4B or R5). Default: every pinned release.",
            "name": "release",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--tgz-dir"
            },
            "description": "A directory of already-downloaded `<name>-<version>.tgz`; still hash-checked against the pin.",
            "name": "tgz-dir",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "Definitions indexed or materialised per release; an unread release is named with its reason.",
            "name": "definitions",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "fhir-core",
      "requirements": {
        "network": true,
        "runtime": [
          "bun"
        ]
      },
