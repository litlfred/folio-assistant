            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "The folio-assistant ref whose lock mounts the platform's layers. Default `main`.",
            "name": "index_ref",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          },
          {
            "description": "`lock` (the caller's lock pin of the tools layer) or a 40-hex commit.",
            "name": "tools_ref",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ],
        "outputs": [
          {
            "description": "The ready PR carrying the records, when anything was recorded.",
            "name": "pull_request",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
          },
          {
            "description": "The comment on the issue: what was recorded and what was refused.",
            "name": "summary",
