      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/merge-guard.jsonld",
      "@type": "cat-harness:Tool",
      "description": "The enforced merge guard: asks GitHub's live facts about one pull request whether it is finished (its checks, its tier, the session that marked it ready) before it reaches its base, and lands it only when every check passes. With `--status` it posts the verdict as the `merge-guard` commit status on the head, which is what the layer's merge-guard workflow does.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat merge:guard"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "The pull request number.",
            "name": "pr",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "arg": {
              "flag": "--repo"
            },
            "description": "The repository holding the pull request. Default: the checkout's own.",
            "name": "repo",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
          },
          {
            "arg": {
              "flag": "--merge"
            },
            "description": "Land the pull request, only if every check passes. Needs `--session`.",
            "name": "merge",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--status"
            },
            "description": "Post the verdict as the `merge-guard` commit status on the head.",
            "name": "status",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          },
          {
            "arg": {
              "flag": "--full-tier"
            },
            "description": "Require the full (release) tier of checks, not the fast tier a draft runs.",
            "name": "full_tier",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Each check with its verdict; exit 0 when the pull request may land.",
            "name": "verdict",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ]
      },
      "name": "merge-guard",
      "requirements": {
        "network": true,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/ci-health",
      "title": "Judge whether a pull request may land"
    }
