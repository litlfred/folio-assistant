      "@type": "cat-harness:Tool",
      "description": "Turn one translation-review issue into the recorded adjudication: read the `issues` event (never the body from a shell variable), refuse an author who is not an owner, member or collaborator, refuse an item whose catalogue hash changed since the page showed it, then write the translation node's sign-off, the fuzzy suggestions and an append-only `translation-qa` attestation, and leave a Markdown summary. Exit 0 recorded, 3 nothing recorded, 2 could not determine.",
      "install": {
        "none": true
      },
      "invoke": {
        "manual": true
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--root"
            },
            "description": "The layer root holding the catalogues. Default: the current directory.",
            "name": "root",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "The `issues` event file GitHub wrote. Absent: `$GITHUB_EVENT_PATH`, which is how the workflow passes it.",
            "name": "event",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/FilesystemPath"
          },
          {
            "arg": {
              "flag": "--dry-run"
            },
            "description": "Plan and report, write nothing.",
            "name": "dry_run",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "The files written: catalogues, translation nodes and attestations under the layer's translations and attestation directories.",
            "name": "records",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "What was recorded and what was refused, with each reason — the issue comment and the PR body.",
            "name": "summary",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ]
      },
      "name": "translation-adjudicate",
