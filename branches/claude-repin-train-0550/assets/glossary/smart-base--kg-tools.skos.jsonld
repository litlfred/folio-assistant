        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "DMN → L2-DMN knowledge graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the interior of one DMN decision table as the L2-DMN subgraph (`smart-base/L2-dmn/schemas/extract-dmn.ts`, ported from WHO smart-kg `tools/extract-dmn.mjs`): a `dmn-definitions` node and its decisions, decision tables, input and output clauses and rules, the `reads` edges to the data elements recovered from input expressions, the `citesSource` edges to the L1 citations each rule's reference column names, and the `invokedBy` edge to the BPMN task the `usingTask` href names. Pass `--bpmn` to resolve that task by name instead of recording it unresolved."
        }
      ],
      "skos:notation": "kg-extract-dmn",
      "dcterms:source": "smart-base/L2-dmn/tools/kg-extract-dmn/kg-extract-dmn.ts#kg-extract-dmn",
