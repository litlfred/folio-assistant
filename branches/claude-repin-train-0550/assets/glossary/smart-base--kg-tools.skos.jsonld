        }
      ],
      "skos:definition": [
        {
          "@value": "Scan the Publisher's `output/` for `{ResourceType}-{id}.json` and emit a Liquid include assigning `smart__<ResourceType>__<id>__<category>__<key>` for each published resource."
        }
      ],
      "skos:notation": "smart-liquid-variables",
      "dcterms:source": "smart-base/L3/tools/smart-liquid-variables/smart-liquid-variables.ts#smart-liquid-variables",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/terminology-lookup",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Reuse-first terminology and code-list lookup"
        }
      ],
      "skos:definition": [
        {
          "@value": "Look up a concept or code token for a semantic slot across the four reuse-first rungs of the `terminology-coding` methodology: (1) the target guide's `l1-scenario-vocabulary/v1`; (2) smart-base's generic personas (`DAK.Persona.*`), GRADE `code-lists/*.json` and the `guideline-domain` SKOS glossary; (3) local WHO/ILO FSH CodeSystems (`ISCO08`, `CDHIv2`, `CDHIv1`, `CDSCv2`, `KGTerminologySystem`); (4) a proposed `glossary-terms` candidate (`status: \"candidate\"`), or `could-not-determine` for `business-process`."
        }
      ],
      "skos:notation": "terminology-lookup",
      "dcterms:source": "smart-base/L3/tools/terminology-lookup/terminology-lookup.ts#terminology-lookup",
      "skos:note": "candidate"
    }
  ]
}
