      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/immz-schedule-app-local",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the immunization schedule-check app locally on a WHO or country IG"
        }
      ],
      "skos:definition": [
        {
          "@value": "Start litlfred/awho-mcp's schedule-check web form on this machine: a HAPI FHIR server in Docker, the WHO SMART Immunizations IG loaded, then optionally a country adaptation IG (its decision-logic tables replace WHO's; its country profile is generated from its `input/l2/dependencies.yaml`), the CQL cache warmed, and the form served. Both listen on 127.0.0.1. Unbuilt IGs are built with SUSHI first, and each Library's CQL is embedded from `input/cql/` as the IG Publisher would. A re-run reuses a server loaded from the same commits; `--down` stops both."
        }
      ],
      "skos:notation": "immz-schedule-app-local",
      "dcterms:source": "smart-base/L4/tools/immz-schedule-app-local/immz-schedule-app-local.ts#immz-schedule-app-local",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/kg-extract-bpmn",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "BPMN → L2-BPMN knowledge graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the interior of one BPMN file as the L2-BPMN subgraph (`smart-base/L2-bpmn/schemas/extract-bpmn.ts`, ported from WHO smart-kg `tools/extract-bpmn.mjs`): a `bpmn-definitions` node and its processes, participants, tasks, gateways, events, the `flowsTo`/`messageTo`/`contains` edges between them, and one `performedBy` edge from each pool to the persona its @name matches against the ActorDefinition titles under `--personas`. The output is a graph document whose `@context` is the l2-bpmn context and validates with the engine's `check()`."
        }
      ],
      "skos:notation": "kg-extract-bpmn",
      "dcterms:source": "smart-base/L2-bpmn/tools/kg-extract-bpmn/kg-extract-bpmn.ts#kg-extract-bpmn",
      "skos:note": "candidate"
    },
    {
