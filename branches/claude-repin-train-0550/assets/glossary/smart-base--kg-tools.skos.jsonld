      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "DMN reference column → L1 citations"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the L1 citations from a DMN decision table's reference column (`smart-base/L2-dmn/schemas/extract-citations.ts`, ported from WHO smart-kg `tools/extract-citations.mjs`): one `external-artifact` node for the table and one `citation` node per distinct reference string, each left `unresolved`, with `appearsIn` edges and a coverage report of how many rules cite an L1 source. A citation string is content-addressed in the DAK's namespace, so the same string is one node here and in the L2-DMN graph's `citesSource` edges. The output is an L2 document."
        }
      ],
      "skos:notation": "kg-extract-citations",
      "dcterms:source": "smart-base/L2-dmn/tools/kg-extract-citations/kg-extract-citations.ts#kg-extract-citations",
      "skos:note": "candidate"
    },
