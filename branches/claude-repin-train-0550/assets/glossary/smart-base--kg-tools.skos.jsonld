    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/l1-extraction-pages",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "L1 extraction viewer: a hub and a page per instance with `l1-extraction` directories"
        }
      ],
      "skos:definition": [
        {
          "@value": "For every visualiser an instance declares with `renderedBy: l1-extraction-pages`, write the hub at `<locale>/<harness>/<id>/` and, with `subgraphs: \"instance\"`, one page per instance that declares an `l1-extraction` directory. Each page shows, from what the files declare: the L1 statements (graph nodes with a `statement`, and an authored L1 source's `recommendations`); the candidate work list's counts, coverage and decisions; each graph document's nodes by type and edges by predicate (L2 scenario candidates included); counts of curation, mapping, vocabulary, exclusions and run context; and a link from every file to its published copy (cat-harness's `library:viz`), when the site has it, and to its source at the pinned commit. A declared directory not on disk is reported UNKNOWN, never zero."
        }
      ],
      "skos:notation": "l1-extraction-pages",
      "dcterms:source": "smart-base/tools/l1-extraction-pages/l1-extraction-pages.ts#l1-extraction-pages",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/l1-recommendation-candidates",
