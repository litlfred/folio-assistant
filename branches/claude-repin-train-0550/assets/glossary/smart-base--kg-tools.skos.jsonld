      "skos:prefLabel": [
        {
          "@value": "L1 extraction → statement lists"
        }
      ],
      "skos:definition": [
        {
          "@value": "The smart-base collector for core's `publish-extracted-statements` step: an `l1-extraction` directory's authored L1 sources (`recommendations:` rows) and scenario-candidate graphs (`user-scenario` nodes whose `evidence.location` names a row), written as `folio-extracted-statements/v1` lists, each statement with the library entry its L1 source names and the page it was read from. Core's `statements:pages` then renders them with links to the entry and section."
        }
      ],
      "skos:notation": "l1-statement-lists",
      "dcterms:source": "smart-base/L1/tools/l1-statement-lists/l1-statement-lists.ts#l1-statement-lists",
