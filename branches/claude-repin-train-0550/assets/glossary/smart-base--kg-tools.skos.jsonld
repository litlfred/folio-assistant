      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/bpmn-validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "BPMN structure, vendor namespaces and lane → actor"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check a DAK's BPMN (`validate.ts` beside this file; bean folio-assistant-tgaj, which replaced four Python validators with it): well-formed XML whose root is `<bpmn:definitions>`, no Camunda or Zeebe namespace, no duplicate id, at least one process, no bpmn-moddle (bpmn-js) import warning; every process has a `<laneSet>`, every flow node sits in a lane, and lane ids are unique and valid FSH ids; and every innermost lane names its actor by id: its `partitionElementRef` (a top-level `<bpmn:resource>`), else its own id, matched exactly against the `Instance:` ids of the ActorDefinitions in the IG's FSH (or JSON) and, for a harness process, the role ids of the mounted layers' `scenarios/roles.json`. Never by file name or title. With no file named it reads the declared process directories, `smart-base/**/processes/` and an IG's `input/bpmn/`."
        }
      ],
      "skos:notation": "bpmn-validate",
      "dcterms:source": "smart-base/L2-bpmn/tools/bpmn-validate/bpmn-validate.ts#bpmn-validate",
