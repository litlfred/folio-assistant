      "skos:prefLabel": [
        {
          "@value": "DAK spreadsheets → DMN, PlanDefinitions, CQL, requirements, logical models"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run WHO's `extract_dak.py` in a DAK or IG repository. It reads the DAK template spreadsheets (`input/decision-logic/*.xlsx` via `dt_extractor`, `input/system-requirements/*.xlsx` via `req_extractor`, `input/dictionary/*.xlsx` via `dd_extractor`) and the BPMN, and writes DMN decision tables, CPG recommendation PlanDefinitions with citations, CQL library skeletons, Requirements and logical-model FSH. Per the WHO IG Starter Kit (`l3_decisiontables`, `l3_cql`), an adapted decision or scheduling table is an edited copy of the upstream DAK's spreadsheet, never a parallel format."
        }
      ],
      "skos:notation": "extract-dak",
      "dcterms:source": "smart-base/L2/tools/extract-dak/extract-dak.ts#extract-dak",
      "skos:note": "candidate"
    },
