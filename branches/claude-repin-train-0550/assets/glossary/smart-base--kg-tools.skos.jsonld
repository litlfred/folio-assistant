      },
      "skos:prefLabel": [
        {
          "@value": "FHIR IG → L3 knowledge graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the L3 index from a SMART Guidelines IG's source tree (`smart-base/L3/schemas/extract-l3.ts`, ported from WHO smart-kg `tools/extract-l3.mjs`): one thin node per FHIR artefact (PlanDefinition, ActivityDefinition, Library, Measure, Questionnaire, StructureMap/Definition, ValueSet, CodeSystem, ConceptMap, ActorDefinition, Requirements, CQL) read from FSH, FML and JSON with RuleSets expanded, the real `uses` and `citesSource` canonical references, and the `implementedBy` edges that tie each artefact to the L2 component its Title names by the SOP's id convention. Coverage is reported across every artefact type."
        }
      ],
      "skos:notation": "kg-extract-l3",
      "dcterms:source": "smart-base/L3/tools/kg-extract-l3/kg-extract-l3.ts#kg-extract-l3",
