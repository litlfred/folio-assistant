      "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools/kg-extract-dak",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns/glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "dak.json + FSH tree → L2 DAK component graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract the DAK component layer (L2) from a smart-base-shaped IG (`smart-base/L2/schemas/extract-dak.ts`, ported from WHO smart-kg `tools/extract-dak.mjs`): a `dak` node from dak.json, a `persona` node per ActorDefinition, a `functional`/`non-functional-requirement` node per requirement instance with its `requirement-statement`s, the `hasComponent`/`hasStatement` edges, and the `fulfilledBy` edges that resolve each requirement's `actor = Canonical(...)` against a persona's instance id. Coverage is reported across all nine DAK components, including the empty ones, and files present with no component declaring them are listed. Distinct from the existing `extract-dak` tool (WHO's spreadsheet extractor)."
        }
      ],
      "skos:notation": "kg-extract-dak",
      "dcterms:source": "smart-base/L2/tools/kg-extract-dak/kg-extract-dak.ts#kg-extract-dak",
