      },
      "skos:prefLabel": [
        {
          "@value": "Render PDF and HTML"
        }
      ],
      "skos:definition": [
        {
          "@value": "Typeset the paper through LaTeX to PDF and HTML. Run `latex-preflight` first to catch compile-breaking source patterns before a full compile. The preamble, class and macros belong to the folio, never to the platform."
        }
      ],
      "skos:notation": "Task_Render",
      "dcterms:source": "folio-assistant-sci/collab/processes/content/authoring-a-paper.bpmn#Task_Render",
      "skos:note": "candidate"
    },
