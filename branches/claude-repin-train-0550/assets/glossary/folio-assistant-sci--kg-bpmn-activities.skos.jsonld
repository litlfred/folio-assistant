        {
          "@value": "Author blocks"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every block edit runs the HCI validation gate — see editing-hci-validation.bpmn."
        }
      ],
      "skos:notation": "Task_AuthorBlocks",
      "dcterms:source": "folio-assistant-sci/collab/processes/content/authoring-a-paper.bpmn#Task_AuthorBlocks",
      "skos:note": "candidate"
    },
