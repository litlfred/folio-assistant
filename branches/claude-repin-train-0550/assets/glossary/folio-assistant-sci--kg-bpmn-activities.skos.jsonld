      },
      "skos:prefLabel": [
        {
          "@value": "Plan the paper"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scope the paper: chapters, the blocks each needs, what gets formalised."
        }
      ],
      "skos:notation": "Task_Plan",
      "dcterms:source": "folio-assistant-sci/collab/processes/content/authoring-a-paper.bpmn#Task_Plan",
      "skos:note": "candidate"
    },
