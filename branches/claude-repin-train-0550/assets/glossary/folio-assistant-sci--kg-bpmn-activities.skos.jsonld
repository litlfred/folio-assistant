      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant-sci/v0/ns/glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review and publish"
        }
      ],
      "skos:definition": [
        {
          "@value": "Core's shared review-and-publish process (Process_FolioReviewPublish): the reviewer reads the rendered folio and approves it, asks for changes, or sends a working draft to the Authoring Committee."
        }
      ],
      "skos:notation": "Call_ReviewPublish",
      "dcterms:source": "folio-assistant-sci/collab/processes/content/authoring-a-paper.bpmn#Call_ReviewPublish",
