      },
      "skos:prefLabel": [
        {
          "@value": "Seed the work plan"
        }
      ],
      "skos:definition": [
        {
          "@value": "The plan becomes beans, so a resumed session or a sibling agent can pick it up."
        }
      ],
      "skos:notation": "Task_SeedPlan",
      "dcterms:source": "folio-assistant-sci/collab/processes/content/authoring-a-paper.bpmn#Task_SeedPlan",
