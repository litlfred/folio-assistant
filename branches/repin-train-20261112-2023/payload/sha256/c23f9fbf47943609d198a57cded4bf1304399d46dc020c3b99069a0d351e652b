      "narrative": null,
      "content": "L’OMS RECOMMANDE QUE DES APPROCHES \nDE DÉPISTAGE DU VIH QUI S’APPUIENT \nSUR LES RÉSEAUX SOCIAUX SOIENT \nOFFERTES AUX POPULATIONS CLÉS, DANS \nLE CADRE D’UN DISPOSITIF DE SERVICES \nAUX PARTENAIRES",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
