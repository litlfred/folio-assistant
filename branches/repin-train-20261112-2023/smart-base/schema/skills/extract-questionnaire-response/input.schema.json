{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Extract Questionnaire Response Input",
  "type": "object",
  "required": [
    "questionnaireResponse",
    "questionnaire"
  ],
  "properties": {
    "questionnaireResponse": {
      "type": "object",
      "required": [
        "resourceType"
      ],
      "properties": {
        "resourceType": {
          "const": "QuestionnaireResponse"
        },
        "questionnaire": {
          "type": "string",
          "description": "The Questionnaire's canonical, url|version."
        },
        "status": {
          "enum": [
            "in-progress",
            "completed",
            "amended",
            "entered-in-error",
            "stopped"
          ]
        }
      },
      "description": "The completed response."
    },
    "questionnaire": {
      "type": "object",
      "required": [
        "resourceType"
      ],
      "properties": {
        "resourceType": {
          "const": "Questionnaire"
        },
        "url": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "description": "A FHIR R4 Questionnaire (https://hl7.org/fhir/R4/questionnaire.html) conforming to an SDC profile (https://hl7.org/fhir/uv/sdc/), with its canonical url and version."
    }
  },
  "additionalProperties": false,
  "$id": "http://smart.who.int/base/schema/skills/extract-questionnaire-response/input.schema.json",
