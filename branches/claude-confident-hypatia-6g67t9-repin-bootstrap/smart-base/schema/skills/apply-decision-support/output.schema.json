{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Apply Decision Support Output",
  "description": "The proposal. Every request in it is status draft, intent proposal; none is in the client's record.",
  "type": "object",
  "properties": {
    "requestGroup": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "resourceType"
          ],
          "properties": {
            "resourceType": {
              "const": "RequestGroup"
            }
          },
          "description": "FHIR R4 RequestGroup (https://hl7.org/fhir/R4/requestgroup.html): the proposed actions, each request a draft proposal."
        },
        {
          "type": "object",
          "required": [
            "resourceType"
          ],
          "properties": {
            "resourceType": {
              "const": "RequestOrchestration"
            }
          },
          "description": "FHIR R5 RequestOrchestration (https://hl7.org/fhir/R5/requestorchestration.html), RequestGroup's R5 name."
        }
      ]
    },
    "cards": {
      "type": "array",
      "description": "CDS Hooks 2.0 cards (https://cds-hooks.hl7.org/2.0/#card-attributes), when the guidance came from a CDS service.",
      "items": {
        "type": "object",
        "required": [
          "summary",
          "indicator",
          "source"
        ],
        "properties": {
          "uuid": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "indicator": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "source": {
            "type": "object"
          },
          "suggestions": {
            "type": "array"
          }
        }
      }
    }
  },
  "minProperties": 1,
  "additionalProperties": false,
  "$id": "http://smart.who.int/base/schema/skills/apply-decision-support/output.schema.json",
  "staging": {
    "branch": "claude/confident-hypatia-6g67t9-repin-bootstrap",
    "sha": "c404c705e6bb8bf0bf6561f1782a82a79506f9b5",
    "pr": "3012/merge",
    "run": "42388469519"
  }
}
