    {
      "id": "library/10665-325892/blocks/prose-sec-005",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "\u0007Box 3: A woman-centred approach",
      "pageStart": 5,
      "pageEnd": 6,
      "target": "../sections/sec-005-box-3-a-woman-centred-approach.md",
      "narrative": null,
      "content": "Woman-centred health services involve an \napproach to health care that consciously adopts \nthe perspectives of women and their families and \ncommunities. This means that health services see \nwomen as active participants in and beneficiaries \nof trusted health systems that respond to women’s \nneeds, rights and preferences in humane and  \nholistic ways (with no coercion). Care is provided  \nin ways that respect a woman’s autonomy in \ndecision-making about her health, and services  \nmust provide information and options to enable \nwomen to make informed choices. The needs and \nperspectives of wome",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Describes a woman-centred, human rights-based approach to antiretroviral therapy that respects women's autonomy and informed choice. It then covers DTG approval and formulations for children, raltegravir as an option from birth, and the need for twice-daily DTG in people with HIV and TB on rifampicin.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
