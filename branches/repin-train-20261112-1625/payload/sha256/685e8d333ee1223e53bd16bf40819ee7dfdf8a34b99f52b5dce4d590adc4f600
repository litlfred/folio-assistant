    {
      "id": "library/10665-325892/blocks/prose-sec-006",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "EFV 400 mg in first-line ART",
      "pageStart": 6,
      "pageEnd": 8,
      "target": "../sections/sec-006-efv-400-mg-in-first-line-art.md",
      "narrative": null,
      "content": "The updated systematic review found that EFV 400 mg is \nbetter tolerated than EFV in standard dose (EFV 600 mg), with \nlower risk of treatment discontinuation and severe treatment-\nrelated adverse events. Regimens containing EFV 400 mg and \nEFV 600 mg were comparable for viral suppression, mortality \nand mental and nervous system adverse events.\nEFV 400 mg is available in a smaller pill size and can \npotentially reduce treatment costs compared with EFV 600 \nmg; both are available as generic fixed-dose combinations.\nEFV 400 mg is expected to be safe for pregnant women \nto use, like EFV 600 mg.",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Reviews evidence showing efavirenz 400 mg is better tolerated than the 600 mg dose, with similar viral suppression, lower cost and expected safety in pregnancy. It discusses limited data on its use with rifampicin-based TB treatment and its pharmacokinetics in pregnancy. It then introduces the review of DTG for people whose non-DTG first-line regimen has failed, finding DTG generally outperforms protease-inhibitor-based second-line therapy on safety and efficacy.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
