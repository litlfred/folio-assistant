    {
      "id": "library/10665-325892/blocks/prose-sec-007",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "DTG in second-line ART",
      "pageStart": 8,
      "pageEnd": 9,
      "target": "../sections/sec-007-dtg-in-second-line-art.md",
      "narrative": null,
      "content": "Taken together with other advantages, including lower \ncost, less potential for drug–drug interactions, lower \npill burden and availability in once-daily fixed-dose \ncombinations, DTG is recommended as the preferred ARV \ndrug for second-line ART among adults, adolescents and \nchildren for whom a non-DTG-based first-line regimen has \nfailed. For those taking a first-line regimen containing DTG \nthat has failed, a boosted PI-containing regimen should be \nused (Table 2).\nTable 2. Preferred and alternative second-line ART regimens\nPopulation\nFailing first-line regimen\nPreferred second-line regimen",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Recommends DTG as the preferred second-line drug for adults, adolescents and children failing non-DTG first-line regimens, and a boosted protease inhibitor for those failing DTG-based first-line therapy. Table 2 lists preferred and alternative second-line regimens by population and failing regimen, with footnotes on dosing and use in children.",
        "state": "draft",
