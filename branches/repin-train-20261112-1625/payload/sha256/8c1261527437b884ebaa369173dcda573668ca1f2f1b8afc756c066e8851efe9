    {
      "id": "library/10665-340190/blocks/prose-sec-008",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "\u0003Guiding principles",
      "pageStart": 18,
      "pageEnd": 19,
      "target": "../sections/sec-008-14-guiding-principles.md",
      "narrative": null,
      "content": "The following principles have informed the development of these guidelines and should guide \nthe implementation of the recommendations.\n•\tThe guidelines should contribute to and expedite the achievement of key global and national \nHIV goals for 2016–2021 (11), contribute to the new Global Programme of Work – Triple-Billion \ninitiative – as part of the Global Public Health Goods 1.1.2 and to realizing the Sustainable \nDevelopment Goals (12).\n•\tThe guidelines are based on a public health approach to scaling up the use of ARV drugs \nalong the continuum of HIV prevention, treatment and care.\n1 Int",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Lists the guiding principles behind the guidelines, such as a public health approach to scaling up antiretroviral drugs and the involvement of people living with HIV. Others include strengthening wider health systems, protecting human rights and gender equity, and adapting to local context.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
