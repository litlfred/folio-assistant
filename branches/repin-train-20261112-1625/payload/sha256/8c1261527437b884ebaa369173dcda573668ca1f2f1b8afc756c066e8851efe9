      ],
      "kind": "prose",
      "title": "\u0003Objectives",
      "pageStart": 18,
      "pageEnd": 18,
      "target": "../sections/sec-006-12-objectives.md",
      "narrative": null,
      "content": "These guidelines are intended to contribute to the 13th WHO Global Programme of Work – \nTriple-Billion initiative – as part of the Global Public Health Goods 1.1.2 as well as the objective \nto meet targets set out in the Sustainable Development Goal 3 to end of AIDS by 2030.",
      "truncated": false,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "States that the guidelines aim to contribute to WHO's 13th General Programme of Work and the goal of ending AIDS by 2030.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
