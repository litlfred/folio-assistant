    {
      "id": "library/10665-357088/blocks/prose-sec-030",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "\u0007\u0007IMPLEMENTATION CONSIDERATIONS",
      "pageStart": 36,
      "pageEnd": 38,
      "target": "../sections/sec-030-4-implementation-considerations.md",
      "narrative": null,
      "content": "Diagnosis\nDiagnosis is key to improving mortality from cryptococcal disease, and national programmes \nneed to give priority to reliable access to rapid diagnostic cryptococcal antigen assays, \npreferably lateral flow assays for use in CSF and serum or plasma. In addition, health-care \nprofessionals need to have a low threshold for suspecting cryptococcal meningitis.\nCountries should develop plans to improve access to rapid cryptococcal antigen assays, \ndepending on the cryptococcal burden. Health-care infrastructure and available resources will \ndetermine the comprehensiveness of access.\nThe r",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Discusses practical issues in implementing the guidelines, including access to rapid antigen assays, laboratory reflex screening and task sharing. It also covers access to essential antifungal medicines, especially flucytosine and liposomal amphotericin B, and adapting the toxicity monitoring package to available resources.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
