    {
      "id": "library/10665-357088/blocks/prose-sec-021",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Rationale for the recommendations",
      "pageStart": 30,
      "pageEnd": 31,
      "target": "../sections/sec-021-351-rationale-for-the-recommendations.md",
      "narrative": null,
      "content": "WHO recommends fluconazole at 800 mg/day for eight weeks following an amphotericin B \ndeoxycholate–based induction regimen; these recommendations were based primarily on \nexpert opinion, considering the limited evidence from two trials that compared itraconazole \nversus fluconazole at lower doses (48,49). Recent guidelines from the European AIDS Clinical \nSociety recommend 400 mg for eight weeks after a single loading dose of 800 mg on the first \nday of therapy (50). Maintenance or secondary prophylaxis until there is evidence of sustained \nART-related immune reconstitution is an integral part",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Explains the evidence behind fluconazole consolidation and maintenance doses and its role in preventing relapse. It also suggests expert-opinion regimens for localized non-meningeal disease, cryptococcomas and disseminated disease.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
