    {
      "id": "library/10665-357088/blocks/prose-sec-022",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Treatment for pregnant women",
      "pageStart": 31,
      "pageEnd": 31,
      "target": "../sections/sec-022-37-treatment-for-pregnant-women.md",
      "narrative": null,
      "content": "Amphotericin B therapy can be given to pregnant women with meningeal and non-meningeal \ndisease when the benefits outweigh the harm. Liposomal amphotericin B is considered as a \npregnancy category B drug and although animal reproduction studies have failed to demonstrate \na risk, an increase in spontaneous abortions was noted at higher doses. Exposure to flucytosine \nand fluconazole during pregnancy has been associated with an increased risk of birth defects in \nanimal studies and some uncontrolled human studies (60). The use of flucytosine and fluconazole \nfor treating cryptococcal disease am",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Advises that amphotericin B may be given in pregnancy when benefits outweigh harm, while flucytosine and fluconazole use should be judged case by case because of possible birth defects.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
