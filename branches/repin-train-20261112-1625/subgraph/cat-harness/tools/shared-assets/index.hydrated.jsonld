      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/shared-assets.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Write each shared directory of a built site (its `assets/…` laid out as a built site) to `<out>/shared/<dir>/<key>/` with a `.shared.json`, so sites on one host load one copy instead of one each. A directory already there is left alone. This is the host side of the shared-assets step `build-instance-site` runs when a checkout declares `site.sharedAssets`; run on its own, it stages an IG build, or any built site, into a host site root.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat site:shared-assets stage"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--site"
            },
            "description": "A directory laid out as a built site, holding `assets/…`.",
            "name": "site",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--out"
            },
            "description": "The host site root the shared directories are written under.",
            "name": "out",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ],
        "outputs": [
          {
            "description": "One line per shared directory: `staged` or `already there`, with its path under `shared/`.",
            "name": "staged",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "shared-assets",
      "requirements": {
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/docs-generation",
      "title": "Stage a site's shared asset directories where the host serves them"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
