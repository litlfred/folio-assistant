{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Decision Support Guidance Output",
  "description": "One decision per action; one tap each, nothing else required.",
  "type": "object",
  "required": [
    "decisions"
  ],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action",
          "outcome",
          "by",
          "at"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "The RequestGroup action id, or the CDS Hooks card uuid (and suggestion uuid)."
          },
          "outcome": {
            "enum": [
              "accepted",
              "declined",
              "modified"
            ],
            "description": "An action the health worker did not touch is declined."
          },
          "modified": {
            "type": "object",
            "description": "The changed request resource; only with outcome modified."
          },
          "by": {
            "type": "object",
            "description": "A FHIR R4 Reference (https://hl7.org/fhir/R4/references.html).",
            "properties": {
              "reference": {
                "type": "string"
              },
              "display": {
                "type": "string"
              }
            }
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "addReason": {
      "type": "boolean",
      "default": false,
      "description": "True only when the health worker tapped \"add a reason\" while reviewing, which is Event_AddReason, the non-interrupting boundary event on the review. False, the default, skips record-decision-rationale."
    }
  },
  "additionalProperties": false,
  "$id": "http://smart.who.int/base/schema/skills/review-decision-support-guidance/output.schema.json",
  "staging": {
    "branch": "repin-train/20261113-1424",
    "sha": "115a5947a46455b9bc4e115d78b6ae989c29c054",
    "pr": "3111/merge",
    "run": "43447091019"
  }
}
