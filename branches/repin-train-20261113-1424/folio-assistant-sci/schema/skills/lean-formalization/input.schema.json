  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lean Formalization Input",
  "description": "Input schema for the lean-formalization skill. Describes source material to be formalized in Lean 4.",
  "type": "object",
  "required": [
    "sourceFile",
    "targetModule"
  ],
  "properties": {
    "sourceFile": {
      "type": "string",
