    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/digital-health",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "digital health",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The systematic application of information and communications technologies, computer science and data to support informed decision-making by individuals, the health workforce and health systems, to strengthen resilience to disease and improve health and wellness (1, 2).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L14",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/digital-health-supply-chain-intervention",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "digital health supply chain intervention",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "An intervention that involves the use of digital technologies to improve the management and operation of health supply chains. It aims to enhance the efficiency and effectiveness of health supply chain processes such as planning, procurement, distribution and warehouse management.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L18",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/digital-transformation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "digital transformation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the health context, using digital technologies to fundamentally change and improve how health services are delivered and accessed across all health programme areas (3, 4, 5). The process involves using innovation, analytics and feedback mechanisms to achieve systems-level changes.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L24",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/digitalization",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "digitalization",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the health context, the process of digitally automating and simplifying processes to streamline individual health programmes and reduce manual efforts for greater efficiency. Digitalization is the second step in digital transformation (3, 6).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L29",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/digitization",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "digitization",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of converting and organizing data from manual paper records into a digital format for easier entry, storage and retrieval. Digitization is the initial step in digital transformation (3, 7).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L33",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/end-users",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "end users",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "People who will be using the digital systems.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L36",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/enterprise-architecture",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "enterprise architecture",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A blueprint of business processes, data, systems and technologies that helps planners, software developers and managers design increasingly complex systems to support the workflow and roles of people in a large enterprise such as a health system (1).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L38",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/features",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "features",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The characteristics of a system that include look and feel as well as what the system can do (e.g., “order processing” can be a feature of an order management solution).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L43",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/functional-requirements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "functional requirements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A description of what the digital system needs to do to support the tasks that make up the business process and address the identified challenges.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L46",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/functions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "functions",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Business processes within a system that help the system perform (e.g., “receiving inventory” and “picking inventory” are functions of the “warehousing” feature of a warehouse management system).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L50",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/health-supply-chain-information-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "health supply chain information system",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A paper-based or software tool that supports the management and/or operations of the health supply chain. Such software tools (e.g., for order management or warehouse management) are also commonly referred to as electronic logistics management information systems.",
          "@language": "en"
        }
      ],
      "skos:notation": "HSCIS",
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L54",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/interoperability",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "interoperability",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ability of different applications to access, exchange, integrate and use data in a coordinated and consistent manner, through the use of shared application interfaces, value sets, concepts and standards within and across organizational, regional and national boundaries. In the health context, this provides timely, safe and seamless portability of information to help ensure good health outcomes (1).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L59",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/nonfunctional-requirements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "nonfunctional requirements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A description of how the digital system needs to operate and perform in order to support the tasks that make up the business process.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L65",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/open-source-software",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "open-source software",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Software with source code that is published and made freely available to the public so anyone can inspect, modify and enhance the code within set guidelines (8). While the source code is open to everyone, the implementation of the software is not necessarily without costs. Open-source software must have a license approved by the Open Source Initiative (9).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L69",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/open-standards",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "open standards",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Standards that are documented and made freely available to the public. Open standards are developed, approved and maintained via a collaborative and consensus-driven process. Open standards facilitate interoperability and data exchange and are intended for widespread adoption (10).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L74",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/order-management",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "order management",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The planning, directing, monitoring and controlling of the processes related to customer or requisition orders. Order management includes order promising; order entry; order pick, pack and ship; billing; and reconciliation of the customer account (11).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L79",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/order-management-system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "order management system",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A paper-based or software tool that supports the processes for fulfilling requisition orders (e.g., a software tool that supports entry and processing of requisition orders from health facilities to regional or central warehouses to replenish inventory).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L83",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/organogram",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "organogram",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A visual representation of an organization’s structure that shows the hierarchy of various roles and reporting relationships.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L88",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/registry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "registry",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A governed, authoritative and centralized information system that captures, stores and maintains the unique attributes and identifiers of health facilities, health service users, health products and/or the health workforce using a predefined canonical minimum data set.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L91",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/smart-guidelines",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "SMART Guidelines",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The WHO guidelines for developing Standards-based, Machine-readable, Adaptive, Requirements-based and Testable components for implementing digital health capabilities. The components include interoperability standards, code libraries, algorithms, and technical and operational specifications. The SMART Guidelines provide a five-step pathway to advance the adoption of best clinical and data practices, even if a country is not yet fully digital (12, 13).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L95",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/stakeholder",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "stakeholder",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "In the context of digital health transformation, anyone who is affected by or interested in the consequences of the efforts, including the planning team, end users, beneficiaries and funders.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L101",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/systems-architecture",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "systems architecture",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A technical framework based on a conceptual model that defines how the system should be structured and how its elements should be connected.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240101197-eng/sections/sec-002-glossary.md#L104",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng/total-cost-of-ownership",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240101197-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "total cost of ownership",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The resources required to support a digital health intervention throughout its life cycle.",
          "@language": "en"
        }
