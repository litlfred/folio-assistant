    {
      "id": "library/10665-42458/blocks/prose-sec-001",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "EXECUTIVE SUMMARY",
      "pageStart": 6,
      "pageEnd": 8,
      "target": "../sections/sec-001-executive-summary.md",
      "narrative": null,
      "content": "Herpes simplex virus type 2 (HSV2) infection is the primary cause of genital herpes. It is\nhighly prevalent in human populations in many parts of the world, and is the most\ncommon cause of genital ulcer disease worldwide.\nIn developing countries, the major public health importance of HSV2 relates to its\npotential role in facilitating HIV transmission. HSV2 is highly prevalent in most regions\nexperiencing severe HIV epidemics, with infection rates rising steeply with age to reach\nlevels of 70% or more among adult women and men in some African countries. Genital\nulcer disease enhances the infect",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Summarises the report, explaining that HSV2 is the main cause of genital ulcer disease, is very common where HIV epidemics are severe, and may facilitate HIV transmission in a two-way interaction. It notes that the workshop reviewed evidence and set priorities across epidemiology, HSV2–HIV interaction, therapy, vaccines and behavioural and microbicide studies.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
