    {
      "id": "library/10665-196326/blocks/prose-sec-002",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Introduction",
      "pageStart": 11,
      "pageEnd": 14,
      "target": "../sections/sec-002-introduction.md",
      "narrative": null,
      "content": "Epidemics, emergencies and disasters raise many ethical issues for the people involved, who include \nresponders, public health specialists and policy‑makers. This training manual provides material on ethical \nissues in research, surveillance and patient care in these difficult contexts, as well as related issues to reduce \nrisks before, during and after events.\nThe idea for this manual can be traced back to a  WHO technical consultation on Research ethics in \ninternational epidemic response (World Health Organization, 2010). In the resulting report, the experts took \npositions on three main is",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Introduces the manual's aim of providing training material on ethics in research, surveillance and patient care during epidemics, emergencies and disasters. It recalls the 2009 WHO consultation's positions on upholding ethics guidelines, the blurred line between practice and research, and adapting ethics oversight. It also explains how emergencies and disasters are understood, including natural and human-induced hazards, and ends with references.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
