{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { bash .github/mount-from-lock.sh --root . >/dev/null 2>&1; bun install --frozen-lockfile >/dev/null 2>&1; bash cat-harness-tools/scripts/session-start-coord-sweep.sh; }",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/cat-harness-tools/scripts/ask-well.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run \"$CLAUDE_PROJECT_DIR/cat-harness-tools/scripts/decisions-named-not-asked.ts\""
          }
        ]
      }
    ]
  }
}
