  "narrative": [
    {
      "text": "A line chart titled \"EPI: Functional refrigerators by orgunit - last 12 months\" (cold chain refrigerator functional), November 2015 to October 2016. Animal Region stays between 231 and 240 functional refrigerators each month; Food Region stays between 119 and 122. Both lines are nearly flat.",
      "lang": "en",
      "state": "draft",
