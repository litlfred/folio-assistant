# French translation of the knowledge-graph viewer's interface.
# Source: scripts/kg-viewer-strings.ts (the generator's string table, NOT the
# generated page). Produced by an agent and NOT reviewed by a person, which is
# what X-Folio-Official says and what the page tells the reader.
#
# The graph's own words — node names, descriptions, property names — are not
# covered here and cannot be: they come from the corpus.
msgid ""
msgstr ""
"Project-Id-Version: kg-viewer\n"
"POT-Creation-Date: 2026-09-19 05:46+0000\n"
"PO-Revision-Date: 2026-09-19 05:46+0000\n"
"Last-Translator: folio-assistant agent\n"
"Language-Team: French\n"
"Language: fr\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Folio-Official: no\n"
"X-Generator: folio-assistant translate-kg-viewer\n"

#: scripts/kg-viewer-strings.ts:168
#. Last row of the list when there are more results than are drawn. {n} is a number.
msgid "… and {n} more; narrow the search."
msgstr "… et {n} de plus ; affinez la recherche."

#: scripts/kg-viewer-strings.ts:76
#. Appended to the heading when the graph document is a staged preview rather than the published one.
msgid "(preview)"
msgstr "(aperçu)"

#: scripts/kg-viewer-strings.ts:122
#. Node count under the heading. {n} is a number, and is 1 or more.
msgid "{n} nodes"
msgstr "{n} nœuds"

#: scripts/kg-viewer-strings.ts:160
#. Announced when the search or filter changes the list. {n} is 0 or 2 and above.
msgid "{n} nodes match"
msgstr "{n} nœuds correspondent"

#: scripts/kg-viewer-strings.ts:178
#. First half of the warning above a node's properties, shown in bold. @context is a JSON-LD keyword and is never translated. {n} is a number.
msgid "{n} of this node's properties are not in the @context"
msgstr "{n} propriétés de ce nœud ne figurent pas dans le @context"

#: scripts/kg-viewer-strings.ts:68
#. Page title and heading. {stub} is the repository's own name and is never translated.
msgid "{stub} — knowledge graph"
msgstr "{stub} — graphe de connaissances"

#: scripts/kg-viewer-strings.ts:190
#. Row label listing the nodes that point AT this one. Flip the arrow if the language reads right to left.
msgid "← referenced by"
msgstr "← référencé par"

#: scripts/kg-viewer-strings.ts:156
#. Announced when the search or filter leaves exactly one node.
msgid "1 node matches"
msgstr "1 nœud correspond"

#: scripts/kg-viewer-strings.ts:84
#. The filter that selects every node, shown above the individual kinds.
msgid "All"
msgstr "Tous"

#: scripts/kg-viewer-strings.ts:126
#. The commit the graph was generated from. {sha} is an abbreviated hexadecimal commit id.
msgid "commit {sha}"
msgstr "commit {sha}"

#: scripts/kg-viewer-strings.ts:146
#. Replaces the provenance line when the graph document could not be fetched. {doc} is a filename, {error} the browser's own message.
msgid "could not load {doc} — {error}"
msgstr "impossible de charger {doc} — {error}"

#: scripts/kg-viewer-strings.ts:138
#. Accessible name of that link. The visible text is only the format, so the name has to say what it gets you and from where. {doc} is a filename.
msgid "Download this graph as JSON-LD ({doc})"
msgstr "Télécharger ce graphe au format JSON-LD ({doc})"

#: scripts/kg-viewer-strings.ts:108
#. Accessible name of the language switcher — the group of buttons, not one of them. The buttons themselves carry each language's own name and are not translated.
msgid "Interface language"
msgstr "Langue de l'interface"

#: scripts/kg-viewer-strings.ts:112
#. Announced to a screen reader after the language changes. {language} is the new language's name in its own language.
msgid "Interface language: {language}"
msgstr "Langue de l'interface : {language}"

#: scripts/kg-viewer-strings.ts:30
#. Link text for the graph document itself. A format name — leave it as-is unless the language writes it differently.
msgid "JSON-LD"
msgstr "JSON-LD"

#: scripts/kg-viewer-strings.ts:80
#. Heading of the filter column. The kinds are node types (Tool, ProcessNode, …) and come from the graph, so they are not translated.
msgid "Kind"
msgstr "Type"

#: scripts/kg-viewer-strings.ts:210
#. Accessible name of one neighbour in the diagram. {name} is a node's name from the graph and {via} the property that links to it — both stay in the graph's language.
msgid "Links to {name} via {via}"
msgstr "Pointe vers {name} via {via}"

#: scripts/kg-viewer-strings.ts:118
#. Shown under the heading while the graph document is being fetched. {doc} is a filename.
msgid "loading {doc}…"
msgstr "chargement de {doc}…"

#: scripts/kg-viewer-strings.ts:198
#. Shown in place of the neighbourhood diagram for an isolated node.
msgid "No links to or from this node."
msgstr "Aucun lien vers ou depuis ce nœud."

#: scripts/kg-viewer-strings.ts:164
#. Shown in place of the list when nothing matches.
msgid "No node matches."
msgstr "Aucun nœud ne correspond."

#: scripts/kg-viewer-strings.ts:174
#. Shown when a followed link names a node the document does not contain.
msgid "No such node."
msgstr "Nœud introuvable."

#: scripts/kg-viewer-strings.ts:88
#. Heading of the result list.
msgid "Nodes"
msgstr "Nœuds"

#: scripts/kg-viewer-strings.ts:194
#. Shown for a property that is present but holds an empty list — as opposed to one that is absent, which is not shown at all.
msgid "none"
msgstr "aucune"

#: scripts/kg-viewer-strings.ts:206
#. Accessible name of that diagram. {n} is the number of neighbours drawn, 0 or 2 and above.
msgid "One-hop neighbourhood, {n} linked nodes"
msgstr "Voisinage à un saut, {n} nœuds liés"

#: scripts/kg-viewer-strings.ts:202
#. Accessible name of the diagram under a node's properties when it has exactly one neighbour.
msgid "One-hop neighbourhood, 1 linked node"
msgstr "Voisinage à un saut, 1 nœud lié"

#: scripts/kg-viewer-strings.ts:214
#. As above, for a neighbour that points AT the selected node rather than away from it.
msgid "Referenced by {name} via {via}"
msgstr "Référencé par {name} via {via}"

#: scripts/kg-viewer-strings.ts:96
#. Placeholder text inside the search field.
msgid "search name, id, title…"
msgstr "nom, identifiant, titre…"

#: scripts/kg-viewer-strings.ts:92
#. The search field's label. Visually hidden, read by a screen reader, and it must say the same thing as the placeholder.
msgid "Search nodes by name, id or description"
msgstr "Rechercher des nœuds par nom, identifiant ou description"

#: scripts/kg-viewer-strings.ts:104
#. The detail panel before anything is selected.
msgid "Select a node."
msgstr "Sélectionnez un nœud."

#: scripts/kg-viewer-strings.ts:100
#. Accessible name of the detail panel on the right.
msgid "Selected node"
msgstr "Nœud sélectionné"

#: scripts/kg-viewer-strings.ts:72
#. Skip link, the first thing a keyboard user reaches. Jumps past the filter column to the node list.
msgid "Skip to results"
msgstr "Aller aux résultats"

#: scripts/kg-viewer-strings.ts:182
#. Second half of that warning, following a comma. {n} is a number — the count across the whole graph, not this node.
msgid "so a JSON-LD processor drops them. They are shown below, marked. Across the graph: {n} such property names."
msgstr "un processeur JSON-LD les ignore donc. Elles sont affichées ci-dessous, signalées. Dans l'ensemble du graphe : {n} noms de propriétés de ce type."

#: scripts/kg-viewer-strings.ts:142
#. Link text to the commit the graph was generated from, on the forge.
msgid "source commit"
msgstr "commit source"

#: scripts/kg-viewer-strings.ts:150
#. Shown in the detail panel when the fetch failed. The second sentence matters: an empty index and a failed fetch look identical on screen and mean opposite things.
msgid "The graph could not be read, so nothing is shown. This is not an empty graph."
msgstr "Le graphe n'a pas pu être lu, donc rien n'est affiché. Il ne s'agit pas d'un graphe vide."

#: scripts/kg-viewer-strings.ts:220
#. Shown under the heading whenever a language other than English is chosen. It states the boundary: a reader must not have to infer from a half-translated screen where the translation stops.
msgid "The interface is shown in {language}. The graph itself — node names, descriptions and property names — comes from this repository and is shown as written, in English."
msgstr "L'interface est affichée en {language}. Le graphe lui-même — noms de nœuds, descriptions et noms de propriétés — provient de ce dépôt et est affiché tel quel, en anglais."

#: scripts/kg-viewer-strings.ts:224
#. Shown with the note above when the chosen language's catalogue is not signed off. Dropped once a reviewer signs it off.
msgid "This interface translation was produced by an agent and has not been reviewed by a person."
msgstr "Cette traduction de l'interface a été produite par un agent et n'a pas été relue par une personne."

#: scripts/kg-viewer-strings.ts:130
#. Warns that the working tree had uncommitted changes when the graph was generated, so the commit id does not reproduce it.
msgid "tree dirty"
msgstr "arbre modifié"

#: scripts/kg-viewer-strings.ts:41
#. Row label for the node's type. The other row labels are property names from the graph's own vocabulary and are not translated — see the note about the graph's language.
msgid "type"
msgstr "type"
