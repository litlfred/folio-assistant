        <di:waypoint x="640" y="402" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PHW.A.Flow6_di" bpmnElement="PHW.A.Flow6">
        <di:waypoint x="830" y="312" />
        <di:waypoint x="865" y="312" />
