      <bpmndi:BPMNShape id="PHW.H.4_di" bpmnElement="PHW.H.4"><dc:Bounds x="850" y="679" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.H.Gateway2_di" bpmnElement="PHW.H.Gateway2" isMarkerVisible="true"><dc:Bounds x="1115" y="132" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.H.5_di" bpmnElement="PHW.H.5"><dc:Bounds x="1310" y="97" width="120" height="120" /></bpmndi:BPMNShape>
