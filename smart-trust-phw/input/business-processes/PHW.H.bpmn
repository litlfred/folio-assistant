      <bpmndi:BPMNShape id="PHW.H.Participant_di" bpmnElement="PHW.H.Participant" isHorizontal="true"><dc:Bounds x="120" y="60" width="1560" height="776" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.Lane.DataProvider_di" bpmnElement="PHW.Lane.DataProvider" isHorizontal="true"><dc:Bounds x="150" y="60" width="1530" height="194" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.Lane.GrantIssuer_di" bpmnElement="PHW.Lane.GrantIssuer" isHorizontal="true"><dc:Bounds x="150" y="254" width="1530" height="194" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.Lane.AuthorizationServer_di" bpmnElement="PHW.Lane.AuthorizationServer" isHorizontal="true"><dc:Bounds x="150" y="448" width="1530" height="194" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.Lane.TrustAnchor_di" bpmnElement="PHW.Lane.TrustAnchor" isHorizontal="true"><dc:Bounds x="150" y="642" width="1530" height="194" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.H.Start_di" bpmnElement="PHW.H.Start"><dc:Bounds x="252" y="139" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.H.1_di" bpmnElement="PHW.H.1"><dc:Bounds x="390" y="97" width="120" height="120" /></bpmndi:BPMNShape>
