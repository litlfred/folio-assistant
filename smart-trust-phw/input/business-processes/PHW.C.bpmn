<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="PHW.C.Definitions" targetNamespace="http://smart.who.int/trust-phw/bpmn">
  <bpmn:collaboration id="PHW.C.Collaboration">
    <bpmn:participant id="PHW.C.Participant" name="C. Present and Redeem Verifiable Health Link with PCF Consent Enforcement" processRef="PHW.C" />
  </bpmn:collaboration>
  <bpmn:process id="PHW.C" name="C. Present and Redeem Verifiable Health Link with PCF Consent Enforcement" isExecutable="false">
    <bpmn:documentation>Presents a Verifiable Health Link (`[ITI-YY4]` Provide VHL), verifies cryptographic trust against a Trust Anchor&apos;s trust list (`[ITI-YY2]` Retrieve Trust List with DID), requests the document manifest (`[ITI-YY5]` Retrieve Manifest), queries active patient privacy consent directives (`[ITI-108]` Access Consent: Search), and enforces three-valued (`permit` | `deny` | `unknown`) PCF Consent evaluation with W3C PROV-O decision provenance. Trust-anchor neutral (WHO GDHCN is one possible Trust Anchor among others) and makes no IUA claim.</bpmn:documentation>
    <bpmn:laneSet id="PHW.C.LaneSet">
      <bpmn:lane id="PHW.Lane.Holder" name="VHL Holder (Patient / Personal Health Wallet)">
        <bpmn:documentation>Personas: VHL Holder (`https://profiles.ihe.net/ITI/VHL/ActorDefinition/VHLHolder`) presenting a Verifiable Health Link to a VHL Receiver.</bpmn:documentation>
        <bpmn:flowNodeRef>PHW.C.Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHW.C.1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PHW.Lane.VHLReceiver" name="VHL Receiver (Verifier / Relying Party)">
        <bpmn:documentation>System Actor: IHE VHL Receiver (`https://profiles.ihe.net/ITI/VHL/CapabilityStatement/IHE.VHL.VHLReceiver`) verifying the VHL via `[ITI-YY2]` and redeeming the manifest via `[ITI-YY5]`.</bpmn:documentation>
        <bpmn:flowNodeRef>PHW.C.2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHW.C.4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHW.C.10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHW.C.End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PHW.Lane.TrustAnchor" name="Trust Anchor (e.g. GDHCN, national, or regional anchor)">
        <bpmn:documentation>System Actor: IHE VHL Trust Anchor (`https://profiles.ihe.net/ITI/VHL/CapabilityStatement/IHE.VHL.TrustAnchor`) serving trust lists via `[ITI-YY2]`. Trust-anchor neutral: WHO GDHCN is one possible Trust Anchor among others.</bpmn:documentation>
        <bpmn:flowNodeRef>PHW.C.3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PHW.Lane.VHLSharer" name="VHL Sharer (grouped with PCF Consent Authorization Server)">
        <bpmn:documentation>System Actor: IHE VHL Sharer (`https://profiles.ihe.net/ITI/VHL/CapabilityStatement/IHE.VHL.VHLSharer`) grouped with IHE PCF Consent Authorization Server (`https://profiles.ihe.net/ITI/PCF/CapabilityStatement/IHE.PCF.consentAuthorizationServer`).</bpmn:documentation>
        <bpmn:flowNodeRef>PHW.C.5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHW.C.7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHW.C.Gateway1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHW.C.8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PHW.C.9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PHW.Lane.ConsentRegistry" name="PCF Consent Registry">
        <bpmn:documentation>System Actor: IHE PCF Consent Registry (`https://profiles.ihe.net/ITI/PCF/CapabilityStatement/IHE.PCF.consentRegistry`) serving active FHIR `Consent` directives via `[ITI-108]` Access Consent.</bpmn:documentation>
        <bpmn:flowNodeRef>PHW.C.6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PHW.C.Start" name="Start VHL presentation">
      <bpmn:documentation>VHL Holder initiates presentation of a Verifiable Health Link to a VHL Receiver.</bpmn:documentation>
      <bpmn:outgoing>PHW.C.Flow1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PHW.C.1" name="C1. Present VHL payload to Receiver [ITI-YY4] Provide VHL">
      <bpmn:documentation>VHL Holder provides the VHL payload (via QR code, deep link, or near-field exchange) to the VHL Receiver under IHE VHL `[ITI-YY4]` Provide VHL.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow1</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PHW.C.2" name="C2. Request Trust Anchor key list [ITI-YY2] Retrieve Trust List with DID">
      <bpmn:documentation>VHL Receiver requests the current trust list from the configured Trust Anchor via IHE VHL `[ITI-YY2]` Retrieve Trust List with DID.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow2</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PHW.C.3" name="C3. Return signed trust list [ITI-YY2] (GDHCN or other Trust Anchor)">
      <bpmn:documentation>Trust Anchor (WHO GDHCN or another national/regional trust anchor) returns the signed DID / PKI trust list via `[ITI-YY2]`.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow3</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PHW.C.4" name="C4. Verify VHL signature &amp; request manifest [ITI-YY5] Retrieve Manifest">
      <bpmn:documentation>VHL Receiver verifies the VHL cryptographic signature against the `[ITI-YY2]` trust list and initiates `[ITI-YY5]` Retrieve Manifest stating its actor identity and purpose of use.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow4</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PHW.C.5" name="C5. Query active patient Consent [ITI-108] Access Consent: Search">
      <bpmn:documentation>VHL Sharer (grouped with PCF Consent Authorization Server) queries the PCF Consent Registry via `[ITI-108]` Access Consent: Search (`GET [base]/Consent?patient=...&amp;status=active`). Only Consents whose `Consent.policy.uri` names the agreement version in force are counted (rule 2). Results may be served from a cache, but an entry ends at its TTL, at its Consents&apos; `provision.period.end`, or as soon as a Consent in it is withdrawn (rule 4). With no matching Consent, the jurisdiction&apos;s PCF implicit default policy decides (rule 4) (owner consent rules, 2026-10-30 19:27Z).</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow5</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PHW.C.6" name="C6. Return active PCF Consent Bundle [ITI-108] Access Consent">
      <bpmn:documentation>PCF Consent Registry returns the Bundle of matching FHIR `Consent` resources (each with `Consent.id` and `Consent.meta.versionId`) via `[ITI-108]`.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow6</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="PHW.C.7" name="C7. Evaluate PCF Consent (ODRL decide: permit / deny / unknown) &amp; PROV-O log">
      <bpmn:documentation>Evaluates the retrieved PCF `Consent` via `consentToOdrl()` and three-valued `decide()` (`permit` | `deny` | `unknown`), recording a W3C PROV-O `prov:Activity` citing `Consent.id` and `Consent.meta.versionId`.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow7</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow8</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="PHW.C.Gateway1" name="Decision = permit?">
      <bpmn:documentation>Checks whether the three-valued PCF Consent evaluation yielded `permit` or `deny`/`unknown`.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow8</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow9</bpmn:outgoing>
      <bpmn:outgoing>PHW.C.Flow10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="PHW.C.8" name="C8. Return authorized manifest &amp; documents [ITI-YY5] Retrieve Manifest (permit)">
      <bpmn:documentation>On `permit`, VHL Sharer returns the authorized document manifest (`Bundle` of `DocumentReference` / clinical resources) in the `[ITI-YY5]` Retrieve Manifest response.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow9</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PHW.C.9" name="C9. Refuse disclosure with OperationOutcome [ITI-YY5] (deny or unknown)">
      <bpmn:documentation>On `deny` or `unknown` (e.g. inactive consent, expired period, missing purpose, or unresolvable actor), VHL Sharer refuses disclosure with HTTP 403 `OperationOutcome`.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow10</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PHW.C.10" name="C10. Process clinical documents or refusal notice [ITI-YY5] response">
      <bpmn:documentation>VHL Receiver processes the clinical documents returned by `[ITI-YY5]` Retrieve Manifest or handles the consent refusal `OperationOutcome`.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow11</bpmn:incoming>
      <bpmn:incoming>PHW.C.Flow12</bpmn:incoming>
      <bpmn:outgoing>PHW.C.Flow13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PHW.C.End" name="VHL redemption complete">
      <bpmn:documentation>VHL redemption workflow completes with full PCF Consent enforcement and provenance.</bpmn:documentation>
      <bpmn:incoming>PHW.C.Flow13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PHW.C.Flow1" sourceRef="PHW.C.Start" targetRef="PHW.C.1" />
    <bpmn:sequenceFlow id="PHW.C.Flow2" name="[ITI-YY4]" sourceRef="PHW.C.1" targetRef="PHW.C.2" />
    <bpmn:sequenceFlow id="PHW.C.Flow3" name="[ITI-YY2]" sourceRef="PHW.C.2" targetRef="PHW.C.3" />
    <bpmn:sequenceFlow id="PHW.C.Flow4" name="[ITI-YY2]" sourceRef="PHW.C.3" targetRef="PHW.C.4" />
    <bpmn:sequenceFlow id="PHW.C.Flow5" name="[ITI-YY5]" sourceRef="PHW.C.4" targetRef="PHW.C.5" />
    <bpmn:sequenceFlow id="PHW.C.Flow6" name="[ITI-108]" sourceRef="PHW.C.5" targetRef="PHW.C.6" />
    <bpmn:sequenceFlow id="PHW.C.Flow7" name="[ITI-108]" sourceRef="PHW.C.6" targetRef="PHW.C.7" />
    <bpmn:sequenceFlow id="PHW.C.Flow8" sourceRef="PHW.C.7" targetRef="PHW.C.Gateway1" />
    <bpmn:sequenceFlow id="PHW.C.Flow9" name="permit" sourceRef="PHW.C.Gateway1" targetRef="PHW.C.8" />
    <bpmn:sequenceFlow id="PHW.C.Flow10" name="deny / unknown" sourceRef="PHW.C.Gateway1" targetRef="PHW.C.9" />
    <bpmn:sequenceFlow id="PHW.C.Flow11" name="[ITI-YY5] 200 OK" sourceRef="PHW.C.8" targetRef="PHW.C.10" />
    <bpmn:sequenceFlow id="PHW.C.Flow12" name="[ITI-YY5] 403" sourceRef="PHW.C.9" targetRef="PHW.C.10" />
    <bpmn:sequenceFlow id="PHW.C.Flow13" sourceRef="PHW.C.10" targetRef="PHW.C.End" />
  </bpmn:process>
