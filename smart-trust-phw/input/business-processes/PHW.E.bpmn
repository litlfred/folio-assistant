      <bpmndi:BPMNShape id="PHW.E.6_di" bpmnElement="PHW.E.6"><dc:Bounds x="1430" y="95" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.E.7_di" bpmnElement="PHW.E.7"><dc:Bounds x="1635" y="475" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.E.8_di" bpmnElement="PHW.E.8"><dc:Bounds x="1840" y="475" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PHW.E.9_di" bpmnElement="PHW.E.9"><dc:Bounds x="2045" y="475" width="170" height="80" /></bpmndi:BPMNShape>
