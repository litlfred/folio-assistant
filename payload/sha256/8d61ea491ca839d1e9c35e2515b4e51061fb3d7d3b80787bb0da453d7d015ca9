    {
      "id": "library/10665-344250/blocks/prose-sec-006",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "TENIR COMPTE DU FAIT QUE, POUR ÊTRE EFFICACES, LES INITIATIVES DE SANTÉ NUMÉRIQUE DOIVENT S’APPUYER SUR UNE STRATÉGIE INTÉGRÉE",
      "pageStart": 20,
      "pageEnd": 20,
      "target": "../sections/sec-006-2-tenir-compte-du-fait-que-pour-être-efficaces-l.md",
      "narrative": null,
      "content": "INITIATIVES DE SANTÉ NUMÉRIQUE DOIVENT S’APPUYER SUR \nUNE STRATÉGIE INTÉGRÉE\nLes technologies numériques sont une composante essentielle \net servent de catalyseur pour l’instauration de systèmes de santé \ndurables et de la couverture sanitaire universelle. Pour en tirer \nparti, les initiatives de santé numérique doivent s’inscrire dans \nl’écosystème plus large de la santé et du numérique et être guidées \npar une stratégie solide intégrant le leadership et les ressources \nfinancières, institutionnelles, humaines et technologiques ; et \nqui sert de fondement à l’élaboration d’un plan d’action ch",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "States the guiding principle that digital health initiatives must sit within an integrated strategy with leadership, resources, strong governance, a costed action plan and standards-based architecture.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
