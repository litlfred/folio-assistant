    {
      "id": "library/10665-258517/blocks/prose-sec-009",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Counselling example I: Integrated Next Step Counselling (iNSC)",
      "pageStart": 16,
      "pageEnd": 18,
      "target": "../sections/sec-009-counselling-example-i-integrated-next-step-couns.md",
      "narrative": null,
      "content": "This method was developed to address the challenges of informing the choice of PrEP, developing a plan for adherence, \nand developing broader plans for sexual health (17). The method is interactive, brief, client-centred and focused on \nproblem-solving, starting with the client’s identification of personal goals and the barriers and facilitators to achieving \nthose goals. The method was developed for the iPrEx study conducted in Thailand, South Africa, Brazil, Peru, Ecuador and \nthe USA. This counselling method has been used to support adherence in the iPrEx Open Label Extension, especially in",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Describes Integrated Next Step Counselling, a brief, client-centred, problem-solving method developed for the iPrEx study to support PrEP choice, adherence and sexual health planning. It outlines its steps and explains that it is linked to delivering negative HIV results, combining test counselling and adherence counselling in one conversation.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
    },
    {
      "id": "library/10665-258517/blocks/prose-sec-010",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Counselling example II: Informed choice counselling",
      "pageStart": 18,
      "pageEnd": 21,
      "target": "../sections/sec-010-counselling-example-ii-informed-choice-counselli.md",
      "narrative": null,
      "content": "Best practices in counselling are also incorporated into a PrEP counselling plan that was developed by FHI360 for a study \nlooking at PrEP use and risk compensation among women at higher risk for HIV infection at sites in Kenya and South \nAfrica (24, 25). More information on this approach can be found in the following document Guidance for providing \ninformed-choice counseling on sexual health for women interested in pre-exposure prophylaxis (PrEP), available at https://\nwww.fhi360.org/projects/prep-and-risk-compensation-assessing-effect-and-preparing-rollout. \nThis approach builds on informed",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Presents an informed choice counselling approach developed by FHI360 for women at higher HIV risk in Kenya and South Africa, built on principles of voluntary, informed decision-making. It walks through four phases (introductory, informational, deliberation and decision, and confirmation) with suggested counsellor prompts. A flow chart shows how to assess interest in PrEP and develop either a PrEP use plan or a risk-reduction plan.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
      }
