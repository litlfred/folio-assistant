      ],
      "kind": "prose",
      "title": "Integration - across programmes and services",
      "pageStart": 16,
      "pageEnd": 16,
      "target": "../sections/sec-009-141-integration---across-programmes-and-services.md",
      "narrative": null,
      "content": "",
      "truncated": false,
