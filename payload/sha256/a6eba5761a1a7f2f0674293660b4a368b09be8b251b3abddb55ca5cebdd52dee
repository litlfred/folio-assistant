    },
    {
      "id": "library/10665-44759/blocks/prose-sec-003",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Decision-making during the Expert Group meeting and external review",
      "pageStart": 13,
      "pageEnd": 14,
      "target": "../sections/sec-003-22-decision-making-during-the-expert-group-meeti.md",
      "narrative": null,
      "content": "Decision-making during the Expert Group meeting and external review \nThe systematic reviews were made available to the Expert Group for scrutiny before the meeting.   \n \nThe Expert Group meeting was co-chaired by the WHO-STB secretariat and an evidence synthesis \nexpert. Decisions were based on consensus. Concerns and opinions by Expert Group members were \nnoted and included in the final meeting report. The detailed meeting report was prepared by the \nWHO-STB secretariat and underwent several iterations (managed by the secretariat) before being \nsigned off by all Expert Group members.  \n \nReco",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Explains that the Expert Group reviewed the systematic reviews in advance and reached decisions by consensus, with members' concerns recorded in the meeting report. The final policy was approved by WHO's Guidelines Review Committee.",
        "state": "draft",
