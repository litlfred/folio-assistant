    {
      "id": "library/10665-44759/blocks/prose-sec-008",
      "types": [
        "folio-assistant-core:Prose",
        "doco:Section"
      ],
      "kind": "prose",
      "title": "Summary of results",
      "pageStart": 15,
      "pageEnd": 16,
      "target": "../sections/sec-008-312-summary-of-results.md",
      "narrative": null,
      "content": "Summary of results \nThe results demonstrated that in low- and middle-income countries: \n \nThe sensitivity of IGRAs in detecting active TB among persons suspected of having TB ranged \nfrom 73-83% and specificity ranged from 49-58%;  One in four patients, on average, with culture-\nconfirmed active TB could therefore be expected to be IGRA-negative in low-and middle income \ncountries, with serious consequences for patients in terms of morbidity and mortality; \n \n \nThere was no evidence that IGRAs have added value beyond conventional microbiological tests \nfor the diagnosis of active TB.  Among",
      "truncated": true,
      "provenance": "ingested",
      "summary": {
        "status": "draft",
        "text": "Reports that IGRAs had sensitivity of 73–83% and specificity of 49–58% for active TB in low- and middle-income countries, so about one in four culture-confirmed patients could test negative. It also notes industry involvement in some of the studies.",
        "state": "draft",
        "draftedBy": {
          "kind": "agent",
          "id": "claude-code",
          "model": "not-disclosed"
        },
        "draftedAt": "2026-11-11"
