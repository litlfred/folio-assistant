{
  "name": "authoring-document",
  "version": "0.1.0",
  "description": "Authoring skills for structured prose folios — policy guidance, standards, reports, books — with no Lean formalization and no required LaTeX toolchain",
  "skills": [
    "document-authoring",
    "document-structure",
    "normative-statements",
    "document-publishing"
  ],
  "docker": {
    "baseImage": "ubuntu:24.04",
    "aptPackages": [
      "curl",
      "git",
      "git-lfs",
      "ca-certificates",
      "python3",
      "python3-pip",
      "python3-venv",
      "nodejs",
      "npm",
      "pandoc",
      "graphviz",
      "unzip",
      "wget"
    ],
    "pipPackages": [
      "weasyprint"
    ],
    "npmPackages": [
      "typescript",
      "bun"
    ],
    "env": {
      "FOLIO_CONTENT_PROFILE": "document"
    },
    "labels": {
      "org.opencontainers.image.title": "folio-assistant-document",
      "org.opencontainers.image.description": "Structured prose authoring environment — no Lean, no TeX",
      "org.opencontainers.image.source": "https://github.com/litlfred/folio-assistant"
    }
  },
  "providesCapabilities": [
    "pandoc",
    "html-pdf-engine",
    "bun-runtime",
    "python3",
    "graphviz"
  ],
  "requiresCapabilities": [
    "git-push"
  ],
  "lifecycleStages": [
    "plan",
    "author",
    "validate",
    "review",
    "test",
    "publish"
  ],
  "schemas": [
    "schemas/generated/SkillDefinition.schema.json",
    "schemas/generated/SkillPackageManifest.schema.json"
  ]
}
