    },
    "targetDate": {
      "type": "string",
      "format": "date"
    },
    "teamSize": {
      "type": "integer",
      "minimum": 1
    },
    "sprintDuration": {
      "type": "string",
      "enum": [
        "1w",
        "2w",
        "3w",
        "4w"
      ],
      "default": "2w"
    }
  },
