{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/skills/content-plan/input.schema.json",
  "title": "Content Plan Input",
  "description": "Input schema for content planning — scope, team, timeline, governance.",
  "type": "object",
  "required": [
    "projectName"
  ],
  "properties": {
    "projectName": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "description": "Description of the content scope."
    },
    "targetDate": {
      "type": "string",
      "format": "date"
    },
    "teamSize": {
      "type": "integer",
      "minimum": 1
    },
    "sprintDuration": {
      "type": "string",
      "enum": [
        "1w",
        "2w",
        "3w",
        "4w"
      ],
      "default": "2w"
    }
  },
  "staging": {
    "branch": "main",
    "sha": "e7f0b4d6a1c0f67b91a8a2f20f1a9eebd30b114d",
    "pr": "main",
    "run": "35530602558"
  }
}
