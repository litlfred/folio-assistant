{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://litlfred.github.io/folio-assistant/skills/content-plan/input.schema.json",
  "title": "Content Plan Input",
  "description": "Input schema for content planning — scope, team, timeline, governance.",
  "type": "object",
  "required": [
    "projectName"
  ],
  "properties": {
    "projectName": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "description": "Description of the content scope."
    },
    "targetDate": {
      "type": "string",
      "format": "date"
    },
    "teamSize": {
      "type": "integer",
      "minimum": 1
    },
    "sprintDuration": {
      "type": "string",
      "enum": [
        "1w",
        "2w",
        "3w",
        "4w"
      ],
      "default": "2w"
    }
  },
