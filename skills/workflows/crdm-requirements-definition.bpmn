<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:folio="https://litlfred.github.io/folio-assistant/bpmn"
                  id="Definitions_Process_CRDM_Requirements" targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:collaboration id="Collaboration_Process_CRDM_Requirements">
    <bpmn:participant id="Participant_Process_CRDM_Requirements" name="CRDM Phases 2–4 — BPA and requirements" processRef="Process_CRDM_Requirements"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CRDM_Requirements" name="CRDM Phases 2–4 — BPA and requirements" isExecutable="false">
    <bpmn:documentation>Map the current workflow, then define the requirements and the impact they carry, and loop until approved. Same shape as Phase 1 and for the same reason: an unapproved requirement is a proposal.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_CRDM_Requirements">
      <bpmn:lane id="Lane_BA" name="BA / Feature Requestor">
        <bpmn:flowNodeRef>BA_ReviewReqs</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Agent">
        <bpmn:flowNodeRef>Start_Process_CRDM_Requirements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_MapWorkflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DefineReqs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Reqs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Process_CRDM_Requirements</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Stakeholders" name="Stakeholders">
        <bpmn:flowNodeRef>S_ApproveReqs</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Process_CRDM_Requirements" name="Phase begins"/>
    <bpmn:task id="A_MapWorkflow" name="Phase 2: Map current
workflow (BPA)">
      <bpmn:documentation>Business-process analysis here means reading the
existing diagrams under skills/workflows/ and drawing the gap, so the skill
that implements this step is the BPMN one.</bpmn:documentation>
      <bpmn:extensionElements><folio:skill ref="bpmn-authoring"/></bpmn:extensionElements>
    </bpmn:task>
    <bpmn:task id="A_DefineReqs" name="Phases 3–4: Define
requirements + impact">
      <bpmn:documentation>Two skills, because this step is two things: the
requirements come from the CRDM process, the impact half is a dependency
question the content graph answers.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="crdm-requirements-workflow"/>
        <folio:skill ref="content-graph"/>
      </bpmn:extensionElements>
    </bpmn:task>
    <bpmn:task id="BA_ReviewReqs" name="Review requirements
and impact analysis">
      <bpmn:documentation>The BA reviews the formal requirements and the
impact analysis the agent produced.</bpmn:documentation>
    </bpmn:task>
    <bpmn:task id="S_ApproveReqs" name="Approve
requirements"/>
    <bpmn:exclusiveGateway id="GW_Reqs" name="BA approves?"/>
    <bpmn:endEvent id="End_Process_CRDM_Requirements" name="Phase complete"/>
    <bpmn:sequenceFlow id="SF_Process_CRDM_Requirements_1" sourceRef="Start_Process_CRDM_Requirements" targetRef="A_MapWorkflow"/>
    <bpmn:sequenceFlow id="SF_Process_CRDM_Requirements_2" sourceRef="A_MapWorkflow" targetRef="A_DefineReqs"/>
    <bpmn:sequenceFlow id="SF_Process_CRDM_Requirements_3" sourceRef="A_DefineReqs" targetRef="BA_ReviewReqs"/>
    <bpmn:sequenceFlow id="SF_Process_CRDM_Requirements_4" sourceRef="BA_ReviewReqs" targetRef="S_ApproveReqs"/>
    <bpmn:sequenceFlow id="SF_Process_CRDM_Requirements_5" sourceRef="S_ApproveReqs" targetRef="GW_Reqs"/>
    <bpmn:sequenceFlow id="SF_Process_CRDM_Requirements_6" name="revise" sourceRef="GW_Reqs" targetRef="A_DefineReqs"/>
    <bpmn:sequenceFlow id="SF_Process_CRDM_Requirements_7" name="yes" sourceRef="GW_Reqs" targetRef="End_Process_CRDM_Requirements"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_CRDM_Requirements">
    <bpmndi:BPMNPlane id="Plane_Process_CRDM_Requirements" bpmnElement="Collaboration_Process_CRDM_Requirements">
      <bpmndi:BPMNShape id="Shape_Participant_Process_CRDM_Requirements" bpmnElement="Participant_Process_CRDM_Requirements" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1466" height="510" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_BA_Process_CRDM_Requirements" bpmnElement="Lane_BA" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1436" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Agent_Process_CRDM_Requirements" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="1436" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Stakeholders_Process_CRDM_Requirements" bpmnElement="Lane_Stakeholders" isHorizontal="true">
        <dc:Bounds x="190" y="420" width="1436" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Process_CRDM_Requirements" bpmnElement="Start_Process_CRDM_Requirements">
        <dc:Bounds x="310" y="317" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_MapWorkflow" bpmnElement="A_MapWorkflow">
        <dc:Bounds x="510" y="295" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_DefineReqs" bpmnElement="A_DefineReqs">
        <dc:Bounds x="710" y="295" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BA_ReviewReqs" bpmnElement="BA_ReviewReqs">
        <dc:Bounds x="910" y="125" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_S_ApproveReqs" bpmnElement="S_ApproveReqs">
        <dc:Bounds x="1110" y="465" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Reqs" bpmnElement="GW_Reqs" isMarkerVisible="true">
        <dc:Bounds x="1310" y="310" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Process_CRDM_Requirements" bpmnElement="End_Process_CRDM_Requirements">
        <dc:Bounds x="1510" y="317" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_SF_Process_CRDM_Requirements_1" bpmnElement="SF_Process_CRDM_Requirements_1">
        <di:waypoint x="346" y="335" />
        <di:waypoint x="510" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_CRDM_Requirements_2" bpmnElement="SF_Process_CRDM_Requirements_2">
        <di:waypoint x="650" y="335" />
        <di:waypoint x="710" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_CRDM_Requirements_3" bpmnElement="SF_Process_CRDM_Requirements_3">
        <di:waypoint x="850" y="335" />
        <di:waypoint x="880" y="335" />
        <di:waypoint x="880" y="165" />
        <di:waypoint x="910" y="165" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_CRDM_Requirements_4" bpmnElement="SF_Process_CRDM_Requirements_4">
        <di:waypoint x="1050" y="165" />
        <di:waypoint x="1080" y="165" />
        <di:waypoint x="1080" y="505" />
        <di:waypoint x="1110" y="505" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_CRDM_Requirements_5" bpmnElement="SF_Process_CRDM_Requirements_5">
        <di:waypoint x="1250" y="505" />
        <di:waypoint x="1280" y="505" />
        <di:waypoint x="1280" y="335" />
        <di:waypoint x="1310" y="335" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_CRDM_Requirements_6" bpmnElement="SF_Process_CRDM_Requirements_6">
        <di:waypoint x="1335" y="360" />
        <di:waypoint x="1335" y="415" />
        <di:waypoint x="780" y="415" />
        <di:waypoint x="780" y="375" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_CRDM_Requirements_7" bpmnElement="SF_Process_CRDM_Requirements_7">
        <di:waypoint x="1360" y="335" />
        <di:waypoint x="1510" y="335" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
