{
  "name": "@litlfred/folio-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Content-agnostic assistant platform coordinator.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/litlfred/folio-assistant.git"
  },
  "scripts": {
    "bootstrap:schemas": "bun run bootstrap-tools/scripts/gen-bootstrap-schemas.ts",
    "bootstrap:schemas:check": "bun run bootstrap-tools/scripts/gen-bootstrap-schemas.ts --check",
    "bootstrap:semver": "bun run bootstrap-tools/scripts/schema-semver.ts",
    "bootstrap:validate": "bun run bootstrap-tools/scripts/validate-bootstrap.ts",
    "check:bootstrap-concepts": "bun run bootstrap-tools/scripts/check-bootstrap-concepts.ts",
    "ns:bootstrap": "bun run bootstrap-tools/scripts/gen-vocabulary.ts",
    "bootstrap:vocabulary": "bun run bootstrap-tools/scripts/gen-vocabulary.ts",
    "bootstrap:vocabulary:check": "bun run bootstrap-tools/scripts/gen-vocabulary.ts --check",
    "check:tools-closure": "bun run bootstrap-tools/scripts/check-closure.ts",
    "check:node-iris": "bun run bootstrap-tools/scripts/check-node-iris.ts",
    "iri:sync": "bun run bootstrap-tools/scripts/iri-sync.ts",
    "iri:sync:check": "bun run bootstrap-tools/scripts/iri-sync.ts --check",
    "smart-base:pages": "bun run fhir-harness/scripts/gen-ig-pages.ts --instance smart-base --publish-note \"This page mirrors a published WHO Implementation Guide.\" --sidecar-label \"DAK API\" --label \"WHO SMART Base\" --chrome-owner smart-base --summary",
    "smart-trust:pages": "bun run fhir-harness/scripts/gen-ig-pages.ts --instance smart-trust --publish-note \"This page mirrors a published WHO Implementation Guide.\" --sidecar-label \"Trust Network\" --label \"WHO SMART Trust\" --chrome-owner smart-trust --summary",
    "smart-immunizations:pages": "bun run fhir-harness/scripts/gen-ig-pages.ts --instance smart-immunizations --publish-note \"This page mirrors a published WHO Implementation Guide.\" --sidecar-label \"DAK API\" --label \"WHO SMART Immunizations\" --chrome-owner smart-base --summary",
    "smart-trust:openapi:pages": "bun run cat-harness/openapi/scripts/gen-openapi-pages.ts --instance smart-trust",
    "smart:pages": "bun run cat smart-base:pages && bun run cat smart-trust:pages && bun run cat smart-immunizations:pages",
    "smart:pages:publish": "bun run cat smart:pages && bun run cat smart-trust:openapi:pages",
    "test": "bun test",
    "typecheck": "bun node_modules/typescript7/bin/tsc --noEmit -p tsconfig.json",
    "cat": "bun cat-harness/scripts/run-script.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "bpmn-moddle": "^10.2.0",
    "dmn-moddle": "^12.1.0",
    "glob": "^13.0.6",
    "liquidjs": "^10.29.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "oxigraph": "^0.5.11",
    "remark": "^15.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-math": "^6.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@sqlite.org/sqlite-wasm": "3.53.4-build2",
    "@types/jsonld": "^1.5.15",
    "bpmn-js": "^18.25.1",
    "bun-types": "latest",
    "csl-json": "^0.1.0",
    "eslint": "^10.8.0",
    "fast-xml-parser": "^5.10.1",
    "jsonld": "8",
    "lunr": "2.3.9",
    "typescript-eslint": "^8.66.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "folio",
    "mcp",
    "assistant",
    "content-platform",
    "model-context-protocol"
  ],
  "resolutions": {
    "zod": "^4.6.5"
  }
}
