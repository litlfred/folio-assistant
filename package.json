{
  "name": "@anthropic-ai/folio-assistant",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Content-agnostic assistant platform — MCP server, auth, UI, deploy. Pluggable content adapters for papers, guidelines, documentation.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/litlfred/qou.git",
    "directory": "folio-assistant"
  },
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./types": "./src/types.ts",
    "./core/git": "./src/core/git.ts",
    "./core/feedback": "./src/core/feedback.ts",
    "./core/rbac": "./src/core/rbac.ts",
    "./core/cache": "./src/core/cache.ts",
    "./core/logging": "./src/core/logging.ts",
    "./blocks": "./src/blocks/index.ts",
    "./blocks/registry": "./src/blocks/registry.ts",
    "./blocks/types": "./src/blocks/types.ts",
    "./routes/branches": "./src/routes/branches.ts",
    "./routes/feedback": "./src/routes/feedback.ts",
    "./routes/chat": "./src/routes/chat.ts",
    "./tools/check-deps": "./src/tools/check-deps.ts",
    "./tools/preferences": "./src/tools/preferences.ts",
    "./tools/preview": "./src/tools/preview.ts"
  },
  "files": [
    "src/",
    "ui/",
    "viewer/sw-pyodide-cache.js",
    "viewer/register-sw.js",
    "harness.config.example.json",
    "README.md"
  ],
  "scripts": {
    "agent-memory": "bun run scripts/agent-memory.ts",
    "agent-memory:check": "bun run scripts/agent-memory.ts --check",
    "beans:fallback": "bun run scripts/beans-fallback.ts",
    "beans:claim": "bun run scripts/claim-bean.ts",
    "check-deps": "bun run src/index.ts --check-deps",
    "check:ci-health": "bun run scripts/check-ci-health.ts",
    "check:corpus-gate": "bun run scripts/check-corpus-gate.ts",
    "check:declared-paths": "bun run scripts/check-declared-paths.ts",
    "check:declared-assets": "bun run scripts/check-declared-assets.ts",
    "ingest": "bun run scripts/ingest-document.ts",
    "check:bean-parents": "bun run scripts/check-bean-parents.ts",
    "check:l1-complete": "bun run scripts/check-l1-complete.ts",
    "check:harness-dirs": "bun run scripts/check-harness-dirs.ts",
    "check:agents-xref": "bun run scripts/check-agents-xref.ts",
    "avatars:css": "bun run scripts/gen-avatars-css.ts",
    "avatars:css:check": "bun run scripts/gen-avatars-css.ts --check",
    "themes:css": "bun run scripts/gen-themes-css.ts",
    "themes:css:check": "bun run scripts/gen-themes-css.ts --check",
    "check:agents-xref:strict": "bun run scripts/check-agents-xref.ts --strict",
    "check:orphan-verdicts": "bun run content/pipeline/orphan-verdict-sweep.ts",
    "check:partition": "bun run scripts/repo-partition.ts",
    "check:partition:edges": "bun run scripts/repo-partition.ts --edges",
    "check:schema-nodes": "bun run scripts/check-schema-nodes.ts",
    "check:tools": "bun run scripts/check-tools.ts",
    "check:voices": "bun run scripts/check-voices.ts",
    "check:upstream-pins": "bun run scripts/check-upstream-pins.ts",
    "check:workflow-policy": "bun run scripts/check-workflow-policy.ts",
    "check:workflow-refs": "bun run scripts/check-workflow-refs.ts",
    "check:workflows": "bun run scripts/check-workflows.ts",
    "check:xml-comments": "bun run scripts/xml-comment-check.ts",
    "docs:harness": "bun run scripts/sync-docs-harness.ts",
    "docs:harness:check": "bun run scripts/sync-docs-harness.ts --check",
    "eval:crdm-detect": "bun run scripts/eval-crdm-detect.ts",
    "gen:jsonld": "bun run scripts/gen-jsonld-context.ts && bun run content/pipeline/gen-block-jsonld.ts && bun run content/pipeline/gen-library-jsonld.ts",
    "gen:jsonld:check": "bun run scripts/gen-jsonld-context.ts --check && bun run content/pipeline/gen-block-jsonld.ts --check && bun run content/pipeline/gen-library-jsonld.ts --check",
    "harness:dirs": "bun run scripts/harness-dirs.ts",
    "health": "bun run test/health/run.ts",
    "health:check": "bun run test/health/run.ts --no-write",
    "health:list": "bun run test/health/run.ts --list",
    "harness:dirs:check": "bun run scripts/harness-dirs.ts --check",
    "init-folio": "bun run scripts/init-folio.ts",
    "kg:audit": "bun run scripts/kg-audit.ts",
    "kg:audit:check": "bun run scripts/kg-audit.ts --check",
    "kg:audit:strict": "bun run scripts/kg-audit.ts --check --strict",
    "kg:export": "bun run scripts/kg-export.ts",
    "kg:schema": "bun run scripts/harness-schema-export.ts",
    "kg:schema:check": "bun run scripts/harness-schema-export.ts --check",
    "kg:schema:ids": "bun run scripts/harness-schema-export.ts --write-ids",
    "kg:viewer": "bun run scripts/kg-viewer.ts",
    "lint": "eslint .",
    "mcp:capture": "bun run scripts/capture-mcp-tools.ts",
    "ns:bootstrap": "bun run scripts/ns-export.ts --layer bootstrap",
    "ns:check": "bun run scripts/ns-export.ts --check",
    "ns:export": "bun run scripts/ns-export.ts",
    "pages:bootstrap": "bun run scripts/pages-bootstrap.ts",
    "serve:rendering": "bun run scripts/serve-rendering.ts",
    "readme:audit": "bun run content/pipeline/readme-links.ts",
    "readme:sections": "bun run content/pipeline/readme-sections.ts --list",
    "readme:sync": "bun run content/pipeline/readme-sections.ts",
    "readme:sync:check": "bun run content/pipeline/readme-sections.ts --check",
    "render:bpmn": "bun run scripts/render-bpmn.ts",
    "render:bpmn:check": "bun run scripts/render-bpmn.ts --check",
    "scan:repo": "bun run scripts/scan-repo-content.ts",
    "site:links": "bun run scripts/site-links.ts",
    "stakeholder-map": "bun run scripts/stakeholder-map.ts",
    "start": "bun run src/index.ts",
    "start:http": "bun run src/index.ts --http",
    "start:stdio": "bun run src/index.ts --stdio",
    "test": "bun test",
    "test:e2e": "playwright test",
    "todos": "bun run scripts/todos.ts",
    "tools:coverage": "bun run scripts/tool-coverage.ts",
    "translate-bpmn": "bun run scripts/translate-bpmn.ts",
    "translate-bpmn:check": "bun run scripts/translate-bpmn.ts --check",
    "translate-kg-viewer": "bun run scripts/translate-kg-viewer.ts",
    "translate-kg-viewer:check": "bun run scripts/translate-kg-viewer.ts --check",
    "translation:block-qa": "bun run content/pipeline/translation-block-qa.ts",
    "translation:block-qa:check": "bun run content/pipeline/translation-block-qa.ts --check",
    "translation:index": "bun run content/pipeline/translation-index.ts",
    "translation:index:check": "bun run content/pipeline/translation-index.ts --check",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "bpmn-moddle": "^10.2.0",
    "dmn-moddle": "^12.1.0",
    "glob": "^13.0.6",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "remark": "^15.0.1",
    "remark-directive": "^4.0.0",
    "remark-html": "^16.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.61.1",
    "bpmn-js": "^18.25.1",
    "bun-types": "latest",
    "csl-json": "^0.1.0",
    "eslint": "^10.8.0",
    "fast-xml-parser": "^5.10.1",
    "typescript-eslint": "^8.66.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "keywords": [
    "folio",
    "mcp",
    "assistant",
    "content-platform",
    "model-context-protocol"
  ]
}
