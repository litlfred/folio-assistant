      "key": "cs1-cat-mount-<hashFiles('index.lock.json')> (namespaced by cached-step.sh key)",
      "restoreKeys": "prefix cs1-cat-mount- (trust: exact only)",
      "holds": "~/.cache/cat-mount",
      "producer": "jsonld-gen-check drift-check (save phase, :160); determinism-audit has restore only",
      "consumers": "determinism-audit audit, jsonld-gen-check drift-check",
      "savePolicy": "cached-step policy (cached-step.sh:125): main push saves; trust=exact may save from PR (ref-scoped); main-only saves only from main; pull_request_target never; undetermined key never",
      "keyDerivation": "derived: hashFiles('index.lock.json'); verify: mount-from-lock.sh",
      "notes": "Same content as cat-mount but a DIFFERENT key namespace (cs1-), so the two caches never share entries. determinism-audit restores but never saves."
