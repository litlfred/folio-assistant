      ],
      "key": "cat-mount-v1-${{ hashFiles('index.lock.json') }}  (feature-staging.yml:2672,3050 use hashFiles('source/index.lock.json'))",
      "restoreKeys": "cat-mount-v1-",
      "holds": "~/.cache/cat-mount — remote layer trees mounted from index.lock.json (mount-from-lock.sh)",
      "producer": "the same step (actions/cache post-step) in every job that mounts layers",
      "consumers": "the same 19 steps: code-quality-gates jobs hygiene, typescript-static, verdict-reuse, qa-working-copy, publish-pages, typescript-test, gates-kg, gates-docs, gates-standalone, gates-unrun, e2e-shard, skill-registration-chain, qa-publish; feature-staging stage/cleanup/cleanup-dispatch; post-merge-regen regen; repin-train train; staging-publish publish",
      "savePolicy": "plain actions/cache: saves on every run whose exact key missed — push to main, PR (PR-ref scoped), merge_group, schedule, dispatch; feature-staging cleanup jobs run on pull_request_target, so they save into the BASE (main) scope (content from main's lock: default checkout is base)",
      "keyDerivation": "derived: hashFiles of the lock that pins every mounted tree; 'v1' hand-bumped",
      "notes": "19 duplicate steps of one key in 6 workflows (13 in code-quality-gates alone). Prefix restore of any older lock is safe only because the mount step re-verifies trees against the lock digests. No tool (bun/git) version in key."
    },
    {
