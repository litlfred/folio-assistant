      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CF10_di" bpmnElement="CF10">
        <di:waypoint x="1981" y="320" />
        <di:waypoint x="2036" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CF14_di" bpmnElement="CF14">
        <di:waypoint x="2166" y="320" />
        <di:waypoint x="2216" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CF11_di" bpmnElement="CF11">
        <di:waypoint x="1556" y="640" />
        <di:waypoint x="1626" y="640" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CF12_di" bpmnElement="CF12">
        <di:waypoint x="1651" y="665" />
        <di:waypoint x="1651" y="705" />
        <di:waypoint x="981" y="705" />
        <di:waypoint x="981" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CF13_di" bpmnElement="CF13">
        <di:waypoint x="1676" y="640" />
