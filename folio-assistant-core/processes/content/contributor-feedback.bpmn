        <di:waypoint x="461" y="160" />
        <di:waypoint x="501" y="160" />
        <di:waypoint x="501" y="320" />
        <di:waypoint x="541" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CF03_di" bpmnElement="CF03">
        <di:waypoint x="661" y="320" />
