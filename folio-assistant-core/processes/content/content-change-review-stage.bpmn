<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/v0/processes/ns/"
 xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/v0/processes/ns/" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_ContentChangeReviewStage"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="0.1.0">
  <bpmn:import namespace="https://litlfred.github.io/bootstrap/v0/processes/ns/" location="https://litlfred.github.io/bootstrap/v0/processes/ns.jsonld" importType="http://www.w3.org/ns/json-ld"/>
  <bpmn:resource id="build-pipeline" name="Build pipeline"/>

  <bpmn:collaboration id="Collaboration_ContentChangeReviewStage">
    <bpmn:participant id="Participant_ContentChangeReviewStage" name="Stage the content change" processRef="Process_ContentChangeReviewStage" />
  </bpmn:collaboration>

  <bpmn:process id="Process_ContentChangeReviewStage" name="Stage the content change" isExecutable="false">
    <bpmn:documentation>Putting one push of a content change where a person can look at it: build the staging site, deploy it under the branch's slug, link it on the pull request, and watch the branch's CI.

Called from content-change-review after the first push and after every revision, so the author and the committee never review a stale preview.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ContentChangeReviewStage">
      <bpmn:lane id="Lane_Pipeline" name="CI/CD Pipeline" partitionElementRef="build-pipeline">
        <bpmn:documentation>Runs build, stage, comment and watch once per push.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_Pipeline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildStaging</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeployStaging</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CommentPR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WatchBranchCI</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Staged</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Pipeline" name="Push to feature branch">
      <bpmn:outgoing>p1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_BuildStaging" name="Build staging site">
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="feature-staging"/>
      </bpmn:extensionElements>

      <bpmn:documentation>
        feature-staging.yml triggers:
        1. Regenerate docs (schema, skills, content-backed pages)
        2. Render BPMN diagrams
        3. Stamp build with commit SHA + timestamp + branch
        4. Build Jekyll site with branches/ baseurl
        5. Inject yellow staging banner into every HTML page
        A draft pull request is staged too, from its first push. A build
        takes about 22 minutes, and GitHub Pages about 3 to 4 more.
      </bpmn:documentation>
      <bpmn:incoming>p1</bpmn:incoming>
      <bpmn:outgoing>p2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_DeployStaging" name="Deploy to branches/&lt;slug&gt;/">
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="feature-staging"/>
      </bpmn:extensionElements>

      <bpmn:documentation>
        The stage job copies the built site into gh-pages under
        branches/&lt;branch-slug&gt;/, then `staging-share.ts apply` keeps only
        the files that differ from the live site.
        The preview's staging-sw.js serves every other file from the live
        site and puts the staging banner back on it. Other previews and the
        main site are left as they are.
      </bpmn:documentation>
      <bpmn:incoming>p2</bpmn:incoming>
      <bpmn:outgoing>p3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CommentPR" name="Comment staging URL on PR">
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="feature-staging"/>
        <bootstrap.processes:skill ref="rendered-impact"/>
      </bpmn:extensionElements>

      <bpmn:documentation>
        Bot comments or updates the staging URL on the PR.
        Includes commit SHA, branch name, and build log link, and the
        review list of rendered files the change alters (skill
        rendered-impact), each linked on the preview and on main, with any
        input the renderer could not place named as not known.
      </bpmn:documentation>
      <bpmn:incoming>p3</bpmn:incoming>
      <bpmn:outgoing>p4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_WatchBranchCI" name="Open the branch-watch bean">
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="watch" />
        <bootstrap.processes:skill ref="todo-manager" />
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>

      <bpmn:documentation>
        First dispatch point for a CI watcher: the feature branch has changed
        and a staging build now exists to watch. The watcher is DISPATCHED BY
        OPENING A BEAN, not by a workflow_dispatch: this is a task/workflow
        initiation.

        A bean makes the watch durable past the session that opened it: the
        container is reclaimed, and what survives is the bean. Starting the
        watcher and recording that it is running are ONE declared step, so the
        two cannot disagree about whether anything is watching.

        It notes the watch on the bean rather than claiming it: only
        Process_BeanOpen claims a bean. The note is idempotent, so re-entering
        on a later push does not duplicate it.
      </bpmn:documentation>
      <bpmn:incoming>p4</bpmn:incoming>
      <bpmn:outgoing>p4b</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Staged" name="Staged for review">
      <bpmn:incoming>p4b</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="p1" sourceRef="Start_Pipeline" targetRef="Task_BuildStaging" />
    <bpmn:sequenceFlow id="p2" sourceRef="Task_BuildStaging" targetRef="Task_DeployStaging" />
    <bpmn:sequenceFlow id="p3" sourceRef="Task_DeployStaging" targetRef="Task_CommentPR" />
    <bpmn:sequenceFlow id="p4" sourceRef="Task_CommentPR" targetRef="Task_WatchBranchCI" />
    <bpmn:sequenceFlow id="p4b" sourceRef="Task_WatchBranchCI" targetRef="End_Staged" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_ContentChangeReviewStage">
    <bpmndi:BPMNPlane id="BPMNPlane_ContentChangeReviewStage" bpmnElement="Collaboration_ContentChangeReviewStage">
      <bpmndi:BPMNShape id="Participant_ContentChangeReviewStage_di" bpmnElement="Participant_ContentChangeReviewStage" isHorizontal="true">
        <dc:Bounds x="100" y="80" width="1250" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pipeline_di" bpmnElement="Lane_Pipeline" isHorizontal="true">
        <dc:Bounds x="130" y="80" width="1220" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Pipeline_di" bpmnElement="Start_Pipeline">
        <dc:Bounds x="242" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildStaging_di" bpmnElement="Task_BuildStaging">
        <dc:Bounds x="370" y="95" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeployStaging_di" bpmnElement="Task_DeployStaging">
        <dc:Bounds x="540" y="95" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CommentPR_di" bpmnElement="Task_CommentPR">
        <dc:Bounds x="710" y="95" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WatchBranchCI_di" bpmnElement="Task_WatchBranchCI">
        <dc:Bounds x="880" y="95" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Staged_di" bpmnElement="End_Staged">
        <dc:Bounds x="1092" y="137" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="p1_di" bpmnElement="p1">
        <di:waypoint x="278" y="155" />
        <di:waypoint x="370" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p2_di" bpmnElement="p2">
        <di:waypoint x="490" y="155" />
        <di:waypoint x="540" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p3_di" bpmnElement="p3">
        <di:waypoint x="660" y="155" />
        <di:waypoint x="710" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p4_di" bpmnElement="p4">
        <di:waypoint x="830" y="155" />
        <di:waypoint x="880" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="p4b_di" bpmnElement="p4b">
        <di:waypoint x="1000" y="155" />
        <di:waypoint x="1092" y="155" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
