          <dc:Bounds x="218" y="387" width="110" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_MapCone_di" bpmnElement="Task_MapCone">
        <dc:Bounds x="330" y="305" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenRepin_di" bpmnElement="Task_OpenRepin">
        <dc:Bounds x="480" y="305" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Impact_di" bpmnElement="Task_Impact">
        <dc:Bounds x="630" y="495" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_Touches_di" bpmnElement="Gw_Touches" isMarkerVisible="true">
        <dc:Bounds x="780" y="530" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="836" y="482" width="110" height="44" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
