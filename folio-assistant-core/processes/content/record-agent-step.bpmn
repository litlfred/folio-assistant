<?xml version="1.0" encoding="UTF-8"?>
<!--
  folio-assistant — record one agent step on a change set.

  Source of truth: this file. Any SVG of it is generated by `bun run cat
  render:bpmn`; never hand-edit one.

  Called every time an agent moves on a change set of a review log: it picks
  the row up, proposes, opens or pushes the pull request, the preview goes
  live, or it answers new feedback. The Agent tab row is written first, then
  Feedback (agent) from it, then the sheet is read back, so a link never
  reaches Feedback (agent) without also reaching Staging review and Agentic
  status.
  Skills: review-sheet-agent-columns, review-sheet-script.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/v0/processes/ns/"
                  id="Definitions_RecordAgentStep"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:import namespace="https://litlfred.github.io/bootstrap/v0/processes/ns/" location="https://litlfred.github.io/bootstrap/v0/processes/ns.jsonld" importType="http://www.w3.org/ns/json-ld"/>
  <bpmn:resource id="authoring-agent" name="Authoring agent"/>

  <bpmn:collaboration id="Collaboration_RecordAgentStep">
    <bpmn:participant id="Participant_RecordAgentStep" name="Record agent step — one move on one change set" processRef="Process_RecordAgentStep" />
  </bpmn:collaboration>
  <bpmn:process id="Process_RecordAgentStep" name="Record agent step" isExecutable="false">
    <bpmn:documentation>
      The one way an agent reports a move on a change set. The sheet script
      builds Agentic status, Agentic status (filter) and Staging review from
      the Agent tab, and warns that no agent has picked a row up when the
      Agent step is missing or older than Ready for agent. Writing only
      Feedback (agent) leaves those columns stale, so it is never done alone.
    </bpmn:documentation>
    <bpmn:laneSet id="Process_RecordAgentStep_LaneSet">
      <bpmn:lane id="Lane_Agent" name="Authoring agent" partitionElementRef="authoring-agent">
        <bpmn:documentation>The agent working the change set (or the log watcher writing on its behalf). Writes the Agent row first, then Feedback (agent) from that row, and reads back the sheet so the copied columns agree.</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_Moved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteAgentRow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteFeedback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReadBack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Agrees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Recorded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_Moved" name="Agent moved on a change set">
      <bpmn:documentation>Picked the row up, proposed, opened or pushed its pull request, saw its preview go live, answered new feedback, or stopped and is waiting for people.</bpmn:documentation>
      <bpmn:outgoing>RS01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_WriteAgentRow" name="Write the change set's Agent row">
      <bpmn:documentation>On the Agent tab, the change set's row: Agentic status (Not started, Working, PR open, Ready for review, Change merged or Needs human); Pull request; Staging review page; Staging built, PR head, Staging built from and Staging deploy from `agent-record.ts push`; and Agent step from `agent-record.ts step &lt;name&gt;`, exactly "&lt;step&gt; &lt;YYYY-MM-DD HH:MMZ&gt;" with a step from the fixed list (reading, proposing, editing, pushing, staging, deploying, qa-review, merging, proposed, idle). Prose in Agent step is not read: use idle when the row waits for people. A preview or review link is written only once it is live: the GitHub Pages deploy of a gh-pages commit at or after the preview's publish has succeeded, and an HTTP GET of each link answers 200 where the agent can reach the site. A publish that is only on the gh-pages branch is not live: Pages deploys can be queued for many minutes or cancelled by the next push. Until then Staging review page stays empty, Staging deploy says deploying, and Feedback (agent) says &quot;Preview deploying&quot; with no preview link.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="review-sheet-agent-columns"/></bpmn:extensionElements>
      <bpmn:incoming>RS01</bpmn:incoming>
      <bpmn:incoming>RS05</bpmn:incoming>
      <bpmn:outgoing>RS02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_WriteFeedback" name="Write Feedback (agent) from that row">
      <bpmn:documentation>Feedback (agent) in the fixed layout (the ask first, then Status: and Next:), linking the same pull request and preview the Agent row now names. In a log one watcher owns, another thread sends the watcher its step and links instead of writing the sheet. A preview or review link is written only once it is live: the GitHub Pages deploy of a gh-pages commit at or after the preview's publish has succeeded, and an HTTP GET of each link answers 200 where the agent can reach the site. A publish that is only on the gh-pages branch is not live: Pages deploys can be queued for many minutes or cancelled by the next push. Until then Staging review page stays empty, Staging deploy says deploying, and Feedback (agent) says &quot;Preview deploying&quot; with no preview link.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="review-sheet-script"/></bpmn:extensionElements>
      <bpmn:incoming>RS02</bpmn:incoming>
      <bpmn:outgoing>RS03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ReadBack" name="Read back Agentic status and Staging review">
      <bpmn:documentation>After the script's next run, read the row's Agentic status, Agentic status (filter) and Staging review. They must name the pull request and preview that Feedback (agent) names, and show no "no agent has picked this up" warning.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="review-log-watch"/></bpmn:extensionElements>
      <bpmn:incoming>RS03</bpmn:incoming>
      <bpmn:outgoing>RS04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Agrees" name="Sheet agrees with Feedback (agent)?">
      <bpmn:incoming>RS04</bpmn:incoming>
      <bpmn:outgoing>RS05</bpmn:outgoing>
      <bpmn:outgoing>RS06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Recorded" name="Step recorded">
      <bpmn:incoming>RS06</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="RS01" sourceRef="StartEvent_Moved" targetRef="Task_WriteAgentRow" />
    <bpmn:sequenceFlow id="RS02" sourceRef="Task_WriteAgentRow" targetRef="Task_WriteFeedback" />
    <bpmn:sequenceFlow id="RS03" sourceRef="Task_WriteFeedback" targetRef="Task_ReadBack" />
    <bpmn:sequenceFlow id="RS04" sourceRef="Task_ReadBack" targetRef="Gateway_Agrees" />
    <bpmn:sequenceFlow id="RS05" name="no: fix the Agent row, never the copied columns" sourceRef="Gateway_Agrees" targetRef="Task_WriteAgentRow" />
    <bpmn:sequenceFlow id="RS06" name="yes" sourceRef="Gateway_Agrees" targetRef="EndEvent_Recorded" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_RecordAgentStep">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_RecordAgentStep">
      <bpmndi:BPMNShape id="Participant_RecordAgentStep_di" bpmnElement="Participant_RecordAgentStep" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="1012" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="60" width="982" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Moved_di" bpmnElement="StartEvent_Moved">
        <dc:Bounds x="220" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="180" y="179" width="116" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WriteAgentRow_di" bpmnElement="Task_WriteAgentRow">
        <dc:Bounds x="316" y="110" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WriteFeedback_di" bpmnElement="Task_WriteFeedback">
        <dc:Bounds x="496" y="110" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReadBack_di" bpmnElement="Task_ReadBack">
        <dc:Bounds x="676" y="110" width="120" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Agrees_di" bpmnElement="Gateway_Agrees" isMarkerVisible="true">
        <dc:Bounds x="856" y="130" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="816" y="90" width="130" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Recorded_di" bpmnElement="EndEvent_Recorded">
        <dc:Bounds x="1006" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="966" y="179" width="116" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="RS01_di" bpmnElement="RS01">
        <di:waypoint x="256" y="155" />
        <di:waypoint x="316" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="RS02_di" bpmnElement="RS02">
        <di:waypoint x="436" y="155" />
        <di:waypoint x="496" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="RS03_di" bpmnElement="RS03">
        <di:waypoint x="616" y="155" />
        <di:waypoint x="676" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="RS04_di" bpmnElement="RS04">
        <di:waypoint x="796" y="155" />
        <di:waypoint x="856" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="RS05_di" bpmnElement="RS05">
        <di:waypoint x="881" y="180" />
        <di:waypoint x="881" y="290" />
        <di:waypoint x="376" y="290" />
        <di:waypoint x="376" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="520" y="296" width="220" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="RS06_di" bpmnElement="RS06">
        <di:waypoint x="906" y="155" />
        <di:waypoint x="1006" y="155" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
