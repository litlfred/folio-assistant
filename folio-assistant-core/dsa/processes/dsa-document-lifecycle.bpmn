      <bpmndi:BPMNShape id="End_BeanNotYours_di" bpmnElement="End_BeanNotYours"><dc:Bounds x="702" y="523" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="557" y="242" width="130" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AgreeTerms_di" bpmnElement="Task_AgreeTerms"><dc:Bounds x="890" y="287" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_DraftMerge_di" bpmnElement="GW_DraftMerge" isMarkerVisible="true"><dc:Bounds x="1155" y="1026" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="760" y="514" width="130" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WriteText_di" bpmnElement="Task_WriteText"><dc:Bounds x="1350" y="991" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GW_Computable_di" bpmnElement="GW_Computable" isMarkerVisible="true"><dc:Bounds x="2535" y="1026" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1590" y="514" width="130" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DeriveOdrl_di" bpmnElement="Task_DeriveOdrl"><dc:Bounds x="2730" y="991" width="120" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckOdrl_di" bpmnElement="Task_CheckOdrl"><dc:Bounds x="2910" y="1185" width="120" height="120" /></bpmndi:BPMNShape>
