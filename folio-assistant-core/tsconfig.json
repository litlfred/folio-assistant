{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "adapters/**/*.ts",
    "scripts/**/*.ts",
    "schemas/**/*.ts",
    "skills/**/*.ts",
    "tools/**/*.ts",
    "validators/**/*.ts",
    "test/**/*.ts",
    "../cat-harness-tools/types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.e2e.ts"
  ]
}
