    "@vocab": "http://www.w3.org/ns/odrl/2/",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "cat-harness": "https://litlfred.github.io/cat-harness/v0/ns/"
  },
  "@type": "Set",
  "uid": "https://litlfred.github.io/folio-assistant-core/policies/content-agents",
  "profile": "https://litlfred.github.io/folio-assistant/ns/folio-odrl",
  "conflict": "odrl:prohibit",
  "permission": [
    {
      "assignee": "deep-researcher",
      "action": "content-authoring"
    },
    {
      "assignee": "evidence-agent",
      "action": "content-authoring"
    },
