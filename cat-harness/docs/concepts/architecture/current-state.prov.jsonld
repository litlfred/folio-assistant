      "@id": "docs/concepts/architecture/current-state.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "(header)",
      "prov:value": "> **All figures on this page were measured on `main` at `369d89e`, 2026-09-18**,\n> with the commands shown. They are a snapshot, not a contract: re-run the\n> command before quoting a number, per the `AGENTS.md` rule on BASELINE facts.",
      "cat-harness:refs": [
        "369d89e",
        "2026-09-18",
        "AGENTS.md BASELINE rule"
      ],
      "dcterms:date": [
        "2026-09-18"
      ]
    },
    {
      "@id": "docs/concepts/architecture/current-state.md#provenance-2",
