    {
      "@id": "docs/concepts/architecture/repo-taxonomy.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Why a taxonomy at all",
      "prov:value": "folio-assistant is a **self-documenting set of skills** that is today a mixture\nof two things: a *Content* repo and a *Tool* repo. That mixture is not a defect\nso much as an unexamined default — the platform grew by accreting whatever the\nfirst folio needed, and nothing forced the question *which kind of repo is this\nchange for?*",
      "cat-harness:refs": [
        "mixed Tool+Content repo"
      ]
    },
    {
      "@id": "docs/concepts/architecture/repo-taxonomy.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "The composition rule",
      "prov:value": "This is the rule the current\nrepo breaks most often, and the one the migration exists to enforce. Every\ngenericity failure recorded in `AGENTS.md` — a platform script naming\n`quantum-observable-universe`, a README generator carrying one folio's badges,\na module namespace hardcoded to `QOU.` — is the same violation: Tool code that\ncannot run without a particular Content repo.",
      "cat-harness:refs": [
        "AGENTS.md genericity failures",
        "QOU"
      ]
    },
    {
      "@id": "docs/concepts/architecture/repo-taxonomy.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "Splitting a mixed repo",
      "prov:value": "`smart-kg` and `smart-kg-tools` is the worked example from the issue",
      "cat-harness:refs": [
        "#223"
      ]
    },
    {
      "@id": "docs/concepts/architecture/repo-taxonomy.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Splitting a mixed repo",
      "prov:value": "**Where that example stands.** `smart-kg` is already its own repository. The\nowner, 2026-09-23: *\"that is its own repo already\"*. The stub `smart-kg/`\ndirectory that sat here was removed for that reason (bean `wg7r`), so nothing in\nthis checkout is `smart-kg` content.",
      "cat-harness:refs": [
        "bean wg7r",
        "2026-09-23"
      ],
      "dcterms:date": [
        "2026-09-23"
      ]
    }
  ]
