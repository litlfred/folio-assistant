    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#process/Process_VoiceReview",
      "@type": "bootstrap:Process",
      "conformsTo": [
        "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#externalSchema/omg-bpmn-2.0",
        "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#externalSchema/omg-dd-1.0"
      ],
      "depiction": "https://litlfred.github.io/folio-assistant/assets/img/workflows/voice-review.svg",
      "description": "The voice axis: load whichever editorial voices are active, run each rule's mechanical half, and decide — for each finding — whether the prose is wrong, the rule does not apply to this content, or this block is a stated exception.\n\nYou are in this process after the base voice has been adjudicated, and only if a voice is active at all: the first gateway ends the process honestly when none is, rather than reporting a clean review of nothing.\n\nThree outcomes, all legitimate, and the third is the one that needs recording: an exception without a reviewer entry is indistinguishable from a rule nobody ran. There is also a fourth path the diagram draws deliberately — if the rule's own citation does not support it, the RULE is the defect, and that becomes a bean rather than a finding against the prose.",
      "enforcement": "strict",
      "flowCount": 13,
      "inSubgraph": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#directory/processes",
      "name": "Voice overlay review",
      "nodeCount": 12,
      "sourcePath": "processes/content/voice-review.bpmn",
      "sourceUrl": "https://github.com/litlfred/folio-assistant/blob/main/cat-harness/processes/content/voice-review.bpmn",
      "startNode": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#process/Process_VoiceReview/node/Start_BaseVoiceDone",
      "summary": "The voice axis: load whichever editorial voices are active, run each rule's mechanical half, and decide — for each finding — whether the prose is wrong, the rule does not apply to this content, or this block is a stated exception."
    },
