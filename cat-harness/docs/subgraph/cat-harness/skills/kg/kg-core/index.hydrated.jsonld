    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#skill/corpus-grep",
      "@type": "bootstrap:Skill",
      "ambiguous": false,
      "description": "Pre-declaration corpus check. Before declaring any item \"open\", \"gap\", \"TODO\", \"open problem\", \"pending derivation\" — or asserting in chat that something is unresolved in the corpus — run the four-path grep checklist. A source file's `## Status` note lags the corpus by weeks; the corpus is the source of truth. An item is open only after all four paths come back empty (modulo the originating file itself).",
      "hasIOContract": false,
      "hasInstructions": true,
      "inPackage": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#package/kg-core",
