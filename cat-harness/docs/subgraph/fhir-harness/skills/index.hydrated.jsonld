          "name": "fhir-client-operations",
          "title": "fhir-client-operations"
        },
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#skill/smart-launch",
          "@type": "bootstrap:Skill",
          "ambiguous": false,
          "description": "How a browser app performs a SMART on FHIR launch — EHR launch and standalone launch — with the SMARTerFHIR library: `SmartLaunchHandler`, the `LAUNCH` and `EMR` enums, the scopes it requests per EHR vendor, how the redirect URI is computed, and where the token ends up. Written against a pinned upstream commit; read before wiring a launch page or a redirect page.",
          "hasIOContract": false,
          "hasInstructions": true,
          "inPackage": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#package/fhir-client",
          "instructionLines": 177,
          "instructionsPath": "../fhir-harness/skills/fhir-client/smart-launch.md",
          "name": "smart-launch",
          "title": "smart-launch"
        }
