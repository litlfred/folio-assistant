          "@id": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#skill/fhir-client-operations",
          "@type": "bootstrap:Skill",
          "ambiguous": false,
          "description": "Reading, searching and writing FHIR R4 resources through the SMARTerFHIR client (`BaseClient` and its vendor subclasses): the launch-context reads, `requestResource`, `create` with its automatic subject/encounter/context hydration, the per-vendor differences, how errors surface, and the operations the library does not have. Written against a pinned upstream commit; read before calling a FHIR server from a SMART app built on it.",
          "hasIOContract": false,
          "hasInstructions": true,
          "inPackage": "https://litlfred.github.io/folio-assistant/cat-harness.jsonld#package/fhir-client",
          "instructionLines": 150,
