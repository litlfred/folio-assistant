      "skos:prefLabel": [
        {
          "@value": "ActorDefinition.inherits"
        }
      ],
      "skos:definition": [
        {
          "@value": "This field carried a role lattice under an actor's name — `author` inherits `reviewer` inherits `viewer` — which is a property of a position, not of a person. The lattice now lives in `scenarios/roles.json` (`schemas/role-graph.ts`), where `inherits` means what it says. Optional so an unmigrated registry still validates."
        }
      ],
      "dcterms:source": "cat-harness/schemas/assistant-types.ts#ActorDefinition.inherits",
      "skos:note": "candidate"
