    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Declaration",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Declaration",
          "@language": "en"
        },
        {
          "@value": "الإعلان",
          "@language": "ar"
        },
        {
          "@value": "Declaración",
          "@language": "es"
        },
        {
          "@value": "Déclaration",
          "@language": "fr"
        },
        {
          "@value": "Декларация",
          "@language": "ru"
        },
        {
          "@value": "声明",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A JSON document, `<name>.json`, that gives a name and lists directory entries and file entries.",
          "@language": "en"
        },
        {
          "@value": "مستند JSON باسم `<name>.json` يحدّد اسماً ويسرد مُدخلات الأدلة ومُدخلات الملفات.",
          "@language": "ar"
        },
        {
          "@value": "Un documento JSON, `<name>.json`, que da un nombre y enumera entradas de directorio y entradas de archivo.",
          "@language": "es"
        },
        {
          "@value": "Un document JSON, `<name>.json`, qui donne un nom et énumère des entrées de répertoire et des entrées de fichier.",
          "@language": "fr"
        },
        {
          "@value": "Документ JSON, `<name>.json`, задающий имя и перечисляющий записи каталогов и записи файлов.",
          "@language": "ru"
        },
        {
          "@value": "一个 JSON 文档 `<name>.json`，给出名称并列出目录条目和文件条目。",
          "@language": "zh"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Declaration"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Extension",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Extension",
          "@language": "en"
        },
        {
          "@value": "الامتداد",
          "@language": "ar"
        },
        {
          "@value": "Extensión",
          "@language": "es"
        },
        {
          "@value": "Extension",
          "@language": "fr"
        },
        {
          "@value": "Расширение",
          "@language": "ru"
        },
        {
          "@value": "扩展",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A field of a Declaration, or of one of its entries, that is not defined here. A reader that does not recognise the field ignores it, and the rest of the Declaration keeps its meaning.",
          "@language": "en"
        },
        {
          "@value": "حقل في الإعلان، أو في أحد مُدخلاته، غير معرَّف هنا. القارئ الذي لا يتعرّف على الحقل يتجاهله، ويبقى باقي الإعلان على معناه.",
          "@language": "ar"
        },
        {
          "@value": "Un campo de una Declaración, o de una de sus entradas, que no se define aquí. Un lector que no reconoce el campo lo ignora, y el resto de la Declaración conserva su significado.",
          "@language": "es"
        },
        {
          "@value": "Un champ d'une Déclaration, ou de l'une de ses entrées, qui n'est pas défini ici. Un lecteur qui ne reconnaît pas le champ l'ignore, et le reste de la Déclaration garde son sens.",
          "@language": "fr"
        },
        {
          "@value": "Поле Декларации или одной из её записей, которое здесь не определено. Читатель, не распознающий поле, пропускает его, а остальная Декларация сохраняет своё значение.",
          "@language": "ru"
        },
        {
          "@value": "声明或其某条条目中未在此处定义的字段。不识别该字段的读取方会忽略它，声明的其余部分保持原意。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Declaration"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Extension"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Extension"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subgraph",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
