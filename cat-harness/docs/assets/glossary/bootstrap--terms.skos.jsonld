{
  "@context": {
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "dcterms": "http://purl.org/dc/terms/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#"
  },
  "@graph": [
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "Bootstrap terms",
      "skos:definition": "The terms Bootstrap defines, in order: each is defined only by terms above it, and never itself. Read from the schema that defines them, bootstrap/schemas/graph.schema.json, so this glossary cannot say anything that schema does not.",
      "dcterms:hasVersion": "0.1.0",
      "dcterms:source": "bootstrap/schemas/graph.schema.json"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Node"
        }
      ],
      "skos:definition": [
        {
          "@value": "One file, or one part of a file addressable by an IRI fragment, named by an IRI."
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.w3.org/TR/json-ld11/#node-objects"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Node"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/reference",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Reference"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node's naming of another Node by its IRI."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.rfc-editor.org/rfc/rfc3987"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Reference"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-schema",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Node Schema"
        }
      ],
      "skos:definition": [
        {
          "@value": "A schema a Node can be checked against: a JSON Schema, or a published external schema such as BPMN's."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "http://json-schema.org/draft-07/schema#"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/NodeSchema"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-kind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Node Kind"
        }
      ],
      "skos:definition": [
        {
          "@value": "A name paired with a Node Schema."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-schema"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/NodeKind"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/NodeKind"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/subkind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Subkind"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node Kind whose Node Schema requires everything another Node Kind's does, so every Node that satisfies it satisfies the other too."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-kind"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-schema"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Subkind"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Subkind"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Node Instance"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node that names its Node Kind, in `$schema` or front matter, and satisfies that kind's Node Schema."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-kind"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-schema"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/NodeInstance"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/NodeInstance"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/graph-kind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Graph Kind"
        }
      ],
      "skos:definition": [
        {
          "@value": "A named set of Node Kinds."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-kind"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/GraphKind"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/GraphKind"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/declaration",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "A JSON document, `<name>.json`, that gives a name and lists directory entries and file entries."
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Declaration"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/extension",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Extension"
        }
      ],
      "skos:definition": [
        {
          "@value": "A field of a Declaration, or of one of its entries, that is not defined here. A reader that does not recognise the field ignores it, and the rest of the Declaration keeps its meaning."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/declaration"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Extension"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Extension"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/subgraph",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Subgraph"
        }
      ],
      "skos:definition": [
        {
          "@value": "A directory entry of a Declaration: an id, a directory, and the Graph Kinds its Node Instances' kinds belong to."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/declaration"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/graph-kind"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Subgraph"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Subgraph"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/asset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Asset"
        }
      ],
      "skos:definition": [
        {
          "@value": "A file entry of a Declaration: one file about the repository itself, whose `role` field says what it is for."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/declaration"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Asset"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Asset"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/knowledge-graph",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Knowledge Graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Node Schemas, Node Instances and Assets one Declaration lists, as of one version of the repository. Published as JSON-LD, the statements of each Subgraph's Node Instances form one named graph."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-schema"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/asset"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/declaration"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/subgraph"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/KnowledgeGraph"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/dependency",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Dependency"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Declaration's `needs` entry naming another Knowledge Graph. References may point from this graph's Node Instances into the named one, never back."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/declaration"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/knowledge-graph"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/reference"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Dependency"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Dependency"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/content",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Content"
        }
      ],
      "skos:definition": [
        {
          "@value": "Node Instances that describe the subject matter of a Knowledge Graph, such as records, documents, catalogues and their terms, rather than how to work with it."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/knowledge-graph"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Content"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Content"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/task",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Task"
        }
      ],
      "skos:definition": [
        {
          "@value": "A unit of work, stated by what it needs to begin and what it produces."
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.omg.org/spec/BPMN/2.0/#task"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Task"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/actor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Actor"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person, an agent or a program that can carry out Tasks."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/task"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "http://www.w3.org/ns/prov#Agent"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Actor"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/skill",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Skill"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node Instance holding natural-language instructions an Actor follows to carry out a Task."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/actor"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/task"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Skill"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Skill"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/role",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Role"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node Instance naming a part an Actor takes on to carry out Tasks, and listing the Skills that part needs."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/actor"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/task"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/skill"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Role"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Role"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/process-node",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Process Node"
        }
      ],
      "skos:definition": [
        {
          "@value": "A BPMN flow node: an activity (a task or call activity), a gateway, or an event."
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.omg.org/spec/BPMN/2.0/#flowNode"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/ProcessNode"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/sequence-flow",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Sequence Flow"
        }
      ],
      "skos:definition": [
        {
          "@value": "A directed connection in a BPMN process from one Process Node to the next."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/process-node"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.omg.org/spec/BPMN/2.0/#sequenceFlow"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/SequenceFlow"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/process",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Process"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node Instance holding a BPMN process that coordinates Tasks: its Process Nodes, joined by Sequence Flows, sit in lanes that each name a Role."
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/task"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/process-node"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/sequence-flow"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/role"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.omg.org/spec/BPMN/2.0/#process"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Process"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/harness",
      "@type": "skos:Concept",
