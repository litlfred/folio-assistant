        },
        {
          "@value": "الرسم البياني الفرعي",
          "@language": "ar"
        },
        {
          "@value": "Subgrafo",
          "@language": "es"
        },
        {
          "@value": "Sous-graphe",
          "@language": "fr"
        },
        {
          "@value": "Подграф",
          "@language": "ru"
        },
        {
          "@value": "子图",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A directory entry of a Declaration: an id, a directory, and the Graph Typologies its Node Instances' kinds belong to.",
          "@language": "en"
        },
        {
          "@value": "مُدخل دليل في الإعلان: معرّف ودليل وأنواع الرسوم البيانية التي تنتمي إليها أنواع مثيلات العقدة فيه.",
          "@language": "ar"
        },
        {
          "@value": "Una entrada de directorio de una Declaración: un id, un directorio y los Tipos de grafo a los que pertenecen los tipos de sus Instancias de nodo.",
          "@language": "es"
        },
        {
          "@value": "Une entrée de répertoire d'une Déclaration : un id, un répertoire et les Types de graphe auxquels appartiennent les types de ses Instances de nœud.",
          "@language": "fr"
        },
        {
          "@value": "Запись каталога в Декларации: id, каталог и Виды графов, к которым относятся виды его Экземпляров узла.",
          "@language": "ru"
        },
        {
          "@value": "声明中的一条目录条目：一个 id、一个目录，以及其节点实例的类型所属的图类型。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Declaration"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#GraphTypology"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeInstance"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Subgraph"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Subgraph"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Asset",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Asset",
          "@language": "en"
        },
        {
          "@value": "الأصل",
          "@language": "ar"
        },
        {
          "@value": "Recurso",
          "@language": "es"
        },
        {
          "@value": "Ressource",
          "@language": "fr"
        },
        {
          "@value": "Ресурс",
          "@language": "ru"
        },
        {
          "@value": "资产",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A file entry of a Declaration: one file about the repository itself, whose `role` field says what it is for.",
          "@language": "en"
        },
        {
          "@value": "مُدخل ملف في الإعلان: ملف واحد عن المستودع نفسه، يبيّن حقلُه `role` الغرضَ منه.",
          "@language": "ar"
        },
        {
          "@value": "Una entrada de archivo de una Declaración: un archivo sobre el propio repositorio, cuyo campo `role` indica para qué sirve.",
          "@language": "es"
        },
        {
          "@value": "Une entrée de fichier d'une Déclaration : un fichier concernant le dépôt lui-même, dont le champ `role` indique à quoi il sert.",
          "@language": "fr"
        },
        {
          "@value": "Запись файла в Декларации: один файл о самом репозитории, поле `role` которого говорит, для чего он нужен.",
          "@language": "ru"
        },
        {
          "@value": "声明中的一条文件条目：关于仓库本身的一个文件，其 `role` 字段说明它的用途。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Declaration"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Asset"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Asset"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#KnowledgeGraph",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Knowledge Graph",
          "@language": "en"
        },
        {
          "@value": "الرسم البياني المعرفي",
          "@language": "ar"
        },
        {
          "@value": "Grafo de conocimiento",
          "@language": "es"
        },
        {
          "@value": "Graphe de connaissances",
          "@language": "fr"
        },
        {
          "@value": "Граф знаний",
          "@language": "ru"
        },
        {
          "@value": "知识图谱",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "The Node Schemas, Node Instances and Assets one Declaration lists, as of one version of the repository. Published as JSON-LD, the statements of each Subgraph's Node Instances form one named graph.",
          "@language": "en"
        },
        {
          "@value": "مخططات العقد ومثيلات العقد والأصول التي يسردها إعلان واحد، بحسب نسخة واحدة من المستودع. وعند نشرها بصيغة JSON-LD، تشكّل عبارات مثيلات العقدة في كل رسم بياني فرعي رسماً بيانياً مسمّى واحداً.",
          "@language": "ar"
        },
        {
          "@value": "Los Esquemas de nodo, las Instancias de nodo y los Recursos que enumera una Declaración, en una versión dada del repositorio. Publicadas como JSON-LD, las afirmaciones de las Instancias de nodo de cada Subgrafo forman un grafo con nombre.",
          "@language": "es"
        },
        {
          "@value": "Les Schémas de nœud, les Instances de nœud et les Ressources qu'énumère une Déclaration, pour une version donnée du dépôt. Publiées en JSON-LD, les assertions des Instances de nœud de chaque Sous-graphe forment un graphe nommé.",
          "@language": "fr"
        },
        {
          "@value": "Схемы узлов, Экземпляры узлов и Ресурсы, перечисленные в одной Декларации, на одну версию репозитория. При публикации в JSON-LD утверждения Экземпляров узла каждого Подграфа образуют один именованный граф.",
          "@language": "ru"
        },
        {
          "@value": "一份声明所列出的节点模式、节点实例和资产，对应仓库的某一版本。以 JSON-LD 发布时，每个子图的节点实例中的陈述构成一个具名图。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeSchema"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeInstance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Asset"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Declaration"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subgraph"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/KnowledgeGraph"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Dependency",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Dependency",
          "@language": "en"
        },
        {
          "@value": "التبعية",
          "@language": "ar"
        },
        {
          "@value": "Dependencia",
          "@language": "es"
        },
        {
          "@value": "Dépendance",
          "@language": "fr"
        },
        {
          "@value": "Зависимость",
          "@language": "ru"
        },
        {
          "@value": "依赖",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Declaration's `needs` entry naming another Knowledge Graph. References may point from this graph's Node Instances into the named one, never back.",
          "@language": "en"
        },
        {
          "@value": "مُدخل `needs` في الإعلان يسمّي رسماً بيانياً معرفياً آخر. يجوز أن تشير المراجع من مثيلات العقدة في هذا الرسم إلى الرسم المسمّى، ولا يجوز العكس أبداً.",
          "@language": "ar"
        },
        {
          "@value": "Una entrada `needs` de una Declaración que nombra otro Grafo de conocimiento. Las Referencias pueden apuntar desde las Instancias de nodo de este grafo hacia el nombrado, nunca en sentido inverso.",
          "@language": "es"
        },
        {
          "@value": "Une entrée `needs` d'une Déclaration qui nomme un autre Graphe de connaissances. Les Références peuvent pointer des Instances de nœud de ce graphe vers celui qui est nommé, jamais en sens inverse.",
          "@language": "fr"
        },
        {
          "@value": "Запись `needs` Декларации, называющая другой Граф знаний. Ссылки могут вести от Экземпляров узла этого графа к названному, но никогда обратно.",
          "@language": "ru"
        },
        {
          "@value": "声明中的一条 `needs` 条目，用于指明另一个知识图谱。引用可以从本图谱的节点实例指向所指明的图谱，绝不反向。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Declaration"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#KnowledgeGraph"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Reference"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeInstance"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Dependency"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Dependency"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Content",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Content",
          "@language": "en"
        },
        {
          "@value": "المحتوى",
          "@language": "ar"
        },
        {
          "@value": "Contenido",
          "@language": "es"
        },
        {
          "@value": "Contenu",
          "@language": "fr"
        },
        {
          "@value": "Содержимое",
          "@language": "ru"
        },
        {
          "@value": "内容",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "Node Instances that describe the subject matter of a Knowledge Graph, such as records, documents, catalogues and their terms, rather than how to work with it.",
          "@language": "en"
        },
        {
          "@value": "مثيلات عقدة تصف موضوع الرسم البياني المعرفي، كالسجلات والمستندات والفهارس ومصطلحاتها، لا طريقة العمل به.",
          "@language": "ar"
        },
        {
          "@value": "Instancias de nodo que describen el objeto de un Grafo de conocimiento, como registros, documentos, catálogos y sus términos, y no cómo trabajar con él.",
          "@language": "es"
        },
        {
          "@value": "Instances de nœud qui décrivent l'objet d'un Graphe de connaissances, comme des enregistrements, des documents, des catalogues et leurs termes, plutôt que la manière de travailler avec lui.",
          "@language": "fr"
        },
        {
          "@value": "Экземпляры узла, описывающие предмет Графа знаний, — записи, документы, каталоги и их термины, — а не то, как с ним работать.",
          "@language": "ru"
        },
        {
          "@value": "描述知识图谱主题内容的节点实例，例如记录、文档、目录及其术语，而不是如何使用该图谱。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeInstance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#KnowledgeGraph"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Content"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Content"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Task",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Task",
          "@language": "en"
        },
        {
          "@value": "المهمة",
          "@language": "ar"
        },
        {
          "@value": "Tarea",
          "@language": "es"
        },
        {
          "@value": "Tâche",
          "@language": "fr"
        },
        {
          "@value": "Задача",
          "@language": "ru"
        },
        {
          "@value": "任务",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A unit of work, stated by what it needs to begin and what it produces.",
          "@language": "en"
        },
        {
          "@value": "وحدة عمل، تُوصَف بما تحتاجه لتبدأ وبما تُنتجه.",
          "@language": "ar"
        },
        {
          "@value": "Una unidad de trabajo, expresada por lo que necesita para comenzar y lo que produce.",
          "@language": "es"
        },
        {
          "@value": "Une unité de travail, énoncée par ce dont elle a besoin pour commencer et ce qu'elle produit.",
          "@language": "fr"
        },
        {
          "@value": "Единица работы, описанная тем, что ей нужно для начала, и тем, что она производит.",
          "@language": "ru"
        },
        {
          "@value": "一个工作单元，以其开始所需和产出来描述。",
          "@language": "zh"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.omg.org/spec/BPMN/2.0/#task"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Task"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Actor",
          "@language": "en"
        },
        {
          "@value": "الفاعل",
          "@language": "ar"
        },
        {
          "@value": "Actor",
          "@language": "es"
        },
        {
          "@value": "Acteur",
          "@language": "fr"
        },
        {
          "@value": "Актор",
          "@language": "ru"
        },
        {
          "@value": "行动者",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person, an agent or a program that can carry out Tasks.",
          "@language": "en"
        },
        {
          "@value": "شخص أو وكيل أو برنامج قادر على تنفيذ المهام.",
          "@language": "ar"
        },
        {
          "@value": "Una persona, un agente o un programa que puede llevar a cabo Tareas.",
          "@language": "es"
        },
        {
          "@value": "Une personne, un agent ou un programme capable d'accomplir des Tâches.",
          "@language": "fr"
        },
        {
          "@value": "Человек, агент или программа, способные выполнять Задачи.",
          "@language": "ru"
        },
        {
          "@value": "能够执行任务的人、智能体或程序。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Task"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "http://www.w3.org/ns/prov#Agent"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Actor"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Skill",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Skill",
          "@language": "en"
        },
        {
          "@value": "المهارة",
          "@language": "ar"
        },
        {
          "@value": "Habilidad",
          "@language": "es"
        },
        {
          "@value": "Compétence",
          "@language": "fr"
        },
        {
          "@value": "Навык",
          "@language": "ru"
        },
        {
          "@value": "技能",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node Instance holding natural-language instructions an Actor follows to carry out a Task.",
          "@language": "en"
        },
        {
          "@value": "مثيل عقدة يحوي تعليمات بلغة طبيعية يتّبعها الفاعل لتنفيذ مهمة.",
          "@language": "ar"
        },
        {
          "@value": "Una Instancia de nodo que contiene instrucciones en lenguaje natural que un Actor sigue para llevar a cabo una Tarea.",
          "@language": "es"
        },
        {
          "@value": "Une Instance de nœud contenant des instructions en langage naturel qu'un Acteur suit pour accomplir une Tâche.",
          "@language": "fr"
        },
        {
          "@value": "Экземпляр узла, содержащий инструкции на естественном языке, которым Актор следует при выполнении Задачи.",
          "@language": "ru"
        },
        {
          "@value": "包含自然语言指令的节点实例，行动者按照这些指令执行任务。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeInstance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Task"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Skill"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Skill"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Role",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Role",
          "@language": "en"
        },
        {
          "@value": "الدور",
          "@language": "ar"
        },
        {
          "@value": "Rol",
          "@language": "es"
        },
        {
          "@value": "Rôle",
          "@language": "fr"
        },
        {
          "@value": "Роль",
          "@language": "ru"
        },
        {
          "@value": "角色",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node Instance naming a part an Actor takes on to carry out Tasks, and listing the Skills that part needs.",
          "@language": "en"
        },
        {
          "@value": "مثيل عقدة يسمّي دوراً يتولّاه الفاعل لتنفيذ المهام، ويسرد المهارات التي يحتاجها ذلك الدور.",
          "@language": "ar"
        },
        {
          "@value": "Una Instancia de nodo que nombra un papel que un Actor asume para llevar a cabo Tareas y enumera las Habilidades que ese papel necesita.",
          "@language": "es"
        },
        {
          "@value": "Une Instance de nœud qui nomme un rôle qu'un Acteur endosse pour accomplir des Tâches et énumère les Compétences dont ce rôle a besoin.",
          "@language": "fr"
        },
        {
          "@value": "Экземпляр узла, называющий роль, которую Актор принимает на себя для выполнения Задач, и перечисляющий Навыки, необходимые для этой роли.",
          "@language": "ru"
        },
        {
          "@value": "命名行动者为执行任务所担任的职责，并列出该职责所需技能的节点实例。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeInstance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Task"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Skill"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Role"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Role"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#ProcessNode",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Process Node",
          "@language": "en"
        },
        {
          "@value": "عقدة العملية",
          "@language": "ar"
        },
        {
          "@value": "Nodo de proceso",
          "@language": "es"
        },
        {
          "@value": "Nœud de processus",
          "@language": "fr"
        },
        {
          "@value": "Узел процесса",
          "@language": "ru"
        },
        {
          "@value": "流程节点",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A BPMN flow node: an activity (a task or call activity), a gateway, or an event.",
          "@language": "en"
        },
        {
          "@value": "عقدة تدفق BPMN: نشاط (مهمة أو نشاط استدعاء) أو بوابة أو حدث.",
          "@language": "ar"
        },
        {
          "@value": "Un nodo de flujo BPMN: una actividad (una tarea o una actividad de llamada), una compuerta o un evento.",
          "@language": "es"
        },
        {
          "@value": "Un nœud de flux BPMN : une activité (une tâche ou une activité d'appel), une passerelle ou un événement.",
          "@language": "fr"
        },
        {
          "@value": "Узел потока BPMN: действие (задача или вызывающее действие), шлюз или событие.",
          "@language": "ru"
        },
        {
          "@value": "BPMN 流节点：一个活动（任务或调用活动）、一个网关或一个事件。",
          "@language": "zh"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.omg.org/spec/BPMN/2.0/#flowNode"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/ProcessNode"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#SequenceFlow",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Sequence Flow",
          "@language": "en"
        },
        {
          "@value": "تدفق التسلسل",
          "@language": "ar"
        },
        {
          "@value": "Flujo de secuencia",
          "@language": "es"
        },
        {
          "@value": "Flux de séquence",
          "@language": "fr"
        },
        {
          "@value": "Поток последовательности",
          "@language": "ru"
        },
        {
          "@value": "顺序流",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A directed connection in a BPMN process from one Process Node to the next.",
          "@language": "en"
        },
        {
          "@value": "وصلة موجّهة في عملية BPMN من عقدة عملية إلى التي تليها.",
          "@language": "ar"
        },
        {
          "@value": "Una conexión dirigida en un proceso BPMN de un Nodo de proceso al siguiente.",
          "@language": "es"
        },
        {
          "@value": "Une connexion orientée dans un processus BPMN, d'un Nœud de processus au suivant.",
          "@language": "fr"
        },
        {
          "@value": "Направленная связь в процессе BPMN от одного Узла процесса к следующему.",
          "@language": "ru"
        },
        {
          "@value": "BPMN 流程中从一个流程节点到下一个流程节点的有向连接。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#ProcessNode"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.omg.org/spec/BPMN/2.0/#sequenceFlow"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/SequenceFlow"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Process",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Process",
          "@language": "en"
        },
        {
          "@value": "العملية",
          "@language": "ar"
        },
        {
          "@value": "Proceso",
          "@language": "es"
        },
        {
          "@value": "Processus",
          "@language": "fr"
        },
        {
          "@value": "Процесс",
          "@language": "ru"
        },
        {
          "@value": "流程",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node Instance holding a BPMN process that coordinates Tasks: its Process Nodes, joined by Sequence Flows, sit in lanes that each name a Role.",
          "@language": "en"
        },
        {
          "@value": "مثيل عقدة يحوي عملية BPMN تنسّق المهام: تقع عُقد العملية فيها، المرتبطة بتدفقات التسلسل، في مسارات يسمّي كلٌّ منها دوراً.",
          "@language": "ar"
        },
        {
          "@value": "Una Instancia de nodo que contiene un proceso BPMN que coordina Tareas: sus Nodos de proceso, unidos por Flujos de secuencia, se sitúan en carriles que nombran cada uno un Rol.",
          "@language": "es"
        },
        {
          "@value": "Une Instance de nœud contenant un processus BPMN qui coordonne des Tâches : ses Nœuds de processus, reliés par des Flux de séquence, se trouvent dans des couloirs qui nomment chacun un Rôle.",
          "@language": "fr"
        },
        {
          "@value": "Экземпляр узла, содержащий процесс BPMN, который координирует Задачи: его Узлы процесса, соединённые Потоками последовательности, расположены на дорожках, каждая из которых называет Роль.",
          "@language": "ru"
        },
        {
          "@value": "包含协调任务的 BPMN 流程的节点实例：其流程节点由顺序流连接，位于各自指明一个角色的泳道中。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeInstance"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Task"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#ProcessNode"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#SequenceFlow"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Role"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.omg.org/spec/BPMN/2.0/#process"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Process"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Harness",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Harness",
          "@language": "en"
        },
        {
          "@value": "الإطار",
          "@language": "ar"
        },
        {
          "@value": "Arnés",
          "@language": "es"
        },
        {
          "@value": "Harnais",
          "@language": "fr"
        },
        {
          "@value": "Обвязка",
          "@language": "ru"
        },
        {
          "@value": "工具框架",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Knowledge Graph whose Subgraphs hold Skills, Roles or Processes: what an Actor uses to work with a Knowledge Graph, including itself.",
          "@language": "en"
        },
        {
          "@value": "رسم بياني معرفي تحوي رسومه البيانية الفرعية مهارات أو أدواراً أو عمليات: ما يستخدمه الفاعل للعمل مع رسم بياني معرفي، بما في ذلك هذا الرسم نفسه.",
          "@language": "ar"
        },
        {
          "@value": "Un Grafo de conocimiento cuyos Subgrafos contienen Habilidades, Roles o Procesos: aquello que un Actor usa para trabajar con un Grafo de conocimiento, incluido él mismo.",
          "@language": "es"
        },
        {
          "@value": "Un Graphe de connaissances dont les Sous-graphes contiennent des Compétences, des Rôles ou des Processus : ce qu'un Acteur utilise pour travailler avec un Graphe de connaissances, y compris lui-même.",
          "@language": "fr"
        },
        {
          "@value": "Граф знаний, Подграфы которого содержат Навыки, Роли или Процессы: то, чем Актор пользуется для работы с Графом знаний, включая сам этот граф.",
          "@language": "ru"
        },
        {
          "@value": "其子图包含技能、角色或流程的知识图谱：行动者用来处理知识图谱（包括其自身）的工具。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#KnowledgeGraph"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subgraph"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Skill"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Role"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Process"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Actor"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Harness"
    },
