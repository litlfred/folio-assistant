      ],
      "skos:definition": [
        {
          "@value": "A Node's naming of another Node by its IRI.",
          "@language": "en"
        },
        {
          "@value": "تسمية عقدةٍ لعقدة أخرى بواسطة معرّف IRI الخاص بها.",
          "@language": "ar"
        },
        {
          "@value": "La designación que un Nodo hace de otro Nodo por su IRI.",
          "@language": "es"
        },
        {
          "@value": "La désignation d'un Nœud par un autre Nœud au moyen de son IRI.",
          "@language": "fr"
        },
        {
          "@value": "Указание одним Узлом на другой Узел по его IRI.",
          "@language": "ru"
        },
        {
          "@value": "一个节点通过 IRI 对另一个节点的指称。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Node"
        }
