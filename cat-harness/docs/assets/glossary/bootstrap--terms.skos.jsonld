    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Subkind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Subkind",
          "@language": "en"
        },
        {
          "@value": "النوع الفرعي",
          "@language": "ar"
        },
        {
          "@value": "Subtipo",
          "@language": "es"
        },
        {
          "@value": "Sous-type",
          "@language": "fr"
        },
        {
          "@value": "Подвид",
          "@language": "ru"
        },
        {
          "@value": "子类型",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node Kind whose Node Schema requires everything another Node Kind's does, so every Node that satisfies it satisfies the other too.",
          "@language": "en"
        },
        {
          "@value": "نوع عقدة يتطلّب مخططها كل ما يتطلّبه مخطط نوع عقدة آخر، فكل عقدة تستوفيه تستوفي الآخر أيضاً.",
          "@language": "ar"
        },
        {
          "@value": "Un Tipo de nodo cuyo Esquema de nodo exige todo lo que exige el de otro Tipo de nodo, de modo que todo Nodo que lo satisface satisface también el otro.",
          "@language": "es"
        },
        {
          "@value": "Un Type de nœud dont le Schéma de nœud exige tout ce qu'exige celui d'un autre Type de nœud, de sorte que tout Nœud qui le satisfait satisfait aussi l'autre.",
          "@language": "fr"
        },
        {
          "@value": "Вид узла, Схема узла которого требует всего, что требует схема другого Вида узла, так что любой Узел, удовлетворяющий ей, удовлетворяет и другой.",
          "@language": "ru"
        },
        {
          "@value": "一种节点类型，其节点模式要求另一节点类型的全部要求，因此满足它的每个节点也满足另一类型。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeKind"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeSchema"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Node"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/schemas/graph.schema.json#/$defs/Subkind"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Subkind"
    },
    {
      "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeInstance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms"
      },
      "skos:prefLabel": [
        {
          "@value": "Node Instance",
          "@language": "en"
        },
        {
          "@value": "مثيل العقدة",
          "@language": "ar"
        },
        {
          "@value": "Instancia de nodo",
          "@language": "es"
        },
        {
          "@value": "Instance de nœud",
          "@language": "fr"
        },
        {
          "@value": "Экземпляр узла",
          "@language": "ru"
        },
        {
          "@value": "节点实例",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A Node that names its Node Kind, in `$schema` or front matter, and satisfies that kind's Node Schema.",
          "@language": "en"
        },
        {
          "@value": "عقدة تسمّي نوع عقدتها في `$schema` أو في الترويسة، وتستوفي مخطط العقدة لذلك النوع.",
          "@language": "ar"
        },
        {
          "@value": "Un Nodo que nombra su Tipo de nodo, en `$schema` o en el preámbulo, y satisface el Esquema de nodo de ese tipo.",
          "@language": "es"
        },
        {
          "@value": "Un Nœud qui nomme son Type de nœud, dans `$schema` ou dans l'en-tête, et satisfait le Schéma de nœud de ce type.",
          "@language": "fr"
        },
        {
          "@value": "Узел, указывающий свой Вид узла в `$schema` или во вводном блоке и удовлетворяющий Схеме узла этого вида.",
          "@language": "ru"
        },
        {
          "@value": "在 `$schema` 或前置元数据中指明其节点类型，并满足该类型节点模式的节点。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#Node"
        },
        {
          "@id": "https://litlfred.github.io/bootstrap/0.1.0/ns#NodeKind"
        },
