          "@value": "图类型",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "A named set of Node Kinds.",
          "@language": "en"
        },
        {
          "@value": "مجموعة مسمّاة من أنواع العقد.",
          "@language": "ar"
        },
        {
          "@value": "Un conjunto con nombre de Tipos de nodo.",
          "@language": "es"
        },
        {
          "@value": "Un ensemble nommé de Types de nœud.",
          "@language": "fr"
        },
        {
          "@value": "Именованный набор Видов узлов.",
          "@language": "ru"
        },
        {
          "@value": "一组具名的节点类型。",
          "@language": "zh"
        }
      ],
      "dcterms:requires": [
