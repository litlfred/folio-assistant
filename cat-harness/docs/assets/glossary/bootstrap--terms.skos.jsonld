        {
          "@value": "节点",
          "@language": "zh"
        }
      ],
      "skos:definition": [
        {
          "@value": "One file, or one part of a file addressable by an IRI fragment, named by an IRI.",
          "@language": "en"
        },
        {
          "@value": "ملف، أو جزء من ملف يمكن الوصول إليه بجزء IRI، يُسمّى بمعرّف IRI.",
          "@language": "ar"
        },
        {
          "@value": "Un archivo, o una parte de un archivo direccionable mediante un fragmento de IRI, nombrado por un IRI.",
          "@language": "es"
        },
        {
          "@value": "Un fichier, ou une partie de fichier adressable par un fragment d'IRI, nommé par un IRI.",
          "@language": "fr"
        },
        {
          "@value": "Файл или часть файла, адресуемая фрагментом IRI, названные с помощью IRI.",
          "@language": "ru"
        },
        {
          "@value": "由 IRI 命名的一个文件，或可通过 IRI 片段寻址的文件的一部分。",
          "@language": "zh"
        }
      ],
      "rdfs:isDefinedBy": {
        "@id": "https://www.w3.org/TR/json-ld11/#node-objects"
      },
      "dcterms:source": "bootstrap/schemas/graph.schema.json#/$defs/Node"
