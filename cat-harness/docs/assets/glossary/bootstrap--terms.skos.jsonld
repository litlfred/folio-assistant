      "skos:definition": [
        {
          "@value": "A name paired with a Node Schema.",
          "@language": "en"
        },
        {
          "@value": "اسم مقترن بمخطط عقدة.",
          "@language": "ar"
        },
        {
          "@value": "Un nombre emparejado con un Esquema de nodo.",
          "@language": "es"
        },
        {
          "@value": "Un nom associé à un Schéma de nœud.",
          "@language": "fr"
        },
        {
          "@value": "Имя, сопоставленное со Схемой узла.",
          "@language": "ru"
        },
        {
          "@value": "与一个节点模式配对的名称。",
          "@language": "zh"
