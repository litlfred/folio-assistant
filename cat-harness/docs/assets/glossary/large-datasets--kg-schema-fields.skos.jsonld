      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "Schema fields, extracted (large-datasets)",
      "skos:definition": "Candidate terms extracted from every schema field with a doc comment: `<Declaration>.<field>` as the label, the comment's first paragraph as the definition. Generated by folio-assistant-core/scripts/glossary-extract.ts; not curated, and never hand-edited: a person promotes a term by authoring it in a glossary of their own.",
      "dcterms:source": "Schema fields of large-datasets"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/artifact-store.artifactstoreschema.basis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "ArtifactStoreSchema.basis"
        }
      ],
      "skos:definition": [
        {
          "@value": "Why this store, in one sentence — it is a choice, and a choice with no reason cannot be revisited."
        }
      ],
      "dcterms:source": "large-datasets/schemas/artifact-store.ts#ArtifactStoreSchema.basis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/artifact-store.artifactstoreschema.cachettlseconds",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "ArtifactStoreSchema.cacheTtlSeconds"
        }
      ],
      "skos:definition": [
        {
          "@value": "What a CDN in front of this store will hold onto. Absent means unstated, never zero."
        }
      ],
      "dcterms:source": "large-datasets/schemas/artifact-store.ts#ArtifactStoreSchema.cacheTtlSeconds",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/artifact-store.artifactstoreschema.immutableurls",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "ArtifactStoreSchema.immutableUrls"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whether the store's URLs are immutable once published. `true` means a re-publish MUST use a new path; `false` means readers may be served a cached old copy for up to `cacheTtlSeconds`."
        }
      ],
      "dcterms:source": "large-datasets/schemas/artifact-store.ts#ArtifactStoreSchema.immutableUrls",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/artifact-store.artifactstoreschema.maxartifactbytes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "ArtifactStoreSchema.maxArtifactBytes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Largest single artifact, where the host states one. Absent means unstated, never unlimited."
        }
      ],
      "dcterms:source": "large-datasets/schemas/artifact-store.ts#ArtifactStoreSchema.maxArtifactBytes",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/artifact-store.artifactstoreschema.publicbaseurl",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "ArtifactStoreSchema.publicBaseUrl"
        }
      ],
      "skos:definition": [
        {
          "@value": "The base the artifact will be READABLE at. Required, and it is the \"EXTREME care in URL handling\" clause in schema form: a published URL is a promise, and the address has to be decided before the upload rather than discovered from whatever the host returned."
        }
      ],
      "dcterms:source": "large-datasets/schemas/artifact-store.ts#ArtifactStoreSchema.publicBaseUrl",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/source-descriptor.identifiersystemschema.authoritative",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "IdentifierSystemSchema.authoritative"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whether this identifier is guaranteed by an authority outside the source. A Handle is; a DSpace UUID is the source's own; a local slug is neither. The distinction decides which identifier survives the source moving, and IRIS is the worked case — one of its two handles points at a regional instance that was merged away."
        }
      ],
      "dcterms:source": "large-datasets/schemas/source-descriptor.ts#IdentifierSystemSchema.authoritative",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/source-descriptor.sourcedescriptorschema.character",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "SourceDescriptorSchema.character"
        }
      ],
      "skos:definition": [
        {
          "@value": "The characterisation the \"ingest a new data source\" process produces. Required — these are what decide how the source may be REFERENCED, and a descriptor that has not said cannot answer that question."
        }
      ],
      "dcterms:source": "large-datasets/schemas/source-descriptor.ts#SourceDescriptorSchema.character",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/source-descriptor.sourcedescriptorschema.nodekind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "SourceDescriptorSchema.nodeKind"
        }
      ],
      "skos:definition": [
        {
          "@value": "What one node IS in this corpus. Different per source, and never assumed."
        }
      ],
      "dcterms:source": "large-datasets/schemas/source-descriptor.ts#SourceDescriptorSchema.nodeKind",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/source-descriptor.sourcedescriptorschema.subsetbasis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "SourceDescriptorSchema.subsetBasis"
        }
      ],
      "skos:definition": [
        {
          "@value": "Why `subsetIsSelfContained` has the value it has. Optional, because a self-contained source (IRIS: fetch an item and you have it) has little to say; the `false` case is the one that needs its reason recorded."
        }
      ],
      "dcterms:source": "large-datasets/schemas/source-descriptor.ts#SourceDescriptorSchema.subsetBasis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/source-descriptor.sourcedescriptorschema.subsetisselfcontained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "SourceDescriptorSchema.subsetIsSelfContained"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whether a subset chosen by the strategies above stands on its own. `false` means every request must be closed over dependencies first."
        }
      ],
      "dcterms:source": "large-datasets/schemas/source-descriptor.ts#SourceDescriptorSchema.subsetIsSelfContained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/source-descriptor.sourcedescriptorschema.system",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "SourceDescriptorSchema.system"
        }
      ],
      "skos:definition": [
        {
          "@value": "The software, where there is some — `DSpace 7`, `Lean 4 / Lake`. Descriptors for one system are often reusable."
        }
      ],
      "dcterms:source": "large-datasets/schemas/source-descriptor.ts#SourceDescriptorSchema.system",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields/source-descriptor.sourcedescriptorschema.termsurl",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/large-datasets/ns#glossary/kg-schema-fields"
      },
      "skos:prefLabel": [
        {
          "@value": "SourceDescriptorSchema.termsUrl"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whether the source states terms, and where. Feeds the `restrictions` and `copyright` gates; `unknown` stays unknown."
        }
      ],
      "dcterms:source": "large-datasets/schemas/source-descriptor.ts#SourceDescriptorSchema.termsUrl",
      "skos:note": "candidate"
    }
  ]
}
