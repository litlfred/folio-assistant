      },
      "skos:prefLabel": [
        {
          "@value": "Cite the author of every narrative"
        }
      ],
      "skos:definition": [
        {
          "@value": "A generated description is a claim by someone. Record whether a human or an agent wrote it, and for an agent the model version. An uncited narrative is indistinguishable from a transcription of the source."
        }
      ],
      "skos:notation": "Task_Provenance",
