    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_activitylog.a_dowork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Do the work"
        }
      ],
      "skos:definition": [
        {
          "@value": "The task itself. This diagram says nothing about how it is done; it only brackets it, so that a reader of the log can tell where one run of work began and ended."
        }
      ],
      "skos:notation": "A_DoWork",
      "dcterms:source": "cat-harness/processes/sdlc/activity-log.bpmn#A_DoWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_activitylog.a_emptyall",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Discard all entries, or a whole session"
        }
      ],
      "skos:definition": [
        {
          "@value": "Remove every entry, one session's, or those before a date — emptyLog with { all }, { session } or { before }; there is no default selector. A file that will not parse is kept, and the result must say what was refused and why, not only what was removed."
        }
      ],
      "skos:notation": "A_EmptyAll",
      "dcterms:source": "cat-harness/processes/sdlc/activity-log.bpmn#A_EmptyAll",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_activitylog.a_emptyone",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Discard one entry by id"
        }
      ],
      "skos:definition": [
        {
          "@value": "Remove one entry by its stable id, with emptyLog({ id }). Logs are the one exception to the never-delete rule because an entry records no decision; the exception covers files that declare folio-log/v1, not the directory."
        }
      ],
      "skos:notation": "A_EmptyOne",
      "dcterms:source": "cat-harness/processes/sdlc/activity-log.bpmn#A_EmptyOne",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_activitylog.a_logend",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log task-end"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write a task-end entry, with the outcome in the detail. The step is the unit: an entry per step, not one when the whole process finishes, or every intermediate entry is lost."
        }
      ],
      "skos:notation": "A_LogEnd",
      "dcterms:source": "cat-harness/processes/sdlc/activity-log.bpmn#A_LogEnd",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_activitylog.a_logmessage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log a message or an error"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write a message or error entry whenever a later reader would need it. A command run goes in `execution` (command, exit code, where output went) — never the output itself, and never a secret, token or credential: capture on puts entries in git."
        }
      ],
      "skos:notation": "A_LogMessage",
      "dcterms:source": "cat-harness/processes/sdlc/activity-log.bpmn#A_LogMessage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_activitylog.a_logstart",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Log task-start"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write a task-start entry before touching anything: summary, actor, and the process/task/bean/branch/session it belongs to where they exist. role, process and task are optional on purpose — do not invent a lane for work done outside a process."
        }
      ],
      "skos:notation": "A_LogStart",
      "dcterms:source": "cat-harness/processes/sdlc/activity-log.bpmn#A_LogStart",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_activitylog.a_persistlog",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Persist the log to the data store"
        }
      ],
      "skos:definition": [
        {
          "@value": "Capture is explicitly on — by <cat-harness.processes:log capture=\"on\"/> on the process or by config — so the entries go to the git data store. Only this branch commits anything."
        }
      ],
      "skos:notation": "A_PersistLog",
      "dcterms:source": "cat-harness/processes/sdlc/activity-log.bpmn#A_PersistLog",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_activitylog.a_reportcapturestate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the capture state"
        }
      ],
      "skos:definition": [
        {
          "@value": "Capture is off or unknown, so nothing is committed. Say which of the two it is: off is somebody's decision, unknown means nobody could tell, and an agent that believes it has an audit trail when it has none acts on a false belief."
        }
      ],
      "skos:notation": "A_ReportCaptureState",
      "dcterms:source": "cat-harness/processes/sdlc/activity-log.bpmn#A_ReportCaptureState",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_actorroleadministration.callactivity_codechangereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Branch, gates, PR and review [code-change-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Called rather than restated. The mechanics of getting an edit reviewed and merged are not specific to the role graph, and a second description of them is a second thing free to disagree with the first."
        }
      ],
      "skos:notation": "CallActivity_CodeChangeReview",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#CallActivity_CodeChangeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_actorroleadministration.task_addactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Add an actor, and declare its kind"
        }
      ],
      "skos:definition": [
        {
          "@value": "Human, agentic or mechanical. A userTask because the agentic/mechanical line is JUDGEMENT — role-model.md says so — and reading it wrong disqualifies the actor from every judgement task it exists to perform, silently."
        }
      ],
      "skos:notation": "Task_AddActor",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_AddActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_actorroleadministration.task_assignroles",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or close a role to an actor"
        }
      ],
      "skos:definition": [
        {
          "@value": "The join every other diagram depends on. An empty `roles` is a DETERMINED empty — it says the actor takes on none — and is not the same as an absent one, which asserts nothing."
        }
      ],
      "skos:notation": "Task_AssignRoles",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_AssignRoles",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_actorroleadministration.task_grantorrevoke",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grant or revoke a permission"
        }
      ],
      "skos:definition": [
        {
          "@value": "A permission travels with the PARTICIPANT and cross-cuts every lane, so unlike a role it cannot be scoped by the diagram it is used in. Granting one is a standing decision, which is why this lane is person-only and why the log capture on this process is on."
        }
      ],
      "skos:notation": "Task_GrantOrRevoke",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_GrantOrRevoke",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_actorroleadministration.task_retireactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retire an actor — never delete one"
        }
      ],
      "skos:definition": [
        {
          "@value": "An actor id is referenced from roles, diagrams, beans and commits, so removing the file leaves every one of those unable to tell retirement from accident. Same rule, and the same reason, as a scrapped bean."
        }
      ],
      "skos:notation": "Task_RetireActor",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_RetireActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_actorroleadministration.task_runkgaudit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Audit the graph [kg:audit]"
        }
      ],
      "skos:definition": [
        {
          "@value": "AFTER the change, not before. Every criterion here is a join — role to lane, actor to role, activity to skill — so what an administrative edit breaks is not in the file it edited. The sidecars under `test/results/kg-qa/` are committed for the reason a printed verdict is not: without them, \"unbound since it was drawn\" and \"broken by this change\" are indistinguishable."
        }
      ],
      "skos:notation": "Task_RunKgAudit",
      "dcterms:source": "cat-harness/processes/process/actor-role-administration.bpmn#Task_RunKgAudit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_adjudication.a_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the disagreement"
        }
      ],
      "skos:definition": [
        {
          "@value": "The judgement itself, and the one step nothing here can check: if a mechanism could decide it, the process would not have been entered. It declares NO `cat-harness.processes:adjudication codes` on purpose, and that absence is the whole of bean `bvuk`. This step used to name three — stands, scope, dispensation — and six diagrams called it: `review-narrative` and `voice-review`, whose question those three answer, and four whose question they do not. `refresh-materialized` asks which side wins a local-vs-remote conflict; there is no criterion to scope there and no dispensation to grant, yet the outcome half ran regardless. Since the caller's question decides the permitted answers, the caller declares them: `cat-harness.processes:adjudication codes` on its OWN call activity, with its own gateway acting on them. `criterion-adjudication.bpmn` is that for the QA-criterion question. What could NOT be fixed by passing the codes as data, which was this bean's first recommendation: the three branches ran three different TASKS, so a caller handed `local-wins` would have had it pointing at `A_ScopeCriterion`. The branches had to move, not the enum."
        }
      ],
      "skos:notation": "A_Adjudicate",
      "dcterms:source": "cat-harness/processes/sdlc/adjudication.bpmn#A_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_adjudication.a_dispatch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dispatch with adjudicator_sees — never the artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "`UntaintedDispatch` on the criterion declares what each party is given; the caller names a subject and a criterion and does not hand-assemble a brief, because the party composing a brief by hand is the producer. `untaintedPartitionDefects` reports `overlap` when the checker and the adjudicator can read the same file — one of them is then grading its own input, and the verdict measures nothing while raising no error."
        }
      ],
      "skos:notation": "A_Dispatch",
      "dcterms:source": "cat-harness/processes/sdlc/adjudication.bpmn#A_Dispatch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_adjudication.a_statefinding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "State the finding and what it read"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each provider says what it found and on what evidence. A finding that does not show what it read is an opinion, and an adjudicator cannot tell it from a finding about some other version of the block."
        }
      ],
      "skos:notation": "A_StateFinding",
      "dcterms:source": "cat-harness/processes/sdlc/adjudication.bpmn#A_StateFinding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_beanlifecycle.task_checkexists",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check before you create (exact-title search)"
        }
      ],
      "skos:definition": [
        {
          "@value": "STRICT. `beans create` is not idempotent: it mints a fresh id every call and dedupes on nothing, so re-entering a step duplicates the plan instead of no-op'ing. In the qou folio an unguarded re-run produced 14,688 duplicate beans — 92% of every open bean — which starved the idle-backlog policy of signal and collided with 15 real ids."
        }
      ],
      "skos:notation": "Task_CheckExists",
      "dcterms:source": "cat-harness/processes/sdlc/bean-lifecycle.bpmn#Task_CheckExists",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_beanlifecycle.task_claim",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Claim it (status: in-progress)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Idempotent. Claim BEFORE working, and note the branch, so a sibling session can see the item is taken rather than discovering it by collision."
        }
      ],
      "skos:notation": "Task_Claim",
      "dcterms:source": "cat-harness/processes/sdlc/bean-lifecycle.bpmn#Task_Claim",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_beanlifecycle.task_complete",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Complete (no unchecked todos left)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once nothing is unchecked, and with a summary of what changed. The engine's `resolve` completes a bean only after the instance itself has completed — whether work is done is a judgement, and a bean is not closed on someone else's say-so."
        }
      ],
      "skos:notation": "Task_Complete",
      "dcterms:source": "cat-harness/processes/sdlc/bean-lifecycle.bpmn#Task_Complete",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_beanlifecycle.task_create",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create the bean (agent CLI, not an engine op)"
        }
      ],
      "skos:definition": [
        {
          "@value": "`beans create \"<title>\"`. This is the AGENT's call. The workflow engine has no `create` op — its vocabulary is claim, note and resolve, all of which act on an instance's existing bean."
        }
      ],
      "skos:notation": "Task_Create",
      "dcterms:source": "cat-harness/processes/sdlc/bean-lifecycle.bpmn#Task_Create",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_beanlifecycle.task_leavealone",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it alone (coordinate instead)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never resolve, scrap or delete a bean another session or a human owns. Claiming is how two sessions avoid picking the same item; closing someone else's is how one of them loses work it had not finished reporting."
        }
      ],
      "skos:notation": "Task_LeaveAlone",
      "dcterms:source": "cat-harness/processes/sdlc/bean-lifecycle.bpmn#Task_LeaveAlone",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_beanlifecycle.task_recordblocker",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the blocker and hand back"
        }
      ],
      "skos:definition": [
        {
          "@value": "Blocked is not scrapped. Set `--blocked-by`, say in the body what would unblock it, and return it to `todo` so it is visible to whoever can act. An in-progress bean nobody is progressing reads as active work."
        }
      ],
      "skos:notation": "Task_RecordBlocker",
      "dcterms:source": "cat-harness/processes/sdlc/bean-lifecycle.bpmn#Task_RecordBlocker",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_beanlifecycle.task_scrap",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scrap with reasons NEVER delete"
        }
      ],
      "skos:definition": [
        {
          "@value": "`status: scrapped`, plus a \"Reasons for Scrapping\" section. This is what \"disable\" means here — the CLI has no disabled state; its vocabulary is draft, todo, in-progress, completed, scrapped. DELETION IS NEVER THE ANSWER, even though `beans delete` exists. A scrapped bean records that the work was considered and rejected, and why; a deleted one leaves a sibling session unable to tell abandonment from accident, and leaves the next agent free to re-open the same dead end."
        }
      ],
      "skos:notation": "Task_Scrap",
      "dcterms:source": "cat-harness/processes/sdlc/bean-lifecycle.bpmn#Task_Scrap",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_beanlifecycle.task_work",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Work, keeping the body current (this is 'edit')"
        }
      ],
      "skos:definition": [
        {
          "@value": "Editing a bean is not a separate ceremony: check off todo items as they happen, append measurements with the command and date that produced them, and record what you now know that the next agent does not. A bean whose body is a title is a placeholder, not a plan."
        }
      ],
      "skos:notation": "Task_Work",
      "dcterms:source": "cat-harness/processes/sdlc/bean-lifecycle.bpmn#Task_Work",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_buildl1kg.task_assets",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record assets[] — local path or remote URL"
        }
      ],
      "skos:definition": [
        {
          "@value": "kind / role / url-or-path / checksum / retrieved. A SIBLING of library:, never inside it: LibraryRef is regenerated from the tree, so an authored URL placed there is dropped on the next sync."
        }
      ],
      "skos:notation": "Task_Assets",
      "dcterms:source": "cat-harness/processes/library/ingest-build-l1-kg.bpmn#Task_Assets",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_buildl1kg.task_bind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Bind the folder name to the bibliography slug"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bind the folder name to the document's bibliography slug, so library/<bib-slug>/ and its citation key are the same string: a citation resolves to a directory without a lookup table between them."
        }
      ],
      "skos:notation": "Task_Bind",
      "dcterms:source": "cat-harness/processes/library/ingest-build-l1-kg.bpmn#Task_Bind",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_buildl1kg.task_dublin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write dublin-core.jsonld (the record of truth)"
        }
      ],
      "skos:definition": [
        {
          "@value": "One standalone Dublin Core record per folder. dcterms is already this corpus's JSON-LD vocabulary, so this extends a live context rather than introducing one."
        }
      ],
      "skos:notation": "Task_Dublin",
      "dcterms:source": "cat-harness/processes/library/ingest-build-l1-kg.bpmn#Task_Dublin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_buildl1kg.task_link",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Link L1 nodes into the corpus graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "Anything in library/ is L1 source content. A knowledge-graph reference from any artefact -- paper, L2, L3 -- resolves to it through library/."
        }
      ],
      "skos:notation": "Task_Link",
      "dcterms:source": "cat-harness/processes/library/ingest-build-l1-kg.bpmn#Task_Link",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_buildl1kg.task_manifest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write manifest.jsonld referencing it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write manifest.jsonld for the folder: its @id, @type folio:SourceDocument, what it contains and its provenance, referencing the standalone dublin-core.jsonld as the record of truth rather than copying its fields."
        }
      ],
      "skos:notation": "Task_Manifest",
      "dcterms:source": "cat-harness/processes/library/ingest-build-l1-kg.bpmn#Task_Manifest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_cihealth.task_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run check:ci-health, WRITING the report file"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run check:ci-health --out, writing the report file before any exit path. Exit 0 clean, 1 live failures, 2 could not check. bun also exits 1 on an uncaught exception, so an exit 1 with no report file is a crash and is treated as could-not-check."
        }
      ],
      "skos:notation": "Task_Check",
      "dcterms:source": "cat-harness/processes/sdlc/ci-health-watch.bpmn#Task_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_cihealth.task_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clean: close the open ci-health issue, if any, saying why (main is clean). Runs only on a clean verdict — on unknown the issue is left untouched and the job fails instead, because could-not-check is never rendered as clean."
        }
      ],
      "skos:notation": "Task_Close",
      "dcterms:source": "cat-harness/processes/sdlc/ci-health-watch.bpmn#Task_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_cihealth.task_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the tracking label exists"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the ci-health label with --force so it exists before either issue path runs — the close path filters on it too, and on a repository that has never had a finding it would not exist yet. Skipped on an unknown verdict."
        }
      ],
      "skos:notation": "Task_Label",
      "dcterms:source": "cat-harness/processes/sdlc/ci-health-watch.bpmn#Task_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_cihealth.task_track",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings: EDIT the one open issue labelled ci-health if there is one, otherwise create it, with the report as the body. One issue edited in place, never a new issue or a comment per run, so the tracking issue never becomes a feed."
        }
      ],
      "skos:notation": "Task_Track",
      "dcterms:source": "cat-harness/processes/sdlc/ci-health-watch.bpmn#Task_Track",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_addressreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Address the review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every finding is answered — implemented, or replied to with why not. A design question does not excuse skipping the nits in the same review."
        }
      ],
      "skos:notation": "Task_AddressReview",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_AddressReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_branchandannounce",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Branch, and announce it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Announce the branch WHEN IT IS CREATED, not when the work is done. The gap between one agent's view of an issue and everyone else's is what this closes."
        }
      ],
      "skos:notation": "Task_BranchAndAnnounce",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_BranchAndAnnounce",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_claimbean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Claim the work item"
        }
      ],
      "skos:definition": [
        {
          "@value": "Claim before you work. A claim ANNOUNCES rather than reserves until the PR exists, which is why the branch is announced at the next step and not at the end."
        }
      ],
      "skos:notation": "Task_ClaimBean",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_ClaimBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_closebean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what was done, and close"
        }
      ],
      "skos:definition": [
        {
          "@value": "A closed work item is read later by somebody deciding whether to reopen the subject, so \"completed\" with nothing behind it cannot be audited. An ISSUE is never closed on the agent's own say-so."
        }
      ],
      "skos:notation": "Task_CloseBean",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_CloseBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_commitandopenpr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Commit, push, open the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "The PR opens at the FIRST commit, even on a stub, and permission is never asked for it. Holding a green PR back for someone to look at is not caution — it is a blocked reviewer. A change to a rendered surface carries a before/after preview in the PR body (skill before-after-preview)."
        }
      ],
      "skos:notation": "Task_CommitAndOpenPR",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_CommitAndOpenPR",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_diagnose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Root-cause the failure"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"Flake\" is not a root cause. A red PR is work now, whatever its review state — only a green, mergeable head waits on reviewers."
        }
      ],
      "skos:notation": "Task_Diagnose",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_Diagnose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_implement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Make the change"
        }
      ],
      "skos:definition": [
        {
          "@value": "The loop's only open-ended step. Everything around it is procedure; this is the work."
        }
      ],
      "skos:notation": "Task_Implement",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_Implement",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_preparemerge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare the merge, and watch it through"
        }
      ],
      "skos:definition": [
        {
          "@value": "`prepare-merge` brings the base in, re-runs the gates and pushes — it does NOT merge. Bringing the base in IS `merge-base.bpmn` (`bun run merge:main`): conflicts a declared pattern covers are resolved and proved by the gate set; anything else aborts the merge and comes back to the agent (bean `y7b3`, #1707). `watch` follows the PR until it is merged or closed, because webhooks do not reliably deliver CI success or a merge-conflict transition."
        }
      ],
      "skos:notation": "Task_PrepareMerge",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_PrepareMerge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the change"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human or an agent acting AS reviewer. Nothing is a reviewer; somebody acts as one for the duration of this lane. For a rendered change the reviewer reads the agent's before/after preview rather than building one."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_runci",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the gates against the merge of head into base"
        }
      ],
      "skos:definition": [
        {
          "@value": "CI tests the MERGE, not the branch. That is why a locally green tree can go red here: the agent's tree and the merge result are different trees, and the difference is invisible from a checkout."
        }
      ],
      "skos:notation": "Task_RunCI",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_RunCI",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codechangereview.task_rungates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the platform's own gates"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before pushing, not after CI says so. `bun test` passing is NOT the gates passing: measured 2026-09-19, a green unit suite sat beside a `tsc` failure and a missing `@graphNode` tag, and the second broke a QA sidecar comparison as well — one cause, two symptoms, and an agent running only the tests would have pushed all three."
        }
      ],
      "skos:notation": "Task_RunGates",
      "dcterms:source": "cat-harness/processes/sdlc/code-change-review.bpmn#Task_RunGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codequalitygates.task_e2e",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "End-to-end + accessibility (HARD)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Install Chromium, check the rendered BPMN SVGs are current, then run the Playwright suite, which includes the accessibility checks. Hard: a failure blocks the PR. SHARDED since bean `dlqu` (drawn as one task, deliberately: a multi-instance marker would add a BPMN term to every instance's UML overview, about 75 generated files, for a picture this sentence already gives): the suite runs as three `e2e-shard` jobs (`E2E_SHARD=i/3`, one Playwright worker per core in each), and the `e2e` job that carries this check's name completes the task only when every instance succeeded — a shard that failed, was cancelled or never ran is a red check, never a skipped one. Measured before the split: `playwright test` alone was 4m33s of a 5m16s job, the workflow's slowest once `bun test` ran in parallel. The BPMN-render and `.bat`-wrapper checks run in shard 1 only, so they are asked once."
        }
      ],
      "skos:notation": "Task_E2E",
      "dcterms:source": "cat-harness/processes/sdlc/code-quality-gates.bpmn#Task_E2E",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codequalitygates.task_hygiene",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import hygiene (HARD) and advisories (WARN-ONLY)"
        }
      ],
      "skos:definition": [
        {
          "@value": "FOUR QUESTIONS, ONE RUNNER — bean `7fu5`. They were four jobs (`lean-bare-import`, `python-imports`, `rust-wildcard`, `dependency-advisories`), each about a second of work behind a ~13 s checkout and a runner request; measured on `main` run 37133247484 (2026-10-03), the run took 21.7 min while its longest job executed for 174 s, the rest waiting for runners. Now they are steps of the `hygiene` job, and every step after the first gate runs `if: !cancelled()`, so a red one masks none of the others — the `om30` rule kept inside one job rather than by splitting it. (1) Lean, HARD: fail on any bare `import Mathlib` in content/**/*.lean; in this platform repo there is no content/, so the step prints SKIP and states that nothing was scanned. (2) Python, HARD: ruff F401 (unused) and F403 (wildcard) over the Python trees that exist, then the Python tests; an absent tree is dropped rather than passed to ruff, and an empty set says SKIP. (3) Dependency advisories, WARN-ONLY by the owner's ruling on bean `j41m`: is anything in the resolved tree KNOWN-VULNERABLE? The script exits 0 in every state and keeps them apart in its output; `.github/dependabot.yml` is the other half of that ruling and is not drawn here. (4) Rust wildcard imports, WARN-ONLY: report non-test `use …::*;` in tools/**/*.rs; `continue-on-error`, and therefore the job's LAST step, where it masks nothing."
        }
      ],
      "skos:notation": "Task_Hygiene",
      "dcterms:source": "cat-harness/processes/sdlc/code-quality-gates.bpmn#Task_Hygiene",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codequalitygates.task_qapublish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish QA results to qa-reports (NOT A GATE)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean `16ei`, arc `3fva`. After Task_RepositoryGates, WHATEVER it concluded (`needs: gates` with `always()`), `qa:publish --github` writes this run's `test/results` trees to the orphan `qa-reports` branch: `main/<sha>/` on a push to main, `pr/<n>/<head-sha>/` on a same-repository PR (owner rulings D1, D3). A fork PR's token is read-only, so it is skipped with a `::notice` naming why. It does NOT reach GW_Join: a red publish is its own red and never decides mergeability, and the hard gates never wait on it. The only job here holding `contents: write`, which is also how `bun run gates` knows not to run it locally."
        }
      ],
      "skos:notation": "Task_QaPublish",
      "dcterms:source": "cat-harness/processes/sdlc/code-quality-gates.bpmn#Task_QaPublish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codequalitygates.task_repositorygates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Repository gates (HARD)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The 43 repository-gate steps — workflow refs, lane and process documentation, kg:audit:check, detangle, skills, published packages — 150 `bun run` invocations in all. A SEPARATE job from Task_TypeScript since bean `om30`: they were one job in which `bun test` came second of 47 steps, and because Actions stops a job at its first failing step and no step was continue-on-error, a deliberate test failure on `main` meant none of these ran. A gate never asked and a gate that passed are indistinguishable from outside, which is `xom7` at the step rather than the workflow. No sequence dependency on Task_TypeScript is drawn because there is none: a red test must not stop these being asked. `bun run gates` derives its list from BOTH jobs, so the local set still cannot drift from CI's."
        }
      ],
      "skos:notation": "Task_RepositoryGates",
      "dcterms:source": "cat-harness/processes/sdlc/code-quality-gates.bpmn#Task_RepositoryGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codequalitygates.task_skillchain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Skill-registration chain (UNMASKED)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Runs the five `--check` commands that adding a skill stales, each on its own: gen-skill-docs, check:glossary, docs:auto:check, kg:audit:check, kg:detangle:check. CORRECTED 2026-09-26, after main split this workflow: the original justification is GONE. It read \"the only place those five are read against the tree as checked out\", because at the time all six lived in one job behind `bun test`, which runs the kg-audit and detangle WRITERS and repaired two artefacts before their checks read them (bean `ymsu`). Task_RepositoryGates is now a separate job that runs all six and never runs `bun test`, so they are unmasked THERE. What survives is narrower and is the reason this is kept: one command a skill author runs (`bun run skill:register`) that regenerates and verifies the chain together, a committed QA sidecar saying which steps ran, and ONE named failure instead of six unrelated generated files — which is bean `v625`'s actual complaint. The unmasking argument belongs to Task_RepositoryGates now. Its first CI run earned the place: it went red on `kg:detangle:check` and the cause was `kg-detangle.ts` counting 1214 files of a gitignored `node_modules/` as graph nodes — 1441 where a clean checkout computes 227, pinned in a committed sidecar. Not a step in front of `bun test` either: measured on main's run 36234052354, a failing step SKIPS every step behind it, so a red there would turn one named failure into forty-five unevaluated ones. 13s, in parallel. Beans `v625`, `fjwi`."
        }
      ],
      "skos:notation": "Task_SkillChain",
      "dcterms:source": "cat-harness/processes/sdlc/code-quality-gates.bpmn#Task_SkillChain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codequalitygates.task_typescript",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "TypeScript: lint, types and tests (HARD)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three checks: `bun run lint`, `tsc --noEmit` and `bun test`. The repository gates it used to carry are Task_RepositoryGates now (bean `om30`). Since bean `dlqu` it is three jobs: `typescript-static` (lint, then typecheck), `typescript-test` (`bun test` as four SEQUENTIAL shards on separate machines — Bun's in-process `--parallel` worker pool hung at both 4 and 2 workers, measured — the shard passed in `BUN_OPTIONS` so the command stays the one `bun run gates` runs locally) and `typescript`, which carries the check name and is green only when the other two succeeded. The step-order rule the single job needed — `bun test` LAST, because Actions stops at the first failing step and a red-by-decision test would otherwise mask lint and typecheck — no longer has anything to order: separate jobs cannot mask each other. Measured on three `main` runs before the change: `bun test` alone was 7m30s-7m45s of an 8m14s-8m33s job."
        }
      ],
      "skos:notation": "Task_TypeScript",
      "dcterms:source": "cat-harness/processes/sdlc/code-quality-gates.bpmn#Task_TypeScript",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codequalitygates.task_unrungates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Registered gates that never run (HARD)"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:gates-registered`, split out of Task_RepositoryGates by bean `dlqu`: one step of that job measured 1m46s-2m28s across four runs, the longest step in it by a factor of four, and a sequential job is as slow as the sum of its steps. In its own job it runs beside the rest rather than after them. It still asks the same question — is every gate a script registers actually run somewhere — and is still hard."
        }
      ],
      "skos:notation": "Task_UnrunGates",
      "dcterms:source": "cat-harness/processes/sdlc/code-quality-gates.bpmn#Task_UnrunGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codereview.task_recordverdict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the verdict on the node"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings are advice, not commits — the same separation the generic reviewer lane keeps. Record them where the next reader meets the node."
        }
      ],
      "skos:notation": "Task_RecordVerdict",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_RecordVerdict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codereview.task_reviewschema",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the schema definition node"
        }
      ],
      "skos:definition": [
        {
          "@value": "Does the node declare what KIND of node it is? Does a widened type carry its mirrors? Does a removed field leave a reason behind, so the next author does not re-add it in good faith? And where the node RENDERS to something the site serves — a colour, a glyph, a theme's tokens — does a Tool maintain that artefact, and does the visual fact have only one home? The node decides; the stylesheet reports."
        }
      ],
      "skos:notation": "Task_ReviewSchema",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_ReviewSchema",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codereview.task_reviewtool",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the Tool node"
        }
      ],
      "skos:definition": [
        {
          "@value": "Does it name skills, and do they resolve? Is the mechanism it advertises the one that actually runs? Are its IRIs minted rather than written out? And the question a covered skill hides: is the COMMAND reachable, or only the skill satisfied? A skill can be served by the neighbours of its mechanism while the mechanism itself is reachable from no node, and check:tools reports it as covered and is right to."
        }
      ],
      "skos:notation": "Task_ReviewTool",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_ReviewTool",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_codereview.task_runnodeaudits",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the node audits"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:tools`, `kg:audit` and `typecheck`. Read the kg-qa sidecar rather than the summary: it is written per node so an inherited defect and a new one are distinguishable."
        }
      ],
      "skos:notation": "Task_RunNodeAudits",
      "dcterms:source": "cat-harness/processes/kg/review-code.bpmn#Task_RunNodeAudits",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_contentacquisition.a_accept",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accept it, and record where it came from"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both branches land here. An unprompted offer is accepted as it stands — do not make somebody follow a process to hand over what they already have. Provenance is recorded whichever channel it arrived through: a description given in chat has a source and can be wrong, exactly as a PDF does."
        }
      ],
      "skos:notation": "A_Accept",
      "dcterms:source": "cat-harness/processes/library/content-acquisition.bpmn#A_Accept",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_contentacquisition.a_ask",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Say what is needed, and ask for a link OR a description"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both forms, named together. A person who cannot find the file often knows exactly what it is, and a description in their own words is an acquired resource rather than a consolation prize. Asking for the upload first demands the one thing they may not have, before the cheaper answers have been offered. Say what happens if they do nothing."
        }
      ],
      "skos:notation": "A_Ask",
      "dcterms:source": "cat-harness/processes/library/content-acquisition.bpmn#A_Ask",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_contentacquisition.a_pointtoupload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Point at the upload target [scripts/upload-url.ts]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Composed from the declaration, never written by hand. The queue is declared with INSTANCE scope, so its declared path is missing the segment a repository-relative forge URL needs: /upload/main/uploads is a 404 and /upload/main/cat-harness/uploads is not, verified against GitHub 2026-09-20. Every failure is named — no origin remote, a non-GitHub forge, a declared-but-absent queue — because a URL is believed, and somebody sent to a wrong one cannot tell it from an empty directory. On failure, fall back to the conversation."
        }
      ],
      "skos:notation": "A_PointToUpload",
      "dcterms:source": "cat-harness/processes/library/content-acquisition.bpmn#A_PointToUpload",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_contentacquisition.a_route",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Route it, and watch the queue"
        }
      ],
      "skos:definition": [
        {
          "@value": "A file goes to ingestion; a link or a description goes to whatever will resolve it. Acquisition stops here — the moment a file is in the queue, library-ingestion owns it, and keeping that seam sharp is what lets a resource acquired through a channel that does not exist yet reach ingestion unchanged. An arrival may be minutes or days away, so it is watched rather than chased."
        }
      ],
      "skos:notation": "A_Route",
      "dcterms:source": "cat-harness/processes/library/content-acquisition.bpmn#A_Route",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_contentacquisition.p_respond",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Give a link, a description, or neither"
        }
      ],
      "skos:definition": [
        {
          "@value": "\"Or neither\" is a real outcome, not a failure. The ask says what happens if nothing comes, and then that happens — the work proceeds without the resource and says so."
        }
      ],
      "skos:notation": "P_Respond",
      "dcterms:source": "cat-harness/processes/library/content-acquisition.bpmn#P_Respond",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_contentacquisition.p_upload",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Drop the file in the queue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through the forge's upload form, a commit, or any other route that lands the file in the declared queue. The agent watches rather than chases: an arrival may be minutes or days away."
        }
      ],
      "skos:notation": "P_Upload",
      "dcterms:source": "cat-harness/processes/library/content-acquisition.bpmn#P_Upload",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_editdirectly",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit it in place — it is your own content"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ordinary path, drawn so the process does not read as though every edit needs a copy. Content in a writable directory is authored content and is edited where it lives; the copy-out is for somebody else's bytes, not for yours."
        }
      ],
      "skos:notation": "Task_EditDirectly",
      "dcterms:source": "cat-harness/processes/library/copy-out-materialized.bpmn#Task_EditDirectly",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_land",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land the bytes in the copier's own folio/"
        }
      ],
      "skos:definition": [
        {
          "@value": "Into the copier's own declared `folio/`, never a scratch area — a directory nobody declared is a directory nobody gates, and the copy would be publishable by accident. The copy is NOT read-only: it is the copier's own content, makes no claim about anybody else's bytes, and freezing it too would mean the next person needs a copy of the copy."
        }
      ],
      "skos:notation": "Task_Land",
      "dcterms:source": "cat-harness/processes/library/copy-out-materialized.bpmn#Task_Land",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_readsource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the original — and write nothing"
        }
      ],
      "skos:definition": [
        {
          "@value": "A read, and the only interaction this process has with the source. Its digest and `provenance` are carried forward: the digest so Task_VerifySourceUntouched has something to check against, and `provenance` so the copy can name what it came out of without re-deriving it."
        }
      ],
      "skos:notation": "Task_ReadSource",
      "dcterms:source": "cat-harness/processes/library/copy-out-materialized.bpmn#Task_ReadSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_recordprovenance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record provenance.local — what this is a copy OF"
        }
      ],
      "skos:definition": [
        {
          "@value": "The step that is easy to omit and impossible to reconstruct afterwards. `provenance` is a PAIR: `upstream` is the remote thing, `local` is the original in this repository. A copy-out writes `local`; it does not overwrite `upstream`, and it does not reuse `upstream` for a local value — that was one field until 2026-09-22, and by then 5 of the 9 who-iris item records were using it for a local one in violation of its own documentation. Without `local`, one rename later the copy is indistinguishable from original work and nothing downstream can repair it, because the information was never written down."
        }
      ],
      "skos:notation": "Task_RecordProvenance",
      "dcterms:source": "cat-harness/processes/library/copy-out-materialized.bpmn#Task_RecordProvenance",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_copyoutmaterialized.task_verifysourceuntouched",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify the ORIGINAL still hashes to its digest"
        }
      ],
      "skos:definition": [
        {
          "@value": "`check:materialized-fixity`. Run against the SOURCE, not the copy — the copy is new content with no claim to verify, and the source is the thing a botched copy-out would have disturbed. A mismatch here means the copy-out was an edit in place wearing a copy's clothes, and it is the only signal that tells the two apart."
        }
      ],
      "skos:notation": "Task_VerifySourceUntouched",
      "dcterms:source": "cat-harness/processes/library/copy-out-materialized.bpmn#Task_VerifySourceUntouched",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.a_detect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect feature request (crdm-detect skill)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Recognise the request as a platform capability change rather than content work, from crdm-detect's signals. Never call it \"CRDM\" to the person. Mid-content-work, ask whether to pause for requirements now or record a bean for later — do not switch on your own."
        }
      ],
      "skos:notation": "A_Detect",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#A_Detect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.ba_submit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Describe the need (chat, issue, discussion)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA describes the capability gap in their own words. They do not need to know it is called CRDM."
        }
      ],
      "skos:notation": "BA_Submit",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#BA_Submit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.call_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close-out"
        }
      ],
      "skos:definition": [
        {
          "@value": "The stakeholders sign off, the BA confirms every criterion is met, and only then does the agent close the issue. Never the other way round: an agent must never assume completion."
        }
      ],
      "skos:notation": "Call_Close",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.call_datamodel",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Data model Entities + cardinalities"
        }
      ],
      "skos:definition": [
        {
          "@value": "Between requirements and sign-off, and the order is the argument: requirements are statements about things, and the model says what the things ARE. Drafted earlier it is invented from nothing, since the entities come from the phase-2 BPA; drafted later, sign-off approves requirements whose nouns were never pinned — which is how two stakeholders approve one sentence meaning different things. Owner, 2026-09-20."
        }
      ],
      "skos:notation": "Call_DataModel",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_DataModel",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.call_deliver",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 6 Implement + acceptance"
        }
      ],
      "skos:definition": [
        {
          "@value": "One phase and not three, because the loops say so: an increment the BA rejects, an MVP that is not ready, and stakeholder findings all route back into implementation. A subprocess has one exit and cannot be re-entered once finished, so splitting this region would have changed what the diagram says."
        }
      ],
      "skos:notation": "Call_Deliver",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Deliver",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.call_issue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Link the work to an issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Feature work must be linked to a GitHub issue. Scan before creating, and never create one without the BA's permission — an issue is the stakeholder's record, not the agent's scratchpad."
        }
      ],
      "skos:notation": "Call_Issue",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Issue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.call_needs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1 Needs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Identify the stakeholders, synthesise a needs statement from the sources, and loop until the BA and the stakeholders both recognise it. The loop is the phase: a needs statement nobody confirmed is an agent's summary, not a requirement."
        }
      ],
      "skos:notation": "Call_Needs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Needs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.call_requirements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phases 2–4 BPA + requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "Map the current workflow, then define the requirements and the impact they carry, and loop until approved. Same shape as Phase 1 and for the same reason: an unapproved requirement is a proposal."
        }
      ],
      "skos:notation": "Call_Requirements",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Requirements",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm.call_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 5 Beans + sign-off"
        }
      ],
      "skos:definition": [
        {
          "@value": "The approved requirements become work-plan items, the BA signs off, and the branch is announced on the issue. The announcement is on the single edge into delivery, so the three loops back into implementation do not re-announce."
        }
      ],
      "skos:notation": "Call_Signoff",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements.bpmn#Call_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_close.a_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close issue ONLY on BA authorisation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reachable only through BA_Confirm, which is the BA saying every criterion is met. An agent must never close an issue without that explicit authorisation — the gate is the preceding task, and this name says so rather than leaving a reader to trace the flow for it."
        }
      ],
      "skos:notation": "A_Close",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#A_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_close.ba_confirm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm all criteria met"
        }
      ],
      "skos:definition": [
        {
          "@value": "The business analyst confirms every acceptance criterion from the requirements is met. The issue closes only on their authorisation — an agent never closes an issue on its own say-so."
        }
      ],
      "skos:notation": "BA_Confirm",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#BA_Confirm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_close.s_featuresignoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Feature sign-off on issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders sign off on the delivered feature on the issue, having tested the built artefact rather than a description of it."
        }
      ],
      "skos:notation": "S_FeatureSignoff",
      "dcterms:source": "cat-harness/processes/process/crdm-close.bpmn#S_FeatureSignoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_datamodel.a_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the model where a tool can read it"
        }
      ],
      "skos:definition": [
        {
          "@value": "A model in prose is a proposal; a model in the declaration is a model. Ship a reader in the same change — everything here that was only documentation went inert within weeks."
        }
      ],
      "skos:notation": "A_Declare",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_datamodel.a_entities",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify entities from the BPA and requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every verb in the BPA whose object is a candidate entity, and every noun in a requirement. An entity with no identifier is an attribute of something else — that test is decisive and belongs to the technique skill."
        }
      ],
      "skos:notation": "A_Entities",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Entities",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_datamodel.a_relations",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Relations and cardinalities, both ways"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stated in both directions, because \"one attestation per report\" and \"one report per attestation\" are different claims and a model with only the first cannot say whether a re-signature is an update or a second row."
        }
      ],
      "skos:notation": "A_Relations",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#A_Relations",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_datamodel.ba_confirmentities",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm the entities are the ones meant"
        }
      ],
      "skos:definition": [
        {
          "@value": "A naming question. The BA owns the domain vocabulary; the agent does not guess, which is CRDM's own rule for phase 1 and applies here with more force."
        }
      ],
      "skos:notation": "BA_ConfirmEntities",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#BA_ConfirmEntities",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_datamodel.s_confirmcardinality",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm the cardinalities"
        }
      ],
      "skos:definition": [
        {
          "@value": "An operational question, asked of the people who run the process because they know where the exceptions are."
        }
      ],
      "skos:notation": "S_ConfirmCardinality",
      "dcterms:source": "cat-harness/processes/process/crdm-data-model.bpmn#S_ConfirmCardinality",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.a_codeaudit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Audit the code nodes the increment adds"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into the review task for what this increment CHANGED IN THE GRAPH — Tool definitions in `tools/` and schema definition nodes under `schemas/`. It runs before the summary, and therefore before an MVP can be shared: a Tool or schema node shipped in an MVP is the version stakeholders start building expectations on, and a node that names a skill nobody wrote is cheaper to catch here than after sign-off. Called, not inherited: the agent keeps its implementing role and takes on the `code-reviewer` lane inside Process_CodeReview for that call path only."
        }
      ],
      "skos:notation": "A_CodeAudit",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_CodeAudit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.a_deploystaging",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy the MVP to staging"
        }
      ],
      "skos:definition": [
        {
          "@value": "An MVP is shared AS A STAGING DEPLOY, not as a description of one. `feature-staging.yml` publishes the branch under `STAGING/<branch-slug>/` on gh-pages and comments the URL on the PR, so the stakeholder who tests it is looking at the built artefact rather than at a screenshot — the same argument the merge discipline makes about rendered work. Measured in this repo on 2026-09-16: holding a rendered change back for assessment made assessment harder, not safer."
        }
      ],
      "skos:notation": "A_DeployStaging",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_DeployStaging",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.a_implement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 6: Implement (feature branch + PR)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Inner loop: agent claims a bean, implements on feature branch, opens PR, posts summary to the issue."
        }
      ],
      "skos:notation": "A_Implement",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_Implement",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.a_summary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post summary to issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "What was accomplished, what remains, and links to the updated content for review."
        }
      ],
      "skos:notation": "A_Summary",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#A_Summary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.ba_reviewincrement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review increment (test behaviour)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Inner loop: the BA tests each delivered increment against the acceptance criteria. They do not review code — they test behaviour."
        }
      ],
      "skos:notation": "BA_ReviewIncrement",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_ReviewIncrement",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.ba_sharemvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Share MVP with stakeholders"
        }
      ],
      "skos:definition": [
        {
          "@value": "Outer loop: the BA presents the accumulated increments to stakeholders as a testable MVP. Staging URL, demo, or walkthrough."
        }
      ],
      "skos:notation": "BA_ShareMVP",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_ShareMVP",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.ba_translatefeedback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Translate feedback into agent direction"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA translates stakeholder findings into actionable direction: new beans or bean updates for the agent."
        }
      ],
      "skos:notation": "BA_TranslateFeedback",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#BA_TranslateFeedback",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.call_optionsanalysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Options analysis how to implement"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the single edge from `Start_Process_CRDM_Deliver` into `A_Implement`, so the approach is chosen before any code exists. By Phase 6 the needs, requirements and data model are signed off, which is exactly the evidence an options analysis needs and the reason it belongs here rather than earlier: at `Call_Needs` there is nothing to weigh, and after `A_Implement` the choice has been made in code. Note where this is NOT. The work-plan named `crdm-requirements-workflow`, and `A_Implement` is not in that diagram — `crdm-requirements.bpmn` is the orchestrator, seven call activities and a gateway, and Phase 6 lives here in `crdm-deliver.bpmn`. The call goes where the step is, not where the plan said to look. The three loop-backs into `A_Implement` — `_5` (increment rejected), `_7` (MVP not ready), `_13` (feedback translated) — deliberately BYPASS this call. Routing them through it would run the subprocess on every iteration of the inner loop, which is the ceremony this design refuses: a gate invoked on every pass stops being read. An iteration reworks an approach already chosen; if the APPROACH is what is wrong, that is not a loop iteration and it belongs to the calling step in `crdm-requirements.bpmn`. Contrast `upstream-version-adoption`, where the loop DOES re-enter the analysis. There the loop-back returns to `A_Impact`, which re-gathers the evidence, so the second pass weighs genuinely different inputs. Here the loop returns to implementation with the evidence unchanged. `A_Implement` carries `cat-harness.processes:bean op=\"claim\"`; this step carries no bean op, because `Process_OptionsAnalysis` ends with its own `decision-audit` note on the bean the caller claimed."
        }
      ],
      "skos:notation": "Call_OptionsAnalysis",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#Call_OptionsAnalysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_deliver.s_testmvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Test MVP in own context"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders test the delivered feature in their own workflow, with their own data. They report what works and what does not."
        }
      ],
      "skos:notation": "S_TestMVP",
      "dcterms:source": "cat-harness/processes/process/crdm-deliver.bpmn#S_TestMVP",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_issue.a_askcreate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask BA to create or link issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask — never create. Creating an issue without the BA's permission is the thing this step exists to prevent."
        }
      ],
      "skos:notation": "A_AskCreate",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_AskCreate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_issue.a_linkissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Link to existing issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "A match was found: ask the person whether the requirements go on #NNN, then link the work there. The issue is where stakeholders sign off, so no phase proceeds without one."
        }
      ],
      "skos:notation": "A_LinkIssue",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_LinkIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_issue.a_scanissues",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan open issues for match"
        }
      ],
      "skos:definition": [
        {
          "@value": "Search open issues, then recently closed ones, by title and body keywords for one this request belongs to. Requirements may span several issues; note every relevant one."
        }
      ],
      "skos:notation": "A_ScanIssues",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#A_ScanIssues",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_issue.call_relatedwork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Related work: find, sort, ask"
        }
      ],
      "skos:definition": [
        {
          "@value": "When the requirement is initiated or updated through a human-agent chat, search the beans and the repository's issues and open PRs for relevance, categorize and summarize them, and ask the user whether and how to coordinate. Judgement decides the categories; the user decides the coordination. Owner, 2026-09-23 (issue #1023)."
        }
      ],
      "skos:notation": "Call_RelatedWork",
      "dcterms:source": "cat-harness/processes/process/crdm-issue-linking.bpmn#Call_RelatedWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_needs.a_stakeholders",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1: Identify stakeholders"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent asks the BA who is affected by this change. The BA knows the domain — the agent does not guess."
        }
      ],
      "skos:notation": "A_Stakeholders",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#A_Stakeholders",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_needs.a_synthesise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 1: Synthesise needs from sources"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the chat, issue, uploads and library sources, write a clear, jargon-free statement of what is needed and why, tied to a concrete workflow. Post it on the GitHub issue, not in chat, and ask the requester and stakeholders to review it."
        }
      ],
      "skos:notation": "A_Synthesise",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#A_Synthesise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_needs.ba_reviewneeds",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review synthesised needs statement"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA reviews what the agent synthesised and checks it against what they actually need."
        }
      ],
      "skos:notation": "BA_ReviewNeeds",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#BA_ReviewNeeds",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_needs.s_confirmneeds",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Confirm needs statement"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders confirm, on the issue, that the needs statement says what they need — or say what to change. A stakeholder's judgement; an agent does not record it for them."
        }
      ],
      "skos:notation": "S_ConfirmNeeds",
      "dcterms:source": "cat-harness/processes/process/crdm-needs.bpmn#S_ConfirmNeeds",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_requirements.a_compareoptions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 4a: Compare the viable options"
        }
      ],
      "skos:definition": [
        {
          "@value": "Phase 4 often ends with a CHOICE rather than a plan, and this is the step that hands it over. Per option: what it does, its pro, its con, what it changes DOWNSTREAM, and how reversible it is — laid out where the rows can be read against each other, then one recommendation and a stated default. A step of its own rather than a line inside A_DefineReqs, because it has a different output and a different reader: the impact analysis is for the record, the comparison is the thing the BA answers from. Folding it in is how it gets skipped — the analysis feels finished, so the options go over as a list of names. Skipped legitimately when the analysis yields ONE viable approach. Do not manufacture alternatives to fill a table."
        }
      ],
      "skos:notation": "A_CompareOptions",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_CompareOptions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_requirements.a_definereqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phases 3–4: Define requirements + impact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Two skills, because this step is two things: the requirements come from the CRDM process, the impact half is a question about the entities and relations the change touches, which is what data modelling answers. It named `content-graph` until placement PR3 (bean `63wl`): that is a folio-content skill, and this diagram is the harness's own."
        }
      ],
      "skos:notation": "A_DefineReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_DefineReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_requirements.a_mapworkflow",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 2: Map current workflow (BPA)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Business-process analysis here means reading the existing diagrams under processes/ and drawing the gap, so the skill that implements this step is the BPMN one."
        }
      ],
      "skos:notation": "A_MapWorkflow",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#A_MapWorkflow",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_requirements.ba_reviewreqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review requirements and impact analysis"
        }
      ],
      "skos:definition": [
        {
          "@value": "The BA reviews the formal requirements and the impact analysis the agent produced."
        }
      ],
      "skos:notation": "BA_ReviewReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#BA_ReviewReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_requirements.s_approvereqs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Approve requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stakeholders approve the requirements and impact analysis on the issue, or send them back for revision. Only their approval moves the work to sign-off; an agent never records an approval on a person's behalf."
        }
      ],
      "skos:notation": "S_ApproveReqs",
      "dcterms:source": "cat-harness/processes/process/crdm-requirements-definition.bpmn#S_ApproveReqs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_signoff.a_announcebranch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Announce the branch on the issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "On CREATING the feature branch, comment on the issue: the branch name, the process and phase, and the beans claimed. Visibility is the whole point — without it a sibling session or a human cannot tell that work has begun, only that it has finished. Deliberately on this edge and not inside Phase 6. The three loops back into A_Implement (increment rejected, MVP not ready, feedback translated) re-enter implementation on the SAME branch, and re-announcing on each would be noise. Announce once, when the branch is created. Before announcing, run the collision review that starts any new unit of work (coordinate, \"Starting new work\"): open PRs and in-progress beans checked against the branch's files and subject, scaled to the blast radius, and the result recorded in the bean before the first edit."
        }
      ],
      "skos:notation": "A_AnnounceBranch",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_AnnounceBranch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_signoff.a_createbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Phase 5: Create beans"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent mints the implementation beans itself with `beans create`, running the exact-title existence check first. The engine has no `create` op — it claims, notes and resolves the instance's OWN bean — so what this step records here is a note that the plan now exists."
        }
      ],
      "skos:notation": "A_CreateBeans",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_CreateBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_signoff.a_offerkg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Offer the knowledge-graph destinations for the agreed set"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE STEP THAT WAS MISSING. Requirements were elicited, agreed and signed off, and then existed as an issue and a conversation — so the output of the process that exists to produce durable requirements was the one thing the knowledge graph never learned. ONE question for the SET, not one per requirement: a six-phase run can agree many, and asking six times is the same failure as a form that re-asks what it was already told. The options are DERIVED from the graphs this instance declares in `<name>.json`, read at the time of asking, so an instance that adds a graph gets it in the offer without anybody editing a skill. Never a list typed from memory."
        }
      ],
      "skos:notation": "A_OfferKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_OfferKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_signoff.a_recordkg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run placement, and raise a bean for the authoring"
        }
      ],
      "skos:definition": [
        {
          "@value": "The offer produces a DECISION, not a node. `placement` then decides instance, graph and node kind — it is the step that catches a hardcoded path or a literal naming one folio — and the authoring itself becomes a bean, because work here is a bean before it is a file. `op=\"note\"` and not `create`, for the reason `A_CreateBeans` above states: the engine has no `create` op — it claims, notes and resolves the instance's OWN bean. The agent mints the authoring bean itself with `beans create`, running the exact-title existence check first, and what this step records is a note that the decision was taken."
        }
      ],
      "skos:notation": "A_RecordKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#A_RecordKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_signoff.ba_choosekg",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose a destination, or none"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PERSON'S STEP, and `none` is one of the answers rather than a refusal to answer. A requirement whose whole content is carried by the code becomes a commit and nothing else; a graph that acquires a node for it is a graph with a node nobody will ever read. The default creates NOTHING. An agent that decides on its own that a requirement \"is really a skill\" has manufactured a node nobody asked for, in a graph somebody else maintains — which is what this step exists to prevent."
        }
      ],
      "skos:notation": "BA_ChooseKg",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#BA_ChooseKg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_crdm_signoff.ba_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off on requirements"
        }
      ],
      "skos:definition": [
        {
          "@value": "The business analyst / requester signs off on the agreed requirement set, on the issue: what was agreed and what was deferred. Recorded as their decision, with its reason, never by an agent on their behalf."
        }
      ],
      "skos:notation": "BA_Signoff",
      "dcterms:source": "cat-harness/processes/process/crdm-signoff.bpmn#BA_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_criterionadjudication.a_dispensation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Grant a dispensation, with its reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "The rule applies and this subject is a stated exception. A `kind: \"human\"` entry with `result: \"pass\"` overrides the script's `fail` for that criterion, and ONLY while its `field_hash` matches the current source — so the dispensation is scoped to the version it was granted against, lapses when the block changes, and never becomes precedent. There is nothing to overturn later; the source moving overturns it. A dispensation with no `notes` is not a dispensation. It is an override somebody applied to get to green, and nobody can review it afterwards — which is why this step is not relaxable."
        }
      ],
      "skos:notation": "A_Dispensation",
      "dcterms:source": "cat-harness/processes/sdlc/criterion-adjudication.bpmn#A_Dispensation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_criterionadjudication.a_recordentry",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the entry that LEADS — keeping the checker's beneath it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Not relaxable, and the one step here that is not. A judgement nobody wrote down is indistinguishable from a checker that was never run, so the judgement is free and the record is not. Do not resolve the disagreement away: both entries stay, the adjudication on top under the sweep's most-recent-matching-hash rule. A disagreement between a checker and a reviewer is information, and somebody re-running the check next month needs to find that a checker read it differently rather than a clean pass. `/api/relevance/adjudicate` reached the same rule independently — `human_adjudicated` written alongside, never over, the agent's `assessed_by`."
        }
      ],
      "skos:notation": "A_RecordEntry",
      "dcterms:source": "cat-harness/processes/sdlc/criterion-adjudication.bpmn#A_RecordEntry",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_criterionadjudication.a_scopecriterion",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the criterion so it stops applying here"
        }
      ],
      "skos:definition": [
        {
          "@value": "One edit to the criterion rather than ten overrules on the blocks it should never have covered. This branch is the one an adjudicator under time pressure converts into a dispensation, and the conversion is a defect: a dispensation lapses when the source moves, so a mis-scoped criterion granted its way past comes back every time anybody touches the block."
        }
      ],
      "skos:notation": "A_ScopeCriterion",
      "dcterms:source": "cat-harness/processes/sdlc/criterion-adjudication.bpmn#A_ScopeCriterion",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_criterionadjudication.call_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the criterion disagreement"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared judgement — entry condition, untainted dispatch, person-or-agent restriction — asked with THIS question's permitted answers. `cat-harness.processes:adjudication codes` sits here rather than on `A_Adjudicate` inside it because the answers depend on what was asked, and the gateway below is what acts on them: the engine refuses a mismatch between the two. `Process_Adjudication` may also leave at `End_NotAdjudicable` — one entry and no other side is a review or a gate, not a disagreement — in which case nothing below runs and there is nothing to record."
        }
      ],
      "skos:notation": "Call_Adjudicate",
      "dcterms:source": "cat-harness/processes/sdlc/criterion-adjudication.bpmn#Call_Adjudicate",
      "skos:note": "candidate"
    },
    {
