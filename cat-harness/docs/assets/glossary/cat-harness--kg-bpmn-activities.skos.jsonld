      },
      "skos:prefLabel": [
        {
          "@value": "Verify the export [publish-verification]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Process_PublishVerification: the verifier set over the built tree, before anything is deployed. Owner, 2026-09-23: before deployment, blocking."
        }
      ],
      "skos:notation": "Call_Verify",
      "dcterms:source": "cat-harness/processes/sdlc/docs-site-publish.bpmn#Call_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_docssite.task_build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the Jekyll site and the API reference"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compose the docs layers, build the Jekyll site, mount instance-rendered content, and generate the TypeScript API reference with TypeDoc."
        }
      ],
      "skos:notation": "Task_Build",
      "dcterms:source": "cat-harness/processes/sdlc/docs-site-publish.bpmn#Task_Build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_docssite.task_closealert",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the publication manager's alert, if open"
        }
      ],
      "skos:definition": [
        {
          "@value": "A clean publish resolves whatever the last failure raised: close the open publication-manager tracking issue with a comment naming this run."
        }
      ],
      "skos:notation": "Task_CloseAlert",
      "dcterms:source": "cat-harness/processes/sdlc/docs-site-publish.bpmn#Task_CloseAlert",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_docssite.task_export",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Export the knowledge graph and its schema"
        }
      ],
      "skos:definition": [
        {
          "@value": "Export the knowledge graph and its schema into the published tree, then check every maintained artefact is present and no block-level markup escaped. The unpublished graph kinds are stripped on export."
        }
      ],
      "skos:notation": "Task_Export",
      "dcterms:source": "cat-harness/processes/sdlc/docs-site-publish.bpmn#Task_Export",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_docssite.task_publish",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Push to the CDN [render-kg-to-cdn] gh-pages, FULL REPLACE"
        }
      ],
      "skos:definition": [
        {
          "@value": "THIS SITE IS ONE INSTANCE OF THE GENERAL STEP (owner, 2026-09-30: gh-pages is \"one specific tool of general 'publish to CDN'\"). Process_RenderKgToCdn, entered with the tree this build already rendered and verified, the site root as the publication root URL, and GitHub Pages as the target — so its `gh-pages` Tool pushes. Here that push is a FULL REPLACE of the `gh-pages` branch: anything on it this build did not produce is gone unless the restore put it back, which is why the restore and the survival check either side of this call stay in THIS process rather than in the general one. The call returns the push's status and message (the gh-pages merge commit and the QA result); a status other than `pushed` takes the `no` branch of Did the deploy succeed?."
        }
      ],
      "skos:notation": "Task_Publish",
      "dcterms:source": "cat-harness/processes/sdlc/docs-site-publish.bpmn#Task_Publish",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_docssite.task_regenerate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Regenerate every derived reference from its source"
        }
      ],
      "skos:definition": [
        {
          "@value": "Regenerate every derived reference from its source before building: skill schema and instruction pages, content-backed docs pages, the graph projections and viewers, the handler and translation indexes, and the rendered BPMN diagrams. The published site is built from sources, never from committed copies that may be stale."
        }
      ],
      "skos:notation": "Task_Regenerate",
      "dcterms:source": "cat-harness/processes/sdlc/docs-site-publish.bpmn#Task_Regenerate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_docssite.task_restore",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Restore the OPEN PRs' staging previews"
        }
      ],
      "skos:definition": [
        {
          "@value": "Copy every OPEN pull request's STAGING/<slug>/ preview from gh-pages into the publish directory before the replace, once per publish attempt. Without it the full replace deletes every preview, silently (bean plj1). Only open PRs' previews are carried."
        }
      ],
      "skos:notation": "Task_Restore",
      "dcterms:source": "cat-harness/processes/sdlc/docs-site-publish.bpmn#Task_Restore",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_extractstructure.task_candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract claim candidates"
        }
      ],
      "skos:definition": [
        {
          "@value": "candidates.json holds extracted theorems and definitions. Proposals only -- never adjudicated verdicts."
        }
      ],
      "skos:notation": "Task_Candidates",
      "dcterms:source": "cat-harness/processes/library/ingest-extract-structure.bpmn#Task_Candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_extractstructure.task_extracttext",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract the text layer"
        }
      ],
      "skos:definition": [
        {
          "@value": "The document has a text layer: extract it with pdf-extract (pdfminer.six, then a zero-dependency content-stream reader). Exit 2 means no text layer — a scan — and routes to OCR; it is not an empty document."
        }
      ],
      "skos:notation": "Task_ExtractText",
      "dcterms:source": "cat-harness/processes/library/ingest-extract-structure.bpmn#Task_ExtractText",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_extractstructure.task_ocr",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "OCR to ocr/page-*.txt"
        }
      ],
      "skos:definition": [
        {
          "@value": "A document ingested this way keeps its text in ocr/ and only a stub in sections/, which the documented sections/ grep cannot see. That asymmetry is why the corpus-grep checklist has a fourth tier."
        }
      ],
      "skos:notation": "Task_Ocr",
      "dcterms:source": "cat-harness/processes/library/ingest-extract-structure.bpmn#Task_Ocr",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_extractstructure.task_sections",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Split into sections/*.md with doc_brief front-matter"
        }
      ],
      "skos:definition": [
        {
          "@value": "Contextual retrieval: a chunk in isolation loses what makes it mean anything, so each section carries the document brief."
        }
      ],
      "skos:notation": "Task_Sections",
      "dcterms:source": "cat-harness/processes/library/ingest-extract-structure.bpmn#Task_Sections",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_extractstructure.task_structure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write structure.json (TOC, page ranges, metadata)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write structure.json (pdf-structure/v1): doc id, TOC from the PDF outline or inferred from headings, page ranges, metadata, and source{} with the sha256 and a mimetype sniffed from the bytes, never the extension. A structure that could not be determined says so in structure_note rather than being rendered as one."
        }
      ],
      "skos:notation": "Task_Structure",
      "dcterms:source": "cat-harness/processes/library/ingest-extract-structure.bpmn#Task_Structure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.h_confirm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Repeat the slug, exactly, to confirm"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step in this process that is a person's. Repeating the slug is not ceremony: it names the artefact being confirmed, so a confirmation cannot be inherited by a later run pointed at a different preview."
        }
      ],
      "skos:notation": "H_Confirm",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#H_Confirm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the docs site Jekyll · TypeDoc · KG export"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build the preview from the PR's head: regenerate the generated docs, trim what this preview does not need, render the BPMN diagrams, then Jekyll, TypeDoc and the knowledge-graph export, with the staging banner and SEO identity claims stripped."
        }
      ],
      "skos:notation": "Task_Build",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_Build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment the preview URL on the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Post, or update in place, one comment on the PR giving the preview URL (STAGING/<slug>/) and the commit it was built from. Pull-request events only."
        }
      ],
      "skos:notation": "Task_Comment",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_deploy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Push to the CDN at STAGING/&lt;slug&gt;/ [render-kg-to-cdn]"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PREVIEW IS THE GENERAL STEP WITH A DIFFERENT ROOT (owner, 2026-09-30: \"independent of staging vs publication … just rendering\"). Process_RenderKgToCdn, entered with the tree Task_Build rendered, `STAGING/<slug>/` under the site root as the publication root URL, and GitHub Pages as the target, so its `gh-pages` Tool pushes. For this target the push is `keep_files: true` with a `destination_dir`, so it adds one directory beside whatever else is on the branch; it is also RETRIED once: five other workflows push to `gh-pages` without joining this one's concurrency group, and a queue does not help because GitHub CANCELS a pending job when a newer one arrives for the same group rather than queueing it. Measured 2026-09-19: three staging runs from three different branches inside 17 seconds, two cancelled. The call returns the push's status and message; the render log and the PR comment that follow are this process's own. THE PREVIEW CAP rides in the same commit (owner ruling 2026-10-02, issue #1868: \"cap the maximum number of previews (<= 10) and rotate old ones off\"): `staging-rotate.ts` keeps this preview plus the most recently updated others up to MAX_PREVIEWS = 10 and removes the rest, each with a `removed` render-log entry and its record retired into STAGING/_retired/. Every push attempt re-reads `gh-pages` and re-decides rather than rebasing, so a lost race never pushes a stale removal. A rotated-off preview is regenerated by the next push to its PR branch."
        }
      ],
      "skos:notation": "Task_Deploy",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_Deploy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_logrendered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `rendered` to the render log"
        }
      ],
      "skos:definition": [
        {
          "@value": "Its OWN commit, not part of the deploy. The publish action writes only into `destination_dir`, so an entry riding in `_site` would land at `STAGING/<slug>/_render-log/` — inside the directory a cleanup removes, which is the one place a record of the removal must not be. `continue-on-error`: a preview that deployed and whose entry did not is a gap in the record, not a failed deploy."
        }
      ],
      "skos:notation": "Task_LogRendered",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_LogRendered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_logretained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `retained`, with why it stays"
        }
      ],
      "skos:definition": [
        {
          "@value": "The event that makes the log worth reading. A removal was CONSIDERED and refused; without an entry that leaves no trace on the branch at all, and the next person asking *\"why is this preview still up\"* has only a comment on a pull request that may itself be closed."
        }
      ],
      "skos:notation": "Task_LogRetained",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_LogRetained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_notice",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the retention notice on the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "Removal was not confirmed, so the preview stays: post a retention notice on the PR giving its URL and saying it has NOT been removed, and the two ways to remove it: the staging:cleanup label while the PR is open, or, once it is closed, a Run workflow dispatch with cleanup_slug and a matching cleanup_confirm."
        }
      ],
      "skos:notation": "Task_Notice",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_Notice",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_preflight",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-evaluate liveness AT REMOVAL TIME"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-evaluated AT REMOVAL TIME, through the same `previewLiveness` the health sweep uses rather than a second implementation of it. The sweep runs daily and proposes; this acts. Between them a branch can come back to life — bean `w2g5` documents exactly that, a session reusing one branch across five successive pull requests."
        }
      ],
      "skos:notation": "Task_Preflight",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_Preflight",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_remove",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove the preview AND append `removed` — one commit"
        }
      ],
      "skos:definition": [
        {
          "@value": "ONE COMMIT for the removal and its record. A separate log push can fail on its own and leave a preview that vanished with nothing saying why — which is the exact state bean `plj1` left the branch in. `render-log.ts` refuses a `removed` entry with no reason, so this step fails loudly rather than writing a record that says an artefact went and not why."
        }
      ],
      "skos:notation": "Task_Remove",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_Remove",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_removedisp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove it AND append `removed` — one commit"
        }
      ],
      "skos:definition": [
        {
          "@value": "Say what is going — size and file count — then remove STAGING/<slug>/ and append `removed` to the render log in the SAME commit, so a preview cannot vanish without a record of who dispatched it and why. The slug is a dispatch input, so the tool re-checks it by value rather than trusting the guard."
        }
      ],
      "skos:notation": "Task_RemoveDisp",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_RemoveDisp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_slug",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Derive the slug from the head ref"
        }
      ],
      "skos:definition": [
        {
          "@value": "Derive the slug from the PR's head ref: every character outside [a-zA-Z0-9._-] becomes '-', runs of '-' collapse, and leading or trailing '-' is trimmed. It must be one safe path segment, checked by value."
        }
      ],
      "skos:notation": "Task_Slug",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_Slug",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_featurestaging.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the slug's SHAPE and that the confirmation repeats it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Guarded three ways because a dispatch input is a DELETION TRIGGER. `workflow_dispatch` is available only to an actor with write access; the slug must match exactly the characters the sed pipeline can produce, with `.` and `..` refused by name; and the confirmation must repeat the slug, so a confirmation cannot be carried over from an earlier run against a different preview."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "cat-harness/processes/sdlc/feature-staging.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Authorise the extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step no package may relax. A repository cut changes the substrate every other diagram's lanes bind to, and that is a person's decision."
        }
      ],
      "skos:notation": "Task_Authorise",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief the topic before touching anything"
        }
      ],
      "skos:definition": [
        {
          "@value": "What am I doing and why is it worth doing; what do I already know, with each measurement's provenance; how do I plan to do it and WHAT WOULD FALSIFY THE APPROACH. A falsifier that never fires is decoration — this practice's own fired, took edges 5 to 12, and rewrote the plan."
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "1 · Declare in place (nothing moves)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `<name>.json` entry with its `graphs[]` kinds. A sub-graph that owns its own layout gains a NESTED declaration whose paths resolve against its own directory, so the whole graph relocates by moving one folder."
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "4 · Extract — a directory move, not a file-by-file sift"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once edges are zero and the declaration stands alone: move the sub-graph out as one directory move, not a file-by-file sift. Its nested declaration resolves paths against its own directory, so moving the folder moves the graph. The five-point gate is in migration-plan.md Phase II."
        }
      ],
      "skos:notation": "Task_Extract",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_isolate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "3 · Isolate — own declaration, namespace, artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only once cross-edges measure zero: give the sub-graph its own declaration, its own namespace and its own published artefact, as bootstrap/ has (its own declaration, bs: namespace and graph document). Nothing moves yet; the sub-graph now stands alone in place."
        }
      ],
      "skos:notation": "Task_Isolate",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Isolate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2a · Measure — unassigned column FIRST"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run check:partition`. Read the unassigned column before the edge count, and quote BOTH numbers rather than only the one that improved. The count rising when the measurement improves is correct: 43 to 49 when thirteen previously-unjudged edges were folded in."
        }
      ],
      "skos:notation": "Task_Measure",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_move",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "2b · Prune, merge, factor — or the classification is wrong"
        }
      ],
      "skos:definition": [
        {
          "@value": "The only four moves. Move the shared TARGET first and the importers after; check the target's layer before the importer's; a schema moves with its script. The fix is never an exemption, it is the right owner."
        }
      ],
      "skos:notation": "Task_Move",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Move",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_graphdetanglement.task_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what would move — sizes, and what breaks"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports and waits. `deletion-requires-confirmation` is not a courtesy to waive: an agent never removes or relocates a durable artefact on its own initiative."
        }
      ],
      "skos:notation": "Task_Propose",
      "dcterms:source": "cat-harness/processes/kg/graph-detanglement.bpmn#Task_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_appenddisclaimer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append WHO disclaimer (if DAK)"
        }
      ],
      "skos:definition": [
        {
          "@value": "For WHO SMART Guidelines content, automatically appends the WHO legal disclaimer: - Translation not created by WHO - English edition is authoritative original - WHO not responsible for translation accuracy Only applies when folio contentType includes WHO/DAK content."
        }
      ],
      "skos:notation": "Task_AppendDisclaimer",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_AppendDisclaimer",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_assigntranslator",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Assign to qualified human translator"
        }
      ],
      "skos:definition": [
        {
          "@value": "The coordinator assigns the translation to a qualified translator, ideally a domain SME for the content area. For WHO content, the translator should be familiar with WHO SMART Guidelines terminology. The assignment includes: - The .pot file(s) from extraction - The domain glossary - Context notes (block kind, chapter, content area) - The deadline"
        }
      ],
      "skos:notation": "Task_AssignTranslator",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_AssignTranslator",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_checkcompleteness",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check translation completeness"
        }
      ],
      "skos:definition": [
        {
          "@value": "Verify that all msgid entries have msgstr translations. Partial translations are acceptable for initial submissions but must be flagged for follow-up. The coordinator checks: - % of strings translated - Any fuzzy-flagged entries - Missing critical sections"
        }
      ],
      "skos:notation": "Task_CheckCompleteness",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_CheckCompleteness",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_extractpot",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract POT (translatable strings)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Pre-processes source markdown: 1. Segments prose by paragraph 2. Shields non-translatable content (math, code, labels) as placeholders 3. Normalizes whitespace 4. Extracts metadata (titles, alt text, captions) Produces .pot file(s) at the configured granularity. Tool: translation_extract MCP tool"
        }
      ],
      "skos:notation": "Task_ExtractPOT",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_ExtractPOT",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_identifycontent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Identify content and target locale"
        }
      ],
      "skos:definition": [
        {
          "@value": "The coordinator selects: - Which content nodes need translation (block, section, chapter, or folio) - The target locale (one of the supportedLocales in <name>.config.json) - The priority and deadline"
        }
      ],
      "skos:notation": "Task_IdentifyContent",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_IdentifyContent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_injectpo",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject PO → translated Markdown"
        }
      ],
      "skos:definition": [
        {
          "@value": "Post-processes the completed .po file: 1. Substitutes msgstr for msgid in source markdown 2. Unshields placeholder tokens back to original content 3. Validates structural integrity (paragraph count, heading levels) 4. Validates completeness (flags empty msgstr) 5. Runs linting (doubled punctuation, orphaned placeholders) Tool: translation_inject MCP tool"
        }
      ],
      "skos:notation": "Task_InjectPO",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_InjectPO",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_prepareglossary",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prepare domain glossary"
        }
      ],
      "skos:definition": [
        {
          "@value": "Generates or retrieves the domain glossary for the target locale. Sources: 1. Root folio's translations/ glossary 2. Folio-assistant dependency translations (depth-first walk) 3. WHO standard terminology (from smart-base) 4. Previous translations of related content"
        }
      ],
      "skos:notation": "Task_PrepareGlossary",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_PrepareGlossary",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_receiveassignment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Receive assignment and materials"
        }
      ],
      "skos:definition": [
        {
          "@value": "The translator receives: - .pot file with source strings (msgid) - Domain glossary with approved term translations - Context notes per string - Style guide and WHO terminology references Tools: Poedit, Weblate, Crowdin, or direct .po editing."
        }
      ],
      "skos:notation": "Task_ReceiveAssignment",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_ReceiveAssignment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_requestmorework",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Request completion of remaining strings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Return to the translator with a list of untranslated or fuzzy strings that need attention."
        }
      ],
      "skos:notation": "Task_RequestMoreWork",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_RequestMoreWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_returnforcorrection",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Return for correction with annotations"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer annotates specific passages that need correction and returns to the translator with detailed feedback. Each annotation includes: - The passage in question - What is wrong (terminology, meaning, style) - The suggested correction or reference"
        }
      ],
      "skos:notation": "Task_ReturnForCorrection",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_ReturnForCorrection",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_humantranslation.task_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean: folio-assistant-ktt2 Back-translates target-language .md to source language and compares meaning. Distinguishes semantic drift from terminology misses. Tool: translation_validate MCP tool No gateway follows: drift or clean, the translation goes to Task_SMEReview with the findings attached. Which of two readings is right is a human call (translation-manager, \"route drift to a human reviewer\"), and every translation in this workflow is reviewed and signed off anyway, so a clean result is evidence for the reviewer and never a way around them."
        }
      ],
      "skos:notation": "Task_RoundTripQA",
      "dcterms:source": "cat-harness/processes/library/human-translation-workflow.bpmn#Task_RoundTripQA",
      "skos:note": "candidate"
    },
    {
