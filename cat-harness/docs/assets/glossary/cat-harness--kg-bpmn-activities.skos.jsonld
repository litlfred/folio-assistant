    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.callactivity_extract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract structure [document-intake]"
        }
      ],
      "skos:definition": [
        {
          "@value": "See ingest-extract-structure.bpmn."
        }
      ],
      "skos:notation": "CallActivity_Extract",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#CallActivity_Extract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.callactivity_gate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "L1 completeness gate"
        }
      ],
      "skos:definition": [
        {
          "@value": "See ingest-l1-completeness-gate.bpmn. Skill-backed by `library-ingestion` (2026-09-30, bean 7bg9): its section \"What a complete L1 entry holds\" names `check:l1-complete` as the gate and states its three results. Until then this step named `paper-relevance-triage`, which never existed, and was left uncovered rather than bound to a guess. The gate contains one adjudication (Task_FlagDrift: `real`, `spurious` or `source-wrong`), and its own Task_Verdict records the answer as a reason against the verdict before returning. So both answers reach this step, and nothing here branches on them; Gateway_Complete branches on the gate's completeness verdict instead."
        }
      ],
      "skos:notation": "CallActivity_Gate",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#CallActivity_Gate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.callactivity_ingesttheme",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ingest the theme [theme-art-intake]"
        }
      ],
      "skos:definition": [
        {
          "@value": "See ingest-theme.bpmn. The subprocess derives one Theme node with kind sticky|webpage|publication, and refuses a source it cannot complete rather than emitting a partial theme."
        }
      ],
      "skos:notation": "CallActivity_IngestTheme",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#CallActivity_IngestTheme",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.task_citeable",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Available to cite as an L1 source"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every knowledge-graph reference to this source now resolves through library/. Authoring and review consume it from here -- see authoring-a-document.bpmn."
        }
      ],
      "skos:notation": "Task_Citeable",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#Task_Citeable",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.task_detect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Detect media type and mint a doc id [document-intake]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Sniff the media type rather than trusting the extension, and mint the doc id from the page-1 arXiv stamp where there is one, else from the filename."
        }
      ],
      "skos:notation": "Task_Detect",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#Task_Detect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.task_licence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish the licence from the upload alone [document-intake]"
        }
      ],
      "skos:definition": [
        {
          "@value": "EARLY, by the owner's ruling on bean 7bg9 (2026-09-20): before any derivation, because library/ is holds: content and anything derived first is committed, so refusing it later is a deletion nobody may take unasked. This step sees only the upload itself — the licence recorded in its intake.json (the same stated / unknown record a library manifest carries) and whether a LICENSE file sits beside it. It never infers a licence from extracted text. The verdict is stated, unknown, or UNDETERMINED, and undetermined is never reported as cleared: the pipeline proceeds and says so, because a licence that only extraction can reveal is a later check's to find."
        }
      ],
      "skos:notation": "Task_Licence",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#Task_Licence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.task_openbean",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the gap as a bean"
        }
      ],
      "skos:definition": [
        {
          "@value": "A missing derived artefact is a tracked gap, not a silent omission. The document stays in uploads/ until the gap closes."
        }
      ],
      "skos:notation": "Task_OpenBean",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#Task_OpenBean",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.task_place",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place it in uploads/ by a declared route [upload-routes]"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE FIRST LINK, and it did not exist until 2026-09-30. Everything downstream of here takes a file that is already in the queue: `document-intake` triggers on \"User drops a file into `uploads/`\", and both ingest Tools type their first input as \"The upload to ingest, under the declared `uploads` graph\". So the act of PUTTING it there was performed by three different mechanisms and governed by none of them. WHAT THIS STEP IS. Choosing an arrival route, writing the bytes into the declared queue of the instance that will own them, and discharging what that route does not discharge for you. The routes, what each writer owes, and the two that are mechanisms against the one that is a persona are in the `upload-routes` skill; `upload-url` composes the forge URL for the web route from the declaration rather than from a literal, because a hand-written one 404'd. WHY A PLAIN `bpmn:task` AND NOT A `userTask`. A `userTask` asserts a human performs it, and this lane is named \"Contributor (human or agent)\" precisely because both do — measured over this repository's own history, files have reached `uploads/` in commits authored by `Carl Leitner` and in commits authored by `Claude`. Asserting human-only here would be the `activity-fulfilment-kind` contradiction written deliberately: the diagram saying one thing and the lane's role graph another. A plain task asserts nothing about the performer, which is the truth. WHY THE BEAN OP IS `note` AND NOT `claim`. Placing a file claims nothing; it adds to a queue. What it owes the work plan is visibility — three batches of PDFs arrived through the forge's web UI (`c8349950fa5`, `f4ddfc65c8d`, `b8549160bb1`) with no bean, no PR and no note, and the first sibling to notice was a generator going stale. A note against the ingestion bean is what makes the queue's growth something another session can see."
        }
      ],
      "skos:notation": "Task_Place",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#Task_Place",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.task_promote",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move into library/<bib-slug>/"
        }
      ],
      "skos:definition": [
        {
          "@value": "The folder name IS the bibliography citation key, so a citation and a directory are the same string."
        }
      ],
      "skos:notation": "Task_Promote",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#Task_Promote",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingestion.task_summaryqueue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prose blocks enter the summary queue [library-ingestion]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Owner, 2026-09-24: \"Make as QA sidecar as part of general doc ingestion to slowly drain.\" Nothing is written to ENQUEUE a block: the queue is derived (every prose block in every declared library, minus those whose summaries.json record is a current draft or confirmation), so a promoted entry is in it the moment its blocks are. A re-ingested document whose text changed re-enters it on its own, because the record's source_hash no longer matches. What an agent doing ingestion work does here is DRAIN a few: `bun run summaries:next -- --n K` hands it the next K blocks with their text, it writes a short summary of each in its own words, and `bun run summaries:record` writes them into library/<bib-slug>/summaries.json as drafts naming the agent and its model. The block itself stays verbatim and `ingested`. ADVISORY, never a gate: this step does not hold up Task_Citeable, and check:l1-complete reports the backlog (`block-summaries`) without failing on it. Confirming or rejecting a draft is a person's act, in `bun run narratives`."
        }
      ],
      "skos:notation": "Task_SummaryQueue",
      "dcterms:source": "cat-harness/processes/library/document-ingestion.bpmn#Task_SummaryQueue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingesttheme.task_contradictions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record contradictions IN the source"
        }
      ],
      "skos:definition": [
        {
          "@value": "A step because it happened twice on the first real ingestion: the WHO guide states its black logo as both K:100 and R:100 G:100 B:100, and gives the logo blue as C:95 on page 6 and C:90 on page 12. A contradiction silently resolved is indistinguishable from one nobody noticed, so it is kept as data and the reading taken is stated as a choice."
        }
      ],
      "skos:notation": "Task_Contradictions",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_Contradictions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingesttheme.task_maproles",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Map values onto the shared palette ROLES"
        }
      ],
      "skos:definition": [
        {
          "@value": "surface / ink / edge / accent, shared across every kind. A palette per kind would be three spellings of \"accent colour\", free to disagree about what an accent IS. Where the source is SILENT on a role, say so and mark the value a choice rather than dressing an invention as a measurement."
        }
      ],
      "skos:notation": "Task_MapRoles",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_MapRoles",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingesttheme.task_readguide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the guide's own stated rules"
        }
      ],
      "skos:definition": [
        {
          "@value": "From the INGESTED document's sections, not from a screenshot and not inferred from a site that happens to use the brand. Units stay as the source gives them: rewriting 29.7cm as millimetres is a conversion nobody asked for and a chance to be wrong."
        }
      ],
      "skos:notation": "Task_ReadGuide",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_ReadGuide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingesttheme.task_readstylesheet",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the served stylesheet's declarations"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the ROLE, never the prettiest value. Bootstrap's --blue is a scale entry and --primary is the role; DSpace sets them differently, and taking the brand-looking one is the hardcoding schemas/theme.ts exists to end. Column widths come from declared columns, never from breakpoints: a breakpoint is a viewport."
        }
      ],
      "skos:notation": "Task_ReadStylesheet",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_ReadStylesheet",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_ingesttheme.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Theme and UI review [theme-ui-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "THEME REVIEW HAPPENS HERE AND NOWHERE ELSE. Owner, 2026-09-23: \"theme review to ingestion of graphical assets in context of website or app design and determining graphical assets/UI\"; asked directly on 2026-09-24 whether that meant ONLY at ingestion: \"Yes only at ingestion\". Bean `9fdi`. So this step now CALLS `theme-ui-review.bpmn` rather than performing one automated check out of it. Until 2026-09-24 it carried a `folio:no-call` reason — \"calling it would put a human gate into an automated ingest\" — and the review ran post-MVP from `crdm-deliver.bpmn` instead. That call is gone, and the reason for not calling is withdrawn rather than left standing beside a call it contradicts. WHAT THE CALL COSTS, stated rather than hidden. The subprocess has a human step, `R_Judge`: a person looks at the ingested assets laid out in their design at a web and a mobile width. So ingesting a THEME SOURCE is attended at that step. Ingesting anything else stays unattended — `Gateway_ThemeSource` in `document-ingestion.bpmn` routes non-theme documents past this subprocess entirely. THE OLD AUTOMATED CHECK IS INSIDE THE CALL, NOT DROPPED. \"A theme sets the stripe's hue; it never sets its width to zero\" — colour alone carrying a whole signal fails WCAG SC 1.4.1, and the WHO guide agrees (\"Never red with green, never blue with yellow\"). That check is `A_Accessibility` in the called process, which measures contrast against the real ground and requires a non-colour channel wherever colour carries meaning."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/processes/ui/ingest-theme.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_jsonlddrift.task_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Regenerate the context, block, library and site graphs — and diff"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the five --check generators in one job — the JSON-LD context, block siblings, library nodes, site graph, then the label-resolution and emitter tests. Any committed .jsonld that differs from what its generator now produces fails the PR, because a stale generated file is still consulted."
        }
      ],
      "skos:notation": "Task_Check",
      "dcterms:source": "cat-harness/processes/sdlc/jsonld-drift-check.bpmn#Task_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_authorise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "9 · Authorise the extraction"
        }
      ],
      "skos:definition": [
        {
          "@value": "A repository cut changes the substrate every other process binds to; that is a person's decision. Declining leaves the graph declared, detangled, isolated and split in place."
        }
      ],
      "skos:notation": "Task_Authorise",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Authorise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_brief",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Brief, and claim the bean"
        }
      ],
      "skos:definition": [
        {
          "@value": "What is separating and why, what is already measured with its provenance, how it will be done, and what would falsify the approach. Claim the bean so a sibling session sees the work."
        }
      ],
      "skos:notation": "Task_Brief",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Brief",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_consume",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "11 · Parent consumes, additively"
        }
      ],
      "skos:definition": [
        {
          "@value": "The parent pins the pair (a commit while staging, a version once released), repoints its imports, and keeps its own copy until it is green with the dependency declared."
        }
      ],
      "skos:notation": "Task_Consume",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Consume",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_create",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Create the repositories"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner creates the content and tools repositories and their Pages. Nothing is committed to them before this."
        }
      ],
      "skos:notation": "Task_Create",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Create",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_cutover",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "13 · Cutover: delete the parent's copy"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one commit worth reverting, made only after the parent consumes the release and every identifier dereferences."
        }
      ],
      "skos:notation": "Task_Cutover",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Cutover",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_decide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Separate this graph?"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner decides from the measured signals, and also decides the address base for its identifiers, where verdicts about it live, and what its tools repository owns. Declining is a real outcome: the graph stays where it is."
        }
      ],
      "skos:notation": "Task_Decide",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Decide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_detangle",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "1–3 · Declare, detangle, isolate"
        }
      ],
      "skos:definition": [
        {
          "@value": "The graph-detanglement practice, all of its gates: declared in place, zero wrong-direction edges on every axis, and standing alone with its own declaration, namespace and artefact. A plain task on purpose, not a call to graph-detanglement.bpmn: that process ends in its own authorise-and-extract steps, which here are stages 9-13 of this one, and calling it would run them twice."
        }
      ],
      "skos:notation": "Task_Detangle",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Detangle",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_drain",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Drain: land, close or re-target the open PRs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Work the PRs `seed:ready` named until the source settles: land or close the heavy movers and the next layer's PRs, bring the layer's open PRs to five or fewer, and finish any move in flight. Fix a red rehearsal or a discovery miss where it is. Nothing is seeded from here; it goes back to the gateway, which re-asks."
        }
      ],
      "skos:notation": "Task_Drain",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Drain",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_hosted",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "5 · Move harness output about it to the host"
        }
      ],
      "skos:definition": [
        {
          "@value": "QA verdicts, translation templates, the exported graph and the glossary ledger are harness output ABOUT the graph: they live with the harness (kgQaHomeFor, translationsHomeFor). The content keeps only what its own checks need; the leak test's pending list is empty."
        }
      ],
      "skos:notation": "Task_Hosted",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Hosted",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_identity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "4 · Identity: version, iriBase, nodeSchemas"
        }
      ],
      "skos:definition": [
        {
          "@value": "The declaration carries name, version, iriBase, needs and nodeSchemas. A base move is `bun run iri:sync -- --from <old base>`, once; then `iri:sync:check` and `check:node-iris` are green."
        }
      ],
      "skos:notation": "Task_Identity",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Identity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_measure",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Measure the signals"
        }
      ],
      "skos:definition": [
        {
          "@value": "Files and bytes per instance, clone cost (`bun run health`), gate time, merge contention, the candidate's cohesion and cut (`kg:detangle`), wrong-direction edges, and the would-be tools package's import cone. Recorded in the bean; none alone is a trigger."
        }
      ],
      "skos:notation": "Task_Measure",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Measure",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "7 · Plan publication"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every identifier the content mints is a file some step publishes: /<version>/ for what programs read, kept for every version; /v<major>/ for pages people read. Name collisions between published files are resolved here."
        }
      ],
      "skos:notation": "Task_Plan",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_propose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report what moves — sizes, what breaks"
        }
      ],
      "skos:definition": [
        {
          "@value": "The agent reports and waits: what moves, how large, what in the parent breaks, and the rollback. It never relocates a durable artefact on its own initiative."
        }
      ],
      "skos:notation": "Task_Propose",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Propose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_rehearse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "8 · Rehearse standalone"
        }
      ],
      "skos:definition": [
        {
          "@value": "Copy the content and the tools alone into a temporary directory, with nothing else on the path, and run the tools' checks there. An empty tree must exit non-zero, so a rehearsal over nothing cannot pass."
        }
      ],
      "skos:notation": "Task_Rehearse",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Rehearse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_release",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "12 · First release"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tag each repository, publish /<version>/ and /v<major>/. From here the two are versioned independently; a tools release lists the content majors it supports."
        }
      ],
      "skos:notation": "Task_Release",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Release",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_seed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "10 · Seed both repositories"
        }
      ],
      "skos:definition": [
        {
          "@value": "Seed main, then bring the content and the tools in as reviewed pull requests with their history, so neither repository's first commit is unreviewable."
        }
      ],
      "skos:notation": "Task_Seed",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Seed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_split",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "6 · Split content from tools"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create <name>-tools as a sibling directory and move the code: the Zod source, the generators, the README and diagram writers, the content checks. Cut its import cone to its own files and declared packages. Both start at the content's version."
        }
      ],
      "skos:notation": "Task_Split",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Split",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgseparation.task_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Every identifier dereferences"
        }
      ],
      "skos:definition": [
        {
          "@value": "After the release is live, every published identifier resolves to the file it names."
        }
      ],
      "skos:notation": "Task_Verify",
      "dcterms:source": "cat-harness/processes/kg/kg-separation.bpmn#Task_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.a_distribute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish to the origin (a cache may front it)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reach host behaviour through publication.host, never by assuming GitHub Pages' behaviour — Pages CANNOT serve application/ld+json and a local server can. A CDN in front is a layer, not the host: the canonical URL stays the origin's, and the cache is an accelerated route to the same bytes. Uploading and exposing are separable steps on purpose (xies, gate 4), because collapsing them removes the last moment at which a bad URL layout can still be caught."
        }
      ],
      "skos:notation": "A_Distribute",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Distribute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.a_package",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Package: files plus a manifest of digests"
        }
      ],
      "skos:definition": [
        {
          "@value": "The serialization alone is not a package. A package is an addressable set — the JSON-LD, the assets it references, and a manifest naming every file with its digest and byte count. The manifest is what makes a REMOVED file detectable, which a per-file signature cannot do on its own."
        }
      ],
      "skos:notation": "A_Package",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Package",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.a_select",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cut the subgraph that leaves"
        }
      ],
      "skos:definition": [
        {
          "@value": "Apply the editorial scope mechanically and report what it removed. A selection that reports nothing cannot be told from one that ran over an empty rule."
        }
      ],
      "skos:notation": "A_Select",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Select",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.a_serialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Serialize to JSON-LD"
        }
      ],
      "skos:definition": [
        {
          "@value": "kg-export, already built and host-agnostic by design. Every edge term declared {\"@type\": \"@id\"} — without that coercion the document is a list of records that merely LOOKS linked, and the node IRIs are fragments of the document's own @id so the graph is mergeable with anyone else's."
        }
      ],
      "skos:notation": "A_Serialize",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#A_Serialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.d_constraints",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "State the constraints, with denominators"
        }
      ],
      "skos:definition": [
        {
          "@value": "Money, network traffic, graph size, latency. Each needs a NUMBER and each number needs a denominator, because a constraint with no denominator is a preference: \"the graph is too big\" is not a finding, \"6.2 MB per publication against a 100 GB free tier\" is. Say which figures were measured, which were quoted from a vendor, and which could not be obtained — a figure from a chat message is none of the three, and the who-iris catalogue carries the worked example where \"0.7 TB\" propagated through ten files and the measured figure was about half."
        }
      ],
      "skos:notation": "D_Constraints",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#D_Constraints",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.d_undetermined",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the decision as still open"
        }
      ],
      "skos:definition": [
        {
          "@value": "An undetermined decision is DATA, not silence. It is recorded with what it waits on and what would settle it, so the next session can tell \"nobody has chosen\" from \"somebody chose and did not write it down\" — the same third state bean-blocking keeps for a block with no expiry."
        }
      ],
      "skos:notation": "D_Undetermined",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#D_Undetermined",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.e_humaneyes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Human eyes on the rendered artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean xies, gate 3, and the one that is easy to drop because gate 2 (merge to main) looks like an approval. It is not: merging approves the CHANGE, and this approves what a reader will actually see. continual-progress measured why a description cannot stand in for it (PR #178, 2026-09-16)."
        }
      ],
      "skos:notation": "E_HumanEyes",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#E_HumanEyes",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.e_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Decide what may leave the repository"
        }
      ],
      "skos:definition": [
        {
          "@value": "EDITORIAL, and it is stage 1 rather than a filter bolted to the exporter. kg-export produces the WHOLE graph because inspection wants the whole graph; a portal wants what its readers may see. Running the second as the first is how a QA verdict, a bean's blocking note or an unpublished draft reaches a public cache. Decided once, here, rather than at each consumer."
        }
      ],
      "skos:notation": "E_Scope",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#E_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.p_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Verify what arrived against what was signed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Against a GDHCN DID trustlist, which means the verifier needs THE NETWORK and not only the bytes — the key is resolved from the trustlist rather than read out of the package. The trustlist is itself static JSON served from a CDN (`tng-cdn.who.int`), and its path is a hierarchical filter — domain, participant, key usage, with `-` as a wildcard — so a verifier fetches the slice it needs rather than the whole list. WHO's own trust network is therefore the same shape as this diagram one layer down, which is the strongest argument the design has. The stage that gets dropped, because every other stage produces something visible and this one produces nothing when it passes. A package that is signed and never verified is a package whose signature is decoration. A portal that CANNOT verify reports `unknown` — a portal nobody asked is not a portal that checked."
        }
      ],
      "skos:notation": "P_Verify",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#P_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_kgtoportal.s_sign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign the package and/or each asset"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE TRUST ANCHOR IS GDHCN, SPECIFIED BY THE WHO SMART TRUST IG (owner, 2026-09-20: `propsal signing = GDHCN`, then `smart-trust`). READ OFF THAT IG rather than from general knowledge: a GDHCN trustlist distributes KEY MATERIAL as W3C DID documents, and says nothing about what you wrap your bytes in — the health-certificate envelope is a separate specification in the same IG, and a document package is not a health certificate. So what is settled is where a verifier GETS THE KEY, not what it verifies. A portal that can fetch the bytes but not reach the trustlist cannot verify, which is `unknown` and not a failure — air-gapped is a declared deployment value, so that case is answered rather than assumed away. Still OPEN and unread: the rotation and revocation model, and whether a document-package signature can be expressed for a GDHCN-aware verifier at all. Two schemes with different properties remain to choose between, and the trustlist does not choose between them. A PACKAGE signature over the manifest verifies the SET — nothing added, removed or altered — and must be reissued whenever any file changes. A PER-ASSET signature verifies one file independently, which is what an edge cache serving one asset can actually check, and it cannot detect a removal because there is nothing left to verify. They compose; composing them is the safer and more expensive default, and it is the deployment's choice rather than the pipeline's."
        }
      ],
      "skos:notation": "S_Sign",
      "dcterms:source": "cat-harness/processes/kg/kg-to-portal.bpmn#S_Sign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_l1gate.task_checkderived",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Is every derived artefact present?"
        }
      ],
      "skos:definition": [
        {
          "@value": "L1 source to L1 KG is NOT complete while a required derived artefact is missing. This is the gate that makes the derivation steps obligatory rather than aspirational."
        }
      ],
      "skos:notation": "Task_CheckDerived",
      "dcterms:source": "cat-harness/processes/library/ingest-l1-completeness-gate.bpmn#Task_CheckDerived",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_l1gate.task_flagdrift",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the flagged passage"
        }
      ],
      "skos:definition": [
        {
          "@value": "A machine can detect that two readings differ. Which one is right is a human call."
        }
      ],
      "skos:notation": "Task_FlagDrift",
      "dcterms:source": "cat-harness/processes/library/ingest-l1-completeness-gate.bpmn#Task_FlagDrift",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_l1gate.task_roundtrip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA"
        }
      ],
      "skos:definition": [
        {
          "@value": "NOT IMPLEMENTED. Tracked as a bean; see docs/document-ingestion.md. Back-translate each localized narrative into its source language and compare meaning, to catch semantic drift and bad terminology that a forward-only check cannot see."
        }
      ],
      "skos:notation": "Task_RoundTrip",
      "dcterms:source": "cat-harness/processes/library/ingest-l1-completeness-gate.bpmn#Task_RoundTrip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_l1gate.task_verdict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the L1 completeness verdict"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record the completeness verdict in three states — met, unmet, or not yet derivable — as bun run check:l1-complete reports it. Not-yet-derivable is never a pass. An unmet verdict opens a bean and returns to derivation; only a met one lets the entry into library/."
        }
      ],
      "skos:notation": "Task_Verdict",
      "dcterms:source": "cat-harness/processes/library/ingest-l1-completeness-gate.bpmn#Task_Verdict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_copyright",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "COPYRIGHT per bitstream, and for the derived work"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the licence permits for THIS bitstream, and separately whether it permits the derivation. LICENSE-CONTENT.md exists in this repository and the ingestion pipeline does not read it."
        }
      ],
      "skos:notation": "Task_Copyright",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_Copyright",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_declare",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the node `materialized`"
        }
      ],
      "skos:definition": [
        {
          "@value": "The node's state moves from `referenced` to `materialized`, carrying purpose, localPath, gates and (archival) fixity. There is NO default state: a node that has not said is invalid, because 'the author did not say' and 'the author said they could not tell' are different facts."
        }
      ],
      "skos:notation": "Task_Declare",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_Declare",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_enumerate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "ENUMERATE + SUBSET against the source descriptor"
        }
      ],
      "skos:definition": [
        {
          "@value": "Resolve the request against the source's descriptor (one per corpus, in the declared sources/ of the instance that owns it, e.g. who-iris/sources/), read against cat-harness/schemas/source-descriptor.ts BEFORE any gate. Three things come from it and none may be guessed. (1) Which subset strategies the source supports — supportsSubset(). (2) Whether a subset stands on its own: when subsetIsSelfContained is false (mathlib), the request is closed over its dependencies here, and every gate after this one is asked about the CLOSURE, because a subset that omits what its members depend on is not a smaller corpus, it is one that does not build. (3) What enumerating the whole costs — enumerationCost(), which is undefined when the descriptor has no measured denominator; SIZE then refuses rather than estimates. A source with no descriptor is not an error here: it is an unknown, and SIZE refuses on it. Bean w5bn: the descriptor is CALLED here rather than restated."
        }
      ],
      "skos:notation": "Task_Enumerate",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_Enumerate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_fetch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch, and record fixity"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fetch, then record sha256 and byte count. Fixity is REQUIRED for an archival copy: an archive that cannot demonstrate it is unchanged is a copy, and it cannot be re-fetched to check, because the thing it would be re-fetched from is what it exists to survive. The data already exists — every structure.json carries sha256 and bytes, and nothing reads them as fixity."
        }
      ],
      "skos:notation": "Task_Fetch",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_Fetch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_purpose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Declare the purpose: working or archival"
        }
      ],
      "skos:definition": [
        {
          "@value": "working or archival, and it is asked FIRST because three of the five gates mean different things under each. An archival copy keeps the original bytes, never expires, requires fixity, and is the only thing that discharges sourceLoss; a working copy keeps derived content and discharges none of that. A process that gated first and asked afterwards would be judging a copy whose obligations it did not yet know."
        }
      ],
      "skos:notation": "Task_Purpose",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_Purpose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_restrictions",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "RESTRICTIONS unknown is an answer, not a green light"
        }
      ],
      "skos:definition": [
        {
          "@value": "The owner's phrase is 'no restrictions known in context', and that is a STATE, not a green light. GateVerdict is three-valued for this reason alone, and `unknown` is never rendered as `permitted`."
        }
      ],
      "skos:notation": "Task_Restrictions",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_Restrictions",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_retention",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "RETENTION what expires this copy"
        }
      ],
      "skos:definition": [
        {
          "@value": "A copy with no expiry cannot be told from an abandoned one — the same argument bean-blocking makes about a block with no expiry. An ARCHIVAL copy is the exception and it is a specification rather than an omission: freshness() reports it `permanent`, not `no-expiry`."
        }
      ],
      "skos:notation": "Task_Retention",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_Retention",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_size",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SIZE what fraction, and what the whole would cost"
        }
      ],
      "skos:definition": [
        {
          "@value": "What is being taken, and what the whole collection would cost. REFUSES when it cannot tell: 'three items' with no denominator is not a size answer. 0.7 TB is the measured reason the IRIS import is by reference."
        }
      ],
      "skos:notation": "Task_Size",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_Size",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_sourceloss",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SOURCE LOSS what survives if the origin goes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Not hypothetical. The one IRIS record this repository holds carries a handle on iris.wpro.who.int, a regional instance merged into the global one. Only an ARCHIVAL copy of the original bytes discharges this; a working copy cannot, because the derived sections are not the publication."
        }
      ],
      "skos:notation": "Task_SourceLoss",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_SourceLoss",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_materializeremote.task_stayref",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Leave it `referenced`, record why"
        }
      ],
      "skos:definition": [
        {
          "@value": "A refusal is not a failure of the process — it is the process working. The node stays `referenced`, which means the graph still knows it exists and where, and the refusing gate's basis is recorded so the next caller does not re-litigate it."
        }
      ],
      "skos:notation": "Task_StayRef",
      "dcterms:source": "cat-harness/processes/library/materialize-remote.bpmn#Task_StayRef",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergebase.task_abort",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Abort, restore the tree, list what was refused"
        }
      ],
      "skos:definition": [
        {
          "@value": "`git merge --abort`. Each refused path is listed with its pattern's reason, or \"no declared pattern\"."
        }
      ],
      "skos:notation": "Task_Abort",
      "dcterms:source": "cat-harness/processes/sdlc/merge-base.bpmn#Task_Abort",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergebase.task_byhand",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve by hand, then regenerate"
        }
      ],
      "skos:notation": "Task_ByHand",
      "dcterms:source": "cat-harness/processes/sdlc/merge-base.bpmn#Task_ByHand",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergebase.task_classify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Classify every conflicted path against the declared patterns"
        }
      ],
      "skos:definition": [
        {
          "@value": "The first matching pattern decides: take-base, generated-regions, qa-sidecar, or refuse. A path no pattern names refuses."
        }
      ],
      "skos:notation": "Task_Classify",
      "dcterms:source": "cat-harness/processes/sdlc/merge-base.bpmn#Task_Classify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergebase.task_commit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Commit the merge"
        }
      ],
      "skos:notation": "Task_Commit",
      "dcterms:source": "cat-harness/processes/sdlc/merge-base.bpmn#Task_Commit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergebase.task_merge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge the base in, without committing"
        }
      ],
      "skos:definition": [
        {
          "@value": "`git merge --no-ff --no-commit origin/main` on a clean tree (untracked files refuse too, so the final stage cannot sweep in a scratch file)."
        }
      ],
      "skos:notation": "Task_Merge",
      "dcterms:source": "cat-harness/processes/sdlc/merge-base.bpmn#Task_Merge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergebase.task_regen",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Regenerate, asking every CI gate"
        }
      ],
      "skos:definition": [
        {
          "@value": "`bun run regen`: every check/writer pair the CI workflow runs, repeated until the tree settles."
        }
      ],
      "skos:notation": "Task_Regen",
      "dcterms:source": "cat-harness/processes/sdlc/merge-base.bpmn#Task_Regen",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergebase.task_resolve",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve each by its declared strategy"
        }
      ],
      "skos:definition": [
        {
          "@value": "qa-sidecar paths first, through `qa:resolve-conflicts`; take-base paths take the base's copy; generated-regions files take the base's side of each hunk, which lies inside a generated region by construction."
        }
      ],
      "skos:notation": "Task_Resolve",
      "dcterms:source": "cat-harness/processes/sdlc/merge-base.bpmn#Task_Resolve",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.call_checkspresent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Find members with no CI on their head [pr-checks-present]"
        }
      ],
      "skos:definition": [
        {
          "@value": "GitHub runs no `pull_request` CI while a PR conflicts, so a member can arrive with nothing on its head (bean `u7be` item 3). That member is T2's first suspect if the train goes red."
        }
      ],
      "skos:notation": "Call_ChecksPresent",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Call_ChecksPresent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.call_ejecthandback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand the culprit back [merge-refusal]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The same hand-back as a refused placement (#1888), carrying the ejection's evidence (R4). Then the train re-runs without it."
        }
      ],
      "skos:notation": "Call_EjectHandBack",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Call_EjectHandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.call_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the gate set on the train [code-quality-gates]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every gate CI runs, on the combination (R2): a member that passes alone can still break `main` with another. The merge-gate epic (`nok9`, #1887) adds its gates here when they land."
        }
      ],
      "skos:notation": "Call_Gates",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Call_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.call_handback",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand it back [merge-refusal]"
        }
      ],
      "skos:definition": [
        {
          "@value": "`merge-refusal.bpmn` (PR #1888, bean `zacz`): a bean under the right epic, a hand-back to the owning session with a fail condition (agent-handoff, #1884), or a dispatch when nobody owns it. R4: the PR returns with its reason."
        }
      ],
      "skos:notation": "Call_HandBack",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Call_HandBack",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.call_mergemembers",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Merge each member onto the base [merge-base]"
        }
      ],
      "skos:definition": [
        {
          "@value": "`merge-base.bpmn` once per member, in order, `--no-regen`; then ONE `bun run regen` over the result. Tool: `merge:train`. Always onto the current base, never a cached one (R5)."
        }
      ],
      "skos:notation": "Call_MergeMembers",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Call_MergeMembers",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_admit",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Admit it to the train, record the train id"
        }
      ],
      "skos:definition": [
        {
          "@value": "Writes the queue entry's `trainId` and `placement` (rule, class, rank) with who decided and when. A decision, so it is stored; the facts it was decided on are not. PRECONDITION, CHECKED RATHER THAN ASSUMED: the worktree carries no untracked, non-ignored file before the member is merged and the tree regenerated. `git status --porcelain` must be empty. The reason is specific: generated directory READMEs carry a per-subdirectory file count, and the writer counts the files GIT WOULD COMMIT -- `git ls-files --cached --others --exclude-standard` (bootstrap-tools/scripts/git-files.ts:23). `--exclude-standard` already keeps IGNORED junk out, which is the `__pycache__` case that drove that line, but `--others` still counts an untracked file nobody has ignored. So a transient written by an earlier train step moves a committed count, `readme:subgraphs:check` goes red, and the red belongs to nobody. Train 6 hit this. The count is volatile for a second reason the precondition cannot fix: two members each adding a file write different integers to one line. Measured in bean `y7b3` -- 76 of 300 replayed merges conflicted on `beans/README.md`, every one on the `| defs/ | N files |` line -- and the exposure is wider than that bean states: 54 generated READMEs across 14 instances carry 207 such rows (measured 2026-10-02). `merge:main` already resolves them (`readme-generated-regions`), so the cost falls on merges made by plain git. The chosen fix is bean `ba9e`: take the integer off `main` into the KG's `_data` layer, which classifies `take-base` and is therefore auto-resolved, leaving the README with a marker that is invariant until the directory crosses LIST_LIMIT. Not done here -- it spans the pinned `bootstrap-tools` submodule."
        }
      ],
      "skos:notation": "Task_Admit",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_Admit",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_attribute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Attribute the failure: each member's own CI first"
        }
      ],
      "skos:definition": [
        {
          "@value": "T2 (SQ19 §2.1 pp. 2-3). A member whose own PR CI is red, or never ran on its head, is the prime suspect, and the evidence is already on GitHub. Only when every member is green alone is the failure a real conflict between them."
        }
      ],
      "skos:notation": "Task_Attribute",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_Attribute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_bisect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Bisect the train"
        }
      ],
      "skos:definition": [
        {
          "@value": "Halve the members and re-run the gates on each half until the conflicting one is found: two or three CI runs for three to six members. Only reached when the cheap evidence is silent."
        }
      ],
      "skos:notation": "Task_Bisect",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_Bisect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_eject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Eject the culprit, record why"
        }
      ],
      "skos:definition": [
        {
          "@value": "T1 (R3; SQ19 §2.2 p. 3): the culprit leaves, the rest re-run. Writes `ejection` on its queue entry (train id, reason, evidence URL, when) and a dated evidence snapshot on this instance. The train is never rejected whole for one member."
        }
      ],
      "skos:notation": "Task_Eject",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_Eject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_land",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land the train at the tested SHA"
        }
      ],
      "skos:definition": [
        {
          "@value": "R1: what lands is exactly what CI tested. If `main` moved after the train's CI started, re-run rather than land (open question for the owner in the requirements note §6). Clears each member's `trainId`; its preview is then taken down by `feature-staging.bpmn`."
        }
      ],
      "skos:notation": "Task_Land",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_Land",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_override",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place it by hand, with a reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "Recorded as a queue entry whose placement is `override` with a position and a reason; the schema refuses one without a reason. It enters the next placement as the table's `ownerOverride` input."
        }
      ],
      "skos:notation": "Task_Override",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_Override",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_readlive",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read each queued PR's live facts"
        }
      ],
      "skos:definition": [
        {
          "@value": "From GitHub and the checkout, now: authored paths, shared declarations, size, conflict risk and overlap KIND against the other queued PRs (T3), own CI and whether it ran on the head (T2). Tools: `merge:overlap` for the overlap facts, `check:head-has-run` for `ownCi`. Nothing read here is written to a queue entry; it is the input to the placement table. `ownCi` IS NOT A VERDICT READ. Never ask whether anything is red: ask which workflow runs are OWED for the head's event and whether each one is present and successful. The two readings come apart, measured 2026-10-02 on #1889's head 7ab6119405 -- 9 runs present, all 9 gating job NAMES matching, 3 of them in_progress with a null conclusion, and 3 check SUITES completed as `action_required` having executed nothing. A filter for conclusion = failure finds zero, and counting the runs does not catch it either. `check:head-has-run` is the only thing here that asks the owed question (bean `3pqn`), and the five states it distinguishes are the five values of `ownCi`. `Rule_HeadNotGreen` in merge-priority.dmn then hands back anything but `green`, so this is a gate the engine applies rather than advice a steward remembers. Overlap kind matters as much as overlap: `merge:overlap` over all 36 open PRs on 2026-10-02 (459 pairs) found #1907 x #1909 NOT independent on `package.json` alone, with zero authored content shared. `generated-only` needs a regeneration and `shared-declaration` needs ordering; only `authored` needs a train."
        }
      ],
      "skos:notation": "Task_ReadLive",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_ReadLive",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_release",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Release the merge to main"
        }
      ],
      "skos:definition": [
        {
          "@value": "Explicit confirmation before merging to `main`, or a standing ruling the steward quotes verbatim with its date (2026-10-01: \"you may merge green PRs\")."
        }
      ],
      "skos:notation": "Task_Release",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_Release",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_retryflaky",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Retry a declared-flaky gate once"
        }
      ],
      "skos:definition": [
        {
          "@value": "T7, narrow (R11; TAP17 Table II p. 5): only gates on a declared flaky list (browser e2e), once, both outcomes recorded. A deterministic gate is never retried: that would spend a CI cycle to learn nothing."
        }
      ],
      "skos:notation": "Task_RetryFlaky",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_RetryFlaky",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_siblingfix",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fix the PR, then re-signal ready"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the sibling's own branch: merge main in, fix, push, and re-mark ready (`ready: <head sha>`). It re-enters the queue as a new placement; the ejection stays on its entry until a later train lands it."
        }
      ],
      "skos:notation": "Task_SiblingFix",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_SiblingFix",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mergetrain.task_takenext",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Take the next PR in queue order"
        }
      ],
      "skos:definition": [
        {
          "@value": "Owner overrides at their positions first, then by the table's rank, then by PR number, oldest first (`scripts/merge-queue.ts` `orderQueue`)."
        }
      ],
      "skos:notation": "Task_TakeNext",
      "dcterms:source": "cat-harness/processes/sdlc/merge-train.bpmn#Task_TakeNext",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_integrate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Integrate: call existing processes"
        }
      ],
      "skos:definition": [
        {
          "@value": "The method's steps become a process whose judgement points call the processes that already exist (adjudication, options analysis, review) by calledElement. Nothing is re-implemented. A needed change to an existing process becomes a bean against its owner."
        }
      ],
      "skos:notation": "A_Integrate",
      "dcterms:source": "cat-harness/processes/library/methodology-from-source.bpmn#A_Integrate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_origin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish origin and licence"
        }
      ],
      "skos:definition": [
        {
          "@value": "Authors, publication, identifier, and the licence the source itself states. No stated licence means reference only: headings, page ranges and a summary in our own words; the file stays in uploads/ (git-ignored) pinned by checksum. A method with no origin is a house process; write a skill instead."
        }
      ],
      "skos:notation": "A_Origin",
      "dcterms:source": "cat-harness/processes/library/methodology-from-source.bpmn#A_Origin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_place",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Place by ownership; declare the directory"
        }
      ],
      "skos:definition": [
        {
          "@value": "A domain-neutral method belongs to the harness and a domain method to the folio that owns the domain. If the session cannot write where it belongs, draft it where it can, say so in the file, and open a bean to move it."
        }
      ],
      "skos:notation": "A_Place",
      "dcterms:source": "cat-harness/processes/library/methodology-from-source.bpmn#A_Place",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render the method: adopted vs refused"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the source says, section by section, then a table of what this platform adopts and what it refuses, each with a reason. Extensions beyond the source (such as web plus mobile where the paper studied mobile) are stated as ours. Reported results are not imported as facts."
        }
      ],
      "skos:notation": "A_Render",
      "dcterms:source": "cat-harness/processes/library/methodology-from-source.bpmn#A_Render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.a_tools",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Every skill and tool used becomes a Tool"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each script, CLI or checker the process relies on gets a Tool node in cat-harness/tools/index.ts that satisfies a named skill, validated by folio-assistant's ToolDefinitionSchema."
        }
      ],
      "skos:notation": "A_Tools",
      "dcterms:source": "cat-harness/processes/library/methodology-from-source.bpmn#A_Tools",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.call_ingest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ingest into library/"
        }
      ],
      "skos:definition": [
        {
          "@value": "folio-assistant's document ingestion, choosing the rung mechanically (embedded outline, pages, OCR). Section text is written only when the licence allows it."
        }
      ],
      "skos:notation": "Call_Ingest",
      "dcterms:source": "cat-harness/processes/library/methodology-from-source.bpmn#Call_Ingest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.call_relatedwork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Related work: find, sort, ask"
        }
      ],
      "skos:definition": [
        {
          "@value": "Search beans, issues and open PRs for work the method touches, categorize and summarize them, and ask the owner whether and how to coordinate. CRDM calls the same sub-process."
        }
      ],
      "skos:notation": "Call_RelatedWork",
      "dcterms:source": "cat-harness/processes/library/methodology-from-source.bpmn#Call_RelatedWork",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_methodologyfromsource.o_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the adoption"
        }
      ],
      "skos:notation": "O_Review",
      "dcterms:source": "cat-harness/processes/library/methodology-from-source.bpmn#O_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mountsubgraph.task_mountbranchtip",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mount the branch tip at the declared path"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `branch` source keyed by `tip`: `branch-store mount --id <dir-id>` writes the tip's files at the declared path, so every reader finds the directory where it always was; `push` splices edits back onto the tip, never forcing, and a same-file race is a conflict. The branch's NAME is the special-branches row the resolver attached — a branch no row declares is refused rather than guessed. A `commit`-keyed branch is read per commit through its own store (`qa-store`), not mounted."
        }
      ],
      "skos:notation": "Task_MountBranchTip",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_MountBranchTip",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mountsubgraph.task_refuseunknownkind",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refuse: no flow for this source kind"
        }
      ],
      "skos:definition": [
        {
          "@value": "A kind added to the union (a graph database, say) before this diagram and the mount tool learn it. Refused with its own exit code — reading it as a directory would scan an empty path and report it clean, the `dh4f` defect."
        }
      ],
      "skos:notation": "Task_RefuseUnknownKind",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_RefuseUnknownKind",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mountsubgraph.task_resolvesource",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the subgraph's content source"
        }
      ],
      "skos:definition": [
        {
          "@value": "`declaredSubgraph(start, id)`: the declaring instance, the entry, and the resolved source with `declaredIn` saying which layer answered. Never read `source` off the declaration directly — the config override and the legacy `storage` field are folded in by the resolver and nowhere else. A contradiction (both `source` and `storage`; a `qa` subgraph keyed by tip) throws here, before anything is mounted."
        }
      ],
      "skos:notation": "Task_ResolveSource",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_ResolveSource",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_mountsubgraph.task_usecheckoutpath",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Use the checkout path in place"
        }
      ],
      "skos:definition": [
        {
          "@value": "A `directory` source IS its declared path. Nothing is mounted; a write is an ordinary commit on the working branch, which is why `branch-store push` answers \"commit through git\" for it rather than pushing anything."
        }
      ],
      "skos:notation": "Task_UseCheckoutPath",
      "dcterms:source": "cat-harness/processes/kg/mount-subgraph.bpmn#Task_UseCheckoutPath",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativecodereview.a_attest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Attest the pair, with a reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "The prose holds: record it with `bun run pairs:attest -- --sidecar … --by agent|human --reason \"…\"`, naming what was compared. The attestation moves the pair's baseline to the current hashes, so the staleness flag clears and stays cleared until the code moves again."
        }
      ],
      "skos:notation": "A_Attest",
      "dcterms:source": "cat-harness/processes/sdlc/narrative-code-review.bpmn#A_Attest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativecodereview.a_raisefinding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise a finding against the wrong side"
        }
      ],
      "skos:definition": [
        {
          "@value": "The prose and the code really disagree: raise a finding that names which side is wrong and why. Usually the prose, because the code is what runs — but a skill can state intended behaviour correctly while the code has regressed, and then the finding is against the code."
        }
      ],
      "skos:notation": "A_RaiseFinding",
      "dcterms:source": "cat-harness/processes/sdlc/narrative-code-review.bpmn#A_RaiseFinding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativecodereview.a_readpairfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the pair checks' findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the subject's kg-qa sidecar and list what is open: a failing prose-reviewed-since-code-changed (code moved, prose did not), and every false or undetermined claim from prose-claims-resolve — `bun run pairs:claims` prints the full list, including what it did not check. Claims that hold and pairs that are not stale need nothing."
        }
      ],
      "skos:notation": "A_ReadPairFindings",
      "dcterms:source": "cat-harness/processes/sdlc/narrative-code-review.bpmn#A_ReadPairFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativecodereview.a_reread",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-read the prose against the code"
        }
      ],
      "skos:definition": [
        {
          "@value": "For each open item, read the prose claim beside the code it describes and decide what is true. For a stale pair, read what changed in the code and whether the prose still describes it. For an undetermined claim, say whether it points at something real outside this repository. For a false claim, check the checker's reading before trusting it."
        }
      ],
      "skos:notation": "A_ReRead",
      "dcterms:source": "cat-harness/processes/sdlc/narrative-code-review.bpmn#A_ReRead",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativecodereview.call_adjudication",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate against the checker"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer and a checker read the same claim differently — a disagreement about ONE kg-qa criterion (prose-claims-resolve). Descend into Process_CriterionAdjudication, which runs the shared adjudication and then one of its three outcomes: the checker's finding stands, the criterion is scoped, or a dispensation is granted with its reason. The checker's entry is kept beneath the verdict rather than overwritten (requirement R4 of issue #1042)."
        }
      ],
      "skos:notation": "Call_Adjudication",
      "dcterms:source": "cat-harness/processes/sdlc/narrative-code-review.bpmn#Call_Adjudication",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativereview.call_voiceoverlay",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Voice overlay review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_VoiceReview for whichever named voices the folio has ACTIVATED — the WHO editorial style, the guideline-development register, the publication design conventions, the Milnor exposition standard. No new role is taken on: register is what this lane already judges, and a voice is a register. Placed after the base voice adjudication because a voice OVERLAYS the house voice rather than replacing it, so the house finding has to be settled first. Its own first gateway leaves immediately when no voice is active, which is this instance's case and the default everywhere."
        }
      ],
      "skos:notation": "Call_VoiceOverlay",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Call_VoiceOverlay",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativereview.task_adjudicatevoice",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the voice findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three outcomes, all legitimate: the register is wrong for this genre; the criterion does not belong in this genre and should carry `profiles`; or the block is a stated exception and a reviewer entry records why."
        }
      ],
      "skos:notation": "Task_AdjudicateVoice",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_AdjudicateVoice",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativereview.task_readfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the sidecar findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the block's `.qa.json`, not just the evidence line: register is a property of the passage, and the sidecar quotes one line of it."
        }
      ],
      "skos:notation": "Task_ReadFindings",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_ReadFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativereview.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record findings as advice"
        }
      ],
      "skos:definition": [
        {
          "@value": "A reviewer cannot accept a change — that is the editor's lane — so the output is findings on the sidecar, not a commit."
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_narrativereview.task_reviewtranslation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the translation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Coverage, preserved terms and echoes are mechanical. A semantic round trip needs a back-translator that has not seen the original; where none has run, the criterion carries no verdict and that is the honest state."
        }
      ],
      "skos:notation": "Task_ReviewTranslation",
      "dcterms:source": "cat-harness/processes/content/review-narrative.bpmn#Task_ReviewTranslation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Apply it, and state each option's trade-offs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Follow the selected methodology as written — adopted whole, not blended with another. At least two real options: one option is not a choice, and a straw option is worse than a short list because it makes the analysis look thorough while narrowing it. Never quantify the comparison to make it look measured. Where a method scores and sums, this platform takes the structure and refuses the arithmetic: the weights are invented and a total reads as a measurement."
        }
      ],
      "skos:notation": "A_Apply",
      "dcterms:source": "cat-harness/processes/sdlc/options-analysis.bpmn#A_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_checkevidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check the selected methodology's evidence base"
        }
      ],
      "skos:definition": [
        {
          "@value": "Before applying a methodology, establish that the thing being applied is what it claims to be. A methodology is adopted because it is somebody else's named, external work; this step checks that the `origin` it cites resolves to a source in a declared library, and reads the `methodology-evidence` QA sidecar for it. WHY THE CHECK IS HERE AND NOT AT ADOPTION. Adoption happens once; selection happens every time a decision is made. A source that was reachable when the methodology was adopted can stop being so, and a methodology adopted before this axis existed was never checked at all. Measured 2026-09-22: six methodologies cited an origin and NONE had that source in any library, so every selection made until then rested on an unverifiable citation. WHAT A GAP DOES AND DOES NOT DO. A missing source does NOT block the decision, and this step has no branch that stops the process — that would make a documentation gap into an outage, and the owner decides whether an unbacked methodology may still be used. It does two things: it runs `literature-search` to try to close the gap, and it puts the evidence state into the record `A_Record` writes, so a reader can tell a decision made on a verified method from one made on a citation nobody could follow. The third state is the one that matters. \"Source ingested\", \"source located but unreachable from here\" and \"no source found\" are three different facts, and `literature-search` exists largely to stop the middle one being reported as the last."
        }
      ],
      "skos:notation": "A_CheckEvidence",
      "dcterms:source": "cat-harness/processes/sdlc/options-analysis.bpmn#A_CheckEvidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_frame",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Frame the decision and check the trigger"
        }
      ],
      "skos:definition": [
        {
          "@value": "One sentence naming the KIND of thing being chosen, not the options — \"which cache strategy\", never \"A or B\". Then the trigger: is this irreversible, or would the answer surprise someone? If neither, say so and stop; the calling step decides without this subprocess. Stopping here is a correct outcome, not a skipped step."
        }
      ],
      "skos:notation": "A_Frame",
      "dcterms:source": "cat-harness/processes/sdlc/options-analysis.bpmn#A_Frame",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the recommendation AND the rejected options"
        }
      ],
      "skos:definition": [
        {
          "@value": "The rejected options and why they lost are part of the output, not an appendix. A rejected option with no record is a dead end nobody marked, and the next agent walks into it — the same argument `bean-coordination` makes for `scrapped` over deleted. In a bean context the form is MADR's. Which methodology was followed is named here, so a reader can check the method rather than take the conclusion."
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/sdlc/options-analysis.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_optionsanalysis.a_select",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Select the methodology by context"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask the selection question in order, first yes decides: do the criteria RECUR with the same inputs having to produce the same answer; is this the CERTAINTY of a body of evidence behind a recommendation; is the context a BEAN recording a decision; otherwise a one-off choice among candidates. If none fits, that is a finding — say which question the decision is and that no adopted methodology covers it. Do not improvise one and do not stretch the nearest fit. The declared set is the contents of the `methodology` graph. Ask for it; do not remember it."
        }
      ],
      "skos:notation": "A_Select",
      "dcterms:source": "cat-harness/processes/sdlc/options-analysis.bpmn#A_Select",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clean: close the open pr-no-checks issue, if any, saying why (every open pull request's head now has a CI run). Runs only on a clean verdict — on unknown the issue is left untouched and the job fails instead, because could-not-check is never rendered as clean."
        }
      ],
      "skos:notation": "Task_Close",
      "dcterms:source": "cat-harness/processes/sdlc/pr-checks-present.bpmn#Task_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment ONCE per (PR, head sha)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Comment on each affected open PR once per (PR, head sha): a hidden marker carrying the sha is checked first, so a re-run on the same head stays silent and a new push can be reported again. A PR that is no longer open is skipped."
        }
      ],
      "skos:notation": "Task_Comment",
      "dcterms:source": "cat-harness/processes/sdlc/pr-checks-present.bpmn#Task_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the tracking label exists"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the pr-no-checks label with --force so it exists before either issue path runs — the close path filters on it too, and on a repository that has never had a finding it would not exist yet. Skipped on an unknown verdict."
        }
      ],
      "skos:notation": "Task_Label",
      "dcterms:source": "cat-harness/processes/sdlc/pr-checks-present.bpmn#Task_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_sweep",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask, per open PR, whether its HEAD has a run — skipping heads younger than 15 min"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run check:prs-have-runs --min-age-minutes 15, writing the report file first. A head younger than 15 minutes legitimately has no run yet and is skipped. Exit 0 clean, 1 findings, 2 could not determine; an exit 1 with no report file is a crash and is treated as could-not-determine."
        }
      ],
      "skos:notation": "Task_Sweep",
      "dcterms:source": "cat-harness/processes/sdlc/pr-checks-present.bpmn#Task_Sweep",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_prcheckspresent.task_track",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings: EDIT the one open issue labelled pr-no-checks if there is one, otherwise create it, with the sweep's report as the body. One issue edited in place, never a new issue or a comment per run, so the tracking issue never becomes a feed."
        }
      ],
      "skos:notation": "Task_Track",
      "dcterms:source": "cat-harness/processes/sdlc/pr-checks-present.bpmn#Task_Track",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_publishalert.a_comment",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Comment on the open issue, naming the step"
        }
      ],
      "skos:definition": [
        {
          "@value": "Add this failure to the open issue as a comment (which notifies), and refresh the body to the latest state."
        }
      ],
      "skos:notation": "A_Comment",
      "dcterms:source": "cat-harness/processes/sdlc/publish-alert.bpmn#A_Comment",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_publishalert.a_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the publication-manager label"
        }
      ],
      "skos:definition": [
        {
          "@value": "The alert is a tracking issue labelled `publication-manager` — the role, not a person, because no actor declares a GitHub account for it. Whoever watches that label is alerted."
        }
      ],
      "skos:notation": "A_Label",
      "dcterms:source": "cat-harness/processes/sdlc/publish-alert.bpmn#A_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_publishalert.a_open",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the tracking issue, naming the failed step"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open the issue with the step that failed, the run link and — for a verification failure — the verifier report."
        }
      ],
      "skos:notation": "A_Open",
      "dcterms:source": "cat-harness/processes/sdlc/publish-alert.bpmn#A_Open",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_publishalert.u_triage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Triage the failure: hold or fix forward"
        }
      ],
      "skos:definition": [
        {
          "@value": "The publication manager reads what failed and decides: hold the release, or fix forward and publish again. Nothing was deployed on a failure before the deploy; a failure after it (the deploy itself, or the previews lost) is live, and says so. The next successful publish closes the issue."
        }
      ],
      "skos:notation": "U_Triage",
      "dcterms:source": "cat-harness/processes/sdlc/publish-alert.bpmn#U_Triage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_publishverification.a_verify",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run every verifier over the export"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the verifier set (scripts/publish-verify.ts, `bun run publish:verify -- --dir <site>`) over the built tree. A SET: each verifier is one entry, and adding one changes nothing else. The first is JSON-LD expansion under a real processor, network refused — a property the context does not declare, a relative IRI or a context that will not load is a finding. Only documents of OURS are verified; third-party data in the tree is counted and cannot block."
        }
      ],
      "skos:notation": "A_Verify",
      "dcterms:source": "cat-harness/processes/sdlc/publish-verification.bpmn#A_Verify",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_apisign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign over the API"
        }
      ],
      "skos:definition": [
        {
          "@value": "The attestation service signs the run hashes. Reached only from the one table row that has both egress and a configured endpoint."
        }
      ],
      "skos:notation": "Task_ApiSign",
      "dcterms:source": "cat-harness/processes/sdlc/qa-report-signing.bpmn#Task_ApiSign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_buildrun",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the test run [folio-test-run/v1]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assemble the run record the signature will cover: the data hash and the process hash, each all-or-nothing. An UNKNOWN_HASH never reproduces another unknown, so a run that could not be hashed is signable only as what it is — unverifiable."
        }
      ],
      "skos:notation": "Task_BuildRun",
      "dcterms:source": "cat-harness/processes/sdlc/qa-report-signing.bpmn#Task_BuildRun",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_humansign",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign as release authority"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person attests the run hashes out of band. This is a userTask, not a serviceTask, and the distinction is enforced: `fulfilmentKindsForBpmnType` will not let a system actor fill it, which is what stops the air-gapped route quietly becoming another machine route."
        }
      ],
      "skos:notation": "Task_HumanSign",
      "dcterms:source": "cat-harness/processes/sdlc/qa-report-signing.bpmn#Task_HumanSign",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_recordattestation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record which route signed it"
        }
      ],
      "skos:definition": [
        {
          "@value": "The attestation records the route, not only the signature. A reader who cannot tell an API signature from a human one cannot tell which trust assumption they are relying on."
        }
      ],
      "skos:notation": "Task_RecordAttestation",
      "dcterms:source": "cat-harness/processes/sdlc/qa-report-signing.bpmn#Task_RecordAttestation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_qareportsigning.task_resolvereach",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the performer's reach [effectiveReach + signing-api probe]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compute the two facts the gateway reads: effectiveReach(deployment, actor) from schemas/actor-reach.ts, and whether the signing-api capability is configured. Undeclared reach resolves to \"unknown\" rather than to the deployment's value — an aggregate does not determine a member."
        }
      ],
      "skos:notation": "Task_ResolveReach",
      "dcterms:source": "cat-harness/processes/sdlc/qa-report-signing.bpmn#Task_ResolveReach",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate the conflict"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human or agentic decision, never a merge rule. Which side wins depends on why the local edit was made, and a process that picked automatically would be choosing without the one fact that decides it."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/processes/library/refresh-materialized.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-materialize, re-asking the five gates — and record the new fixity"
        }
      ],
      "skos:definition": [
        {
          "@value": "The gates are re-asked, not inherited: a licence can change, and a collection can grow past the size a caller agreed to. AND THE NEW FIXITY IS RECORDED IN THE SAME CHANGE. This step rewrites bytes that a materialization record describes, so leaving the old digest behind would make a CORRECT run of this process fail check:materialized-fixity as a mismatch — the gate reading \"somebody edited held content without saying so\" about the one process whose job is to replace it. Measured 2026-09-22 (bean 10s1): this task named no fixity write at all. This is the owner's publication exception, stated as a rule rather than as a carve-out. The exception is NOT \"these actors may skip the rule\"; it is \"say what you did\". A writer that updates the digest alongside the bytes passes, and the record then describes what is actually there. A writer that does not fails, correctly, because it has forked upstream silently. A list of permitted writers would go stale the first time somebody added a sixth one; this does not."
        }
      ],
      "skos:notation": "Task_Apply",
      "dcterms:source": "cat-harness/processes/library/refresh-materialized.bpmn#Task_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_fixity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "ARCHIVAL verify fixity — never re-fetch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Re-compute the digest and compare. An archive is NEVER re-fetched — the source is what it exists to survive, so replacing it with today's version discards the state it was keeping. A mismatch means OUR copy rotted, and the remedy is restoration from a backup, not re-download."
        }
      ],
      "skos:notation": "Task_Fixity",
      "dcterms:source": "cat-harness/processes/library/refresh-materialized.bpmn#Task_Fixity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_keeplocal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep the local edit, and re-pin so it stops being asked"
        }
      ],
      "skos:definition": [
        {
          "@value": "The local edit wins, so nothing is re-materialized — and the pin moves to the upstream revision that was compared against. Re-pinning is the half that is easy to forget and is the reason this is a step rather than an absence: without it the same upstream change is detected as new on every cycle, and a contributor is asked the same settled question for ever. The record says the copy is deliberately divergent FROM a named revision, which is a different claim from being stale against an unknown one."
        }
      ],
      "skos:notation": "Task_KeepLocal",
      "dcterms:source": "cat-harness/processes/library/refresh-materialized.bpmn#Task_KeepLocal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_local",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "What changed LOCALLY since"
        }
      ],
      "skos:definition": [
        {
          "@value": "The half nothing answers today. A materialized copy that was edited in place is not a copy any more, and overwriting it silently destroys work whose existence the process never established."
        }
      ],
      "skos:notation": "Task_Local",
      "dcterms:source": "cat-harness/processes/library/refresh-materialized.bpmn#Task_Local",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_reconcile",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Reconcile the two by hand"
        }
      ],
      "skos:definition": [
        {
          "@value": "Neither side wins whole: the contributor produces content that is neither the local copy nor the remote one, and THEN it is applied. Drawn as a separate step before Task_Apply rather than folded into it, because Task_Apply re-asks the five import gates against what is being materialized — and what is being materialized here is a hand-made artefact, which is exactly the case those gates should see rather than be told about."
        }
      ],
      "skos:notation": "Task_Reconcile",
      "dcterms:source": "cat-harness/processes/library/refresh-materialized.bpmn#Task_Reconcile",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_recordconflict",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the conflict, decide nothing, and do NOT re-pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "Both copies stay and the conflict is written down with what each side says. Deliberately does not re-pin, which is the one thing separating it from Task_KeepLocal: the question is unresolved, so it must be asked again next cycle. Recording is not optional here for the reason A_RecordEntry is not optional in an adjudication — a judgement nobody wrote down is indistinguishable from a check that never ran, and a DEFERRAL nobody wrote down is indistinguishable from a refresh that silently did nothing."
        }
      ],
      "skos:notation": "Task_RecordConflict",
      "dcterms:source": "cat-harness/processes/library/refresh-materialized.bpmn#Task_RecordConflict",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_refreshmaterialized.task_upstream",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "WORKING what changed upstream"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compare the recorded upstreamVersion against the source. `could not reach the source` is a THIRD answer and is never reported as `unchanged` — an unreachable source is the sourceLoss gate firing late. Reachability is asked by `bun run sources:liveness <instance>` against the node's resolvable IRI, its Handle first: live, gone, or could not determine, never live on an error (bean 08u4)."
        }
      ],
      "skos:notation": "Task_Upstream",
      "dcterms:source": "cat-harness/processes/library/refresh-materialized.bpmn#Task_Upstream",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_relatedwork.a_categorize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Categorize and summarize"
        }
      ],
      "skos:definition": [
        {
          "@value": "Each hit gets a category (overlaps: coordinate; affected by; out of scope; unrelated) and a one-line summary with its state. Judgement, not a keyword score: say why each is in its category."
        }
      ],
      "skos:notation": "A_Categorize",
      "dcterms:source": "cat-harness/processes/sdlc/related-work.bpmn#A_Categorize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_relatedwork.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record and act on the answer"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the chosen coordination where it will be found: bean links (--blocked-by, --parent), a line in the issue or PR body, or 'note only'. A declined coordination is recorded too."
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/sdlc/related-work.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_relatedwork.a_searchbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search beans for relevance"
        }
      ],
      "skos:definition": [
        {
          "@value": "beans list --json / beans query over titles AND bodies, open and recently completed. A completed bean is evidence of a decision already made."
        }
      ],
      "skos:notation": "A_SearchBeans",
      "dcterms:source": "cat-harness/processes/sdlc/related-work.bpmn#A_SearchBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_relatedwork.a_searchissues",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Search issues and open PRs"
        }
      ],
      "skos:definition": [
        {
          "@value": "The repository's issues (open and closed) and its open pull requests. An open PR touching the same files is the collision most worth finding early."
        }
      ],
      "skos:notation": "A_SearchIssues",
      "dcterms:source": "cat-harness/processes/sdlc/related-work.bpmn#A_SearchIssues",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_relatedwork.u_coordinate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Coordinate? How?"
        }
      ],
      "skos:notation": "U_Coordinate",
      "dcterms:source": "cat-harness/processes/sdlc/related-work.bpmn#U_Coordinate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderkgtocdn.call_toolsubprocess",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render and push with the target's Tool [its own subprocess]"
        }
      ],
      "skos:definition": [
        {
          "@value": "BOUND BY THE TOOL, so no `calledElement` is written here: the activity names the skill, the Tool satisfies it, and the Tool's `subprocesses` are what this descends into — for `gh-pages`, bootstrap-tools' render-kg-to-github-pages (make sure gh-pages exists and Pages serves it, stage, check the staging, commit onto gh-pages, check what is served). A diagram that named it would make every other CDN a second copy of this process. Whatever the Tool, it returns the two outputs below."
        }
      ],
      "skos:notation": "Call_ToolSubprocess",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Call_ToolSubprocess",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderkgtocdn.task_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the push: status and message"
        }
      ],
      "skos:definition": [
        {
          "@value": "The output, on every path: `pushed`, `not-pushed` or `could-not-determine`, and one message — what is live (a commit), at which root URL, and the QA result. From the no-Tool branch the status is `not-pushed` and the message names the target nobody implements. A check that could not look is never reported as pushed."
        }
      ],
      "skos:notation": "Task_Report",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Task_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderkgtocdn.task_resolve",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the Subgraphs, the root URL and the target's Tool"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every Subgraph id asked for must be one the declaration lists; none means the whole graph. The root URL is the one given. The target's Tool is the one that `satisfies: [\"render-kg-to-cdn\"]` for that CDN — `gh-pages` for GitHub Pages. A caller that already rendered and verified its tree hands the tree over instead of the graph, and the Tool pushes it without rendering again."
        }
      ],
      "skos:notation": "Task_Resolve",
      "dcterms:source": "cat-harness/processes/process/render-kg-to-cdn.bpmn#Task_Resolve",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderlog.a_logremoved",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `removed` with the reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "BEFORE the removal, not after: a job that dies mid-step must leave a record of the intent rather than an artefact that vanished with no entry. A reason is REQUIRED — an entry saying an artefact went and not why is the ambiguity this log exists to prevent."
        }
      ],
      "skos:notation": "A_LogRemoved",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRemoved",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderlog.a_logrendered",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `rendered`"
        }
      ],
      "skos:definition": [
        {
          "@value": "A re-deploy is a rendering, so it gets its own entry rather than overwriting the last. \"When was this last built\" is then answerable without diffing commits."
        }
      ],
      "skos:notation": "A_LogRendered",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRendered",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderlog.a_logrestored",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `restored`"
        }
      ],
      "skos:definition": [
        {
          "@value": "A full-replace deploy (`docs-site.yml`, the only publisher without keep_files) wipes the branch; `restore-staging` carries the previews AND this log back in. Its own event rather than a second `rendered`, because \"somebody pushed this branch\" and \"an unrelated merge nearly deleted it\" are different facts — and bean `plj1` is what happens when the second is invisible."
        }
      ],
      "skos:notation": "A_LogRestored",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRestored",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderlog.a_logretained",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Append `retained` with the reason"
        }
      ],
      "skos:definition": [
        {
          "@value": "THE ENTRY THAT MAKES THE LOG WORTH READING. A preview still standing because a signal fired leaves no trace otherwise, and the next person asking \"why is this still up\" has nothing to consult. A reason is REQUIRED — the tool refuses without one."
        }
      ],
      "skos:notation": "A_LogRetained",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_LogRetained",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderlog.a_preflight",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Preflight: is the preview live?"
        }
      ],
      "skos:definition": [
        {
          "@value": "`previewLiveness` — a disjunction over open-pr, unmerged-branch and recent-commit, shared with the health sweep so the two cannot disagree. Bean `w2g5`: a preview whose pull request is closed is NOT an abandoned one."
        }
      ],
      "skos:notation": "A_Preflight",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_Preflight",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_renderlog.a_remove",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Remove the artefact"
        }
      ],
      "skos:definition": [
        {
          "@value": "`rm -rf STAGING/<slug>`. Cannot reach the log, which lives outside STAGING/ — structural rather than guarded, because a branch named to collide with a directory under STAGING/ slugifies to exactly that name and git permits the ref."
        }
      ],
      "skos:notation": "A_Remove",
      "dcterms:source": "cat-harness/processes/ui/staging-render-log.bpmn#A_Remove",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_repohealth.task_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the health checks, keeping the report either way"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run bun run health --out and upload the JSON report whatever the verdict — on unknown it is the only evidence of why the sweep went blind. Exit 0 clean, 1 gating findings, 2 could not check; exit 1 with no report is a crash. The checks report and never act: every finding names something a person does."
        }
      ],
      "skos:notation": "Task_Check",
      "dcterms:source": "cat-harness/processes/sdlc/repository-health-watch.bpmn#Task_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_repohealth.task_close",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Clean: close the open repo-health issue, if any, saying why (every check ran and none had anything to report). Runs only on a clean verdict — on unknown the issue is left untouched and the job fails instead, because could-not-check is never rendered as clean."
        }
      ],
      "skos:notation": "Task_Close",
      "dcterms:source": "cat-harness/processes/sdlc/repository-health-watch.bpmn#Task_Close",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_repohealth.task_label",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ensure the tracking label exists"
        }
      ],
      "skos:definition": [
        {
          "@value": "Create the repo-health label with --force so it exists before either issue path runs — the close path filters on it too, and on a repository that has never had a finding it would not exist yet. Skipped on an unknown verdict."
        }
      ],
      "skos:notation": "Task_Label",
      "dcterms:source": "cat-harness/processes/sdlc/repository-health-watch.bpmn#Task_Label",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_repohealth.task_track",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings: EDIT the one open issue labelled repo-health if there is one, otherwise create it, with the report as the body. One issue edited in place, never a new issue or a comment per run, so the tracking issue never becomes a feed. The body states that nothing in it has been acted on."
        }
      ],
      "skos:notation": "Task_Track",
      "dcterms:source": "cat-harness/processes/sdlc/repository-health-watch.bpmn#Task_Track",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_review.call_codereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Code node review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_CodeReview. The actor takes on the `code-reviewer` lane for this call path only."
        }
      ],
      "skos:notation": "Call_CodeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_CodeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_review.call_narrativecodereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Prose and the code it describes"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_NarrativeCodeReview: judge what the pair checks could not settle (a stale pair, a false or undetermined claim), and send a disagreement with a checker to adjudication. Issue #1042, stage C."
        }
      ],
      "skos:notation": "Call_NarrativeCodeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_NarrativeCodeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_review.call_narrativereview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Narrative review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Descend into Process_NarrativeReview. The actor takes on the `narrative-reviewer` lane for this call path only."
        }
      ],
      "skos:notation": "Call_NarrativeReview",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Call_NarrativeReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_review.task_classifychange",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Classify what changed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Prose, code nodes, or both. This is the only decision the generic lane makes on its own: everything after it is made inside a subprocess by the role that lane binds. Binds `content-review`, the same skill as Task_Consolidate in this lane, since placement PR3 (bean `63wl`): it named `semantic-review-scoping`, a paper skill folio-assistant-sci owns, which this harness diagram cannot reach. A paper process that wants semantic scoping adds it by calling this process."
        }
      ],
      "skos:notation": "Task_ClassifyChange",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_ClassifyChange",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_review.task_consolidate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Consolidate findings"
        }
      ],
      "skos:definition": [
        {
          "@value": "One report from however many subprocesses ran. Findings are advice: a reviewer cannot accept the change."
        }
      ],
      "skos:notation": "Task_Consolidate",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_Consolidate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_review.task_editordecides",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accept, or send back"
        }
      ],
      "skos:definition": [
        {
          "@value": "The editor's lane, kept separate on purpose: the reviewer who judged the change is not the position that accepts it."
        }
      ],
      "skos:notation": "Task_EditorDecides",
      "dcterms:source": "cat-harness/processes/content/review-task.bpmn#Task_EditorDecides",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sampleimport.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialize remote content (the five gates)"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared subprocess. It resolves the request against the source descriptor, then asks size, restrictions, copyright, retention and source loss, and either fetches with fixity or leaves the content referenced. This process does not restate any of that; it waits for the outcome."
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "cat-harness/processes/library/sample-import.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sampleimport.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh materialized content"
        }
      ],
      "skos:definition": [
        {
          "@value": "Refresh is not re-import: what changed upstream, what changed locally since, and what to do when both did. The shared subprocess answers all three, and re-asks the five gates, since a licence can change and a collection can grow past the size agreed."
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "cat-harness/processes/library/sample-import.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sampleimport.task_importtest",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Import into the store, and test the import"
        }
      ],
      "skos:definition": [
        {
          "@value": "The part only this process does. Load the landed sample into the chosen store and check what an import can get wrong: every item arrived (count against the request), identifiers survived (the descriptor's authoritative ones), structure validates against the store's schema, and provenance (source, revision, fixity) is attached to each node. A check that could not run is a failure, not a pass."
        }
      ],
      "skos:notation": "Task_ImportTest",
      "dcterms:source": "cat-harness/processes/library/sample-import.bpmn#Task_ImportTest",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sampleimport.task_library",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Land it in library/"
        }
      ],
      "skos:definition": [
        {
          "@value": "A permanent sample joins the library as an L1 source, with the materialization record (purpose, gates, fixity) beside it. From here refresh-materialized governs it."
        }
      ],
      "skos:notation": "Task_Library",
      "dcterms:source": "cat-harness/processes/library/sample-import.bpmn#Task_Library",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sampleimport.task_recordfindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what failed"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which check failed, on which items, and the evidence. The landed copy is not removed: a failed import is information about the source or the store, and deleting the copy would destroy the evidence."
        }
      ],
      "skos:notation": "Task_RecordFindings",
      "dcterms:source": "cat-harness/processes/library/sample-import.bpmn#Task_RecordFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sampleimport.task_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the sample: which items, which store, and is it PERMANENT?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Three answers, recorded before anything is fetched. WHICH ITEMS: named by the source's identifiers, or by a subset strategy its descriptor supports. WHICH STORE: the knowledge graph or other structured store the import is tested against. PERMANENT OR TRIAL: a permanent sample lands in library/ and is refreshed; a trial lands in fsh-guts/ and is not. The purpose materialize-remote asks for (working or archival) is asked there, not here."
        }
      ],
      "skos:notation": "Task_Scope",
      "dcterms:source": "cat-harness/processes/library/sample-import.bpmn#Task_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sampleimport.task_trial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Keep it as a trial: the unpublished trashcan"
        }
      ],
      "skos:definition": [
        {
          "@value": "A trial goes to the kept trashcan: addressable, exported, never published. Its node declares `$schema: folio-fsh-guts/v1` and carries the bean or issue it was written under, since it was never moved from anywhere and a `movedFrom` would be invented provenance. It is NOT refreshed: a trial records what the source looked like when it was tried. Promoting a trial means running this process again with permanent = yes, so the gates are asked afresh."
        }
      ],
      "skos:notation": "Task_Trial",
      "dcterms:source": "cat-harness/processes/library/sample-import.bpmn#Task_Trial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_askwhoisacting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask who is acting"
        }
      ],
      "skos:definition": [
        {
          "@value": "The one step that needs a person. Asked ONCE and recorded, never re-asked: `interaction/interaction.json` and the record exist so that a preference stated once is not requested again, which is WCAG 2.2 SC 3.3.7."
        }
      ],
      "skos:notation": "A_AskWhoIsActing",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_AskWhoIsActing",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_closesession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the session"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records that the actor stopped. It does NOT resolve beans or complete instances: those outlive the session by design, and a machine that closed them on the way out would be asserting work finished because somebody went away."
        }
      ],
      "skos:notation": "A_CloseSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_CloseSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_identifyactor",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Establish who is acting"
        }
      ],
      "skos:definition": [
        {
          "@value": "The first step and not a formality: `actor` is the one field of the record that nothing else can supply. Every other field is recoverable by reading the repository; who is acting is not."
        }
      ],
      "skos:notation": "A_IdentifyActor",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_IdentifyActor",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_opensession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the session record"
        }
      ],
      "skos:definition": [
        {
          "@value": "Writes `id`, `actor` and `startedAt`, with `open` and `claimed` empty. An empty `open` is the NORMAL state, not an unfinished one: an agent reading, answering or deciding is in no process at all."
        }
      ],
      "skos:notation": "A_OpenSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_OpenSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_readturn",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Take in the turn"
        }
      ],
      "skos:definition": [
        {
          "@value": "A turn is anything that arrives — a person's message, a tool result, a notification. The machine advances on turns rather than on a clock, because a session that has been told nothing has not changed."
        }
      ],
      "skos:notation": "A_ReadTurn",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_ReadTurn",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_touch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh `updatedAt` only"
        }
      ],
      "skos:definition": [
        {
          "@value": "Nothing changed, and saying so is the point. A record that stops being written looks exactly like an abandoned session; a refreshed timestamp with no other change says the session is alive and idle, which is a different fact and the commonest one."
        }
      ],
      "skos:notation": "A_Touch",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_Touch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_sessionstatemachine.a_updatesession",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write what changed"
        }
      ],
      "skos:definition": [
        {
          "@value": "An instance opened or closed, a bean claimed, a wait started or ended. All by REFERENCE: the bean and the instance are each the authority on themselves, and a status copied here would be free to contradict them. NO `cat-harness.processes:bean` on this step. It records that a claim happened; it does not claim."
        }
      ],
      "skos:notation": "A_UpdateSession",
      "dcterms:source": "cat-harness/processes/process/session-state-machine.bpmn#A_UpdateSession",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_stalledagenttriage.a_collect",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Collect or reconstruct a handover report per agent"
        }
      ],
      "skos:definition": [
        {
          "@value": "Use the agent's own report and check it against live state; if none, ask the agent if it is still reachable, else reconstruct with the handover-report template and mark it reconstructed. Unpushed state is unknown, never empty."
        }
      ],
      "skos:notation": "A_Collect",
      "dcterms:source": "cat-harness/processes/sdlc/stalled-agent-triage.bpmn#A_Collect",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_stalledagenttriage.a_consolidate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Consolidate into 2-4 themes, with a recommendation each"
        }
      ],
      "skos:definition": [
        {
          "@value": "Group by what the work delivers, not by agent. Each theme gets its epic, members, dependencies, risk, and one of: continue, fold in, new epic, park, scrap (owner only)."
        }
      ],
      "skos:notation": "A_Consolidate",
      "dcterms:source": "cat-harness/processes/sdlc/stalled-agent-triage.bpmn#A_Consolidate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_stalledagenttriage.a_footprint",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Find the footprint"
        }
      ],
      "skos:definition": [
        {
          "@value": "handover notes (beans/notes, title 'handover:'), open PRs and branches by session or time window, in-progress beans, workflow instances, last PR and issue comments. REST, one batched pass."
        }
      ],
      "skos:notation": "A_Footprint",
      "dcterms:source": "cat-harness/processes/sdlc/stalled-agent-triage.bpmn#A_Footprint",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_stalledagenttriage.a_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the triage and claim the picked-up work"
        }
      ],
      "skos:definition": [
        {
          "@value": "A 'triage: <date>' bean note on each theme's epic; new or re-parented beans; claims via beans:claim. Owning sessions still alive are notified before their branches are touched."
        }
      ],
      "skos:notation": "A_Record",
      "dcterms:source": "cat-harness/processes/sdlc/stalled-agent-triage.bpmn#A_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_stalledagenttriage.s_reroute",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Re-route open PRs that lost their driver"
        }
      ],
      "skos:definition": [
        {
          "@value": "Green, up-to-date PRs join the queue; mid-merge branches are re-driven from the PR head, never guessed at; red PRs go back to the new driver."
        }
      ],
      "skos:notation": "S_Reroute",
      "dcterms:source": "cat-harness/processes/sdlc/stalled-agent-triage.bpmn#S_Reroute",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_stalledagenttriage.u_decide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Decide each theme"
        }
      ],
      "skos:notation": "U_Decide",
      "dcterms:source": "cat-harness/processes/sdlc/stalled-agent-triage.bpmn#U_Decide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.call_materialize",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Materialise the part [materialize-remote]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The ONLY way bytes arrive. Purpose first, then the five gates — size, restrictions, copyright, retention, source loss — then fetch with fixity, or stay referenced with the refusing gate's basis recorded. Both ends of that subprocess return here and the walk continues: one part refused is not the subscription refused."
        }
      ],
      "skos:notation": "Call_Materialize",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Call_Materialize",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.call_refresh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Refresh the held part [refresh-materialized]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The shared refresh, called, not re-described: what changed upstream, what changed locally, and what to do when both did. An archival copy is fixity-checked and never re-fetched. Whatever that process decides — refreshed, kept divergent, or deferred — is the part's new state; this loop only moves to the next part."
        }
      ],
      "skos:notation": "Call_Refresh",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Call_Refresh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose subgraphs, the asset policy, harnesses"
        }
      ],
      "skos:definition": [
        {
          "@value": "Written to the entry as `subgraphs`, `assets.policy` (none, on-demand or all) and `harnesses`. Choosing is not holding: a chosen subgraph is still referenced until the gates below let it through. Choosing nothing is legitimate — a subscription with no parts chosen is a pinned reference, the case associatedHarnesses covers today."
        }
      ],
      "skos:notation": "Task_Choose",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_instantiate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Instantiate the harness: write its config"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write `<harness>.config.json` at the repository root, plus the state directories the harness declares. That file is what harness-tiles reads as INSTANTIATED, and it is what puts the harness in the navbar's bottom region. check:instance-render must be green on the result; a config that renders nothing is an entry pointing nowhere."
        }
      ],
      "skos:notation": "Task_Instantiate",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_Instantiate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_pin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name the substrate, pin a full commit SHA"
        }
      ],
      "skos:definition": [
        {
          "@value": "`owner/repo` and a 40-character commit SHA — never a branch, never an abbreviated SHA. The schema refuses anything else (SubscriptionSchema.ref), and this step exists so the refusal is met while choosing rather than at commit time. A tag replaces the SHA only once the substrate publishes releases."
        }
      ],
      "skos:notation": "Task_Pin",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_Pin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_record",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the entry and cache the declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `subscriptions` entry in the subscriber's instance declaration — id, repository, ref, and nothing chosen yet — plus a cached copy of the substrate's declaration at the pin. The entry holds the choice and the pin, never state: whether a part is held is answered by its materialisation record, and a second answer here would be free to disagree with it."
        }
      ],
      "skos:notation": "Task_Record",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_Record",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_refuse",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record why it is not a substrate; write no entry"
        }
      ],
      "skos:definition": [
        {
          "@value": "No subscription entry is written for a repository that is not a substrate. What is recorded is the reason (non-conforming, no harness, or unreachable) and the pin it was asked at, so a later attempt at a different commit starts from what failed."
        }
      ],
      "skos:notation": "Task_Refuse",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_Refuse",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_repin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move the entry's ref and re-cache the declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only after every held part has been through the refresh. Moving the ref first would make the records of parts not yet refreshed describe a commit the entry no longer names. The cached declaration is replaced so the review that follows shows what the NEW pin offers, including subgraphs that did not exist at the old one."
        }
      ],
      "skos:notation": "Task_RePin",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_RePin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review what the substrate offers"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every subgraph, asset class and harness the cached declaration names, each with its current state — referenced, materialised, unknown, stale, or refused by a gate. Shown whole, because a reader who sees only what was chosen cannot tell \"not offered\" from \"not taken\"."
        }
      ],
      "skos:notation": "Task_Review",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_summarise",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record how the walk ended, part by part"
        }
      ],
      "skos:definition": [
        {
          "@value": "One line per offered part: materialised, referenced by choice, or referenced because a gate refused (and which). Nothing new is decided here; it is the account the visualizer and the next refresh read, written once rather than reconstructed from the loop."
        }
      ],
      "skos:notation": "Task_Summarise",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_Summarise",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_subscribekg.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Fetch the root declaration at the pin, and validate it"
        }
      ],
      "skos:definition": [
        {
          "@value": "A sparse, shallow fetch of the substrate's root declaration only. Two questions: does it parse as bootstrap's KnowledgeGraphDeclarationSchema, and does it declare at least one harness? `could not fetch` is a third answer and is never read as `conforms`."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "cat-harness/processes/library/subscribe-kg.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_cross",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Cross the axes into SO, WO, ST, WT"
        }
      ],
      "skos:definition": [
        {
          "@value": "The TOWS matching step, and the only step that produces anything actionable. Strengths and weaknesses across, opportunities and threats down, and each cell names the strategy the pairing implies: SO — achieve opportunities that greatly match the strengths; WO — overcome weaknesses to attain opportunities; ST — use strengths to reduce vulnerability to threats; WT — prevent weaknesses, to avoid becoming more susceptible to threats. A SWOT that stops at four lists is the failure the source names as its central one. This step is what the process exists to reach. It produces CANDIDATE strategies, not a chosen one, and they are not ranked — see the process documentation on why no scoring activity exists."
        }
      ],
      "skos:notation": "A_Cross",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_Cross",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_framesubject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Name the subject and the level"
        }
      ],
      "skos:definition": [
        {
          "@value": "One sentence naming WHAT is being analysed and at WHICH level — individual, organisational, national, international. The source requires this before anything is listed: \"the classification of a variable also depends on the purpose of the practice\", and the criteria for assigning a variable to a quadrant \"may be more difficult to clarify if the methodology is not used for a company but for a country\". It also bounds the known limitation that SWOT \"is rarely deployed at lower than the organization level\", where one scan drives strategy for units its factors do not hold equally for. Naming the level does not remove that risk; it makes it visible in the record."
        }
      ],
      "skos:notation": "A_FrameSubject",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_FrameSubject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_groupreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pool knowledge across participants"
        }
      ],
      "skos:definition": [
        {
          "@value": "The four lists are reviewed by more than the person who wrote them. This is the method's own answer to its own bias limitation, and it is a distinct activity rather than advice attached to the scans, because an activity can be recorded as not performed and a recommendation cannot. Disagreement about which quadrant a factor belongs in is an OUTPUT of this step, not a failure of it — it feeds A_RecordAmbiguous."
        }
      ],
      "skos:notation": "A_GroupReview",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_GroupReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_handoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Hand the candidates to a decision methodology"
        }
      ],
      "skos:definition": [
        {
          "@value": "The candidate strategies go to `options-analysis`, which selects the decision methodology by context and applies it. SWOT does not make that selection and does not make the decision. What is handed over includes the ambiguities from A_RecordAmbiguous and the fact that the candidates are UNRANKED. A receiving methodology that assumed an ordered list would be reading a priority SWOT never established."
        }
      ],
      "skos:notation": "A_HandOff",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_HandOff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_recordambiguous",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record what did not classify cleanly"
        }
      ],
      "skos:definition": [
        {
          "@value": "Factors that sit in two quadrants, or in none, are written down as such. The source states this as inherent rather than as analyst error: \"the same factor can be fitted in two categories. A factor can be a strength and a weakness at the same time.\" It adds the two drifts — strengths not maintained become weaknesses, and opportunities not taken but taken by competitors become threats. A scan that silently forced every factor into one quadrant would report a cleanliness the method does not have. This is the same third-state discipline the rest of this repository applies to \"could not determine\": an unclassifiable factor is a finding, not a blank."
        }
      ],
      "skos:notation": "A_RecordAmbiguous",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_RecordAmbiguous",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_scanexternal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the environment opportunities and threats"
        }
      ],
      "skos:definition": [
        {
          "@value": "The external axis, first, per Weihrich. Work the source's categories of environmental change rather than free-associating: societal, governmental, economic, competitive, supplier and market changes, each item recorded with what it impacts. An opportunity is an external element that gives benefit; a threat is one that could cause trouble. Both are outside the subject and largely beyond its control — that is what puts them on this axis, not whether they feel good or bad."
        }
      ],
      "skos:notation": "A_ScanExternal",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_ScanExternal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_swotanalysis.a_scaninternal",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scan the subject strengths and weaknesses"
        }
      ],
      "skos:definition": [
        {
          "@value": "The internal axis. Work the source's functional checklist rather than a blank page: marketing, research and development, management information systems, management team, operations, finance, human resources. A strength gives advantage over others in the field; a weakness places the subject at a disadvantage relative to others. Both are attributes OF the subject. The source's warning belongs to this step specifically: listing strengths on paper \"is very different from testing the organization and experiencing the strengths at work\", so a strength recorded here is a claim, and where evidence for it exists it is cited."
        }
      ],
      "skos:notation": "A_ScanInternal",
      "dcterms:source": "cat-harness/processes/process/swot-analysis.bpmn#A_ScanInternal",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_themeuireview.a_accessibility",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Accessibility: measure, do not assert"
        }
      ],
      "skos:definition": [
        {
          "@value": "Contrast COMPUTED against the real ground, including the worst case a backdrop can present; a non-colour channel wherever colour carries meaning (SC 1.4.1); an accessible name on every region; keyboard and focus order. An automated pass is necessary and not sufficient — axe accepts a non-empty placeholder as an accessible name, and a CSS selector that matches nothing raises no error at all."
        }
      ],
      "skos:notation": "A_Accessibility",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Accessibility",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_themeuireview.a_branding",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Branding: does it read as this instance?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Marks, palettes and art against the instance's own declaration rather than a remembered style. The question a downstream folio makes sharp: would this instance inherit something it did not choose?"
        }
      ],
      "skos:notation": "A_Branding",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Branding",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_themeuireview.a_inventory",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inventory the ingested assets"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which graphical assets arrived, for which surfaces of the website or app design, in which locales, and at which VIEWPORTS: every surface at a web width and at a mobile width (owner, 2026-09-23, issue #1023). Read off the ingested artefacts rather than off the intent — a layout the source declares but does not supply is not in the inventory, and a surface the design needs but no asset covers is the one that would ship wrong."
        }
      ],
      "skos:notation": "A_Inventory",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Inventory",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_themeuireview.a_locales",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Languages: extracted, rendered, and RTL"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every user-facing string reaches the .pot; every declared locale renders without clipping or overflow; right-to-left is laid out rather than mirrored by accident. New UI is where untranslated strings enter, because nothing was stale — there was nothing there before."
        }
      ],
      "skos:notation": "A_Locales",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_Locales",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_themeuireview.a_raisefindings",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Raise findings before the assets land"
        }
      ],
      "skos:definition": [
        {
          "@value": "Findings go back to whoever authored the choice, because the choice was theirs: a theme is picked per note by a human or an agent, and there is no mapping to correct instead. Raised, never silently fixed — a reviewer who re-themes a note has substituted their judgement for the author's without saying so."
        }
      ],
      "skos:notation": "A_RaiseFindings",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#A_RaiseFindings",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_themeuireview.r_judge",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Judge the assets in their design"
        }
      ],
      "skos:definition": [
        {
          "@value": "A person looks at the ingested assets laid out in the design they are for, at BOTH a web and a mobile width. THIS IS A HUMAN STEP INSIDE INGESTION, and that is stated rather than hidden: `ingest-theme.bpmn` used to refuse to call this process for exactly that reason. The owner's ruling puts theme review at ingestion only, and a ruling that moves a review does not remove the person who performs it — so ingestion of a THEME SOURCE is attended at this step, while ingestion of everything else stays unattended because `Gateway_ThemeSource` routes it past. A judgement made at one viewport is incomplete, not passed, and the wireframe of the surface (wireframe-design-review) says what each layout was meant to be. Three defects in the landing board — a selector matching nothing, a crop cutting the subject, a fade wrong in both directions — were invisible to a clean build, a passing suite and every gate, and were found only by rendering the page and looking."
        }
      ],
      "skos:notation": "R_Judge",
      "dcterms:source": "cat-harness/processes/ui/theme-ui-review.bpmn#R_Judge",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate flagged passage (human reviewer)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human SME or editor reviews the flagged passage. They may: - Accept the translation as-is (false positive) - Edit the translation and re-run QA - Reject and request re-translation The round trip establishes that two readings differ. Which one is right is a human call."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_edittranslation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Edit the flagged passage and re-inject"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reviewer corrects the passage in the PO rather than sending the whole translation back. Flows to Task_PoInject, so the round-trip QA runs again over the corrected text — \"edit the translation and re-run QA\", which is what the adjudication step has always offered and what this process could not do. A userTask, not a service task: this is the one step here where a person edits content, and the lane's actor is the reviewer who just adjudicated."
        }
      ],
      "skos:notation": "Task_EditTranslation",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_EditTranslation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_poinject",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Inject translations (PO → Markdown)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reads .po file and source .md, substitutes msgstr for msgid, preserves non-translatable elements, writes translated .md to translations/<locale>/block.md. Tool: translation_inject MCP tool or bun run content/pipeline/po-inject.ts"
        }
      ],
      "skos:notation": "Task_PoInject",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_PoInject",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_potextract",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Extract translatable strings (POT generation)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Scans content nodes and extracts translatable strings to .pot files. Excludes math, labels, code, and Lean companions. Tool: translation_extract MCP tool or bun run content/pipeline/pot-extract.ts"
        }
      ],
      "skos:notation": "Task_PotExtract",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_PotExtract",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_roundtripqa",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Round-trip translation QA (back-translate)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Bean: folio-assistant-ktt2 Back-translates the target-language .md into the source language and compares meaning with the original. Detects semantic drift and terminology misses that a forward-only fluency check cannot see. Tool: translation_validate MCP tool"
        }
      ],
      "skos:notation": "Task_RoundTripQA",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_RoundTripQA",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_signoff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Sign off translation (human adjudicator)"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human reviewer signs off the translation at the chosen hierarchy level (block, section, chapter, or folio). Updates status.json: { official: true, signedOffBy: \"...\", signedOffAt: \"...\", sourceHash: \"...\" } Tool: translation_signoff MCP tool"
        }
      ],
      "skos:notation": "Task_Signoff",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_Signoff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_stalenesscheck",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check staleness (source hash)"
        }
      ],
      "skos:definition": [
        {
          "@value": "On source content change: computes sha256(source.md) and compares to each translation's status.json sourceHash. If they differ, sets stale: true. The translation remains visible with a \"stale — needs re-adjudication\" indicator."
        }
      ],
      "skos:notation": "Task_StalenessCheck",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_StalenessCheck",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_translate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce translation (PO file)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Translation of .pot → .po by one of: 1. Existing PO from smart-base (Weblate/Crowdin/Launchpad) 2. FHIR/translation-utils po-translate CLI (DeepL/Google, tagged #fuzzy) 3. Agent (LLM) translation 4. Human translator Result: <locale>/block.po with msgid/msgstr pairs."
        }
      ],
      "skos:notation": "Task_Translate",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_Translate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_writeofficial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (official)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records the sign-off with the SHA-256 of the source .md, enabling staleness detection on future source changes."
        }
      ],
      "skos:notation": "Task_WriteOfficial",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_WriteOfficial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_translation.task_writeunofficial",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write status.json (unofficial)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Records the translation as unofficial in translations/<locale>/status.json: { official: false, generatedBy: \"...\", generatedAt: \"...\" } The translation is usable but carries a visible warning badge."
        }
      ],
      "skos:notation": "Task_WriteUnofficial",
      "dcterms:source": "cat-harness/processes/library/translation-workflow.bpmn#Task_WriteUnofficial",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_applypin",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Move the pin and open the PR"
        }
      ],
      "skos:definition": [
        {
          "@value": "The pin literal moves in the one file `upstream-pins.json` declares, and the PR body says what the version range changed in RENDERED output — the evidence, not just the verdict."
        }
      ],
      "skos:notation": "A_ApplyPin",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#A_ApplyPin",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_evidence",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Post the MVP evidence staging URL + gate results"
        }
      ],
      "skos:definition": [
        {
          "@value": "Staging URL, gate results and the impact analysis, on the PR. Enough for the reviewer to answer without opening anything else."
        }
      ],
      "skos:notation": "A_Evidence",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#A_Evidence",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_impact",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Impact analysis what of ours binds it"
        }
      ],
      "skos:definition": [
        {
          "@value": "The half a changelog cannot supply, because upstream does not know what you reached into. Worked from the row's `binds` list in `upstream-pins.json`. For the theme: `docs/assets/js/docs-ui.js` MOVES the theme's own search markup into the action launcher and binds `.search`, `#search-input` and `.search-label`; `docs-ui.css` overrides `.side-bar`, `.site-header` and `.main-header`; three e2e specs assert the structure the theme emits. An upstream rename of any of those is not a build failure — it is a shipped feature that quietly stops working."
        }
      ],
      "skos:notation": "A_Impact",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#A_Impact",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_recordoutcome",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record the hold or the decline"
        }
      ],
      "skos:definition": [
        {
          "@value": "A HOLD is a block with an expiry and a revisit trigger: a hold with neither cannot be told from abandoned work, and the next watcher run re-raises the same pin with no memory of why it was left. A DECLINE is a scrapped bean carrying its reasons — what stops the next agent re-entering the same dead end. Either way the decision is written down before the process ends, and the bean is resolved from here: a run that stops at \"we looked and said no\" is as finished as one that moved the pin."
        }
      ],
      "skos:notation": "A_RecordOutcome",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#A_RecordOutcome",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.a_scope",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Scope the delta pinned → candidate"
        }
      ],
      "skos:definition": [
        {
          "@value": "Restricted to the directories that reach our output — for a Jekyll theme `_sass`, `_includes`, `_layouts`, `assets`. Upstream's own docs, CI and tests cannot reach us, and counting them makes a harmless release look alarming. The changelog is the claim; `git diff --stat pinned..candidate` over those paths is the evidence."
        }
      ],
      "skos:notation": "A_Scope",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#A_Scope",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.call_optionsanalysis",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Options analysis adopt · hold · decline"
        }
      ],
      "skos:definition": [
        {
          "@value": "On the single edge into `PM_Decide`, and deliberately not earlier: the MVP build and its gates are HOW the options' costs are measured, so an analysis before `Task_Mvp` would weigh alternatives against no evidence. Everything the decider needs exists by the time the reviewer has finished and the fixable findings are fixed. In the Agent lane, because this step produces the analysis and does not make the decision — `PM_Decide` is a `userTask` whose lane admits `person` only, and putting the analysis in the agent's lane is what keeps that separation legible rather than implied. A subprocess that decided would be a second accepting party. Reached through the loop as well as straight through: `SF_UA_8` re-enters at `A_Impact`, so a run where the reviewer found something fixable arrives here a second time with different evidence. That is a genuine re-analysis and its `op=\"note\"` appends rather than deduping, which is the behaviour wanted — a second note records that the options were weighed again against changed inputs."
        }
      ],
      "skos:notation": "Call_OptionsAnalysis",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#Call_OptionsAnalysis",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.pm_decide",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adopt, hold or decline"
        }
      ],
      "skos:definition": [
        {
          "@value": "A PERSON decides. The lane admits `person` only, so `activity-fulfilment-kind` fails the moment somebody makes an agent the accepting party, and `relaxable=\"false\"` means no package may relax the step. The publication manager rather than the editor because a pin is not a change to the corpus — it is a change to what the published artefact is BUILT FROM, and that role is the one accountable for what is live. Deliberately NOT a DMN-backed gateway. Every computed gateway in this repository reduces to arithmetic over tool output; this one weighs a rendering nobody can score against the cost of staying behind, and a table here would look authoritative without being so."
        }
      ],
      "skos:notation": "PM_Decide",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#PM_Decide",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.r_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the MVP against what we bind to"
        }
      ],
      "skos:definition": [
        {
          "@value": "A narrower question than \"is the new version good\": does everything in `binds` still hold, checked against the deployed page. A `userTask`, and the lane admits `person` and `agent` — a review agent is a legitimate reviewer here, and the separation that matters is the next lane's: a reviewer cannot accept."
        }
      ],
      "skos:notation": "R_Review",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#R_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.task_gates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the row's gates tests · e2e · site-links"
        }
      ],
      "skos:definition": [
        {
          "@value": "The `mvp` commands declared for this tenant. For the theme: `bun test`, `CI=1 bunx playwright test` (a11y, action tiles, sidebar panels, QA panel) and `scripts/site-links.ts --site ./_site`, which checks the navbar tiles against the BUILT site rather than against the attribute — the distinction that let a 404 ship unnoticed once already. A red gate is EVIDENCE, not an exit. It does not end the process and it does not loop by itself: \"this version breaks us\" is a finding the decider needs, not a reason to stop before they see it."
        }
      ],
      "skos:notation": "Task_Gates",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#Task_Gates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreamadoption.task_mvp",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "MVP: build the candidate on a staging branch"
        }
      ],
      "skos:definition": [
        {
          "@value": "An MVP is a DEPLOYED BUILD, not a description of one. The pin is moved on a branch and `feature-staging.yml` publishes it under `STAGING/<branch-slug>/`, so the reviewer looks at the artefact rather than at a screenshot — the same argument the merge discipline makes about rendered work."
        }
      ],
      "skos:notation": "Task_Mvp",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-version-adoption.bpmn#Task_Mvp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.a_pickup",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Pick up the stale pin claim a bean"
        }
      ],
      "skos:definition": [
        {
          "@value": "The hand-off from the mechanical lane to the one that can exercise judgement. Claiming the bean here is what stops two sessions adopting the same bump."
        }
      ],
      "skos:notation": "A_PickUp",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-pin-watch.bpmn#A_PickUp",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.call_adopt",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adopt the version bump"
        }
      ],
      "skos:definition": [
        {
          "@value": "The reusable subprocess. Every pinned dependency enters it the same way, so a new tenant is a registry row and a call — never a second diagram saying the same thing in different words."
        }
      ],
      "skos:notation": "Call_Adopt",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-pin-watch.bpmn#Call_Adopt",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.task_closeissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Close the tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "Closed automatically when every pin is current, so the issue's existence is the state rather than a log of past states."
        }
      ],
      "skos:notation": "Task_CloseIssue",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-pin-watch.bpmn#Task_CloseIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.task_queryupstream",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "List upstream releases and compare to the pin"
        }
      ],
      "skos:definition": [
        {
          "@value": "`git ls-remote --tags`, filtered by the row's `tagPattern` and ordered by version. Nothing is cloned and no API token is needed, so the check runs the same way on a laptop and in CI."
        }
      ],
      "skos:notation": "Task_QueryUpstream",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-pin-watch.bpmn#Task_QueryUpstream",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.task_readpins",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the pin registry upstream-pins.json"
        }
      ],
      "skos:definition": [
        {
          "@value": "The registry lists the tenants and says, per row, WHICH FILE holds the pin literal and how to read it. It deliberately does not store the version: one answer to \"what are we running\", read from the file the build reads."
        }
      ],
      "skos:notation": "Task_ReadPins",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-pin-watch.bpmn#Task_ReadPins",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_upstreampinwatch.task_trackissue",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open or EDIT the one tracking issue"
        }
      ],
      "skos:definition": [
        {
          "@value": "One issue, edited in place. GitHub's own failure mail is the channel that was already ignored thirty times, so this adds none: an edit does not notify, and a pin that stays behind for two months stays one unread item rather than nine."
        }
      ],
      "skos:notation": "Task_TrackIssue",
      "dcterms:source": "cat-harness/processes/sdlc/upstream-pin-watch.bpmn#Task_TrackIssue",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_voicereview.task_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudicate: prose, scope, or exception"
        }
      ],
      "skos:definition": [
        {
          "@value": "The same three outcomes as the base voice axis. The register is wrong for this block (fix the prose); the rule does not apply to this content (scope it on the voice, one edit rather than ten overrules); or the rule applies and this block is an exception (a reviewer entry saying why)."
        }
      ],
      "skos:notation": "Task_Adjudicate",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_voicereview.task_loadactive",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Load the active voices"
        }
      ],
      "skos:definition": [
        {
          "@value": "The activated set only, never everything shipped. An id naming no shipped voice is an error rather than a skip — a folio that believes it is applying a voice and is applying nothing has the cleanest-looking output of the three."
        }
      ],
      "skos:notation": "Task_LoadActive",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_LoadActive",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_voicereview.task_mechanicalhalf",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Run the rule's mechanical half"
        }
      ],
      "skos:definition": [
        {
          "@value": "Whatever `patterns` and `terminology` the rule carries. A `judgementOnly` rule has no mechanical half by declaration, which is different from nobody having written one yet."
        }
      ],
      "skos:notation": "Task_MechanicalHalf",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_MechanicalHalf",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_voicereview.task_opencitation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Open the rule's citation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every rule resolves to a real `library/` section or a KG node, and carries the quote it was read from. Opening it is what lets a reviewer say WHY the rule applies — and it is the only way to catch a rule that misread its own source."
        }
      ],
      "skos:notation": "Task_OpenCitation",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_OpenCitation",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_voicereview.task_recordonsidecar",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Record on the block's QA sidecar"
        }
      ],
      "skos:definition": [
        {
          "@value": "Through `qa-merge-findings`, so the icon and the published witness agree with the decision. The adjudication LEADS the criterion and the script entry is kept beneath it: a disagreement between a checker and a reviewer is information."
        }
      ],
      "skos:notation": "Task_RecordOnSidecar",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_RecordOnSidecar",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_voicereview.task_ruleiswrong",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "The RULE is the defect — bean it"
        }
      ],
      "skos:definition": [
        {
          "@value": "A rule its own quote does not support is a finding against the voice, not against the block. Measured precedent: `voice-editorializing` flags \"clearly\", and the exemplar the Milnor gate is named after uses it fourteen times as proof economy (bean `2t41`)."
        }
      ],
      "skos:notation": "Task_RuleIsWrong",
      "dcterms:source": "cat-harness/processes/content/voice-review.bpmn#Task_RuleIsWrong",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.call_adjudicate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Adjudication"
        }
      ],
      "skos:definition": [
        {
          "@value": "folio-assistant's adjudication: the adjudication leads, the checker's entry is kept, and the dispensation carries its reason. Reviewers disagreeing on ONE criterion is a criterion disagreement, so this calls the QA-criterion specialisation (bean `bvuk`, owner 2026-09-23): the failing entry stands, the criterion does not apply to this screen, or a dispensation is granted with its reason. FOR THIS CALLER THE SPLIT WAS A REGRESSION, not a fix, and that is worth keeping because the PR that made it said the opposite. When `bvuk` moved the outcome half out of `adjudication.bpmn`, #1074 reported that all four remaining callers \"no longer reach A_ScopeCriterion or A_Dispensation\" and framed it as the intended effect. True for three of them, whose question never admitted those steps. Here it removed the two steps the sentence above already documents, so the call was left pointing at a shared judgement that no longer runs either. Repointing restores what the documentation always claimed rather than changing it. The entry condition matches exactly rather than approximately: GW_Agree asks whether the blind reviewers' entries agree and takes `no` here, and `Process_CriterionAdjudication` starts at \"entries for one criterion disagree\" — R_Review records pass, warn or fail PER CRITERION with a reason, so the disagreement reaching this step is a per-criterion disagreement between reviewer entries and nothing else."
        }
      ],
      "skos:notation": "Call_Adjudicate",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#Call_Adjudicate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.call_choose",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Choose a candidate"
        }
      ],
      "skos:definition": [
        {
          "@value": "A one-off choice between surviving candidates. Rejected candidates are kept, with the reason each lost."
        }
      ],
      "skos:notation": "Call_Choose",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#Call_Choose",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.d_candidates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Produce >= 2 candidates, web + mobile"
        }
      ],
      "skos:definition": [
        {
          "@value": "Mid-fidelity HTML: monochrome, real folio content, semantic icons, no placeholder text. Each candidate has both a web layout and a mobile layout."
        }
      ],
      "skos:notation": "D_Candidates",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Candidates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.d_check",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Mechanical checks, both viewports"
        }
      ],
      "skos:definition": [
        {
          "@value": "Tool wireframe-check renders every candidate at a web and a mobile viewport. It fails on horizontal overflow at mobile width, on placeholder text, and on a missing viewport, and writes screenshots and a script entry per criterion."
        }
      ],
      "skos:notation": "D_Check",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Check",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.d_intent",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Write the design intent"
        }
      ],
      "skos:definition": [
        {
          "@value": "A short statement of who the screen is for, what they need to do, and what it must show. It is the criterion every candidate is judged against."
        }
      ],
      "skos:notation": "D_Intent",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#D_Intent",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities/process_wireframedesignreview.r_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Blind review per criterion"
        }
      ],
      "skos:definition": [
        {
          "@value": "Criteria: intent-fit, web usability, mobile usability, accessibility, and alternatives considered. A review at one viewport only is incomplete."
        }
      ],
      "skos:notation": "R_Review",
      "dcterms:source": "cat-harness/processes/ui/wireframe-design-review.bpmn#R_Review",
      "skos:note": "candidate"
    }
  ]
}
