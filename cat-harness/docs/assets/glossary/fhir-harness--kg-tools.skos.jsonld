      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/build-ig-site",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Stage one IG as its own just-the-docs Jekyll site"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turn an IG source repository into ONE Jekyll source for just-the-docs, as the IG Publisher builds one IG per site: `input/pagecontent` pages with title, parent and order from `sushi-config.yaml` `pages:`, the files the Publisher resolves `{% include %}` against, images, `_data/fhir.json` from `ig-site-data`, and a `_config.yml`. The pages render unchanged, `{{ site.data.fhir.* }}` included (bean `bamf`, owner's choice of one site per IG)."
        }
      ],
      "skos:notation": "build-ig-site",
      "dcterms:source": "fhir-harness/tools/index.ts#build-ig-site",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/fhir-cache-seed-npm",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the FHIR package cache from trusted sources (exact versions)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Fill `~/.fhir/packages` (or `--cache`) for an environment that cannot reach packages.fhir.org, from trust anchors only: npm account `grahamegrieve` (owner-trusted), the publishers' own site repos (WorldHealthOrganization/smart-html, IHE/publications), template repos found through FHIR/ig-registry's templates.json read live each run, and an owner `--mirror`. Exact versions only (a patch wildcard resolves as the Publisher resolves it, recorded); every tarball verified; nothing computed once and kept; provenance recorded; missing versions listed, never substituted."
        }
      ],
      "skos:notation": "fhir-cache-seed-npm",
      "dcterms:source": "fhir-harness/tools/index.ts#fhir-cache-seed-npm",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/fhir-package-mirror",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Mirror FHIR packages from packages.fhir.org into a git repository"
        }
      ],
      "skos:definition": [
        {
          "@value": "On a machine that reaches packages.fhir.org, fetch exactly a missing list (from `fhir-cache-seed-npm --missing-out`), check each tarball names itself exactly, record SHA512SUMS, and commit and push to a git repository that an environment without packages.fhir.org reads with `--mirror`. The person running it is the trust anchor for what it adds."
        }
      ],
      "skos:notation": "fhir-package-mirror",
      "dcterms:source": "fhir-harness/tools/index.ts#fhir-package-mirror",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/ig-ast-diff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "List and view the delta between two IG ASTs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Diff two ASTs by resource key: added, removed, changed (with a structural element-level differential) and version-changed resources, plus edges added and removed; optionally fold in the incremental plan, and render just-the-docs pages (an index that lists, a page per resource that shows) every one of which carries the provisional mark. `list <ast>` summarises one AST."
        }
      ],
      "skos:notation": "ig-ast-diff",
      "dcterms:source": "fhir-harness/tools/index.ts#ig-ast-diff",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/ig-ast-export",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Build an IG and write its AST"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run one ordinary IG Publisher build through `AstPublisher` (a subclass that overrides nothing) and write the AST beside `output/`: one JSON file per resource keyed `canonical|version`, `dependencies.json` (upstream's DependencyAnalyser plus the Library/PlanDefinition/ActivityDefinition/Measure edges it leaves empty), SUSHI's `fsh-index.json`, and a manifest that declares itself a cache and records the inputs it is valid for."
        }
      ],
      "skos:notation": "ig-ast-export",
      "dcterms:source": "fhir-harness/tools/index.ts#ig-ast-export",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/ig-ast-incremental-build",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Rebuild only the cone of a change and merge it into the AST"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the unchanged part of a base AST as a FHIR package into the package cache, build a temporary IG of only the rebuild set with the stock Publisher, merge the result into a mixed-provenance AST (`builtAt` per resource), and repeat while the merged graph's cone reaches resources that were not rebuilt."
        }
      ],
      "skos:notation": "ig-ast-incremental-build",
      "dcterms:source": "fhir-harness/tools/index.ts#ig-ast-incremental-build",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/ig-ast-measure-real-igs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Measure the AST export on real IGs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build smart-trust and smart-immunizations through `ig-ast-export` and print the W1/W2 measurements: counts, whether FSH sources sit where the plan expects, and logic-layer edge coverage per resource type against 458 of 458. `--byte-identical` adds a stock build and an `output/` diff."
        }
      ],
      "skos:notation": "ig-ast-measure-real-igs",
      "dcterms:source": "fhir-harness/tools/index.ts#ig-ast-measure-real-igs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/ig-ast-plan",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Plan an incremental IG build from a delta of changed files"
        }
      ],
      "skos:definition": [
        {
          "@value": "Map a delta (a commit range, a PR's diff, or the staged index) onto a base AST: which resources to rebuild (the forward cone), which to load from cache, which to remove, or a full build and why. Builds nothing."
        }
      ],
      "skos:notation": "ig-ast-plan",
      "dcterms:source": "fhir-harness/tools/index.ts#ig-ast-plan",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/ig-ast-validity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Is this IG AST still valid for the IG's current inputs?"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run folio-assistant-core's `compiledValidity` on an AST manifest's `inputs`: recompute the input digest (the same algorithm as the Java writer, pinned by a shared golden vector) and the source revision, and answer valid, stale-inputs (naming which input), or cannot-tell."
        }
      ],
      "skos:notation": "ig-ast-validity",
      "dcterms:source": "fhir-harness/tools/index.ts#ig-ast-validity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/ig-site-data",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Populate site.data.fhir for a just-the-docs IG render"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the IG Publisher's Jekyll variables (`site.data.fhir.ig.*`, `packageId`, `canonical`) for ONE implementation guide, from `sushi-config.yaml` or a published IG's `fhir-artifact-index`, so pages written for the Publisher render on just-the-docs unchanged. fhir-harness declares `site.data` as a pass-through Liquid prefix; this is what Jekyll then reads (bean `bamf`)."
        }
      ],
      "skos:notation": "ig-site-data",
      "dcterms:source": "fhir-harness/tools/index.ts#ig-site-data",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools/strip-library-binaries",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Strip binary payloads from Library resources"
        }
      ],
      "skos:definition": [
        {
          "@value": "Remove base64 `content.data` from published `Library` resources, so an IG embedding compiled CQL does not ship the bytes twice."
        }
      ],
      "skos:notation": "strip-library-binaries",
      "dcterms:source": "fhir-harness/tools/index.ts#strip-library-binaries",
      "skos:note": "candidate"
    },
