        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-tools"
      },
      "skos:prefLabel": [
        {
          "@value": "Replace inline Library content with URL references"
        }
      ],
      "skos:definition": [
        {
          "@value": "Replace inline CQL/ELM in `Library` resources with a URL reference to the published copy."
        }
      ],
      "skos:notation": "strip-library-content",
      "dcterms:source": "fhir-harness/tools/index.ts#strip-library-content",
