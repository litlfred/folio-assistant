  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills",
      "@type": "skos:ConceptScheme",
      "skos:prefLabel": "Skills, extracted (fhir-harness)",
      "skos:definition": "Candidate terms extracted from every skill's front matter: `name` as the label, `description` as the definition. Generated by folio-assistant-core/scripts/glossary-extract.ts; not curated, and never hand-edited: a person promotes a term by authoring it in a glossary of their own.",
      "dcterms:source": "Skills of fhir-harness"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills/fhir-client-operations",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "fhir-client-operations"
        }
      ],
      "skos:definition": [
        {
          "@value": "Reading, searching and writing FHIR R4 resources through the SMARTerFHIR client (`BaseClient` and its vendor subclasses): the launch-context reads, `requestResource`, `create` with its automatic subject/encounter/context hydration, the per-vendor differences, how errors surface, and the operations the library does not have. Written against a pinned upstream commit; read before calling a FHIR server from a SMART app built on it."
        }
      ],
      "skos:notation": "fhir-client-operations",
      "dcterms:source": "fhir-harness/skills/fhir-client/fhir-client-operations.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills/ig-build-pipeline",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "ig-build-pipeline"
        }
      ],
      "skos:definition": [
        {
          "@value": "The bare FHIR IG pipeline — FSH to SUSHI to the IG Publisher to a pages branch, with no pre-processing and no post-processing. What this layer runs, what it emits, and the list of things it deliberately refuses to know about. Read before adding anything to fhir-harness."
        }
      ],
      "skos:notation": "ig-build-pipeline",
      "dcterms:source": "fhir-harness/skills/fhir-ig-base/ig-build-pipeline.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills/ig-publisher-fork",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "ig-publisher-fork"
        }
      ],
      "skos:definition": [
        {
          "@value": "Requirements for an agent working a local experimental fork of the IG Publisher — which repositories, what the AST must carry, what must not change, and the acceptance criteria. Read before forking, and before reporting a fork's work complete."
        }
      ],
      "skos:notation": "ig-publisher-fork",
      "dcterms:source": "fhir-harness/skills/fhir-ig-base/ig-publisher-fork.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills/ig-publisher-reduction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "ig-publisher-reduction"
        }
      ],
      "skos:definition": [
        {
          "@value": "The phased transition that reduces the IG Publisher to AST + QA — five phases, each with an exit criterion that is measured rather than asserted, and the staleness contract that makes an AST-backed staging build honest. Read before starting any phase, and before claiming one is done."
        }
      ],
      "skos:notation": "ig-publisher-reduction",
      "dcterms:source": "fhir-harness/skills/fhir-ig-base/ig-publisher-reduction.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills/ig-render-jekyll",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "ig-render-jekyll"
        }
      ],
      "skos:definition": [
        {
          "@value": "Rendering a FHIR IG's content through the just-the-docs pipeline instead of mounting the IG Publisher's finished HTML — the JSON-only representation contract, navigation derived from sushi-config.yaml, and the LHS rail. Read before adding a representation, a menu entry, or a page kind."
        }
      ],
      "skos:notation": "ig-render-jekyll",
      "dcterms:source": "fhir-harness/skills/fhir-ig-base/ig-render-jekyll.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills/smart-launch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/fhir-harness/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-launch"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a browser app performs a SMART on FHIR launch — EHR launch and standalone launch — with the SMARTerFHIR library: `SmartLaunchHandler`, the `LAUNCH` and `EMR` enums, the scopes it requests per EHR vendor, how the redirect URI is computed, and where the token ends up. Written against a pinned upstream commit; read before wiring a launch page or a redirect page."
        }
      ],
      "skos:notation": "smart-launch",
      "dcterms:source": "fhir-harness/skills/fhir-client/smart-launch.md",
      "skos:note": "candidate"
    }
  ]
}
