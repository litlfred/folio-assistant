      "skos:prefLabel": [
        {
          "@value": "JSON Schema"
        }
      ],
      "skos:definition": [
        {
          "@value": "A JSON document that describes the shape of other JSON documents. In the platform, a node schema and a skill's input and output contracts are each a JSON Schema file."
