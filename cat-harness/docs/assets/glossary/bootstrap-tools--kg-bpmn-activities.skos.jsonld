      "skos:prefLabel": [
        {
          "@value": "Check what is served"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ask the root URL and every document address. 2xx or 3xx answers; 404 is not there; 403, 407, 5xx or no answer is about the way here and could not be determined."
        }
      ],
      "skos:notation": "A_CheckServed",
      "dcterms:source": "bootstrap-tools/processes/render-kg-to-github-pages.bpmn#A_CheckServed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities/process_renderkgtogithubpages.a_checkstaged",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check what was staged"
        }
      ],
      "skos:definition": [
        {
          "@value": "site.ts --check and readme-book.ts --check: every document at its address, no address taken by another file, every link on the page landing. This is the QA of what would be pushed."
        }
      ],
      "skos:notation": "A_CheckStaged",
      "dcterms:source": "bootstrap-tools/processes/render-kg-to-github-pages.bpmn#A_CheckStaged",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities/process_renderkgtogithubpages.a_deploy",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Deploy the rendering"
        }
      ],
      "skos:definition": [
        {
          "@value": "Commit the staged tree onto gh-pages as a full replace (the instance's Pages workflow on a push to main, or by hand); GitHub Pages then builds it from the branch. Rebuild and retry on a rejected push; never rebase the branch. The gh-pages commit SHA is the message the report names."
        }
      ],
      "skos:notation": "A_Deploy",
      "dcterms:source": "bootstrap-tools/processes/render-kg-to-github-pages.bpmn#A_Deploy",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities/process_renderkgtogithubpages.a_provision",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Make sure gh-pages exists and Pages serves it"
        }
      ],
      "skos:definition": [
        {
          "@value": "Provisioning the target, owned by this Tool's subprocess rather than by the general step (owner, 2026-10-01: \"need to create gh-pages branch before can turn on\"). In order: (1) an orphan gh-pages branch exists — git ls-remote --heads origin gh-pages; if absent, push a placeholder (index.html + .nojekyll); (2) Pages is on, Source = the gh-pages branch at / — gh api -X POST repos/<o>/<r>/pages -f source[branch]=gh-pages -f source[path]=/ when gh is signed in, otherwise the exact manual step (Settings → Pages → Deploy from a branch → gh-pages, / (root)). Each half is done, not done, or could not be determined; never assumed."
        }
      ],
      "skos:notation": "A_Provision",
      "dcterms:source": "bootstrap-tools/processes/render-kg-to-github-pages.bpmn#A_Provision",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities/process_renderkgtogithubpages.a_report",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Report the push: status and message"
        }
      ],
      "skos:definition": [
        {
          "@value": "pages-status.ts: pushed, not-pushed or could-not-determine, and one line — the commit, the root URL, and the QA of both the staging and what is served. On the path from a failed staging it says not-pushed and names the problem. Required on every path: a caller that gets no status cannot tell a push from nothing."
        }
      ],
      "skos:notation": "A_Report",
      "dcterms:source": "bootstrap-tools/processes/render-kg-to-github-pages.bpmn#A_Report",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities/process_renderkgtogithubpages.a_resolveinputs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Resolve the Subgraphs and the root URL"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read the instance's declaration. Every Subgraph id asked for must be one it declares; none asked for means the whole graph. The root URL is the one given, else the declaration's iriBase, else https://<owner>.github.io/<repo>/. An unknown id is refused, never rendered as a smaller site."
        }
      ],
      "skos:notation": "A_ResolveInputs",
      "dcterms:source": "bootstrap-tools/processes/render-kg-to-github-pages.bpmn#A_ResolveInputs",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities/process_renderkgtogithubpages.a_stage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/folio-assistant/bootstrap-tools/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Stage the rendering"
        }
      ],
      "skos:definition": [
        {
          "@value": "site.ts --root <instance> --out <dir> [--subgraph <id>]…: every JSON Schema and JSON-LD document at the IRI it names, the files as they sit, the README page as README.md (served as README.html), and index.html as a redirect to it — the default landing page, which an index.html or index.md at the instance root replaces. Generated pages carry the generated-by notice at their top, and a footer that links their generator and source, never an edit page."
        }
      ],
      "skos:notation": "A_Stage",
      "dcterms:source": "bootstrap-tools/processes/render-kg-to-github-pages.bpmn#A_Stage",
      "skos:note": "candidate"
    }
  ]
