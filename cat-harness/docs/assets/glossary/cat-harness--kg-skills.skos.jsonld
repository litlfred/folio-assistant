      },
      "skos:prefLabel": [
        {
          "@value": "data-modelling"
        }
      ],
      "skos:definition": [
        {
          "@value": "Build a data model: identify the entities a body of work is actually about, the relations between them, and the cardinalities — then declare it where the tools can read it. Process-agnostic technique; the CRDM phase that invokes it is `crdm-data-model`."
        }
      ],
      "skos:notation": "data-modelling",
      "dcterms:source": "cat-harness/skills/kg/kg-core/data-modelling.md",
