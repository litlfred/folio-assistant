      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/code-node-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "code-node-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review the knowledge graph's CODE nodes — Tool definitions in the `tools` graph and schema definition nodes under `schemas/` — for the joins a reader cannot see: that a node declares what it is, that what it names resolves, and that the mechanism it describes is the one that actually runs."
        }
      ],
      "skos:notation": "code-node-review",
      "dcterms:source": "cat-harness/skills/kg/kg-core/code-node-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/code-review-process",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "code-review-process"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where code review sits in the release lifecycle. Review types, who reviews what, how feedback maps to beans, and the path from review to approval to release. Works with prepare-merge-auto for mechanics and release-lifecycle for the broader flow."
        }
      ],
      "skos:notation": "code-review-process",
      "dcterms:source": "cat-harness/skills/process/workflow/code-review-process.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/communication-language",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "communication-language"
        }
      ],
      "skos:definition": [
        {
          "@value": "Determine the language an agent SPEAKS IN — the language of a turn, as against the language of content. Covers the four inputs and their order, why a model's own languages are never the answer, the boundary between speaking to the person and writing durable artefacts, where the determination is recorded so a sibling session does not re-ask, and when to re-ask."
        }
      ],
      "skos:notation": "communication-language",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/communication-language.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/compute-integration-watcher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "compute-integration-watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Cross-layer wiring auditor — watches for newly-landed formal/analytic improvements (proofs, propositions, lemmas, axiom→theorem upgrades, witness data) on the default branch AND on open PRs, and checks whether each one has been wired into the production compute chain. Complements `local/compute-audit` (which scans for performance/correctness antipatterns inside scripts). Runs in two modes: REACTIVE (watch new commits / PR events) and IDLE-SWEEP (walk all existing content blocks and audit wiring)."
        }
      ],
      "skos:notation": "compute-integration-watcher",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/compute-integration-watcher.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/confirmation-waiver",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "confirmation-waiver"
        }
      ],
      "skos:definition": [
        {
          "@value": "A human may waive a confirmation they are owed — for a session, for a process run, or until a stated time. Covers what a waiver is made of, where it is recorded (the context graph, never the work plan), the gates that can be waived and the rules that cannot, why every waiver carries an expiry, and the one thing an agent may never do: grant itself one."
        }
      ],
      "skos:notation": "confirmation-waiver",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/confirmation-waiver.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/content-acquisition",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "content-acquisition"
        }
      ],
      "skos:definition": [
        {
          "@value": "Getting a resource INTO the graph in the first place — accepting one offered unprompted, or asking for one and then asking for it to be uploaded. The channels are plural and open: `uploads/` is one, the conversation is another. Runs before document ingestion, which begins only once a file has landed."
        }
      ],
      "skos:notation": "content-acquisition",
      "dcterms:source": "cat-harness/skills/library/library-core/content-acquisition.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/content-author",
      "@type": "skos:Concept",
      "skos:inScheme": {
