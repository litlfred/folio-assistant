      },
      "skos:prefLabel": [
        {
          "@value": "content-feedback"
        }
      ],
      "skos:notation": "content-feedback",
      "dcterms:source": "cat-harness/skills/authoring/content-lifecycle/content-feedback.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/content-graph",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "content-graph"
        }
      ],
      "skos:definition": [
        {
          "@value": "Editorial graph analysis skill — builds a content graph from uses[], interprets, proofs, and examples relationships; builds a chapter/section topology graph; and applies heuristics to identify forward references, cross-section/cross-chapter coupling, and sections that are too sparse or too dense. Produces actionable reorganisation suggestions and can implement approved moves."
        }
      ],
      "skos:notation": "content-graph",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/content-graph.md",
      "skos:note": "candidate"
    },
