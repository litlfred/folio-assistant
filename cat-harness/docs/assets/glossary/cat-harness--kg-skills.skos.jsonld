      },
      "skos:prefLabel": [
        {
          "@value": "kg-subscription"
        }
      ],
      "skos:definition": [
        {
          "@value": "Subscribing a folio or harness to an external knowledge graph — a substrate — and walking its parts from referenced to materialised, one at a time and only through the shared materialisation gates. When to subscribe, what makes a repository a substrate, choosing subgraphs, assets and harnesses, the five gates, instantiating a harness so it reaches the navbar, moving the pin, and what never to do."
        }
      ],
      "skos:notation": "kg-subscription",
      "dcterms:source": "cat-harness/skills/library/large-datasets/kg-subscription.md",
      "skos:note": "candidate"
    },
