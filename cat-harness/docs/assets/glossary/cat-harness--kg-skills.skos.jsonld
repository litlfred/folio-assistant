      ],
      "skos:definition": [
        {
          "@value": "Taking a file from `uploads/` to `library/<bib-slug>/` — which rung to reach for and why, what a complete L1 entry holds, and why an inferred structure is refused rather than guessed. One entry point: `bun run ingest`."
        }
      ],
      "skos:notation": "library-ingestion",
      "dcterms:source": "cat-harness/skills/library/library-core/library-ingestion.md",
      "skos:note": "candidate"
