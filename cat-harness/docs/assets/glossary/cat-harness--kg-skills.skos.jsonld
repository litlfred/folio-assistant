      },
      "skos:prefLabel": [
        {
          "@value": "decision-methodology-selector"
        }
      ],
      "skos:definition": [
        {
          "@value": "Given a decision context, select the applicable methodology from the methodology graph. Reads the graph's applies-when declarations, matches them against the context, and returns the ranked applicable methods with rationale. Extends methodology-adoption's four-question protocol with quantitative method-selection criteria from the MCDM literature."
        }
      ],
      "skos:notation": "decision-methodology-selector",
      "dcterms:source": "cat-harness/skills/process/process-core/decision-methodology-selector.md",
