      },
      "skos:prefLabel": [
        {
          "@value": "crdm-needs-assessment"
        }
      ],
      "skos:definition": [
        {
          "@value": "Facilitate Phase 1 (Needs Assessment) of the CRDM requirements workflow. Guide the BA through stakeholder identification, source material gathering, and synthesising a domain-language needs statement. Post to the GitHub issue and iterate until the BA confirms the need is correctly captured."
        }
      ],
      "skos:notation": "crdm-needs-assessment",
