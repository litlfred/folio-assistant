        }
      ],
      "skos:definition": [
        {
          "@value": "Judge whether the prose side of a declared prose ↔ code pair still says what the code does, when the machine could not settle it. Reads the two mechanical signals first — staleness and resolvable claims — and settles what is left in one of three ways, sending a disagreement with a checker to adjudication. General: the Lean case is a specialisation with its own skill."
        }
      ],
      "skos:notation": "narrative-asserts-code",
