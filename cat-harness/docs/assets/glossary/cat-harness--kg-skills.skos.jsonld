      },
      "skos:prefLabel": [
        {
          "@value": "merge-conflict-patterns"
        }
      ],
      "skos:definition": [
        {
          "@value": "Merge the base branch in and resolve, without a person, only the conflicts a DECLARED pattern covers — generated files, generated README regions, QA sidecars — then prove the result with the gate set. Refuses the whole merge when any conflict is authored or undeclared. Use for \"merge main\", \"resolve the conflicts\", \"the PR is conflicted again\", \"auto-resolve\", and when adding a pattern for a new kind of churn."
        }
      ],
      "skos:notation": "merge-conflict-patterns",
