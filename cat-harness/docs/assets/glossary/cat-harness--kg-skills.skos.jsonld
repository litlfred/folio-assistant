        }
      ],
      "skos:notation": "content-plan",
      "dcterms:source": "cat-harness/skills/authoring/content-lifecycle/content-plan.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/content-profiles",
      "@type": "skos:Concept",
      "skos:inScheme": {
