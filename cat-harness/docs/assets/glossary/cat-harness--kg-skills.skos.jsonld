      },
      "skos:prefLabel": [
        {
          "@value": "crdm-impact-analysis"
        }
      ],
      "skos:definition": [
        {
          "@value": "Guide for CRDM Phase 4 — Impact Analysis and Migration Planning. Systematic scan across 7 dimensions: schema, pipeline, adapter, folio, skill, migration, and test/documentation impact. Produces a structured assessment for posting to the GitHub issue."
        }
      ],
      "skos:notation": "crdm-impact-analysis",
      "dcterms:source": "cat-harness/skills/sdlc/crdm/crdm-impact-analysis.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/crdm-needs-assessment",
      "@type": "skos:Concept",
      "skos:inScheme": {
