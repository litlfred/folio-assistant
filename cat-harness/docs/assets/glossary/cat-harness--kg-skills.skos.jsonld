          "@value": "decision-audit"
        }
      ],
      "skos:definition": [
        {
          "@value": "Record why a decision was made, or why a finding in it was left. Required of whoever adjudicates a gate, and of the agent that assembles the citations for them. Every overrule of a mechanical finding carries a note, and every note cites corpus evidence."
        }
      ],
      "skos:notation": "decision-audit",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/decision-audit.md",
