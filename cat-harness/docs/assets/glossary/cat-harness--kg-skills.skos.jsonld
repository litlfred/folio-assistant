      },
      "skos:prefLabel": [
        {
          "@value": "decision-comparison"
        }
      ],
      "skos:definition": [
        {
          "@value": "Lay a decision out as a comparison before you ask it — what each option does, its pro, its con, what it changes downstream, and how reversible it is — in the prose that precedes the question, never inside the option labels. Required whenever a choice is handed to a person."
        }
      ],
      "skos:notation": "decision-comparison",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/decision-comparison.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/decision-methodology-selector",
      "@type": "skos:Concept",
