      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/symbiotic-interaction",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "symbiotic-interaction"
        }
      ],
      "skos:definition": [
        {
          "@value": "Recognize and respond to the three epistemic registers of author input — Socratic steer (known-answer correction), honest gap (flagged unknown), and intuition seed (tenuous cross-domain identification) — with the coactive-learning measurement spec (per-arc correction quality and turns-to-convergence) and the prompt-lexicon convention. Carries the STRICT rule that a steer correcting a RULE is written into the skill that governs it, in the same turn, quoted and dated — use whenever the author corrects, settles or overrules anything. Generic folio-assistant platform skill."
        }
      ],
      "skos:notation": "symbiotic-interaction",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/symbiotic-interaction.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/tabular-metadata",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "tabular-metadata"
        }
      ],
      "skos:definition": [
        {
          "@value": "Extract tabular metadata from a CSV or spreadsheet as CSVW — tables, rows, headers, columns, datatypes and location on sheet — recording every field as determined or explicitly undetermined. Read before touching a tabular ingest arm, adding a format, or deciding what a sheet is in the graph."
        }
      ],
      "skos:notation": "tabular-metadata",
      "dcterms:source": "cat-harness/skills/library/library-core/tabular-metadata.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/task-authorization",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "task-authorization"
        }
      ],
      "skos:definition": [
        {
          "@value": "The check every BPMN task execution runs before anything is recorded: is the actor authenticated, assigned to the role the lane binds, authorized by an ODRL policy to perform the task, and allowed access to the content it acts on? One generic check in the engine rather than a step drawn in some diagrams; strict since 2026-09-24, with GitHub as the authenticator. Also how the HTTP routes ask the same policies. Triggers on: may this actor, who may perform, authorization, authentication, access rights, permission check, RBAC, rbac.ts, workflow_complete refused, not eligible for role."
        }
      ],
      "skos:notation": "task-authorization",
      "dcterms:source": "cat-harness/skills/process/process-core/task-authorization.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/technical-documentation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "technical-documentation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write and review technical documentation of standards, software and knowledge assets as an SDO writes. Carries the RFC 2119 requirement levels as RFC 8174 constrains them, the three questions a first draft is measured against, and the rule that an ingested specification is checked for supersession before it is cited."
        }
      ],
      "skos:notation": "technical-documentation",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/technical-documentation.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/term-disagreement",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "term-disagreement"
        }
      ],
      "skos:definition": [
        {
          "@value": "When a glossary term the extractor minted and an authorised terminology disagree — the corpus spells a concept differently from the authority, or uses a word the authority does not carry — decide among three outcomes: change the prose, author a local term with its reason, or record that the vocabulary is wrong for this domain. Says which disagreements need a decision at all, how to choose, what each outcome writes and where, and what is NOT this skill (two judges disagreeing about a mapping)."
        }
      ],
      "skos:notation": "term-disagreement",
      "dcterms:source": "cat-harness/skills/library/library-core/term-disagreement.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/test-engineer",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "test-engineer"
        }
      ],
      "skos:notation": "test-engineer",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/test-engineer.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/test-plan-execution",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "test-plan-execution"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run a `test-plan/v1` against a system under test and take it to a certification decision — the five lanes of `test-plan-execution.bpmn` (requester, tester, untainted checker, certifier, attestation service), how the test data is bound, what the run and the report must record, the facts the certification table reads, and the four kg-audit criteria that judge a run afterwards. Read before executing a plan, re-executing a sample, or certifying a result."
        }
      ],
      "skos:notation": "test-plan-execution",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/test-plan-execution.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/theme-art-intake",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-art-intake"
        }
      ],
      "skos:definition": [
        {
          "@value": "Accept or refuse a set of three theme/avatar layouts arriving through document ingestion, with a named reason for every refusal."
        }
      ],
      "skos:notation": "theme-art-intake",
      "dcterms:source": "cat-harness/skills/ui/theming/theme-art-intake.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/theme-artefacts",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-artefacts"
        }
      ],
      "skos:definition": [
        {
          "@value": "The per-surface SPECIALISATION layer — sticky, landing board, docs background, navbar avatar. Only what DIFFERS lives here; the general rule lives in its stage. Read this last, after the stage that owns your question."
        }
      ],
      "skos:notation": "theme-artefacts",
      "dcterms:source": "cat-harness/skills/ui/theming/theme-artefacts.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/theme-contrast",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-contrast"
        }
      ],
      "skos:definition": [
        {
          "@value": "Why every scrim is measured over PURE BLACK rather than over the art actually in use, what the AAA floor is, and why the high-contrast pair declares no backdrop at all. The CONSUMER stage that says what the ink must survive."
        }
      ],
      "skos:notation": "theme-contrast",
      "dcterms:source": "cat-harness/skills/ui/theming/theme-contrast.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/theme-declaration",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-declaration"
        }
      ],
      "skos:definition": [
        {
          "@value": "What a theme IS as data — the palette, the three required layouts, and the per-image regions (`textRegion`, `avatarRegion`). The PRODUCER stage: this is where a number is written down, and the rule is that geometry over art is declared rather than derived, because no amount of arithmetic on an aspect ratio can see where a picture is quiet."
        }
      ],
      "skos:notation": "theme-declaration",
      "dcterms:source": "cat-harness/skills/ui/theming/theme-declaration.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/theme-generation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-generation"
        }
      ],
      "skos:definition": [
        {
          "@value": "Turning a declared theme into CSS — `bun run themes:css` — and the single consumer-side failure this stage exists to stop: a theme with no CSS rule falls back to an opaque surface and paints over its own art. Four rounds of \"still not image\" had that one cause."
        }
      ],
      "skos:notation": "theme-generation",
      "dcterms:source": "cat-harness/skills/ui/theming/theme-generation.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/theme-ui-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theme-ui-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review graphical assets AS THEY ARE INGESTED, in the context of the website or app design they are for — accessibility, branding, languages — to determine what the assets and the UI will be. At ingestion only, by owner ruling; called from ingest-theme. Measures rather than asserts, and raises findings rather than fixing them."
        }
      ],
      "skos:notation": "theme-ui-review",
      "dcterms:source": "cat-harness/skills/ui/ui-core/theme-ui-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/theming",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "theming"
        }
      ],
      "skos:definition": [
        {
          "@value": "The map of this subgraph: theming is split on PIPELINE STAGE first — intake, declaration, generation, contrast — with producer/consumer as the direction each stage faces, and per-artefact specialisation last. Read this to find which stage owns the fact you need; read the stage for the fact."
        }
      ],
      "skos:notation": "theming",
      "dcterms:source": "cat-harness/skills/ui/theming/theming.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/todo-manager",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "todo-manager"
        }
      ],
      "skos:definition": [
        {
          "@value": "Maintain and display work-in-progress task lists using the `beans` CLI issue tracker. Track implementation progress, open tasks, missing artifacts, and blocked items across a session."
        }
      ],
      "skos:notation": "todo-manager",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/todo-manager.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/todo-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "todo-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Monitor and triage open feedback across all content blocks. At session start, ask the author if they'd like to work on feedback. Provide overview, let them pick a chapter/section, then review and iterate until done."
        }
      ],
      "skos:notation": "todo-review",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/todo-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/translation-manager",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "translation-manager"
        }
      ],
      "skos:definition": [
        {
          "@value": "Translation lifecycle management for folio content. Covers gettext PO/POT extraction and injection, TranslationNode manifests as KG nodes, official vs unofficial translations, staleness tracking, sign-off workflow, automatic badge rendering, and the poSources fallback resolution chain."
        }
      ],
      "skos:notation": "translation-manager",
      "dcterms:source": "cat-harness/skills/library/library-core/translation-manager.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/turn-reporting",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "turn-reporting"
        }
      ],
      "skos:definition": [
        {
          "@value": "Say which bean you are on, every turn — the opening and closing report formats, the rules that make a report worth reading (two sentences and a link per bean, every mention), and the STRICT rule that the \"next\" line is a question and must carry its own context."
        }
      ],
      "skos:notation": "turn-reporting",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/turn-reporting.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/ui-accessibility",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "ui-accessibility"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every user interface this project produces must be operable by keyboard, legible at measured contrast, and comfortable to hit. How to build to that, how to check it, why an automated pass is not the standard, and what a rendering built client-side owes a reader — there is no no-JavaScript floor here, and the two gates that look like one are narrower than their names."
        }
      ],
      "skos:notation": "ui-accessibility",
      "dcterms:source": "cat-harness/skills/ui/ui-core/ui-accessibility.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/uml-overview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uml-overview"
        }
      ],
      "skos:definition": [
        {
          "@value": "Read, regenerate or extend the UML class diagrams of a harness: one per harness and one per named sub-graph it declares, plus the harness object model. Every box is generated from a declaration and a schema, never drawn by hand, so a wrong diagram is fixed at the declaration or the schema, and a dashed \"could not determine\" box is a finding about the registry."
        }
      ],
      "skos:notation": "uml-overview",
      "dcterms:source": "cat-harness/skills/kg/kg-core/uml-overview.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/untainted-verification",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "untainted-verification"
        }
      ],
      "skos:definition": [
        {
          "@value": "The party that produced an artefact does not write the verdict on it. How a checker and an adjudicator are dispatched with controlled context, the three rules that make it a measurement rather than a ritual, and the third state that lets it gate at all."
        }
      ],
      "skos:notation": "untainted-verification",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/untainted-verification.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/untrusted-input",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "untrusted-input"
        }
      ],
      "skos:definition": [
        {
          "@value": "Keep attacker-controlled values out of program text — in GitHub Actions, in command lines, in anything that is parsed before it runs. Read before interpolating any value into a script, and before giving a Tool a command-line input."
        }
      ],
      "skos:notation": "untrusted-input",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/untrusted-input.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/unverified-constraints",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "unverified-constraints"
        }
      ],
      "skos:definition": [
        {
          "@value": "Never encode a constraint you have not verified — a rule that refuses a working setup is worse than no rule. Read before adding a check to a schema, a validator, a gate or an incompatibility table, and whenever you are about to write down that something \"is not supported\"."
        }
      ],
      "skos:notation": "unverified-constraints",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/unverified-constraints.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/upload-naming",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "upload-naming"
        }
      ],
      "skos:definition": [
        {
          "@value": "What an ingested file may be CALLED. Read before adding anything to an `uploads` or `library` graph, before writing a generator that links to one, and before \"fixing\" a broken link in a generated README. Covers which characters break what, why the name is normalised rather than the link escaped, how a sidecar stays paired with its source, and the one case the fixer refuses."
        }
      ],
      "skos:notation": "upload-naming",
      "dcterms:source": "cat-harness/skills/library/library-core/upload-naming.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/upload-routes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "upload-routes"
        }
      ],
      "skos:definition": [
        {
          "@value": "How a file actually REACHES `uploads/` — the two mechanisms that write bytes into a declared queue, the persona that performs one of them on somebody's behalf, and what each writer owes that the route does not do for them. The step before intake and after acquisition."
        }
      ],
      "skos:notation": "upload-routes",
      "dcterms:source": "cat-harness/skills/library/library-core/upload-routes.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/uploads-watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uploads-watch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Notice what has landed in the acquisition queue, and tell an arrival from a backlog. Reports; it never deletes, and never ingests on its own say-so."
        }
      ],
      "skos:notation": "uploads-watch",
      "dcterms:source": "cat-harness/skills/library/library-core/uploads-watch.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/upstream-version-adoption",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "upstream-version-adoption"
        }
      ],
      "skos:definition": [
        {
          "@value": "Watch a pinned upstream dependency for a new release, and take a candidate version through impact analysis, an MVP build, review and a person's adopt/hold/decline decision. Reusable per pin — the theme is the first tenant, not the only one."
        }
      ],
      "skos:notation": "upstream-version-adoption",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/upstream-version-adoption.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/uses-editorial-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "uses-editorial-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Adjudicate `uses-editorial-completeness` — read a block as a reader would and judge whether its `uses[]` is complete and genuinely expository. The human/agent half of the `uses` QA axis; the mechanical half runs in `qa-checkers-uses.ts`."
        }
      ],
      "skos:notation": "uses-editorial-review",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/uses-editorial-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/visual-diff",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "visual-diff"
        }
      ],
      "skos:definition": [
        {
          "@value": "Pictures of a changed figure, diagram or table, before and after, and how much of it changed. Says when to use it, what the percentage means and must NOT be read as, what a missing picture means, and how the staging job and the review process call it. Use when a reviewer asks \"what does this figure look like now\", when a table's markup diff is unreadable, or when a staging preview's pictures are missing."
        }
      ],
      "skos:notation": "visual-diff",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/visual-diff.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/visualizer-loading",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "visualizer-loading"
        }
      ],
      "skos:definition": [
        {
          "@value": "The general strategy for a complex visualizer: the generated page carries identity, layout and a pointer, and its bulky or repeated content is fetched from the Knowledge Graph in the browser rather than baked into every page. What must stay server-side, how to fetch, how to stay equivalent to the render being replaced, and how to verify a page whose content is not in its HTML. Read before generating any page that shows a KG node's data at length: an IG artefact view, a graph viewer, a schema or sidecar view."
        }
      ],
      "skos:notation": "visualizer-loading",
      "dcterms:source": "cat-harness/skills/ui/ui-core/visualizer-loading.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/vocabulary-authority",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "vocabulary-authority"
        }
      ],
      "skos:definition": [
        {
          "@value": "One vocabulary is authoritative for one kind of fact, and every other is a derived rendering reached by a declared mapping. Which vocabulary owns what here, the pros and cons behind each ruling, how DC and SKOS overlap and what stops them drifting, and the normalisation-first rule for any modelling or mapping exercise."
        }
      ],
      "skos:notation": "vocabulary-authority",
      "dcterms:source": "cat-harness/skills/kg/kg-core/vocabulary-authority.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/voice-authoring-guidance",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "voice-authoring-guidance"
        }
      ],
      "skos:definition": [
        {
          "@value": "Load the active voices' rules BEFORE writing, so a block is drafted in the register it will be reviewed against. The authoring half of the voice overlay; `voice-overlay-review` is the half that runs after."
        }
      ],
      "skos:notation": "voice-authoring-guidance",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/voice-authoring-guidance.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/voice-editorial-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "voice-editorial-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Adjudicate a `voice-*` finding — read the flagged passage as a reader of THAT genre would and decide whether the register is wrong, the criterion is out of scope, or the block is a stated exception. The human/agent half of the voice QA axis; the mechanical half runs in `qa-checkers-voice.ts`."
        }
      ],
      "skos:notation": "voice-editorial-review",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/voice-editorial-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/voice-overlay-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "voice-overlay-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Review a block against the active voices' rules and record the verdict on its QA sidecar. The human/agent half of the voice overlay; the mechanical half is whatever `patterns` and `terminology` a rule carries."
        }
      ],
      "skos:notation": "voice-overlay-review",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/voice-overlay-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/watch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "watch"
        }
      ],
      "skos:definition": [
        {
          "@value": "Background-watch a branch (default origin/main) or a GitHub PR for new activity while you work, and on every event report whether to integrate / whether it conflicts with the current branch / whether it lets you simplify exposition / proofs / computations"
        }
      ],
      "skos:notation": "watch",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/watch.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/where-a-proposal-goes",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "where-a-proposal-goes"
        }
      ],
      "skos:notation": "where-a-proposal-goes",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/where-a-proposal-goes.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/where-does-this-go",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "where-does-this-go"
        }
      ],
      "skos:definition": [
        {
          "@value": "The router for filing decisions. This repository answers \"where does this go?\" nine separate times, each well, and nothing says WHICH question you are asking — so an agent who does not know a rule exists cannot look it up. One discriminating question per row, and the skill that owns the answer."
        }
      ],
      "skos:notation": "where-does-this-go",
      "dcterms:source": "cat-harness/skills/conduct/conduct-core/where-does-this-go.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/wireframe-design-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "wireframe-design-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Design a user interface (a page, a visualiser, a navbar) by the WireGen methodology: a written design intent, at least two mid-fidelity HTML candidates, each with a web AND a mobile layout, mechanical checks at both viewports, a blind per-criterion review, adjudication where reviewers disagree, and a recorded choice. Also how an EXISTING visualiser is wireframed as-is, so that every declared visualiser has a wireframe with a QA sidecar. Process: processes/ui/wireframe-design-review.bpmn."
        }
      ],
      "skos:notation": "wireframe-design-review",
      "dcterms:source": "cat-harness/skills/ui/ui-core/wireframe-design-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/workflow-state",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "workflow-state"
        }
      ],
      "skos:definition": [
        {
          "@value": "Where a running process keeps what it knows, and which store answers which question. The three records a step may touch, the one it may not, what `<cat-harness.processes:bean op>` actually performs, and why an instance and a bean must be one answer rather than two."
        }
      ],
      "skos:notation": "workflow-state",
      "dcterms:source": "cat-harness/skills/process/workflow/workflow-state.md",
      "skos:note": "candidate"
    }
  ]
}
