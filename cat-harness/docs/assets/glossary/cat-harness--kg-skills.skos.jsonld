      },
      "skos:prefLabel": [
        {
          "@value": "specification-compiled-agents"
        }
      ],
      "skos:definition": [
        {
          "@value": "When a diagram already says what the process is, the model should not be planning it. The two gaps between this repository's engine and a compiled control plane — typed node contracts and per-node context scope — what to do before either exists, and the three things not to adopt with the method."
        }
      ],
      "skos:notation": "specification-compiled-agents",
      "dcterms:source": "cat-harness/skills/process/workflow/specification-compiled-agents.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/staging-review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "staging-review"
        }
      ],
      "skos:definition": [
        {
          "@value": "Staging preview and before/after comparison for content review. Takes one optional string — what the reader wants to look at, in their own words — and returns a list of URLs, each looked up in the publish ref, with what is published at it and what to review there. Provides before (MAIN) and after (STAGING) pairs so reviewers can compare rather than guess. Used by the CRDM feature development workflow, content authoring review sessions, and whenever a staging preview deploys or someone asks to see it."
        }
      ],
      "skos:notation": "staging-review",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/staging-review.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/stalled-agent-triage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "stalled-agent-triage"
        }
      ],
      "skos:definition": [
        {
          "@value": "Triage incoming work from stalled agents. Given named agents or sessions, or a time window, find what they left (handover reports, open PRs, branches, beans, issue and PR discussions, workflow instances), collect as many handover reports as exist, reconstruct the rest, consolidate the workstreams into 2–4 themes, recommend how to fold them into the current or a new work plan, and coordinate open PRs with their owners (the merge steward above all). Use when a session or a swarm has stalled, timed out or lost its container, or when the owner says \"pick up what X was doing\"."
        }
      ],
      "skos:notation": "stalled-agent-triage",
      "dcterms:source": "cat-harness/skills/sdlc/sdlc-core/stalled-agent-triage.md",
      "skos:note": "candidate"
    },
    {
