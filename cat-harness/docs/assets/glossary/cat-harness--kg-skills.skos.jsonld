      },
      "skos:prefLabel": [
        {
          "@value": "content-author"
        }
      ],
      "skos:notation": "content-author",
      "dcterms:source": "cat-harness/skills/authoring/content-lifecycle/content-author.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/content-context-and-state-graphs",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "content-context-and-state-graphs"
        }
      ],
      "skos:definition": [
        {
          "@value": "Every declared graph is the subject a process produces, static context it reads, or live state it writes. The one question that settles it, the classification of every kind with its reason, what a consumer may assume of each layer, and why agent memory is context rather than state."
        }
      ],
      "skos:notation": "content-context-and-state-graphs",
      "dcterms:source": "cat-harness/skills/kg/kg-core/content-context-and-state-graphs.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/content-feedback",
