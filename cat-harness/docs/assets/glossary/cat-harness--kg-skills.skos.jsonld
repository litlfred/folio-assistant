      },
      "skos:prefLabel": [
        {
          "@value": "content-profiles"
        }
      ],
      "skos:definition": [
        {
          "@value": "Adapters and profiles are different axes and conflating them is costly. What a document folio is, how a paper extends it, which distinction needs code and which needs only rules, and what profile enforcement catches that schema validation structurally cannot."
        }
      ],
      "skos:notation": "content-profiles",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/content-profiles.md",
