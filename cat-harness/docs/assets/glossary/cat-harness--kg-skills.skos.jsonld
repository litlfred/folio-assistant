      },
      "skos:prefLabel": [
        {
          "@value": "crdm-requirements-template"
        }
      ],
      "skos:definition": [
        {
          "@value": "Guide and template for CRDM Phase 3 — Requirements Definition. Helps the agent structure requirements from conversation using a REQ-### format with acceptance criteria, priority, and traceability."
