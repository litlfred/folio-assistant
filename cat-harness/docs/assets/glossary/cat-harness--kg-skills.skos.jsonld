      "skos:prefLabel": [
        {
          "@value": "deletion-requires-confirmation"
        }
      ],
      "skos:definition": [
        {
          "@value": "An agent never removes a durable artefact on its own initiative. Report what would go, with sizes and ages, and wait for the user to say so. Covers what counts as durable, the non-destructive move for each kind, and the rule that a workflow whose shape deletes something counts as a deletion nobody decided."
        }
      ],
