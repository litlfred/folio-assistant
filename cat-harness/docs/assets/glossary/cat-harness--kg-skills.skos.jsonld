      "skos:prefLabel": [
        {
          "@value": "literature-search"
        }
      ],
      "skos:definition": [
        {
          "@value": "Finding the source a node cites but does not hold — memory first, then this repository, then open-access services. Always produce a DIRECT download link. Read before recording that a citation cannot be found, and before appraising any source you have not opened. Its central rule: a blocked network is not a missing document, and the two must never share a report."
        }
      ],
      "skos:notation": "literature-search",
