    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/detangler-integration-watcher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "detangler-integration-watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Structural-QA integration watcher — watches the default branch + open active PRs + newly-opened PRs for organisational changes (paper / chapter manifest edits, new blocks, edited `uses[]` / `kind` / `label` / `interprets` / `defines` / `tags`, block renames) and runs the editor's detanglement skill suite (`content-graph`, `chapter-complexity-review`, `block-density`, `critical-path-analysis`) on every detected change. Queues findings, auto-discharges mechanical fixes (table extraction), routes block reorderings through narrative review before applying them, and escalates section splits / merges / cross-chapter moves / new sections to the author. Inherits shared mechanics from `local/integration-watcher`."
        }
      ],
      "skos:notation": "detangler-integration-watcher",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/detangler-integration-watcher.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/deterministic-and-agentic",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "deterministic-and-agentic"
        }
      ],
      "skos:definition": [
        {
          "@value": "Workflow processing is a SPECTRUM, not a switch. The four mechanisms this repository already uses to sit at different points on it, the four axes an answer has to name, what is measured today, and the three research questions — which are open, and marked as open."
        }
      ],
      "skos:notation": "deterministic-and-agentic",
      "dcterms:source": "cat-harness/skills/process/workflow/deterministic-and-agentic.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills/devils-advocate-watcher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/cat-harness/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "devils-advocate-watcher"
        }
      ],
      "skos:definition": [
        {
          "@value": "Logical devil's-advocate integration watcher — for every content block (.ts/.md) and formal sibling, constructs the strongest adversarial case that it is WRONG: the objection a hostile-but- competent referee would raise (false claim, vacuity, circularity, overclaim, hidden degree-of-freedom, logical non-sequitur, formal↔narrative divergence, citation misuse, definitional ambiguity, empirical fragility, domain implausibility, irreproducible compute). Fans out multiple adversarial-lens agents per block, then an adjudicator scores whether each objection survives rebuttal. Persists per-block <block>.qa.json entries under the `da-*` criteria family (reviewer.kind = \"agent\"). Operationalizes the standing Critical-distance red-team license (AGENTS.md). Inherits all shared mechanics (Monitor, subscriptions, queue, ledger, idle sweep, author-ask, watch-prepared-PRs, witness-drift recovery, billing-quick-fail flake) from `integration-watcher`."
        }
      ],
      "skos:notation": "devils-advocate-watcher",
      "dcterms:source": "cat-harness/skills/authoring/authoring-core/devils-advocate-watcher.md",
      "skos:note": "candidate"
    },
