        "2026-10-14"
      ]
    },
    {
      "@id": "docs/wireframes/suggest-editor/intent.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "What it must show",
      "prov:value": "bold, italic, strikethrough, heading, bullet list, numbered list, link, inline code, undo and redo;\n  - for a paper, also math, plus the raw-LaTeX toggle (owner: *\"both\"*);\n  - the track changes."
    },
