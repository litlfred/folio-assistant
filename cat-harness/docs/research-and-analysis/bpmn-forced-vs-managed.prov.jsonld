    {
      "@id": "docs/research-and-analysis/bpmn-forced-vs-managed.md#provenance-6",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "1. Experimental Design and the Two-Hash Split (`folio-test-run/v1`)",
      "prov:value": "[`sdlc/processes/test-plan-execution.bpmn`](https://github.com/litlfred/cat-harness/blob/main/sdlc/processes/test-plan-execution.bpmn) (`Process_TestPlanExecution`, 5 swimlanes), which opens its bean through [`bean-open.bpmn`](https://github.com/litlfred/cat-harness/blob/main/sdlc/processes/bean-open.bpmn) and closes it through [`bean-close.bpmn`](https://github.com/litlfred/cat-harness/blob/main/sdlc/processes/bean-close.bpmn) (bean `m8gz`), evaluates [`sdlc/processes/decisions/test-certification.dmn`](https://github.com/litlfred/cat-harness/blob/main/sdlc/processes/decisions/test-certification.dmn) at `GW_ExitCriteria` (`certified` | `refused` | `undetermined`) and, on the `certified` branch, enters [`sdlc/processes/qa-report-signing.bpmn`](https://github.com/litlfred/cat-harness/blob/main/sdlc/processes/qa-report-signing.bpmn) (`Process_QaReportSigning`, 3 swimlanes) via call activity `Call_Sign`, which in turn evaluates [`sdlc/processes/decisions/signing-route.dmn`](https://github.com/litlfred/cat-harness/blob/main/sdlc/processes/decisions/signing-route.dmn) at `Gateway_SigningRoute` (`api` | `human`).",
      "cat-harness:refs": [
        "bean m8gz",
        "bean through"
      ]
    },
