      ],
      "dcterms:date": [
        "2026-09-20"
      ]
    },
    {
      "@id": "work-plan/skills/work-plan/bean-coordination.md#provenance-41",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Worked example — the session that built this tool, tripping over it",
      "prov:value": "A sibling session had created the same three milestones **with the owner's verbatim words** and merged them to `main` at 18:50, about an hour earlier.",
      "cat-harness:refs": [
