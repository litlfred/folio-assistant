      ]
    },
    {
      "@id": "work-plan/skills/work-plan/bean-coordination.md#provenance-39",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "One command, not a procedure",
      "prov:value": "(`tools/sessions.ts`), which is what `ab3n` asked for and for a reason: prose describing how to grep a trailer is a procedure every session re-derives slightly differently, the counts then disagree, and nobody can tell which sweep was wrong.",
      "cat-harness:refs": [
        "`ab3n`"
      ]
    },
    {
      "@id": "work-plan/skills/work-plan/bean-coordination.md#provenance-40",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Worked example — the session that built this tool, tripping over it",
      "prov:value": "**2026-09-20, an hour after `ab3n` was written.** This session created three `milestone` beans for the owner's three goals, each carrying the `goal-review` sweep's **paraphrase**, because the verbatim words were not written down anywhere it could see — it searched the issue, its comments, the pull request and the whole store.",
      "cat-harness:refs": [
        "`ab3n`",
        "owner's",
