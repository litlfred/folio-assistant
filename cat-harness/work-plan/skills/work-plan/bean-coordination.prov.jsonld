    },
    {
      "@id": "work-plan/skills/work-plan/bean-coordination.md#provenance-24",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "date",
      "cat-harness:section": "Complete it in the PR's own last commit (bean `4d22`)",
      "prov:value": "Practised on 2026-09-23 for eight beans in a row with no orphan.",
      "cat-harness:refs": [
