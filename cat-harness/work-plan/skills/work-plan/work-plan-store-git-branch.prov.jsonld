    {
      "@id": "work-plan/skills/work-plan/work-plan-store-git-branch.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "proposal",
      "cat-harness:section": "The operations, by this Tool",
      "prov:value": "| write the file with its front matter | | `update(id, change, ifMatch)` | `beans update <id> …` | edit the front matter | | `note(id, text)` | `beans update <id> --body-append …`, or a file in `beans/notes/` | append to the body, or add a note file | | `update(id, { archived: true }, …)` | `beans archive` (the sweep), or move the file | move `defs/<id>--*.md` into `defs/archive/`; the status is kept | | `history(id)` | `git log --follow -- beans/defs/<id>--*.md` on the branch, merged with the `history` of every instance in `beans/workflows/` that names the bean (Q-BSD-4 A)",
      "cat-harness:refs": [
        "Q-BSD-4"
      ]
    }
