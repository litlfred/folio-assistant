{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "workflow-next",
    "title": "What is enabled now",
    "description": "The activities an instance may work right now, each with the lane that owns it and the skill that implements it.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "workflow_next"
      },
      "inProcess": {
        "module": "src/tools/workflow.ts"
      }
    },
    "io": {
      "inputs": [
        {
          "name": "instance",
          "schema": {
            "$type": "InstanceId"
          },
          "required": true,
          "arg": {
            "positional": 0
          }
        }
      ],
      "outputs": [
        {
          "name": "enabled",
          "schema": {
            "$type": "Markdown"
          },
          "description": "Activity, lane and skill for each enabled step."
        }
      ]
    },
    "satisfies": [
      "process-state"
    ],
    "requires": {
      "network": false
    }
  }
}
