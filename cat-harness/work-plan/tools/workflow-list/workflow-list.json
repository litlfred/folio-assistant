{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "workflow-list",
    "title": "List processes",
    "description": "The BPMN processes this layer defines, and the layers currently open against them.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "workflow_list"
      },
      "inProcess": {
        "module": "src/tools/workflow.ts"
      }
    },
    "io": {
      "inputs": [],
      "outputs": [
        {
          "name": "processes",
          "schema": {
            "$type": "Markdown"
          },
          "description": "Each process, its policy, and its open layers."
        }
      ]
    },
    "satisfies": [
      "process-state"
    ],
    "requires": {
      "network": false
    }
  }
}
