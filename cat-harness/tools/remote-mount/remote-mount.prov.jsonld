    {
      "@id": "tools/remote-mount/remote-mount.json#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "tool.description",
      "prov:value": "`--staging` mounts for a preview and needs neither, by the owner's ruling."
    },
    {
      "@id": "tools/remote-mount/remote-mount.json#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "tool.description",
      "prov:value": "A directory id an override or `mountDefaults` names may be one the instance declares in its `<name>.json` or one it declares FROM WITHIN a declared directory (`skills/skills.json` naming `voices`), resolved at the pin through `instanceDirectories` (bean `mo75` G3); an id in neither is refused at plan time.",
      "cat-harness:refs": [
        "bean mo75"
      ]
    },
    {
      "@id": "tools/remote-mount/remote-mount.json#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "tool.description",
      "prov:value": "`tools` on an override names Tools by id and mounts each one runnable (bean `mo75` G3; owner, 2026-10-24): its definition (`<tools dir>/<id>/<id>.ts`), its implementation (the `inProcess.module`, or the script its `bun run cat <key>` resolves to) and their import closure, walked by bootstrap-tools' `importClosure` (the one closure walker), as every declared directory that closure touches — the lock still records directories only.",
      "cat-harness:refs": [
        "bean mo75",
        "2026-10-24"
      ],
      "dcterms:date": [
        "2026-10-24"
      ]
    },
    {
      "@id": "tools/remote-mount/remote-mount.json#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "tool.description",
      "prov:value": "A `hydrated` mount (bean `mo75`) lays each chosen directory down as its published `index.hydrated.jsonld` only: read from the pin's git tree when a commit carries it, otherwise fetched from the pin's subgraph index package (the `subgraph-index-<sha>` release asset `subgraph-index-package` publishes), its tarball checked against its `folio-binary-release/v1` record, its manifest against the repository, pin and harness asked for, and each file against its sha256, `SubgraphHydratedSchema` and the subgraph IRI; the lock records the package's URL and sha256 so a replay fetches the same bytes.",
      "cat-harness:refs": [
        "bean mo75"
      ]
    },
    {
      "@id": "tools/remote-mount/remote-mount.json#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "tool.io.inputs[5].description",
      "prov:value": "Refused while a mount it moves has edits the lock does not hold, since the next mount would leave that mount at the old commit (folio-assistant#2682); `fresh` lets it through.",
      "cat-harness:refs": [
        "folio-assistant#2682"
      ]
    },
    {
      "@id": "tools/remote-mount/remote-mount.json#provenance-6",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "tool.io.inputs[7].description",
      "prov:value": "`<harness>[:<instance>]`: write a review's choice (`directories` and/or `tools`) into that mount entry's `overrides.<instance>` instead of mounting, so a fresh clone replays it (bean `mo75`).",
      "cat-harness:refs": [
        "bean mo75"
      ]
    }
  ]
