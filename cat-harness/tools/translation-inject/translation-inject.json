{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "translation-inject",
    "title": "Inject translations",
    "description": "Produce a translated copy of a source markdown file from a .po, using the same segmentation the extractor used.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "translation_inject"
      },
      "inProcess": {
        "module": "src/tools/translation.ts"
      }
    },
    "io": {
      "inputs": [
        {
          "name": "source",
          "schema": {
            "$type": "RepoPath"
          },
          "required": true,
          "arg": {
            "positional": 0
          }
        },
        {
          "name": "po_file",
          "schema": {
            "$type": "RepoPath"
          },
          "required": true,
          "arg": {
            "positional": 1
          }
        },
        {
          "name": "locale",
          "schema": {
            "$type": "Locale"
          },
          "required": true,
          "arg": {
            "flag": "--locale"
          }
        }
      ],
      "outputs": [
        {
          "name": "translated",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "The translated copy written."
        }
      ]
    },
    "satisfies": [
      "translation-manager"
    ],
    "requires": {
      "network": false
    }
  }
}
