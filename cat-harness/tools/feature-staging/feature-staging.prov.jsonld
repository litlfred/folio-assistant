    {
      "@id": "tools/feature-staging/feature-staging.json#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "tool.io.inputs[1].description",
      "prov:value": "DELETION: the `branches/<slug>` to remove, instead of staging anything. It exists because the label path cannot reach the previews the health sweep reports — being findable as an orphan REQUIRES the pull request to be closed, so the close event has already fired with no label (bean `w2g5`).",
      "cat-harness:refs": [
        "bean w2g5"
      ]
    },
    {
      "@id": "tools/feature-staging/feature-staging.json#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "tool.selection.limits",
      "prov:value": "The removal arm is guarded THREE ways, and the guards are the point rather than ceremony: `workflow_dispatch` is available only to an actor with write access; `cleanup_confirm` must repeat the slug exactly; and the removal is preflighted at removal time against the same liveness signals the health sweep uses. That is `deletion-requires-confirmation` applied to the tool most able to break it — bean `plj1` is a workflow whose shape deleted every open pull request's preview without anybody deciding it. This node does not claim that skill, because implementing the discipline once is not the same as stating it.",
      "cat-harness:refs": [
        "bean plj1"
      ]
    },
    {
      "@id": "tools/feature-staging/feature-staging.json#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "tool.selection.cost",
      "prov:value": "Concurrency is keyed on the branch or the cleanup slug, NOT the shared ref, so two cleanups of different previews no longer cancel each other (bean `xd1s`).",
      "cat-harness:refs": [
        "bean xd1s"
      ]
    }
  ]
}
