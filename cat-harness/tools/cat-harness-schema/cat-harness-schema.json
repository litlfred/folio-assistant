{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "cat-harness-schema",
    "title": "Layer declaration schema",
    "description": "The zod definition of `<name>.json` — what a layer may declare about itself — and the published JSON Schema generated from it.",
    "install": {
      "none": true
    },
    "invoke": {
      "shell": "bun run cat kg:schema"
    },
    "io": {
      "inputs": [
        {
          "name": "baseUrl",
          "schema": {
            "$type": "Url"
          },
          "required": false,
          "arg": {
            "flag": "--base-url"
          },
          "description": "Publication base; a preview passes its own."
        }
      ],
      "outputs": [
        {
          "name": "schema",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "The written JSON Schema."
        }
      ]
    },
    "satisfies": [
      "kg-export"
    ],
    "maintains": [
      {
        "source": "schemas/kg/cat-harness.ts",
        "artefact": "cat-harness/cat-harness.schema.json",
        "format": "json-schema"
      }
    ]
  }
}
