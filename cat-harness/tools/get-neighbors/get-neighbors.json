{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "get-neighbors",
    "title": "Walk the content graph from one node",
    "description": "List the nodes adjacent to one node, out (what it depends on) or in (what depends on it), to a given depth and optionally over named edge terms only. An unknown edge term is reported, never silently dropped.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "get_neighbors"
      },
      "inProcess": {
        "module": "src/tools/graph.ts"
      }
    },
    "io": {
      "inputs": [
        {
          "name": "id",
          "schema": {
            "$type": "Text"
          },
          "description": "Node @id or authored label, e.g. `thm:main`.",
          "required": true
        },
        {
          "name": "direction",
          "schema": {
            "$type": "Slug"
          },
          "description": "`out` (default), `in` or `both`.",
          "required": false
        },
        {
          "name": "hops",
          "schema": {
            "$type": "Count"
          },
          "description": "Traversal depth, 1-6 (default 1).",
          "required": false
        },
        {
          "name": "edges",
          "schema": {
            "$type": "Text"
          },
          "description": "A LIST of edge terms (uses, interprets, cites, contains, ...) to restrict to. Omit for all.",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "result",
          "schema": {
            "$type": "Markdown"
          },
          "description": "JSON: the neighbours, each with the edge path that reached it."
        }
      ]
    },
    "satisfies": [
      "corpus-grep"
    ],
    "requires": {
      "network": false
    }
  }
}
