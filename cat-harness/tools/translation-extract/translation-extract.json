{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "translation-extract",
    "title": "Extract translatable strings",
    "description": "Segment a folio's prose into a GNU gettext .pot template, leaving code, math and identifiers untranslated.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "translation_extract"
      },
      "inProcess": {
        "module": "src/tools/translation.ts"
      }
    },
    "io": {
      "inputs": [
        {
          "name": "path",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "A markdown file or a directory of them.",
          "required": true,
          "arg": {
            "positional": 0
          }
        },
        {
          "name": "locale",
          "schema": {
            "$type": "Locale"
          },
          "required": false,
          "arg": {
            "flag": "--locale"
          }
        },
        {
          "name": "project_name",
          "schema": {
            "$type": "Text"
          },
          "description": "Recorded in the .pot header.",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "pot",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "The template written."
        }
      ]
    },
    "satisfies": [
      "translation-manager"
    ],
    "requires": {
      "network": false
    }
  }
}
