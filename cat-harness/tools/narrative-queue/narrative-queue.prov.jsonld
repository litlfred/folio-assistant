  "dcterms:description": "Provenance moved out of the narrative of narrative-queue.json: who decided, when, and under which work item or proposal. The document keeps the rules and their reasons; this log is rendered in its footer.",
  "@graph": [
    {
      "@id": "tools/narrative-queue/narrative-queue.json",
      "@type": "prov:Entity",
      "prov:wasInfluencedBy": [
        {
          "@id": "tools/narrative-queue/narrative-queue.json#provenance-1"
        },
        {
          "@id": "tools/narrative-queue/narrative-queue.json#provenance-2"
