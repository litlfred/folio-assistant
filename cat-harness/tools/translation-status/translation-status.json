{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "translation-status",
    "title": "Translation coverage",
    "description": "Per-locale translation coverage, computed from the .po files under the translations directory.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "translation_status"
      },
      "inProcess": {
        "module": "src/tools/translation.ts"
      }
    },
    "io": {
      "inputs": [
        {
          "name": "locale",
          "schema": {
            "$type": "Locale"
          },
          "description": "Absent means every locale.",
          "required": false,
          "arg": {
            "flag": "--locale"
          }
        }
      ],
      "outputs": [
        {
          "name": "coverage",
          "schema": {
            "$type": "Markdown"
          },
          "description": "Translated, fuzzy and untranslated counts per locale."
        }
      ]
    },
    "satisfies": [
      "translation-manager"
    ],
    "requires": {
      "network": false
    }
  }
}
