{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "pack-tarball",
    "title": "Package instance into an npm tarball and record binary release",
    "description": "Build an npm tarball (.tgz) of an instance using `bun pm pack`, compute its size and SHA-256 digest, and record it as a `folio-binary-release/v1` state node.",
    "install": {
      "none": true
    },
    "invoke": {
      "shell": "bun run cat pack:tarball"
    },
    "io": {
      "inputs": [
        {
          "name": "root",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "Instance root containing package.json (default: cwd).",
          "required": false,
          "arg": {
            "flag": "--root"
          }
        },
        {
          "name": "destination",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "Directory to save the tarball and release record.",
          "required": false,
          "arg": {
            "flag": "--destination"
          }
        },
        {
          "name": "out",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "Path to write the folio-binary-release/v1 JSON record.",
          "required": false,
          "arg": {
            "flag": "--out"
          }
        },
        {
          "name": "repository",
          "schema": {
            "$type": "RepoFullName"
          },
          "description": "Repository owner/repo for the release origin.",
          "required": false,
          "arg": {
            "flag": "--repository"
          }
        },
        {
          "name": "release-url",
          "schema": {
            "$type": "Url"
          },
          "description": "Public URL where the tarball is published/hosted.",
          "required": false,
          "arg": {
            "flag": "--release-url"
          }
        },
        {
          "name": "json",
          "schema": {
            "$type": "Flag"
          },
          "description": "Emit the folio-binary-release/v1 JSON record to stdout.",
          "required": false,
          "arg": {
            "flag": "--json"
          }
        }
      ],
      "outputs": [
        {
          "name": "release",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "Path to the created folio-binary-release/v1 record."
        },
        {
          "name": "tarball",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "Path to the created .tgz tarball."
        }
      ]
    },
    "satisfies": [
      "package-release",
      "npm-kg-distribution"
    ],
    "requires": {
      "runtime": [
        "bun"
      ],
      "network": false
    }
  }
}
