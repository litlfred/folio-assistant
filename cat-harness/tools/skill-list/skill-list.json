{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "skill-list",
    "title": "List skills",
    "description": "Every skill this instance can resolve, with its one-line summary. The entry point AGENTS.md sends an agent to first.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "skill_list"
      },
      "inProcess": {
        "module": "src/tools/skill-fetch.ts"
      }
    },
    "io": {
      "inputs": [],
      "outputs": [
        {
          "name": "skills",
          "schema": {
            "$type": "Markdown"
          },
          "description": "Name and summary per skill."
        }
      ]
    },
    "satisfies": [
      "skills-and-tools"
    ],
    "requires": {
      "network": false
    }
  }
}
