{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "avatars-css",
    "title": "Avatar stylesheet",
    "description": "Render the declared avatar nodes — an actor's glyph and colours, including the overlay states — into the stylesheet the site serves.",
    "install": {
      "none": true
    },
    "invoke": {
      "shell": "bun run cat avatars:css"
    },
    "io": {
      "inputs": [
        {
          "name": "check",
          "schema": {
            "$type": "Flag"
          },
          "description": "Compare against the committed copy and fail if stale, instead of writing.",
          "required": false,
          "arg": {
            "flag": "--check"
          }
        }
      ],
      "outputs": [
        {
          "name": "stylesheet",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "The generated stylesheet. Never hand-edited."
        }
      ]
    },
    "satisfies": [
      "site-presentation-assets"
    ],
    "requires": {
      "runtime": [
        "bun"
      ],
      "network": false
    },
    "maintains": [
      {
        "source": "schemas/content/avatars.ts",
        "artefact": "assets/css/avatars.css",
        "format": "css"
      }
    ]
  }
}
