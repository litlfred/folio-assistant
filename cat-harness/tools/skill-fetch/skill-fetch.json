{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "skill-fetch",
    "title": "Fetch a skill",
    "description": "Load one skill's instruction body for the agent to follow, from the local packages or an external bundle.",
    "install": {
      "none": true
    },
    "invoke": {
      "mcp": {
        "tool": "skill_fetch"
      },
      "inProcess": {
        "module": "src/tools/skill-fetch.ts"
      }
    },
    "io": {
      "inputs": [
        {
          "name": "skill",
          "schema": {
            "$type": "SkillName"
          },
          "required": true,
          "arg": {
            "positional": 0
          }
        },
        {
          "name": "package_name",
          "schema": {
            "$type": "PackageName"
          },
          "required": false,
          "arg": {
            "flag": "--package"
          }
        }
      ],
      "outputs": [
        {
          "name": "instructions",
          "schema": {
            "$type": "Markdown"
          },
          "description": "The skill's instruction body."
        }
      ]
    },
    "satisfies": [
      "skills-and-tools"
    ],
    "requires": {
      "network": false
    }
  }
}
