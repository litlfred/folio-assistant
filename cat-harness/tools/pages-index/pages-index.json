{
  "$schema": "tool-definition/v1",
  "tool": {
    "id": "pages-index",
    "title": "Published-paper index page",
    "description": "Write the gh-pages `index.html` for a built paper: a Paper tab embedding the PDF and, when given, a Visualizer tab, with download links and the build's branch and commit.",
    "install": {
      "none": true
    },
    "invoke": {
      "shell": "python3 .github/scripts/generate-index.py"
    },
    "io": {
      "inputs": [
        {
          "name": "outputHtml",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "Where to write index.html.",
          "required": true,
          "arg": {
            "positional": 0
          }
        },
        {
          "name": "paperEmbed",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "The file the Paper tab embeds, typically the PDF.",
          "required": true,
          "arg": {
            "positional": 1
          }
        },
        {
          "name": "pdf",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "The PDF filename used in download links.",
          "required": true,
          "arg": {
            "flag": "--pdf"
          }
        },
        {
          "name": "md",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "A Markdown rendering to link, when there is one.",
          "required": false,
          "arg": {
            "flag": "--md"
          }
        },
        {
          "name": "visualizer",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "The visualizer page for the second tab.",
          "required": false,
          "arg": {
            "flag": "--visualizer"
          }
        },
        {
          "name": "branch",
          "schema": {
            "$type": "Branch"
          },
          "description": "The branch the build is from.",
          "required": false,
          "arg": {
            "flag": "--branch"
          }
        },
        {
          "name": "repo",
          "schema": {
            "$type": "RepoFullName"
          },
          "description": "owner/repo, for links back to the source.",
          "required": false,
          "arg": {
            "flag": "--repo"
          }
        },
        {
          "name": "sha",
          "schema": {
            "$type": "CommitSha"
          },
          "description": "The commit the build is from.",
          "required": false,
          "arg": {
            "flag": "--sha"
          }
        }
      ],
      "outputs": [
        {
          "name": "index",
          "schema": {
            "$type": "RepoPath"
          },
          "description": "The written index.html."
        }
      ]
    },
    "satisfies": [
      "docs-generation"
    ],
    "requires": {
      "runtime": [
        "python3"
      ],
      "network": false
    }
  }
}
