    {
      "@id": "platform-ui/skills/platform-ui/theme-contrast.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "The measurement is over PURE BLACK, and that is the whole idea",
      "prov:value": "**Every value here was re-measured rather than nudged.** When a scrim changed,\nthe ratio was recomputed and written down beside it. A scrim whose ratio nobody\nrecomputed is a scrim doing less work than it appears to — which had already\nhappened once."
    },
    {
      "@id": "platform-ui/skills/platform-ui/theme-contrast.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "A new surface inherits this, it does not renegotiate it",
      "prov:value": "A todo sticky gaining backdrop art (bean `5y4b`) inherits the requirement\nexactly: **it must not reach the board by skipping the measurement the landing\nstickies pay.** A surface that renders art behind text and has no measured\nscrim is a contrast finding whatever it looks like on the reviewer's monitor.",
      "cat-harness:refs": [
        "bean 5y4b"
      ]
    }
  ]
}
