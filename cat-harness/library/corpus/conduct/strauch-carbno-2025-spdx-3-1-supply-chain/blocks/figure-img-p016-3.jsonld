  "narrative": [
    {
      "text": "A screenshot of a graph-editor canvas with node cards, each showing a type and a name, joined by labelled edges. Organization 'Smart Talk Becom' is reached by a 'createdBy' edge from CreationInfo '3.0.1'. PhysicalHardware 'AMD A10-6700 APU with Rad...' has a 'productAgent' edge to Organization 'AMD' and a 'to' edge to Relationship 'hasOutput'. Relationship 'hasOutput' has a 'from' edge to ManufacturerAction 'Make CPU', which has a 'from' edge to Relationship 'hasInput', which has a 'to' edge to PhysicalHardware 'Wafer'. 'Wafer' has a 'productAgent' edge to Organization 'TMC Technology'. Relationship 'performedBy' has a 'from' edge to 'Make CPU' and a 'to' edge to 'TMC Technology'. The type name 'ManufacturerAction' and the spelling 'Smart Talk Becom' are as drawn.",
      "state": "draft",
      "drafted_by": {
