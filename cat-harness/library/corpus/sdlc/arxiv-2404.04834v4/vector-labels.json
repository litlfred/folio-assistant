          "sizes": [
            9.96,
            10.06
          ]
        },
        {
          "text": "which test cases need maintenance after source code changes. These agents perform tasks including",
          "bbox": [
            45.46,
            359.77,
            440.17,
            369.74
          ],
          "intersectsDrawing": false,
          "fonts": [
            "LinLibertineT"
          ],
          "sizes": [
            9.86
          ]
        },
        {
          "text": "summarizing code changes, identifying maintenance triggers, and localizing relevant test cases.",
          "bbox": [
            45.83,
