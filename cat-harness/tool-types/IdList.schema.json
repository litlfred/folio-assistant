  "$id": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types/IdList.schema.json",
  "title": "IdList",
  "type": "string",
  "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*(?:,[A-Za-z0-9][A-Za-z0-9._/-]*)*$",
