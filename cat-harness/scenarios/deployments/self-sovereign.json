{
  "id": "self-sovereign",
  "title": "Self-sovereign (example)",
  "description": "No external service at all: local git, an agent on open weights with no network, and a person who signs. It is the one example that may hold wallet credentials (owner, 2026-09-24). The attestation-service actor cannot be placed here: its own file fixes reach as internet, so signing goes to the human lane (signing-route.dmn).",
  "topology": {
    "forge": "none",
    "network": "air-gapped",
    "compute": "own-infrastructure",
    "modelProvenance": "open-weight-local",
    "toolSurface": "cli",
    "modelCardinality": "single",
    "dataStores": ["wallet"],
    "outwardFacing": false
  },
  "publicationHost": "local-server",
  "modes": ["author", "develop", "test", "qa-review"],
  "placements": [
    { "actor": "authoring-agent", "host": "local", "compute": "own-infrastructure", "toolSurface": "cli", "modelProvenance": "open-weight-local" },
    { "actor": "owner", "host": "local", "compute": "own-infrastructure", "credentials": { "sign-artefact": "LOCAL_KEYSTORE" } }
  ],
  "jurisdiction": { "audience": "operator-only", "residency": "the owner's own machine" },
  "liveData": "may-hold-credentials",
  "stores": { "work-plan": "beans-git-branch" }
}
