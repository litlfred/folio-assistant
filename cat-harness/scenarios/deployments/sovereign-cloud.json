{
  "id": "sovereign-cloud",
  "title": "Sovereign cloud (example)",
  "description": "A fictional jurisdiction hosts the forge, the runners, the agents and the publication. Egress leaves only for what the jurisdiction allows, models run on open weights inside it, and only artefacts are held: no live data store is reachable (owner, 2026-09-24).",
  "topology": {
    "forge": "jurisdiction-hosted",
    "visibility": "internal",
    "network": "egress-restricted",
    "compute": "jurisdiction-cloud",
    "modelProvenance": "open-weight-local",
    "toolSurface": "cli",
    "modelCardinality": "stack",
    "dataStores": ["none"],
    "outwardFacing": true
  },
  "publicationHost": "jurisdiction-endpoint",
  "modes": ["author", "ingest", "develop", "test", "qa-review", "publish"],
  "placements": [
    { "actor": "authoring-agent", "host": "local", "compute": "jurisdiction-cloud", "reach": "egress-restricted", "modelProvenance": "open-weight-local" },
    { "actor": "review-agent", "host": "local", "compute": "jurisdiction-cloud", "reach": "air-gapped", "modelProvenance": "open-weight-local" },
    { "actor": "ci-pipeline", "host": "gitlab-ci", "compute": "jurisdiction-cloud", "reach": "egress-restricted", "credentials": { "push-branch": "FORGE_TOKEN", "publish-site": "PUBLISH_SITE" } },
    { "actor": "owner", "host": "local", "identity": { "provider": "gitlab" } }
  ],
  "jurisdiction": {
    "publicationBase": "https://guidelines.example.org/",
    "audience": "authenticated",
    "retention": "as long as the published version is in force, then archived",
    "residency": "in-country"
  },
  "liveData": "artefacts-only",
  "stores": { "work-plan": "beans-git-branch" }
}
