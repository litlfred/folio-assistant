{
  "id": "private-github",
  "title": "Private GitHub",
  "description": "As today, on a private repository, and rendered by a local server rather than Pages (owner, 2026-09-19: Pages on a private repository exists on some plans, so this is a choice, not a conflict).",
  "topology": {
    "forge": "github",
    "visibility": "private",
    "network": "internet",
    "compute": "vendor-cloud",
    "modelProvenance": "hosted",
    "toolSurface": "both",
    "dataStores": [
      "none"
    ],
    "outwardFacing": false
  },
  "publicationHost": "local-server",
  "modes": [
    "author",
    "develop",
    "test",
    "qa-review"
  ],
  "placements": [
    {
      "actor": "claude",
      "host": "claude-code",
      "reach": "internet",
      "compute": "vendor-cloud",
      "identity": {
        "provider": "github"
      }
    },
    {
      "actor": "ci-pipeline",
      "host": "github-actions",
      "reach": "internet",
      "compute": "vendor-cloud",
      "credentials": {
        "push-branch": "GITHUB_TOKEN"
      }
    },
    {
      "actor": "owner",
      "host": "local",
      "reach": "internet",
      "compute": "workstation",
      "identity": {
        "provider": "github"
      }
    }
  ],
  "jurisdiction": {
    "audience": "operator-only"
  },
  "liveData": "artefacts-only",
  "stores": { "work-plan": "beans-git-branch" }
}
