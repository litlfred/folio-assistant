      ]
    },
    {
      "@id": "sdlc/skills/sdlc-core/prepare-merge.md#provenance-35",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "pr",
      "cat-harness:section": "`qa:resolve-conflicts` is retired (bean `7mwa`, 2026-11-01)",
      "prov:value": "It existed because the derived\nsidecars were committed: across one working session on PR #773 and its\nsuccessor, **four base merges gave four conflicts, every one in a committed\ngenerated QA sidecar** (bean `520m`), and the command regenerated each one,\nrefusing any file that carried a judgement the attestation store did not hold.\ncat-harness (cat-harness#857) and the content core\n(https://github.com/litlfred/folio-assistant-core/pull/482) no longer commit `test/results/`, and the\njudgements moved to `test/attestations/` (bean `2gst`).",
      "cat-harness:refs": [
        "bean 520m",
        "bean 2gst",
        "#773",
        "cat-harness#857",
        "https://github.com/litlfred/folio-assistant-core/pull/482"
      ]
    },
    {
      "@id": "sdlc/skills/sdlc-core/prepare-merge.md#provenance-36",
