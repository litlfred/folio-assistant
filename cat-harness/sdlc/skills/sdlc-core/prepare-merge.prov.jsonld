      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "`qa:resolve-conflicts` is retired (bean `7mwa`, 2026-11-01)",
      "prov:value": "The owner retired the\ncommand, its `qa-sidecar` merge pattern and the `test/results/` entries in\n`.gitattributes` together (2026-11-01, \"A.",
      "cat-harness:refs": [
        "2026-11-01"
      ],
