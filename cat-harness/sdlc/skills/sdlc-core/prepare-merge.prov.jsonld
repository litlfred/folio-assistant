    {
      "@id": "sdlc/skills/sdlc-core/prepare-merge.md#provenance-32",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Submodules: check the pointers BEFORE you stage the merge (STRICT)",
      "prov:value": "**Why it is not `qa:resolve-conflicts`, and not bean `520m`.** That command,\nretired since bean `7mwa`, only ever inspected UNMERGED paths, and here there\nwere none; `520m` is about\ngenerated artefacts that *conflict*, which is noisy but git stops you.",
      "cat-harness:refs": [
        "bean 520m",
        "bean 7mwa"
      ]
    },
    {
      "@id": "sdlc/skills/sdlc-core/prepare-merge.md#provenance-33",
