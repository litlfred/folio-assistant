    {
      "@id": "sdlc/skills/sdlc-core/prepare-merge.md#provenance-37",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Guardrails",
      "prov:value": "- **In folio-assistant an agent never merges to `main` at all** (owner,\n  2026-10-01).",
      "cat-harness:refs": [
        "2026-10-01"
      ],
      "dcterms:date": [
        "2026-10-01"
      ]
    },
    {
      "@id": "sdlc/skills/sdlc-core/prepare-merge.md#provenance-38",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Guardrails",
      "prov:value": "Read the governing skills (from the mounted layers when the MCP\n  skill server is unreachable) and hold the diff to them: a step that, say,\n  copies the IG Publisher's finished HTML into a site passes every test and\n  breaks `ig-render-jekyll` (owner, 2026-10-14).",
      "cat-harness:refs": [
        "2026-10-14"
      ],
      "dcterms:date": [
        "2026-10-14"
      ]
    },
    {
      "@id": "sdlc/skills/sdlc-core/prepare-merge.md#provenance-39",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Guardrails",
      "prov:value": "A design choice the PR body\n  describes in passing (\"copies every Publisher page the site lacks\") is a\n  question for the owner when a skill already answers it, never an\n  implementation detail to merge past."
    },
    {
      "@id": "sdlc/skills/sdlc-core/prepare-merge.md#provenance-40",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Guardrails",
      "prov:value": "Bean `3pqn`.",
      "cat-harness:refs": [
