      "cat-harness:section": "What you look for",
      "prov:value": "Read the definitions\nthere rather than from a copy: the proposal's own table already differs from\nthe schema."
    },
    {
      "@id": "sdlc/skills/sdlc-core/adversarial-code-review.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Recording the verdict",
      "prov:value": "The verdict lives on its own state branch, **never in the pull request**.\nCommitting it into the pull request moves the head it names, which makes it\nstale at once (owner, 2026-10-20, \"State branch\").",
