    {
      "@id": "sdlc/skills/sdlc-core/qa-witness.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "The three families, and why the distinction is load-bearing",
      "prov:value": "A `kg` document's\ncriteria all come from one auditor, so the same field is the same value\nrepeated, and the auditor's identity is recorded once in\n`skills/kg-qa.manifest.json` rather than in each sidecar (bean `cflw`).",
      "cat-harness:refs": [
        "bean cflw"
      ]
    },
