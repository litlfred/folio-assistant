    {
      "@id": "sdlc/skills/sdlc-core/integration-watcher/idle-backlog.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "5g. Watch PRs you prepare",
      "prov:value": "When a watcher (or any skill it dispatches) **prepares a PR**, the\nwatcher **must** add the new PR to its subscription set immediately and\nfollow up on review activity. Author oversight expectation: *\"watch PRs\nyou prepare for review comments and respond if you can. if not ask\nauthor. once done, ask author if they want to merge and provide link\"*."
    },
    {
      "@id": "sdlc/skills/sdlc-core/integration-watcher/idle-backlog.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "5m. Sequential-by-default; parallel agents require explicit consent",
      "prov:value": "Repo-owner preference: **don't spawn more than one agent at a time\nunless explicit consent. This overrides the historical\n\"parallel-by-default\" model."
    }
