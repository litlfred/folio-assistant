      "@id": "sdlc/skills/sdlc-core/qa-reports.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "proposal",
      "cat-harness:section": "The branch",
      "prov:value": "**A miss is never read as \"no findings\".** A reader\nthat turns an absent entry into an empty, clean directory is the `dh4f`\ndefect, and the readers audit\n(`docs/proposals/qa-readers-audit-2026-10-01.md`) is a catalogue of exactly\nthat.",
      "cat-harness:refs": [
        "2026-10-01",
        "docs/proposals/qa-readers-audit-2026-10-01.md"
      ],
      "dcterms:date": [
        "2026-10-01"
      ]
    },
    {
