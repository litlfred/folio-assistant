    },
    {
      "@id": "sdlc/skills/sdlc-core/qa-reports.md#provenance-7",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Whose branch: each layer publishes its own",
      "prov:value": "**The branch is the store of the repository that declares it.** A layer\nrepository that declares a `qa` directory with `storage` (`test/results/`,\nkeyed by commit) keeps its results on `cat/cat-harness/qa-reports` of **its\nown** repository, keyed by **its own** commits (owner, 2026-11-03, \"2.",
      "cat-harness:refs": [
        "2026-11-03"
      ],
      "dcterms:date": [
        "2026-11-03"
      ]
    },
    {
