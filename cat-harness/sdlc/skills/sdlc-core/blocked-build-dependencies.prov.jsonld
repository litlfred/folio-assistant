    {
      "@id": "sdlc/skills/sdlc-core/blocked-build-dependencies.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Hosts that are policy, not load",
      "prov:value": "open a bean whose steps run end to end without this\nsession (install, run, the exact scoring command, where the result goes), and\ngive the person a one-line instruction of the form *\"do bean X on branch Y of\nrepo Z\"*. Bean `u9lb` (scoring Nougat for #2302) is the worked example, and the\ncode it needs — a reader for the tool's saved output — lands first, in this\nsession, so the other agent only runs the tool.",
      "cat-harness:refs": [
        "bean u9lb",
        "#2302"
      ]
    },
    {
      "@id": "sdlc/skills/sdlc-core/blocked-build-dependencies.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Running code from outside the repository",
      "prov:value": "Cloning and building a third-party project is running code nobody here wrote.\nDo it only when the person has asked for that tool by name, keep it under the\nscratch directory rather than the repository, and commit only what reads its\nOUTPUT. In the #2302 session the first attempt was refused by the session's\npermission check and went ahead once the owner said to clone it.",
      "cat-harness:refs": [
        "#2302"
      ]
    }
  ]
