    {
      "@id": "sdlc/skills/sdlc-core/turn-reporting.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "pr",
      "cat-harness:section": "The rules that make a report worth reading",
      "prov:value": "`AGENTS.md` records the underlying rule (PR #178, 2026-09-16): a human cannot\nassess a rendered artefact from a description, and withholding it makes\nassessment harder rather than safer.",
      "cat-harness:refs": [
        "#178",
        "2026-09-16"
      ],
      "dcterms:date": [
        "2026-09-16"
      ]
    },
    {
      "@id": "sdlc/skills/sdlc-core/turn-reporting.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "The rules that make a report worth reading",
      "prov:value": "A repo-relative path is not\nclickable when the reader's working directory is not that repository, and a\nbranch link shows whatever was pushed since the reader was asked to look\n(issue #2405 FR-003, observed in the session that raised it).",
      "cat-harness:refs": [
        "#2405",
        "FR-003"
      ]
    },
