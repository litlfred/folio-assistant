      "@id": "sdlc/skills/sdlc-core/turn-reporting.md#provenance-7",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "The worked failure",
      "prov:value": "The old version of this rule capped entries at \"up to 50 words\", which read as a\nbudget to spend rather than a floor to clear and rewarded exactly that\nterseness."
    },
