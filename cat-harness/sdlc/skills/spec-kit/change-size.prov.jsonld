      "@id": "sdlc/skills/spec-kit/change-size.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Reporting Format (SC-005)",
      "prov:value": "Per **SC-005**, compliance metrics must always be reported as a **count with its denominator**, never as a bare percentage:\n- Correct: *\"4 of 32 PRs (12.5%) exceeded the advisory threshold.\"*\n- Incorrect: *\"12.5% of PRs exceeded the threshold.\"*",
      "cat-harness:refs": [
        "SC-005"
      ]
