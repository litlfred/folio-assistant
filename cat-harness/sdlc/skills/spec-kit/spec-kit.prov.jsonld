    {
      "@id": "sdlc/skills/spec-kit/spec-kit.md#provenance-16",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "What this platform refuses, with reasons",
      "prov:value": "**Not adopted.** A spec instance here is a\n  comment on its governing issue and goes nowhere near the knowledge graph, per\n  `where-a-proposal-goes` — the owner's standing rule of 2026-09-19, *\"do not\n  pollute the KG with SDLC churn\"*.",
      "cat-harness:refs": [
        "2026-09-19"
      ],
      "dcterms:date": [
        "2026-09-19"
      ]
    },
    {
      "@id": "sdlc/skills/spec-kit/spec-kit.md#provenance-17",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Against `crdm` — parallel, never blended",
      "prov:value": "The short form, in the owner's terms: **who is asking, and does the answer depend\non what a folio says?** Tool developer, content-agnostic → here."
    },
    {
      "@id": "sdlc/skills/spec-kit/spec-kit.md#provenance-18",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "Refusals",
      "prov:value": "- **Adjudicated status IS a sign-off, and it is recorded.** A spec reaches it\n  through the same adjudication the CRDM sign-off steps call — answers\n  `approve amend reject defer cancel` (code list `adjudication-requirement-set`)\n  — and the answer is written as a `requirement-signoff` attestation for the\n  spec's requirement set (issue #2405, FR-011/FR-013), never only stated in a\n  comment.",
      "cat-harness:refs": [
        "#2405",
        "FR-011",
        "FR-013"
      ]
    },
