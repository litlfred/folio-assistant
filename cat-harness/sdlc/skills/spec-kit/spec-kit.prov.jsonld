      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Applies when",
      "prov:value": "Owner, 2026-09-21: *\"spec-kit is specific to folio assistant feature\ndevelopment requests by tool developers not content developers (content\nagnostic, more scrum methodology process) for best practives of software\ndevelopment\"*.",
      "cat-harness:refs": [
        "2026-09-21"
      ],
      "dcterms:date": [
        "2026-09-21"
      ]
    },
    {
