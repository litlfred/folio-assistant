<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/0.1.0/processes/ns/"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns/"
                  id="Definitions_Process_RequirementsFiling"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:import namespace="https://litlfred.github.io/bootstrap/0.1.0/processes/ns/" location="https://litlfred.github.io/bootstrap/0.1.0/processes/ns.jsonld" importType="http://www.w3.org/ns/json-ld"/>
  <bpmn:resource id="authoring-agent" name="Authoring agent"/>
  <bpmn:resource id="business-analyst" name="Business analyst"/>
  <bpmn:collaboration id="Collaboration_Process_RequirementsFiling">
    <bpmn:participant id="Participant_Process_RequirementsFiling" name="Requirements filing: promote, organise, trace, supersede, or retire" processRef="Process_RequirementsFiling"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_RequirementsFiling" name="Requirements filing: promote, organise, trace, supersede, or retire" isExecutable="false">
    <bpmn:documentation>How a proposal in docs/proposals/&lt;slug&gt;.md is promoted into docs/requirements/&lt;slug&gt;.md when its feature ships, or how an existing filed requirement is amended in place, superseded by a new requirement (status: superseded + supersededBy: req:&lt;new-slug&gt;), or retired (status: retired) without deleting historical records. Every filed requirement keeps its flat path docs/requirements/&lt;slug&gt;.md (id: req:&lt;slug&gt;) and is organised in docs/requirements/index.md under its canonical concern group from code-lists/concern-group.json, verified by check:requirements, and signed off by the Business Analyst / Owner.</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="strict"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_RequirementsFiling">
      <bpmn:lane id="Lane_BA" name="BA / Feature Requestor" partitionElementRef="business-analyst">
        <bpmn:documentation>Reviews the filed requirement's normative statements, three-axis traceability links, concern-group placement in docs/requirements/index.md, and any supersession or retirement transition, issuing the human adjudication required before a RequirementSet reaches accepted.</bpmn:documentation>
        <bpmn:flowNodeRef>BA_ReviewFiling</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Authoring Agent" partitionElementRef="authoring-agent">
        <bpmn:documentation>Executes the deterministic filing steps under methodologies/requirements-filing-and-organisation.md: classifies the filing mode and concern group, promotes the proposal via git mv (preserving git blame and proposedIn), binds Requirement front matter and three-axis lineage, updates superseded or retired records in place, updates docs/requirements/index.md, runs check:requirements, and records the human sign-off attestation.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_Process_RequirementsFiling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ClassifyFiling</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_FilingMode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_PromoteOrUpdate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_BindFrontMatter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_UpdateLifecycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_UpdateIndex</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RunCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_CheckPassed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_RecordFilingSignoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_FilingAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RequirementFiled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_FilingHeld</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Process_RequirementsFiling" name="Feature ready to file or requirement lifecycle change requested"/>

    <bpmn:task id="A_ClassifyFiling" name="Classify filing mode,&#10;concern group, and&#10;req:&lt;slug&gt; ID">
      <bpmn:documentation>Determine whether this filing promotes a proposal from docs/proposals/&lt;slug&gt;.md (promote), amends an existing requirement or replaces it with a new requirement (amend-or-supersede), or retires an obsolete requirement (retire). Assign the primary semantic concern group from code-lists/concern-group.json (sdlc, process, tools, kg, library, content, ui, conduct) and verify that req:&lt;slug&gt; does not collide across docs/proposals/ and docs/requirements/.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="crdm-requirements-workflow"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_FilingMode" name="Which filing transition?">
      <bpmn:documentation>Branches on the kind of requirement filing transition: promoting a proposal from docs/proposals/&lt;slug&gt;.md (`promote`), amending an existing requirement or superseding an older requirement (`amend-or-supersede`), or retiring an obsolete requirement (`retire`).</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:judgement reason="Whether a change promotes a new proposal, amends an existing requirement in place, supersedes a prior requirement with a new contract, or retires an obsolete requirement is a scope judgement over the requirement's normative intent."/>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <bpmn:task id="A_PromoteOrUpdate" name="git mv proposal to&#10;docs/requirements/&lt;slug&gt;.md&#10;and record proposedIn">
      <bpmn:documentation>Record the last commit SHA touching docs/proposals/&lt;slug&gt;.md, execute `git mv docs/proposals/&lt;slug&gt;.md docs/requirements/&lt;slug&gt;.md` so git log --follow preserves the proposal's history, and record `proposedIn: { commit, path: "docs/proposals/&lt;slug&gt;.md" }` in the YAML front matter.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="crdm-requirements-workflow"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="A_BindFrontMatter" name="Bind Requirement&#10;front matter, statements,&#10;and 3-axis lineage">
      <bpmn:documentation>Author or update the YAML front matter conforming to bootstrap/schemas/requirement.schema.json: `id: req:&lt;slug&gt;`, `title`, `status`, `statements[]` (each with stable `#&lt;key&gt;`, RFC 2119 modality MUST/SHOULD/MAY, normative statement, and measurable successCriteria), backward lineage (`proposedIn`, `derivedFrom`), horizontal dependencies (`dependsOn`), and forward links (`beans`, `skills`, `processes`).</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="specification-management"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="A_UpdateLifecycle" name="Mark the record superseded or retired">
      <bpmn:documentation>Never delete (`git rm`) a superseded or retired requirement. When superseding `req:&lt;old-slug&gt;`, set `status: superseded` and `supersededBy: req:&lt;new-slug&gt;` on `docs/requirements/&lt;old-slug&gt;.md`. When retiring, set `status: retired` and document the retirement reason and authorising issue in prose. Update any `RequirementSet` (`docs/requirements/*.set.json`) so approved/accepted sets hold only `in-force` members.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="specification-management"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="A_UpdateIndex" name="Organise entry in&#10;docs/requirements/index.md&#10;by concern group &amp; status">
      <bpmn:documentation>Add or update the requirement's row in `docs/requirements/index.md` under its canonical concern group (`sdlc`, `process`, `tools`, `kg`, `library`, `content`, `ui`, `conduct` from `code-lists/concern-group.json`) for `in-force` requirements, or move it to the Superseded and Retired Requirements table when superseded or retired.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="crdm-requirements-workflow"/>
      </bpmn:extensionElements>
    </bpmn:task>

    <bpmn:serviceTask id="A_RunCheck" name="Run the requirements check">
      <bpmn:documentation>Run `bun run cat check:requirements` to verify schema conformance (`bootstrap/schemas/requirement.schema.json`), slug uniqueness across `docs/proposals/` and `docs/requirements/`, acyclicity of `derivedFrom`, existence of all referenced `derivedFrom` / `dependsOn` / `supersededBy` / `skills` / `processes` targets, and `RequirementSet` sign-off invariants.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="specification-management"/>
        <cat-harness.processes:policy relaxable="false"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_CheckPassed" name="check:requirements&#10;clean?">
      <bpmn:documentation>Branches on the exit code of `bun run cat check:requirements`: any schema violation, slug collision, cycle in `derivedFrom`, or unresolved reference loops back to `A_BindFrontMatter` before human review.</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:judgement reason="Determined directly from the deterministic pass/fail exit code of `bun run cat check:requirements`."/>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <bpmn:callActivity id="BA_ReviewFiling" name="Review the filed requirement, sign off" calledElement="Process_Adjudication">
      <bpmn:documentation>The Business Analyst / Owner reviews the filed requirement in `docs/requirements/&lt;slug&gt;.md`, its concern-group organisation in `docs/requirements/index.md`, its three-axis traceability, and any supersession or retirement update, deciding `approve`, `amend`, `reject`, `defer`, or `cancel`.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="adjudication"/>
        <cat-harness.processes:adjudication codes="approve amend reject defer cancel" list="adjudication-requirement-set"/>
        <cat-harness.processes:fulfilment kinds="person" reason="Accepting, amending, superseding, or retiring a requirement in `docs/requirements/` is a human governance decision (issue #2405 FR-011); `check:requirements` refuses an `approved` or `accepted` RequirementSet without a human sign-off attestation."/>
      </bpmn:extensionElements>
    </bpmn:callActivity>

    <bpmn:serviceTask id="A_RecordFilingSignoff" name="Record the sign-off and set the stage">
      <bpmn:documentation>Append the human sign-off decision to `test/attestations/requirement-signoff/&lt;set-slug&gt;.attestations.json` (recording who, at, scope, outcome, stage, reason, and issue comment permalink) and update the `RequirementSet` stage to match.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="adjudication"/>
        <cat-harness.processes:policy relaxable="false"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="GW_FilingAccepted" name="Filing accepted?">
      <bpmn:documentation>Routes on the recorded `requirement-signoff` outcome from `BA_ReviewFiling`: `approve` or `amend` completes the filing; `reject`, `defer`, or `cancel` holds the filing with its recorded reason.</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:judgement reason="Routes on the human adjudication code recorded in `A_RecordFilingSignoff` (`approve`/`amend` vs `reject`/`defer`/`cancel`)."/>
      </bpmn:extensionElements>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="End_RequirementFiled" name="Requirement filed and organised in docs/requirements/"/>
    <bpmn:endEvent id="End_FilingHeld" name="Filing held or deferred — recorded with reason"/>

    <bpmn:sequenceFlow id="SF_RF_1" sourceRef="Start_Process_RequirementsFiling" targetRef="A_ClassifyFiling"/>
    <bpmn:sequenceFlow id="SF_RF_2" sourceRef="A_ClassifyFiling" targetRef="GW_FilingMode"/>
    <bpmn:sequenceFlow id="SF_RF_Promote" name="promote" sourceRef="GW_FilingMode" targetRef="A_PromoteOrUpdate"/>
    <bpmn:sequenceFlow id="SF_RF_Amend" name="amend-or-supersede" sourceRef="GW_FilingMode" targetRef="A_BindFrontMatter"/>
    <bpmn:sequenceFlow id="SF_RF_Retire" name="retire" sourceRef="GW_FilingMode" targetRef="A_UpdateLifecycle"/>
    <bpmn:sequenceFlow id="SF_RF_3" sourceRef="A_PromoteOrUpdate" targetRef="A_BindFrontMatter"/>
    <bpmn:sequenceFlow id="SF_RF_4" sourceRef="A_BindFrontMatter" targetRef="A_UpdateLifecycle"/>
    <bpmn:sequenceFlow id="SF_RF_5" sourceRef="A_UpdateLifecycle" targetRef="A_UpdateIndex"/>
    <bpmn:sequenceFlow id="SF_RF_6" sourceRef="A_UpdateIndex" targetRef="A_RunCheck"/>
    <bpmn:sequenceFlow id="SF_RF_7" sourceRef="A_RunCheck" targetRef="GW_CheckPassed"/>
    <bpmn:sequenceFlow id="SF_RF_CheckFail" name="fail" sourceRef="GW_CheckPassed" targetRef="A_BindFrontMatter"/>
    <bpmn:sequenceFlow id="SF_RF_CheckPass" name="pass" sourceRef="GW_CheckPassed" targetRef="BA_ReviewFiling"/>
    <bpmn:sequenceFlow id="SF_RF_8" sourceRef="BA_ReviewFiling" targetRef="A_RecordFilingSignoff"/>
    <bpmn:sequenceFlow id="SF_RF_9" sourceRef="A_RecordFilingSignoff" targetRef="GW_FilingAccepted"/>
    <bpmn:sequenceFlow id="SF_RF_Approved" name="approve / amend" sourceRef="GW_FilingAccepted" targetRef="End_RequirementFiled"/>
    <bpmn:sequenceFlow id="SF_RF_Held" name="reject / defer / cancel" sourceRef="GW_FilingAccepted" targetRef="End_FilingHeld"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_Process_RequirementsFiling">
    <bpmndi:BPMNPlane id="Plane_Process_RequirementsFiling" bpmnElement="Collaboration_Process_RequirementsFiling">
      <bpmndi:BPMNShape id="Shape_Participant_Process_RequirementsFiling" bpmnElement="Participant_Process_RequirementsFiling" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1360" height="530" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_BA_Process_RequirementsFiling" bpmnElement="Lane_BA" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1330" height="170" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Agent_Process_RequirementsFiling" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="250" width="1330" height="360" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_Process_RequirementsFiling" bpmnElement="Start_Process_RequirementsFiling">
        <dc:Bounds x="240" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="218.97" y="361.5" width="110.06" height="90" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ClassifyFiling" bpmnElement="A_ClassifyFiling">
        <dc:Bounds x="340" y="280" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_FilingMode" bpmnElement="GW_FilingMode" isMarkerVisible="true">
        <dc:Bounds x="515" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="480" y="268" width="120" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_PromoteOrUpdate" bpmnElement="A_PromoteOrUpdate">
        <dc:Bounds x="620" y="420" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_BindFrontMatter" bpmnElement="A_BindFrontMatter">
        <dc:Bounds x="645" y="280" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_UpdateLifecycle" bpmnElement="A_UpdateLifecycle">
        <dc:Bounds x="810" y="280" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_UpdateIndex" bpmnElement="A_UpdateIndex">
        <dc:Bounds x="970" y="280" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_RunCheck" bpmnElement="A_RunCheck">
        <dc:Bounds x="970" y="440" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_CheckPassed" bpmnElement="GW_CheckPassed" isMarkerVisible="true">
        <dc:Bounds x="1135" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1166" y="404" width="112" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_BA_ReviewFiling" bpmnElement="BA_ReviewFiling">
        <dc:Bounds x="1112" y="105" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_RecordFilingSignoff" bpmnElement="A_RecordFilingSignoff">
        <dc:Bounds x="1225" y="280" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_FilingAccepted" bpmnElement="GW_FilingAccepted" isMarkerVisible="true">
        <dc:Bounds x="1260" y="455" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1162" y="462" width="90" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_RequirementFiled" bpmnElement="End_RequirementFiled">
        <dc:Bounds x="1395" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1355.62" y="451.5" width="146.77" height="54" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_FilingHeld" bpmnElement="End_FilingHeld">
        <dc:Bounds x="1395" y="517" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1365" y="556" width="140" height="48" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_SF_RF_1" bpmnElement="SF_RF_1">
        <di:waypoint x="276" y="340" />
        <di:waypoint x="340" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_2" bpmnElement="SF_RF_2">
        <di:waypoint x="460" y="340" />
        <di:waypoint x="515" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_Promote" bpmnElement="SF_RF_Promote">
        <di:waypoint x="540" y="365" />
        <di:waypoint x="540" y="480" />
        <di:waypoint x="620" y="480" />
        <bpmndi:BPMNLabel><dc:Bounds x="472" y="410" width="60" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_Amend" bpmnElement="SF_RF_Amend">
        <di:waypoint x="565" y="340" />
        <di:waypoint x="645" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="566" y="346" width="76" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_Retire" bpmnElement="SF_RF_Retire">
        <di:waypoint x="540" y="365" />
        <di:waypoint x="540" y="555" />
        <di:waypoint x="870" y="555" />
        <di:waypoint x="870" y="400" />
        <bpmndi:BPMNLabel><dc:Bounds x="548" y="532" width="50" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_3" bpmnElement="SF_RF_3">
        <di:waypoint x="705" y="420" />
        <di:waypoint x="705" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_4" bpmnElement="SF_RF_4">
        <di:waypoint x="765" y="340" />
        <di:waypoint x="810" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_5" bpmnElement="SF_RF_5">
        <di:waypoint x="930" y="340" />
        <di:waypoint x="970" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_6" bpmnElement="SF_RF_6">
        <di:waypoint x="1030" y="400" />
        <di:waypoint x="1030" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_7" bpmnElement="SF_RF_7">
        <di:waypoint x="1090" y="500" />
        <di:waypoint x="1160" y="500" />
        <di:waypoint x="1160" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_CheckFail" bpmnElement="SF_RF_CheckFail">
        <di:waypoint x="1148" y="315" />
        <di:waypoint x="1148" y="262" />
        <di:waypoint x="705" y="262" />
        <di:waypoint x="705" y="280" />
        <bpmndi:BPMNLabel><dc:Bounds x="1105" y="266" width="35" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_CheckPass" bpmnElement="SF_RF_CheckPass">
        <di:waypoint x="1172" y="315" />
        <di:waypoint x="1172" y="225" />
        <bpmndi:BPMNLabel><dc:Bounds x="1178" y="266" width="40" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_8" bpmnElement="SF_RF_8">
        <di:waypoint x="1232" y="165" />
        <di:waypoint x="1285" y="165" />
        <di:waypoint x="1285" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_9" bpmnElement="SF_RF_9">
        <di:waypoint x="1285" y="400" />
        <di:waypoint x="1285" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_Approved" bpmnElement="SF_RF_Approved">
        <di:waypoint x="1310" y="480" />
        <di:waypoint x="1350" y="480" />
        <di:waypoint x="1350" y="430" />
        <di:waypoint x="1395" y="430" />
        <bpmndi:BPMNLabel><dc:Bounds x="1346.67" y="373.5" width="110" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RF_Held" bpmnElement="SF_RF_Held">
        <di:waypoint x="1285" y="505" />
        <di:waypoint x="1285" y="535" />
        <di:waypoint x="1395" y="535" />
        <bpmndi:BPMNLabel><dc:Bounds x="1235" y="542" width="120" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
