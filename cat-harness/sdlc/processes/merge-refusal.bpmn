        <dc:Bounds x="425" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="405" y="200" width="90" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_BeanNotYours_di" bpmnElement="End_BeanNotYours">
        <dc:Bounds x="432" y="365" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="405" y="407" width="90" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Record" bpmnElement="Task_Record">
        <dc:Bounds x="530" y="205" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Comment" bpmnElement="Task_Comment">
        <dc:Bounds x="530" y="365" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Owner" bpmnElement="GW_Owner" isMarkerVisible="true">
        <dc:Bounds x="675" y="400" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="655" y="456" width="90" height="54" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_HandBack" bpmnElement="Task_HandBack">
        <dc:Bounds x="760" y="205" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Fix" bpmnElement="Task_Fix">
        <dc:Bounds x="760" y="48" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_FailCond" bpmnElement="GW_FailCond" isMarkerVisible="true">
        <dc:Bounds x="905" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="888" y="355" width="120" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Retrain" bpmnElement="Task_Retrain">
        <dc:Bounds x="995" y="205" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Fate" bpmnElement="GW_Fate" isMarkerVisible="true">
        <dc:Bounds x="1140" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1176" y="202" width="66" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Close" bpmnElement="Task_Close">
        <dc:Bounds x="1250" y="205" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Scrap" bpmnElement="Task_Scrap">
        <dc:Bounds x="1105" y="365" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_BeanClose_2_di" bpmnElement="Call_BeanClose_2">
        <dc:Bounds x="1250" y="365" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_BeanClosedHow" bpmnElement="GW_BeanClosedHow" isMarkerVisible="true">
        <dc:Bounds x="1400" y="355" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1434" y="268" width="115" height="22" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Closed" bpmnElement="End_Closed">
        <dc:Bounds x="1500" y="207" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1488" y="248" width="60" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_AwaitOwner" bpmnElement="End_AwaitOwner">
        <dc:Bounds x="1500" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1436" y="316" width="118" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Scrapped" bpmnElement="End_Scrapped">
        <dc:Bounds x="1500" y="467" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1436" y="508" width="118" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Dispatch" bpmnElement="Task_Dispatch">
        <dc:Bounds x="760" y="365" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AgentFix" bpmnElement="Task_AgentFix">
        <dc:Bounds x="760" y="575" width="120" height="120" />
