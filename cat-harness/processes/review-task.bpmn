<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:folio="https://litlfred.github.io/folio-assistant/bpmn"
                  id="Definitions_ReviewTask"
                  targetNamespace="http://folio-assistant.dev/bpmn/review">

  <!-- ═══════════════════════════════════════════════════════════
       Review task — the GENERIC entry, and the reason the two
       specialisms are subprocesses rather than inherited skills.

       ROLES COMPOSE TWO WAYS AND THEY ARE NOT THE SAME THING
       (skills/folio-core/role-model.md):

         `inherits` is IS-A and STATIC. `qc-reviewer inherits reviewer`
         carries the reviewer's skills everywhere, always.

         The SUBPROCESS STACK is SCOPED. Descending into a called process,
         the actor keeps the outer role AND takes on the inner lane's, and
         the skills are the union ALONG THAT CALL PATH ONLY.

       Review is the case that needs the second. A generic reviewer that
       statically inherited both specialisms would carry the Tool and schema
       skills while reading prose, and the voice and translation skills while
       reading a schema — a closure so broad that `role-carries-activity-skill`
       could never fail, which is the audit going quiet rather than passing.

       So: this lane classifies WHAT CHANGED and descends. A change that is
       both prose and code visits both subprocesses; the actor is a narrative
       reviewer for one call and a code reviewer for the other, and neither
       role widens the other.
       ═══════════════════════════════════════════════════════════ -->

  <bpmn:process id="Process_Review" name="Review task" isExecutable="false">

    <bpmn:laneSet id="LaneSet_Review">
      <bpmn:lane id="Lane_Reviewer" name="Reviewer / SME">
        <bpmn:documentation>Makes exactly one decision on its own — what changed, at Task_ClassifyChange — and for everything after that descends into a subprocess, taking on the narrative- or code-reviewer role for that call path only rather than carrying both statically. A change that is both visits both subprocesses in turn, and neither role widens the other.</bpmn:documentation>
        <bpmn:flowNodeRef>Start_ChangeToReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Kind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_NarrativeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_CodeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Consolidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Reviewed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_EditorDecides" name="Editors + authoring agents">
        <bpmn:documentation>Kept a separate lane on purpose, holding the one activity this diagram gives it: the reviewer who classified and judged the change is never the party that accepts it, so consolidated findings cross a lane boundary before anything is decided on them.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_EditorDecides</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_ChangeToReview" name="Change&#10;to review"/>

    <bpmn:task id="Task_ClassifyChange" name="Classify what changed">
      <bpmn:documentation>
        Prose, code nodes, or both. This is the only decision the generic lane
        makes on its own: everything after it is made inside a subprocess by
        the role that lane binds.
      </bpmn:documentation>
      <bpmn:extensionElements><folio:skill ref="semantic-review-scoping"/></bpmn:extensionElements>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_Kind" name="Prose, code,&#10;or both?"/>

    <bpmn:callActivity id="Call_NarrativeReview" name="Narrative review" calledElement="Process_NarrativeReview">
      <bpmn:documentation>
        Descend into Process_NarrativeReview. The actor takes on the
        `narrative-reviewer` lane for this call path only.
      </bpmn:documentation>
    </bpmn:callActivity>

    <bpmn:callActivity id="Call_CodeReview" name="Code node review" calledElement="Process_CodeReview">
      <bpmn:documentation>
        Descend into Process_CodeReview. The actor takes on the `code-reviewer`
        lane for this call path only.
      </bpmn:documentation>
    </bpmn:callActivity>

    <bpmn:exclusiveGateway id="GW_Join"/>

    <bpmn:task id="Task_Consolidate" name="Consolidate findings">
      <bpmn:documentation>
        One report from however many subprocesses ran. Findings are advice: a
        reviewer cannot accept the change.
      </bpmn:documentation>
      <bpmn:extensionElements><folio:skill ref="content-review"/></bpmn:extensionElements>
    </bpmn:task>

    <bpmn:task id="Task_EditorDecides" name="Accept, or send back">
      <bpmn:documentation>
        The editor's lane, kept separate on purpose: the reviewer who judged the
        change is not the position that accepts it.
      </bpmn:documentation>
      <bpmn:extensionElements><folio:skill ref="content-validate"/></bpmn:extensionElements>
    </bpmn:task>

    <bpmn:endEvent id="End_Reviewed" name="Decision&#10;recorded"/>

    <bpmn:sequenceFlow id="F_R1" sourceRef="Start_ChangeToReview" targetRef="Task_ClassifyChange"/>
    <bpmn:sequenceFlow id="F_R2" sourceRef="Task_ClassifyChange" targetRef="GW_Kind"/>
    <bpmn:sequenceFlow id="F_R3" name="prose" sourceRef="GW_Kind" targetRef="Call_NarrativeReview"/>
    <bpmn:sequenceFlow id="F_R4" name="code nodes" sourceRef="GW_Kind" targetRef="Call_CodeReview"/>
    <bpmn:sequenceFlow id="F_R5" sourceRef="Call_NarrativeReview" targetRef="GW_Join"/>
    <bpmn:sequenceFlow id="F_R6" sourceRef="Call_CodeReview" targetRef="GW_Join"/>
    <bpmn:sequenceFlow id="F_R7" sourceRef="GW_Join" targetRef="Task_Consolidate"/>
    <bpmn:sequenceFlow id="F_R8" sourceRef="Task_Consolidate" targetRef="Task_EditorDecides"/>
    <bpmn:sequenceFlow id="F_R9" sourceRef="Task_EditorDecides" targetRef="End_Reviewed"/>

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_ReviewTask">
    <bpmndi:BPMNPlane id="Plane_ReviewTask" bpmnElement="Process_Review">
      <bpmndi:BPMNShape id="S_Lane_Reviewer" bpmnElement="Lane_Reviewer" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1240" height="280"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Lane_EditorDecides" bpmnElement="Lane_EditorDecides" isHorizontal="true">
        <dc:Bounds x="160" y="360" width="1240" height="140"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Start_ChangeToReview" bpmnElement="Start_ChangeToReview">
        <dc:Bounds x="200" y="202" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_ClassifyChange" bpmnElement="Task_ClassifyChange">
        <dc:Bounds x="280" y="180" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_Kind" bpmnElement="GW_Kind" isMarkerVisible="true">
        <dc:Bounds x="480" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Call_NarrativeReview" bpmnElement="Call_NarrativeReview">
        <dc:Bounds x="590" y="110" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Call_CodeReview" bpmnElement="Call_CodeReview">
        <dc:Bounds x="590" y="250" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_GW_Join" bpmnElement="GW_Join" isMarkerVisible="true">
        <dc:Bounds x="830" y="195" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_Consolidate" bpmnElement="Task_Consolidate">
        <dc:Bounds x="930" y="180" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Task_EditorDecides" bpmnElement="Task_EditorDecides">
        <dc:Bounds x="930" y="390" width="160" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_End_Reviewed" bpmnElement="End_Reviewed">
        <dc:Bounds x="1180" y="412" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="E_F_R1" bpmnElement="F_R1">
        <di:waypoint x="236" y="220"/><di:waypoint x="280" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_R2" bpmnElement="F_R2">
        <di:waypoint x="440" y="220"/><di:waypoint x="480" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_R3" bpmnElement="F_R3">
        <di:waypoint x="505" y="195"/><di:waypoint x="505" y="150"/><di:waypoint x="590" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_R4" bpmnElement="F_R4">
        <di:waypoint x="505" y="245"/><di:waypoint x="505" y="290"/><di:waypoint x="590" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_R5" bpmnElement="F_R5">
        <di:waypoint x="770" y="150"/><di:waypoint x="855" y="150"/><di:waypoint x="855" y="195"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_R6" bpmnElement="F_R6">
        <di:waypoint x="770" y="290"/><di:waypoint x="855" y="290"/><di:waypoint x="855" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_R7" bpmnElement="F_R7">
        <di:waypoint x="880" y="220"/><di:waypoint x="930" y="220"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_R8" bpmnElement="F_R8">
        <di:waypoint x="1010" y="260"/><di:waypoint x="1010" y="390"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="E_F_R9" bpmnElement="F_R9">
        <di:waypoint x="1090" y="430"/><di:waypoint x="1180" y="430"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
