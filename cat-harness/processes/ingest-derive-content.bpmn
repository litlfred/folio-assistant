<?xml version="1.0" encoding="UTF-8"?>
<!--
  folio-assistant — Ingestion subprocess — derive content from the assets.

  Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
  BPMN 2.0 tool. The SVG under docs/assets/img/workflows/ is generated from it
  by `bun run render:bpmn` — never hand-edit the SVG.

  The <folio:skill> extension on an activity names the folio-assistant skill
  that implements it; <folio:bean> marks a step that reads or writes the shared
  work plan in beans/.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:folio="https://litlfred.github.io/folio-assistant/bpmn"
                  id="Definitions_DeriveContent"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:collaboration id="Collaboration_DeriveContent">
    <bpmn:participant id="Participant_DeriveContent" name="Ingestion subprocess — derive content from the assets" processRef="Process_DeriveContent" />
  </bpmn:collaboration>
  <bpmn:process id="Process_DeriveContent" name="Ingestion subprocess — derive content from the assets" isExecutable="false">
    <bpmn:documentation>folio-assistant — Ingestion subprocess — derive content from the assets.

  Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
  BPMN 2.0 tool. The SVG under docs/assets/img/workflows/ is generated from it
  by `bun run render:bpmn` — never hand-edit the SVG.

  The &lt;folio:skill&gt; extension on an activity names the folio-assistant skill
  that implements it; &lt;folio:bean&gt; marks a step that reads or writes the shared
  work plan in beans/.</bpmn:documentation>
    <bpmn:extensionElements>
      <folio:policy enforcement="advisory" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="Process_DeriveContent_LaneSet">
      <bpmn:lane id="Lane_0" name="Ingestion Engine (agent, runs unattended)">
        <bpmn:documentation>The only lane in this subprocess, so nothing produced here is checked by a different party before it reaches the L1 graph. Five of these six tasks carry their own NOT IMPLEMENTED note; Task_Provenance does not, and its citation of who or what wrote each narrative is what is meant to stand between a generated description and its being treated as source material.</bpmn:documentation>
        <bpmn:extensionElements><folio:role ref="ingestion-agent"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>StartEvent_Assets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Fan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Archive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TechMeta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Image</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Audio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Tabular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Provenance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Derived</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Assets" name="Assets in hand">
      <bpmn:outgoing>Flow_d1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Fan" name="Per asset kind">
      <bpmn:incoming>Flow_d1</bpmn:incoming>
      <bpmn:outgoing>Flow_d2</bpmn:outgoing>
      <bpmn:outgoing>Flow_d3</bpmn:outgoing>
      <bpmn:outgoing>Flow_d4</bpmn:outgoing>
      <bpmn:outgoing>Flow_d5</bpmn:outgoing>
      <bpmn:outgoing>Flow_d6</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Archive" name="Archive → greppable
contents manifest">
      <bpmn:extensionElements>
        <folio:skill ref="document-intake"/>
      </bpmn:extensionElements>

      <bpmn:documentation>NOT IMPLEMENTED. Tracked as a bean; see docs/document-ingestion.md. Tar/zip is opaque to every grep in the corpus until its contents are listed as data.</bpmn:documentation>
      <bpmn:incoming>Flow_d2</bpmn:incoming>
      <bpmn:outgoing>Flow_d7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_TechMeta" name="File info, sizes, hashes,
timestamps, mimetype">
      <bpmn:extensionElements>
        <folio:skill ref="document-intake"/>
      </bpmn:extensionElements>

      <bpmn:documentation>NOT IMPLEMENTED. Tracked as a bean; see docs/document-ingestion.md. Mechanical and cheap; the checksum is what makes a remote asset verifiable.</bpmn:documentation>
      <bpmn:incoming>Flow_d3</bpmn:incoming>
      <bpmn:outgoing>Flow_d8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Image" name="Narrative description
per image, localized">
      <bpmn:extensionElements>
        <folio:skill ref="document-intake"/>
      </bpmn:extensionElements>

      <bpmn:documentation>NOT IMPLEMENTED. Tracked as a bean; see docs/document-ingestion.md. Applies equally to an image EXTRACTED FROM A PDF, not only to an uploaded one.</bpmn:documentation>
      <bpmn:incoming>Flow_d4</bpmn:incoming>
      <bpmn:outgoing>Flow_d9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Audio" name="Transcribe and
translate audio">
      <bpmn:extensionElements>
        <folio:skill ref="document-intake"/>
      </bpmn:extensionElements>

      <bpmn:documentation>NOT IMPLEMENTED. Tracked as a bean; see docs/document-ingestion.md.</bpmn:documentation>
      <bpmn:incoming>Flow_d5</bpmn:incoming>
      <bpmn:outgoing>Flow_d10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Tabular" name="Sheet names, headers,
shape, narrative">
      <bpmn:extensionElements>
        <folio:skill ref="document-intake"/>
      </bpmn:extensionElements>

      <bpmn:documentation>NOT IMPLEMENTED. Tracked as a bean; see docs/document-ingestion.md. CSV and spreadsheet: tabs, column and row headers, sizes, and what the dataset is about.</bpmn:documentation>
      <bpmn:incoming>Flow_d6</bpmn:incoming>
      <bpmn:outgoing>Flow_d11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_Join" name="All kinds done">
      <bpmn:incoming>Flow_d7</bpmn:incoming>
      <bpmn:incoming>Flow_d8</bpmn:incoming>
      <bpmn:incoming>Flow_d9</bpmn:incoming>
      <bpmn:incoming>Flow_d10</bpmn:incoming>
      <bpmn:incoming>Flow_d11</bpmn:incoming>
      <bpmn:outgoing>Flow_d12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_Provenance" name="Cite the author of
every narrative">
      <bpmn:extensionElements>
        <folio:skill ref="document-intake"/>
      </bpmn:extensionElements>

      <bpmn:documentation>A generated description is a claim by someone. Record whether a human or an agent wrote it, and for an agent the model version. An uncited narrative is indistinguishable from a transcription of the source.</bpmn:documentation>
      <bpmn:incoming>Flow_d12</bpmn:incoming>
      <bpmn:outgoing>Flow_d13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Derived" name="Derived">
      <bpmn:incoming>Flow_d13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_d1" sourceRef="StartEvent_Assets" targetRef="Gateway_Fan" />
    <bpmn:sequenceFlow id="Flow_d2" sourceRef="Gateway_Fan" targetRef="Task_Archive" />
    <bpmn:sequenceFlow id="Flow_d3" sourceRef="Gateway_Fan" targetRef="Task_TechMeta" />
    <bpmn:sequenceFlow id="Flow_d4" sourceRef="Gateway_Fan" targetRef="Task_Image" />
    <bpmn:sequenceFlow id="Flow_d5" sourceRef="Gateway_Fan" targetRef="Task_Audio" />
    <bpmn:sequenceFlow id="Flow_d6" sourceRef="Gateway_Fan" targetRef="Task_Tabular" />
    <bpmn:sequenceFlow id="Flow_d7" sourceRef="Task_Archive" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_d8" sourceRef="Task_TechMeta" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_d9" sourceRef="Task_Image" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_d10" sourceRef="Task_Audio" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_d11" sourceRef="Task_Tabular" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_d12" sourceRef="Gateway_Join" targetRef="Task_Provenance" />
    <bpmn:sequenceFlow id="Flow_d13" sourceRef="Task_Provenance" targetRef="EndEvent_Derived" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_DeriveContent">
    <bpmndi:BPMNPlane id="Plane_DeriveContent" bpmnElement="Collaboration_DeriveContent">
      <bpmndi:BPMNShape id="Participant_DeriveContent_di" bpmnElement="Participant_DeriveContent" isHorizontal="true"><dc:Bounds x="160" y="80" width="1260" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="190" y="80" width="1230" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Assets_di" bpmnElement="StartEvent_Assets"><dc:Bounds x="277" y="152" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Fan_di" bpmnElement="Gateway_Fan"><dc:Bounds x="460" y="145" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Archive_di" bpmnElement="Task_Archive"><dc:Bounds x="600" y="0" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TechMeta_di" bpmnElement="Task_TechMeta"><dc:Bounds x="600" y="65" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Image_di" bpmnElement="Task_Image"><dc:Bounds x="600" y="130" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Audio_di" bpmnElement="Task_Audio"><dc:Bounds x="600" y="195" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Tabular_di" bpmnElement="Task_Tabular"><dc:Bounds x="600" y="260" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join"><dc:Bounds x="840" y="145" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Provenance_di" bpmnElement="Task_Provenance"><dc:Bounds x="980" y="130" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Derived_di" bpmnElement="EndEvent_Derived"><dc:Bounds x="1227" y="152" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_d1_di" bpmnElement="Flow_d1"><di:waypoint x="313" y="170" /><di:waypoint x="460" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d2_di" bpmnElement="Flow_d2"><di:waypoint x="510" y="170" /><di:waypoint x="570" y="170" /><di:waypoint x="570" y="40" /><di:waypoint x="600" y="40" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d3_di" bpmnElement="Flow_d3"><di:waypoint x="510" y="170" /><di:waypoint x="570" y="170" /><di:waypoint x="570" y="105" /><di:waypoint x="600" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d4_di" bpmnElement="Flow_d4"><di:waypoint x="510" y="170" /><di:waypoint x="600" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d5_di" bpmnElement="Flow_d5"><di:waypoint x="510" y="170" /><di:waypoint x="570" y="170" /><di:waypoint x="570" y="235" /><di:waypoint x="600" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d6_di" bpmnElement="Flow_d6"><di:waypoint x="510" y="170" /><di:waypoint x="570" y="170" /><di:waypoint x="570" y="300" /><di:waypoint x="600" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d7_di" bpmnElement="Flow_d7"><di:waypoint x="750" y="40" /><di:waypoint x="810" y="40" /><di:waypoint x="810" y="170" /><di:waypoint x="840" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d8_di" bpmnElement="Flow_d8"><di:waypoint x="750" y="105" /><di:waypoint x="810" y="105" /><di:waypoint x="810" y="170" /><di:waypoint x="840" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d9_di" bpmnElement="Flow_d9"><di:waypoint x="750" y="170" /><di:waypoint x="840" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d10_di" bpmnElement="Flow_d10"><di:waypoint x="750" y="235" /><di:waypoint x="810" y="235" /><di:waypoint x="810" y="170" /><di:waypoint x="840" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d11_di" bpmnElement="Flow_d11"><di:waypoint x="750" y="300" /><di:waypoint x="810" y="300" /><di:waypoint x="810" y="170" /><di:waypoint x="840" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d12_di" bpmnElement="Flow_d12"><di:waypoint x="890" y="170" /><di:waypoint x="980" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_d13_di" bpmnElement="Flow_d13"><di:waypoint x="1130" y="170" /><di:waypoint x="1227" y="170" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
