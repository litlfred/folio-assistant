    {
      "@id": "processes/ui/staging-render-log.bpmn#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "process Process_RenderLog",
      "prov:value": "Bean `plj1` is why it is needed — a full-replace deploy silently deleted every open PR's preview, for months, and the publish branch kept no record of its own changes. The publish branch has several publishers and one of them replaces the whole branch, which is why a removed preview needs a record of its own.",
      "cat-harness:refs": [
        "bean plj1"
      ]
    },
    {
      "@id": "processes/ui/staging-render-log.bpmn#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "task A_Preflight",
      "prov:value": "`previewLiveness` — a disjunction over open-pr, unmerged-branch and recent-commit, shared with the health sweep so the two cannot disagree. Bean `w2g5`: a preview whose pull request is closed is NOT an abandoned one.",
      "cat-harness:refs": [
        "bean w2g5"
      ]
    },
    {
      "@id": "processes/ui/staging-render-log.bpmn#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "task A_LogRestored",
      "prov:value": "Its own event rather than a second `rendered`, because \"somebody pushed this branch\" and \"an unrelated merge nearly deleted it\" are different facts — and bean `plj1` is what happens when the second is invisible.",
      "cat-harness:refs": [
        "bean plj1"
      ]
    }
  ]
}
