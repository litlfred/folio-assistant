    {
      "@id": "processes/ui/wireframe-design-review.bpmn#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "callActivity Call_Adjudicate",
      "prov:value": "FOR THIS CALLER THE SPLIT WAS A REGRESSION, not a fix, and that is worth keeping because the PR that made it said the opposite. When `bvuk` moved the outcome half out of `adjudication.bpmn`, #1074 reported that all four remaining callers \"no longer reach A_ScopeCriterion or A_Dispensation\" and framed it as the intended effect. True for three of them, whose question never admitted those steps. Here it removed the two steps the sentence above already documents, so the call was left pointing at a shared judgement that no longer runs either. Repointing restores what the documentation always claimed rather than changing it.",
      "cat-harness:refs": [
        "#1074"
      ]
    }
  ]
