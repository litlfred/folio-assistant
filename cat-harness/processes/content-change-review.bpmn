      </bpmndi:BPMNShape>

      <!-- Edges -->
      <bpmndi:BPMNShape id="Task_WatchBranchCI_di" bpmnElement="Task_WatchBranchCI">
        <dc:Bounds x="2510" y="740" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WatchMainCI_di" bpmnElement="Task_WatchMainCI">
        <dc:Bounds x="5840" y="740" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="276" y="180" />
        <di:waypoint x="330" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="470" y="180" />
        <di:waypoint x="548" y="180" />
        <di:waypoint x="548" y="362" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a1_di" bpmnElement="a1">
        <di:waypoint x="566" y="380" />
        <di:waypoint x="620" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="a2_di" bpmnElement="a2">
        <di:waypoint x="760" y="380" />
        <di:waypoint x="820" y="380" />
