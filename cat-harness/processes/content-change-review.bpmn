          <dc:Bounds x="5454" y="836" width="150" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Pipeline_di" bpmnElement="End_Pipeline">
        <dc:Bounds x="6040" y="762" width="36" height="36" />
