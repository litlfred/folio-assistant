    {
      "@id": "processes/content/voice-review.bpmn#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "comment before Process_VoiceReview",
      "prov:value": "Issue #208 asks for the voice review to be part of the \"one voice\" review rather than beside it, and this is where that lands: the narrative reviewer descends here after adjudicating the base house voice, and takes on no new role — the same `narrative-reviewer` lane owns both halves, because a voice is a REGISTER and register is what that lane already judges.",
      "cat-harness:refs": [
        "#208"
      ]
    },
    {
      "@id": "processes/content/voice-review.bpmn#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "comment before Process_VoiceReview",
      "prov:value": "A folio that has activated no voice must leave immediately, and this diagram says so structurally rather than leaving it to a reviewer's discretion. Issue #208: \"we shouldnt autmoatically apply voices … the folio-asst's own docuemtnation conent doesnt have any voice\". An unasked-for voice produces confident findings against prose that was never written to it.",
      "cat-harness:refs": [
        "#208"
      ]
    },
    {
      "@id": "processes/content/voice-review.bpmn#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "task Task_RuleIsWrong",
      "prov:value": "A rule its own quote does not support is a finding against the voice, not against the block. Measured precedent: `voice-editorializing` flags \"clearly\", and the exemplar the Milnor gate is named after uses it fourteen times as proof economy (bean `2t41`).",
      "cat-harness:refs": [
        "bean 2t41"
      ]
    }
  ]
}
