        <bpmndi:BPMNLabel><dc:Bounds x="1141.5" y="303" width="90" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
