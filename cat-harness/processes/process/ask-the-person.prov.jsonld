    {
      "@id": "processes/process/ask-the-person.bpmn#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "process Process_AskThePerson",
      "prov:value": "WHY A SUBPROCESS. The asking rule lived only in a skill, and every diagram had its own ask step with no link to it. Each enforcement was keyed to one tool name (`AskUserQuestion`), so a host with a different question tool (the Claude projects `request_decision` Decision card) asked without the rule, and the owner got bare cards with no question or options (owner, 2026-10-23: \"this is PROCESS FAILURE ... maybe need better subprocess etc associations\"). One subprocess, called by every asking step, makes the association visible in the diagrams and checkable.",
      "cat-harness:refs": [
        "2026-10-23"
      ],
      "dcterms:date": [
        "2026-10-23"
      ]
    },
    {
      "@id": "processes/process/ask-the-person.bpmn#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "process Process_AskThePerson",
      "prov:value": "WHAT IS BOOTSTRAP'S AND WHAT IS OURS (shared block G8 of the BPMN guidance review, owner Q-BR-6 A, 2026-11-01).",
      "cat-harness:refs": [
        "2026-11-01",
        "shared block G8",
        "Q-BR-6 A"
      ],
