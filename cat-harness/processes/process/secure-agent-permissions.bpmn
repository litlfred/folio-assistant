      <bpmndi:BPMNShape id="Shape_GW_Gap" bpmnElement="GW_Gap" isMarkerVisible="true">
        <dc:Bounds x="632" y="135" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="597" y="64" width="120" height="54" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Current" bpmnElement="End_Current">
        <dc:Bounds x="639" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="682" y="271" width="80" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Explain" bpmnElement="Task_Explain">
        <dc:Bounds x="752" y="100" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_OwnerGrants" bpmnElement="Task_OwnerGrants">
        <dc:Bounds x="902" y="355" width="120" height="120" />
      </bpmndi:BPMNShape>
