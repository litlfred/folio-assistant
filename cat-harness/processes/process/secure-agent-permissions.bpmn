        <dc:Bounds x="312" y="100" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReadGrants" bpmnElement="Task_ReadGrants">
        <dc:Bounds x="462" y="100" width="120" height="120" />
