      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_WriteConfig" bpmnElement="Task_WriteConfig">
        <dc:Bounds x="1332" y="100" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Granted" bpmnElement="End_Granted">
        <dc:Bounds x="1492" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1474" y="183" width="70" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_p1" bpmnElement="p1">
        <di:waypoint x="282" y="160" />
        <di:waypoint x="312" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_p2" bpmnElement="p2">
        <di:waypoint x="432" y="160" />
        <di:waypoint x="462" y="160" />
      </bpmndi:BPMNEdge>
