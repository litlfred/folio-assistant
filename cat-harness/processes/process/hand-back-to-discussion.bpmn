      <bpmndi:BPMNEdge id="Edge_SF_HB_14" bpmnElement="SF_HB_14">
        <di:waypoint x="1530" y="180" />
        <di:waypoint x="1572" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
