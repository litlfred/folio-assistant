      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HB_4" bpmnElement="SF_HB_4">
        <di:waypoint x="495" y="155" /><di:waypoint x="495" y="110" /><di:waypoint x="735" y="110" /><di:waypoint x="735" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HB_5" bpmnElement="SF_HB_5">
        <di:waypoint x="670" y="180" />
