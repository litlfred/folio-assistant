      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Kg_None" bpmnElement="SF_Kg_None">
        <di:waypoint x="1012" y="365" />
        <di:waypoint x="1012" y="440" />
        <di:waypoint x="1332" y="440" />
        <di:waypoint x="1332" y="400" />
        <bpmndi:BPMNLabel><dc:Bounds x="1130" y="444" width="150" height="36" /></bpmndi:BPMNLabel>
