        <bpmndi:BPMNLabel><dc:Bounds x="1044" y="318" width="48" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Kg_4" bpmnElement="SF_Kg_4">
        <di:waypoint x="1232" y="340" />
