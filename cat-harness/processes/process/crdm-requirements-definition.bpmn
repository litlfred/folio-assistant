        <di:waypoint x="522" y="400" />
        <bpmndi:BPMNLabel><dc:Bounds x="1412" y="590" width="55" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_Process_CRDM_Requirements_7" bpmnElement="SF_Process_CRDM_Requirements_7">
        <di:waypoint x="1432" y="340" />
        <di:waypoint x="1472" y="340" />
        <bpmndi:BPMNLabel><dc:Bounds x="1437" y="318" width="30" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
