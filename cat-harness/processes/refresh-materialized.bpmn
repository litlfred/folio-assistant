        <dc:Bounds x="2060" y="497" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2010" y="538" width="140" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Remote_di" bpmnElement="Flow_Remote">
        <di:waypoint x="1725" y="295" /><di:waypoint x="1725" y="525" /><di:waypoint x="1640" y="525" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Local_di" bpmnElement="Flow_Local">
        <di:waypoint x="1750" y="270" /><di:waypoint x="1905" y="270" /><di:waypoint x="1905" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Merge_di" bpmnElement="Flow_Merge">
        <di:waypoint x="1725" y="245" /><di:waypoint x="1725" y="140" /><di:waypoint x="1810" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Defer_di" bpmnElement="Flow_Defer">
