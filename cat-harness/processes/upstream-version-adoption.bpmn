        <dc:Bounds x="1710" y="560" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PM_Decide" bpmnElement="PM_Decide">
        <dc:Bounds x="1910" y="715" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Adopt" bpmnElement="GW_Adopt" isMarkerVisible="true">
        <dc:Bounds x="2110" y="730" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ApplyPin" bpmnElement="A_ApplyPin">
        <dc:Bounds x="2310" y="125" width="140" height="80" />
      </bpmndi:BPMNShape>
