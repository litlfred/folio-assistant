        <dc:Bounds x="710" y="125" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Mvp" bpmnElement="Task_Mvp">
        <dc:Bounds x="910" y="375" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Gates" bpmnElement="Task_Gates">
        <dc:Bounds x="1110" y="375" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Evidence" bpmnElement="A_Evidence">
        <dc:Bounds x="1310" y="125" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Call_OptionsAnalysis" bpmnElement="Call_OptionsAnalysis">
        <dc:Bounds x="1910" y="125" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_R_Review" bpmnElement="R_Review">
        <dc:Bounds x="1510" y="545" width="140" height="80" />
      </bpmndi:BPMNShape>
