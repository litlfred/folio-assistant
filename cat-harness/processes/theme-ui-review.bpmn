      <bpmndi:BPMNShape id="Shape_End_TUR" bpmnElement="End_TUR">
        <dc:Bounds x="1660" y="317" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_SF_TUR_1" bpmnElement="SF_TUR_1">
        <di:waypoint x="276" y="335" />
        <di:waypoint x="330" y="335" />
      </bpmndi:BPMNEdge>
