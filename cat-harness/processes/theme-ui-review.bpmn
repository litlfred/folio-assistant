        <dc:Bounds x="1130" y="125" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Findings" bpmnElement="GW_Findings" isMarkerVisible="true">
        <dc:Bounds x="1330" y="310" width="50" height="50" />
