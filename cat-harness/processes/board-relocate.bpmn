<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:folio="https://litlfred.github.io/folio-assistant/bpmn"
                  id="Definitions_BoardRelocate"
                  targetNamespace="http://folio-assistant.dev/bpmn/board-relocate">

  <!-- ═══════════════════════════════════════════════════════════
       The fishbone — relocating content into fsh-guts
       Bean: folio-assistant-sd8x (authoring), folio-assistant-0jtj (build)

       Owner, 2026-09-21: "have fsh-guts to throw stuff into", "confrim
       arctions [fishbones] on open content puts in fsh guts", and, when
       asked what the fishbone does to the thing it takes:
       "Relocate the content itself — delete becomes move".

       WHY THIS IS A DIAGRAM AND NOT A HANDLER. The fishbone LOOKS like
       a delete and is not one, which is exactly the confusion a drawn
       process is for. Two facts have to survive every future edit of
       the code:

         1. The content MOVES. Nothing is removed, so the reader who
            hits the wrong control loses a location rather than a node.
         2. The reader is ASKED FIRST, and the question names what will
            move and where it lands — `deletion-requires-confirmation`,
            which governs any durable artefact an agent or a control
            would take away on its own initiative.

       THE EXPORTED LABELS SAY "the trashcan", NOT THE DIRECTORY NAME, and
       that is not squeamishness — owner, 2026-09-19: "NEVER include
       fsh-guts, references to fsh-guts stripped out of KG before sending to
       publication." A task name is a published node, an XML comment is not,
       so the directory is named here and nowhere a consumer can follow.
       `fsh-guts-unpublished.test.ts` is what catches a rename back.

       STRICT, unlike `board-open-close`. Opening a card is a click and
       refusing it would refuse a click; relocating content edits the
       folio, and a step that has not been confirmed must be refused.
       ═══════════════════════════════════════════════════════════ -->

  <bpmn:collaboration id="Collab_BoardRelocate">
    <bpmn:participant id="Participant_BoardRelocate" name="Board: relocate content to the trashcan" processRef="Process_BoardRelocate"/>
  </bpmn:collaboration>

  <bpmn:process id="Process_BoardRelocate" name="Board: relocate content to the trashcan" isExecutable="true">
    <bpmn:extensionElements>
      <folio:policy enforcement="strict"/>
    </bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_BoardRelocate">
      <bpmn:lane id="Lane_Reader" name="Reader">
        <bpmn:extensionElements><folio:role ref="user"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>Start_Fishbone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unchanged</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Renderer" name="Board renderer">
        <bpmn:documentation>The order of its five tasks is load-bearing: the folio move lands before the layer update, so an interruption between the two leaves the semantic content already relocated rather than the presentation layer half-updated against a folio it no longer matches. On "no", the only action taken is to leave everything untouched — this process, unlike board-open-close, is strict, because a step that edits the folio and has not been confirmed must be refused rather than merely discouraged.</bpmn:documentation>
        <bpmn:extensionElements><folio:role ref="board-renderer"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>A_Cancel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_AskConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_MoveContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_UpdateLayer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ReportMove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Moved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Fishbone" name="The fishbone is used on open content">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="A_AskConfirm" name="Name what will move, and where it lands">
      <bpmn:extensionElements>
        <!-- The question carries the SUBJECT and the DESTINATION, not a
             bare "are you sure": a confirmation that does not say what is
             at stake is not one. -->
        <folio:skill ref="deletion-requires-confirmation"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="GW_Confirmed" name="Confirmed by the reader?">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_Yes</bpmn:outgoing>
      <bpmn:outgoing>F_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="A_Cancel" name="Leave the content exactly where it is">
      <bpmn:extensionElements><folio:skill ref="board-windows"/></bpmn:extensionElements>
      <bpmn:incoming>F_No</bpmn:incoming>
      <bpmn:outgoing>F_Cancelled</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Unchanged" name="Nothing moved">
      <bpmn:incoming>F_Cancelled</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:task id="A_MoveContent" name="Relocate the content to the trashcan">
      <bpmn:extensionElements>
        <!-- A MOVE in the folio, the semantic layer. The node keeps its
             identity, so every reference to it still resolves. -->
        <folio:skill ref="board-diagram-interchange"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Yes</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="A_UpdateLayer" name="Drop its positions and sweep orphans">
      <bpmn:extensionElements>
        <!-- The layer follows the folio and never the other way: an
             orphan is swept from `board-positions.json`, not edited out
             of a note somebody owns. -->
        <folio:skill ref="board-diagram-interchange"/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="A_ReportMove" name="Say what moved and where it went">
      <bpmn:extensionElements><folio:skill ref="deletion-requires-confirmation"/></bpmn:extensionElements>
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Moved" name="The content lives in the trashcan">
      <bpmn:incoming>F_5</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_1" sourceRef="Start_Fishbone" targetRef="A_AskConfirm"/>
    <bpmn:sequenceFlow id="F_2" sourceRef="A_AskConfirm" targetRef="GW_Confirmed"/>
    <bpmn:sequenceFlow id="F_Yes" name="yes, move it" sourceRef="GW_Confirmed" targetRef="A_MoveContent"/>
    <bpmn:sequenceFlow id="F_No" name="no" sourceRef="GW_Confirmed" targetRef="A_Cancel"/>
    <bpmn:sequenceFlow id="F_Cancelled" sourceRef="A_Cancel" targetRef="End_Unchanged"/>
    <bpmn:sequenceFlow id="F_3" sourceRef="A_MoveContent" targetRef="A_UpdateLayer"/>
    <bpmn:sequenceFlow id="F_4" sourceRef="A_UpdateLayer" targetRef="A_ReportMove"/>
    <bpmn:sequenceFlow id="F_5" sourceRef="A_ReportMove" targetRef="End_Moved"/>
  </bpmn:process>

  <!-- Layout only. Nothing below changes what the process does. -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_BoardRelocate">
    <bpmndi:BPMNPlane id="BPMNPlane_BoardRelocate" bpmnElement="Collab_BoardRelocate">
      <bpmndi:BPMNShape id="Shape_Participant_BoardRelocate" bpmnElement="Participant_BoardRelocate" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1060" height="440"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Reader" bpmnElement="Lane_Reader" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1030" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Renderer" bpmnElement="Lane_Renderer" isHorizontal="true">
        <dc:Bounds x="190" y="200" width="1030" height="320"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_Fishbone" bpmnElement="Start_Fishbone">
        <dc:Bounds x="220" y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Confirmed" bpmnElement="GW_Confirmed" isMarkerVisible="true">
        <dc:Bounds x="480" y="115" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Unchanged" bpmnElement="End_Unchanged">
        <dc:Bounds x="1000" y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_AskConfirm" bpmnElement="A_AskConfirm">
        <dc:Bounds x="300" y="250" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Cancel" bpmnElement="A_Cancel">
        <dc:Bounds x="760" y="250" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_MoveContent" bpmnElement="A_MoveContent">
        <dc:Bounds x="560" y="390" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_UpdateLayer" bpmnElement="A_UpdateLayer">
        <dc:Bounds x="760" y="390" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ReportMove" bpmnElement="A_ReportMove">
        <dc:Bounds x="960" y="390" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Moved" bpmnElement="End_Moved">
        <dc:Bounds x="1140" y="412" width="36" height="36"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_F_1" bpmnElement="F_1">
        <di:waypoint x="238" y="158"/>
        <di:waypoint x="238" y="290"/>
        <di:waypoint x="300" y="290"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_2" bpmnElement="F_2">
        <di:waypoint x="440" y="290"/>
        <di:waypoint x="450" y="290"/>
        <di:waypoint x="450" y="140"/>
        <di:waypoint x="480" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_Yes" bpmnElement="F_Yes">
        <di:waypoint x="505" y="165"/>
        <di:waypoint x="505" y="430"/>
        <di:waypoint x="560" y="430"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_No" bpmnElement="F_No">
        <di:waypoint x="530" y="140"/>
        <di:waypoint x="820" y="140"/>
        <di:waypoint x="820" y="250"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_Cancelled" bpmnElement="F_Cancelled">
        <di:waypoint x="880" y="290"/>
        <di:waypoint x="1018" y="290"/>
        <di:waypoint x="1018" y="158"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_3" bpmnElement="F_3">
        <di:waypoint x="700" y="430"/>
        <di:waypoint x="760" y="430"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_4" bpmnElement="F_4">
        <di:waypoint x="900" y="430"/>
        <di:waypoint x="960" y="430"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_5" bpmnElement="F_5">
        <di:waypoint x="1100" y="430"/>
        <di:waypoint x="1140" y="430"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
