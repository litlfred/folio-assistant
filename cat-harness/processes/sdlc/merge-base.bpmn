<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/0.1.0/processes/ns#"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns#"
                  id="Definitions_Process_MergeBase" targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:collaboration id="Collaboration_Process_MergeBase">
    <bpmn:participant id="Participant_Process_MergeBase" name="Merge the base branch in" processRef="Process_MergeBase"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_MergeBase" name="Merge the base branch in" isExecutable="false">
    <bpmn:documentation>CALLED FROM `Task_PrepareMerge` in code-change-review.bpmn, and executed by `bun run merge:main` (cat-harness/scripts/merge-base.ts). Bean `y7b3`, issue #1707. Owner, 2026-10-01: "put in merge process bpmn".

MEASURED 2026-09-30 over 300 main-into-branch merges: 235 conflicted, 147 (63%) ONLY on generated files, each resolved the same mechanical way. The declared patterns, and why each is or is not automatic, are in the `merge-conflict-patterns` skill.

ALL OR NOTHING: every conflicted path is classified before any is touched, and one refusal aborts the merge and restores the tree. PROVED, NOT ASSUMED: `regen` derives every check/writer pair from the CI workflow, and an unrepaired check aborts too. Only what both gateways pass is committed.</bpmn:documentation>
    <bpmn:extensionElements>
      <!-- STRICT: `GW_AllDeclared` and `GW_Proved` each guard a path that
           COMMITS. Advisory would permit reaching the commit without the
           gateway that separates a declared, regenerated resolution from a
           guessed one. -->
      <cat-harness.processes:policy enforcement="strict"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_MergeBase">
      <bpmn:lane id="Lane_Command" name="merge:main command">
        <bpmn:documentation>Mechanical. Decides nothing a declaration has not decided: a path no pattern names is refused, and the gate set, not this lane, judges the result.</bpmn:documentation>
        <bpmn:extensionElements><bootstrap.processes:role ref="build-pipeline"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>Start_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conflicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Classify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_AllDeclared</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Regen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Proved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Merged</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Abort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_News</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Notified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Recorded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Authoring agent">
        <bpmn:documentation>Reached only when the command refused: an authored conflict, an undeclared path, or a resolution the gates could not reproduce. The refused paths are listed for it; what to do with an authored conflict is judgement.</bpmn:documentation>
        <bpmn:extensionElements><bootstrap.processes:role ref="authoring-agent"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>Task_ByHand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ByHand</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Merge" name="Base moved,&#10;or PR conflicted">
      <bpmn:outgoing>m1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Merge" name="Merge the base in,&#10;without committing">
      <bpmn:documentation>`git merge --no-ff --no-commit origin/main` on a clean tree (untracked files refuse too, so the final stage cannot sweep in a scratch file).</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="prepare-merge"/></bpmn:extensionElements>
      <bpmn:incoming>m1</bpmn:incoming>
      <bpmn:outgoing>m2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Conflicts" name="Any&#10;conflict?">
      <bpmn:documentation>`none` still regenerates: a CLEAN merge can produce an artefact neither side would emit (bean `lxpq`), so only the gates can say it is right.</bpmn:documentation>
      <bpmn:incoming>m2</bpmn:incoming>
      <bpmn:outgoing>m3</bpmn:outgoing>
      <bpmn:outgoing>m4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Classify" name="Classify every conflicted&#10;path against the&#10;declared patterns">
      <bpmn:documentation>The first matching pattern decides: take-base, generated-regions, qa-sidecar, or refuse. A path no pattern names refuses.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="merge-conflict-patterns"/></bpmn:extensionElements>
      <bpmn:incoming>m4</bpmn:incoming>
      <bpmn:outgoing>m5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_AllDeclared" name="Every path&#10;resolvable?">
      <bpmn:documentation>`no` if even one path is refused: the merge is aborted whole, never half-resolved.</bpmn:documentation>
      <bpmn:incoming>m5</bpmn:incoming>
      <bpmn:outgoing>m6</bpmn:outgoing>
      <bpmn:outgoing>m7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Resolve" name="Resolve each by&#10;its declared strategy">
      <bpmn:documentation>qa-sidecar paths first, through `qa:resolve-conflicts`; take-base paths take the base's copy; generated-regions files take the base's side of each hunk, which lies inside a generated region by construction.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="merge-conflict-patterns"/></bpmn:extensionElements>
      <bpmn:incoming>m6</bpmn:incoming>
      <bpmn:outgoing>m8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Regen" name="Regenerate, asking&#10;every CI gate">
      <bpmn:documentation>`bun run regen`: every check/writer pair the CI workflow runs, repeated until the tree settles.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="prepare-merge"/></bpmn:extensionElements>
      <bpmn:incoming>m3</bpmn:incoming>
      <bpmn:incoming>m8</bpmn:incoming>
      <bpmn:outgoing>m9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_Proved" name="Every gate&#10;reproduced?">
      <bpmn:documentation>`no` when regen reports an unrepaired check, or one with no writer: a resolution the gates cannot reproduce is not a resolution.</bpmn:documentation>
      <bpmn:incoming>m9</bpmn:incoming>
      <bpmn:outgoing>m10</bpmn:outgoing>
      <bpmn:outgoing>m11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Commit" name="Commit the merge">
      <bpmn:extensionElements><bootstrap.processes:skill ref="continual-progress"/></bpmn:extensionElements>
      <bpmn:incoming>m10</bpmn:incoming>
      <bpmn:outgoing>m12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Merged" name="Merged,&#10;proved">
      <bpmn:incoming>m12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Abort" name="Abort, restore the tree,&#10;list what was refused">
      <bpmn:documentation>`git merge --abort`. Each refused path is listed with its pattern's reason, or "no declared pattern".</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="merge-conflict-patterns"/></bpmn:extensionElements>
      <bpmn:incoming>m7</bpmn:incoming>
      <bpmn:incoming>m11</bpmn:incoming>
      <bpmn:outgoing>m13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ByHand" name="Resolve by hand,&#10;then regenerate">
      <bpmn:extensionElements><bootstrap.processes:skill ref="prepare-merge"/></bpmn:extensionElements>
      <bpmn:incoming>m13</bpmn:incoming>
      <bpmn:outgoing>m14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_ByHand" name="Merged by&#10;a person">
      <bpmn:incoming>m14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Report" name="Every member&#10;reported">
      <bpmn:documentation>A SECOND trigger, not a step of the merge above: `merge-main.yml` runs one merge per opted-in PR and this fires once per RUN, when all of them have reported. Drawn separately because a diagram that showed it inside one PR's flow would say the run notifies per PR, which is the defect it exists to fix (bean `03nl`).</bpmn:documentation>
      <bpmn:outgoing>m15</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Report" name="Report what the run&#10;found, once">
      <bpmn:documentation>Every member's verdict, in one table in the run's summary: merged, already up to date, refused, an expected race, a repeat of a failure already reported, something new, or a member that could not say. `cat-harness/scripts/merge-main-comment.ts --aggregate`.</bpmn:documentation>
      <bpmn:extensionElements><bootstrap.processes:skill ref="ci-health"/></bpmn:extensionElements>
      <bpmn:incoming>m15</bpmn:incoming>
      <bpmn:outgoing>m16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_News" name="Anything&#10;new?">
      <bpmn:documentation>`new` on three conditions and no others: a failure whose signature the PR's own comment did not already report; a member that reported no verdict, or one it could not classify; and a systemic failure (every selected PR failed) unless every one of those failures is itself a repeat, in which case each PR's comment already reports its own condition and the run that made it true was the loud one. A repeat of an identical failure on an unchanged head is `already reported`.</bpmn:documentation>
      <bpmn:incoming>m16</bpmn:incoming>
      <bpmn:outgoing>m17</bpmn:outgoing>
      <bpmn:outgoing>m18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Notified" name="Run red:&#10;one email">
      <bpmn:incoming>m17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Recorded" name="Run green: recorded,&#10;not sent again">
      <bpmn:documentation>Quiet is not silent. The finding stays in the PR's comment, in the member's job summary, in a warning annotation and in that member's own red job; only the email is withheld. `1xhc`: a report nobody receives must still be a report somebody can find.</bpmn:documentation>
      <bpmn:incoming>m18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="m1" sourceRef="Start_Merge" targetRef="Task_Merge"/>
    <bpmn:sequenceFlow id="m2" sourceRef="Task_Merge" targetRef="GW_Conflicts"/>
    <bpmn:sequenceFlow id="m3" name="none" sourceRef="GW_Conflicts" targetRef="Task_Regen"/>
    <bpmn:sequenceFlow id="m4" name="yes" sourceRef="GW_Conflicts" targetRef="Task_Classify"/>
    <bpmn:sequenceFlow id="m5" sourceRef="Task_Classify" targetRef="GW_AllDeclared"/>
    <bpmn:sequenceFlow id="m6" name="yes" sourceRef="GW_AllDeclared" targetRef="Task_Resolve"/>
    <bpmn:sequenceFlow id="m7" name="no" sourceRef="GW_AllDeclared" targetRef="Task_Abort"/>
    <bpmn:sequenceFlow id="m8" sourceRef="Task_Resolve" targetRef="Task_Regen"/>
    <bpmn:sequenceFlow id="m9" sourceRef="Task_Regen" targetRef="GW_Proved"/>
    <bpmn:sequenceFlow id="m10" name="yes" sourceRef="GW_Proved" targetRef="Task_Commit"/>
    <bpmn:sequenceFlow id="m11" name="no" sourceRef="GW_Proved" targetRef="Task_Abort"/>
    <bpmn:sequenceFlow id="m12" sourceRef="Task_Commit" targetRef="End_Merged"/>
    <bpmn:sequenceFlow id="m13" sourceRef="Task_Abort" targetRef="Task_ByHand"/>
    <bpmn:sequenceFlow id="m14" sourceRef="Task_ByHand" targetRef="End_ByHand"/>
    <bpmn:sequenceFlow id="m15" sourceRef="Start_Report" targetRef="Task_Report"/>
    <bpmn:sequenceFlow id="m16" sourceRef="Task_Report" targetRef="GW_News"/>
    <bpmn:sequenceFlow id="m17" name="new, changed or systemic" sourceRef="GW_News" targetRef="End_Notified"/>
    <bpmn:sequenceFlow id="m18" name="already reported" sourceRef="GW_News" targetRef="End_Recorded"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_MergeBase">
    <bpmndi:BPMNPlane id="Plane_Process_MergeBase" bpmnElement="Collaboration_Process_MergeBase">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_Process_MergeBase" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="1480" height="460"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Command" bpmnElement="Lane_Command" isHorizontal="true">
        <dc:Bounds x="30" y="0" width="1450" height="300"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Agent" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="30" y="300" width="1450" height="160"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Merge" bpmnElement="Start_Merge"><dc:Bounds x="100" y="132" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Merge" bpmnElement="Task_Merge"><dc:Bounds x="160" y="110" width="130" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Conflicts" bpmnElement="GW_Conflicts" isMarkerVisible="true"><dc:Bounds x="330" y="125" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Classify" bpmnElement="Task_Classify"><dc:Bounds x="420" y="110" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_AllDeclared" bpmnElement="GW_AllDeclared" isMarkerVisible="true"><dc:Bounds x="610" y="125" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Resolve" bpmnElement="Task_Resolve"><dc:Bounds x="700" y="110" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Regen" bpmnElement="Task_Regen"><dc:Bounds x="900" y="110" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Proved" bpmnElement="GW_Proved" isMarkerVisible="true"><dc:Bounds x="1090" y="125" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Commit" bpmnElement="Task_Commit"><dc:Bounds x="1180" y="110" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Merged" bpmnElement="End_Merged"><dc:Bounds x="1380" y="132" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Abort" bpmnElement="Task_Abort"><dc:Bounds x="900" y="210" width="150" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ByHand" bpmnElement="Task_ByHand"><dc:Bounds x="900" y="340" width="150" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_ByHand" bpmnElement="End_ByHand"><dc:Bounds x="1100" y="362" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Report" bpmnElement="Start_Report"><dc:Bounds x="100" y="232" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Report" bpmnElement="Task_Report"><dc:Bounds x="170" y="220" width="150" height="60"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_News" bpmnElement="GW_News" isMarkerVisible="true"><dc:Bounds x="370" y="225" width="50" height="50"/></bpmndi:BPMNShape>
      <!-- x=480, not 620: `m7` runs VERTICALLY down x=635 from GW_AllDeclared
           to the abort row at y=245, and an end event at 620-656 would have
           had that edge drawn through it. -->
      <bpmndi:BPMNShape id="Shape_End_Notified" bpmnElement="End_Notified"><dc:Bounds x="480" y="200" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Recorded" bpmnElement="End_Recorded"><dc:Bounds x="480" y="255" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_m15" bpmnElement="m15"><di:waypoint x="136" y="250"/><di:waypoint x="170" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m16" bpmnElement="m16"><di:waypoint x="320" y="250"/><di:waypoint x="370" y="250"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m17" bpmnElement="m17"><di:waypoint x="395" y="225"/><di:waypoint x="395" y="218"/><di:waypoint x="480" y="218"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m18" bpmnElement="m18"><di:waypoint x="395" y="275"/><di:waypoint x="395" y="273"/><di:waypoint x="480" y="273"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m1" bpmnElement="m1"><di:waypoint x="136" y="150"/><di:waypoint x="160" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m2" bpmnElement="m2"><di:waypoint x="290" y="150"/><di:waypoint x="330" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m3" bpmnElement="m3"><di:waypoint x="355" y="125"/><di:waypoint x="355" y="60"/><di:waypoint x="975" y="60"/><di:waypoint x="975" y="110"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m4" bpmnElement="m4"><di:waypoint x="380" y="150"/><di:waypoint x="420" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m5" bpmnElement="m5"><di:waypoint x="570" y="150"/><di:waypoint x="610" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m6" bpmnElement="m6"><di:waypoint x="660" y="150"/><di:waypoint x="700" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m7" bpmnElement="m7"><di:waypoint x="635" y="175"/><di:waypoint x="635" y="245"/><di:waypoint x="900" y="245"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m8" bpmnElement="m8"><di:waypoint x="850" y="150"/><di:waypoint x="900" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m9" bpmnElement="m9"><di:waypoint x="1050" y="150"/><di:waypoint x="1090" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m10" bpmnElement="m10"><di:waypoint x="1140" y="150"/><di:waypoint x="1180" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m11" bpmnElement="m11"><di:waypoint x="1115" y="175"/><di:waypoint x="1115" y="245"/><di:waypoint x="1050" y="245"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m12" bpmnElement="m12"><di:waypoint x="1330" y="150"/><di:waypoint x="1380" y="150"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m13" bpmnElement="m13"><di:waypoint x="975" y="280"/><di:waypoint x="975" y="340"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_m14" bpmnElement="m14"><di:waypoint x="1050" y="380"/><di:waypoint x="1100" y="380"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
