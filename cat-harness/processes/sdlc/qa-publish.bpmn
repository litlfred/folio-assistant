      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P07" bpmnElement="P07">
        <bpmndi:BPMNLabel><dc:Bounds x="1170" y="160" width="55" height="14" /></bpmndi:BPMNLabel>
        <di:waypoint x="1150" y="180" />
        <di:waypoint x="1257" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P08" bpmnElement="P08">
        <bpmndi:BPMNLabel><dc:Bounds x="1135" y="275" width="80" height="27" /></bpmndi:BPMNLabel>
        <di:waypoint x="1125" y="205" />
        <di:waypoint x="1125" y="305" />
        <di:waypoint x="1000" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P09" bpmnElement="P09">
        <di:waypoint x="925" y="270" />
        <di:waypoint x="925" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_P10" bpmnElement="P10">
        <bpmndi:BPMNLabel><dc:Bounds x="1130" y="66" width="90" height="27" /></bpmndi:BPMNLabel>
        <di:waypoint x="1125" y="155" />
