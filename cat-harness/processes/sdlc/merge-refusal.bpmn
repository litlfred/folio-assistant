      <bpmndi:BPMNEdge id="Edge_r15" bpmnElement="r15"><di:waypoint x="1240" y="100"/><di:waypoint x="1290" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_r16" bpmnElement="r16"><di:waypoint x="1340" y="100"/><di:waypoint x="1390" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_r17" bpmnElement="r17"><di:waypoint x="1315" y="75"/><di:waypoint x="1315" y="30"/><di:waypoint x="240" y="30"/><di:waypoint x="240" y="60"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_r18" bpmnElement="r18"><di:waypoint x="1315" y="125"/><di:waypoint x="1315" y="200"/><di:waypoint x="1390" y="200"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_r19" bpmnElement="r19"><di:waypoint x="1530" y="100"/><di:waypoint x="1580" y="100"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_r20" bpmnElement="r20"><di:waypoint x="1530" y="200"/><di:waypoint x="1580" y="200"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
