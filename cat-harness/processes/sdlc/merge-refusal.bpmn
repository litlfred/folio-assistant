      <bpmndi:BPMNShape id="Shape_Task_AskOwner" bpmnElement="Task_AskOwner"><dc:Bounds x="1100" y="470" width="140" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_AwaitOwner" bpmnElement="End_AwaitOwner"><dc:Bounds x="1290" y="492" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_r1" bpmnElement="r1"><di:waypoint x="136" y="100"/><di:waypoint x="170" y="100"/></bpmndi:BPMNEdge>
