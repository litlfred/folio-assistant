        <dc:Bounds x="960" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_DecisionFollows" bpmnElement="GW_DecisionFollows" isMarkerVisible="true">
        <dc:Bounds x="1120" y="145" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_HandOff" bpmnElement="A_HandOff">
        <dc:Bounds x="1220" y="130" width="120" height="80" />
      </bpmndi:BPMNShape>
