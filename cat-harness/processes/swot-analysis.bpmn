        <dc:Bounds x="1400" y="152" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_SituationRecorded" bpmnElement="End_SituationRecorded">
        <dc:Bounds x="1127" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_SF_Process_SwotAnalysis_1" bpmnElement="SF_Process_SwotAnalysis_1">
        <di:waypoint x="268" y="170" /><di:waypoint x="320" y="170" />
      </bpmndi:BPMNEdge>
