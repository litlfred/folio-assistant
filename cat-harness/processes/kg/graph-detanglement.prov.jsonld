    {
      "@id": "processes/kg/graph-detanglement.bpmn#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "process Process_GraphDetanglement",
      "prov:value": "`Prune, merge, factor, or reclassify` returns to `Measure` rather than to the gate, because an assignment is verified by RE-RUNNING and never by being locally reasonable — the obvious move, the one the tool's own message asks for, once took the count from 5 to 15. The four moves are the only four: the first three are the block-scale rule, and \"the classification is wrong\" is the fourth the repository scale adds because a module's layer is in doubt the way a block's chapter is not."
    },
    {
      "@id": "processes/kg/graph-detanglement.bpmn#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "comment before Lane_Admin",
      "prov:value": "Bound EXPLICITLY rather than by name. \"Authoring agent\" is not in the role's `lanes` aliases, and the audit caught that on the first run — which is the cheap version of the near-miss `code-change-review` records, where \"CI/CD pipeline\" differed from the declared name by one capital letter. A ref cannot near-miss. And the role is REUSED rather than minted: `role-model` says a role is never invented to make a diagram drawable, so there is no \"graph steward\" here."
    },
    {
      "@id": "processes/kg/graph-detanglement.bpmn#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "task Task_Brief",
      "prov:value": "A falsifier that never fires is decoration — this practice's own fired, took edges 5 to 12, and rewrote the plan."
    },
    {
      "@id": "processes/kg/graph-detanglement.bpmn#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "exclusiveGateway GW_Declared",
      "prov:value": "No entry, or a declared path that does not exist (bean `dh4f`), goes to `not yet`, back to Declare.",
      "cat-harness:refs": [
        "bean dh4f"
      ]
    },
    {
      "@id": "processes/kg/graph-detanglement.bpmn#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "task Task_Measure",
      "prov:value": "Read the unassigned column before the edge count, and quote BOTH numbers rather than only the one that improved. The count rising when the measurement improves is correct: 43 to 49 when thirteen previously-unjudged edges were folded in."
    },
    {
      "@id": "processes/kg/graph-detanglement.bpmn#provenance-6",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "process Process_GraphDetanglement",
      "prov:value": "Stage 1 moves nothing: the sub-graph is declared where it already sits, still inside the repository, still connected. The worked example was the WHO base harness's `methodologies/`, declared in place and lifted out whole when that harness became its own repository."
    }
  ]
