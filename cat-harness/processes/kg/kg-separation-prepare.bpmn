      <bpmndi:BPMNEdge id="Edge_F9" bpmnElement="F9"><di:waypoint x="1365" y="726.667"/><di:waypoint x="1455" y="726.667"/><bpmndi:BPMNLabel><dc:Bounds x="1369" y="729.333" width="80" height="14"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
