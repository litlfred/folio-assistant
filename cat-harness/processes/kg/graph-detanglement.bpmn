      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G5b" bpmnElement="G5b">
        <di:waypoint x="1177" y="315" />
        <di:waypoint x="1177" y="375" />
        <di:waypoint x="1032" y="375" />
        <di:waypoint x="1032" y="442" />
        <bpmndi:BPMNLabel><dc:Bounds x="1182" y="322" width="60" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G9" bpmnElement="G9">
        <di:waypoint x="1202" y="290" />
        <di:waypoint x="1282" y="290" />
        <bpmndi:BPMNLabel><dc:Bounds x="1206" y="268" width="80" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G10" bpmnElement="G10">
        <di:waypoint x="1402" y="290" />
