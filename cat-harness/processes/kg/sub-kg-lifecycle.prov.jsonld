      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "task Task_Rehearse",
      "prov:value": "Run the gates rather than scanning imports: the fork rehearsal (bean rbz3) found a static scan saw 20 of the 23 platform files the gates loaded, and that renaming the directory changed every generated page.",
      "cat-harness:refs": [
        "bean rbz3"
