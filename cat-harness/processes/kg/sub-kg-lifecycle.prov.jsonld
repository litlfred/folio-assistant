      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "task Task_Seam",
      "prov:value": "A merge from main is where new climbs arrive; reroute them here. Learned from #1767 and #1860.",
      "cat-harness:refs": [
        "#1767",
        "#1860"
      ]
    },
    {
      "@id": "processes/kg/sub-kg-lifecycle.bpmn#provenance-6",
