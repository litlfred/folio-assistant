      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "task Task_Seed",
      "prov:value": "The new repository's own root files are a second commit, so the copy stays byte-identical and reviewable. The first fork seed carried 378 commits this way (bean n3ni, stage E).",
