    {
      "@id": "processes/kg/sub-kg-lifecycle.bpmn#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "task Task_Declare",
      "prov:value": "`&lt;name&gt;/&lt;name&gt;.json` with name, version, `repository` (the planned home), `livesAt` (where it sits today), `needs`, and only the directories that exist, each declared with its files in one commit (bean dh4f).",
      "cat-harness:refs": [
        "bean dh4f"
      ]
    },
    {
      "@id": "processes/kg/sub-kg-lifecycle.bpmn#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "task Task_PushDown",
      "prov:value": "Wrong-direction edges hide in declarations and data as well as imports: run check:import-direction, check:reference-direction and check:process-bindings. Learned from stages A-D of bean n3ni (#1768, #1782, #1783, #1795).",
