      <bpmndi:BPMNEdge id="Edge_F8" bpmnElement="F8"><di:waypoint x="835" y="745"/><di:waypoint x="835" y="400"/><di:waypoint x="850" y="400"/><bpmndi:BPMNLabel><dc:Bounds x="841" y="550" width="45" height="18"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F9" bpmnElement="F9"><di:waypoint x="810" y="770"/><di:waypoint x="802" y="770"/><di:waypoint x="802" y="80"/><di:waypoint x="710" y="80"/><di:waypoint x="710" y="110"/><bpmndi:BPMNLabel><dc:Bounds x="716" y="550" width="80" height="45"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
