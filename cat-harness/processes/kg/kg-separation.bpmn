      <bpmndi:BPMNEdge id="Edge_F11" bpmnElement="F11"><di:waypoint x="970" y="400"/><di:waypoint x="1005" y="400"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F12" bpmnElement="F12">
        <di:waypoint x="1055" y="400" />
        <di:waypoint x="1065" y="400" />
        <di:waypoint x="1065" y="170" />
        <di:waypoint x="1080" y="170" />
        <bpmndi:BPMNLabel><dc:Bounds x="1070" y="300" width="65" height="18" /></bpmndi:BPMNLabel>
