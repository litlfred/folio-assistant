      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Permanent_di" bpmnElement="Gateway_Permanent" isMarkerVisible="true">
        <dc:Bounds x="950" y="410" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="905" y="465" width="80" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Library_di" bpmnElement="Task_Library">
        <dc:Bounds x="1070" y="325" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Trial_di" bpmnElement="Task_Trial">
        <dc:Bounds x="1070" y="445" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ImportTest_di" bpmnElement="Task_ImportTest">
        <dc:Bounds x="1330" y="385" width="190" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Passed_di" bpmnElement="Gateway_Passed" isMarkerVisible="true">
        <dc:Bounds x="1580" y="410" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1560" y="375" width="90" height="30" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Refused_di" bpmnElement="EndEvent_Refused">
