      "localId": "signing-api",
      "name": "Signing API",
      "description": "An attestation endpoint that will sign a QA report's run hashes. Probed by configuration, not by calling it: a probe that made a live request would be indistinguishable from an outage on the one machine this matters for, and would call an external service just to answer a question about setup.",
      "detection": {
        "method": "env-var",
        "variable": "FOLIO_SIGNING_ENDPOINT"
      }
