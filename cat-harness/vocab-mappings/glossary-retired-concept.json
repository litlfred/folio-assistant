{
  "$schema": "folio-vocab-mapping/v1",
  "id": "glossary-retired-concept",
  "title": "Retired glossary term → deprecated SKOS concept (swimlane glossary)",
  "status": "active",
  "description": "How scripts/glossary-export.ts writes a term the ledger remembers and the corpus no longer derives: reported and never deleted. Inventory rows 11-13 of docs/proposals/vocabulary-mappings-2026-10-02.md (bean k74z).",
  "group": [
    {
      "source": "cat-harness:GlossaryGraph",
      "target": "skos:",
      "element": [
        { "code": "prefLabel", "target": [{ "code": "prefLabel", "relationship": "equivalent" }] },
        { "code": "notation", "target": [{ "code": "notation", "relationship": "equivalent" }] },
        { "code": "scheme", "target": [{ "code": "inScheme", "relationship": "equivalent" }] }
      ]
    },
    {
      "source": "cat-harness:GlossaryGraph",
      "target": "owl:",
      "element": [{ "code": "retired", "target": [{ "code": "deprecated", "relationship": "equivalent", "transform": "flag" }] }]
    },
    {
      "source": "cat-harness:GlossaryGraph",
      "target": "skos:",
      "element": [
        {
          "code": "changeNote",
          "target": [
            {
              "code": "changeNote",
              "relationship": "equivalent",
              "transform": "code",
              "comment": "Prepared in code: \"Retired <date>: renamed <title>.\" when a role lists the old name among its formerNames, else \"Retired <date>: no swimlane in this instance derives this term.\""
            }
          ]
        }
      ]
    },
    {
      "source": "cat-harness:GlossaryGraph",
      "target": "dcterms:",
      "element": [
        {
          "code": "replacedBy",
          "target": [
            {
              "code": "isReplacedBy",
              "relationship": "equivalent",
              "transform": "code",
              "comment": "Prepared in code: the IRI of the role that lists this term's label among its formerNames, when one does."
            }
          ]
        }
      ]
    }
  ]
}
