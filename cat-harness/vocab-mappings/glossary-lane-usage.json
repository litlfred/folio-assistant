{
  "$schema": "folio-vocab-mapping/v1",
  "id": "glossary-lane-usage",
  "title": "Lane occurrence → lane usage node (swimlane glossary)",
  "status": "active",
  "description": "How scripts/glossary-export.ts writes one appearance of a lane in one process as a LaneUsage node. Inventory rows 7-9 of docs/proposals/vocabulary-mappings-2026-10-02.md (bean k74z).",
  "group": [
    {
      "source": "cat-harness:Lane",
      "target": "cat-harness:",
      "element": [
        { "code": "concept", "target": [{ "code": "ofConcept", "relationship": "equivalent" }] },
        { "code": "process", "target": [{ "code": "inProcess", "relationship": "equivalent" }] }
      ]
    },
    {
      "source": "cat-harness:Lane",
      "target": "rdfs:",
      "element": [
        {
          "code": "name",
          "target": [
            {
              "code": "label",
              "relationship": "equivalent",
              "comment": "rdfs:label rather than skos:prefLabel: a usage is not a concept, and the term's preferred label is on the concept."
            }
          ]
        }
      ]
    },
    {
      "source": "cat-harness:Lane",
      "target": "skos:",
      "element": [
        {
          "code": "documentation",
          "target": [
            {
              "code": "scopeNote",
              "relationship": "equivalent",
              "comment": "Verbatim: the lane documentation is its own .pot msgid, so a wrapped note would have no translation."
            }
          ]
        }
      ]
    },
    {
      "source": "cat-harness:Lane",
      "target": "dcterms:",
      "element": [{ "code": "file", "target": [{ "code": "source", "relationship": "equivalent" }] }]
    }
  ]
}
