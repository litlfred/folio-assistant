msgstr ""

#: processes/kg/slice-sqlite-publish.bpmn:119
#. Diagram element documentation
msgid "Open `slices/search.html?slice=<name>` on the deployed site, run a phrase search for a known row, open it so its payload is fetched, and look at the result; send the screenshot rather than a description of it. Report the mode the page says it used (OPFS or in memory), never an assumed one."
msgstr ""

#: processes/kg/slice-sqlite-publish.bpmn:29
#. Diagram label
msgid "Platform authoring agent"
msgstr ""

#: processes/kg/slice-sqlite-publish.bpmn:74
#. Diagram label
msgid "Report the measurement; ship nothing"
