#: sdlc/processes/bean-drain.bpmn:89
#. Diagram label
msgid "A bean left on your list?"
msgstr ""

#: sdlc/processes/bean-drain.bpmn:86
#. Diagram element documentation
msgid "A merge, not a decision: the built queue, a closed bean and a skipped one all come back here before the drainer looks at its list again."
msgstr ""

#: sdlc/processes/bean-drain.bpmn:128
#. Diagram element documentation
msgid "Answered by the refreshed queue. `refilled`: the drainer's list has beans again, and it takes the next one straight away. `queue empty`: every drainable bean is closed, held by another agent, or left out with its reason, and the drain ends."
msgstr ""

#: sdlc/processes/bean-drain.bpmn:127
#. Diagram label
msgid "Anything left to drain?"
msgstr ""

#: sdlc/processes/bean-drain.bpmn:78
#. Diagram label
msgid "Asked to drain beans"
msgstr ""

#: sdlc/processes/bean-drain.bpmn:103
#. Diagram label
msgid "Bean claimed?"
msgstr ""

#: sdlc/processes/bean-drain.bpmn:80
#. Diagram label
msgid "Build the queue, grouped by owner"
msgstr ""

#: sdlc/processes/bean-drain.bpmn:139
#. Diagram label
msgid "claimed"
msgstr ""

#: sdlc/processes/bean-drain.bpmn:117
#. Diagram label
msgid "Close the bean"
msgstr ""

#: sdlc/processes/bean-drain.bpmn:45
#. Diagram label
msgid "Drain the beans"
