msgstr "cola de entrada"

#: docs/document-ingestion.md:47
msgid "L1 source content"
msgstr "contenido de fuente L1"

#: docs/document-ingestion.md:48
msgid "greppable by the corpus checklist"
msgstr "accesible mediante grep por la lista de comprobación del corpus"

#: docs/document-ingestion.md:48
msgid "no"
msgstr "no"

#: docs/document-ingestion.md:48
