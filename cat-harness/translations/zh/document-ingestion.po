msgstr "表格元数据"

#: docs/document-ingestion.md:248
msgid "Sheets, headers, shape, narrative"
msgstr "工作表、表头、数据形态、叙述"

#: docs/document-ingestion.md:249
msgid "Narrative provenance"
msgstr "叙述来源溯源"

#: docs/document-ingestion.md:249
msgid "Human or agent + model version"
msgstr "人类或智能体 + 模型版本"

#: docs/document-ingestion.md:250
msgid "L1 completeness gate"
msgstr "L1 完整性关卡"

#: docs/document-ingestion.md:250
