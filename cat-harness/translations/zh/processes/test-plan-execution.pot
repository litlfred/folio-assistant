#. Diagram label
msgid "Record the certification decision"
msgstr ""

#: sdlc/processes/test-plan-execution.bpmn:191
#. Diagram label
msgid "Record the refusal, with the failing cases"
msgstr ""

#: sdlc/processes/test-plan-execution.bpmn:201
#. Diagram label
msgid "Record why it could not be decided"
msgstr ""

