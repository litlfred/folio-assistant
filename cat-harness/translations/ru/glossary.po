# Terminology glossary for Russian — hand-authored, no POT.
#
# This file does not translate anything. It tells
# `content/pipeline/translation-block-qa.ts` how to read a source term that is
# ABSENT from a translation, which it otherwise cannot judge: `WHO` missing from
# a French sentence is either `OMS` (correct) or a dropped term (a loss).
#
#   msgstr "..."     the expected form. Absent from the translation -> fail.
#   #, localised     rendered in the target language, form NOT pinned.
#                    Absent verbatim -> pass, because that is the expectation.
#   (no entry)       unknown -> warn, exactly as before this file existed.
#
# NOTHING HERE IS A TRANSLATION, deliberately. Pinning forms would mean
# authoring target-language material in a repository that holds no content, to
# quieten a checker. `#, localised` says the one thing the checker needs and the
# one thing a reader of English can review. Pin a form when you want the
# stricter check; the mechanism takes it.
#
# Bean `he0e`.
msgid ""
msgstr ""
"Project-Id-Version: folio-assistant\n"
"Language: ru\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"X-Glossary: terminology; not a translation catalogue\n"


# ── Localised: rendered in the target language, form not pinned ──────────

#. World Health Organization. A UN agency that publishes under an official
#. name in each of the six UN languages, so a translation that renders it is
#. correct and one that keeps the English initials is the unusual case.
#, localised
msgid "WHO"
msgstr ""

#. Large language model. Routinely expanded or calqued rather than carried
#. across as three Latin letters.
#, localised
msgid "LLM"
msgstr ""

#. Human-computer interaction. As above — a field name, not a product.
#, localised
msgid "HCI"
msgstr ""

#. Application programming interface. Kept verbatim in much technical prose
#. and expanded in some languages; both are correct, which is exactly the case
#. this flag exists for.
#, localised
msgid "API"
msgstr ""


# ── Verbatim: a name that does not translate. Absent -> fail ─────────────

#. A standard's name, not a phrase. HL7 publishes it untranslated.
msgid "FHIR"
msgstr "FHIR"

#. An OMG specification name.
msgid "BPMN"
msgstr "BPMN"

#. An OMG specification name.
msgid "DMN"
msgstr "DMN"

#. Model Context Protocol — a protocol name.
msgid "MCP"
msgstr "MCP"
