#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/process-node
msgid "A BPMN flow node: an activity (a task or call activity), a gateway, or an event."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/dependency
msgid "A Declaration's `needs` entry naming another Knowledge Graph. References may point from this graph's Node Instances into the named one, never back."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/sequence-flow
msgid "A directed connection in a BPMN process from one Process Node to the next."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/subgraph
msgid "A directory entry of a Declaration: an id, a directory, and the Graph Kinds its Node Instances' kinds belong to."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/extension
msgid "A field of a Declaration, or of one of its entries, that is not defined here. A reader that does not recognise the field ignores it, and the rest of the Declaration keeps its meaning."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/asset
msgid "A file entry of a Declaration: one file about the repository itself, whose `role` field says what it is for."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/declaration
msgid "A JSON document, `<name>.json`, that gives a name and lists directory entries and file entries."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/harness
msgid "A Knowledge Graph whose Subgraphs hold Skills, Roles or Processes: what an Actor uses to work with a Knowledge Graph, including itself."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-kind
msgid "A name paired with a Node Schema."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/graph-kind
msgid "A named set of Node Kinds."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/process
msgid "A Node Instance holding a BPMN process that coordinates Tasks: its Process Nodes, joined by Sequence Flows, sit in lanes that each name a Role."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/skill
msgid "A Node Instance holding natural-language instructions an Actor follows to carry out a Task."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/role
msgid "A Node Instance naming a part an Actor takes on to carry out Tasks, and listing the Skills that part needs."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/subkind
msgid "A Node Kind whose Node Schema requires everything another Node Kind's does, so every Node that satisfies it satisfies the other too."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-instance
msgid "A Node that names its Node Kind, in `$schema` or front matter, and satisfies that kind's Node Schema."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/reference
msgid "A Node's naming of another Node by its IRI."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/actor
msgid "A person, an agent or a program that can carry out Tasks."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/node-schema
msgid "A schema a Node can be checked against: a JSON Schema, or a published external schema such as BPMN's."
msgstr ""

#: bootstrap/schemas/graph.schema.json:1
#. Glossary term definition: https://litlfred.github.io/bootstrap/0.1.0/ns#glossary/terms/task
msgid "A unit of work, stated by what it needs to begin and what it produces."
msgstr ""

