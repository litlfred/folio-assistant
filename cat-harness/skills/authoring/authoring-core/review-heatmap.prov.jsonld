    {
      "@id": "skills/authoring/authoring-core/review-heatmap.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "What each column means, and must not be read as",
      "prov:value": "| **Review coverage** | \"3 of 5 reviewed\": the section's added or changed blocks, and how many have a reviewer VERDICT on their **current** version. Shaded by what is still unreviewed. | `review-comments.json`'s `verdicts` + `blocks.json` (bean `px0t`) | \"every comment is resolved\". **Resolved comments are not a verdict**: a question answered is not a block judged. A verdict on an earlier version is shown on the block and does NOT count, so an edit after review reopens exactly the blocks it touched. A file written before verdicts existed has no `verdicts` field and reads \"no data\", never \"0 reviewed\". |",
      "cat-harness:refs": [
        "bean px0t"
      ]
    },
    {
      "@id": "skills/authoring/authoring-core/review-heatmap.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Where the QA column's data comes from",
      "prov:value": "The staging workflow first sweeps the build (its `qa_sweep` input, on by\ndefault, bean `tw61`), then runs the `folio-block-qa-summary` Tool\n(`cat-harness-tools/scripts/publish-block-qa.ts`).",
      "cat-harness:refs": [
        "bean tw61"
      ]
    },
    {
      "@id": "skills/authoring/authoring-core/review-heatmap.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Where the QA column's data comes from",
      "prov:value": "**\"Passing\" says what was judged** (bean `9791`).",
      "cat-harness:refs": [
        "bean 9791"
      ]
    },
    {
      "@id": "skills/authoring/authoring-core/review-heatmap.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Where the QA column's data comes from",
      "prov:value": "A summary published before this field existed reads \"passing (this build does\nnot say whether agent-judged criteria were run)\", never \"all judged\". A\nverdict never given is not a pass, the same rule as stale-versus-passing one\nlevel up."
    },
    {
      "@id": "skills/authoring/authoring-core/review-heatmap.md#provenance-6",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Where the QA column's data comes from",
      "prov:value": "Freshness is the QA sweep's own rule, including the `uses`-graph hash that\ngraph-scoped criteria depend on. Leaving that hash out made every\ndetangler criterion read stale straight after a sweep."
    },
    {
      "@id": "skills/authoring/authoring-core/review-heatmap.md#provenance-7",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Where the QA column's data comes from",
      "prov:value": "The QA sweep writes verdicts under the instance root (fixed by bean `s3p2`,\n2026-09-23). Before that fix, it wrote them under the directory it was run\non, so the summary still reads there second, for folios swept before the\nfix.",
      "cat-harness:refs": [
        "bean s3p2",
        "2026-09-23"
      ],
      "dcterms:date": [
        "2026-09-23"
      ]
    }
  ]
