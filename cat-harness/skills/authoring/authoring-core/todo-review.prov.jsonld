      "@id": "skills/authoring/authoring-core/todo-review.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Where the feedback came FROM — this skill starts mid-air without it",
      "prov:value": "Triage assumes somebody already had an editable copy to leave feedback **on**,\nand until 2026-09-22 nothing said how they got one. For content this repository\nholds by reference or has materialized from somewhere else, the answer is not\n\"they opened it\": materialized content is **read-only**, and browsing to it\ngives a reader nothing to annotate.",
      "cat-harness:refs": [
        "2026-09-22"
      ],
      "dcterms:date": [
        "2026-09-22"
      ]
    },
    {
      "@id": "skills/authoring/authoring-core/todo-review.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Where the feedback came FROM — this skill starts mid-air without it",
      "prov:value": "The missing first step is\n[`copy-out-materialized`](../../library/large-datasets/copy-out-materialized.md)\n(diagram:\n`cat-harness/processes/library/copy-out-materialized.bpmn`).\nThe owner's framing, 2026-09-21:\n\n> *\"this is first/early step of review process, checking out local copy to edit,\n> make comments/todos/stickies, etc on it. these feed into the comment review\n> pipeline.\"*",
      "cat-harness:refs": [
        "2026-09-21",
        "owner"
      ],
      "dcterms:date": [
        "2026-09-21"
      ]
    }
  ]
}
