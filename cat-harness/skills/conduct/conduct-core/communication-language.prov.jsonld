      "cat-harness:section": "Why this exists",
      "prov:value": "The owner, 2026-09-21: *\"part of agent first task is to determine appropriate\nlanguage when speaking/communicating regardless of context\"*.",
      "cat-harness:refs": [
        "2026-09-21",
        "owner"
      ],
