    },
    {
      "@id": "skills/conduct/conduct-core/getting-started.md#provenance-7",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "6. Anti-patterns",
      "prov:value": "6. **Switching Pages on before `gh-pages` exists, or choosing \"GitHub\n   Actions\" as the source for a workflow that pushes `gh-pages`.** That was\n   the litlfred/test plan in its #3, caught by the owner and fixed in\n   litlfred/test#5. Step 2 first; the source is \"Deploy from a branch\".",
      "cat-harness:refs": [
        "#3",
        "litlfred/test#5",
        "owner"
      ]
    }
  ]
