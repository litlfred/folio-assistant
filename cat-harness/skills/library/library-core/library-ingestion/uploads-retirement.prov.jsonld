      "cat-harness:section": "Why the library cannot be the destination",
      "prov:value": "Dropping the PDF into a promoted\nentry makes `check:l1-complete` report it — measured 2026-09-29:",
      "cat-harness:refs": [
        "2026-09-29"
      ],
      "dcterms:date": [
        "2026-09-29"
      ]
