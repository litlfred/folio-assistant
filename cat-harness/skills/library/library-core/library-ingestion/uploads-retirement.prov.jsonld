      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "What this makes true, and what it costs",
      "prov:value": "`deletion-requires-confirmation` governs any exception, and an ingest\nstep that removed its own input would be the `plj1` shape exactly."
    },
