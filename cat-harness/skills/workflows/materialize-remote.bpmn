      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Purpose_di" bpmnElement="Task_Purpose">
        <dc:Bounds x="450" y="95" width="190" height="100" />
      </bpmndi:BPMNShape>
