        <dc:Bounds x="1012" y="382" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Dispatch" bpmnElement="Start_Dispatch">
        <dc:Bounds x="142" y="512" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Validate" bpmnElement="Task_Validate">
        <dc:Bounds x="255" y="490" width="170" height="80"/>
      </bpmndi:BPMNShape>
