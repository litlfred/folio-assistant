      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G11" bpmnElement="G11">
        <di:waypoint x="1550" y="125"/>
        <di:waypoint x="1550" y="80"/>
        <di:waypoint x="1360" y="80"/>
        <di:waypoint x="1360" y="110"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G12" bpmnElement="G12">
