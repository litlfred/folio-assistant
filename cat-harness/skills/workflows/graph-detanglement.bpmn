      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Measure" bpmnElement="Task_Measure">
        <dc:Bounds x="870" y="110" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Detangled" bpmnElement="GW_Detangled">
        <dc:Bounds x="1125" y="125" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Move" bpmnElement="Task_Move">
        <dc:Bounds x="870" y="270" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Isolate" bpmnElement="Task_Isolate">
        <dc:Bounds x="1270" y="110" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Isolated" bpmnElement="GW_Isolated">
        <dc:Bounds x="1525" y="125" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Propose" bpmnElement="Task_Propose">
        <dc:Bounds x="1670" y="110" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Authorise" bpmnElement="Task_Authorise">
        <dc:Bounds x="1670" y="560" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Declined" bpmnElement="End_Declined">
        <dc:Bounds x="1952" y="582" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Extract" bpmnElement="Task_Extract">
        <dc:Bounds x="2070" y="110" width="180" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Extracted" bpmnElement="End_Extracted">
        <dc:Bounds x="2322" y="132" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Unknown" bpmnElement="End_Unknown">
        <dc:Bounds x="932" y="422" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_G0" bpmnElement="G0">
        <di:waypoint x="158" y="150"/>
        <di:waypoint x="220" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G1" bpmnElement="G1">
        <di:waypoint x="400" y="150"/>
        <di:waypoint x="470" y="150"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G2" bpmnElement="G2">
        <di:waypoint x="650" y="150"/>
