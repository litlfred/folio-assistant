      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G13" bpmnElement="G13">
        <di:waypoint x="1760" y="190"/>
        <di:waypoint x="1760" y="560"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_G14" bpmnElement="G14">
        <di:waypoint x="1850" y="580"/>
