    {
      "@id": "skills/process/process-core/decision-methodology-selector.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "What this does NOT cover — bean `7e59`, measured 2026-09-30",
      "prov:value": "The title of the bean that commissioned this skill claims it *\"covers all\nmethodology families with when-to-use criteria\"*. Checked against the three\nsources now that they are in `library/`, that does not hold, and the honest\nshape is:"
    },
    {
      "@id": "skills/process/process-core/decision-methodology-selector.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "What this does NOT cover — bean `7e59`, measured 2026-09-30",
      "prov:value": "**Owner ruled 2026-09-30: FAMILY plus prose.** The selector returns a\nmethodology node that exists — `mcdm-aggregation`,\n`probabilistic-decision-analysis`, `kepner-tregoe`, `dmn` and the rest — and\nnames the within-family method in `rationale`, as prose. The 23 rows above are\nmaterial for that prose. They are not a menu of returnable answers, and no\nindividual method gets a node.",
      "cat-harness:refs": [
        "2026-09-30"
      ],
      "dcterms:date": [
        "2026-09-30"
      ]
