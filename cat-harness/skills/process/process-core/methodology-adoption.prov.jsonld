    {
      "@id": "skills/process/process-core/methodology-adoption.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Adopting a methodology, and choosing between them",
      "prov:value": "The owner's framing, 2026-09-20, and it is the whole design:",
      "cat-harness:refs": [
        "2026-09-20"
      ],
      "dcterms:date": [
        "2026-09-20"
      ]
    },
    {
      "@id": "skills/process/process-core/methodology-adoption.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "date",
      "cat-harness:section": "Parallel, not composable",
      "prov:value": "Two or more methodologies may answer the same question. **Do not blend them.** A\ncomposite — this one's vocabulary, that one's record, a third one's filter — is a\nhouse method that cites nobody, and it inherits none of their authority while\nclaiming all of it. This exact mistake was made and corrected on 2026-09-20: an\nanalysis proposed \"adopt A's vocabulary + B's record + C's filter\", and the answer\nwas that they are parallel tracks selected by context.",
      "cat-harness:refs": [
        "2026-09-20"
      ],
      "dcterms:date": [
        "2026-09-20"
      ]
    },
    {
      "@id": "skills/process/process-core/methodology-adoption.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Node, skill, or both? — the question RACI made somebody ask",
      "prov:value": "An adopted methodology can produce up to two artefacts, and which ones is not\nobvious. Settled by the owner 2026-09-22 (bean `2xfl`), after `raci` spent\nmonths as a skill with no node and the methodology graph could not see the one\nmethodology this repository uses on every diagram.",
      "cat-harness:refs": [
        "bean 2xfl",
        "2026-09-22"
      ],
      "dcterms:date": [
        "2026-09-22"
      ]
    },
    {
      "@id": "skills/process/process-core/methodology-adoption.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Node, skill, or both? — the question RACI made somebody ask",
      "prov:value": "**A methodology in use with no node is invisible to the graph**, which is what\n`2xfl` recorded: `check:methodology-evidence` counted the nodes and RACI was\nnot among them, so a reader asking \"what methodologies does this repository\nadopt?\" got an answer that omitted one they had just used."
    },
    {
      "@id": "skills/process/process-core/methodology-adoption.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Extract the PROCESS, not the paper's tools",
      "prov:value": "**A source that presents a method through an implementation is presenting two\nthings, and only one of them is the methodology.** The owner, 2026-09-23, on\ningesting a tool paper:",
      "cat-harness:refs": [
        "2026-09-23"
      ],
      "dcterms:date": [
        "2026-09-23"
      ]
    },
    {
      "@id": "skills/process/process-core/methodology-adoption.md#provenance-6",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "An origin nobody can open is not evidence",
      "prov:value": "**Measured 2026-09-22: six methodologies cited an origin and not one of those\nsources was in any declared library.** Every citation resolved against nothing\n— the shape the retired skill `roles:` field cost 260 dangling values (`qif9`),\non the one kind whose entire justification is being somebody else's named,\nexternal work.",
      "cat-harness:refs": [
        "bean qif9",
        "2026-09-22"
      ],
      "dcterms:date": [
        "2026-09-22"
      ]
    }
  ]
}
