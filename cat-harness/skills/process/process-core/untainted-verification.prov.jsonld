    {
      "@id": "skills/process/process-core/untainted-verification.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Untainted verification — the producer never writes the verdict",
      "prov:value": "It is generic on purpose —\n`translation-manager.md` §\"The agentic round trip\" is where it was first\nwritten down, in translation vocabulary, and taking the translation out changed\nnothing structural."
    },
    {
      "@id": "skills/process/process-core/untainted-verification.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Three states, and the third is what lets it gate",
      "prov:value": "State 2 is the owner's ruling of 2026-09-21, and without it the discipline\ncannot gate anywhere.",
      "cat-harness:refs": [
        "2026-09-21"
      ],
      "dcterms:date": [
        "2026-09-21"
      ]
    },
    {
      "@id": "skills/process/process-core/untainted-verification.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Where the verdict is kept: the attestation store, not the derived file",
      "prov:value": "The derived `test/results/` file beside\nthem is a working copy whose record lives on the `qa-reports` branch, and a\nregeneration cannot reproduce an agent ruling (arc `3fva`, owner ruling D2\n(a)).",
      "cat-harness:refs": [
        "bean 3fva",
        "D2"
      ]
    },
    {
      "@id": "skills/process/process-core/untainted-verification.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Where the verdict is kept: the attestation store, not the derived file",
      "prov:value": "`recordUntainted` writes the store **first**, through the same\n`resolvePrior` / `finalizeCriteria` API as every other attesting writer (bean\n`8iqt`), and refreshes the derived report only if one already exists — it\nnever invents one."
    },
    {
      "@id": "skills/process/process-core/untainted-verification.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Why the instrument is the thing to watch",
      "prov:value": "A measurement shipped with a `description` explaining its own failures away as\nexpected *\"with limited vocabulary back-translator\"*."
    },
    {
      "@id": "skills/process/process-core/untainted-verification.md#provenance-6",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "This is one rule with two homes",
      "prov:value": "Guideline methodology separates the systematic\nreview team from the guideline development group for the same reason, and\n`8rwa` carries the identical rule into evidence-based literature review for\nliving guidelines."
    },
    {
      "@id": "skills/process/process-core/untainted-verification.md#provenance-7",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Related",
      "prov:value": "- `translation-manager.md` §\"The agentic round trip\" — the first instance, and\n  the translation-specific drift definition that does *not* generalise.\n- `permissions.json` `qa-reporting` — who may emit a verdict at all. Bean\n  `a58y` gives it its first consumer.\n- `pipeline/untainted-verification.ts` — the recorder. It deliberately\n  does **not** call a model: the payload is written by whatever ran the\n  parties, so recording works the same for two subagents, two API calls, or two\n  people.",
      "cat-harness:refs": [
        "bean a58y"
      ]
    }
  ]
