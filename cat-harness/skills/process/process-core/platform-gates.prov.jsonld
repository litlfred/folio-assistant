    {
      "@id": "skills/process/process-core/platform-gates.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Why this skill does not contain a list of gates",
      "prov:value": "**This is not a hypothetical drift.** The agent who wrote this skill had spent\nthat session running **17** gates by hand, repeatedly, and reporting them as\n\"the gate sweep\" in commit messages and PR bodies."
    },
    {
      "@id": "skills/process/process-core/platform-gates.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "date",
      "cat-harness:section": "Why the CI workflow is the authority, and `package.json` is not",
      "prov:value": "Measured 2026-09-19: of 33 `check:` / `:check`\nscripts, **21 appeared in no workflow at all**.",
      "cat-harness:refs": [
        "2026-09-19"
      ],
      "dcterms:date": [
        "2026-09-19"
      ]
    },
