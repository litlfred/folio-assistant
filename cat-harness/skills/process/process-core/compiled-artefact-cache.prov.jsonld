      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "The warm-start principle: Cache the intermediates, not just the output",
      "prov:value": "Owner decision (2026-10-01): `input-cache/txcache/` goes on the `fhir-ast` branch alongside the AST files.",
      "cat-harness:refs": [
        "2026-10-01"
      ],
