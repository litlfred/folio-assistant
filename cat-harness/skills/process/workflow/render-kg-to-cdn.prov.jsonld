    {
      "@id": "skills/process/workflow/render-kg-to-cdn.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Name the Tool, not its steps",
      "prov:value": "**A target may need provisioning before it accepts a push; the Tool's\nsubprocess owns that.** For GitHub Pages a `gh-pages` branch has to exist\nbefore Pages can be switched on to serve it (owner, 2026-10-01), so the\n`gh-pages` subprocess creates it first — the general step does not.",
      "cat-harness:refs": [
        "2026-10-01"
      ],
