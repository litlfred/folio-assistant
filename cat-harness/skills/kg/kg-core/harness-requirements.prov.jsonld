      ]
    },
    {
      "@id": "skills/kg/kg-core/harness-requirements.md#provenance-26",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Why this one takes no `exempt`",
      "prov:value": "**`hfkl` is the proof rather than the exception.** `bootstrap` is excused a\nvisualiser — *\"it is exception to harness/layer not having visualtion/workflow\nvisualizer. but it must have its json/jsonld… that is its existence.\"*",
      "cat-harness:refs": [
        "bean hfkl"
      ]
