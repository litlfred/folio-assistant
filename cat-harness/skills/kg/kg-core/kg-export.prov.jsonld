      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "A partial graph must never pass for a whole one",
      "prov:value": "This is the rule, and it was learned by breaking it in the module that states\nit."
    },
    {
