      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Deterministic, proved",
      "prov:value": "The\ngate builds twice and requires one sha256. Measured 2026-10-03: two separate\nprocesses gave one sha256 for each of the four slices, and the gate re-proves\nit on every run.",
      "cat-harness:refs": [
        "2026-10-03"
      ],
      "dcterms:date": [
        "2026-10-03"
      ]
    },
