      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Whose nodes — an instance publishes its own",
      "prov:value": "**The policy is [`instance-publication`](instance-publication.md) §\"What each\ninstance publishes — graph, address, schema, and what is stripped\"**: which\ninstance publishes which document where, the owner's 2026-10-05 ruling\n(option B; bean `4ak5` item 2).",
      "cat-harness:refs": [
        "bean 4ak5",
        "2026-10-05"
      ],
      "dcterms:date": [
        "2026-10-05"
      ]
    },
    {
