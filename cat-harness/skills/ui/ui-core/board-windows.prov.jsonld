    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Semantic zoom is the GLASS's, not the board's — since 2026-10-02",
      "prov:value": "A slot is its closed tile at **every** width, so there is no width at which a board slot shows more words, and **semantic zoom no longer runs on the board**."
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "One sticky, one icon row, in one order",
      "prov:value": "A link the sticky cannot serve is absent, never dead (`pb04`).",
      "cat-harness:refs": [
        "`pb04`"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Pin is a toggle onto the FOLIO glass",
      "prov:value": "The owner, 2026-10-02, verbatim: *\"pin to glass should pin to folio glass. its not working right.\"*",
      "cat-harness:refs": [
        "owner",
        "2026-10-02"
      ],
      "dcterms:date": [
        "2026-10-02"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-6",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Pin is a toggle onto the FOLIO glass",
      "prov:value": "- The old pin store is migrated into the folio once, so no reader's pin is lost; nothing writes it any more."
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-7",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Send to fsh-guts asks first",
      "prov:value": "The inverse is Restore in fsh-guts (`l4zi`).",
      "cat-harness:refs": [
        "`l4zi`"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-8",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "The chrome is fixed; the kind fills it in",
      "prov:value": "`pb04` is why: a dead `[edit]` 404s for exactly the reader who cannot edit, which reads as *\"this page is broken\"* rather than *\"you cannot do this\"*.",
      "cat-harness:refs": [
        "`pb04`"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-9",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Closing must have a reachable inverse",
      "prov:value": "Bean `l4zi`: the landing board's close set `hidden` and stopped.",
      "cat-harness:refs": [
        "Bean `l4zi`"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-10",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Closing must have a reachable inverse",
      "prov:value": "The glass's tile strip starts slid away (owner, 2026-10-01), and that is acceptable for one reason: its \"Show tiles (N)\" tab stays in view, in the strip's own position, and the same tab hides the tiles again.",
      "cat-harness:refs": [
        "owner",
        "2026-10-01"
      ],
      "dcterms:date": [
        "2026-10-01"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-11",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "The listing is the ARTEFACT and the board is the overlay",
      "prov:value": "Owner: *\"this dymanic moving state is overlayed, its an 'extra'. on stndard folio just simple tile based listing.\"*",
      "cat-harness:refs": [
        "Owner"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-12",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "date",
      "cat-harness:section": "The listing is the ARTEFACT and the board is the overlay",
      "prov:value": "Those are different claims and the second one was true here while the first was false: measured 2026-09-21, every note on an ordinary page was built by `docs-ui.js` from a `fetch` of `assets/todos/index.json`, so a reader with JavaScript off got no note, no count, and no hint that notes existed.",
      "cat-harness:refs": [
        "2026-09-21"
      ],
      "dcterms:date": [
        "2026-09-21"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-13",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "The listing is the ARTEFACT and the board is the overlay",
      "prov:value": "It does not delete it, hide it from assistive technology, or `display: none` it — bean `l4zi` again, one layer out: a listing the board removed would have no way back while the board is open.",
      "cat-harness:refs": [
        "bean `l4zi`"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-14",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "proposal",
      "cat-harness:section": "An asset has THREE states, not two",
      "prov:value": "R27 says *\"materialized should live in folio\"*, and the folio is the reader's REPOSITORY, of which `library/` and `uploads/` are already declared parts — both carry `dependents: \"reproduce\"`, which is the schema saying *this is the reader's own copy*.",
      "cat-harness:refs": [
        "R27"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-15",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "An asset has THREE states, not two",
      "prov:value": "This is `l4zi` one level out, and the shape is easy to miss because no single screen looks wrong: the inverse of **close** must be reachable, and here it is reachable from a **different surface** than the one that closed it.",
      "cat-harness:refs": [
        "`l4zi`"
      ]
    },
    {
      "@id": "skills/ui/ui-core/board-windows.md#provenance-16",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "Two settings panels, two names, each points to the other",
      "prov:value": "Owner, 2026-10-01, choosing option 2 of 4 on bean `ob3m` finding 12.",
      "cat-harness:refs": [
        "bean `ob3m`",
        "Owner",
        "2026-10-01"
      ],
      "dcterms:date": [
        "2026-10-01"
      ]
    }
