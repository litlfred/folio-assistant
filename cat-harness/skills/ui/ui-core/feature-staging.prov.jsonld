    {
      "@id": "skills/ui/ui-core/feature-staging.md#provenance-29",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Before you hand a staging URL to a person",
      "prov:value": "The reason it is a rule: an agent relayed one preview URL to the owner **five\ntimes in a session** without checking anything, each time straight off the\nbot's comment. Whether the site served it was never established in either\ndirection."
    },
    {
      "@id": "skills/ui/ui-core/feature-staging.md#provenance-30",
