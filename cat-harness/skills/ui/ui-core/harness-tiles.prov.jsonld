      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-5",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "date",
      "cat-harness:section": "Which harness `/` is — the landing is `index-config`'s rule (issue #1904)",
      "prov:value": "Since 2026-10-07 the root `index.config.json` says it as `site.landing` — an instance name or `\"hub\"`. A folio without an index keeps the 2026-10-02 per-config `site.landing` flag as its fallback.",
      "cat-harness:refs": [
        "2026-10-07",
        "2026-10-02"
      ],
