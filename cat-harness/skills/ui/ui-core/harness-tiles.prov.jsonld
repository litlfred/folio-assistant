    },
    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-23",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "The navbar icon row is DECLARED, and three states is not two",
      "prov:value": "Owner, 2026-09-22: *\"max is 6 and one for todos one for beans one for processes viewer/ (the factory flow) one for KG viewer\"*, and then, on where the list lives: *\"should be in each harness config which are shown (so some could show none, but make this default in cat-harness that is inherited).\"*",
      "cat-harness:refs": [
        "Owner",
        "2026-09-22"
      ],
      "dcterms:date": [
        "2026-09-22"
      ]
    },
    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-24",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "The navbar icon row is DECLARED, and three states is not two",
      "prov:value": "The cap was six until 2026-10-02, when the owner put the fsh-guts trashcan in the row *\"with the others\"* (#1925) rather than in place of one. (owner, 2026-10-02) — so that dialog says \"the fish in the icon row\" only when this icon is on the page, and points at Page settings otherwise.",
      "cat-harness:refs": [
        "owner",
        "#1925",
        "2026-10-02"
      ],
      "dcterms:date": [
        "2026-10-02"
      ]
    },
    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-25",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "The navbar icon row is DECLARED, and three states is not two",
      "prov:value": "| declared | means | |---|---| | absent | **inherit** — walk `needs`, site owner as the floor | | `[]` | **show none**, which the owner asked for by name | | a list | this instance's own answer |",
      "cat-harness:refs": [
        "owner"
      ]
    },
    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-26",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "The navbar icon row is DECLARED, and three states is not two",
      "prov:value": "They come from the instance's own declared visualisations plus `siteLinks`, so an icon whose graph this instance does not publish gets no href and renders as a **non-link** — `pb04`, the same choice the tabs' graph list makes.",
      "cat-harness:refs": [
        "`pb04`"
      ]
    },
    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-27",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "date",
      "cat-harness:section": "The theme avatar: the assignment is theme-mediated, and I got this wrong once",
      "prov:value": "**This was reported on 2026-09-22 as \"an assignment nobody has made\", and gap 6 was left unwired on that basis.**",
      "cat-harness:refs": [
        "2026-09-22"
      ],
