    },
    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-33",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "On a folio's own site, a tile describes the FOLIO (issue #2263)",
      "prov:value": "(issue #46, found on litlfred/ihris, whose site is generated rather than a Jekyll tree) needs four more things, and each is the platform's answer, not a folio's bridge:",
      "cat-harness:refs": [
        "#46"
