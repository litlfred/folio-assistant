      ]
    },
    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-19",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "A TILE IS ONE OF TWO KINDS, and they bind to different things",
      "prov:value": "A tile already takes *\"the avatar's declared hue\"*, and the owner's 2026-09-20 line says the same thing from the other side — *\"defaults to theme, but new can be changed\"*.",
      "cat-harness:refs": [
