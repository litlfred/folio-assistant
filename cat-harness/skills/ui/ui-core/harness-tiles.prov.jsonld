    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-32",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "On a folio's own site, a tile describes the FOLIO (issue #2263)",
      "prov:value": "`compose-docs --shell` now leaves out every `assets/**.json` that declares a headline `tile` count, the same way it already blanked `_includes/generated/` (#2235 F1).",
      "cat-harness:refs": [
        "#2235"
