    },
    {
      "@id": "skills/ui/ui-core/harness-tiles.md#provenance-34",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "The glass strip — pinned first, and \"+N more\" counts the rest",
      "prov:value": "That is the rule, and the owner's ruling on bean `ob3m` finding 10 (2026-10-01, option 1 of 4, *\"Pinned tiles first, plus '+N more'\"*) is how the glass's bottom strip keeps it.",
      "cat-harness:refs": [
        "bean `ob3m`",
        "owner's",
