    {
      "@id": "skills/ui/ui-core/staging-review.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "The deep-link rule — every request for feedback",
      "prov:value": "Owner, 2026-10-14: *\"update\nyour feedback skills as part of crdm, SDLC, other content authoring processes,\nif there is a staging URL provided, ideally with a deep link to the relevant\nfeatures being edited or shown\"*, and the request it repeats, beans `u1os`,\n`28k2` and `g4dv`.",
      "cat-harness:refs": [
        "bean u1os",
        "2026-10-14"
      ],
      "dcterms:date": [
        "2026-10-14"
      ]
    },
    {
      "@id": "skills/ui/ui-core/staging-review.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "The deep-link rule — every request for feedback",
      "prov:value": "Owner, 2026-10-14: *\"it is a\n   Judgement as to the context which one to use. more than one can be\n   used.\"* Ask where the person will look.",
      "cat-harness:refs": [
        "2026-10-14"
      ],
      "dcterms:date": [
        "2026-10-14"
      ]
    },
    {
      "@id": "skills/ui/ui-core/staging-review.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Output",
      "prov:value": "A table of URLs\n   tells a reviewer *where* to look; only the narrative tells them *what\n   they are looking for*, and a reviewer who has not read the code cannot\n   reconstruct it from a filename (owner, 2026-10-01: *\"provide/show\n   before/after, provide narrative description of change\"*).\n2.",
      "cat-harness:refs": [
        "2026-10-01"
      ],
      "dcterms:date": [
        "2026-10-01"
      ]
    },
    {
      "@id": "skills/ui/ui-core/staging-review.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "The third column is the one with value",
      "prov:value": "That failure is on the record: a\ncontrast defect survived two days behind a tile nobody clicked (bean `rptk`),\nbecause the gate that swept the page never opened the view.",
      "cat-harness:refs": [
        "bean rptk"
      ]
    },
    {
      "@id": "skills/ui/ui-core/staging-review.md#provenance-5",
