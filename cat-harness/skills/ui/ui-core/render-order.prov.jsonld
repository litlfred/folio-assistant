      "@id": "skills/ui/ui-core/render-order.md#provenance-4",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "history",
      "cat-harness:section": "Three outcomes, and `pending` is the third",
      "prov:value": "It exists because the first draft did not have it: the bootstrap step was written as `kg-export --root bootstrap`, and `kg-export` has no `--root` flag."
    },
