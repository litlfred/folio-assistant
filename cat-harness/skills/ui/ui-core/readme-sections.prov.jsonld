      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "`readme:toc` — every harness README's own table of contents",
      "prov:value": "Owner, 2026-09-30: *\"generated README.md ... missing TOC, probably need on all harnesses\"*.",
      "cat-harness:refs": [
