    {
      "@id": "skills/ui/ui-core/readme-sections.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "issue",
      "cat-harness:section": "Which README, and the `--dir` flag",
      "prov:value": "Before #592 the two were one file (`cat-harness` declared the root's README with `scope: \"repository\"`), so the difference could not show.",
      "cat-harness:refs": [
        "#592"
      ]
    },
    {
      "@id": "skills/ui/ui-core/readme-sections.md#provenance-3",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "Which README, and the `--dir` flag",
      "prov:value": "Its root declares no instance (owner, 2026-10-08), so nothing could own the file, and the owner ruled on 2026-10-09 that it and the root `AGENTS.md` are rendered: `bun run cat index:render` writes both — with the `CLAUDE.md` and `GEMINI.md` stubs — from `index.config.json`, each instance's declared `agent-instructions` and `instance-readme` assets, bootstrap's `AGENTS.md`, and the sections above, and `index:render:check` fails when any of the four is not its current output.",
      "cat-harness:refs": [
        "owner",
        "2026-10-08",
        "2026-10-09"
      ],
      "dcterms:date": [
        "2026-10-08",
        "2026-10-09"
      ]
    },
    {
      "@id": "skills/ui/ui-core/readme-sections.md#provenance-4",
