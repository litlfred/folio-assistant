      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "`cat-harness:instances` — the root README indexes every instance",
      "prov:value": "Added 2026-09-20 (issue #592). The owner:",
      "cat-harness:refs": [
        "owner",
