      "cat-harness:provenanceKind": "owner-decision",
      "cat-harness:section": "3. Choose the theme — a judgement, not a lookup",
      "prov:value": "> no formal role/theme mapping per se. that is authoring (human/agentic)\n> decision/judgement\n>\n> — owner, 2026-09-20",
      "cat-harness:refs": [
        "2026-09-20"
      ],
