    {
      "@id": "editorial/skills/editorial-audits/voice-overlay-review.md#provenance-1",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "The rule's citation is the argument, so open it",
      "prov:value": "The\n   only defence is that the quote is right there — if the quote does not support\n   the rule, the rule is the defect and the bean goes against the voice, not\n   against the block."
    },
    {
      "@id": "editorial/skills/editorial-audits/voice-overlay-review.md#provenance-2",
      "@type": "prov:Entity",
      "cat-harness:provenanceKind": "bean",
      "cat-harness:section": "A mechanical match is a question",
      "prov:value": "A `pattern` is a regex over text; it does not know what the block is about. This\nplatform has paid for that three times and the measurements are worth carrying:\n\n- `voice-scholarly-default` fired on ten documentation pages whose register is\n  correctly second-person (bean `hbsh`).\n- `voice-editorializing` fired four times on `merely` inside a comparative,\n  where the contrast was the block's claim (bean `nwus`).\n- `voice-editorializing` flags `clearly`, and the exemplar the Milnor gate is\n  named after uses it fourteen times as proof economy (bean `2t41`).",
      "cat-harness:refs": [
        "bean hbsh",
        "bean nwus",
        "bean 2t41"
      ]
    },
