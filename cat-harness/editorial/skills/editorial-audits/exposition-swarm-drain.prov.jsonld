      "cat-harness:section": "7. Interaction with the flag-preservation guard",
      "prov:value": "Per\n`qa-flag-preservation-audit.ts` (PR #3289), a distrusted `expo-milnor-clarity`\nverdict must be **re-audited**, never `n/a`-cleared.",
      "cat-harness:refs": [
        "#3289"
      ]
    }
