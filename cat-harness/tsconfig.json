{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "folio-render/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
