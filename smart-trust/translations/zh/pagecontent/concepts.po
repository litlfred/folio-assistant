msgstr "卫生专业教育认证机构"

#: input/pagecontent/concepts.md:22
msgid "Health Professions Education Accreditation Agency;"
msgstr "卫生专业教育认证机构；"

#: input/pagecontent/concepts.md:57
msgid "Health Services Licensing Agency"
msgstr "卫生服务许可机构"

#: input/pagecontent/concepts.md:23
msgid "Health Services Licensing Agency; or"
msgstr "卫生服务许可机构；或"

