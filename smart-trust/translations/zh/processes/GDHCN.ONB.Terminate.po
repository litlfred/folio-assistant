#: input/business-processes/GDHCN.ONB.Terminate.bpmn:65
#. Diagram label
msgid "30 days after the notice"
msgstr "通知后 30 天"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:45
#. Diagram element documentation
msgid "Authorized WHO staff of the GDHCN Secretariat (Framework V, VI). ActorDefinition http://smart.who.int/trust/ActorDefinition/GDHCNSecretariat."
msgstr "GDHCN 秘书处经授权的 WHO 工作人员（《框架》第 V、VI 节）。ActorDefinition http://smart.who.int/trust/ActorDefinition/GDHCNSecretariat."

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:18
#. Diagram label
msgid "Business Owner Representative"
msgstr "业务负责人代表"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:25
#. Diagram label
msgid "Decided to leave"
msgstr "决定退出"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:41
#. Diagram label
msgid "End a participation"
msgstr "终止参与"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:6
#. Diagram element documentation
msgid "End participation in one or more Trust Domains. Framework XV.1-3; XV.4 (the Secretariat ceases the GDHCN) is out of scope."
msgstr "终止对一个或多个信任域的参与。《框架》第 XV.1-3 节；XV.4（秘书处终止 GDHCN）不在范围内。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:42
#. Diagram element documentation
msgid "Framework XV.1-3."
msgstr "《框架》第 XV.1-3 节。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:30
#. Diagram element documentation
msgid "Framework XV.1: at least 30 days ahead."
msgstr "《框架》第 XV.1 节：至少提前 30 天。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:26
#. Diagram element documentation
msgid "Framework XV.1: for one or more Trust Domains."
msgstr "《框架》第 XV.1 节：针对一个或多个信任域。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:66
#. Diagram element documentation
msgid "Framework XV.1: termination takes effect 30 days after the Secretariat receives the notice."
msgstr "《框架》第 XV.1 节：终止在秘书处收到通知 30 天后生效。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:16
#. Diagram element documentation
msgid "Framework XV.1."
msgstr "《框架》第 XV.1 节。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:61
#. Diagram element documentation
msgid "Framework XV.2."
msgstr "《框架》第 XV.2 节。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:76
#. Diagram element documentation
msgid "Framework XV.3: at its sole discretion."
msgstr "《框架》第 XV.3 节：由其全权酌定。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:80
#. Diagram element documentation
msgid "Framework XV.3. The Framework sets no notice period for this case."
msgstr "《框架》第 XV.3 节。《框架》未对此情形规定通知期。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:7
#. Diagram label
msgid "GDHCN Participant"
msgstr "GDHCN 参与方"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:44
#. Diagram label
msgid "GDHCN Secretariat"
msgstr "GDHCN 秘书处"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:10
#. Diagram label
msgid "GDHCN Secretariat (WHO)"
msgstr "GDHCN 秘书处（WHO）"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:60
#. Diagram label
msgid "Inform the other Participants"
msgstr "告知其他参与方"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:15
#. Diagram label
msgid "Leave the GDHCN"
msgstr "退出 GDHCN"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:34
#. Diagram label
msgid "Notice given"
msgstr "已发出通知"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:55
#. Diagram label
msgid "Notice received"
msgstr "已收到通知"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:71
#. Diagram label
msgid "Participation ended"
msgstr "参与已终止"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:84
#. Diagram label
msgid "Participation terminated"
msgstr "参与已被终止"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:75
#. Diagram label
msgid "Secretariat decides to terminate"
msgstr "秘书处决定终止"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:29
#. Diagram label
msgid "Send written notice by diplomatic channel"
msgstr "通过外交渠道发送书面通知"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:19
#. Diagram element documentation
msgid "Sends the Statement of Interest and the Letter of Application; may meet WHO in person (Framework IX). ActorDefinition http://smart.who.int/trust/ActorDefinition/BusinessOwnerRepresentative."
msgstr "发送意向声明和申请函；可以与 WHO 当面会晤（《框架》第 IX 节）。ActorDefinition http://smart.who.int/trust/ActorDefinition/BusinessOwnerRepresentative."

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:79
#. Diagram label
msgid "Terminate the participation"
msgstr "终止该参与"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:8
#. Diagram element documentation
msgid "The Eligible GDHCN Participant (Framework VII)."
msgstr "合格 GDHCN 参与方（《框架》第 VII 节）。"

#: input/business-processes/GDHCN.ONB.Terminate.bpmn:11
#. Diagram element documentation
msgid "The GDHCN Secretariat at WHO (Framework V, VI)."
msgstr "设在 WHO 的 GDHCN 秘书处（《框架》第 V、VI 节）。"
