msgid "P13, <a0>P15</a0>"
msgstr "P13, <a0>P15</a0>"

#: input/pagecontent/dsa_processes.md:129
msgid "P15. Dispute and breach handling {#p15}"
msgstr "P15. Tratamiento de controversias e incumplimientos {#p15}"

#: input/pagecontent/dsa_processes.md:65
msgid "P3. Register parties and keys with a trust anchor {#p3}"
msgstr "P3. Registrar las partes y las claves ante un ancla de confianza {#p3}"

