#: input/pagecontent/dsa_processes.md:17
msgid "\"Computable\" changes one thing: where the access rule comes from."
msgstr "\"Computable\" cambia una sola cosa: de dónde procede la regla de acceso."

#: input/pagecontent/dsa_processes.md:39
msgid "\"Data provider\" and \"data recipient\" are our words. No actor in this guide has those names."
msgstr "\"Proveedor de datos\" y \"receptor de datos\" son términos nuestros. Ningún actor de esta guía tiene esos nombres."

#: input/pagecontent/dsa_processes.md:50
msgid "<a0>DID Core 1.0</a0>, did:web, JsonWebSignature2020 proof (<a1>DID Trustlist v2</a1>)"
msgstr "<a0>DID Core 1.0</a0>, did:web, prueba JsonWebSignature2020 (<a1>DID Trustlist v2</a1>)"

#: input/pagecontent/dsa_processes.md:50
msgid "<a0>Onboarding Process</a0>"
msgstr "<a0>Proceso de integración</a0>"

#: input/pagecontent/dsa_processes.md:37
msgid "<a0>Receiver</a0>; any system that checks a party's signature or TLS certificate"
msgstr "<a0>Receptor (Receiver)</a0>; cualquier sistema que compruebe la firma o el certificado TLS de una parte"

#: input/pagecontent/dsa_processes.md:61
msgid "<a0>RFC 5914</a0> (Trust Anchor Format) states \"this root is trusted\" in ASN.1 only. It has no JSON form. A local list of X.509 roots is therefore kept as PEM files plus RFC 5280 checks."
msgstr "<a0>RFC 5914</a0> (Trust Anchor Format) expresa \"esta raíz es de confianza\" solo en ASN.1. No tiene forma JSON. Por ello, una lista local de raíces X.509 se mantiene como archivos PEM más comprobaciones conforme a RFC 5280."

#: input/pagecontent/dsa_processes.md:205
msgid "<a0>smart-trust-phw, process D</a0>"
msgstr "<a0>smart-trust-phw, proceso D</a0>"

#: input/pagecontent/dsa_processes.md:206
