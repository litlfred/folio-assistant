#: input/pagecontent/use_cases.md:8
#: input/pagecontent/use_cases.md:19
#: input/pagecontent/use_cases.md:30
msgid "ACTORS:"
msgstr "ACTORES:"

#: input/pagecontent/use_cases.md:10
#: input/pagecontent/use_cases.md:22
msgid "Aggregating/Federated PKD – trusted aggregation of public keys and trusted services from nodes"
msgstr "PKD de agregación/federado: agregación fiable de claves públicas y servicios de confianza procedentes de los nodos"

#: input/pagecontent/use_cases.md:32
msgid "Business Rules Library – trusted service, provided by a node within a trust network, to share business rules using Clinical Quality Language (CQL) specification​"
msgstr "Biblioteca de reglas de negocio: servicio de confianza, proporcionado por un nodo de una red de confianza, para compartir reglas de negocio mediante la especificación Clinical Quality Language (CQL)​"

#: input/pagecontent/use_cases.md:26
msgid "Dynamic Business Rule Validation​"
msgstr "Validación dinámica de reglas de negocio​"

#: input/pagecontent/use_cases.md:3
msgid "Federated PKD Aggregation"
msgstr "Agregación en un PKD federado"

#: input/pagecontent/use_cases.md:14
msgid "Federated Verification"
msgstr "Verificación federada"

#: input/pagecontent/use_cases.md:5
msgid "Keys from Local PKDs are aggregated in a federated PKD for use by verification applications."
msgstr "Las claves de los PKD locales se agregan en un PKD federado para que las utilicen las aplicaciones de verificación."

#: input/pagecontent/use_cases.md:9
#: input/pagecontent/use_cases.md:21
msgid "Local PKD – acts as a node within a trust network​"
msgstr "PKD local: actúa como nodo de una red de confianza​"

#: input/pagecontent/use_cases.md:38
msgid "OUT OF SCOPE: consolidating business rules across trust network members​"
msgstr "FUERA DEL ALCANCE: consolidación de las reglas de negocio entre los miembros de la red de confianza​"

#: input/pagecontent/use_cases.md:34
msgid "PRE-CONDITION: Verification Application has passed Verification Workflow​"
msgstr "CONDICIÓN PREVIA: la aplicación de verificación ha superado el flujo de trabajo de verificación​"

#: input/pagecontent/use_cases.md:12
msgid "TRANSACTION: Mirror Local PKD"
msgstr "TRANSACCIÓN: Replicar el PKD local"

#: input/pagecontent/use_cases.md:24
msgid "TRANSACTION: Request PKD"
msgstr "TRANSACCIÓN: Solicitar el PKD"

#: input/pagecontent/use_cases.md:36
msgid "TRANSACTIONS: Request Business Rule Updates, Execute Business Rule​"
msgstr "TRANSACCIONES: Solicitar actualizaciones de reglas de negocio, Ejecutar regla de negocio​"

#: input/pagecontent/use_cases.md:20
msgid "Universal Verification Application –  verifies health documents using Public Key Infrastructure (PKI)​"
msgstr "Aplicación de verificación universal: verifica documentos de salud mediante la infraestructura de clave pública (PKI)​"

#: input/pagecontent/use_cases.md:31
msgid "Universal Verification Application – executes business rules against verified health documents​"
msgstr "Aplicación de verificación universal: ejecuta reglas de negocio sobre documentos de salud verificados​"

#: input/pagecontent/use_cases.md:1
msgid "Use Cases"
msgstr "Casos de uso"

#: input/pagecontent/use_cases.md:28
msgid "Validate one or more verified COVID credential against a dynamic business rule.​"
msgstr "Validar una o más credenciales de COVID verificadas con respecto a una regla de negocio dinámica.​"

#: input/pagecontent/use_cases.md:16
msgid "Verifications can cryptographically verify health credentials using keys retrieved from the Federated PKD."
msgstr "Las verificaciones pueden comprobar criptográficamente las credenciales de salud mediante claves obtenidas del PKD federado."
