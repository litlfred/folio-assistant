msgstr "Técnico"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:roles.who.initials"
msgid "WHO"
msgstr "OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:roles.who.name"
msgid "WHO"
msgstr "OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:roles.who.title"
msgid "WHO does this part"
msgstr "Esta parte la hace la OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.brief"
msgid "The SCA's private key is the root of trust for every Document Signer Certificate {country} will ever issue."
msgstr "La clave privada de la SCA es la raíz de confianza de todos los certificados de firmante de documentos que {country} emita jamás."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.repo.consequence.by"
msgid "Your own security review"
msgstr "Tu propia revisión de seguridad"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.repo.consequence.title"
msgid "Private key published"
msgstr "Clave privada publicada"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.repo.consequence.travel.label"
msgid "SCA private key"
msgstr "Clave privada de la SCA"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.repo.consequence.what"
msgid "A private key left the country. It has to be treated as compromised: revoke it, regenerate, and prepare the key material again."
msgstr "Una clave privada salió del país. Hay que darla por comprometida: revocarla, regenerarla y volver a preparar el material de claves."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.repo.consequence.why"
msgid "Only public keys go to GitHub. Private keys never cross the {country} boundary."
msgstr "A GitHub solo van claves públicas. Las claves privadas nunca cruzan la frontera de {country}."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.repo.text"
msgid "In the GitHub repo next to the public keys, so nothing gets lost"
msgstr "En el repositorio de GitHub, junto a las claves públicas, para que no se pierda nada"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.server.consequence.by"
msgid "Your own security review"
msgstr "Tu propia revisión de seguridad"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.server.consequence.title"
msgid "Trust anchor exposed"
msgstr "Ancla de confianza expuesta"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.server.consequence.what"
msgid "An online server can be compromised. If the SCA key leaks, every certificate it vouches for is in doubt."
msgstr "Un servidor en línea puede verse comprometido. Si se filtra la clave SCA, todos los certificados que respalda quedan en duda."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.server.consequence.why"
msgid "Keep the SCA offline, with more than one person needed to use it. A hardware security module or smart card adds further protection."
msgstr "Mantén la SCA fuera de línea, de modo que haga falta más de una persona para usarla. Un módulo de seguridad de hardware o una tarjeta inteligente añaden más protección."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.server.text"
msgid "On the backend server, so signing is quick"
msgstr "En el servidor de backend, para que la firma sea rápida"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.choices.vault.text"
msgid "Offline, in the vault, under multi-person control"
msgstr "Fuera de línea, en la caja fuerte, bajo control de varias personas"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.docs.0.lines.0"
msgid "Signs Document Signer Certificates"
msgstr "Firma certificados de firmante de documentos"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.docs.0.lines.1"
msgid "Whoever holds it can speak for {country}"
msgstr "Quien la tenga puede hablar en nombre de {country}"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.docs.0.title"
msgid "SCA private key"
msgstr "Clave privada de la SCA"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.learn"
msgid "Private keys stay inside {country}, and the SCA key stays offline."
msgstr "Las claves privadas se quedan dentro de {country}, y la clave SCA permanece fuera de línea."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.prompt"
msgid "Where does it live?"
msgstr "¿Dónde se guarda?"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.success.note"
msgid "SCA private key locked in the offline vault."
msgstr "Clave privada de la SCA guardada en la caja fuerte fuera de línea."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:sca.title"
msgid "Protect the trust anchor"
msgstr "Proteger el ancla de confianza"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.brief"
msgid "{country} wants to issue digital health certificates that other countries can verify. The first move is a formal Statement of Interest to WHO."
msgstr "{country} quiere emitir certificados digitales de salud que otros países puedan verificar. El primer paso es una Declaración de interés formal dirigida a la OMS."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.email.text"
msgid "Email it to gdhcn-secretariat@who.int"
msgstr "Enviarla por correo electrónico a gdhcn-secretariat@who.int"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.gateway.consequence.by"
msgid "Trust Network Gateway"
msgstr "Puerta de enlace a la red de confianza"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.gateway.consequence.title"
msgid "Wrong road"
msgstr "Camino equivocado"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.gateway.consequence.travel.label"
msgid "Statement of Interest"
msgstr "Declaración de interés"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.gateway.consequence.what"
msgid "The Gateway refused the connection. {country} has no certificates registered, and the Gateway only accepts signed key material over mTLS."
msgstr "La puerta de enlace rechazó la conexión. {country} no tiene certificados registrados, y la puerta de enlace solo acepta material de claves firmado mediante mTLS."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.gateway.consequence.why"
msgid "Paperwork travels by email to the Secretariat. The Gateway carries keys, never letters."
msgstr "El papeleo viaja por correo electrónico a la Secretaría. La puerta de enlace transporta claves, nunca cartas."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.gateway.text"
msgid "Upload it to the Trust Network Gateway"
msgstr "Cargarla en la puerta de enlace a la red de confianza"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.github.consequence.by"
msgid "WHO Secretariat"
msgstr "Secretaría de la OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.github.consequence.title"
msgid "Nobody is looking there"
msgstr "Nadie mira ahí"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.github.consequence.travel.label"
msgid "Statement of Interest"
msgstr "Declaración de interés"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.github.consequence.what"
msgid "No one at WHO watches a repository it hasn't been told about. tng-bot only reads repositories it is invited to, much later in onboarding."
msgstr "Nadie en la OMS vigila un repositorio del que no le han hablado. tng-bot solo lee los repositorios a los que se le invita, mucho más adelante en la integración."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.github.consequence.why"
msgid "The Statement of Interest goes to gdhcn-secretariat@who.int."
msgstr "La Declaración de interés se envía a gdhcn-secretariat@who.int."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.choices.github.text"
msgid "Put it in a GitHub repository for WHO to find"
msgstr "Ponerla en un repositorio de GitHub para que la OMS la encuentre"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.docs.0.lines.0"
msgid "From: Ministry of Health, {country}"
msgstr "De: Ministerio de Salud, {country}"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.docs.0.lines.1"
msgid "To: WHO GDHCN Secretariat"
msgstr "Para: Secretaría de la Red Mundial, OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.docs.0.lines.2"
msgid "{country} wishes to join the Global Digital Health Certification Network as a Participant."
msgstr "{country} desea unirse a la Red Mundial de Certificación Digital en Salud como participante."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.docs.0.title"
msgid "Statement of Interest"
msgstr "Declaración de interés"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.learn"
msgid "Onboarding starts with an email: the Statement of Interest goes to gdhcn-secretariat@who.int."
msgstr "La integración empieza con un correo electrónico: la Declaración de interés se envía a gdhcn-secretariat@who.int."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.prompt"
msgid "How do you send it?"
msgstr "¿Cómo la envías?"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.success.note"
msgid "Received by the GDHCN Secretariat."
msgstr "Recibida por la Secretaría de la Red Mundial."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.success.travel.0.label"
msgid "Statement of Interest"
msgstr "Declaración de interés"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:soi.title"
msgid "Say you want to join"
msgstr "Decir que quieres unirte"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.brief"
msgid "WHO's bot takes the latest git tag and checks its signature against your onboarded GPG keys. {keymasterFirst} marks the version WHO should use."
msgstr "El bot de la OMS toma la última etiqueta de git y comprueba su firma con tus claves GPG incorporadas. {keymasterFirst} marca la versión que debe usar la OMS."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.choices.none.consequence.by"
msgid "tng-bot"
msgstr "tng-bot"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.choices.none.consequence.title"
msgid "Nothing to collect"
msgstr "Nada que recoger"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.choices.none.consequence.what"
msgid "tng-bot clones the latest tag. With no tag, there is nothing to take over."
msgstr "tng-bot clona la última etiqueta. Sin etiqueta, no hay nada que recoger."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.choices.none.consequence.why"
msgid "Tag each version you want WHO to use, and sign it."
msgstr "Etiqueta cada versión que quieras que use la OMS, y fírmala."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.choices.none.text"
msgid "Skip the tag; the bot will take the latest commit"
msgstr "Saltarse la etiqueta; el bot tomará el último commit"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.choices.terminal.text"
msgid "Sign it from the terminal with git tag -s, using {keymasterFirst}'s GPG key"
msgstr "Firmarla desde el terminal con git tag -s, usando la clave GPG de {keymasterFirst}"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.choices.web.text"
msgid "Create it on the GitHub website; it's quicker"
msgstr "Crearla en el sitio web de GitHub; es más rápido"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.docs.0.lines.0"
msgid "GitHub website: Releases → Create a new tag"
msgstr "Sitio web de GitHub: Releases → Create a new tag"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.docs.0.lines.1"
msgid "Terminal: git tag -s v1.0"
msgstr "Terminal: git tag -s v1.0"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.docs.0.title"
msgid "Release v1.0"
msgstr "Versión v1.0"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.learn"
msgid "Sign the git tag locally, from the terminal or an IDE. Tags made on the GitHub website can't be verified by tng-bot."
msgstr "Firma la etiqueta de git en local, desde el terminal o un IDE. tng-bot no puede verificar las etiquetas creadas en el sitio web de GitHub."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.prompt"
msgid "How do you create the tag?"
msgstr "¿Cómo creas la etiqueta?"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.success.note"
msgid "Signed tag v1.0 pushed."
msgstr "Etiqueta firmada v1.0 enviada."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tag.title"
msgid "Sign the tag"
msgstr "Firmar la etiqueta"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.brief"
msgid "WHO needs named people it can verify. {business}, the Business Owner, puts the team together."
msgstr "La OMS necesita personas designadas a las que pueda verificar. {business}, responsable (Business Owner), forma el equipo."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.choices.four.text"
msgid "Name all four, each with an official government email address"
msgstr "Designar a los cuatro, cada uno con una dirección de correo electrónico oficial del gobierno"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.choices.later.consequence.by"
msgid "WHO Secretariat"
msgstr "Secretaría de la OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.choices.later.consequence.title"
msgid "The Letter can't be finished"
msgstr "No se puede terminar la Carta"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.choices.later.consequence.what"
msgid "The Letter of Application must name the people authorised to provide {country}'s key material, with their contact details. It can't go out with a blank."
msgstr "La Carta de solicitud debe nombrar a las personas autorizadas a aportar el material de claves de {country}, con sus datos de contacto. No puede salir con un espacio en blanco."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.choices.later.consequence.why"
msgid "WHO verifies the named people in person or through the diplomatic channel, so they have to be named up front."
msgstr "La OMS verifica a las personas designadas en persona o por la vía diplomática, así que hay que nombrarlas desde el principio."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.choices.later.text"
msgid "Let the software vendor handle the keys and name the people later"
msgstr "Dejar que el proveedor de software se ocupe de las claves y nombrar a las personas más adelante"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.docs.0.lines.0"
msgid "Business Owner · {business} · Accountable for the country's participation and its use cases. Puts the team together and signs off."
msgstr "Responsable (Business Owner) · {business} · Responsable de la participación del país y de sus casos de uso. Forma el equipo y da el visto bueno."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.docs.0.lines.1"
msgid "Key Master · {keymaster} · Creates and safeguards the country's keys and certificates (the PKI)."
msgstr "Key Master · {keymaster} · Crea y protege las claves y los certificados del país (la PKI)."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.docs.0.lines.2"
msgid "Legal · {legal} · WHO's contact on legal and policy matters. Prepares the Letter of Application."
msgstr "Legal · {legal} · Contacto de la OMS en asuntos jurídicos y de políticas. Prepara la Carta de solicitud."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.docs.0.lines.3"
msgid "Technical · {technical} · Runs the backend, its security and the connection tests with the Gateway."
msgstr "Técnico · {technical} · Gestiona el backend, su seguridad y las pruebas de conexión con la puerta de enlace."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.docs.0.title"
msgid "{country} representatives"
msgstr "Representantes de {country}"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.learn"
msgid "Four named roles carry onboarding: Business Owner, Key Master, Legal and Technical."
msgstr "Cuatro funciones designadas llevan la integración: responsable (Business Owner), Key Master, legal y técnico."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.prompt"
msgid "How do you set the team up for onboarding?"
msgstr "¿Cómo organizas el equipo para la integración?"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.success.note"
msgid "Four named representatives, each with an official address."
msgstr "Cuatro representantes designados, cada uno con una dirección oficial."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:team.title"
msgid "Name your team"
msgstr "Designa a tu equipo"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.brief"
msgid "{technicalFirst} sets up the tools: OpenSSL, cURL, Git, [[gpg|GPG]] and a [[github|GitHub]] account. On Windows, WHO's <a href=\"https://github.com/WorldHealthOrganization/GDHCNOnboardingWizard\" target=\"_blank\" rel=\"noopener\">Onboarding Wizard</a> can do the repository, GPG and certificate steps for you."
msgstr "{technicalFirst} configura las herramientas: OpenSSL, cURL, Git, [[gpg|GPG]] y una cuenta de [[github|GitHub]]. En Windows, el <a href=\"https://github.com/WorldHealthOrganization/GDHCNOnboardingWizard\" target=\"_blank\" rel=\"noopener\">Onboarding Wizard</a> de la OMS puede hacer por ti los pasos del repositorio, de GPG y de los certificados."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.choices.all.text"
msgid "Install GPG too: every named person needs a GPG key, and the release tag must be signed"
msgstr "Instalar también GPG: cada persona designada necesita una clave GPG, y la etiqueta de versión debe estar firmada"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.choices.nogpg.text"
msgid "Skip GPG; Git and OpenSSL cover what we need"
msgstr "Saltarse GPG; Git y OpenSSL cubren lo que necesitamos"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.choices.skip.consequence.by"
msgid "WHO onboarding team"
msgstr "Equipo de integración de la OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.choices.skip.consequence.title"
msgid "It's your test"
msgstr "Es tu prueba"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.choices.skip.consequence.what"
msgid "The connectivity test is run by the participant, from its own backend, with its own TLS certificate."
msgstr "La prueba de conectividad la hace el participante, desde su propio backend, con su propio certificado TLS."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.choices.skip.consequence.why"
msgid "You prove your backend can reach the Gateway. The operations team supports you if it fails."
msgstr "Tú demuestras que tu backend puede llegar a la puerta de enlace. El equipo de operaciones te ayuda si falla."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.choices.skip.text"
msgid "Skip cURL; WHO tests the connection for us"
msgstr "Saltarse cURL; la OMS prueba la conexión por nosotros"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.docs.0.title"
msgid "{technicalFirst}'s laptop"
msgstr "El portátil de {technicalFirst}"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.learn"
msgid "Set up every tool before you start: OpenSSL, cURL, Git and GPG. On Windows, WHO's Onboarding Wizard can help."
msgstr "Configura todas las herramientas antes de empezar: OpenSSL, cURL, Git y GPG. En Windows, el Onboarding Wizard de la OMS puede ayudar."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.prompt"
msgid "GPG is missing. Do you need every tool?"
msgstr "Falta GPG. ¿Necesitas todas las herramientas?"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.success.note"
msgid "Workbench ready."
msgstr "Banco de trabajo listo."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:tools.title"
msgid "Set up the workbench"
msgstr "Preparar el banco de trabajo"

#: onboarding-game/src/i18n/en.json:1
msgctxt "settings.ts:DEFAULTS.country"
msgid "Country XC"
msgstr "País XC"

#: onboarding-game/src/i18n/en.json:1
msgctxt "settings.ts:domains.and"
msgid " and "
msgstr " y"

#: onboarding-game/src/i18n/en.json:1
msgctxt "settings.ts:domains.none"
msgid "no trust domain yet"
msgstr "ningún ámbito de confianza por ahora"

#: onboarding-game/src/i18n/en.json:1
msgctxt "settings.ts:letter.one"
msgid "{n} Letter"
msgstr "{n} Carta"

#: onboarding-game/src/i18n/en.json:1
msgctxt "settings.ts:letter.other"
msgid "{n} Letters"
msgstr "{n} Cartas"

#: onboarding-game/src/i18n/en.json:1
msgctxt "settings.ts:letter.zero"
msgid "The Letter for joining with no trust domain"
msgstr "La Carta para unirse sin ámbito de confianza"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:about.builtBy"
msgid "Built by"
msgstr "Creado por"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:about.cats"
msgid "🐾 Cats found: {n} of 3"
msgstr "🐾 Gatos encontrados: {n} de 3"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:about.close"
msgid "Close"
msgstr "Cerrar"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:about.h2"
msgid "About this simulation"
msgstr "Acerca de esta simulación"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:about.osforge"
msgid "OS Forge"
msgstr "OS Forge"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:about.p1"
msgid "A learning tool that turns the WHO SMART Trust onboarding process into choices a country team makes. Step numbers refer to the published process at smart.who.int/trust, which remains the authority. The GDHCN Administrative and Operational Framework is authoritative for definitions."
msgstr "Una herramienta de aprendizaje que convierte el proceso de integración de SMART Trust de la OMS en decisiones que toma el equipo de un país. Los números de paso remiten al proceso publicado en smart.who.int/trust, que sigue siendo la referencia. El Marco administrativo y operativo de la GDHCN es la referencia para las definiciones."

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:about.p2"
msgid "Simplifications: steps are grouped into moments, some checks are shown at a convenient point in the story, and game days are illustrative."
msgstr "Simplificaciones: los pasos se agrupan en momentos, algunos controles se muestran en un punto conveniente de la historia y los días de juego son ilustrativos."

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:confirm.cancel"
msgid "Cancel"
msgstr "Cancelar"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:confirm.homeBody"
msgid "You return to the title screen; your country and team names are kept."
msgstr "Vuelves a la pantalla de título; se conservan los nombres de tu país y de tu equipo."

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:confirm.homeOk"
msgid "⌂ Go home"
msgstr "⌂ Ir al inicio"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:confirm.homeTitle"
msgid "Go back to the start?"
msgstr "¿Volver al inicio?"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:confirm.lost"
msgid "Your progress in this run ({days} game days, {n} detour{n:|s}) will be lost."
msgstr "Se perderá tu progreso en esta partida ({days} días de juego, {n} desvío{n:|s})."

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:confirm.restartBody"
msgid "You start again at the Statement of Interest, with the same country and team."
msgstr "Empiezas de nuevo en la Declaración de interés, con el mismo país y el mismo equipo."

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:confirm.restartOk"
msgid "↺ Restart"
msgstr "↺ Reiniciar"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:confirm.restartTitle"
msgid "Restart onboarding?"
msgstr "¿Reiniciar la integración?"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:dashboard.days"
msgid "{n} days"
msgstr "{n} días"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:dashboard.months"
msgid "{n} months"
msgstr "{n} meses"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:dashboard.years"
msgid "{n} years"
msgstr "{n} años"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.countryKeeps"
msgid "{country} keeps"
msgstr "{country} conserva"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.eyebrow"
msgid "Debrief · {country} is live"
msgstr "Balance · {country} está en servicio"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.finish"
msgid "Finish"
msgstr "Terminar"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.gateway1"
msgid "Whitelisted public keys"
msgstr "Claves públicas incluidas en la lista blanca"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.gateway2"
msgid "Trust lists for every participant"
msgstr "Listas de confianza de todos los participantes"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.gatewayPublishes"
msgid "The Gateway publishes"
msgstr "La puerta de enlace publica"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.github1"
msgid "Public keys only (PEM)"
msgstr "Solo claves públicas (PEM)"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.github2"
msgid "A GPG-signed tag"
msgstr "Una etiqueta firmada con GPG"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.github3"
msgid "Read by tng-bot-dev (UAT) and tng-bot (PROD)"
msgstr "Leídas por tng-bot-dev (UAT) y tng-bot (PROD)"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.githubCarries"
msgid "GitHub carries"
msgstr "GitHub transporta"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.h1Clean"
msgid "Live, first time"
msgstr "En servicio a la primera"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.h1Detours"
msgid "Live, with {n} detour{n:|s}"
msgstr "En servicio, con {n} desvío{n:|s}"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.keep1"
msgid "SCA private key, offline in the vault"
msgstr "Clave privada de la SCA, fuera de línea en la caja fuerte"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:debrief.keep2"
msgid "TLS and Upload private keys"
msgstr "Claves privadas TLS y de carga"

#: onboarding-game/src/i18n/en.json:1
