#. Diagram label
msgid "GDHCN Secretariat"
msgstr "Secretaría de la Red Mundial"

#: input/business-processes/GDHCN.TrustDomain.Propose.bpmn:10
#. Diagram label
msgid "GDHCN Secretariat (WHO)"
msgstr "Secretaría de la Red Mundial (OMS)"

