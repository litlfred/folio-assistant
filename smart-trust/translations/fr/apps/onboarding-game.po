msgstr "KM"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:roles.keymaster.job"
msgid "Creates and safeguards the country's keys and certificates (the PKI)."
msgstr "Crée et protège les clés et les certificats du pays (l'ICP)."

#: onboarding-game/src/i18n/en.json:1
