msgstr "Les dépôts doivent être privés"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:repos.choices.public.consequence.what"
msgid "The repositories have to be private."
msgstr "Les dépôts doivent être privés."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:repos.choices.public.consequence.why"
msgid "Private repositories hide the uploader's identity."
msgstr "Les dépôts privés masquent l'identité de la personne qui téléverse."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:repos.choices.public.text"
msgid "Make them public so WHO can find them easily"
msgstr "Rendez-les publics pour que l'OMS les trouve facilement"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:repos.choices.right.text"
msgid "A private repo per environment; invite tng-bot-dev to UAT and tng-bot to PROD"
msgstr "Un dépôt privé par environnement ; invitez tng-bot-dev sur UAT et tng-bot sur PROD"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:repos.docs.0.lines.0"
