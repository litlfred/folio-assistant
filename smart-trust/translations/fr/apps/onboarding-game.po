msgstr "Kwame Mensah"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:roles.keymaster.title"
msgid "Key Master"
msgstr "Responsable des clés (Key Master)"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:roles.legal.initials"
