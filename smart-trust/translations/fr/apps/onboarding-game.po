msgstr "Gère le backend, sa sécurité et les tests de connexion avec la passerelle."

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:roles.technical.name"
msgid "Tendai Banda"
msgstr "Tendai Banda"

#: onboarding-game/src/i18n/en.json:1
msgctxt "scenario:roles.technical.title"
