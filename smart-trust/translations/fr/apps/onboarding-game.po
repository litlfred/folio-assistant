msgid "⬇ Download the narrated demo as MP4 (6 MB)"
msgstr "⬇ Télécharger la démo commentée en MP4 (6 Mo)"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.sideEyebrow"
msgid "See it in action"
msgstr "Voir en action"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.sideLede"
msgid "Short films showing what onboarding involves and what the network does once a country is live."
msgstr "De courts films montrant en quoi consiste l'adhésion et ce que fait le réseau une fois qu'un pays est en service."

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.smallData"
msgid "keys travel by data"
msgstr "les clés circulent par transfert de données"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.smallLead"
msgid "Each moment asks your team to make a call. Wrong calls send things back, sometimes much later. Roads matter:"
msgstr "Chaque séquence demande à votre équipe de prendre une décision. Les mauvaises décisions font revenir en arrière, parfois bien plus tard. Les voies comptent :"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.smallPaper"
msgid "paper travels by email"
msgstr "les documents circulent par courriel"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.start"
msgid "Start onboarding"
msgstr "Commencer l'adhésion"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.teamBusiness"
msgid "Business Owner"
msgstr "Responsable métier"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.teamKeymaster"
msgid "Key Master"
msgstr "Responsable des clés (Key Master)"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.teamLegal"
msgid "Legal"
msgstr "Responsable juridique"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.teamTechnical"
msgid "Technical"
msgstr "Responsable technique"

#: onboarding-game/src/i18n/en.json:1
msgctxt "ui.ts:title.watchDemo"
msgid "▶ Watch the demo"
msgstr "▶ Voir la démo"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.backend.blurb"
msgid "Your servers. Private TLS and Upload keys, Document Signers, and the offline SCA vault."
msgstr "Vos serveurs. Les clés privées TLS et de téléversement, les signataires de documents et le coffre-fort SCA hors ligne."

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.backend.name"
msgid "Country backend"
msgstr "Infrastructure du pays"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.dashboard.blurb"
msgid "WHO-run dashboards (DEV, UAT, PROD) showing when each participant's certificates expire. A view, not a reminder service."
msgstr "Tableaux de bord gérés par l'OMS (DEV, UAT, PROD) indiquant quand expirent les certificats de chaque participant. Une vue, pas un service de rappel."

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.dashboard.name"
msgid "Certificate expiry dashboard"
msgstr "Tableau de bord d'expiration des certificats"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.github.blurb"
msgid "{country}'s private repositories (UAT, PROD). Public keys only."
msgstr "Dépôts privés de {country} (UAT, PROD). Clés publiques uniquement."

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.github.name"
msgid "Private repos"
msgstr "Dépôts privés"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.ministry.blurb"
msgid "People and paperwork: Business Owner, Legal, Technical and Key Master representatives."
msgstr "Les personnes et les documents : le responsable métier, le responsable juridique, le responsable technique et le Key Master."

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.ministry.name"
msgid "Ministry of Health"
msgstr "Ministère de la Santé"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.ops.blurb"
msgid "tng-bot, pull requests, and the air-gapped room where the WHO Trust Anchor signs PROD keys."
msgstr "tng-bot, demandes de tirage, et la salle isolée du réseau où l'ancre de confiance de l'OMS signe les clés PROD."

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.ops.name"
msgid "WHO Operations"
msgstr "Opérations de l'OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.prod.blurb"
msgid "The production gateway. Holds whitelisted public keys and publishes trust lists."
msgstr "La passerelle de production. Elle conserve les clés publiques inscrites sur la liste d'autorisation et publie les listes de confiance."

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.prod.name"
msgid "PROD gateway"
msgstr "Passerelle PROD"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.secretariat.blurb"
msgid "Governance: gdhcn-secretariat@who.int. Technical help: gdhcn-support@who.int. Eligibility, Letters of Application and identity checks."
msgstr "Gouvernance : gdhcn-secretariat@who.int. Aide technique : gdhcn-support@who.int. Admissibilité, lettres de candidature et vérifications d'identité."

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.secretariat.name"
msgid "GDHCN Secretariat"
msgstr "Secrétariat du GDHCN"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.uat.blurb"
msgid "The test gateway. Keys are auto-signed. Connectivity and dry-run tests happen here."
msgstr "La passerelle de test. Les clés sont signées automatiquement. Les tests de connectivité et l'essai à blanc se déroulent ici."

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:place.uat.name"
msgid "UAT gateway"
msgstr "Passerelle UAT"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:sub.airgap"
msgid "Air-gapped signing"
msgstr "Signature en environnement isolé"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:sub.vault"
msgid "Offline SCA vault"
msgstr "Coffre-fort SCA hors ligne"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:territory.country"
msgid "COUNTRY XC"
msgstr "PAYS XC"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:territory.dashboard"
msgid "EXPIRY DASHBOARD · WHO"
msgstr "TABLEAU DE BORD D'EXPIRATION · OMS"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:territory.github"
msgid "GITHUB · third party"
msgstr "GITHUB · tiers"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:territory.network"
msgid "TRUST NETWORK GATEWAY"
msgstr "PASSERELLE DU RÉSEAU DE CONFIANCE"

#: onboarding-game/src/i18n/en.json:1
msgctxt "World.ts:territory.who"
msgid "WHO"
msgstr "OMS"
