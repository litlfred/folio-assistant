msgid "Trust Network Gateway additional context JSON-LD file added"
msgstr "Ajout d’un fichier JSON-LD de contexte supplémentaire pour la Passerelle du réseau de confiance"

#: input/pagecontent/changes.md:53
msgid "Trust Network Gateway Letters of Application added for all languages (English, Arabic, French, Mandarin, Russian, Spanish) and PH4H"
msgstr "Ajout des lettres de candidature à la Passerelle du réseau de confiance pour toutes les langues (anglais, arabe, français, mandarin, russe, espagnol) et pour PH4H"

