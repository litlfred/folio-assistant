      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RG_4" bpmnElement="SF_RG_4">
        <di:waypoint x="870" y="240"/>
        <di:waypoint x="920" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RG_5" bpmnElement="SF_RG_5">
        <di:waypoint x="945" y="265"/>
        <di:waypoint x="945" y="500"/>
        <di:waypoint x="1010" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_RG_6" bpmnElement="SF_RG_6">
        <di:waypoint x="945" y="215"/>
