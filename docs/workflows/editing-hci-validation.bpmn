<?xml version="1.0" encoding="UTF-8"?>
<!--
  folio-assistant — editing a content block and its HCI validation gate.

  Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
  BPMN 2.0 tool. The SVG under docs/assets/img/workflows/ is generated from it
  by `bun run render:bpmn` — never hand-edit the SVG.

  The <folio:skill> extension on an activity names the folio-assistant skill
  that implements it; <folio:bean> marks a step that reads or writes the shared
  work plan in .beans/.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:folio="https://litlfred.github.io/folio-assistant/bpmn"
                  id="Definitions_FolioEditing"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">

  <bpmn:collaboration id="Collaboration_FolioEditing">
    <bpmn:participant id="Participant_FolioEditing" name="Folio editing — one proposed change to a content block" processRef="Process_Editing" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Editing" name="Editing and HCI validation" isExecutable="false">
    <bpmn:laneSet id="Process_Editing_LaneSet">
      <bpmn:lane id="Lane_Editor" name="Editor / author (person)">
        <bpmn:flowNodeRef>StartEvent_EditRequested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DescribeChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewFindings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EditorDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Discarded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WorkPlan" name="Work plan — beans (shared by humans and agents)">
        <bpmn:flowNodeRef>Task_ClaimBean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogFindings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResolveBean</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Authoring agent (system)">
        <bpmn:flowNodeRef>Task_DraftEdit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProposalReady</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseEdit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Pipeline" name="HCI validation pipeline (system)">
        <bpmn:flowNodeRef>Gateway_ValidationFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ValidationJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollateFindings</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Mechanical" name="Mechanical validation (system)">
        <bpmn:flowNodeRef>Task_SchemaValidate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SyntaxSpell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BuildGates</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NonMechanical" name="Non-mechanical validation (review agent or SME)">
        <bpmn:flowNodeRef>Gateway_ReviewerKind</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AgentReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SmeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewerJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Corpus" name="Corpus (versioned store)">
        <bpmn:flowNodeRef>Task_Commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_InCorpus</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_EditRequested" name="Edit requested">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DescribeChange" name="Describe the intended change">
      <bpmn:documentation>The editor states the change in natural language; no content has moved yet.</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_ClaimBean" name="Claim or open the bean&#10;[todo-manager]">
      <bpmn:documentation>Every edit is tracked as a bean in .beans/. Check for an existing bean by exact title first; claim it (status in-progress) rather than minting a duplicate.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="todo-manager" />
        <folio:bean store=".beans/" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_DraftEdit" name="Draft the block edit&#10;[content-author]">
      <bpmn:documentation>The authoring agent produces a PROPOSED change. Nothing is written to the corpus yet.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-author" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ProposalReady" name="Proposed change ready">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_ValidationFork" name="Run HCI validation">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_SchemaValidate" name="Schema and constraint checks&#10;[content-validate]">
      <bpmn:documentation>Block schema, label prefixes, required fields, constraint rules.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-validate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SyntaxSpell" name="Syntax, spelling and links&#10;[content-validate]">
      <bpmn:documentation>Syntax, spelling, cross-references, citation and link resolution.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-validate" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_BuildGates" name="Build and QA gates&#10;[content-test]">
      <bpmn:documentation>Lean build and proof status, LaTeX compile, FHIR/SUSHI validation, QA axes.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-test" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewerKind" name="Judgement call?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_AgentReview" name="Agent review of the change&#10;[content-review]">
      <bpmn:documentation>A review agent judges what no checker can: accuracy, voice, exposition, whether the change says what the editor meant.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SmeReview" name="Human / SME review&#10;[content-review]">
      <bpmn:documentation>Escalated to a human reviewer or subject-matter expert when the change turns on clinical or scientific judgement.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewerJoin" name="">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_ValidationJoin" name="All checks reported">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_CollateFindings" name="Collate findings into a report">
      <bpmn:documentation>Mechanical results and review findings are merged into one report against the proposed change.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LogFindings" name="Log findings on the bean&#10;[todo-manager]">
      <bpmn:documentation>Findings are appended to the bean, so the next agent or human sees what is outstanding.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="todo-manager" />
        <folio:bean store=".beans/" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewFindings" name="Review the findings">
      <bpmn:documentation>THE GATE: the editor sees every finding BEFORE anything reaches the corpus.</bpmn:documentation>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_EditorDecision" name="Accept, revise or discard?">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReviseEdit" name="Revise the proposed change&#10;[content-author]">
      <bpmn:extensionElements>
        <folio:skill ref="content-author" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Discarded" name="Change discarded">
      <bpmn:incoming>Flow_24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Commit" name="Commit into the corpus">
      <bpmn:documentation>Only now does the change become corpus content, together with its QA sidecars. Subject to the commit-hygiene requirement.</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_ResolveBean" name="Resolve or re-open the bean&#10;[todo-manager]">
      <bpmn:documentation>Resolved when the change landed clean; left open with the residue when it did not.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="todo-manager" />
        <folio:bean store=".beans/" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_InCorpus" name="Change is in the corpus">
      <bpmn:incoming>Flow_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_EditRequested" targetRef="Task_DescribeChange" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_DescribeChange" targetRef="Task_ClaimBean" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_ClaimBean" targetRef="Task_DraftEdit" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_DraftEdit" targetRef="Gateway_ProposalReady" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_ProposalReady" targetRef="Gateway_ValidationFork" />
    <bpmn:sequenceFlow id="Flow_06" name="mechanical" sourceRef="Gateway_ValidationFork" targetRef="Task_SchemaValidate" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Gateway_ValidationFork" targetRef="Task_SyntaxSpell" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_ValidationFork" targetRef="Task_BuildGates" />
    <bpmn:sequenceFlow id="Flow_09" name="non-mechanical" sourceRef="Gateway_ValidationFork" targetRef="Gateway_ReviewerKind" />
    <bpmn:sequenceFlow id="Flow_10" name="no" sourceRef="Gateway_ReviewerKind" targetRef="Task_AgentReview" />
    <bpmn:sequenceFlow id="Flow_11" name="yes" sourceRef="Gateway_ReviewerKind" targetRef="Task_SmeReview" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_AgentReview" targetRef="Gateway_ReviewerJoin" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_SmeReview" targetRef="Gateway_ReviewerJoin" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_SchemaValidate" targetRef="Gateway_ValidationJoin" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_SyntaxSpell" targetRef="Gateway_ValidationJoin" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_BuildGates" targetRef="Gateway_ValidationJoin" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_ReviewerJoin" targetRef="Gateway_ValidationJoin" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_ValidationJoin" targetRef="Task_CollateFindings" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_CollateFindings" targetRef="Task_LogFindings" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_LogFindings" targetRef="Task_ReviewFindings" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_ReviewFindings" targetRef="Gateway_EditorDecision" />
    <bpmn:sequenceFlow id="Flow_22" name="revise" sourceRef="Gateway_EditorDecision" targetRef="Task_ReviseEdit" />
    <bpmn:sequenceFlow id="Flow_23" name="re-validate" sourceRef="Task_ReviseEdit" targetRef="Gateway_ProposalReady" />
    <bpmn:sequenceFlow id="Flow_24" name="discard" sourceRef="Gateway_EditorDecision" targetRef="EndEvent_Discarded" />
    <bpmn:sequenceFlow id="Flow_25" name="accept" sourceRef="Gateway_EditorDecision" targetRef="Task_Commit" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Commit" targetRef="Task_ResolveBean" />
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ResolveBean" targetRef="EndEvent_InCorpus" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_FolioEditing">
      <bpmndi:BPMNShape id="Participant_FolioEditing_di" bpmnElement="Participant_FolioEditing" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2960" height="1310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Editor_di" bpmnElement="Lane_Editor" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2930" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_WorkPlan_di" bpmnElement="Lane_WorkPlan" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="2930" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="380" width="2930" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Pipeline_di" bpmnElement="Lane_Pipeline" isHorizontal="true">
        <dc:Bounds x="190" y="530" width="2930" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Mechanical_di" bpmnElement="Lane_Mechanical" isHorizontal="true">
        <dc:Bounds x="190" y="680" width="2930" height="330" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_NonMechanical_di" bpmnElement="Lane_NonMechanical" isHorizontal="true">
        <dc:Bounds x="190" y="1010" width="2930" height="230" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Corpus_di" bpmnElement="Lane_Corpus" isHorizontal="true">
        <dc:Bounds x="190" y="1240" width="2930" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_EditRequested_di" bpmnElement="StartEvent_EditRequested">
        <dc:Bounds x="262" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="225" y="177" width="110" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DescribeChange_di" bpmnElement="Task_DescribeChange">
        <dc:Bounds x="375" y="110" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ClaimBean_di" bpmnElement="Task_ClaimBean">
        <dc:Bounds x="535" y="260" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DraftEdit_di" bpmnElement="Task_DraftEdit">
        <dc:Bounds x="695" y="410" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ProposalReady_di" bpmnElement="Gateway_ProposalReady" isMarkerVisible="true">
        <dc:Bounds x="895" y="430" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="865" y="484" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidationFork_di" bpmnElement="Gateway_ValidationFork">
        <dc:Bounds x="1055" y="580" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="925" y="592" width="125" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SchemaValidate_di" bpmnElement="Task_SchemaValidate">
        <dc:Bounds x="1335" y="690" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SyntaxSpell_di" bpmnElement="Task_SyntaxSpell">
        <dc:Bounds x="1335" y="800" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_BuildGates_di" bpmnElement="Task_BuildGates">
        <dc:Bounds x="1335" y="910" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReviewerKind_di" bpmnElement="Gateway_ReviewerKind" isMarkerVisible="true">
        <dc:Bounds x="1215" y="1095" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1085" y="1030" width="120" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AgentReview_di" bpmnElement="Task_AgentReview">
        <dc:Bounds x="1335" y="1020" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SmeReview_di" bpmnElement="Task_SmeReview">
        <dc:Bounds x="1335" y="1130" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReviewerJoin_di" bpmnElement="Gateway_ReviewerJoin" isMarkerVisible="true">
        <dc:Bounds x="1535" y="1095" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ValidationJoin_di" bpmnElement="Gateway_ValidationJoin">
        <dc:Bounds x="1695" y="580" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1580" y="592" width="110" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CollateFindings_di" bpmnElement="Task_CollateFindings">
        <dc:Bounds x="1815" y="560" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogFindings_di" bpmnElement="Task_LogFindings">
        <dc:Bounds x="1975" y="260" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewFindings_di" bpmnElement="Task_ReviewFindings">
        <dc:Bounds x="2135" y="110" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EditorDecision_di" bpmnElement="Gateway_EditorDecision" isMarkerVisible="true">
        <dc:Bounds x="2335" y="130" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2295" y="90" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviseEdit_di" bpmnElement="Task_ReviseEdit">
        <dc:Bounds x="2295" y="410" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Discarded_di" bpmnElement="EndEvent_Discarded">
        <dc:Bounds x="2502" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2465" y="177" width="110" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Commit_di" bpmnElement="Task_Commit">
        <dc:Bounds x="2615" y="1270" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResolveBean_di" bpmnElement="Task_ResolveBean">
        <dc:Bounds x="2775" y="260" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_InCorpus_di" bpmnElement="EndEvent_InCorpus">
        <dc:Bounds x="2982" y="1297" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2945" y="1337" width="110" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
