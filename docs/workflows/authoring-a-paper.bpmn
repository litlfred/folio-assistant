<?xml version="1.0" encoding="UTF-8"?>
<!--
  folio-assistant — authoring a scientific paper end to end (Lean + LaTeX).

  Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
  BPMN 2.0 tool. The SVG under docs/assets/img/workflows/ is generated from it
  by `bun run render:bpmn` — never hand-edit the SVG.

  The <folio:skill> extension on an activity names the folio-assistant skill
  that implements it; <folio:bean> marks a step that reads or writes the shared
  work plan in .beans/.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:folio="https://litlfred.github.io/folio-assistant/bpmn"
                  id="Definitions_PaperAuthoring"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">

  <bpmn:collaboration id="Collaboration_PaperAuthoring">
    <bpmn:participant id="Participant_PaperAuthoring" name="Authoring a paper — plan to published" processRef="Process_PaperAuthoring" />
  </bpmn:collaboration>
  <bpmn:process id="Process_PaperAuthoring" name="Authoring a paper" isExecutable="false">
    <bpmn:documentation>
      folio-assistant — authoring a scientific paper end to end (Lean + LaTeX).
      Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
      BPMN 2.0 tool. The SVG under docs/assets/img/workflows/ is generated from it
      by `bun run render:bpmn` — never hand-edit the SVG.
      The &lt;folio:skill&gt; extension on an activity names the folio-assistant skill
      that implements it; &lt;folio:bean&gt; marks a step that reads or writes the shared
      work plan in .beans/.
    </bpmn:documentation>
    <bpmn:laneSet id="Process_PaperAuthoring_LaneSet">
      <bpmn:lane id="Lane_Author" name="Author (person)">
        <bpmn:flowNodeRef>StartEvent_NewPaper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WorkPlan" name="Work plan — beans (shared by humans and agents)">
        <bpmn:flowNodeRef>Task_SeedPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Authoring agent (system)">
        <bpmn:flowNodeRef>Task_Scaffold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuthorBlocks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lean" name="Lean toolchain (lean-mcp)">
        <bpmn:flowNodeRef>Task_Formalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LeanGreen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Build" name="Build pipeline — validate · render · publish">
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Published</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Reviewer" name="Reviewer / SME">
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewOutcome</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_NewPaper" name="New paper">
      <bpmn:outgoing>A01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Plan" name="1 · Plan the paper&#10;[content-plan]">
      <bpmn:documentation>Scope the paper: chapters, the blocks each needs, what gets formalised.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-plan" />
      </bpmn:extensionElements>
      <bpmn:incoming>A01</bpmn:incoming>
      <bpmn:outgoing>A02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Task_SeedPlan" name="2 · Seed the work plan&#10;[todo-manager]">
      <bpmn:documentation>The plan becomes beans, so a resumed session or a sibling agent can pick it up.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="todo-manager" />
        <folio:bean store=".beans/" op="claim" />
      </bpmn:extensionElements>
      <bpmn:incoming>A02</bpmn:incoming>
      <bpmn:outgoing>A03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Scaffold" name="3 · Scaffold the folio repo&#10;[content-plan]">
      <bpmn:extensionElements>
        <folio:skill ref="content-plan" />
      </bpmn:extensionElements>
      <bpmn:incoming>A03</bpmn:incoming>
      <bpmn:outgoing>A04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AuthorBlocks" name="4 · Author blocks&#10;[content-author]">
      <bpmn:documentation>Every block edit runs the HCI validation gate — see editing-hci-validation.bpmn.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-author" />
      </bpmn:extensionElements>
      <bpmn:incoming>A04</bpmn:incoming>
      <bpmn:incoming>A12</bpmn:incoming>
      <bpmn:outgoing>A05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Formalize" name="5 · Formalise in Lean&#10;[lean-formalization]">
      <bpmn:extensionElements>
        <folio:skill ref="lean-formalization" />
        <folio:skill ref="proof-verification" />
      </bpmn:extensionElements>
      <bpmn:incoming>A05</bpmn:incoming>
      <bpmn:incoming>A07</bpmn:incoming>
      <bpmn:outgoing>A06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_LeanGreen" name="Build green, no sorries?">
      <bpmn:extensionElements>
        <folio:decision ref="decisions/lean-build-gate.dmn#Decision_LeanBuildGate" />
      </bpmn:extensionElements>
      <bpmn:incoming>A06</bpmn:incoming>
      <bpmn:outgoing>A07</bpmn:outgoing>
      <bpmn:outgoing>A08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Validate" name="6 · Validate&#10;[content-validate]">
      <bpmn:extensionElements>
        <folio:skill ref="content-validate" />
      </bpmn:extensionElements>
      <bpmn:incoming>A08</bpmn:incoming>
      <bpmn:outgoing>A09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Render" name="7 · Render PDF / HTML&#10;[latex-authoring]">
      <bpmn:extensionElements>
        <folio:skill ref="latex-authoring" />
      </bpmn:extensionElements>
      <bpmn:incoming>A09</bpmn:incoming>
      <bpmn:outgoing>A10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Review" name="8 · Review and feedback&#10;[content-review]">
      <bpmn:extensionElements>
        <folio:skill ref="content-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>A10</bpmn:incoming>
      <bpmn:outgoing>A11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewOutcome" name="Ready to publish?">
      <bpmn:incoming>A11</bpmn:incoming>
      <bpmn:outgoing>A12</bpmn:outgoing>
      <bpmn:outgoing>A13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Publish" name="9 · Publish&#10;[content-publish]">
      <bpmn:documentation>See draft-to-publication.bpmn for the review and release path this expands into.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-publish" />
      </bpmn:extensionElements>
      <bpmn:incoming>A13</bpmn:incoming>
      <bpmn:outgoing>A14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Published" name="Paper published">
      <bpmn:incoming>A14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="A01" sourceRef="StartEvent_NewPaper" targetRef="Task_Plan" />
    <bpmn:sequenceFlow id="A02" sourceRef="Task_Plan" targetRef="Task_SeedPlan" />
    <bpmn:sequenceFlow id="A03" sourceRef="Task_SeedPlan" targetRef="Task_Scaffold" />
    <bpmn:sequenceFlow id="A04" sourceRef="Task_Scaffold" targetRef="Task_AuthorBlocks" />
    <bpmn:sequenceFlow id="A05" sourceRef="Task_AuthorBlocks" targetRef="Task_Formalize" />
    <bpmn:sequenceFlow id="A06" sourceRef="Task_Formalize" targetRef="Gateway_LeanGreen" />
    <bpmn:sequenceFlow id="A07" name="not yet" sourceRef="Gateway_LeanGreen" targetRef="Task_Formalize" />
    <bpmn:sequenceFlow id="A08" name="green" sourceRef="Gateway_LeanGreen" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="A09" sourceRef="Task_Validate" targetRef="Task_Render" />
    <bpmn:sequenceFlow id="A10" sourceRef="Task_Render" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="A11" sourceRef="Task_Review" targetRef="Gateway_ReviewOutcome" />
    <bpmn:sequenceFlow id="A12" name="iterate" sourceRef="Gateway_ReviewOutcome" targetRef="Task_AuthorBlocks" />
    <bpmn:sequenceFlow id="A13" name="approved" sourceRef="Gateway_ReviewOutcome" targetRef="Task_Publish" />
    <bpmn:sequenceFlow id="A14" sourceRef="Task_Publish" targetRef="EndEvent_Published" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_PaperAuthoring">
      <bpmndi:BPMNShape id="Participant_PaperAuthoring_di" bpmnElement="Participant_PaperAuthoring" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2140" height="900" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Author_di" bpmnElement="Lane_Author" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2110" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_WorkPlan_di" bpmnElement="Lane_WorkPlan" isHorizontal="true">
        <dc:Bounds x="190" y="230" width="2110" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="190" y="380" width="2110" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Lean_di" bpmnElement="Lane_Lean" isHorizontal="true">
        <dc:Bounds x="190" y="530" width="2110" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Build_di" bpmnElement="Lane_Build" isHorizontal="true">
        <dc:Bounds x="190" y="680" width="2110" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Reviewer_di" bpmnElement="Lane_Reviewer" isHorizontal="true">
        <dc:Bounds x="190" y="830" width="2110" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_NewPaper_di" bpmnElement="StartEvent_NewPaper">
        <dc:Bounds x="262" y="137" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="225" y="177" width="110" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Plan_di" bpmnElement="Task_Plan">
        <dc:Bounds x="375" y="110" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SeedPlan_di" bpmnElement="Task_SeedPlan">
        <dc:Bounds x="535" y="260" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scaffold_di" bpmnElement="Task_Scaffold">
        <dc:Bounds x="695" y="410" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AuthorBlocks_di" bpmnElement="Task_AuthorBlocks">
        <dc:Bounds x="855" y="410" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Formalize_di" bpmnElement="Task_Formalize">
        <dc:Bounds x="1015" y="560" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_LeanGreen_di" bpmnElement="Gateway_LeanGreen" isMarkerVisible="true">
        <dc:Bounds x="1215" y="580" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1185" y="540" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate">
        <dc:Bounds x="1335" y="710" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Render_di" bpmnElement="Task_Render">
        <dc:Bounds x="1495" y="710" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review">
        <dc:Bounds x="1655" y="860" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ReviewOutcome_di" bpmnElement="Gateway_ReviewOutcome" isMarkerVisible="true">
        <dc:Bounds x="1855" y="880" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1815" y="934" width="130" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Publish_di" bpmnElement="Task_Publish">
        <dc:Bounds x="1975" y="710" width="130" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Published_di" bpmnElement="EndEvent_Published">
        <dc:Bounds x="2182" y="737" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2145" y="777" width="110" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="A01_di" bpmnElement="A01">
        <di:waypoint x="298" y="155" />
        <di:waypoint x="375" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A02_di" bpmnElement="A02">
        <di:waypoint x="505" y="155" />
        <di:waypoint x="600" y="155" />
        <di:waypoint x="600" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A03_di" bpmnElement="A03">
        <di:waypoint x="665" y="305" />
        <di:waypoint x="760" y="305" />
        <di:waypoint x="760" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A04_di" bpmnElement="A04">
        <di:waypoint x="825" y="455" />
        <di:waypoint x="855" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A05_di" bpmnElement="A05">
        <di:waypoint x="985" y="455" />
        <di:waypoint x="1080" y="455" />
        <di:waypoint x="1080" y="560" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A06_di" bpmnElement="A06">
        <di:waypoint x="1145" y="605" />
        <di:waypoint x="1215" y="605" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A07_di" bpmnElement="A07">
        <di:waypoint x="1240" y="630" />
        <di:waypoint x="1240" y="665" />
        <di:waypoint x="1080" y="665" />
        <di:waypoint x="1080" y="650" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1150" y="634" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A08_di" bpmnElement="A08">
        <di:waypoint x="1265" y="605" />
        <di:waypoint x="1400" y="605" />
        <di:waypoint x="1400" y="710" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1290" y="572" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A09_di" bpmnElement="A09">
        <di:waypoint x="1465" y="755" />
        <di:waypoint x="1495" y="755" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A10_di" bpmnElement="A10">
        <di:waypoint x="1625" y="755" />
        <di:waypoint x="1720" y="755" />
        <di:waypoint x="1720" y="860" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A11_di" bpmnElement="A11">
        <di:waypoint x="1785" y="905" />
        <di:waypoint x="1855" y="905" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A12_di" bpmnElement="A12">
        <di:waypoint x="1880" y="880" />
        <di:waypoint x="1880" y="520" />
        <di:waypoint x="920" y="520" />
        <di:waypoint x="920" y="500" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1400" y="490" width="60" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A13_di" bpmnElement="A13">
        <di:waypoint x="1905" y="905" />
        <di:waypoint x="2040" y="905" />
        <di:waypoint x="2040" y="800" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1920" y="872" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="A14_di" bpmnElement="A14">
        <di:waypoint x="2105" y="755" />
        <di:waypoint x="2182" y="755" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
