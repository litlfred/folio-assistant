<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             id="Definitions_HumanTranslation"
             targetNamespace="http://folio-assistant.dev/bpmn/human-translation">

  <!-- ═══════════════════════════════════════════════════════════
       Human Translation Workflow — folio-assistant
       Issue: https://github.com/litlfred/folio-assistant/issues/206

       Swimlanes:
         - Translation Coordinator (assigns, tracks, manages)
         - Human Translator (translates, uses tools)
         - Subject-Matter Expert / Reviewer (reviews, signs off)
         - Automated Pipeline (extracts, injects, QA)
       ═══════════════════════════════════════════════════════════ -->

  <collaboration id="Collab_HumanTranslation">
    <participant id="Pool_HumanTranslation" name="Human Translation Process"
                 processRef="Process_HumanTranslation" />
  </collaboration>

  <process id="Process_HumanTranslation" name="Human Translation Workflow" isExecutable="false">

    <!-- ── Lanes ──────────────────────────────────────────────── -->
    <laneSet id="LaneSet_Main">
      <lane id="Lane_Coordinator" name="Translation Coordinator">
        <flowNodeRef>Start_TranslationNeeded</flowNodeRef>
        <flowNodeRef>Task_IdentifyContent</flowNodeRef>
        <flowNodeRef>Task_AssignTranslator</flowNodeRef>
        <flowNodeRef>Task_CheckCompleteness</flowNodeRef>
        <flowNodeRef>Gateway_Complete</flowNodeRef>
        <flowNodeRef>Task_RequestMoreWork</flowNodeRef>
      </lane>
      <lane id="Lane_Translator" name="Human Translator">
        <flowNodeRef>Task_ReceiveAssignment</flowNodeRef>
        <flowNodeRef>Task_TranslateInTool</flowNodeRef>
        <flowNodeRef>Task_SubmitPO</flowNodeRef>
      </lane>
      <lane id="Lane_Reviewer" name="Subject-Matter Expert / Reviewer">
        <flowNodeRef>Task_SMEReview</flowNodeRef>
        <flowNodeRef>Gateway_Accurate</flowNodeRef>
        <flowNodeRef>Task_ReturnForCorrection</flowNodeRef>
        <flowNodeRef>Task_Signoff</flowNodeRef>
        <flowNodeRef>End_OfficialTranslation</flowNodeRef>
      </lane>
      <lane id="Lane_Pipeline" name="Automated Pipeline">
        <flowNodeRef>Task_ExtractPOT</flowNodeRef>
        <flowNodeRef>Task_PrepareGlossary</flowNodeRef>
        <flowNodeRef>Task_InjectPO</flowNodeRef>
        <flowNodeRef>Task_RoundTripQA</flowNodeRef>
        <flowNodeRef>Gateway_Drift</flowNodeRef>
        <flowNodeRef>Task_AppendDisclaimer</flowNodeRef>
        <flowNodeRef>Task_WriteStatus</flowNodeRef>
      </lane>
    </laneSet>

    <!-- ══════ COORDINATOR LANE ════════════════════════════════ -->

    <startEvent id="Start_TranslationNeeded" name="Translation needed&#10;for content node(s)">
      <documentation>A translation coordinator identifies one or more content
nodes that require human translation into a target locale.</documentation>
    </startEvent>

    <userTask id="Task_IdentifyContent" name="Identify content&#10;and target locale">
      <documentation>The coordinator selects:
- Which content nodes need translation (block, section, chapter, or folio)
- The target locale (one of the supportedLocales in folio.config.json)
- The priority and deadline</documentation>
    </userTask>

    <userTask id="Task_AssignTranslator" name="Assign to qualified&#10;human translator">
      <documentation>The coordinator assigns the translation to a qualified
translator, ideally a domain SME for the content area. For WHO content,
the translator should be familiar with WHO SMART Guidelines terminology.

The assignment includes:
- The .pot file(s) from extraction
- The domain glossary
- Context notes (block kind, chapter, content area)
- The deadline</documentation>
    </userTask>

    <userTask id="Task_CheckCompleteness" name="Check translation&#10;completeness">
      <documentation>Verify that all msgid entries have msgstr translations.
Partial translations are acceptable for initial submissions but must be
flagged for follow-up. The coordinator checks:
- % of strings translated
- Any fuzzy-flagged entries
- Missing critical sections</documentation>
    </userTask>

    <exclusiveGateway id="Gateway_Complete" name="Complete enough?" />

    <userTask id="Task_RequestMoreWork" name="Request completion&#10;of remaining strings">
      <documentation>Return to the translator with a list of untranslated
or fuzzy strings that need attention.</documentation>
    </userTask>

    <!-- ══════ TRANSLATOR LANE ════════════════════════════════ -->

    <userTask id="Task_ReceiveAssignment" name="Receive assignment&#10;and materials">
      <documentation>The translator receives:
- .pot file with source strings (msgid)
- Domain glossary with approved term translations
- Context notes per string
- Style guide and WHO terminology references

Tools: Poedit, Weblate, Crowdin, or direct .po editing.</documentation>
    </userTask>

    <userTask id="Task_TranslateInTool" name="Translate strings&#10;in preferred tool">
      <documentation>The translator works through each msgid, producing
msgstr translations. They:
- Follow the domain glossary for technical terms
- Preserve placeholder tokens ({1}, {2}) in position
- Mark uncertain translations as #fuzzy
- Note any source ambiguities for the coordinator</documentation>
    </userTask>

    <userTask id="Task_SubmitPO" name="Submit completed&#10;.po file">
      <documentation>The translator submits the completed .po file back
to the pipeline. This may happen via:
- Git commit + push
- Weblate/Crowdin sync
- File upload to the coordinator</documentation>
    </userTask>

    <!-- ══════ REVIEWER LANE ══════════════════════════════════ -->

    <userTask id="Task_SMEReview" name="Review translation&#10;for accuracy">
      <documentation>A subject-matter expert reviews the injected translated
markdown for:
- Clinical/technical accuracy of terminology
- Preservation of meaning from the source
- Cultural appropriateness for the target locale
- Consistency with the domain glossary

For WHO content: the SME verifies that normative statements
("SHALL", "SHOULD", "MAY") are translated with the correct
force in the target language.</documentation>
    </userTask>

    <exclusiveGateway id="Gateway_Accurate" name="Translation accurate?" />

    <userTask id="Task_ReturnForCorrection" name="Return for correction&#10;with annotations">
      <documentation>The reviewer annotates specific passages that need
correction and returns to the translator with detailed feedback.
Each annotation includes:
- The passage in question
- What is wrong (terminology, meaning, style)
- The suggested correction or reference</documentation>
    </userTask>

    <userTask id="Task_Signoff" name="Sign off translation&#10;as official">
      <documentation>The reviewer signs off the translation, making it
official. This records:
- signedOffBy: the reviewer's identity
- signedOffAt: the current timestamp
- sourceHash: SHA-256 of the source .md
- level: block | section | chapter | folio

Tool: translation_signoff MCP tool</documentation>
    </userTask>

    <endEvent id="End_OfficialTranslation" name="Translation is official" />

    <!-- ══════ PIPELINE LANE ══════════════════════════════════ -->

    <serviceTask id="Task_ExtractPOT" name="Extract POT&#10;(translatable strings)">
      <documentation>Pre-processes source markdown:
1. Segments prose by paragraph
2. Shields non-translatable content (math, code, labels) as placeholders
3. Normalizes whitespace
4. Extracts metadata (titles, alt text, captions)
Produces .pot file(s) at the configured granularity.
Tool: translation_extract MCP tool</documentation>
    </serviceTask>

    <serviceTask id="Task_PrepareGlossary" name="Prepare domain&#10;glossary">
      <documentation>Generates or retrieves the domain glossary for the
target locale. Sources:
1. Root folio's translations/ glossary
2. Folio-assistant dependency translations (depth-first walk)
3. WHO standard terminology (from smart-base)
4. Previous translations of related content</documentation>
    </serviceTask>

    <serviceTask id="Task_InjectPO" name="Inject PO →&#10;translated Markdown">
      <documentation>Post-processes the completed .po file:
1. Substitutes msgstr for msgid in source markdown
2. Unshields placeholder tokens back to original content
3. Validates structural integrity (paragraph count, heading levels)
4. Validates completeness (flags empty msgstr)
5. Runs linting (doubled punctuation, orphaned placeholders)
Tool: translation_inject MCP tool</documentation>
    </serviceTask>

    <serviceTask id="Task_RoundTripQA" name="Round-trip&#10;translation QA">
      <documentation>Bean: folio-assistant-ktt2
Back-translates target-language .md to source language and compares
meaning. Distinguishes semantic drift from terminology misses.
Tool: translation_validate MCP tool</documentation>
    </serviceTask>

    <exclusiveGateway id="Gateway_Drift" name="Drift detected?" />

    <serviceTask id="Task_AppendDisclaimer" name="Append WHO&#10;disclaimer (if DAK)">
      <documentation>For WHO SMART Guidelines content, automatically appends
the WHO legal disclaimer:
- Translation not created by WHO
- English edition is authoritative original
- WHO not responsible for translation accuracy

Only applies when folio contentType includes WHO/DAK content.</documentation>
    </serviceTask>

    <serviceTask id="Task_WriteStatus" name="Write status.json&#10;(official)">
      <documentation>Writes translations/&lt;locale&gt;/status.json with the
official sign-off metadata and source hash for staleness detection.</documentation>
    </serviceTask>

    <!-- ══════ SEQUENCE FLOWS ═════════════════════════════════ -->

    <!-- Coordinator start -->
    <sequenceFlow id="F01" sourceRef="Start_TranslationNeeded" targetRef="Task_IdentifyContent" />
    <sequenceFlow id="F02" sourceRef="Task_IdentifyContent" targetRef="Task_ExtractPOT" />

    <!-- Pipeline: extract + glossary (parallel in practice, sequential in BPMN for clarity) -->
    <sequenceFlow id="F03" sourceRef="Task_ExtractPOT" targetRef="Task_PrepareGlossary" />
    <sequenceFlow id="F04" sourceRef="Task_PrepareGlossary" targetRef="Task_AssignTranslator" />

    <!-- Coordinator assigns to translator -->
    <sequenceFlow id="F05" sourceRef="Task_AssignTranslator" targetRef="Task_ReceiveAssignment" />

    <!-- Translator works -->
    <sequenceFlow id="F06" sourceRef="Task_ReceiveAssignment" targetRef="Task_TranslateInTool" />
    <sequenceFlow id="F07" sourceRef="Task_TranslateInTool" targetRef="Task_SubmitPO" />

    <!-- Back to coordinator for completeness check -->
    <sequenceFlow id="F08" sourceRef="Task_SubmitPO" targetRef="Task_CheckCompleteness" />
    <sequenceFlow id="F09" sourceRef="Task_CheckCompleteness" targetRef="Gateway_Complete" />
    <sequenceFlow id="F10" name="Incomplete" sourceRef="Gateway_Complete" targetRef="Task_RequestMoreWork" />
    <sequenceFlow id="F11" sourceRef="Task_RequestMoreWork" targetRef="Task_TranslateInTool" />
    <sequenceFlow id="F12" name="Complete" sourceRef="Gateway_Complete" targetRef="Task_InjectPO" />

    <!-- Pipeline: inject + QA -->
    <sequenceFlow id="F13" sourceRef="Task_InjectPO" targetRef="Task_RoundTripQA" />
    <sequenceFlow id="F14" sourceRef="Task_RoundTripQA" targetRef="Gateway_Drift" />
    <sequenceFlow id="F15" name="Drift found" sourceRef="Gateway_Drift" targetRef="Task_SMEReview" />
    <sequenceFlow id="F16" name="Clean" sourceRef="Gateway_Drift" targetRef="Task_SMEReview" />

    <!-- Reviewer -->
    <sequenceFlow id="F17" sourceRef="Task_SMEReview" targetRef="Gateway_Accurate" />
    <sequenceFlow id="F18" name="Needs correction" sourceRef="Gateway_Accurate" targetRef="Task_ReturnForCorrection" />
    <sequenceFlow id="F19" sourceRef="Task_ReturnForCorrection" targetRef="Task_TranslateInTool" />
    <sequenceFlow id="F20" name="Accurate" sourceRef="Gateway_Accurate" targetRef="Task_AppendDisclaimer" />

    <!-- Final pipeline steps -->
    <sequenceFlow id="F21" sourceRef="Task_AppendDisclaimer" targetRef="Task_Signoff" />
    <sequenceFlow id="F22" sourceRef="Task_Signoff" targetRef="Task_WriteStatus" />
    <sequenceFlow id="F23" sourceRef="Task_WriteStatus" targetRef="End_OfficialTranslation" />

  </process>

</definitions>
