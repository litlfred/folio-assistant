<?xml version="1.0" encoding="UTF-8"?>
<!--
  folio-assistant — Editing subprocess — evidence for a recommendation.

  STRAWPERSON. The shape is real and renders; the concrete registry list, the
  grading system and the API bindings are deliberately NOT fixed here. A
  separate process refines requirements; this file exists so there is something
  to refine instead of a conversation.

  Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
  BPMN 2.0 tool. The SVG under docs/assets/img/workflows/ is generated from it
  by `bun run render:bpmn` -- never hand-edit the SVG.

  The <folio:skill> extension on an activity names the folio-assistant skill
  that implements it; <folio:bean> marks a step that reads or writes the shared
  work plan in .beans/.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:folio="https://litlfred.github.io/folio-assistant/bpmn"
                  id="Definitions_EvidenceRetrieval"
                  targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:collaboration id="Collaboration_EvidenceRetrieval">
    <bpmn:participant id="Participant_EvidenceRetrieval" name="Editing subprocess — evidence for a recommendation" processRef="Process_EvidenceRetrieval" />
  </bpmn:collaboration>
  <bpmn:process id="Process_EvidenceRetrieval" name="Evidence for a recommendation" isExecutable="false">
    <bpmn:documentation>The author reviews the guidance already in their content, frames the question as PICO, retrieves candidate evidence across three classes (trusted L1 sources, trusted L2/L3 content, data repositories), verifies each candidate's authority against the publishing body's own API, grades the body of evidence, and either attaches it to the recommendation or records the gap. STRAWPERSON: registries, grading system and API bindings are not fixed here.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_EvidenceRetrieval">
      <bpmn:lane id="Lane_Author" name="Author / guideline developer (person)">
        <bpmn:flowNodeRef>StartEvent_Recommendation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewExisting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FramePico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AppraiseGrade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Sufficient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AttachEvidence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_EvidenceAttached</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Evidence agent (system)">
        <bpmn:flowNodeRef>Gateway_RetrievalFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L1Sources</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_L2L3Content</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DataRepos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetrievalJoin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Trusted" name="Trusted registries and observatories (external)">
        <bpmn:flowNodeRef>Task_VerifyAuthority</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Authoritative</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WorkPlan" name="Work plan — beans (shared)">
        <bpmn:flowNodeRef>Task_RecordUnverified</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordGap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_GapRecorded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Recommendation" name="A recommendation is in play">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewExisting" name="Review the guidance already in this content&#10;[content-review]">
      <bpmn:documentation>The author reads what the document, DAK or IG ALREADY says on this question, before looking outward. A recommendation that contradicts a sibling recommendation in the same artefact is a defect no external evidence will reveal.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FramePico" name="Frame the question as PICO&#10;[content-author]">
      <bpmn:documentation>Population, Intervention, Comparator, Outcome. The PICO is what makes the search reproducible and the evidence auditable: without it, &#x27;we looked for evidence&#x27; is not a claim anyone can check. WHO guideline development states the question this way before any retrieval.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-author" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="Gateway_RetrievalFork" name="Retrieve across evidence classes">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_L1Sources" name="Search trusted SOURCES — L1&#10;[document-intake]">
      <bpmn:documentation>Ingested primary literature under library/: the sections/*.md tree and, where a document was scanned, ocr/page-NNN.txt. NOTE the known blind spot — a document OCR&#x27;d but never re-run through pdf-structure.py has only a stub in sections/, so a sections-only search misses it.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="document-intake" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_L2L3Content" name="Search trusted CONTENT — L2 DAKs, L3 IGs&#10;[corpus-search]">
      <bpmn:documentation>Already-adjudicated guidance: WHO SMART DAKs at L2 and FHIR Implementation Guides at L3. A recommendation adopted in a published DAK is evidence of a different kind from a primary study -- it is a prior decision, with its own provenance, and must be cited as that rather than laundered into primary evidence.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="corpus-search" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DataRepos" name="Query data repositories and statistical datasets">
      <bpmn:documentation>Indicator and microdata sources. Distinct from the two above because the unit of evidence is a MEASUREMENT with a population, a period and a method, not a claim in prose.</bpmn:documentation>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_RetrievalJoin" name="Candidates assembled">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_VerifyAuthority" name="Verify authority against the observatory / registry API">
      <bpmn:documentation>Each candidate is resolved against the standard API of the body that publishes it, so that &#x27;authoritative&#x27; is a RESOLVED FACT rather than an assertion in the citation. What is checked: that the identifier resolves at the publisher; that the retrieved record matches what the citation claims; that the version and date are the ones cited; and that the publisher is one this folio has declared trusted. STRAWPERSON: the concrete registry list and endpoints are not settled here -- see the folio:policy note.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:policy enforcement="strict" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Authoritative" name="Authority confirmed?">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RecordUnverified" name="Open a bean for the unverified citation&#10;[todo-manager]">
      <bpmn:documentation>An unresolvable citation is not dropped and not silently kept. It becomes a tracked item, so the gap is visible in the work plan rather than surviving as a footnote nobody re-checks.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="todo-manager" />
        <folio:bean store=".beans/" op="note" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AppraiseGrade" name="Appraise and grade the body of evidence">
      <bpmn:documentation>Certainty of evidence per the grading system the folio declares. The grade attaches to the BODY of evidence for one PICO question, not to an individual citation -- which is why this step is after the join and not inside the fan-out.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Sufficient" name="Sufficient for a recommendation?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RecordGap" name="Record the evidence gap&#10;[todo-manager]">
      <bpmn:documentation>Insufficient evidence is a RESULT. It is recorded as such -- an honest gap the guideline can state -- rather than being closed by weakening the recommendation until the available evidence supports it.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="todo-manager" />
        <folio:bean store=".beans/" op="note" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AttachEvidence" name="Attach the evidence to the recommendation&#10;[content-author]">
      <bpmn:documentation>The PICO, the graded body of evidence, each verified citation and its resolved authority record are written onto the recommendation block, so a reader can retrace the whole chain from the sentence back to the source.</bpmn:documentation>
      <bpmn:extensionElements>
        <folio:skill ref="content-author" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_EvidenceAttached" name="Recommendation is evidence-backed">
      <bpmn:incoming>Flow_19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_GapRecorded" name="Gap recorded, no recommendation">
      <bpmn:incoming>Flow_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Recommendation" targetRef="Task_ReviewExisting" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_ReviewExisting" targetRef="Task_FramePico" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_FramePico" targetRef="Gateway_RetrievalFork" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_RetrievalFork" targetRef="Task_L1Sources" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Gateway_RetrievalFork" targetRef="Task_L2L3Content" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_RetrievalFork" targetRef="Task_DataRepos" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_L1Sources" targetRef="Gateway_RetrievalJoin" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Task_L2L3Content" targetRef="Gateway_RetrievalJoin" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Task_DataRepos" targetRef="Gateway_RetrievalJoin" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_RetrievalJoin" targetRef="Task_VerifyAuthority" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_VerifyAuthority" targetRef="Gateway_Authoritative" />
    <bpmn:sequenceFlow id="Flow_12" name="no" sourceRef="Gateway_Authoritative" targetRef="Task_RecordUnverified" />
    <bpmn:sequenceFlow id="Flow_13" name="yes" sourceRef="Gateway_Authoritative" targetRef="Task_AppraiseGrade" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_RecordUnverified" targetRef="Task_AppraiseGrade" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_AppraiseGrade" targetRef="Gateway_Sufficient" />
    <bpmn:sequenceFlow id="Flow_16" name="no" sourceRef="Gateway_Sufficient" targetRef="Task_RecordGap" />
    <bpmn:sequenceFlow id="Flow_17" name="yes" sourceRef="Gateway_Sufficient" targetRef="Task_AttachEvidence" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_RecordGap" targetRef="EndEvent_GapRecorded" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_AttachEvidence" targetRef="EndEvent_EvidenceAttached" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_EvidenceRetrieval">
    <bpmndi:BPMNPlane id="Plane_EvidenceRetrieval" bpmnElement="Collaboration_EvidenceRetrieval">
      <bpmndi:BPMNShape id="Participant_EvidenceRetrieval_di" bpmnElement="Participant_EvidenceRetrieval" isHorizontal="true"><dc:Bounds x="160" y="80" width="2760" height="720" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Author_di" bpmnElement="Lane_Author" isHorizontal="true"><dc:Bounds x="190" y="80" width="2730" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Agent_di" bpmnElement="Lane_Agent" isHorizontal="true"><dc:Bounds x="190" y="260" width="2730" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Trusted_di" bpmnElement="Lane_Trusted" isHorizontal="true"><dc:Bounds x="190" y="440" width="2730" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_WorkPlan_di" bpmnElement="Lane_WorkPlan" isHorizontal="true"><dc:Bounds x="190" y="620" width="2730" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Recommendation_di" bpmnElement="StartEvent_Recommendation"><dc:Bounds x="277" y="152" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ReviewExisting_di" bpmnElement="Task_ReviewExisting"><dc:Bounds x="420" y="130" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FramePico_di" bpmnElement="Task_FramePico"><dc:Bounds x="640" y="130" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RetrievalFork_di" bpmnElement="Gateway_RetrievalFork"><dc:Bounds x="880" y="325" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L1Sources_di" bpmnElement="Task_L1Sources"><dc:Bounds x="1010" y="215" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_L2L3Content_di" bpmnElement="Task_L2L3Content"><dc:Bounds x="1010" y="310" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DataRepos_di" bpmnElement="Task_DataRepos"><dc:Bounds x="1010" y="405" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_RetrievalJoin_di" bpmnElement="Gateway_RetrievalJoin"><dc:Bounds x="1240" y="325" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_VerifyAuthority_di" bpmnElement="Task_VerifyAuthority"><dc:Bounds x="1400" y="490" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Authoritative_di" bpmnElement="Gateway_Authoritative" isMarkerVisible="true"><dc:Bounds x="1620" y="505" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordUnverified_di" bpmnElement="Task_RecordUnverified"><dc:Bounds x="1760" y="670" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AppraiseGrade_di" bpmnElement="Task_AppraiseGrade"><dc:Bounds x="1900" y="130" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Sufficient_di" bpmnElement="Gateway_Sufficient" isMarkerVisible="true"><dc:Bounds x="2120" y="145" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecordGap_di" bpmnElement="Task_RecordGap"><dc:Bounds x="2260" y="670" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AttachEvidence_di" bpmnElement="Task_AttachEvidence"><dc:Bounds x="2400" y="130" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_EvidenceAttached_di" bpmnElement="EndEvent_EvidenceAttached"><dc:Bounds x="2640" y="152" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_GapRecorded_di" bpmnElement="EndEvent_GapRecorded"><dc:Bounds x="2440" y="692" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="313" y="170" /><di:waypoint x="366" y="170" /><di:waypoint x="366" y="170" /><di:waypoint x="420" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="590" y="170" /><di:waypoint x="615" y="170" /><di:waypoint x="615" y="170" /><di:waypoint x="640" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03"><di:waypoint x="810" y="170" /><di:waypoint x="845" y="170" /><di:waypoint x="845" y="350" /><di:waypoint x="880" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04"><di:waypoint x="930" y="350" /><di:waypoint x="970" y="350" /><di:waypoint x="970" y="255" /><di:waypoint x="1010" y="255" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05"><di:waypoint x="930" y="350" /><di:waypoint x="970" y="350" /><di:waypoint x="970" y="350" /><di:waypoint x="1010" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06"><di:waypoint x="930" y="350" /><di:waypoint x="970" y="350" /><di:waypoint x="970" y="445" /><di:waypoint x="1010" y="445" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07"><di:waypoint x="1180" y="255" /><di:waypoint x="1210" y="255" /><di:waypoint x="1210" y="350" /><di:waypoint x="1240" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08"><di:waypoint x="1180" y="350" /><di:waypoint x="1210" y="350" /><di:waypoint x="1210" y="350" /><di:waypoint x="1240" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09"><di:waypoint x="1180" y="445" /><di:waypoint x="1210" y="445" /><di:waypoint x="1210" y="350" /><di:waypoint x="1240" y="350" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10"><di:waypoint x="1290" y="350" /><di:waypoint x="1345" y="350" /><di:waypoint x="1345" y="530" /><di:waypoint x="1400" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11"><di:waypoint x="1570" y="530" /><di:waypoint x="1595" y="530" /><di:waypoint x="1595" y="530" /><di:waypoint x="1620" y="530" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12"><di:waypoint x="1670" y="530" /><di:waypoint x="1715" y="530" /><di:waypoint x="1715" y="710" /><di:waypoint x="1760" y="710" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13"><di:waypoint x="1670" y="530" /><di:waypoint x="1785" y="530" /><di:waypoint x="1785" y="170" /><di:waypoint x="1900" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14"><di:waypoint x="1930" y="710" /><di:waypoint x="1915" y="710" /><di:waypoint x="1915" y="170" /><di:waypoint x="1900" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15"><di:waypoint x="2070" y="170" /><di:waypoint x="2095" y="170" /><di:waypoint x="2095" y="170" /><di:waypoint x="2120" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16"><di:waypoint x="2170" y="170" /><di:waypoint x="2215" y="170" /><di:waypoint x="2215" y="710" /><di:waypoint x="2260" y="710" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17"><di:waypoint x="2170" y="170" /><di:waypoint x="2285" y="170" /><di:waypoint x="2285" y="170" /><di:waypoint x="2400" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18"><di:waypoint x="2430" y="710" /><di:waypoint x="2435" y="710" /><di:waypoint x="2435" y="710" /><di:waypoint x="2440" y="710" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19"><di:waypoint x="2570" y="170" /><di:waypoint x="2605" y="170" /><di:waypoint x="2605" y="170" /><di:waypoint x="2640" y="170" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
