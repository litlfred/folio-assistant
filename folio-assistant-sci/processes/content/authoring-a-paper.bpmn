<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:bootstrap.processes="https://litlfred.github.io/bootstrap/0.1.0/processes/ns/"
                  xmlns:cat-harness.processes="https://litlfred.github.io/cat-harness/0.1.0/processes/ns/"
                  id="Definitions_Process_PaperAuthoring" targetNamespace="https://litlfred.github.io/folio-assistant/workflows"
                  exporter="folio-assistant" exporterVersion="1">
  <bpmn:import namespace="https://litlfred.github.io/bootstrap/0.1.0/processes/ns/" location="https://litlfred.github.io/bootstrap/0.1.0/processes/ns.jsonld" importType="http://www.w3.org/ns/json-ld"/>
  <bpmn:resource id="author" name="Author"/>
  <bpmn:resource id="authoring-agent" name="Authoring agent"/>
  <bpmn:resource id="build-pipeline" name="Build pipeline"/>
  <bpmn:resource id="work-plan" name="Work plan (beans)"/>
  <bpmn:resource id="lean-toolchain" name="Lean toolchain"/>
  <bpmn:collaboration id="Collaboration_Process_PaperAuthoring">
    <bpmn:participant id="Participant_Process_PaperAuthoring" name="Authoring a paper" processRef="Process_PaperAuthoring"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_PaperAuthoring" name="Authoring a paper" isExecutable="false">
    <bpmn:documentation>How a scientific paper or book folio is authored end to end, with Lean for its formal claims and LaTeX for its typesetting.
      Source of truth: this file. Open it in bpmn.io, Camunda Modeler, or any other
      BPMN 2.0 tool. The SVG under docs/assets/img/workflows/ is generated from it
      by `bun run cat render:bpmn` — never hand-edit the SVG.
      The &lt;bootstrap.processes:skill&gt; extension on an activity names the folio-assistant skill
      that implements it; &lt;cat-harness.processes:bean&gt; marks a step that reads or writes the shared
      work plan in beans/.

Review, publish and committee feedback are core's shared Process_FolioReviewPublish, called after rendering. Its `no` answer, changes asked, comes back to Task_AuthorBlocks.</bpmn:documentation>
    <bpmn:extensionElements>
      <cat-harness.processes:policy enforcement="advisory"/>
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_Process_PaperAuthoring">
      <bpmn:lane id="Lane_Author" name="Author (person)" partitionElementRef="author">
        <bpmn:documentation>The plan set here — chapters, the blocks each needs, what gets formalised — is not revisited: GW_Published's 'no' branch re-enters Task_AuthorBlocks, not this lane, so a scoping mistake surfaces only as rework downstream.</bpmn:documentation>
        <bpmn:flowNodeRef>StartEvent_NewPaper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_BeanNotYours</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_WorkPlan" name="Work plan (beans)" partitionElementRef="work-plan">
        <bpmn:documentation>Opens and claims the bean, then turns the author's plan into beans, so a resumed session or another agent can pick up Task_Scaffold.</bpmn:documentation>
        <bpmn:flowNodeRef>Call_BeanOpen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_BeanYours</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SeedPlan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Agent" name="Authoring agent (system)" partitionElementRef="authoring-agent">
        <bpmn:documentation>Scaffolds the repo from the author's plan and writes every block, including every revision: GW_Published's 'no' branch returns here, not to Lane_Author.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Scaffold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuthorBlocks</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lean" name="Lean toolchain (lean-mcp)" partitionElementRef="lean-toolchain">
        <bpmn:documentation>Owns its own loop: Gateway_LeanGreen, computed by decisions/lean-build-gate.dmn from the build result, sends 'not yet' back to Task_Formalize. The paper reaches Task_Validate only when it says green.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Formalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LeanGreen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Build" name="Build pipeline" partitionElementRef="build-pipeline">
        <bpmn:documentation>Validates and renders the Lean-green manuscript, calls the shared review-and-publish process (Call_ReviewPublish), and closes the bean once GW_Published says yes. It decides nothing itself.</bpmn:documentation>
        <bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_PublishStatements</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Render</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_ReviewPublish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Published</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Call_BeanClose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Published</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_NewPaper" name="New paper">
      <bpmn:outgoing>A01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Plan" name="Plan the paper">
      <bpmn:documentation>Scope the paper: chapters, the blocks each needs, what gets formalised.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-plan"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A01</bpmn:incoming>
      <bpmn:outgoing>A02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_BeanNotYours" name="Not yours: left alone">
      <bpmn:documentation>Someone else holds the bean; this run stops without touching it.</bpmn:documentation>
      <bpmn:incoming>A05</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="Call_BeanOpen" name="Open the bean" calledElement="Process_BeanOpen">
      <bpmn:documentation>Process_BeanOpen: check before you create, find out whose the bean is, and claim it — or leave it alone when it is someone else's. The one place a claim is drawn; the gateway after this reads which end it reached.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="bean-coordination"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A02</bpmn:incoming>
      <bpmn:outgoing>A03</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="GW_BeanYours" name="Bean claimed?">
      <bpmn:documentation>Reads which end Process_BeanOpen reached. `claimed`: the bean is in progress and this process works it. `not yours`: a sibling session or a human holds it, nothing was written to it, and this process stops here rather than work a bean it does not own (bean-coordination).</bpmn:documentation>
      <bpmn:incoming>A03</bpmn:incoming>
      <bpmn:outgoing>A04</bpmn:outgoing>
      <bpmn:outgoing>A05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_SeedPlan" name="Seed the work plan">
      <bpmn:documentation>The plan becomes beans, so a resumed session or a sibling agent can pick it up.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager"/>
        <cat-harness.processes:bean op="note"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A04</bpmn:incoming>
      <bpmn:outgoing>A06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_Scaffold" name="Scaffold the folio repo">
      <bpmn:documentation>Create the folio repository with `bun run cat init-folio` (or the folio_init tool): content/, the document, chapter and first block manifests, the builder shim, AGENTS.md, .mcp.json, the session-start hook and the beans store, with the platform linked rather than copied.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-plan"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A06</bpmn:incoming>
      <bpmn:outgoing>A07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AuthorBlocks" name="Author blocks">
      <bpmn:documentation>Every block edit runs the HCI validation gate — see editing-hci-validation.bpmn.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-author"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A07</bpmn:incoming>
      <bpmn:incoming>A17</bpmn:incoming>
      <bpmn:outgoing>A08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Formalize" name="Formalise in Lean">
      <bpmn:documentation>Give each formal block (definition, theorem, lemma, proposition, corollary, conjecture, proof) a .lean sibling that Lean 4 accepts, in the order lean-formalization sets out. A compiling declaration is not a formalised claim: check vacuity and narrative drift before calling it done, and record the status with proof-verification.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="lean-formalization"/>
        <bootstrap.processes:skill ref="proof-verification"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A08</bpmn:incoming>
      <bpmn:incoming>A10</bpmn:incoming>
      <bpmn:outgoing>A09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_LeanGreen" name="Build green, no sorries?">
      <bpmn:documentation>Answered by the Lean build after formalisation: is it green with no `sorry` left? `not yet` loops on formalisation; `green` goes on to validation. A build that passes with a deferred (closeable) `sorry` is not green; a sorry standing in for an open conjecture does not hold the gate.</bpmn:documentation>
      <bpmn:extensionElements>
        <cat-harness.processes:decision ref="decisions/lean-build-gate.dmn#Decision_LeanBuildGate"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A09</bpmn:incoming>
      <bpmn:outgoing>A10</bpmn:outgoing>
      <bpmn:outgoing>A11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Validate" name="Validate">
      <bpmn:documentation>Run content validation over the folio: schemas, the content profile (formal kinds only in a paper), cross-block consistency and that the Lean builds. Loop back rather than rendering over a failure.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-validate"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A11</bpmn:incoming>
      <bpmn:outgoing>A12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Call_PublishStatements" name="Publish extracted statements" calledElement="Process_PublishExtractedStatements">
      <bpmn:documentation>The paper draws on library sources; every statement quoted or extracted from them is published in an appendix page of the paper and in the shared extraction viewer, each linked to its library entry and section, before the paper is rendered. These pages are EXPOSITION about sources, never part of a proof: nothing published here enters a formal statement or its Lean sibling. The sub-process is core's, the same for every content type; the paper supplies only the page look.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="publish-extracted-statements"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A12</bpmn:incoming>
      <bpmn:outgoing>A12b</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Task_Render" name="Render PDF and HTML">
      <bpmn:documentation>Typeset the paper through LaTeX to PDF and HTML. Run `latex-preflight` first to catch compile-breaking source patterns before a full compile. The preamble, class and macros belong to the folio, never to the platform.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="latex-authoring"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A12b</bpmn:incoming>
      <bpmn:outgoing>A13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:callActivity id="Call_ReviewPublish" name="Review and publish" calledElement="Process_FolioReviewPublish">
      <bpmn:documentation>Core's shared review-and-publish process (Process_FolioReviewPublish): the reviewer reads the rendered folio and approves it, asks for changes, or sends a working draft to the Authoring Committee.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="content-review"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A13</bpmn:incoming>
      <bpmn:outgoing>A14</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="GW_Published" name="Published?">
      <bpmn:documentation>Reads which end Process_FolioReviewPublish reached. `yes`: Published, so the bean is closed. `no`: Changes asked, or Feedback in, so the work goes back to Task_AuthorBlocks with the feedback.</bpmn:documentation>
      <bpmn:incoming>A14</bpmn:incoming>
      <bpmn:outgoing>A15</bpmn:outgoing>
      <bpmn:outgoing>A17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="Call_BeanClose" name="Close the bean" calledElement="Process_BeanClose">
      <bpmn:documentation>Process_BeanClose: end the bean in a state that says why — complete and archive it, scrap it with its reasons and archive it, or record the blocker and hand it back. The one place resolve and archive are drawn; placed straight before the end so the engine's resolve sees nothing left but the archive step.</bpmn:documentation>
      <bpmn:extensionElements>
        <bootstrap.processes:skill ref="todo-manager"/>
      </bpmn:extensionElements>
      <bpmn:incoming>A15</bpmn:incoming>
      <bpmn:outgoing>A16</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="EndEvent_Published" name="Paper published">
      <bpmn:incoming>A16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="A01" sourceRef="StartEvent_NewPaper" targetRef="Task_Plan"/>
    <bpmn:sequenceFlow id="A02" sourceRef="Task_Plan" targetRef="Call_BeanOpen"/>
    <bpmn:sequenceFlow id="A03" sourceRef="Call_BeanOpen" targetRef="GW_BeanYours"/>
    <bpmn:sequenceFlow id="A04" sourceRef="GW_BeanYours" targetRef="Task_SeedPlan" name="claimed"/>
    <bpmn:sequenceFlow id="A05" sourceRef="GW_BeanYours" targetRef="End_BeanNotYours" name="not yours"/>
    <bpmn:sequenceFlow id="A06" sourceRef="Task_SeedPlan" targetRef="Task_Scaffold"/>
    <bpmn:sequenceFlow id="A07" sourceRef="Task_Scaffold" targetRef="Task_AuthorBlocks"/>
    <bpmn:sequenceFlow id="A08" sourceRef="Task_AuthorBlocks" targetRef="Task_Formalize"/>
    <bpmn:sequenceFlow id="A09" sourceRef="Task_Formalize" targetRef="Gateway_LeanGreen"/>
    <bpmn:sequenceFlow id="A10" sourceRef="Gateway_LeanGreen" targetRef="Task_Formalize" name="not yet"/>
    <bpmn:sequenceFlow id="A11" sourceRef="Gateway_LeanGreen" targetRef="Task_Validate" name="green"/>
    <bpmn:sequenceFlow id="A12" sourceRef="Task_Validate" targetRef="Call_PublishStatements"/>
    <bpmn:sequenceFlow id="A12b" sourceRef="Call_PublishStatements" targetRef="Task_Render"/>
    <bpmn:sequenceFlow id="A13" sourceRef="Task_Render" targetRef="Call_ReviewPublish"/>
    <bpmn:sequenceFlow id="A14" sourceRef="Call_ReviewPublish" targetRef="GW_Published"/>
    <bpmn:sequenceFlow id="A15" sourceRef="GW_Published" targetRef="Call_BeanClose" name="yes"/>
    <bpmn:sequenceFlow id="A16" sourceRef="Call_BeanClose" targetRef="EndEvent_Published"/>
    <bpmn:sequenceFlow id="A17" sourceRef="GW_Published" targetRef="Task_AuthorBlocks" name="no"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Process_PaperAuthoring">
    <bpmndi:BPMNPlane id="Plane_Process_PaperAuthoring" bpmnElement="Collaboration_Process_PaperAuthoring">
      <bpmndi:BPMNShape id="Shape_Participant_Process_PaperAuthoring" bpmnElement="Participant_Process_PaperAuthoring" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="1525" height="890"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Author" bpmnElement="Lane_Author" isHorizontal="true">
        <dc:Bounds x="90" y="60" width="1495" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_WorkPlan" bpmnElement="Lane_WorkPlan" isHorizontal="true">
        <dc:Bounds x="90" y="210" width="1495" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Agent" bpmnElement="Lane_Agent" isHorizontal="true">
        <dc:Bounds x="90" y="360" width="1495" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Lean" bpmnElement="Lane_Lean" isHorizontal="true">
        <dc:Bounds x="90" y="510" width="1495" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Build" bpmnElement="Lane_Build" isHorizontal="true">
        <dc:Bounds x="90" y="660" width="1495" height="290"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_StartEvent_NewPaper" bpmnElement="StartEvent_NewPaper">
        <dc:Bounds x="140" y="117" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="121" y="157" width="76" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Plan" bpmnElement="Task_Plan">
        <dc:Bounds x="200" y="75" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_BeanNotYours" bpmnElement="End_BeanNotYours">
        <dc:Bounds x="382" y="117" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="425" y="125.0" width="120" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Call_BeanOpen" bpmnElement="Call_BeanOpen">
        <dc:Bounds x="200" y="225" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_BeanYours" bpmnElement="GW_BeanYours" isMarkerVisible="true">
        <dc:Bounds x="375" y="260" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="340" y="314" width="120" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SeedPlan" bpmnElement="Task_SeedPlan">
        <dc:Bounds x="500" y="225" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Scaffold" bpmnElement="Task_Scaffold">
        <dc:Bounds x="500" y="375" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AuthorBlocks" bpmnElement="Task_AuthorBlocks">
        <dc:Bounds x="660" y="375" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Formalize" bpmnElement="Task_Formalize">
        <dc:Bounds x="660" y="525" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_LeanGreen" bpmnElement="Gateway_LeanGreen" isMarkerVisible="true">
        <dc:Bounds x="830" y="560" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="795" y="521" width="120" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Validate" bpmnElement="Task_Validate">
        <dc:Bounds x="925" y="675" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Call_PublishStatements" bpmnElement="Call_PublishStatements">
        <dc:Bounds x="1080" y="675" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Render" bpmnElement="Task_Render">
        <dc:Bounds x="1235" y="675" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Call_ReviewPublish" bpmnElement="Call_ReviewPublish">
        <dc:Bounds x="1405" y="675" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GW_Published" bpmnElement="GW_Published" isMarkerVisible="true">
        <dc:Bounds x="1440" y="860" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1405" y="914" width="120" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Call_BeanClose" bpmnElement="Call_BeanClose">
        <dc:Bounds x="1235" y="825" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Published" bpmnElement="EndEvent_Published">
        <dc:Bounds x="960" y="867" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="918" y="907" width="120" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_A01" bpmnElement="A01">
        <di:waypoint x="176" y="135"/>
        <di:waypoint x="200" y="135"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A02" bpmnElement="A02">
        <di:waypoint x="260" y="195"/>
        <di:waypoint x="260" y="225"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A03" bpmnElement="A03">
        <di:waypoint x="320" y="285"/>
        <di:waypoint x="375" y="285"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A04" bpmnElement="A04">
        <di:waypoint x="425" y="285"/>
        <di:waypoint x="500" y="285"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A05" bpmnElement="A05">
        <di:waypoint x="400" y="260"/>
        <di:waypoint x="400" y="153"/>
        <bpmndi:BPMNLabel><dc:Bounds x="404" y="224.25" width="90" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A06" bpmnElement="A06">
        <di:waypoint x="560" y="345"/>
        <di:waypoint x="560" y="375"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A07" bpmnElement="A07">
        <di:waypoint x="620" y="435"/>
        <di:waypoint x="660" y="435"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A08" bpmnElement="A08">
        <di:waypoint x="720" y="495"/>
        <di:waypoint x="720" y="525"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A09" bpmnElement="A09">
        <di:waypoint x="780" y="585"/>
        <di:waypoint x="830" y="585"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A10" bpmnElement="A10">
        <di:waypoint x="855" y="610"/>
        <di:waypoint x="855" y="630"/>
        <di:waypoint x="780" y="630"/>
        <bpmndi:BPMNLabel><dc:Bounds x="859" y="611" width="90" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_A11" bpmnElement="A11">
