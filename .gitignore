node_modules/
dist/
# Jekyll build output — the docs site is built from docs/, never committed.
_site/
*.js
*.js.map
*.d.ts
# ...except hand-written ambient declarations. `types/` holds ones for packages
# that ship none (bpmn-moddle); the blanket rule above is for generated output,
# and without this exception a fresh clone fails `tsc` on a missing module.
!types/*.d.ts
.env
.env.*
*.log
.DS_Store

# Build outputs — regenerate locally, never commit
build/

# Generated files — regenerate with `npm run generate:all`
schemas/generated/
content/audit-tex-source.json

# Agent worktrees (Claude Code `isolation: worktree`). Live, locked git
# worktrees created per background agent and removed when it finishes —
# transient tooling state, never repository content.
.claude/worktrees/
# Python bytecode. There are 44 .py files here and no ignore for their
# artefacts, so any `python -m py_compile` / import leaves `__pycache__`
# directories staged for the next `git add -A`.
__pycache__/
*.py[cod]

# Agent scratch state — transient tooling state, never repository content.
# Same class as .claude/worktrees/ above. A sandbox accumulates these as
# untracked directories and a `git add -A` sweeps them into an unrelated
# commit; in the qou folio that mechanism committed 46,155 files under a
# one-file Lean subject line. Prophylactic here — folio-assistant has none
# of these today, and should not acquire them.
#
# ANCHORED with a leading slash — root-level only. A gitignore pattern with no
# internal slash matches at EVERY depth, so the unanchored form these entries
# originally had reaches into nested directories that share a name. In the qou
# folio that captured two documented archives — `computations/_deprecated/`
# (1,449 tracked files, including `script-qa/*.script-qa.json` QA sidecars) and
# `docs/audits/_deprecated/` (66) — where any NEW file would then be skipped by
# `git add` with no error. Keep the leading slash on every entry.
/.agents/
/amalgamated_done/
/amalgamated_input/
/_deprecated/
/scratch/

# Symlink farm created by the CONTENT repo's scripts/setup-folio-assistant.sh
# (e.g. content/schema/references.ts -> <content-repo>/content/schema/references.ts).
# Machine-local absolute paths — useful in a working clone, meaningless in git.
content/schema/

# The same script bridges the bibliography by a SECOND path, because the
# platform imports it two ways — qa-checkers-extended.ts reads
# <clone>/content/schema/references (above) and export-bibtex.ts reads
# <clone>/schemas/references (here). That second link was added later and
# never ignored, so it has been showing up as an untracked file in every
# working clone.
#
# Scoped to the one path, NOT the directory: schemas/ holds real tracked
# source (block-qa.ts, lean-packages.ts, ...) and ignoring it wholesale
# would silence `git add` on all of it.
/schemas/references.ts

# Per-machine subagent memory (`memory: local` scope). The committed
# `project` scope lives at .claude/agent-memory/ and is tracked.
.claude/agent-memory-local/

# docs/assets/js is SOURCE, not build output. The rule above exists because
# compiled JS is generated next to its .ts; these files are hand-written and
# vendored assets that Jekyll serves verbatim to the browser, so there is no
# build step that could regenerate them.
!docs/assets/js/
!docs/assets/js/**/*.js

# Same reason, different directory. `docs/_includes/mermaid_config.js` is the
# hook just-the-docs interpolates into its `mermaid.initialize()` call (see
# that theme's `_includes/components/mermaid.html`). It is a .js file that is
# hand-written source and lives OUTSIDE docs/assets, so the exception above
# does not reach it — `git add` reported nothing and the file would simply
# never have deployed.
!docs/_includes/*.js

# Build stamp written by .github/workflows/docs-site.yml at deploy time.
# Never committed: a sha in the repo names the commit BEFORE the deploy.
docs/_data/build.yml

# Build artifacts: regenerated from the tree, stale the moment they are
# committed. `_kg/` is the published KG export; `registry.json` is the runtime
# manifest `scripts/generate-registry.ts` writes. Neither was ignored before,
# and `registry.json` was nearly committed by accident while writing kg-export.
_kg/
.claude/skills/registry.json

# Playwright failure artefacts. `.last-run.json` is tracked (bb28f8e); the
# per-test directories are snapshots of a failing run — one reproduce-then-fix
# cycle wrote 3,040 lines of them into a commit here on 2026-09-19.
test-results/*/
