      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C09_di" bpmnElement="C09">
        <di:waypoint x="1400" y="580" />
        <di:waypoint x="1400" y="305" />
        <di:waypoint x="1495" y="305" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1372" y="540" width="25" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C10_di" bpmnElement="C10">
        <di:waypoint x="1560" y="260" />
        <di:waypoint x="1560" y="100" />
        <di:waypoint x="600" y="100" />
        <di:waypoint x="600" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Call_PublishStatements_di" bpmnElement="Call_PublishStatements">
        <dc:Bounds x="1420" y="395" width="120" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="C11_di" bpmnElement="C11">
        <di:waypoint x="1425" y="605" />
        <di:waypoint x="1480" y="605" />
        <di:waypoint x="1480" y="515" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C11b_di" bpmnElement="C11b">
        <di:waypoint x="1540" y="455" />
        <di:waypoint x="1660" y="455" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C12_di" bpmnElement="C12">
        <di:waypoint x="1780" y="455" />
        <di:waypoint x="1800" y="455" />
        <di:waypoint x="1800" y="755" />
        <di:waypoint x="1820" y="755" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C13_di" bpmnElement="C13">
        <di:waypoint x="1940" y="755" />
        <di:waypoint x="2022" y="755" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Shape_DSR_work_plan" bpmnElement="DSR_work_plan"><dc:Bounds x="1535" y="870" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1589" y="877" width="90" height="36" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_DOA_Task_QcBeans" bpmnElement="DOA_Task_QcBeans"><di:waypoint x="1560" y="350"/><di:waypoint x="1560" y="870"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
