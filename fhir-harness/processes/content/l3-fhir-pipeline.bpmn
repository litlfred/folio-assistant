        <di:waypoint x="1180" y="605" />
        <bpmndi:BPMNLabel><dc:Bounds x="1111" y="434" width="90" height="18" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="C08_di" bpmnElement="C08">
        <di:waypoint x="1300" y="605" />
