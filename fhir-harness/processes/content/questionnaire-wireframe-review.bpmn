      <bpmndi:BPMNShape id="Shape_GW_L2" bpmnElement="GW_L2" isMarkerVisible="true">
        <dc:Bounds x="745" y="290" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="725" y="251" width="90" height="35" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
