{
  "name": "@litlfred/fhir-harness",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aehrc/sdc-assemble": "2.0.3",
    "@aehrc/sdc-populate": "4.7.2",
    "@aehrc/sdc-template-extract": "1.0.16",
    "liquidjs": "^10.29.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/fhir": "0.0.44",
    "ajv": "^6.15.0",
    "playwright": "1.63.0"
  },
  "peerDependencies": {
    "@litlfred/cat-harness-tools": "*"
  },
  "peerDependenciesMeta": {
    "@litlfred/cat-harness-tools": {
      "optional": true
    }
  },
  "checkoutScripts": {
    "check:artifact-index": "bun run fhir-harness/scripts/check-artifact-index.ts",
    "check:ig-annex-links": "bun run fhir-harness/scripts/check-ig-annex-links.ts",
    "check:ig-content-qa": "bun run fhir-harness/scripts/ig-content-qa.ts gate",
    "ig-content-qa:scan": "bun run fhir-harness/scripts/ig-content-qa.ts scan",
    "ig-content-qa:record": "bun run fhir-harness/scripts/ig-content-qa.ts record",
    "ingest:ig-chrome": "bun run fhir-harness/scripts/ingest-ig-chrome.ts",
    "ingest:ig-menu": "bun run fhir-harness/scripts/ingest-ig-menu.ts",
    "ig-ast:schema": "bun run fhir-harness/scripts/ig-ast.ts schema",
    "ig-ast:schema:check": "bun run fhir-harness/scripts/ig-ast.ts schema --check",
    "instantiate:fhir-harness": "bun run fhir-harness/scripts/ig-instantiate.ts",
    "prepare:fhir-harness": "bash fhir-harness/scripts/ig-ast-build.sh --ig-root .",
    "ig-site:ast": "bun run fhir-harness/scripts/ig-repo-site.ts ast",
    "ig-site:compose": "bun run fhir-harness/scripts/ig-repo-site.ts compose",
    "ig-site:publisher-pages": "bun run fhir-harness/scripts/ig-repo-site.ts publisher-pages",
    "ig-site:bar": "bun run fhir-harness/scripts/ig-repo-site.ts bar",
    "ig-site:page-render-qa": "bun run fhir-harness/scripts/ig-page-render-qa.ts",
    "ig-ast:pages": "bun run fhir-harness/scripts/gen-ig-ast-pages.ts",
    "ig-index:build": "bun run fhir-harness/scripts/build-ig-indexes.ts",
    "ig-ast:pin": "bun run fhir-harness/scripts/ig-ast-pin.ts",
    "ig-ast:lock:check": "bun run fhir-harness/scripts/ig-ast-pin.ts --check"
  },
  "overrides": {
    "node-forge": "^1.4.2",
    "zod": "^4.6.7",
    "minimatch": "^11.0.3",
    "glob": "^14.0.3",
    "csv-parse": "^7.0.3"
  }
}
