# The IG build toolchain, pinned: one exact version each, read by
# .github/workflows/ig-ast-refresh.yml (setup-java, setup-node, setup-ruby,
# the SUSHI and Jekyll installs, and the `fhir-ig-tooling` cache key, which hashes this file) and by
# scripts/ig-ast-build.sh. Change a version here, and only here; the cache key
# moves with it, so no entry built with another toolchain is restored.
# Declared cache: caches/fhir-ig-tooling.cache.json.
JAVA_VERSION=17
NODE_VERSION=20
SUSHI_VERSION=3.21.0
RUBY_VERSION=3.3
JEKYLL_VERSION=4.4.1
