// A supplement whose id the French supplement already uses: SUSHI refuses
// two CodeSystems with one id, and the check names both files.
CodeSystem: ColourDe
Id: colour-fr
Title: "Colour (de)"
Description: "German designations of the colours, under the French supplement's id."
* ^content = #supplement
* ^supplements = Canonical(ColourCS)
* ^language = #de
* #red "Rot"
