{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "ig-ast-dependencies/v1"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "targetVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolved": {
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "origin": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "kind",
          "target",
          "targetVersion",
          "resolved",
          "origin"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "$schema",
    "dependencies"
  ],
  "additionalProperties": {},
  "$id": "https://litlfred.github.io/fhir-harness/0.1.0/ns/ig-ast/ig-ast-dependencies.schema.json",
  "title": "IG AST dependencies (ig-ast-dependencies/v1)"
}
