{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "const": "ig-ast/v1"
    },
    "authority": {
      "type": "string",
      "const": "cache"
    },
    "provisional": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provisionalUntil": {
      "type": "string"
    },
    "mixed": {
      "type": "boolean"
    },
    "incremental": {
      "type": "object",
      "properties": {
        "base": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "rebuilt": {
          "type": "number"
        },
        "kept": {
          "type": "number"
        },
        "removed": {
          "type": "number"
        }
      },
      "required": [
        "base",
        "head",
        "rebuilt",
        "kept",
        "removed"
      ],
      "additionalProperties": {}
    },
    "generatedAt": {
      "type": "string"
    },
    "toolchain": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "inputs": {
      "type": "object",
      "properties": {
        "toolchain": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "string"
        },
        "inputDigest": {
          "type": "string"
        }
      },
      "required": [
        "toolchain"
      ],
      "additionalProperties": {}
    },
    "inputsUnknown": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "canonical": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "resourceType": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "builtAt": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "canonical",
          "version",
          "resourceType",
          "id",
          "file",
          "source"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "$schema",
    "authority",
    "provisional",
    "resources"
  ],
  "additionalProperties": {},
  "$id": "https://litlfred.github.io/fhir-harness/0.1.0/ns/ig-ast/ig-ast.schema.json",
  "title": "IG AST manifest (ig-ast/v1)"
}
