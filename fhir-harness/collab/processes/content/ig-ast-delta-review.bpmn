      <bpmndi:BPMNShape id="Shape_DSR_work_plan" bpmnElement="DSR_work_plan"><dc:Bounds x="1235" y="836" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="984" y="647" width="90" height="36" /></bpmndi:BPMNLabel>
