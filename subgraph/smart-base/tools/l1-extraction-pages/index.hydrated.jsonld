  "hasMember": [
    {
      "@id": "http://smart.who.int/base/tools/l1-extraction-pages.jsonld",
      "@type": "cat-harness:Tool",
      "description": "For every visualiser an instance declares with `renderedBy: l1-extraction-pages`, write the hub at `<locale>/<harness>/<id>/` and, with `subgraphs: \"instance\"`, one page per instance that declares an `l1-extraction` directory. Each page shows, from what the files declare: the L1 statements (graph nodes with a `statement`, and an authored L1 source's `recommendations`); the candidate work list's counts, coverage and decisions; each graph document's nodes by type and edges by predicate (L2 scenario candidates included); counts of curation, mapping, vocabulary, exclusions and run context; and a link from every file to its published copy (cat-harness's `library:viz`), when the site has it, and to its source at the pinned commit. A declared directory not on disk is reported UNKNOWN, never zero.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run smart-base/scripts/gen-l1-extraction-pages.ts"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--site"
            },
            "description": "The site being built; pages go under it (cat-harness-tools' `visualiser-writers.ts` passes it). Default: the checkout's site directory.",
            "name": "site",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--root"
            },
            "description": "The checkout whose declarations are read. Default: the checkout holding the working directory.",
            "name": "root",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "description": "Write nothing; exit 1 when a page is stale, missing or orphaned.",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Pages written: the hub and one per instance.",
            "name": "pages",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          }
        ]
      },
      "name": "l1-extraction-pages",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/graph-rendering",
      "title": "L1 extraction viewer: a hub and a page per instance with `l1-extraction` directories"
    }
