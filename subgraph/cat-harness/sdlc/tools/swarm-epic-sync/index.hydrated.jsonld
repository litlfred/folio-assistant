      "@type": "cat-harness:Tool",
      "description": "Idempotently create, claim, or refresh any parent Swarm Work Item (`epic` or `milestone`, parameterized by `--epic-id` or `--swarm-slug`, for example a repository `stability` merge swarm, a proof-closure swarm, a graph-detangling swarm, or a literature-audit swarm) with a live Cold-Start Handover Runbook synthesized from `git worktree list`, forge pull-request queues, host process/memory/swap headroom, and `beans` child queues, then push the updated handover note and state to the shared `beans` branch (`cat/cat-harness/beans`).",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "python3 -m swarm_epic_sync"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--epic-id"
            },
            "description": "Existing parent Swarm Work Item identifier in `beans`; when omitted, resolved or idempotently created from `--swarm-slug`.",
