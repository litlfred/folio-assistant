  "hasMember": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/lsi-query.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Find units of a declared prose graph (a library, the skills, the beans, docs) that discuss a query in OTHER words — the vocabulary gap lexical search cannot reach. Each hit is labelled lexical+latent or latent only, and the score is a cosine in the latent space, never merged with a lexical result.",
      "install": {
        "none": true
      },
      "invoke": {
        "inProcess": {
          "module": "src/tools/lsi-query.ts"
        },
        "mcp": {
          "tool": "lsi_query"
        },
        "shell": "bun run cat lsi query"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "stdin": true
            },
            "description": "The query, in any words, on STDIN — free text never goes on a command line.",
            "name": "text",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          },
          {
            "arg": {
              "flag": "--instance"
            },
            "description": "Instance declaring the graph, e.g. `cat-harness`.",
            "name": "instance",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--graph"
            },
            "description": "Graph id within the instance, e.g. `library`.",
            "name": "graph",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          }
        ],
        "outputs": [
          {
            "description": "Per graph: the top hits by cosine, each marked lexical+latent or latent only.",
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
          }
        ]
      },
      "name": "lsi-query",
      "requirements": {
        "network": false
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/lsi-indexing",
      "title": "Latent Semantic Indexing over a prose graph"
    }
  ],
  "holdsGraph": [
    "cat-harness:graphTypology/tools"
