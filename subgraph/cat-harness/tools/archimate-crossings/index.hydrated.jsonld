      "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/archimate-crossings.jsonld",
      "@type": "cat-harness:Tool",
      "description": "For each view, as `render-view.ts` draws it, count the pairs of lines that cross and the lines that run through a box they do not connect (groups, and boxes that hold one of the line's ends, excepted). With `--view` it lists each tangle by the boxes it joins; with `--max` it is a gate.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat archimate:crossings"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--model"
            },
            "description": "The `.archimate` file (plain XML or Archi's zipped archive).",
            "name": "model",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--view"
            },
            "description": "One view, by its Archi id (`id-<hex>`) or its page slug (e.g. `1-central-health-workforce-registry`). A slug, not free text, so no shell payload can ride on it. Absent: every view in the model.",
            "name": "view",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
          },
          {
            "arg": {
              "flag": "--max"
            },
            "description": "Exit 1 if any view has more tangles than this.",
            "name": "max",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "description": "Print JSON instead of one line per view.",
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "Per view: crossings and lines through a box.",
            "name": "tangles",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "archimate-crossings",
      "requirements": {
        "network": false,
