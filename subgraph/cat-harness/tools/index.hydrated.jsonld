    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/ci-health/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/ci-health.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Report each workflow's state on the default branch, which a checkout cannot see: a red workflow looks exactly like a green one from in here. One API call over the recent run history, not one request per workflow — fanning out would exhaust the unauthenticated 60/hr limit and make it unusable at session start.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat check:ci-health"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--markdown"
                },
                "description": "Emit the block the session-start sweep prints. ALWAYS exits 0, deliberately: the sweep runs it as `if ! …; then` and would otherwise print the report AND declare it unchecked every time CI is red.",
                "name": "markdown",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--warn"
                },
                "description": "Report only, never fail. For a caller that wants the state without a verdict.",
                "name": "warn",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--out"
                },
                "description": "Write the markdown report to a file AND keep the exit code — which `--markdown` cannot do, since it always exits 0. The notifier gets its own flag rather than one API call being spent twice.",
                "name": "out",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ],
            "outputs": [
              {
                "description": "One row per workflow. Five verdicts, not two: green, red, `running`, `superseded` (a red whose workflow file changed after the failing run, so the verdict is against code that no longer exists), and possibly-stale (a red that has not re-run in a week). Three exit codes carry them to a caller that reads no rows: 0 nothing is red, 1 something is, 2 COULD NOT LOOK — the API was unreachable, or `--out` could not be written. A caller must never read 2 as either verdict. `--markdown` and `--warn` always exit 0 by design, so a caller wanting the verdict uses neither.",
                "name": "report",
                "render": {
                  "as": "markdown",
                  "reason": "a table a reader reads; rendered with raw HTML off"
                },
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
              }
            ]
          },
          "name": "ci-health",
          "requirements": {
            "network": true,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/ci-health",
          "title": "Is CI passing on the default branch?"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/ci-health",
      "path": "tools/ci-health/"
    },
