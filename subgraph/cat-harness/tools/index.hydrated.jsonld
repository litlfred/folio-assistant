          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "stdin": true
                },
                "description": "The query, in any words, on STDIN — free text never goes on a command line.",
                "name": "text",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
