          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/secrets-check.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Compare each repository's declared credential needs (`credentials/needs.json`, profile and registry) with the `secrets.NAME` expressions its workflows reference (GitHub Actions' dollar-and-double-brace form, said in words because this text is rendered on a Jekyll page), with the secret names GitHub lists when a token allows it, and with any recorded expiry. NAMES ONLY — no value is ever read. Findings per §6.2: used-not-declared, declared-not-used, declared-not-present, present-not-declared (reported, never deleted), naming advisories, and expiry (≤30 days minor, ≤7 major, expired critical). Exits 2 when anything could not be determined, which outranks clean; else 1 on a major or critical finding; else 0.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat secrets:check"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "positional": 0
                },
                "description": "Repository checkouts to check. Default: every repository the index mounts.",
                "name": "repos",
                "repeated": true,
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--json"
                },
                "description": "Print the result as JSON instead of the human report.",
                "name": "json",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ],
            "outputs": [
