                "description": "The exit status: 0 clean, 1 a major or critical finding, 2 could not determine.",
                "name": "verdict",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ]
