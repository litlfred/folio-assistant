    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/witness-parity/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/witness-parity.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Re-run a computation witness's producer and say whether it reproduces the committed witness. Reads the command from `invocation.reproduce` (else `python3 <scriptFile>`) and the recorded package versions from `environment`; on a version mismatch it stops at `unknown`, since a different environment is not a reproduction test. Otherwise it runs the COMMITTED producer in a scratch git worktree, so the folio's own checkout is never written, and compares the result with the committed witness with run-specific fields (commit, timing, environment) masked at every depth. `pass`, `fail` (with the differing JSON paths), or `unknown` (mismatch, non-zero exit, timeout, no witness written).",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat witness:parity"
          },
          "io": {
            "inputs": [
              {
                "description": "One or more `*.witness.json` paths, committed at HEAD.",
                "name": "witness",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--timeout"
                },
                "description": "Seconds before a run counts as `unknown`. Default 300.",
                "name": "timeout",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
              },
              {
                "arg": {
                  "flag": "--force"
                },
                "description": "Run despite an environment mismatch; the verdict is then marked advisory.",
                "name": "force",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--json"
                },
                "description": "Machine-readable output.",
                "name": "json",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ],
            "outputs": [
              {
                "description": "One line per witness: pass, fail or unknown, with the reason, any environment mismatch and the differing paths. Exit 1 when any witness fails; `unknown` alone exits 0.",
                "name": "verdicts",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
              }
            ]
          },
          "name": "witness-parity",
          "requirements": {
            "network": false,
            "runtime": [
              "bun",
              "git",
              "bash"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/directory-conventions",
          "title": "Witness reproduction check"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/witness-parity",
      "path": "tools/witness-parity/"
    },
