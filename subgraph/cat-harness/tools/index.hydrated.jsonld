    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/remote-mount/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/remote-mount.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Lay down each declared remote mount — a `source.remote` instance in the root `index.config.json`, or, in a folio with no index, a `remoteMounts` entry on its declaration (both at once is refused) — and its dependency closure, from another repository at a full commit SHA. Write the lock, `index.lock.json` (a legacy `<name>.mount-lock.json` is read, and renamed onto it when rewritten), and, with an index, regenerate the root `.gitignore` block that ignores each mount path. It READS the declared mounts and never writes them: a tool that changes a mount writes through `writeDeclaredMounts` into `index.config.json`. Before anything is checked out, each mount must pass the trust gate (`schemas/kg/mount-trust.ts`, rule H8): a person's consent recorded for THIS pin, or a signature in a declared trust network. No signature verifier exists yet, so a signature alone is could-not-determine and does not mount. Unsigned and unconsented is refused. `--staging` mounts for a preview and needs neither, by the owner's ruling. A directory id an override or `mountDefaults` names may be one the instance declares in its `<name>.json` or one it declares FROM WITHIN a declared directory (`skills/skills.json` naming `voices`), resolved at the pin through `instanceDirectories` (bean `mo75` G3); an id in neither is refused at plan time. `tools` on an override names Tools by id and mounts each one runnable (bean `mo75` G3; owner, 2026-10-24): its definition (`<tools dir>/<id>/<id>.ts`), its implementation (the `inProcess.module`, or the script its `bun run cat <key>` resolves to) and their import closure, walked by bootstrap-tools' `importClosure` (the one closure walker), as every declared directory that closure touches — the lock still records directories only. A `hydrated` mount (bean `mo75`) lays each chosen directory down as its published `index.hydrated.jsonld` only: read from the pin's git tree when a commit carries it, otherwise fetched from the pin's subgraph index package (the `subgraph-index-<sha>` release asset `subgraph-index-package` publishes), its tarball checked against its `folio-binary-release/v1` record, its manifest against the repository, pin and harness asked for, and each file against its sha256, `SubgraphHydratedSchema` and the subgraph IRI; the lock records the package's URL and sha256 so a replay fetches the same bytes. `--check` compares the disk against the lock and never fetches. When a run CHANGES the lock, it then re-renders the agent surface (`skill:commands` → `.claude/commands/`, `agent-memory` → `.claude/agent-memory/` and `.agents/`) from the checkout root, so a re-pin commit carries the skills and memory the new layers define; a generator that fails fails the run, and `--no-agent-surface` opts out.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat mount:remote"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--instance"
                },
                "description": "The downstream instance root; omitted, every declaring instance in the checkout.",
                "name": "instance",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--staging"
                },
                "description": "Mount for a staging preview: no signature or consent required.",
                "name": "staging",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--check"
                },
                "description": "Compare the disk against the lock; fetch nothing.",
                "name": "check",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--no-agent-surface"
                },
                "description": "Do not re-render `.claude/commands/` and the agent memory after a mount that changed the lock.",
                "name": "noAgentSurface",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--no-install"
                },
                "description": "Lay the pinned bytes down without `bun install` in each mounted instance that carries a `package.json`. By default the install runs (`--production`; `--install-all` keeps devDependencies), so the mounted tools run; it writes only `node_modules/`, which no mount digest covers, so `--check` still passes.",
                "name": "noInstall",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--seed"
                },
                "description": "`<name>=<owner/repo>@<40-char sha>`: create or re-pin that remote instance in `index.config.json` instead of mounting, writing its `trust.consent` for that pin in the same write (needs `consentBy` and `evidence`; repeatable; `--whole` mounts every tracked file). Refused while a mount it moves has edits the lock does not hold, since the next mount would leave that mount at the old commit (folio-assistant#2682); `fresh` lets it through.",
                "name": "seed",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/MountSeed"
              },
              {
                "arg": {
                  "flag": "--fresh"
                },
                "description": "Replace a mount whose bytes no longer hash to the lock instead of leaving it untouched; with `seed`, re-pin over such edits. The edits are discarded.",
                "name": "fresh",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--choose"
                },
                "description": "`<harness>[:<instance>]`: write a review's choice (`directories` and/or `tools`) into that mount entry's `overrides.<instance>` instead of mounting, so a fresh clone replays it (bean `mo75`). The pin and its consent are untouched; the next mount resolves the choice and the lock records what it resolved to.",
                "name": "choose",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/MountChoice"
              },
              {
                "arg": {
                  "flag": "--directories"
                },
                "description": "With `choose`: comma-separated directory ids, nested ids or concern names.",
                "name": "directories",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/IdList"
              },
              {
                "arg": {
                  "flag": "--tools"
                },
                "description": "With `choose`: comma-separated Tool ids, each mounted runnable.",
                "name": "tools",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/IdList"
              },
              {
                "arg": {
                  "flag": "--consent-by"
                },
                "description": "With `seed`: who consented, as `consent.by`.",
                "name": "consentBy",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Login"
              },
              {
                "arg": {
                  "stdin": true
                },
                "description": "With `seed`: where the consent was given, readable (a session, an issue comment), as `consent.evidence`. On stdin because it is free prose: it quotes what was said.",
                "name": "evidence",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
              }
            ],
            "outputs": [
              {
                "description": "Per instance: mounted, local, skipped, missing (including refused by the trust gate) or could-not-determine.",
                "name": "outcomes",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Count"
              }
            ]
          },
          "name": "remote-mount",
          "requirements": {
            "network": true,
            "runtime": [
              "bun",
              "git",
              "curl",
              "tar"
            ]
          },
          "satisfies": [
            "https://litlfred.github.io/folio-assistant/cat-harness/skill/security",
            "https://litlfred.github.io/folio-assistant/cat-harness/skill/agent-memory"
          ],
          "title": "Mount remote harnesses at a pinned commit, only when trusted"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/remote-mount",
      "path": "tools/remote-mount/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/render-log/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/render-log.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Append one entry to the render log on the publish branch: what was published or taken down, when, from which commit, and — for a removal or a retention — WHY. The log is the only place a preview that vanished leaves a trace.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat render:log"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--dir"
                },
                "description": "A checkout of the publish branch, or a publish directory about to become one. This tool NEVER fetches, commits or pushes: the workflows that call it already hold the checkout with their own retry and concurrency handling, and a second pusher racing those is a new way to lose a deploy.",
                "name": "dir",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--event"
                },
                "description": "`rendered`, `removed`, `restored` or `retained`. `retained` is the one that makes the log worth reading — a removal CONSIDERED and refused, which otherwise leaves no trace at all.",
                "name": "event",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RenderEvent"
              },
              {
                "arg": {
                  "flag": "--kind"
                },
                "description": "What was rendered — `staging-preview`, `site`, `export`. Open on purpose: the publish branch carries more than previews, and a closed enum would put a schema change between somebody and logging what they published.",
                "name": "kind",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
              },
              {
                "arg": {
                  "flag": "--path"
                },
                "description": "The path on the publish branch. Checked as a VALUE, never trusted by provenance: the slug sanitiser can emit `..`, and that is only safe for a slug taken from a git ref — a dispatch input is not one (bean `fuzm`).",
                "name": "path",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--slug"
                },
                "description": "The staging slug, where the subject has one.",
                "name": "slug",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
              },
              {
                "arg": {
                  "flag": "--branch"
                },
                "description": "The branch the render came from.",
                "name": "branch",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
              },
              {
                "arg": {
                  "flag": "--commit"
                },
                "description": "The commit the artefact was built from.",
                "name": "commit",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/CommitSha"
              },
              {
                "arg": {
                  "flag": "--run"
                },
                "description": "The workflow run that wrote this, so a reader can open the log.",
                "name": "run",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
              },
              {
                "arg": {
                  "stdin": true
                },
                "description": "One JSON object on STDIN: `{summary, reason?, detail?, format?}`. `summary` is required and one line. `reason` is required by the SCRIPT for `removed` and `retained` — an entry saying an artefact went and not why is the ambiguity the log exists to prevent. `format` declares how the prose reads (absent means plain text, never sniffed). Build it with `jq -n --arg`, never by concatenation.",
                "name": "prose",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Markdown"
              }
            ],
            "outputs": [
              {
                "description": "The day's JSONL the entry was APPENDED to. Append is the only verb: there is no `--remove`, no `--edit` and no `--id`, so a takedown is a `removed` ENTRY rather than the erasure of the `rendered` one before it — the never-delete rule made structural instead of a guard three cleanup paths have to remember.",
                "name": "entry",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ]
          },
          "name": "render-log",
          "requirements": {
            "network": false,
            "runtime": [
              "bun",
              "jq"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/render-logging",
          "title": "Record what the publish branch served"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/render-log",
      "path": "tools/render-log/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/render-order/",
