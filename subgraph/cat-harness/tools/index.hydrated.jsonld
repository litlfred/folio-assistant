    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/sub-kg-verify-clone/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/sub-kg-verify-clone.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Clone a separated sub-KG's repository (with submodules, and any sibling checkouts it needs) into an empty scratch directory, install, and run its gates: its `gates` script, else its `test` script (a person may pass `--gate` on the command line instead; it is not part of this contract because it is a shell command). Reports `green`, `red` or `unknown`; an empty tree, a failed clone or a repository with no gate is `unknown`, never green. Catches what a rehearsal inside this checkout cannot, because a rehearsal shares this checkout's `node_modules` and environment (#2082). Writes only inside the scratch directory.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat sub-kg:verify-clone"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--repo"
                },
                "description": "The separated repository, `owner/name`. (The script also takes a git URL or a local path, for tests.)",
                "name": "repo",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
              },
              {
                "arg": {
                  "flag": "--ref"
                },
                "description": "The branch or tag to clone, e.g. the seeding PR's branch.",
                "name": "ref",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
              },
              {
                "arg": {
                  "flag": "--sibling"
                },
                "description": "A repository to clone beside it, for a platform linked as a sibling checkout. Repeatable.",
                "name": "sibling",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
              },
              {
                "arg": {
                  "flag": "--work"
                },
                "description": "Scratch directory, kept afterwards. Absent: a temporary directory, removed afterwards.",
                "name": "work",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--text"
                },
                "description": "A report for a person instead of JSON.",
                "name": "text",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ],
            "outputs": [
              {
                "description": "`sub-kg-verify-clone/v1`: the commit cloned, each step with its status and output tail, and the verdict. Exit 0 green, 1 red, 2 unknown.",
                "name": "report",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
              }
            ]
          },
          "name": "sub-kg-verify-clone",
          "requirements": {
            "network": true,
            "runtime": [
              "bun",
              "git"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/sub-kg-lifecycle",
          "title": "Verify a separated repository from a fresh clone"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/sub-kg-verify-clone",
      "path": "tools/sub-kg-verify-clone/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/subgraph-index-package/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/subgraph-index-package.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Pack every built `index.jsonld` and `index.hydrated.jsonld` under an instance's `<docs>/subgraph/<harness>/` into ONE npm package for one pin — `<harness>-subgraph-index@0.0.0-pin.<sha>`, with a `folio-subgraph-index/v1` manifest giving each file's sha256 — through `pack-tarball` (`bun pm pack`), which also writes the tarball's `folio-binary-release/v1` record. The reusable workflow `layer-publish-subgraph-index.yml` attaches both to the GitHub release `subgraph-index-<sha>`, where `remote-mount` finds them for a `hydrated` source whose pin's git tree holds no index file (they are `builtAtPublish`, so none does). It builds nothing: run `subgraph:jsonld` first. No subgraph files under the instance is a refusal, never an empty package.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat subgraph-index:pack"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--root"
                },
                "description": "The instance root whose `<docs>/subgraph/<name>/` is packed.",
                "name": "root",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--repository"
                },
                "description": "owner/name of the repository the pin is a commit of.",
                "name": "repository",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoFullName"
              },
              {
                "arg": {
                  "flag": "--ref"
                },
                "description": "The pin: the full 40-character commit the files were built from.",
                "name": "ref",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/CommitSha"
              },
              {
                "arg": {
                  "flag": "--out-dir"
                },
                "description": "Where the tarball and its release record are written.",
                "name": "outDir",
                "required": true,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--built-in"
                },
                "description": "`<owner/name>@<40-char sha>` of the checkout the files were built in, recorded as provenance.",
                "name": "builtIn",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/PinnedRepo"
              }
            ],
            "outputs": [
              {
                "description": "The package `.tgz`.",
                "name": "tarball",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "Its `folio-binary-release/v1` record.",
                "name": "release",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ]
          },
          "name": "subgraph-index-package",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": [
            "https://litlfred.github.io/folio-assistant/cat-harness/skill/npm-kg-distribution",
            "https://litlfred.github.io/folio-assistant/cat-harness/skill/remote-mount"
          ],
          "title": "Package one pin's subgraph index files for a hydrated mount"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/subgraph-index-package",
      "path": "tools/subgraph-index-package/"
