    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/slice-sqlite/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/slice-sqlite.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Build a named slice of a graph (beans, todos, library, or the whole-repo kg) as one SQLite file a browser mounts without parsing it, beside a manifest carrying its sha256, a row-content digest, its row counts and the search block the one search page reads. Heavy text is indexed by a contentless FTS5 and not stored; each row points at a content-addressed payload. `--check` builds every slice twice, requires one sha256, and requires the row digest read back from the file to equal the one computed from the source.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat slice:sqlite"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--slice"
                },
                "description": "A slice to build; repeatable. Absent: every slice in the builder's table.",
                "name": "slice",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
              },
              {
                "arg": {
                  "flag": "--out"
                },
                "description": "Where the files and `index.json` go; defaults to the gitignored `docs/assets/slices/`. The deploy passes `./_site/assets/slices`.",
                "name": "out",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--payload-out"
                },
                "description": "Where the deploy payloads are written (`<hex>` plus its `<hex>.json` sidecar). Never the committed `docs/payload/`.",
                "name": "payloadOut",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--check"
                },
                "description": "Build twice and verify instead of writing: one sha256, the row digest against the source, an FTS5 phrase query, the payload audit.",
                "name": "check",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ],
            "outputs": [
              {
                "description": "`<slice>.<sha256>.sqlite3` (content-addressed) and its fixed-name `<slice>.sqlite3.json` manifest per slice, and `index.json` listing them.",
                "name": "slices",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "One line per slice: bytes, row counts, payloads, and any source findings; with `--check`, one verdict line per slice. Exit 1 on a red slice or an unreadable source.",
                "name": "report",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
              }
            ]
          },
          "name": "slice-sqlite",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/kg-export",
          "title": "Per-slice SQLite builder"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/slice-sqlite",
      "path": "tools/slice-sqlite/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/stage-local/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/stage-local.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Build a repository's site in the agent's checkout and push it to the publish branch, as a preview or as the main site, without an Actions runner. Which build is read from the repository: a declared `site.build` recipe (built by `build-instance-site`), else the reusable workflow its own workflow files call — `folio-staging.yml` for a folio, the WHO SMART Base IG's `ghbuild.yml` for a FHIR IG, whose `build` job is planned step by step and run as written. For an IG it then applies the harness chrome over the built output (`sync-docs-harness`, then `rail-standalone-pages --foreign-site --instance <the IG>`): every page gains the rail and the icon row `#fa-navbar-row`, and the IG's own content is left byte for byte. A root publish is REFUSED when the chrome cannot be applied, and a clean root deploy is refused over any root whose `index.html` wears the icon row unless the new output does too, so a chromed root is never replaced by bare IG Publisher pages. Every run prints its plan first, and the plan lists the chrome step; `--plan` stops there, `--dry-run` composes the commit in a temporary worktree and pushes nothing, `--artifact` writes a claude.ai Artifact bundle instead.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat stage:local"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--repo"
                },
                "description": "The checkout to publish, with the platform's layers mounted at its root. Default: the working directory.",
                "name": "repo",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--branch"
                },
                "description": "The branch to publish. Default: the checkout's. The default branch publishes the main site; any other a preview.",
                "name": "branch",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
              },
              {
                "arg": {
                  "flag": "--base"
                },
                "description": "A folio preview's base branch, for its ChangeSet and rendered impact.",
                "name": "base",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
              },
              {
                "arg": {
                  "flag": "--main"
                },
                "description": "Publish the main site at the root. Implied on the default branch, refused off it.",
                "name": "main",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--plan"
                },
                "description": "Print what would be built and where, every step named, and stop.",
                "name": "plan",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--dry-run"
                },
                "description": "Build and compose the commit in a temporary publish-branch worktree; push nothing.",
                "name": "dryRun",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              },
              {
                "arg": {
                  "flag": "--artifact"
                },
                "description": "Write a claude.ai Artifact bundle here instead of pushing.",
                "name": "artifact",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--workflow-source"
                },
                "description": "An IG: read the reusable workflow from this local checkout instead of fetching it at the ref its caller names.",
                "name": "workflowSource",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--publisher"
                },
                "description": "`folio` or `ig`, when the repository's workflows call both (the folio by default).",
                "name": "publisher",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Slug"
              },
              {
                "arg": {
                  "flag": "--run-url"
                },
                "description": "What the commit and render log name as the run. Default: the commit's URL.",
                "name": "runUrl",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
              }
            ],
            "outputs": [
              {
                "description": "Where the site is served once GitHub's Pages deploy has run, with the commit pushed (or, with --dry-run, the commit composed and discarded).",
                "name": "url",
                "render": {
                  "as": "url",
                  "reason": "a reader opens the published site; the scheme is checked before it reaches an href"
                },
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Url"
              }
            ]
          },
          "name": "stage-local",
          "requirements": {
            "network": true,
            "runtime": [
              "bun",
              "git"
            ]
          },
          "satisfies": [
            "https://litlfred.github.io/folio-assistant/cat-harness/skill/feature-staging",
            "https://litlfred.github.io/folio-assistant/cat-harness/skill/harness-tiles"
          ],
          "title": "Publish a folio's or an IG's site from the agent's own checkout — the one agent publish path"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/stage-local",
      "path": "tools/stage-local/"
    },
