    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/handover-screen/",
      "@type": "bootstrap:Subgraph",
      "hasMember": [
        {
          "@id": "https://litlfred.github.io/folio-assistant/cat-harness/tools/handover-screen.jsonld",
          "@type": "cat-harness:Tool",
          "description": "Before a model reads a sub-agent's report, a delegated prompt, a tool result or a comment from someone who is not the principal, screen it against a declared schema whose top-level fields are `control` (steers what the receiver does) or `data` (content it reads). A finding in a control field, or any field the strict schema does not declare, is REFUSED, so a report cannot extend the delegator's plan. A finding in a data field is QUARANTINED: the original is kept and marked, never stripped. The patterns are a deterministic tripwire (instruction overrides, role and turn spoofs, fence breaks, tool-call syntax, hidden Unicode, exfiltration links, pipe-to-shell), a mitigation and not a guarantee. Exit 0 clean, 1 refused, 3 quarantined, 2 could not determine.",
          "install": {
            "none": true
          },
          "invoke": {
            "shell": "bun run cat handover:screen"
          },
          "io": {
            "inputs": [
              {
                "arg": {
                  "flag": "--schema"
                },
                "description": "JSON `{ fields: { name: \"control\" | \"data\" }, strict?: boolean }`.",
                "name": "schema",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "description": "The hand-over, as a JSON object.",
                "name": "payload",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              },
              {
                "arg": {
                  "flag": "--text"
                },
                "description": "A single free-text input, screened as one DATA field.",
                "name": "text",
                "required": false,
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
              }
            ],
            "outputs": [
              {
                "description": "`clean`, `quarantined` or `refused`, with every finding's path, field role and kind; also the exit status.",
                "name": "verdict",
                "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
              }
            ]
          },
          "name": "handover-screen",
          "requirements": {
            "network": false,
            "runtime": [
              "bun"
            ]
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/security",
          "title": "Screen a hand-over for injected instructions, field by field"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/handover-screen",
      "path": "tools/handover-screen/"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/subgraph/cat-harness/tools/ig-folio-site-workflow/",
