            "network": false
          },
          "satisfies": "https://litlfred.github.io/folio-assistant/cat-harness/skill/vocabulary-authority",
          "title": "Apply a vocabulary mapping table"
        }
      ],
      "holdsGraph": [
        "cat-harness:graphTypology/tools"
      ],
      "name": "tools/vocab-map",
      "path": "tools/vocab-map/"
    },
