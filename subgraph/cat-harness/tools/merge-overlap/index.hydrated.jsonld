      "@type": "cat-harness:Tool",
      "description": "For the open PRs (via `gh`, or a list of branches), report which pairs would conflict: pairwise overlap on AUTHORED paths, with generated paths excluded using the merge-conflict-patterns declaration; which PRs touch a shared declaration (an instance's `<instance>.json`, `roles.json`, `package.json`, `bun.lock`, schemas, BPMN/DMN); and which touch the harness layer's directory or its tools layer's. A PR that could not be measured makes no pair independent. JSON (`merge-overlap/v1`), the conflict-prediction input for composing trains.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run cat merge:overlap"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "flag": "--base"
            },
            "description": "The base each PR is diffed against from its fork point; default `origin/main`.",
            "name": "base",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          },
          {
            "arg": {
              "positional": 0
            },
            "description": "Branches to compare instead of the open PRs; with none, the open PRs come from `gh`.",
            "name": "branches",
            "repeated": true,
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Branch"
          }
        ],
        "outputs": [
          {
            "description": "`merge-overlap/v1` on stdout: per member `authored_paths`, `region_paths`, `touches_shared`, the two harness flags; every pair that is not independent, with why.",
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "merge-overlap",
