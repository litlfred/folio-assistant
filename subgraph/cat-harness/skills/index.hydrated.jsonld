            {
              "@id": "https://litlfred.github.io/folio-assistant/cat-harness/skill/minimal-change",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "Three rules for any edit to a repository: make the smallest change that does the job and keep the diff minimal; read the repository's code-style files before writing code; and write Markdown without HTML tags. Use before writing a change and again when reviewing its diff.",
