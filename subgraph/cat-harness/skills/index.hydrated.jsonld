                "sha256": "41b3d0b4bc54c3d32cefe038a5168632a2281c4d9b49516b5d8bc29abab36374"
              },
              "title": "/getting-started — what did they actually ask for?"
            },
            {
              "@id": "https://litlfred.github.io/folio-assistant/cat-harness/skill/harness-projections",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "Who may write under `.claude/`, and when. The generated projections of the knowledge graph (`.claude/commands/*.md` from `skill:commands`, the assembled agent memory under `.claude/agents/` and `.claude/agent-memory/`) are written by CI, which commits them to the PR branch, and never by an agent. A hand-edited `.claude/` file (`settings.json`, its hooks, a hand-written command or agent definition) changes only with the owner's explicit consent to that change: the agent shows the exact diff and the reason, asks first, and records the consent. Read before staging any path under `.claude/`.",
              "hasIOContract": false,
              "hasInstructions": true,
              "inPackage": "https://litlfred.github.io/folio-assistant/cat-harness/package/conduct-core",
              "inSubgraph": "https://litlfred.github.io/folio-assistant/cat-harness/directory/skills",
              "instructionLines": 123,
              "instructionsPath": "skills/conduct/conduct-core/harness-projections.md",
