                "bytes": 12723,
                "sha256": "289de306060d9e84e147a618468d9ad8175e05075da6b6dbd72878ab8e9592f3"
              },
              "title": "/repo-conversion — folio-assistant over a repo that already has a life"
            },
            {
              "@id": "https://litlfred.github.io/folio-assistant/cat-harness/skill/retry-backoff",
              "@type": "bootstrap:Skill",
              "ambiguous": false,
              "description": "Every error gets a falling-off retry rate — each wait doubles, with jitter. Read before writing any call that can fail transiently, and before deciding that a failure is worth retrying at all. Exhausting the retries does not change the verdict.",
              "hasIOContract": false,
              "hasInstructions": true,
              "inPackage": "https://litlfred.github.io/folio-assistant/cat-harness/package/conduct-core",
              "inSubgraph": "https://litlfred.github.io/folio-assistant/cat-harness/directory/skills",
              "instructionLines": 122,
