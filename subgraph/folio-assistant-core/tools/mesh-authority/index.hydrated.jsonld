      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/tools/mesh-authority.jsonld",
      "@type": "cat-harness:Tool",
      "description": "Stage three of `skill-pipeline-subject-indexing` for MeSH: look up every candidate heading of a draft (a preferred heading, an entry term, or a descriptor id, with an optional qualifier) in NLM's MeSH authority at id.nlm.nih.gov, current year. Each candidate comes back `resolved` (in the preferred form), `qualifier-not-allowed` (descriptor kept, qualifier dropped), `ambiguous` (options listed for a person) or `not-found` (dropped). It never adds a heading the draft did not propose and never emits one the authority lacks.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-core/scripts/mesh-authority.ts validate"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "A JSON file: `{ \"candidates\": [{ \"label\"?, \"descriptor\"?, \"qualifier\"?, \"why\"? }] }`, in the order stage two ranked them.",
            "name": "draft",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--json"
            },
            "description": "Print the full report as JSON instead of the review table.",
            "name": "json",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "A review table with one row per candidate, or with `--json` the report: `results` per candidate and `validated`, the headings a reviewer sees.",
            "name": "report",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Text"
          }
        ]
      },
      "name": "mesh-authority",
      "requirements": {
        "network": true,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/mesh-subject-indexing",
      "title": "Validate draft MeSH headings against NLM's authority"
    }
  ],
