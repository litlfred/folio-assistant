      "@type": "cat-harness:Tool",
      "description": "Draw a figure as SVG from `as-drawn-figure/v1` data: the drawing `scripts/pdf-as-drawn.py` transcribes from the source PDF's vector layer (every path, clip, text run and image in the L1 figure region, at its printed position, colour and size). The SVG keeps the original's layout and style; labels are SVG text held to their printed width, and labels that name a glossary concept link to it.",
      "install": {
        "none": true
      },
      "invoke": {
        "shell": "bun run folio-assistant-core/scripts/as-drawn-svg.ts"
      },
      "io": {
        "inputs": [
          {
            "arg": {
              "positional": 0
            },
            "description": "An as-drawn-figure/v1 file, or a directory of them.",
            "name": "data",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--out-dir"
            },
            "description": "Where to write as-drawn-fig-<N>.svg.",
            "name": "out-dir",
            "required": true,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          },
          {
            "arg": {
              "flag": "--check"
            },
            "description": "Write nothing; fail when data is invalid or an SVG is stale.",
            "name": "check",
            "required": false,
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/Flag"
          }
        ],
        "outputs": [
          {
            "description": "One SVG per data file, named after the figure labels it draws.",
            "name": "svg",
            "schema": "https://litlfred.github.io/folio-assistant/cat-harness/tool-types.schema.json#/$defs/RepoPath"
          }
        ]
      },
      "name": "as-drawn-svg",
      "requirements": {
        "network": false,
        "runtime": [
          "bun"
        ]
      },
      "satisfies": "https://litlfred.github.io/folio-assistant/folio-assistant-core/skill/figure-rebuild",
      "title": "Figure redrawn as drawn, from its PDF vector layer"
