    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/process/Process_PublicCommentChange",
      "@type": "bootstrap:Process",
      "description": "Called by Process_PublicComment (CallActivity_MakeChange) once the\neditor's decision on a comment changes the document. An author makes\nthe edit on a feature branch, the change set is reviewed on its staging\npreview as any content change (Process_ContentChangeReview), an\nindependent QA gate checks the dispositions against the pull request,\nand each comment the change set answers is marked incorporated when it\nmerges. Drawn on its own page so that each phase fits the screen.\nSkill: public-comment.",
      "enforcement": "strict",
      "flowCount": 7,
      "inSubgraph": "https://litlfred.github.io/folio-assistant/folio-assistant-core/directory/core-processes",
      "name": "Make a decided public comment change",
      "nodeCount": 7,
      "sourcePath": "processes/content/public-comment-change.bpmn",
      "sourceUrl": "https://github.com/litlfred/folio-assistant-core/blob/main/processes/content/public-comment-change.bpmn",
      "startNode": "https://litlfred.github.io/folio-assistant/folio-assistant-core/process/Process_PublicCommentChange/node/StartEvent_ChangeDecided",
      "summary": "Called by Process_PublicComment (CallActivity_MakeChange) once the editor's decision on a comment changes the document."
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/folio-assistant-core/process/Process_PublicCommentChange#flow/Flow_QaFailed",
