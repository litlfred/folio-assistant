      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_P3" bpmnElement="SF_HAD_P3">
        <di:waypoint x="890" y="347" />
        <di:waypoint x="1035" y="347" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SF_HAD_P4" bpmnElement="SF_HAD_P4">
        <di:waypoint x="1085" y="347" />
