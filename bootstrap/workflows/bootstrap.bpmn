<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:folio="http://folio-assistant.dev/bpmn"
                  id="Definitions_Bootstrap"
                  targetNamespace="http://folio-assistant.dev/bpmn/bootstrap">

  <!-- ═══════════════════════════════════════════════════════════
       Bootstrap — the process an agent runs knowing nothing

       A DECISION TREE, deliberately small: this repository either
       already IS an instance, or it is not. Everything else follows
       from that one question.

         already an instance  -> read its declaration, done
         not an instance      -> ask what to make it, and the ONLY
                                 thing asked for is an INSTANCE
                                 REFERENCE

       THE ORDER IS LOAD-BEARING and is why A_ReadUpstream sits
       between the question and the write: reference -> read THEIRS
       -> write OURS -> cache. Writing a declaration before reading
       the upstream one leaves a window in which this repository
       declares something it is not, and every consumer that reads a
       declaration would believe it.

       NO TOOL CALLS ANYWHERE IN THIS PROCESS. An agent cold-starting
       has no MCP server; assuming one fails in exactly the case this
       process exists for. Every step is "read a file" or "ask the
       human".
       ═══════════════════════════════════════════════════════════ -->

  <bpmn:process id="Process_Bootstrap" name="Bootstrap an instance" isExecutable="true">
    <bpmn:documentation>bootstrap — make this repository an instance, or load the one it already is. Source of truth: this file. The graph that reaches it is bootstrap/bootstrap.jsonld; the README a contextless agent reads first is bootstrap/README.md.</bpmn:documentation>
    <bpmn:extensionElements><folio:policy enforcement="strict"/></bpmn:extensionElements>

    <bpmn:laneSet id="LaneSet_Bootstrap">
      <bpmn:lane id="Lane_Agent" name="Bootstrapping agent">
        <bpmn:extensionElements><folio:role ref="onboarding-agent"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>Start_Pointed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ReadDeclaration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gate_IsInstance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_LoadInstance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_DetermineIntent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_ReadUpstream</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_WriteDeclaration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>A_Cache</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Human" name="Person asking (judgement only)">
        <bpmn:extensionElements><folio:role ref="user"/></bpmn:extensionElements>
        <bpmn:flowNodeRef>H_NameInstance</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="Start_Pointed" name="Pointed at a repository">
      <bpmn:outgoing>F_start</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- Read, never assume. An absent declaration and an unreadable one are
         different answers; only the first means "not an instance". -->
    <bpmn:task id="A_ReadDeclaration" name="Read this repository's declaration, if it has one">
      <bpmn:extensionElements><folio:skill ref="kg-navigation"/></bpmn:extensionElements>
      <bpmn:incoming>F_start</bpmn:incoming>
      <bpmn:outgoing>F_toGate</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gate_IsInstance" name="Already an instance?">
      <bpmn:incoming>F_toGate</bpmn:incoming>
      <bpmn:outgoing>F_yes</bpmn:outgoing>
      <bpmn:outgoing>F_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="A_LoadInstance" name="Load the declared graphs and stop">
      <bpmn:extensionElements><folio:skill ref="kg-navigation"/></bpmn:extensionElements>
      <bpmn:incoming>F_yes</bpmn:incoming>
      <bpmn:outgoing>F_loaded</bpmn:outgoing>
    </bpmn:task>

    <!-- The ONE place user input is required. -->
    <bpmn:task id="A_DetermineIntent" name="Determine intent — an INSTANCE REFERENCE, not a content type">
      <bpmn:extensionElements><folio:skill ref="determine-intent"/></bpmn:extensionElements>
      <bpmn:incoming>F_no</bpmn:incoming>
      <bpmn:incoming>F_answered</bpmn:incoming>
      <bpmn:outgoing>F_ask</bpmn:outgoing>
    </bpmn:task>

    <bpmn:userTask id="H_NameInstance" name="Name the instance this repository should be an instance of">
      <bpmn:extensionElements><folio:no-skill reason="Which instance to become is the person's decision; no procedure yields it, and a mapping the agent invents would be a fourth place the answer is written down."/></bpmn:extensionElements>
      <bpmn:incoming>F_ask</bpmn:incoming>
      <bpmn:outgoing>F_answered</bpmn:outgoing>
    </bpmn:userTask>

    <!-- THEIRS before OURS. The harness type, the knowledge graph and the
         voice are all READ here; none of them is asked for separately. -->
    <bpmn:task id="A_ReadUpstream" name="Read the named instance's declaration">
      <bpmn:extensionElements><folio:skill ref="kg-navigation"/></bpmn:extensionElements>
      <bpmn:incoming>F_ask2</bpmn:incoming>
      <bpmn:outgoing>F_toWrite</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="A_WriteDeclaration" name="Write this repository's declaration from what that said">
      <bpmn:extensionElements><folio:skill ref="kg-navigation"/></bpmn:extensionElements>
      <bpmn:incoming>F_toWrite</bpmn:incoming>
      <bpmn:outgoing>F_toCache</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="A_Cache" name="Cache what the declaration needs under bootstrap/&lt;instance&gt;/">
      <bpmn:extensionElements><folio:skill ref="kg-navigation"/></bpmn:extensionElements>
      <bpmn:incoming>F_toCache</bpmn:incoming>
      <bpmn:outgoing>F_cached</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Ready" name="This repository is an instance">
      <bpmn:incoming>F_loaded</bpmn:incoming>
      <bpmn:incoming>F_cached</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_start" sourceRef="Start_Pointed" targetRef="A_ReadDeclaration"/>
    <bpmn:sequenceFlow id="F_toGate" sourceRef="A_ReadDeclaration" targetRef="Gate_IsInstance"/>
    <bpmn:sequenceFlow id="F_yes" name="yes — load" sourceRef="Gate_IsInstance" targetRef="A_LoadInstance"/>
    <bpmn:sequenceFlow id="F_no" name="no — initialize" sourceRef="Gate_IsInstance" targetRef="A_DetermineIntent"/>
    <bpmn:sequenceFlow id="F_loaded" sourceRef="A_LoadInstance" targetRef="End_Ready"/>
    <bpmn:sequenceFlow id="F_ask" sourceRef="A_DetermineIntent" targetRef="H_NameInstance"/>
    <bpmn:sequenceFlow id="F_answered" sourceRef="H_NameInstance" targetRef="A_DetermineIntent"/>
    <bpmn:sequenceFlow id="F_ask2" sourceRef="A_DetermineIntent" targetRef="A_ReadUpstream"/>
    <bpmn:sequenceFlow id="F_toWrite" sourceRef="A_ReadUpstream" targetRef="A_WriteDeclaration"/>
    <bpmn:sequenceFlow id="F_toCache" sourceRef="A_WriteDeclaration" targetRef="A_Cache"/>
    <bpmn:sequenceFlow id="F_cached" sourceRef="A_Cache" targetRef="End_Ready"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Bootstrap">
    <bpmndi:BPMNPlane id="BPMNPlane_Bootstrap" bpmnElement="Process_Bootstrap">
      <bpmndi:BPMNShape id="Shape_Lane_Agent" bpmnElement="Lane_Agent" isHorizontal="true"><dc:Bounds x="160" y="80" width="1180" height="280"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Human" bpmnElement="Lane_Human" isHorizontal="true"><dc:Bounds x="160" y="380" width="1180" height="200"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Pointed" bpmnElement="Start_Pointed"><dc:Bounds x="200" y="190" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ReadDeclaration" bpmnElement="A_ReadDeclaration"><dc:Bounds x="290" y="168" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gate_IsInstance" bpmnElement="Gate_IsInstance"><dc:Bounds x="450" y="187" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_LoadInstance" bpmnElement="A_LoadInstance"><dc:Bounds x="540" y="95" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_DetermineIntent" bpmnElement="A_DetermineIntent"><dc:Bounds x="540" y="250" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_H_NameInstance" bpmnElement="H_NameInstance"><dc:Bounds x="540" y="440" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_ReadUpstream" bpmnElement="A_ReadUpstream"><dc:Bounds x="710" y="250" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_WriteDeclaration" bpmnElement="A_WriteDeclaration"><dc:Bounds x="870" y="250" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_A_Cache" bpmnElement="A_Cache"><dc:Bounds x="1030" y="250" width="120" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Ready" bpmnElement="End_Ready"><dc:Bounds x="1210" y="190" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_F_start" bpmnElement="F_start"><di:waypoint x="218" y="208"/><di:waypoint x="350" y="208"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_toGate" bpmnElement="F_toGate"><di:waypoint x="350" y="208"/><di:waypoint x="475" y="212"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_yes" bpmnElement="F_yes"><di:waypoint x="475" y="212"/><di:waypoint x="600" y="135"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_no" bpmnElement="F_no"><di:waypoint x="475" y="212"/><di:waypoint x="600" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_loaded" bpmnElement="F_loaded"><di:waypoint x="600" y="135"/><di:waypoint x="1228" y="208"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_ask" bpmnElement="F_ask"><di:waypoint x="600" y="290"/><di:waypoint x="600" y="480"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_answered" bpmnElement="F_answered"><di:waypoint x="600" y="480"/><di:waypoint x="600" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_ask2" bpmnElement="F_ask2"><di:waypoint x="600" y="290"/><di:waypoint x="770" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_toWrite" bpmnElement="F_toWrite"><di:waypoint x="770" y="290"/><di:waypoint x="930" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_toCache" bpmnElement="F_toCache"><di:waypoint x="930" y="290"/><di:waypoint x="1090" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_F_cached" bpmnElement="F_cached"><di:waypoint x="1090" y="290"/><di:waypoint x="1228" y="208"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
