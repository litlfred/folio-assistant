  "label": "bootstrap",
  "comment": "Generated by the bootstrap toolset (https://github.com/litlfred/bootstrap-tools, scripts/export-graph.ts) from bootstrap's own files — do not edit; change the files it describes.",
  "wasAttributedTo": "https://github.com/litlfred/bootstrap-tools",
  "title": "Bootstrap",
  "description": "The graph an agent reads before it knows what this repository is.",
  "versionInfo": "0.1.0",
  "generatedAtTime": "2026-10-06T11:34:00.342Z",
  "wasDerivedFrom": "git:e2d5ae642f30333eabd06972984ef2ab29fa5ca0",
  "@graph": [
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#asset/agent-instructions",
      "@type": "bootstrap:Asset",
      "label": "agent-instructions",
      "title": "AGENTS.md — bootstrap",
      "description": "Phase one of two. Valid with nothing installed: no skills, no knowledge graph, no MCP, no work-plan store. The default behaviour of initialisation is to copy this file, and the last bootstrap step re-enters through the installed harness, which is what supplies phase two. No `source` because this is the origin — an absent source means authored here, which is a different fact from an upstream that cannot be reached.",
      "source": "AGENTS.md",
      "isPartOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#asset/readme",
      "@type": "bootstrap:Asset",
      "label": "readme",
      "title": "bootstrap",
      "description": "The flow, with every term linked to the schema that defines it. Self-documenting on GitHub: a person landing on the directory reads the thing itself rather than a pointer to a site.",
      "source": "README.md",
      "isPartOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#asset/vocabulary",
      "@type": "bootstrap:Asset",
      "label": "vocabulary",
      "title": "bootstrap vocabulary",
      "description": "Every term bootstrap defines, in order, and every Graph Typology it defines, as RDF and SKOS — the document bootstrap's namespace resolves to. Generated from bootstrap's own terms by its toolset; each term links to the schema that defines it.",
      "source": "ns.jsonld",
      "isPartOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#directory/models",
      "@type": "bootstrap:Subgraph",
      "label": "models",
      "description": "Which languages a model is good at, and whether anybody checked. In BOOTSTRAP for the reason everything else here is: an agent reaching for the language it should communicate in has not yet loaded the harness that would otherwise answer, so a registry one layer up would be unreachable in exactly the case it exists for. `context`: read when a session opens, never written by a process — a person grants a validation, an agent never does, because a model's own claim about its languages is the thing the validation state exists to distrust.",
      "type": [
        "bootstrap:graphTypology/models"
      ],
      "source": "models/",
      "isPartOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#directory/processes",
      "@type": "bootstrap:Subgraph",
      "label": "processes",
      "description": "bootstrap's Processes: `initialize-harness.bpmn`, the only one an Actor starts; `discussion.bpmn`, which it calls to determine the harness and repositories; `human-agent-discussion.bpmn`, the reusable discussion every diagram calls to ask a person anything; `complete-initialization.bpmn`, which checks every initialization step the declarations name; and `log-message.bpmn`, which any step may call to record what it is doing. `ns.jsonld` defines the elements these diagrams add to BPMN (skill, role, precondition), written with the prefix `bootstrap.processes:`.",
      "type": [
        "bootstrap:graphTypology/processes"
      ],
      "source": "processes/",
      "isPartOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#directory/scenarios",
      "@type": "bootstrap:Subgraph",
      "label": "scenarios",
      "description": "bootstrap's four Roles: Bootstrapping Agent, Requestor, Knowledge Graph Data Store and Logger.",
      "type": [
        "bootstrap:graphTypology/scenarios"
      ],
      "source": "scenarios/",
      "isPartOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#directory/schemas",
      "@type": "bootstrap:Subgraph",
      "label": "schemas",
      "description": "The schemas bootstrap is checked against: `graph.schema.json`, the shape of a declaration and the definition of every term bootstrap uses; and the input and output of the discussion Process. Their published `$id`s do not change when a file moves.",
      "type": [
        "bootstrap:graphTypology/schemas"
      ],
      "source": "schemas/",
      "isPartOf": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld"
    },
    {
      "@id": "https://litlfred.github.io/folio-assistant/bootstrap/bootstrap.jsonld#directory/skills",
      "@type": "bootstrap:Subgraph",
      "label": "skills",
      "type": [
        "bootstrap:graphTypology/skills"
      ],
