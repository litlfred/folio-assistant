    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-040-01",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "Based on national or sub-national eHealth enterprise information architecture, national and sub-national health authorities shall develop and deploy the registry."
        }
      ],
      "skos:notation": "12",
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 62-64.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-040-01",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-040-02",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "The registry shall conform to best practices in information systems design in order to assure quality, accuracy, timeliness, completeness, reliability, privacy, security, and confidentiality of the data and information systems and assets."
        }
      ],
      "skos:notation": "13",
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 62-64.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-040-02",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-040-03",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "Legally authorized users of the registry shall be required to have unique user names and passwords that will be provided by the national Steering Committee, on the approval of the highest health authority at national and sub-national levels. Level of access to the registry shall be determined by the national Steering Committee or its authorized agent."
        }
      ],
      "skos:notation": "15",
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 62-64.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-040-03",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-040-04",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "The registry must be in compliance with all applicable national and sub-national laws related to privacy, security, and confidentiality of data."
        }
      ],
      "skos:notation": "16",
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 62-64.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-040-04",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-040-05",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "The registry and its related physical assets shall be secured in accordance with applicable national and sub-national laws."
        }
      ],
      "skos:notation": "17",
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 62-64.",
      "skos:broader": [
