        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "Make available, at sub-national level, a replica of the registry with similar structure and functions, in order to collect and manage the minimum data set from authorized entities at sub-national-level."
        }
      ],
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 56-60.",
      "skos:broader": [
