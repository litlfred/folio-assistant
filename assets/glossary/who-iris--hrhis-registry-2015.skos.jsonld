        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/hrh-information-system"
        }
      ],
      "dcterms:source": "uploads/9789241549226-eng/9789241549226-eng.pdf#page=21",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-006-01",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "In a national context an electronic health workforce registry can be considered the single authoritative source of health workforce information that can provide an accurate count of all health care personnel that either have worked or are currently working at national or sub-national levels, including in the private sector."
        }
      ],
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 16-18.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-006-01",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-006-02",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "An electronic health workforce registry can be designed to authenticate and validate the existence of a health worker and provide essential details about that person."
        }
      ],
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 16-18.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-006-02",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-006-03",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "In addition, a health workforce registry can ensure quality control, provide easy access to information on production, distribution and utilization of health personnel, and assist in budgeting, research development and advocacy."
        }
      ],
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 16-18.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-006-03",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-006-04",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "A health workforce registry allows aggregation of health workforce data in several combinations and assists both national and sub-national ministries of health in producing essential indicator-based reports, as needed."
        }
      ],
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 16-18.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-006-04",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/fr-sec-006-05",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015"
      },
      "skos:prefLabel": [
        {
          "@value": "The health workforce registry is a central and essential component of a functional HRIS, as it contains important health worker attributes that can subsequently be linked to other relevant HRIS components."
        }
      ],
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 16-18.",
      "skos:broader": [
        {
          "@id": "https://litlfred.github.io/who-iris/v0/ns/glossary/hrhis-registry-2015/health-workforce-registry"
        }
      ],
      "dcterms:source": "library/9789241549226-eng/blocks/functional-requirement-sec-006-05",
      "skos:note": "candidate"
    },
