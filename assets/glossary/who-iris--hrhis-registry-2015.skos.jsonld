      },
      "skos:prefLabel": [
        {
          "@value": "Adhere to best practices in information systems design to assure accuracy, timeliness, completeness, reliability, privacy, security, and confidentiality of data and information systems and assets."
        }
      ],
      "skos:scopeNote": "An inspirational, non-definitional functional requirement (system-requirement-statement), word for word from pages 56-60.",
