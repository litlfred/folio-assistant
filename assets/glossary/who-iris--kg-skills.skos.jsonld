      "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-skills/iris-cdn-signing",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/who-iris/v0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "iris-cdn-signing"
        }
      ],
      "skos:definition": [
        {
          "@value": "How an IRIS CDN release is packaged, signed and verified using published standards only: a BagIt bag (RFC 8493), a detached JWS (RFC 7515 App. F) with ES256 (RFC 7518), and the key published in a did:web DID document whose publicKeyJwk carries an x5c chain up to WHO's signing key. No GDHCN trust list is assumed."
        }
      ],
      "skos:notation": "iris-cdn-signing",
      "dcterms:source": "who-iris/skills/iris-cdn-signing.md",
      "skos:note": "candidate"
    },
