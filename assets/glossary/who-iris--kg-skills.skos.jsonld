      ],
      "skos:definition": [
        {
          "@value": "How WHO IRIS uses DSpace and qualified Dublin Core — the three identifier systems, MeSH as a controlled vocabulary, bundles, and the containment path. What a later tool needs from a record, stated as requirements it can be checked against."
        }
      ],
      "skos:notation": "iris-dspace",
      "dcterms:source": "who-iris/skills/iris-dspace.md",
