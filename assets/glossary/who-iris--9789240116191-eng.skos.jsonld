    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/digitization",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Digitization",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of converting and organizing data from paper records into a digital format for easier entry, storage and retrieval. Digitization is the initial step towards digital transformation.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L15",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/digitalization",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Digitalization",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of digitally automating and simplifying processes to streamline individual health programmes and reducing manual efforts for greater efficiency. Digitalization is the second step towards digital transformation.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L18",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/digital-transformation",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Digital transformation",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The process of digitally optimizing and driving systems-level changes by leveraging innovation, analytics, and feedback mechanisms to improve person centred health systems. Digital technologies are used to fundamentally change and improve how health services are delivered and accessed across all health programme areas.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L22",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/end-user",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "End user",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "People who will be using the digital system(s).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L27",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/features",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Features",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "The characteristics of your system that include look and feel as well as what the system can do (e.g., “approval workflow” can be a feature of a product master data management solution).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L29",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/functional-requirements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Functional requirements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Description of what the digital system needs to do to support the tasks that make up the health system process and address the identified challenges (e.g., a product master data management solution must be able to define categories and attributes to organize product information).",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L32",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/generic-product-or-product-information",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Generic product or product information",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "In this handbook, the terms ‘generic product,’ ‘product,’ or ‘product information’ pertain to the general identifying details of a health product, excluding any manufacturer-specific information.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L37",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/interoperability",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Interoperability",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Ability of different applications to access, exchange, integrate and use data in a coordinated and consistent manner through the use of shared application interfaces, value sets, concepts and standards, within and across organizational, regional and national boundaries, to provide timely and seamless portability of information and optimize health outcomes.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L42",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/non-functional-requirements",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Non-functional requirements",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Description of the attributes and constraints that the system must have to ensure its quality and performance. These requirements do not specify what the system should do, but rather how the system should perform its functions. (e.g., a product master data management solution must be able to support offline mode when network connectivity is not available)",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L47",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/open-source",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Open source",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Open-source software is software with source code that is published and made freely available to the public, enabling anyone to inspect, modify and enhance the code.8 While the source code is open to everyone, this does not mean that implementation of software is necessarily without costs. An open-source software must have a license approved by the Open-Source Initiative.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L53",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/open-standards",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Open standards",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "Standards that are documented and made freely available to the public, which are developed, approved, and maintained via a collaborative and consensus driven process. Open standards facilitate interoperability and data exchange and are intended for widespread adoption.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L59",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/organogram",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "Organogram",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "A visual representation of the organization structure showing the hierarchy of various roles and their reporting relationships Registry A governed, authoritative and centralized information system that captures, stores, and maintains the unique attributes and identifiers of health facilities, health service users, products and/or health workforce using a predefined canonical minimum data set.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L63",
      "skos:note": "candidate"
    },
    {
      "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng/smart-guidelines",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://worldhealthorganization.github.io/who-iris/v0/ns/glossary/9789240116191-eng"
      },
      "skos:prefLabel": [
        {
          "@value": "SMART Guidelines",
          "@language": "en"
        }
      ],
      "skos:definition": [
        {
          "@value": "WHO standards-based, machine-readable, adaptive, requirements-based, and testable Guidelines are recommended digital capabilities, health and data content. They represent a comprehensive set of reusable digital health components (e.g., interoperability standards, code libraries, algorithms, technical and operational specifications) that transform the guideline adaptation and implementation process to preserve fidelity and accelerate uptake. SMART Guidelines provide a five-step pathway to advance the adoption of best clinical and data practices, even if a country is not yet fully digital.",
          "@language": "en"
        }
      ],
      "skos:scopeNote": "Verbatim from the source; a candidate until an editor adopts it (glossary-from-source).",
      "dcterms:source": "library/9789240116191-eng/sections/sec-002-glossary.md#L71",
      "skos:note": "candidate"
    },
