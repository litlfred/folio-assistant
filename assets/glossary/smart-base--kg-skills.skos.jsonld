    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills/transcription-verbatim",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "transcription-verbatim"
        }
      ],
      "skos:definition": [
        {
          "@value": "Check L1 authored from pictures (a schedule poster, a slide deck: a source with no usable text layer) against the image narratives and transcriptions it names: every statement verbatim in one of them, every transcription word corroborated by the entry's text layer unless listed under inspectionOnly, and unique keys. A step of recommendation-extraction, in place of recommendation-candidates when that step found no normative sentence; the `l1-transcription-verbatim` Tool satisfies it."
        }
      ],
      "skos:notation": "transcription-verbatim",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/transcription-verbatim.md",
      "skos:note": "candidate"
    }
  ]
