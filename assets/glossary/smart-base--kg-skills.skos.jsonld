      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-skills/smart-guideline-create",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-guideline-create"
        }
      ],
      "skos:definition": [
        {
          "@value": "Somebody asked for a new WHO SMART Guideline (an IG built on smart-base, or a DAK that will feed one). Specialises fhir-ig-create: the same three facts, the same numbered question with the same default (stage it inside this repository first), and the same routes, plus what the owner ruled for SMART guidelines during the 2026-10 separation: every guideline repository instantiates smart-base identically, forks under litlfred come before any WHO repository, the identity comes from the declaration and never from the directory, and the WHO template's theme and chrome come from smart-base by `needs`, never copied. Use whenever a user asks to create, start or set up a SMART Guideline, a SMART IG, a WHO IG or a DAK."
        }
      ],
      "skos:notation": "smart-guideline-create",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-guideline-create.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-skills/smart-guideline-end-to-end",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/0.1.0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-guideline-end-to-end"
        }
      ],
      "skos:definition": [
        {
          "@value": "The whole road from a use case to a running application on WHO SMART Guidelines, for a new guideline or a jurisdiction's adaptation: find the L1 guidelines that bear on the use case, ingest them into an L1 knowledge graph, choose the existing L2 DAKs and L3 IGs to build on, create or adapt the L2 and L3 assets, then build the consuming application the user describes. Human adjudication follows every stage, as QA and never as a gate: the agent goes on to the next stage while the last one is reviewed. Read before starting any end-to-end authoring or adaptation, and to find which existing skill and process runs each stage."
        }
      ],
      "skos:notation": "smart-guideline-end-to-end",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-guideline-end-to-end.md",
      "skos:note": "candidate"
    },
