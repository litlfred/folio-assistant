        {
          "@value": "dak-postprocessing"
        }
      ],
      "skos:definition": [
        {
          "@value": "What the DAK post-processing phase accomplishes after the IG Publisher runs — the JSON/JSON-LD surface, the DAK API hub, and the metadata-to-Liquid bridge that is the seam the just-the-docs transition cuts at. Read before changing a post-processing step, and before assuming the Publisher produced something it did not."
        }
      ],
      "skos:notation": "dak-postprocessing",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/dak-postprocessing.md",
