      },
      "skos:prefLabel": [
        {
          "@value": "l4-application-brief"
        }
      ],
      "skos:definition": [
        {
          "@value": "Stage 7 of smart-guideline-end-to-end: get from the requester a description of the consuming application — who uses it, on what device, which L2 processes and L3 resources it covers, connectivity, the systems it talks to — and turn it into the design intent wireframe-design-review starts from. The agent offers options drawn from the L2 personas and processes, and never invents the application. Read before wireframing or building an L4 application on a guideline."
        }
      ],
      "skos:notation": "l4-application-brief",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/l4-application-brief.md",
      "skos:note": "candidate"
