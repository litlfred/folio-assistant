    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills/smart-guideline-create",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-guideline-create"
        }
      ],
      "skos:definition": [
        {
          "@value": "Somebody asked for a new WHO SMART Guideline (an IG built on smart-base, or a DAK that will feed one). Specialises fhir-ig-create: the same three facts, the same numbered question with the same default (stage it inside this repository first), and the same routes, plus what the owner ruled for SMART guidelines during the 2026-10 separation: every guideline repository instantiates smart-base identically, forks under litlfred come before any WHO repository, the identity comes from the declaration and never from the directory, and the WHO template's theme and chrome come from smart-base by `needs`, never copied. Use whenever a user asks to create, start or set up a SMART Guideline, a SMART IG, a WHO IG or a DAK."
        }
      ],
      "skos:notation": "smart-guideline-create",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-guideline-create.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills/smart-guideline-end-to-end",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-guideline-end-to-end"
        }
      ],
      "skos:definition": [
        {
          "@value": "The whole road from a use case to a running application on WHO SMART Guidelines, for a new guideline or a jurisdiction's adaptation, as an orchestrator of ten named stage skills, each with its own input and output contract: guideline-use-case, dak-l1-library, recommendation-extraction, l2-dependency-choice, l2-dak-authoring, l3-dependency-choice, l3-fhir-authoring, l4-application-brief, wireframe-design-review and l4-application-build. Each stage's output is the next stage's input. Human adjudication follows every stage, as QA and never as a gate: the agent goes on to the next stage while the last one is reviewed. The ORDER of the stages is a rule, though: no L3 asset before the L1 extraction and the L2 assets it derives from exist and their review has been requested. Read before starting any end-to-end authoring or adaptation, and to find which skill runs each stage. A request to adapt a WHO guideline, DAK or IG to a country or programme (\"adapt the immunization guidelines to Uganda using these schedules\") is this process, even when it reads like an IG or coding task."
        }
      ],
      "skos:notation": "smart-guideline-end-to-end",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-guideline-end-to-end.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills/smart-stack-layering",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "smart-stack-layering"
        }
      ],
      "skos:definition": [
        {
          "@value": "Which layer a WHO SMART asset, rule, script or page belongs to — fhir-harness, smart-base (with its L1 and DAK document kinds) or smart-ig — and the one question that settles it. Read before adding anything to fhir-harness, smart-base or smart-ig, before creating a per-IG harness, and before moving a pre/post-processing step."
        }
      ],
      "skos:notation": "smart-stack-layering",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/smart-stack-layering.md",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills/toolchain-ownership",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/smart-base/v0/ns#glossary/kg-skills"
      },
      "skos:prefLabel": [
        {
          "@value": "toolchain-ownership"
        }
      ],
      "skos:definition": [
        {
          "@value": "Taking ownership of the WHO smart-base scripts in a litlfred fork, rewriting them to the Skill I/O contract, and the one gate that governs when a script may actually move. Read before touching, copying or rewriting any upstream smart-base script."
        }
      ],
      "skos:notation": "toolchain-ownership",
      "dcterms:source": "smart-base/skills/content/authoring-who-smart-guidelines/toolchain-ownership.md",
