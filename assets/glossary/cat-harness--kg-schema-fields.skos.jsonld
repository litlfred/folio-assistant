          "@value": "AdversarialChecklistItem.references"
        }
      ],
      "skos:definition": [
        {
          "@value": "The rules supporting this check, BY NAME — `skill:<name>` or `schema:<module>` — never by path. Code, which is addressed by path on purpose, is `code:<layer>/<module path>`. Paths went stale as skills moved between packages (two named a skill that no longer exists); a name is found wherever the declaration puts it (`check:declared-paths`, bean `rmi6` follow-up). `adversarial-checklist.test.ts` resolves every one."
        }
      ],
      "dcterms:source": "cat-harness/schemas/adversarial-checklist.ts#AdversarialChecklistItem.references",
      "skos:note": "candidate"
