      "skos:definition": [
        {
          "@value": "The graph typologies (directory kinds) whose directories, in OTHER instances, this entry's writers read: the declared READ EDGE that orders them (see \"Writer order\" above). `derive:publish` runs these writers after the writers of every other instance's entry that fills (`directory`) a directory of one of these kinds. Kinds, never instance names: a lower layer reading what the layers above it build cannot name them."
        }
      ],
      "dcterms:source": "cat-harness/schemas/built-at-publish.ts#BuiltAtPublishSchema.reads",
      "skos:note": "candidate"
