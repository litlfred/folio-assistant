      },
      "skos:prefLabel": [
        {
          "@value": "Diff base → head and render the delta pages [ig-ast-delta]"
        }
      ],
      "skos:definition": [
        {
          "@value": "`ig-ast.ts diff <base> <head> --plan plan.json --site <site>/ast-delta/`: resources added, removed, changed (with an element-level differential) and version-changed; edges added and removed; the plan's decision. Every page opens with the provisional mark and is wrapped in raw so narrative Liquid is not executed."
        }
      ],
      "skos:notation": "Task_Diff",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-delta-review.bpmn#Task_Diff",
      "skos:note": "candidate"
    },
