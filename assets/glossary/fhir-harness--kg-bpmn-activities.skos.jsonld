      },
      "skos:prefLabel": [
        {
          "@value": "Note the missed coupling on the bean [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Append to bean `a9tx` (W8): the resource key, the differential path, and why it is unexplained. Check before creating: beans create is not idempotent. A note, not a new bean, unless the owner asks for one."
        }
      ],
      "skos:notation": "Task_FileCoupling",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-delta-review.bpmn#Task_FileCoupling",
