        }
      ],
      "skos:definition": [
        {
          "@value": "ig-cache restore: per-artefact records, the terminology cache, the package cache and temp/, keyed by the toolchain slug. Exit 0 usable, 1 miss, 2 environment error, 3 present but toolchain moved."
        }
      ],
      "skos:notation": "Task_Restore",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Restore",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_igincremental.task_seed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the cache from the green build (ig-cache seed · verify · promote)"
        }
      ],
      "skos:definition": [
        {
          "@value": "Only a green build of main or a release seeds. Seed writes to the -test branch, verifies a restore from a clean clone, then promotes."
        }
      ],
      "skos:notation": "Task_Seed",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Seed",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_igincremental.task_site",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Assemble the site (template · Jekyll) [ig-publication]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Assemble the site from the merged records: the IG template and a Jekyll build over output/. Only site assembly happens here — every artefact record already exists."
        }
      ],
      "skos:notation": "Task_Site",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Site",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_igincremental.task_sushi",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SUSHI on the restricted tank [l3-fhir-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compile the restricted checkout with SUSHI — the cone's FSH, not the whole IG. A build optimisation, not a validation shortcut: SUSHI compiling is not conformance, so a green compile goes on to validation rather than standing in for it."
        }
      ],
      "skos:notation": "Task_Sushi",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Sushi",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_igincremental.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Validate the cone (fhir_validate) [fhir-validation]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Validate the cone's resources against the warm validator and report the cone that was checked. A validator that could not start is could-not-determine, never a pass with no findings. A green cone is not a green IG: a profile the change did not touch can still be broken by it."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "fhir-harness/processes/content/ig-incremental-build.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_l3fhir.task_authorfsh",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Author FSH profiles [l3-fhir-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Write the FSH profiles, value sets and definitions the source model calls for. This is the stage where profiles, slicing and invariants belong — a decision that can only be expressed in FHIR comes here, not back into the source model."
        }
      ],
      "skos:notation": "Task_AuthorFsh",
      "dcterms:source": "fhir-harness/processes/content/l3-fhir-pipeline.bpmn#Task_AuthorFsh",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_l3fhir.task_igpublisher",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "IG Publisher build [ig-publication]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Run the IG Publisher: it renders output/, writes each resource's JSON, the package, canonicals and qa.json, and does the two things no cache can — validates every resource against its profiles and resolves the dependency closure with terminology expansion."
        }
      ],
      "skos:notation": "Task_IgPublisher",
      "dcterms:source": "fhir-harness/processes/content/l3-fhir-pipeline.bpmn#Task_IgPublisher",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_l3fhir.task_publishig",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Publish the IG site [content-publish]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Release authorisation and review follow draft-to-publication.bpmn."
        }
      ],
      "skos:notation": "Task_PublishIg",
      "dcterms:source": "fhir-harness/processes/content/l3-fhir-pipeline.bpmn#Task_PublishIg",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_l3fhir.task_qcbeans",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "File QC findings as beans [todo-manager]"
        }
      ],
      "skos:definition": [
        {
          "@value": "QC findings do not stay in a report nobody re-reads — each becomes a bean the modeller and the agents both see."
        }
      ],
      "skos:notation": "Task_QcBeans",
      "dcterms:source": "fhir-harness/processes/content/l3-fhir-pipeline.bpmn#Task_QcBeans",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_l3fhir.task_qcgates",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "QC gates [quality-control]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The QC reviewer rules on the aggregate QA against the publication gates. Emitting the QA report is mechanical; ruling on it is a decision, which is why it sits in the reviewer's lane rather than the build's."
        }
      ],
      "skos:notation": "Task_QcGates",
      "dcterms:source": "fhir-harness/processes/content/l3-fhir-pipeline.bpmn#Task_QcGates",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_l3fhir.task_sushi",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "SUSHI compile → FHIR JSON [l3-fhir-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Compile the FSH to FHIR JSON with SUSHI. Compiling is not conformance: a green SUSHI result goes on to validation and never stands in for it."
        }
      ],
      "skos:notation": "Task_Sushi",
      "dcterms:source": "fhir-harness/processes/content/l3-fhir-pipeline.bpmn#Task_Sushi",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_l3fhir.task_validate",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Validate against profiles [fhir-validation]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Validate the compiled resources against their profiles and the packages they constrain. A validator that could not start is could-not-determine, never a pass with an empty findings list. Failures return to authoring."
        }
      ],
      "skos:notation": "Task_Validate",
      "dcterms:source": "fhir-harness/processes/content/l3-fhir-pipeline.bpmn#Task_Validate",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.call_review",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Design review [wireframe-design-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "cat-harness Process_WireframeDesignReview: as-is use for a form that exists, design use for one being designed. This process does not restate the method."
        }
      ],
      "skos:notation": "Call_Review",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Call_Review",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_apply",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Apply it, bring the other side in line [l3-fhir-authoring]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The side the request edited is the source of the change (owner, 2026-10-14). An edited Questionnaire is applied as an FSH edit and the wireframe is redrawn to match; an edited wireframe is kept and the Questionnaire re-derived from it. Then back to Task_Read."
        }
      ],
      "skos:notation": "Task_Apply",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_Apply",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_askreview",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Ask for review with deep links [staging-review]"
        }
      ],
      "skos:definition": [
        {
          "@value": "One deep link per rendered Questionnaire and wireframe, before and after. Where the request goes — the conversation, an issue, the pull request — is a judgement, and more than one may be right: staging-review's deep-link rule, point 5."
        }
      ],
      "skos:notation": "Task_AskReview",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_AskReview",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_fidelity",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Check field for field [check-wireframe-questionnaire]"
        }
      ],
      "skos:definition": [
        {
          "@value": "fhir-harness/scripts/check-wireframe-questionnaire.ts <wireframe.html> <Questionnaire.json>, per layout. Exit 0 faithful, 1 a finding, 2 cannot tell, which is never a pass. The findings become the output's fidelity[] and are shown to the reviewers."
        }
      ],
      "skos:notation": "Task_Fidelity",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_Fidelity",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_read",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Read the built Questionnaire JSON"
        }
      ],
      "skos:definition": [
        {
          "@value": "fsh-generated/resources/Questionnaire-<id>.json, or the IG's published Questionnaire-<id>.json — never FSH. The JSON is what every renderer and reader receives, so it is what is judged."
        }
      ],
      "skos:notation": "Task_Read",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_Read",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_render",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Render the wireframe and the LHC-Forms view"
        }
      ],
      "skos:definition": [
        {
          "@value": "A mid-fidelity wireframe with one field per answerable item, each carrying data-element and sitting in a data-layout web or mobile subtree; and the form view, the same JSON in the vendored <lhc-forms> web component on the IG site's form page. Never a CDN at runtime (owner, 2026-10-14)."
        }
      ],
      "skos:notation": "Task_Render",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_Render",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_reviewstaged",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Review the staged form and wireframe"
        }
      ],
      "skos:definition": [
        {
          "@value": "At the deep links. A change is requested through ✍ suggest in its Questionnaire mode, or the questionnaire-change issue form, and says which side was edited: the Questionnaire or the wireframe."
        }
      ],
      "skos:notation": "Task_ReviewStaged",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_ReviewStaged",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_screens",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Screenshots, web and mobile [wireframe-check]"
        }
      ],
      "skos:definition": [
        {
          "@value": "cat-harness Tool wireframe-check: 1280×800 and 390×844; renders, no-overflow and no-placeholder, each a script entry. A rendering missing either viewport does not enter review."
        }
      ],
      "skos:notation": "Task_Screens",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_Screens",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_stage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Stage the renderings [feature-staging]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The branch's wireframes and form pages published under STAGING/<slug>/ by feature-staging."
        }
      ],
      "skos:notation": "Task_Stage",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_Stage",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_questionnairewireframereview.task_triage",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Triage the change request [content-feedback]"
        }
      ],
      "skos:definition": [
        {
          "@value": "content-feedback triages the issue; when a review round is open it joins a change-set through public-comment instead."
        }
      ],
      "skos:notation": "Task_Triage",
      "dcterms:source": "fhir-harness/processes/content/questionnaire-wireframe-review.bpmn#Task_Triage",
      "skos:note": "candidate"
    }
  ]
}
