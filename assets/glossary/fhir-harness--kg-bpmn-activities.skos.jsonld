      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build and publish the site from the AST [ig-render-jekyll]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The site route's steps, provided by the mounted layers and run by `stage-local.ts` → `build-instance-site.ts`: the landing layer's IG API sidecars when it has the step (`ig-site:sidecars`), the artefact index from the AST and the thin pages with the IG composed at the root (`ig-site:compose`: `ast-to-artifact-index.ts`, `gen-ig-pages.ts --compiled-data ast-data`), the OpenAPI pages when the IG holds them (`ig-site:openapi`), the AST's resources served as `ast-data/` and the build stamp (`ig-site:publisher-pages`). Published at the root from the default branch, as a preview otherwise."
        }
      ],
      "skos:notation": "Task_BuildSite",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_BuildSite",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_igastcache.task_dispatch",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Dispatch the IG's ig-ast-refresh.yml [ig-build-pipeline]"
        }
      ],
      "skos:definition": [
        {
          "@value": "Actions → \"IG AST refresh (by hand)\" → Run workflow on the default branch, inputs `ref` = the default branch, `force` = false. The publish refused, so the verdict already says the cache is not valid; `force` is for a cache that is valid but suspected wrong."
        }
      ],
      "skos:notation": "Task_Dispatch",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_Dispatch",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_igastcache.task_export",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Build the IG with the Publisher AST exporter [ig-publisher-fork]"
        }
      ],
      "skos:definition": [
        {
          "@value": "The runner mounts the layers the IG repository's `index.lock.json` pins, restores and judges the cache itself, and, when it is not valid, runs the caller's optional `pre-export` overlay command, then `AstExportCli` (Tool `ig-ast-export`, `litlfred/fhir-ig-publisher` at the pinned `claude/ast-export` commit) with `-tx`. The inputs `pre-export` changed are put back and the AST is recorded against the clean commit's input digest (`ig-ast.ts source-inputs`). The AST just built must itself be `valid` for the commit, or the run fails."
        }
      ],
      "skos:notation": "Task_Export",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_Export",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_igastcache.task_restore",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Restore the AST from its cache branch and judge it [ig-ast-delta]"
        }
      ],
      "skos:definition": [
        {
          "@value": "`ig-cache.sh restore --ig-root .` fetches `cat/fhir-harness/fhir-ast/<package id>` into `output-ast/` (with the Publisher's `txcache/`), then `ig-cache.sh verify` runs `ig-ast.ts validity`: exit 0 valid, 1 stale-inputs (naming which input), 2 cannot-tell. A restore that finds no branch is a miss, judged as not valid. In an IG repository's site route this is the first `pre` step, `ig-site:ast` (`ig-repo-site.ts ast`)."
        }
      ],
      "skos:notation": "Task_Restore",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_Restore",
      "skos:note": "candidate"
    },
    {
      "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities/process_igastcache.task_seed",
      "@type": "skos:Concept",
      "skos:inScheme": {
        "@id": "https://litlfred.github.io/fhir-harness/v0/ns#glossary/kg-bpmn-activities"
      },
      "skos:prefLabel": [
        {
          "@value": "Seed the cache branch (ig-cache seed --push) [compiled-artefact-cache]"
        }
      ],
      "skos:definition": [
        {
          "@value": "`ig-cache.sh seed --ig-root . --push`: one commit holding the AST, the Publisher's expansions and `txcache/`, its subject recording the package, counts, Publisher version and source commit. Refused when the candidate is under 90% of the incumbent's resources or edges (the no-shrink gate)."
        }
      ],
      "skos:notation": "Task_Seed",
      "dcterms:source": "fhir-harness/processes/content/ig-ast-cache.bpmn#Task_Seed",
      "skos:note": "candidate"
    },
    {
