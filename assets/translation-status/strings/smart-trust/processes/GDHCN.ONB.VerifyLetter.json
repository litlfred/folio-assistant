     "fuzzy": false,
     "candidates": []
    },
    "es": {
     "text": "Una Carta corregida se transmite de nuevo por un canal seguro (Marco IX).",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "fr": {
     "text": "Une Lettre corrigée est de nouveau transmise par un canal sécurisé (Cadre IX).",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "ru": {
     "text": "Исправленное Письмо-заявка вновь передаётся по защищённому каналу (Рамочный документ, раздел IX).",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "zh": {
     "text": "更正后的申请函再次通过安全渠道传递（《框架》第 IX 节）。",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
