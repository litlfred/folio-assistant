  {
   "msgid": "Framework XV.1: at least 30 days ahead.",
   "hash": "e45edcbada79d384",
   "sources": [
    "input/business-processes/GDHCN.ONB.Terminate.bpmn"
   ],
   "locales": {
    "ar": {
     "text": "الإطار XV.1: قبل 30 يوماً على الأقل.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "es": {
     "text": "Marco XV.1: con al menos 30 días de antelación.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "fr": {
     "text": "Cadre XV.1 : au moins 30 jours à l’avance.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "ru": {
     "text": "Рамочный документ, раздел XV.1: не менее чем за 30 дней.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "zh": {
     "text": "《框架》第 XV.1 节：至少提前 30 天。",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    }
   }
  },
