  {
   "msgid": "Framework V.3: one or more Eligible GDHCN Participants may propose one.",
   "hash": "173357b2b7f6f3ef",
   "sources": [
    "input/business-processes/GDHCN.TrustDomain.Propose.bpmn"
   ],
   "locales": {
    "ar": {
     "text": "الإطار V.3: يجوز لمشارك مؤهَّل أو أكثر في GDHCN اقتراح نطاق.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "es": {
     "text": "Marco V.3: uno o más Participantes cualificados para la Red Mundial pueden proponer uno.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
