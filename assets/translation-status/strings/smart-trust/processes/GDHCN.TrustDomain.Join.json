     "candidates": []
    },
    "fr": {
     "text": "Personnel autorisé de l’OMS au sein du Secrétariat du GDHCN (Cadre V, VI). ActorDefinition http://smart.who.int/trust/ActorDefinition/GDHCNSecretariat.",
