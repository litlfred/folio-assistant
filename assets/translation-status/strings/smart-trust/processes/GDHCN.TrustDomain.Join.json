     "fuzzy": false,
     "candidates": []
    },
    "es": {
     "text": "Personal autorizado de la OMS de la Secretaría de la Red Mundial (Marco V, VI). ActorDefinition http://smart.who.int/trust/ActorDefinition/GDHCNSecretariat.",
