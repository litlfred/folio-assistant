  {
   "msgid": "Connects the Participant's systems to the Trust Network Gateway and runs the tests (Framework IX). ActorDefinition http://smart.who.int/trust/ActorDefinition/TechnicalRepresentative.",
   "hash": "9e8c77ad5ecf0fb7",
   "sources": [
    "input/business-processes/GDHCN.ONB.bpmn"
   ],
   "locales": {
    "ar": {
     "text": "يربط أنظمة المشارك ببوابة شبكة الثقة ويُجري الاختبارات (الإطار IX). ActorDefinition http://smart.who.int/trust/ActorDefinition/TechnicalRepresentative.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "es": {
     "text": "Conecta los sistemas del Participante a la puerta de enlace a la red de confianza y ejecuta las pruebas (Marco IX). ActorDefinition http://smart.who.int/trust/ActorDefinition/TechnicalRepresentative.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "fr": {
     "text": "Connecte les systèmes du participant à la passerelle du réseau de confiance et exécute les tests (Cadre IX). ActorDefinition http://smart.who.int/trust/ActorDefinition/TechnicalRepresentative.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "ru": {
     "text": "Подключает системы Участника к Шлюзу сети доверия и проводит тесты (Рамочный документ, раздел IX). ActorDefinition http://smart.who.int/trust/ActorDefinition/TechnicalRepresentative.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    },
    "zh": {
     "text": "将参与方的系统连接到信任网络网关并运行测试（《框架》第 IX 节）。ActorDefinition http://smart.who.int/trust/ActorDefinition/TechnicalRepresentative.",
     "status": "agent",
     "fuzzy": false,
     "candidates": []
    }
   }
