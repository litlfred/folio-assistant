    "fr": {
     "text": "Cette page décrit le premier en détail. Les secondes ne sont pas encore construites et cette page le dit explicitement.",
     "status": "unattributed",
     "fuzzy": false,
     "candidates": []
    },
    "ru": {
     "text": "На этой странице подробно описано первое. Второе пока еще не реализовано, о чем здесь прямо сказано.",
     "status": "unattributed",
     "fuzzy": false,
     "candidates": []
